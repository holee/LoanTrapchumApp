@inject NavigationManager NavigationManager

<nav class="lms-nav">

    <!-- ── Main ─────────────────────── -->
    <div class="lms-nav-section">
        @if (SidebarOpen) { <span class="lms-nav-label">Main</span> }

        <NavLink class="lms-nav-item" href="" Match="NavLinkMatch.All">
