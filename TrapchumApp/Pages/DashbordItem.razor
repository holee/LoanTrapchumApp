@using TrapchumApp.Helpers.Enums
@using TrapchumApp.Helpers.Extensions
<div class="card">
    <div class="icon @BackgroundCss">
        <a href="#">
        <RadzenIcon Icon="@Icon"></RadzenIcon>
        </a>
    </div>
    <div class="content">
        <div class="label">@Title</div>
        <div class="value">
            @if (ValueTemplete is not null)
            {
                @ValueTemplete
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;
    [Parameter]
    public RenderFragment ValueTemplete { get; set; } = default!;
    [Parameter]
    public string Icon { get; set; } = IconNames.Customers;
    [Parameter]
    public ColorEnum BackgroundColor { get; set; } = ColorEnum.Warning;
    private string BackgroundCss => BackgroundColor.ToBootstrapColor();
}