@using TrapchumApp.Helpers.Enums
@using TrapchumApp.Helpers.Extensions
<div class="stat-card @ColorCss">
    <div class="stat-icon">
        <RadzenIcon Icon="@Icon" />
    </div>
    <div class="stat-body">
        <div class="stat-label">@Title</div>
        <div class="stat-value">
            @if (ValueTemplete is not null)
            {
                @ValueTemplete
            }
        </div>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <div class="stat-subtitle">@Subtitle</div>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment ValueTemplete { get; set; } = default!;
    [Parameter] public string Icon { get; set; } = IconNames.Customers;
    [Parameter] public ColorEnum BackgroundColor { get; set; } = ColorEnum.Warning;
    [Parameter] public string? Subtitle { get; set; }
    private string ColorCss => BackgroundColor.ToBootstrapColor();
}