<PageTitle>Home</PageTitle>
<AuthorizeView Policy="@Policies.CreditOfficerOnly">
    <Authorized>
        <InfoBox Title="CO"
                 Subtitle="This Month"
                 Count="1250"
                 PercentageIncrease="15.5"
                 Icon="shopping_cart"
                 GradientStart="#FFFFFF"
                 GradientEnd="#2196FA"
                 OnMoreInfoClick="@HandleMoreInfo">
            <ChildContent>
                <main class="dashboard-container">
                    <section class="cards">
                        @foreach (var item in CoSummaries ?? [])
                        {
                            <DashbordItem BackgroundColor="@GetGradientColor(item.CurrencyId)"
                                          Icon="@IconNames.Customers"
                                          Title="Due Customers">
                                <ValueTemplete>
                                    @item.TotalCustomer
                                </ValueTemplete>
                            </DashbordItem>
                            <DashbordItem BackgroundColor="ColorEnum.Danger"
                                          Icon="@IconNames.AccountBalanceWallet"
                                          Title="@GetTitlePriciple(item.CurrencyId)">
                                <ValueTemplete>
                                    @item.TotalPrinciple.Format(item.CurrencyId)
                                </ValueTemplete>
                            </DashbordItem>
                            <DashbordItem BackgroundColor="ColorEnum.Warning"
                                          Icon="@IconNames.Paid"
                                          Title="@GetTitleInterest(item.CurrencyId)">
                                <ValueTemplete>
                                    @item.TotalInterest.Format(item.CurrencyId)
                                </ValueTemplete>
                            </DashbordItem>
                        }
                        <DashbordItem BackgroundColor="ColorEnum.Success"
                                      Icon="@IconNames.Group"
                                      Title="Request">
                            <ValueTemplete>
                                1000
                            </ValueTemplete>
                        </DashbordItem>
                    </section>
                </main>
                <RadzenRow class="rz-my-2">
                    <RadzenColumn Size="2">
                        <RadzenPanelMenu Click="OnParentClicked" Multiple="true">
                            <RadzenPanelMenuItem Text="Today" Path="buttons" Icon="account_circle"></RadzenPanelMenuItem>
                            <RadzenPanelMenuItem Text="This Week" Path="menu" Icon="line_weight"></RadzenPanelMenuItem>
                            <RadzenPanelMenuItem Text="This Month" Path="fileinput" Icon="attach_file"></RadzenPanelMenuItem>
                            <RadzenPanelMenuItem Text="This Quarter" Path="dialog" Icon="perm_media"></RadzenPanelMenuItem>
                            <RadzenPanelMenuItem Text="This Symester" Path="notification" Icon="announcement"></RadzenPanelMenuItem>
                            <RadzenPanelMenuItem Text="This Year" Path="notification" Icon="announcement"></RadzenPanelMenuItem>
                            <RadzenPanelMenuItem Text="Custom" Path="notification" Icon="announcement"></RadzenPanelMenuItem>
                        </RadzenPanelMenu>
                    </RadzenColumn>
                    <RadzenColumn Size="10">
                        <div style="background-color:aliceblue">
                            <RadzenChart>
                                <RadzenColumnSeries Data="@revenue1" CategoryProperty="Quarter" LineType="LineType.Dashed"
                                                    ValueProperty="Revenue" />
                                <RadzenColumnSeries Data="@revenue2" CategoryProperty="Quarter"
                                                    LineType="LineType.Dashed"
                                                    ValueProperty="Revenue" />
                            </RadzenChart>
                        </div>
                    </RadzenColumn>
                </RadzenRow>

            </ChildContent>
        </InfoBox>
    </Authorized>
</AuthorizeView>
<AuthorizeView Roles="@AppRoles.Manager">
    <Authorized>
        <InfoBox Title="BM"
                 Subtitle="This Month"
