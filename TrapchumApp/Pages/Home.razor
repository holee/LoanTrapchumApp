            <ChildContent>
                <div style="background-color:aliceblue">
                    <RadzenChart>
                        <RadzenColumnSeries Data="@revenue1" CategoryProperty="Quarter" LineType="LineType.Dashed"
                                            ValueProperty="Revenue" />
                        <RadzenColumnSeries Data="@revenue2" CategoryProperty="Quarter" LineType="LineType.Dashed"
                                            ValueProperty="Revenue" />
                    </RadzenChart>
                </div>

            </ChildContent>
        </InfoBox>

    </Authorized>
</AuthorizeView>
<AuthorizeView Policy="@Policies.AccountOnly">
    <Authorized>
        <InfoBox Title="Account,Teller"
                 Subtitle="This Month"
                 Count="1250"
                 PercentageIncrease="15.5"
                 Icon="shopping_cart"
                 GradientStart="#FFFFFF"
                 GradientEnd="#2196FA"
                 OnMoreInfoClick="@HandleMoreInfo">

            <ChildContent>
                <div class="dashboard-container">
                    <div class="cards">
                        @foreach (var item in AccSummaries ?? [])
                        {
                            <DashbordItem Title="@GetTitle(item.CurrencyId)"
                                          BackgroundColor="@GetGradientColor(item.CurrencyId)">
                                <ValueTemplete>
                                    @item.TotalCustomer
                                </ValueTemplete>
                            </DashbordItem>
                            <DashbordItem Title="@GetTitlePriciple(item.CurrencyId)"
                                          Icon="@IconNames.AccountBalanceWallet"
                                          BackgroundColor="@GetGradientColor(item.CurrencyId)">
                                <ValueTemplete>
                                    @item.TotalPrinciple.Format(item.CurrencyId)
                                </ValueTemplete>
                            </DashbordItem>
                            <DashbordItem Title="@GetTitleInterest(item.CurrencyId)"
                                          Icon="@IconNames.Paid"
                                          BackgroundColor="@GetGradientColor(item.CurrencyId)">
                                <ValueTemplete>
                                    @item.TotalInterest.Format(item.CurrencyId)
                                </ValueTemplete>
                            </DashbordItem>

                        }
                        <DashbordItem Title="LoanRequest"
                                      BackgroundColor="@ColorEnum.Info">
                            <ValueTemplete>
                                @_numberOfLoanRequest
                            </ValueTemplete>
                        </DashbordItem>
                    </div>
                </div>
            </ChildContent>
        </InfoBox>
    </Authorized>
</AuthorizeView>
<AuthorizeView Policy="@Policies.ManagerOnly">
    <Authorized>
        <InfoBox Title="RBM"
                 Subtitle="This Month"
