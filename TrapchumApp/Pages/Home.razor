                                    @ManagerSummaries.NewRequest
                                </ValueTemplete>
                            </DashbordItem>
                            <DashbordItem Title="Number Approved Requests"
                                          Icon="@IconNames.AccountBalanceWallet"
                                          BackgroundColor="ColorEnum.Success">
