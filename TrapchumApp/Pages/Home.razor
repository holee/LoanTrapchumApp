@page "/"
@using Microsoft.Extensions.Localization
@using TrapchumApp.Components.Indicatros
@using TrapchumApp.Components.Dashboard
@using TrapchumApp.Helpers.Enums
<PageTitle>Home</PageTitle>
@attribute [Authorize]
@attribute [StreamRendering]
@inject DashboardServices dashboardServices
@inject IStringLocalizer<Home> Loc


@Loc["Loading..."]

<AuthorizeView Policy="@Policies.CreditOfficerOnly">
    <Authorized>
        @if (_isPageLoading)
        {
            <Loading Text="@Loc["Loading..."]" />
        }
        else
        {
            <div class="db-page">
                <div class="db-header">
                    <div class="db-header-text">
                        <span class="db-title">@Loc["Credit Officer"]</span>
                        <span class="db-subtitle">@Loc["Dashboard overview — due customers and performance"]</span>
                    </div>
                    <RadzenBadge Text="CO" BadgeStyle="BadgeStyle.Primary" IsPill="true" />
                </div>

                <div class="db-cards">

                    @foreach (var item in CoSummaries?.LoanSummaries ?? [])
                    {
                        <DashbordItem BackgroundColor="@GetGradientColor(item.CurrencyId)"
                                      Icon="@IconNames.Customers"
                                      Title="@Loc["Due Customers"]">
                            <ValueTemplete>@item.TotalCustomer</ValueTemplete>
                        </DashbordItem>
                        <DashbordItem BackgroundColor="ColorEnum.Danger"
                                      Icon="@IconNames.AccountBalanceWallet"
                                      Title="@GetTitlePriciple(item.CurrencyId)">
                            <ValueTemplete>@item.TotalPrinciple.Format(item.CurrencyId)</ValueTemplete>
                        </DashbordItem>
                        <DashbordItem BackgroundColor="ColorEnum.Warning"
                                      Icon="@IconNames.Paid"
                                      Title="@GetTitleInterest(item.CurrencyId)">
                            <ValueTemplete>@item.TotalInterest.Format(item.CurrencyId)</ValueTemplete>
                        </DashbordItem>
                    }

                    <RequestSummaryCards Items="@CoSummaries?.RequestSummaries" />

                </div>
            </div>
        }
       
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@AppRoles.Manager">
    <Authorized>
        <div class="db-page">
            <div class="db-header">
                <div class="db-header-text">
                    <span class="db-title">@Loc["Branch Manager"]</span>
                    <span class="db-subtitle">@Loc["Monitor branch performance and lending activities"]</span>
                </div>
                <RadzenBadge Text="BM" BadgeStyle="BadgeStyle.Info" IsPill="true" />
            </div>

            <div class="db-cards">
                @if (ManagerSummaries is not null)
                {
                    <DashbordItem Title="@Loc["New Requests"]"
                                  Icon="@IconNames.Group"
                                  BackgroundColor="ColorEnum.Primary">
                        <ValueTemplete>@ManagerSummaries.NewRequest</ValueTemplete>
                    </DashbordItem>
                    <DashbordItem Title="@Loc["Approved Requests"]"
                                  Icon="@IconNames.AccountBalanceWallet"
                                  BackgroundColor="ColorEnum.Success">
                        <ValueTemplete>@ManagerSummaries.NumberApproved</ValueTemplete>
                    </DashbordItem>
                }
            </div>

            <RadzenCard class="db-chart-card" Variant="Variant.Outlined">
                <div class="db-chart-header">
                    <RadzenIcon Icon="bar_chart" class="db-chart-icon" />
                    <span>@Loc["Branch Lending Performance"]</span>
                </div>
            </RadzenCard>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Policy="@Policies.AccountOnly">
    <Authorized>
        <div class="db-page">
            <div class="db-header">
                <div class="db-header-text">
                    <span class="db-title">@Loc["Account & Teller"]</span>
                    <span class="db-subtitle">@Loc["Track due customers and daily approved loan requests"]</span>
                </div>
                <RadzenBadge Text="ACC" BadgeStyle="BadgeStyle.Warning" IsPill="true" />
            </div>

            <div class="db-cards">
                @foreach (var item in AccSummaries?.LoanSummaries ?? [])
                {
                    <DashbordItem Title="@GetTitle(item.CurrencyId)"
                                  BackgroundColor="@GetGradientColor(item.CurrencyId)">
                        <ValueTemplete>@item.TotalCustomer</ValueTemplete>
                    </DashbordItem>
                    <DashbordItem Title="@GetTitlePriciple(item.CurrencyId)"
                                  Icon="@IconNames.AccountBalanceWallet"
                                  BackgroundColor="@GetGradientColor(item.CurrencyId)">
                        <ValueTemplete>@item.TotalPrinciple.Format(item.CurrencyId)</ValueTemplete>
                    </DashbordItem>
                    <DashbordItem Title="@GetTitleInterest(item.CurrencyId)"
                                  Icon="@IconNames.Paid"
                                  BackgroundColor="@GetGradientColor(item.CurrencyId)">
                        <ValueTemplete>@item.TotalInterest.Format(item.CurrencyId)</ValueTemplete>
                    </DashbordItem>
                }
                <RequestSummaryCards Items="@AccSummaries?.RequestSummaries" />
            </div>

            <RadzenCard class="db-chart-card" Variant="Variant.Outlined">
                <div class="db-chart-header">
                    <RadzenIcon Icon="bar_chart" class="db-chart-icon" />
                    <span>@Loc["Loan Portfolio Overview"]</span>
                </div>
            </RadzenCard>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Policy="@Policies.ManagerOnly">
    <Authorized>
        <div class="db-page">
            <div class="db-header">
                <div class="db-header-text">
                    <span class="db-title">@Loc["Regional Branch Manager"]</span>
                    <span class="db-subtitle">@Loc["Review requests and approvals across the assigned branch"]</span>
                </div>
                <RadzenBadge Text="RBM" BadgeStyle="BadgeStyle.Danger" IsPill="true" />
            </div>

            <div class="db-cards">
                @if (ManagerSummaries is not null)
                {
                    <DashbordItem Title="@Loc["New Requests"]"
                                  Icon="@IconNames.Group"
                                  BackgroundColor="ColorEnum.Primary">
                        <ValueTemplete>@ManagerSummaries.NewRequest</ValueTemplete>
                    </DashbordItem>
                    <DashbordItem Title="@Loc["Approved Requests"]"
                                  Icon="@IconNames.AccountBalanceWallet"
                                  BackgroundColor="ColorEnum.Success">
                        <ValueTemplete>@ManagerSummaries.NumberApproved</ValueTemplete>
                    </DashbordItem>
                }
            </div>

            <RadzenCard class="db-chart-card" Variant="Variant.Outlined">
                <div class="db-chart-header">
                    <RadzenIcon Icon="bar_chart" class="db-chart-icon" />
                    <span>@Loc["Regional Performance Overview"]</span>
                </div>
            </RadzenCard>
        </div>
    </Authorized>
</AuthorizeView>

<BarChart @ref="barChart" Width="600" />