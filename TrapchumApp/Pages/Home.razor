@page "/"
@using Applications.Features.Documents.Dto
@using TrapchumApp.Helpers.Enums
@using TrapchumApp.Components.FileUploads
<PageTitle>Home</PageTitle>

<AuthorizeView Policy="@Policies.CreditOfficerOnly">
    <Authorized>
        <div class="db-page">
            <div class="db-header">
                <div class="db-header-text">
                    <span class="db-title">Credit Officer</span>
                    <span class="db-subtitle">Dashboard overview — due customers and performance</span>
                </div>
                <RadzenBadge Text="CO" BadgeStyle="BadgeStyle.Primary" IsPill="true" />
            </div>

            <div class="db-cards">
                @foreach (var item in CoSummaries ?? [])
                {
                    <DashbordItem BackgroundColor="@GetGradientColor(item.CurrencyId)"
                                  Icon="@IconNames.Customers"
                                  Title="Due Customers">
                        <ValueTemplete>@item.TotalCustomer</ValueTemplete>
                    </DashbordItem>
                    <DashbordItem BackgroundColor="ColorEnum.Danger"
                                  Icon="@IconNames.AccountBalanceWallet"
                                  Title="@GetTitlePriciple(item.CurrencyId)">
                        <ValueTemplete>@item.TotalPrinciple.Format(item.CurrencyId)</ValueTemplete>
                    </DashbordItem>
                    <DashbordItem BackgroundColor="ColorEnum.Warning"
                                  Icon="@IconNames.Paid"
                                  Title="@GetTitleInterest(item.CurrencyId)">
                        <ValueTemplete>@item.TotalInterest.Format(item.CurrencyId)</ValueTemplete>
                    </DashbordItem>
                }
                <DashbordItem BackgroundColor="ColorEnum.Success"
                              Icon="@IconNames.Group"
                              Title="Pending Requests">
                    <ValueTemplete>1000</ValueTemplete>
                </DashbordItem>
            </div>

            <RadzenCard class="db-chart-card" Variant="Variant.Outlined">
                <div class="db-chart-header">
                    <RadzenIcon Icon="bar_chart" class="db-chart-icon" />
                    <span>Performance Overview</span>
                </div>
                <RadzenRow>
                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenListBox class="db-period-list"
                                       Data="@_periods"
                                       TextProperty="Label"
                                       ValueProperty="Key"
                                       @bind-Value="@_selectedPeriod"
                                       Change="@((v) => OnParentClicked(v))"
                                       TValue="string" />
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="10">
                        <RadzenChart>
                            <RadzenColumnSeries Data="@revenue1" CategoryProperty="Quarter" ValueProperty="Revenue" Title="Principal" />
                            <RadzenColumnSeries Data="@revenue2" CategoryProperty="Quarter" ValueProperty="Revenue" Title="Interest" />
                            <RadzenLegend Position="LegendPosition.Bottom" />
                        </RadzenChart>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenCard>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Roles="@AppRoles.Manager">
    <Authorized>
        <div class="db-page">
            <div class="db-header">
                <div class="db-header-text">
                    <span class="db-title">Branch Manager</span>
                    <span class="db-subtitle">Monitor branch performance and lending activities</span>
                </div>
                <RadzenBadge Text="BM" BadgeStyle="BadgeStyle.Info" IsPill="true" />
            </div>

            <div class="db-cards">
                @if (ManagerSummaries is not null)
                {
                    <DashbordItem Title="New Requests"
                                  Icon="@IconNames.Group"
                                  BackgroundColor="ColorEnum.Primary">
                        <ValueTemplete>@ManagerSummaries.NewRequest</ValueTemplete>
                    </DashbordItem>
                    <DashbordItem Title="Approved Requests"
                                  Icon="@IconNames.AccountBalanceWallet"
                                  BackgroundColor="ColorEnum.Success">
                        <ValueTemplete>@ManagerSummaries.NumberApproved</ValueTemplete>
                    </DashbordItem>
                }
            </div>

            <RadzenCard class="db-chart-card" Variant="Variant.Outlined">
                <div class="db-chart-header">
                    <RadzenIcon Icon="bar_chart" class="db-chart-icon" />
                    <span>Branch Lending Performance</span>
                </div>
                <RadzenChart>
                    <RadzenColumnSeries Data="@revenue1" CategoryProperty="Quarter" ValueProperty="Revenue" Title="Principal" />
                    <RadzenColumnSeries Data="@revenue2" CategoryProperty="Quarter" ValueProperty="Revenue" Title="Interest" />
                    <RadzenLegend Position="LegendPosition.Bottom" />
                </RadzenChart>
            </RadzenCard>
        </div>
    </Authorized>
</AuthorizeView>

<AuthorizeView Policy="@Policies.AccountOnly">
    <Authorized>
        <div class="db-page">
            <div class="db-header">
                <div class="db-header-text">
                    <span class="db-title">Account &amp; Teller</span>
                    <span class="db-subtitle">Track due customers and daily approved loan requests</span>
                </div>
                <RadzenBadge Text="ACC" BadgeStyle="BadgeStyle.Warning" IsPill="true" />
            </div>

            <div class="db-cards">
                @foreach (var item in AccSummaries ?? [])
                {
                    <DashbordItem Title="@GetTitle(item.CurrencyId)"
                                  BackgroundColor="@GetGradientColor(item.CurrencyId)">
                        <ValueTemplete>@item.TotalCustomer</ValueTemplete>
                    </DashbordItem>
                    <DashbordItem Title="@GetTitlePriciple(item.CurrencyId)"
                                  Icon="@IconNames.AccountBalanceWallet"
                                  BackgroundColor="@GetGradientColor(item.CurrencyId)">
                        <ValueTemplete>@item.TotalPrinciple.Format(item.CurrencyId)</ValueTemplete>
                    </DashbordItem>
                    <DashbordItem Title="@GetTitleInterest(item.CurrencyId)"
                                  Icon="@IconNames.Paid"
                                  BackgroundColor="@GetGradientColor(item.CurrencyId)">
                        <ValueTemplete>@item.TotalInterest.Format(item.CurrencyId)</ValueTemplete>
                    </DashbordItem>
                }
                <DashbordItem Title="Approved Requests"
                              Icon="@IconNames.Group"
                              BackgroundColor="@ColorEnum.Info">
                    <ValueTemplete>@_numberOfLoanRequest</ValueTemplete>
                </DashbordItem>
            </div>

            <RadzenCard class="db-chart-card" Variant="Variant.Outlined">
                <div class="db-chart-header">
                    <RadzenIcon Icon="bar_chart" class="db-chart-icon" />
                    <span>Loan Portfolio Overview</span>
                </div>
                <RadzenChart>
                    <RadzenColumnSeries Data="@revenue1" CategoryProperty="Quarter" ValueProperty="Revenue" Title="Principal" />
                    <RadzenColumnSeries Data="@revenue2" CategoryProperty="Quarter" ValueProperty="Revenue" Title="Interest" />
                    <RadzenLegend Position="LegendPosition.Bottom" />
                </RadzenChart>
            </RadzenCard>
        </div>
    </Authorized>
</AuthorizeView>

