@page "/"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Branches.Queries.GetBranchByUser
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Dashbaord.Accountants.Dtos
@using Applications.Features.Dashbaord.Accountants.Queries.GetDbAccountLoanSummaery
@using Applications.Features.Dashbaord.Accountants.Queries.GetDbApprovedLoanRequest
@using Applications.Features.Dashbaord.CreditOfficers.Dtos
@using Applications.Features.Dashbaord.CreditOfficers.Queries.GetDbCreditOfficeLoanSummary
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Domains.Models.Identity
@using TrapchumApp.Helpers.Enums
@using TrapchumApp.Helpers.Extensions
@using Microsoft.AspNetCore.SignalR.Client

<PageTitle>Home</PageTitle>
<NotificationToast UserId="@UserId" />
<AuthorizeView Policy="@Policies.CreditOfficerOnly">
    <Authorized>
        <InfoBox Title="CO"
                 Subtitle="This Month"
                 Count="1250"
                 PercentageIncrease="15.5"
                 Icon="shopping_cart"
                 GradientStart="#FFFFFF"
                 GradientEnd="#2196FA"
                 OnMoreInfoClick="@HandleMoreInfo">
            <ChildContent>
                <main class="dashboard-container">
                    <section class="cards">
                        @foreach (var item in CoSummaries ?? [])
                        {
                            <DashbordItem BackgroundColor="@GetGradientColor(item.CurrencyId)"
                                          Icon="@IconNames.Customers"
                                          Title="Due Customers">
                                <ValueTemplete>
                                    @item.TotalCustomer
                                </ValueTemplete>
                            </DashbordItem>
                            <DashbordItem BackgroundColor="ColorEnum.Danger"
                                          Icon="@IconNames.AccountBalanceWallet"
                                          Title="@GetTitlePriciple(item.CurrencyId)">
                                <ValueTemplete>
                                    @item.TotalPrinciple.Format(item.CurrencyId)
                                </ValueTemplete>
                            </DashbordItem>
                            <DashbordItem BackgroundColor="ColorEnum.Warning"
                                          Icon="@IconNames.Paid"
                                          Title="@GetTitleInterest(item.CurrencyId)">
                                <ValueTemplete>
                                    @item.TotalInterest.Format(item.CurrencyId)
                                </ValueTemplete>
                            </DashbordItem>
                        }
                        <DashbordItem BackgroundColor="ColorEnum.Success"
                                      Icon="@IconNames.Group"
                                      Title="Request">
                            <ValueTemplete>
                                1000
                            </ValueTemplete>
                        </DashbordItem>
                    </section>
                </main>
                <RadzenRow class="rz-my-2">
                    <RadzenColumn Size="2">
                        <RadzenPanelMenu Click="OnParentClicked" Multiple="true">
                            <RadzenPanelMenuItem Text="Today" Path="buttons" Icon="account_circle"></RadzenPanelMenuItem>
                            <RadzenPanelMenuItem Text="This Week" Path="menu" Icon="line_weight"></RadzenPanelMenuItem>
                            <RadzenPanelMenuItem Text="This Month" Path="fileinput" Icon="attach_file"></RadzenPanelMenuItem>
                            <RadzenPanelMenuItem Text="This Quarter" Path="dialog" Icon="perm_media"></RadzenPanelMenuItem>
                            <RadzenPanelMenuItem Text="This Symester" Path="notification" Icon="announcement"></RadzenPanelMenuItem>
                            <RadzenPanelMenuItem Text="This Year" Path="notification" Icon="announcement"></RadzenPanelMenuItem>
                            <RadzenPanelMenuItem Text="Custom" Path="notification" Icon="announcement"></RadzenPanelMenuItem>
                        </RadzenPanelMenu>
                    </RadzenColumn>
                    <RadzenColumn Size="10">
                        <div style="background-color:aliceblue">
                            <RadzenChart>
                                <RadzenColumnSeries Data="@revenue1" CategoryProperty="Quarter" LineType="LineType.Dashed"
                                                    ValueProperty="Revenue" />
                                <RadzenColumnSeries Data="@revenue2" CategoryProperty="Quarter"
                                                    LineType="LineType.Dashed"
                                                    ValueProperty="Revenue" />
                            </RadzenChart>
                        </div>
                    </RadzenColumn>
                </RadzenRow>

            </ChildContent>
        </InfoBox>
    </Authorized>
</AuthorizeView>
<AuthorizeView Roles="@AppRoles.Manager">
    <Authorized>
        <InfoBox Title="BM"
                 Subtitle="This Month"
                 Count="1250"
                 PercentageIncrease="15.5"
                 Icon="shopping_cart"
                 GradientStart="#2196F3"
                 GradientEnd="#64B5F6"
                 OnMoreInfoClick="@HandleMoreInfo">
            <ChildContent>
                <div style="background-color:aliceblue">
                    <RadzenChart>
                        <RadzenColumnSeries Data="@revenue1" CategoryProperty="Quarter" LineType="LineType.Dashed"
                                            ValueProperty="Revenue" />
                        <RadzenColumnSeries Data="@revenue2" CategoryProperty="Quarter" LineType="LineType.Dashed"
                                            ValueProperty="Revenue" />
                    </RadzenChart>
                </div>

            </ChildContent>
        </InfoBox>

    </Authorized>
</AuthorizeView>
<AuthorizeView Policy="@Policies.AccountOnly">
    <Authorized>
        <InfoBox Title="Account,Teller"
                 Subtitle="This Month"
                 Count="1250"
                 PercentageIncrease="15.5"
                 Icon="shopping_cart"
                 GradientStart="#FFFFFF"
                 GradientEnd="#2196FA"
                 OnMoreInfoClick="@HandleMoreInfo">

            <ChildContent>
                <div class="dashboard-container">
                    <div class="cards">
                        @foreach (var item in AccSummaries ?? [])
                        {
                            <DashbordItem Title="@GetTitle(item.CurrencyId)"
                                          BackgroundColor="@GetGradientColor(item.CurrencyId)">
                                <ValueTemplete>
                                    @item.TotalCustomer
                                </ValueTemplete>
                            </DashbordItem>
                            <DashbordItem Title="@GetTitlePriciple(item.CurrencyId)"
                                          Icon="@IconNames.AccountBalanceWallet"
                                          BackgroundColor="@GetGradientColor(item.CurrencyId)">
                                <ValueTemplete>
                                    @item.TotalPrinciple.Format(item.CurrencyId)
                                </ValueTemplete>
                            </DashbordItem>
                            <DashbordItem Title="@GetTitleInterest(item.CurrencyId)"
                                          Icon="@IconNames.Paid"
                                          BackgroundColor="@GetGradientColor(item.CurrencyId)">
                                <ValueTemplete>
                                    @item.TotalInterest.Format(item.CurrencyId)
                                </ValueTemplete>
                            </DashbordItem>

                        }
                        <DashbordItem Title="LoanRequest"
                                      BackgroundColor="@ColorEnum.Info">
                            <ValueTemplete>
                                @_numberOfLoanRequest
                            </ValueTemplete>
                        </DashbordItem>
                    </div>
                </div>
            </ChildContent>
        </InfoBox>
    </Authorized>
</AuthorizeView>
<AuthorizeView Policy="@Policies.ManagerOnly">
    <Authorized>
        <InfoBox Title="RBM"
                 Subtitle="This Month"
                 Count="1250"
                 PercentageIncrease="15.5"
                 Icon="shopping_cart"
                 GradientStart="#2196F3"
                 GradientEnd="#64B5F6"
                 OnMoreInfoClick="@HandleMoreInfo">

            <ChildContent>
                @if (ManagerSummaries is not null)
                {
                    <div class="dashboard-container">
                        <div class="cards">
                            <DashbordItem Title="sdshsjdsjdh"
                                          BackgroundColor="ColorEnum.Primary">
                                <ValueTemplete>
                                    @ManagerSummaries.NewRequest
                                </ValueTemplete>
                            </DashbordItem>
                            <DashbordItem Title="Number Approved Requests"
                                          Icon="@IconNames.AccountBalanceWallet"
                                          BackgroundColor="ColorEnum.Success">
                                <ValueTemplete>
                                    @ManagerSummaries.NumberApproved
                                </ValueTemplete>
                            </DashbordItem>

                        </div>
                    </div>
                }
            </ChildContent>

        </InfoBox>
    </Authorized>
</AuthorizeView>
