@page "/App/Department"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Microsoft.AspNetCore.Components.Web
@using TrapchumApp.Services
<PageTitle>Departments</PageTitle>
<RadzenTabs>
    <Tabs>
        <RadzenTabsItem Text="Departments">
            <GridToolbar SearchChanged="SearchChanged">
                <LeftChildren>
                    <RadzenButton Text="New Department"
                                  Click="ShowCreate"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small"
                                  Icon="add" />
                </LeftChildren>
                <RightChildren>
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenCheckBox TValue="bool" @bind-Value=@includeInactive Change="ex => ShowInactiveAndActive(ex)" Name="CheckBox1" />
                        <RadzenLabel Text="Include InActive" Component="CheckBox1" Style="margin-left:2px; vertical-align: middle;" />
                    </RadzenStack>
                </RightChildren>
            </GridToolbar>
            <RadzenDataGrid Responsive="true"
                            TItem="VDepartment"
                            Density="Density.Compact"
                            LoadData="LoadDepartmentData"
                            PageSize="@pageSize"
                            Count="@counts"
                            AllowPaging="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            ShowPagingSummary="true"
                            PagerPosition="PagerPosition.Bottom"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            AllowFiltering="true"
                            AllowSorting="true"
                            IsLoading="@isLoading"
                            PageSizeOptions="@StorageConstant.PageSizeOptions"
                            Data="@Departments">
                <Columns>
                    <RadzenDataGridColumn Width="5rem" Title="#"
                                          Context="c"
                                          Sortable="false"
                                          Property="@nameof(VDepartment.DepartmentId)">
                        <Template>
                            @(Departments.IndexOf(c) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(VDepartment.DepartmentName)"
                                          Title="Department"
                                          Width="14rem"
                                          Sortable="true" />
                    <RadzenDataGridColumn Property="@nameof(VDepartment.Description)"
                                          Title="Description"
                                          Sortable="false" />
                    <RadzenDataGridColumn Context="c"
                                          Title="Active"
                                          Width="4rem"
                                          Filterable="false"
                                          Sortable="false">
                        <Template>
                            <RadzenCheckBox TValue="bool"
                                            Value="@c.IsActive"
                                            Change="@((arg)=>OnCheckChanged(c.DepartmentId,arg))" />
                        </Template>

                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Filterable="false"
                                          Sortable="false"
                                          Title="Actions" Context="c" Width="4rem">
                        <Template>
                            <RadzenButton Size="ButtonSize.ExtraSmall"
                                          Icon="more_vert"
                                          Variant="Variant.Text"
                                          Click="@((args)=>ShowContextMenuWithContent(args,c.DepartmentId))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
                <LoadingTemplate>
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                               ShowValue="false" Value="100"
                                               ProgressBarStyle="ProgressBarStyle.Danger" />
                </LoadingTemplate>

            </RadzenDataGrid>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {

    void ShowContextMenuWithContent(MouseEventArgs args, int id)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu>
    <RadzenMenuItem Click="@(() => Details(id))" Icon="info" Text="Details" Value="@id"></RadzenMenuItem>
    <RadzenMenuItem Click="@(() => Edit(id))" Icon="edit" Text="Edit" Value="@id"></RadzenMenuItem>
    <RadzenMenuItem Click="@(() => Delete(id))" Icon="delete" Text="Delete" Value="@id"></RadzenMenuItem>
</RadzenMenu>
    );
    }

    async void SelectedPageChanged(int page)
    {
        pageIndex = 0;

        pageSize = page;

        await GetDepartments(searchText);
    }
    protected async Task OnCheckChanged(int? id, bool state)
    {

        var confirm = await DialogService.Confirm($"Do you want to deactivate department with ID#{id}?", options: new ConfirmOptions
        {
            CancelButtonText = "Cancel",
            OkButtonText = "OK",
        });

        if (confirm == false) return;

        var resultResponse = await _depService.ActivateOrDeactivate(id, state);

        if (resultResponse.IsSuccess)
        {

            NotificationService.Notify(NotificationSeverity.Success, resultResponse.Data);

            await GetDepartments(searchText);
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Success, resultResponse.ErrMessage);
        }

    }

}