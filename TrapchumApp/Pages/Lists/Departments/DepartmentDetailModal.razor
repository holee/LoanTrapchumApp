<PageTitle>Department Details</PageTitle>
<div class="container-fluid">
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center">
        <table class="table table-sm">
            <tbody>
                <tr>
                    <th class="table-light">Name</th>
                    <td>@department?.DepartmentName</td>
                </tr>
                <tr>
                    <th class="table-light">Description</th>
                    <td>@department?.Description</td>
                </tr>
                <tr>
                    <th class="table-light">Is Active</th>
                    <td>
                        <RadzenCheckBox TValue="bool" Value="@department!.IsActive" ReadOnly />
                    </td>
                </tr>
                <tr>
                    <th class="table-light">Is InUseed</th>
                    <td>
                        <RadzenCheckBox TValue="bool" Value="@department!.Used" ReadOnly />
                    </td>
                </tr>
            </tbody>
        </table>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.End">
        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                      Icon="cancel"
                      Text="Close"
                      Click="@(()=>DialogService.Close(null))"
                      Variant="Variant.Flat"
                      Size="ButtonSize.Small">
        </RadzenButton>
    </RadzenStack>
</div>



