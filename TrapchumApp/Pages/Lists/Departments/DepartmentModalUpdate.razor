@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.Entities
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Services
<RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
    <RadzenTemplateForm TItem="DepartmentDtoUpdate" Data=@model Submit=@Update>
        <RadzenStack>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenFormField Text="Department Name*" Variant="Variant.Flat" Style="width:100%">
                            <RadzenTextBox Name="DepartmentName" @bind-Value="model.DepartmentName" Style="width:100%" />
                            <RadzenRequiredValidator Component="DepartmentName" Text="Department name is required" Style="position: absolute" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenFormField Text="Description" Variant="Variant.Flat" Style="width:100%;margin-top:10px">
                            <RadzenTextBox Name="Description" @bind-Value="model.Description" Style="width:100%" />

                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenColumn>

            </RadzenRow>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" class="mt-2" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton ButtonType="ButtonType.Submit"
                          Text="Save"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small"
                          Icon="save"></RadzenButton>
            <RadzenButton Click="@((args) => DialogService!.Close(true))"
                          Variant="Variant.Text"
                          Text="Close"
                          Icon="cancel"
                          Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Secondary" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenStack>


