@using Applications.Commons.Messages.Activities
@using Applications.Exceptions
@using Applications.Features.Customers.Commands.ActivitiesCommand.ActitvityQuery.GetActivityById
@using Applications.Features.Customers.Commands.ActivitiesCommand.CreateActivity
@using Applications.Features.Customers.Commands.ActivitiesCommand.EditActivity
@using Applications.Utils
<EditForm Model="_activity" OnValidSubmit="@HandleFormSubmit">
    <input type="hidden" @bind="_activity.Id" />
    <FluentValidationValidator DisableAssemblyScanning="true" />
    <RadzenFormField Text="Activity Date" AllowFloatingLabel="true" class="rz-w-100">
        <RadzenDatePicker @bind-Value="@_activity.ActivityDate"
                          @bind-Value:format="yyyy-MMM-dd"
                          DateFormat="dd-MM-yyyy"
                          class="rz-w-100"></RadzenDatePicker>
    </RadzenFormField>
    <RadzenFormField Text="Description" AllowFloatingLabel="true" class="rz-w-100">
        <RadzenTextArea @bind-Value="@_activity.Description" class="rz-w-100" />
    </RadzenFormField>
    <RadzenStack class="rz-mt-2" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
        <RadzenButton Size="ButtonSize.ExtraSmall" class="rz-mt-2"
                      ButtonType="ButtonType.Submit"
                      Text="Save"
                      Icon="@IconNames.Save"
                      ButtonStyle="ButtonStyle.Success" />
        <RadzenButton Size="ButtonSize.ExtraSmall" class="rz-mt-2"
                      ButtonType="ButtonType.Button"
                      Text="Close"
                      Icon="@IconNames.Close"
                      Click="() => DialogService.Close(false)"
                      ButtonStyle="ButtonStyle.Danger" />

    </RadzenStack>

</EditForm>
@code {
    [CascadingParameter]
    Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    [Parameter] public string? CustomerId { get; set; }
    [Parameter] public int? ActivityId { get; set; } = 0;

    private ActivityDtoCreate _activity = new ActivityDtoCreate();

    private readonly IMediator _mediator;

    public CustomerActivitiesAdd(IMediator mediator)
    {
        _mediator = mediator;
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationState;

        if (auth.User.Identity!.IsAuthenticated)
        {
            _activity.CustomerRefId = CustomerId;
        }

        if (ActivityId > 0)
        {
            await GetActivityDetails(ActivityId);
        }


        await base.OnInitializedAsync();
    }

    async Task GetActivityDetails(int? id)
    {

        if (!id.HasValue && id.Value <= 0)
        {
            return;
        }

        var req = new GetActivityByIdQuery(ActivityId, CustomerId);

        var rsp = await _mediator.Send(req);

        if (!rsp.IsError)
        {
            _activity = new ActivityDtoCreate
            {
                Id = rsp.Value.ActivityId,
                Description = rsp.Value.Description,
                CustomerRefId = rsp.Value.CustomerRefId,
                Status = rsp.Value.Status,
                ActivityDate = rsp.Value.ActivityDate
            };
        }

        // To be implemented if needed
    }


    async Task HandleFormSubmit()
    {

        try
        {

            if (_activity.Id > 0)
            {
                var rsp = await _mediator.Send(new EditActivityCommand
                {
                    Id = _activity.Id,
                    Description = _activity.Description,
                    CustomerRefId = _activity.CustomerRefId,
                    ActivityDate = _activity.ActivityDate
                });

                if (!rsp.IsError)
                {
                    NotificationService.Notify(NotificationSeverity.Success, ActivityMessage.UpdateSuccess);
                    DialogService.Close(true);
                    return;
                }

            }
            else
            {
                var rsp = await _mediator.Send(new CreateActivityCommand
                {
                    Description = _activity.Description,
                    CustomerRefId = _activity.CustomerRefId,
                    ActivityDate = _activity.ActivityDate
                });

                if (!rsp.IsError)
                {
                    NotificationService.Notify(NotificationSeverity.Success, ActivityMessage.CreateSuccess);
                    DialogService.Close(true);
                    return;
                }

            }




        }
        catch (MediatorException ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }

    }


}
