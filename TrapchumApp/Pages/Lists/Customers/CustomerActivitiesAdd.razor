@using Applications.Features.Customers.Commands.ActivitiesCommand.CreateActivity
<EditForm Model="activity" OnValidSubmit="@HandleFormSubmit">
    <FluentValidationValidator DisableAssemblyScanning="true" />
    <RadzenFormField Text="Activity Date" AllowFloatingLabel="true" class="rz-w-100">
        <RadzenDatePicker @bind-Value="@activity.ActivityDate"
                          @bind-Value:format="yyyy-MMM-dd"
                          DateFormat="dd-MM-yyyy"
                          class="rz-w-100"></RadzenDatePicker>
    </RadzenFormField>
    <RadzenFormField Text="Description" AllowFloatingLabel="true" class="rz-w-100">
        <RadzenTextArea @bind-Value="@activity.Description" class="rz-w-100" />
    </RadzenFormField>
    <RadzenStack class="rz-mt-2" Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
        <RadzenButton Size="ButtonSize.ExtraSmall" class="rz-mt-2"
                      ButtonType="ButtonType.Submit"
                      Text="Save" 
                      Icon="@IconNames.Save"
                      ButtonStyle="ButtonStyle.Success" />
        <RadzenButton Size="ButtonSize.ExtraSmall" class="rz-mt-2"
                      ButtonType="ButtonType.Button"
                      Text="Close"
                      Icon="@IconNames.Close"
                      Click="()=>DialogService.Close(false)"
                      ButtonStyle="ButtonStyle.Danger" />

    </RadzenStack>

</EditForm>
@code {
    [CascadingParameter]
    Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    [Parameter] public string? CustomerId { get; set; }
    [Parameter] public long? ActivityId { get; set; } = 0;

    ActivityDtoCreate activity = new ActivityDtoCreate();

    private readonly AddCustomerActivityUseCase _custActivityAdd;

    public CustomerActivitiesAdd(AddCustomerActivityUseCase custActivityAdd)
    {
        _custActivityAdd = custActivityAdd;
    } 

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationState;

        if (auth.User.Identity!.IsAuthenticated)
        {
            activity.CustomerRefId = CustomerId;
        }
        await base.OnInitializedAsync();
    }

    void GetActivityDetails(int? id)
    {

        if (id.HasValue && id.Value > 0)
        {
            
        }
        // To be implemented if needed
    }


    async Task HandleFormSubmit()
    {
        var rsp = await _custActivityAdd.ExecuteAsync(activity);

        if (!rsp.IsError)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", rsp.FirstError.Description);
            return;
        }

        DialogService.Close(true);

    }


}
