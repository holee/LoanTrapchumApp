@page "/App/Customers/CreateNew"
@using Applications.Enumerations
@using Domains.Models.Files
@using TrapchumApp.Services
<Containers Fluid>
    <EditForm Model="model" @ref="editForm" OnValidSubmit="@FormSubmit">
        <FluentValidationValidator DisableAssemblyScanning="true"></FluentValidationValidator>
        <CreateCustomerInfo Model="@model" />
        <CustomerAddress Cities="@Cities"
                         model="@model"
                         Countries="@Countries" />

        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="1rem"
                     class="rz-mt-2"
                     JustifyContent="JustifyContent.End">
            <RadzenButton Size="ButtonSize.ExtraSmall"
                          ButtonStyle="ButtonStyle.Success"
                          ButtonType="ButtonType.Submit"
                          Text="Save & New"
                          Icon="save" />
            <RadzenButton Size="ButtonSize.ExtraSmall"
                          ButtonStyle="ButtonStyle.Success"
                          ButtonType="ButtonType.Submit"
                          Text="Save & Close"
                          Icon="save" />
            <RadzenButton Click="Close"
                          Size="ButtonSize.ExtraSmall"
                          Text="Close"
                          ButtonStyle="ButtonStyle.Danger"
                          Icon="cancel" />
        </RadzenStack>
    </EditForm>
</Containers>