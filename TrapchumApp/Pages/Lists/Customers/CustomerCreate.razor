@page "/App/Customers/CreateNew"
@using Applications.Enumerations
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Domains.Models.Files
@using TrapchumApp.Services
<Containers Fluid>
    <EditForm Model="model" @ref="@editForm">
        <FluentValidationValidator DisableAssemblyScanning="true"></FluentValidationValidator>
        <CreateCustomerInfo Model="@model" />
        <CustomerAddress Cities="@Cities"
                         model="@model"
                         Countries="@Countries" />

        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="1rem"
                     class="rz-mt-2"
                     JustifyContent="JustifyContent.End">
            <RadzenButton Size="ButtonSize.ExtraSmall"
                          ButtonStyle="ButtonStyle.Primary"
                          ButtonType="ButtonType.Button"
                          Text="Save & New"
                          Click="@SaveAndNew"
                          Icon="save" />
            <RadzenButton Size="ButtonSize.ExtraSmall"
                          ButtonStyle="ButtonStyle.Success"
                          ButtonType="ButtonType.Button"
                          Text="Save & Close"
                          Click="@SaveAndClose"
                          Icon="save" />
            <RadzenButton Click="Close"
                          Size="ButtonSize.ExtraSmall"
                          Text="Close"
                          ButtonStyle="ButtonStyle.Danger"
                          Icon="cancel" />
        </RadzenStack>
    </EditForm>
</Containers>

@code {

    async Task SaveAndClose()
    {
        if (editForm?.EditContext?.Validate() == false)
        {
            return;
        }
        await CreateAsync(true);
    }

    async Task SaveAndNew()
    {
        if (editForm?.EditContext?.Validate() == false)
        {
            return;
        }
        await CreateAsync(false);
    }
}