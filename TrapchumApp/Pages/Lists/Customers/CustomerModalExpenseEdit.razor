<EditForm Model="@model" OnValidSubmit="HandleFormSubmit">
    
    <RadzenFormField class="rz-w-100 rz-mt-2" Text="Expense Title" AllowFloatingLabel="true">
        <ChildContent>
            <RadzenTextBox @bind-Value="model.ExpenseTitle" class="rz-w-100" />
        </ChildContent>
    </RadzenFormField>
    
    <RadzenFormField class="rz-w-100 rz-mt-2" Text="Amount" AllowFloatingLabel="true">
        <ChildContent>
            <TCNumbers @bind-Value="model.Amount" />
        </ChildContent>
    </RadzenFormField>

    <RadzenFormField class="rz-w-100 rz-mt-2" Text="Description" AllowFloatingLabel="true">
        <ChildContent>
            <RadzenTextArea @bind-Value="model.Description" class="rz-w-100" />
        </ChildContent>
    </RadzenFormField>
    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 class="rz-mt-2"
                 Gap="1rem"
                 AlignItems="AlignItems.Center">
        <RadzenButton Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Success"
                      ButtonType="ButtonType.Submit"
                      Text="Save" Icon="@IconNames.Save" />

        <RadzenButton Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Danger"
                      Text="Close" 
                      Click="HandleClose"
                      Icon="@IconNames.Close" />
    </RadzenStack>
</EditForm>


