@using Applications.Enumerations
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.ViewModels.Loans.Requests
@using TrapchumApp.Services
<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End"
             class="rz-mb-2"
             Orientation="Orientation.Horizontal">
    <AuthorizeView Policy="@RequestsPolicies.Create">
        <Authorized>
            <RadzenButton Icon="add"
                          Click="AddLoanRequest"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small"
                          Text="Add Loan Request"></RadzenButton>
        </Authorized>
    </AuthorizeView>
</RadzenStack>
<RadzenDataGrid Data="_vLoanRequests"
                Responsive
                TItem="VLoanRequests"
                Density="Density.Compact">
    <Columns>
        <RadzenDataGridColumn Property="@nameof(VLoanRequests.RequestDate)"
                              Title="Date"
                              Context="c"
                              Sortable="false">
            <Template>
                @c.RequestDate.DayFirst()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VLoanRequests.CurrencyName)"
                              Title="Currency"
                              Sortable="false" />
        <RadzenDataGridColumn Property="@nameof(VLoanRequests.RequestAmount)"
                              Title="Amount"
                              Context="c"
                              TextAlign="TextAlign.Right"
                              Sortable="false">
            <Template>
                @c.RequestAmount.Format(c.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VLoanRequests.AprovedAmount)"
                              Title="Amount"
                              Context="c"
                              TextAlign="TextAlign.Right"
                              Sortable="false">
            <Template>
                @c.AprovedAmount.Format(c.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VLoanRequests.Summiter)"
                              Title="Summiter"
                              Sortable="false" />
        <RadzenDataGridColumn Property="@nameof(VLoanRequests.AprovedBy)"
                              Title="AprovedBy"
                              Sortable="false" />
        <RadzenDataGridColumn Property="@nameof(VLoanRequests.Status)"
                              Title="Status"
                              Sortable="false" />
        <RadzenDataGridColumn TextAlign="TextAlign.Center" Width="6rem"
                              Property="@nameof(VLoanRequests.LoanRequestId)"
                              Title="Actions"
                              Context="c"
                              Sortable="false">
            <Template>
                <AuthorizeView Policy="@RequestsPolicies.Request">
                    <Authorized>
                        <NavLink href="@($"/app/loan/{c.LoanRequestId}/request/{c.BranchId}/branches/{c.CustomerId}/details")">
                            Request
                        </NavLink>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="@($"/app/loan/{c.LoanRequestId}/request/{c.BranchId}/branches/{c.CustomerId}/details")">
                            Details
                        </NavLink>
                    </NotAuthorized>
                </AuthorizeView>
                <AuthorizeView Policy="@RequestsPolicies.Disburse">
                    <Authorized>
                        <NavLink href="@($"/app/loan/{c.LoanRequestId}/request/{c.BranchId}/branches/{c.CustomerId}/details")">
                            Details
                        </NavLink>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="@($"/app/loan/{c.LoanRequestId}/request/{c.BranchId}/branches/{c.CustomerId}/details")">
                            Details
                        </NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>
