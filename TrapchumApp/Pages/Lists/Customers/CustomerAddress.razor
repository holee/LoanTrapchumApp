@using Applications.Enumerations
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Applications.Requests.Lists.OtherNames
@using Domains.Models.Addresses
@using TrapchumApp.Services
<RadzenFieldset AllowCollapse="true" Collapsed="false" class="rz-mb-2">
    <HeaderTemplate>
        <RadzenIcon Icon="home" /><strong>Address</strong>
    </HeaderTemplate>
    <ChildContent>
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="6">
                <RadzenFormField class="rz-w-100" Text="Country">
                    <RadzenDropDown class="rz-w-100"
                                    Data="Countries"
                                    Disabled="true"
                                    AllowFiltering="true"
                                    Placeholder="Search Countries"
                                    FilterOperator="StringFilterOperator.Contains"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    @bind-Value="model.CountryName" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="City" class="rz-w-100">
                    <RadzenDropDown class="rz-w-100"
                                    Data="Cities"
                                    TValue="string"
                                    Placeholder="Search City"
                                    AllowFiltering="true"
                                    @onkeydown="OnKeyPress"
                                    Disabled="true"
                                    FilterOperator="StringFilterOperator.Contains"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    @bind-Value="model.City">
                    </RadzenDropDown>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-2">
            <RadzenColumn Size="6">
                <RadzenFormField Text="Province" class="rz-w-100">
                    <RadzenDropDown class="rz-w-100"
                                    Data="Provinces"
                                    Placeholder="Search Province"
                                    AllowFiltering="true"
                                    TextProperty="@nameof(ProvinceDto.ProInKhmer)"
                                    ValueProperty="@nameof(ProvinceDto.ProvinceId)"
                                    SelectedItemChanged="SelectedProvinceChanged"
                                    FilterOperator="StringFilterOperator.Contains"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    @bind-Value="model.ProvinceRefId">
                    </RadzenDropDown>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="District" class="rz-w-100">
                    <RadzenDropDown class="rz-w-100"
                                    Data="Districts"
                                    Placeholder="Search District"
                                    AllowFiltering="true"
                                    TextProperty="@nameof(DistrictDto.DisInKhmer)"
                                    ValueProperty="@nameof(DistrictDto.DistrictId)"
                                    SelectedItemChanged="SelectedDistrictChanged"
                                    FilterOperator="StringFilterOperator.Contains"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    @bind-Value="model.DistrictRefId">
                    </RadzenDropDown>
                </RadzenFormField>
            </RadzenColumn>

        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-2">
            <RadzenColumn Size="6">
                <RadzenFormField Text="Commune" class="rz-w-100">
                    <RadzenDropDown class="rz-w-100"
                                    Data="Communes"
                                    Placeholder="Search Commune"
                                    AllowFiltering="true"
                                    TextProperty="@nameof(CommuneDto.ComInKhmer)"
                                    ValueProperty="@nameof(CommuneDto.CommuneId)"
                                    SelectedItemChanged="SelectedCommuneChanged"
                                    FilterOperator="StringFilterOperator.Contains"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    @bind-Value="model.CommuneRefId">
                    </RadzenDropDown>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="Village" class="rz-w-100">
                    <RadzenDropDown class="rz-w-100"
                                    Data="Villages"
                                    Placeholder="Search Village"
                                    AllowFiltering="true"
                                    TextProperty="@nameof(VillageDto.VilInKhmer)"
                                    ValueProperty="@nameof(VillageDto.VillageId)"
                                    SelectedItemChanged="SelectedVillageChanged"
                                    FilterOperator="StringFilterOperator.Contains"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    @bind-Value="model.VillageRefId"></RadzenDropDown>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
    </ChildContent>
</RadzenFieldset>

