@page "/App/Customers/{CustomerId}/Edit"
@using TrapchumApp.Services
<PageTitle>Edit</PageTitle>
<Card>
    <CardBody>
        <EditForm Model="model" @ref="editForm">
            <input type="hidden" value="@model.CustomerId" />
            <RadzenAccordion Multiple="true">
                <Items>
                    <RadzenAccordionItem Text="Customer" Icon="support_agent" Selected="true">
                        <RadzenRow>
                            <RadzenColumn Size="6">
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        First Name
                                        <span class="text-danger">*</span>
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenTextBox @bind-Value="model.FirstName"
                                                       class="w-100"
                                                       Placeholder="First name..." />
                                        <ValidationMessage For="@(()=>model.FirstName)" />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Middle Name
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenTextBox @bind-Value="model.MiddleName"
                                                       class="w-100"
                                                       Placeholder="First name..." />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Last Name
                                        <span class="text-danger">*</span>
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenTextBox @bind-Value="model.LastName"
                                                       class="w-100"
                                                       Placeholder="middle name..." />
                                        <ValidationMessage For="@(()=>model.LastName)" />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Khmer Name
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenTextBox @bind-Value="model.AltName"
                                                       class="w-100"
                                                       Placeholder="ឈ្មោះខ្មែរ..." />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Salutation
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenDropDown @bind-Value="model.Salutation"
                                                        Chips="true"
                                                        Name="DropDownSalutions"
                                                        class="w-100"
                                                        TValue="string"
                                                        Data="Salutations">
                                            <ValueTemplate Context="s">
                                                <RadzenTextBox @bind-Value="model.Salutation"
                                                               @onkeydown="AddNewSalutation"
                                                               @oninput="OnTextChangedSalution"
                                                               Style="width:120%;height:120%;margin:-15px"
                                                               aria-labelledby="DropDownEditLabel" />
                                            </ValueTemplate>
                                        </RadzenDropDown>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Date Of Birth
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenDatePicker TValue="DateTime?"
                                                          @bind-Value="model.DateOfBirth"
                                                          @bind-Value:format="yyyy-MMM-dd"
                                                          class="w-100"
                                                          Placeholder="Date Of Birth">
                                        </RadzenDatePicker>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Married Status
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenDropDown @bind-Value="model.MarritalStatus"
                                                        class="w-100"
                                                        Data="Statuses">
                                        </RadzenDropDown>
                                    </div>
                                </div>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Occupation
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenDropDown class="w-100"
                                                        Data="Occupations"
                                                        AllowFiltering="true"
                                                        FilterOperator="StringFilterOperator.Contains"
                                                        TextProperty="OccupationTitle"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        ValueProperty="OccupationTitle"
                                                        @bind-Value="model.Occupation">
                                        </RadzenDropDown>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Phone
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenTextBox class="w-100"
                                                       @bind-Value="model.Phone"
                                                       Placeholder="Mobile phone..." />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Email
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenTextBox class="w-100"
                                                       @bind-Value="model.EmailAddress"
                                                       Placeholder="Email Address" />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Passport
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenTextBox class="w-100"
                                                       @bind-Value="model.PassportId"
                                                       Placeholder="Passport...." />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Nationality
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenTextBox class="w-100"
                                                       @bind-Value="model.Nationality"
                                                       Placeholder="Nationality...." />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Photo
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenUpload Auto="false"
                                                      Change="@(args=>HandleFileUpload(args,"Upload"))"
                                                      Progress=@(args => OnProgress(args, "Manual Upload"))
                                                      class="w-100"
                                                      InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select file" }})">
                                        </RadzenUpload>
                                    </div>
                                </div>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenAccordionItem>
                    <RadzenAccordionItem Text="Spouse" Icon="diversity_1" Selected="@(model.MarritalStatus=="Single"?false:true)">
                        <RadzenRow>
                            <RadzenColumn Size="6">
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Spouse Name
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenTextBox @bind-Value="model.SpouseName"
                                                       class="w-100"
                                                       Placeholder="Spouse name" />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Nationality
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenTextBox @bind-Value="model.SpouseNationality"
                                                       class="w-100"
                                                       Placeholder="Spouse Nationality" />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Passport No
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenTextBox @bind-Value="model.SpousePassport"
                                                       class="w-100"
                                                       Placeholder="Spouse Passport" />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Spouse Phone
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenTextBox @bind-Value="model.SpousePhoneNo"
                                                       class="w-100"
                                                       Placeholder="Spouse Phone" />
                                    </div>
                                </div>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Spouse Birth Date
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenDatePicker TValue="DateTime?"
                                                          class="w-100"
                                                          Placeholder="Spouse Date Of Birth"
                                                          @bind-Value:format="yyyy-MMM-dd"
                                                          @bind-Value="model.SpouseDateOfBirth">
                                        </RadzenDatePicker>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Spouse Occupation
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenDropDown class="w-100"
                                                        Data="Occupations"
                                                        AllowFiltering="true"
                                                        FilterOperator="StringFilterOperator.Contains"
                                                        TextProperty="OccupationTitle"
                                                        Placeholder="Search Occupations"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        ValueProperty="OccupationTitle"
                                                        @bind-Value="model.SpouseOccupation">
                                        </RadzenDropDown>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Dependents
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenNumeric TValue="int?"
                                                       class="w-100"
                                                       Min="0"
                                                       Max="12"
                                                       @bind-Value="model.Dependents" />
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">
                                        Children
                                    </label>
                                    <div class="col-sm-9">
                                        <RadzenNumeric TValue="int?"
                                                       Min="0"
                                                       Max="12"
                                                       class="w-100"
                                                       @bind-Value="model.NoOfChildren" />
                                    </div>
                                </div>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenAccordionItem>
                    <RadzenAccordionItem Text="Address" Icon="home">
                        <RadzenRow>
                            <RadzenColumn Size="6">
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">Country</label>
                                    <div class="col-sm-9">
                                        <RadzenDropDown class="w-100"
                                                        Data="Countries"
                                                        AllowFiltering="true"
                                                        Placeholder="Search Countries"
                                                        FilterOperator="StringFilterOperator.Contains"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        @bind-Value="model.CountryName">
                                        </RadzenDropDown>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">Province</label>
                                    <div class="col-sm-9">
                                        <RadzenDropDown class="w-100"
                                                        Data="ProvinceList"
                                                        Placeholder="Search Province"
                                                        AllowFiltering="true"
                                                        TextProperty="@nameof(ProvinceDto.ProInKhmer)"
                                                        ValueProperty="@nameof(ProvinceDto.ProvinceId)"
                                                        @bind-Value:after="GetDistrictsByprovince"
                                                        FilterOperator="StringFilterOperator.Contains"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        @bind-Value="model.ProvinceRefId">
                                        </RadzenDropDown>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">Commune</label>
                                    <div class="col-sm-9">
                                        <RadzenDropDown class="w-100"
                                                        Data="CommuneList"
                                                        Placeholder="Search Province"
                                                        AllowFiltering="true"
                                                        TextProperty="@nameof(CommuneDto.ComInKhmer)"
                                                        ValueProperty="@nameof(CommuneDto.CommuneId)"
                                                        @bind-Value:after="GetVillagesByCommune"
                                                        FilterOperator="StringFilterOperator.Contains"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        @bind-Value="model.CommuneRefId">
                                        </RadzenDropDown>
                                    </div>
                                </div>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">City</label>
                                    <div class="col-sm-9">
                                        <RadzenDropDown class="w-100"
                                                        Data="Cities"
                                                        TValue="string"
                                                        Placeholder="Search City"
                                                        AllowFiltering="true"
                                                        @onkeydown="OnKeyPress"
                                                        FilterOperator="StringFilterOperator.Contains"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        @bind-Value="model.City">
                                        </RadzenDropDown>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">District</label>
                                    <div class="col-sm-9">
                                        <RadzenDropDown class="w-100"
                                                        Data="DistrictList"
                                                        Placeholder="Search Province"
                                                        AllowFiltering="true"
                                                        TextProperty="@nameof(DistrictDto.DisInKhmer)"
                                                        ValueProperty="@nameof(DistrictDto.DistrictId)"
                                                        @bind-Value:after="GetCommunesByDistrict"
                                                        FilterOperator="StringFilterOperator.Contains"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        @bind-Value="model.DistrictRefId">
                                        </RadzenDropDown>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <label class="col-sm-3 col-form-label">Village</label>
                                    <div class="col-sm-9">
                                        <RadzenDropDown class="w-100"
                                                        Data="VillageList"
                                                        Placeholder="Search Village"
                                                        AllowFiltering="true"
                                                        TextProperty="@nameof(VillageDto.VilInKhmer)"
                                                        ValueProperty="@nameof(VillageDto.VillageId)"
                                                        FilterOperator="StringFilterOperator.Contains"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        @bind-Value="model.VillageRefId"></RadzenDropDown>
                                    </div>
                                </div>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenAccordionItem>
                </Items>
            </RadzenAccordion>
        </EditForm>
    </CardBody>
    <CardFooter>
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="1rem"
                     JustifyContent="JustifyContent.End">
            <RadzenButton Click="HandleFormUpdate"
                          Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Success"
                          Text="Save"
                          Icon="save" />
            @if (!ShowEditTab)
            {
                <RadzenLink Path="/App/Customer" Icon="arrow_back" Text="Back" />
            }
            else
            {
                <RadzenButton Click="ClickCloseTab"
                              Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Danger"
                              Text="Close"
                              Icon="cancel" />
            }
        </RadzenStack>
    </CardFooter>
</Card>



