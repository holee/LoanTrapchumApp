@using Applications.Features.Incomes.Dto
<EditForm Model="@model" OnValidSubmit="HandleFormSubmit">
    <FluentValidationValidator DisableAssemblyScanning="true" />
    <input type="hidden" @bind="model.CustomerId" />
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="6">
            <RadzenFormField class="rz-w-100" Text="Income Source" AllowFloatingLabel="true">
                <ChildContent>
                    <RadzenDropDown Data="@_incomeExpenses"
                                    TextProperty="@nameof(IncomeExpenseDto.Description)"
                                    ValueProperty="@nameof(IncomeExpenseDto.Description)"
                                    AllowFiltering="true"
                                    LoadData="@LoadData"
                                    class="rz-w-100"
                                    Close="ClosedDropDown"
                                    @bind-SearchText="@SearchText"
                                    @bind-Value="model.IncomeSource">

                    </RadzenDropDown>
                </ChildContent>
                <Helper>
                    <ValidationMessage For="() => model.IncomeSource" />
                </Helper>
            </RadzenFormField>

        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenFormField class="rz-w-100" Text="Amount" AllowFloatingLabel="true">
                <ChildContent>
                    <TCNumbers @bind-Value="model.Amount" Min="0" />
                </ChildContent>
                <Helper>
                    <ValidationMessage For="() => model.Amount" />
                </Helper>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenFormField class="rz-w-100 rz-mt-2" Text="Description" AllowFloatingLabel="true">
        <ChildContent>
            <RadzenTextArea @bind-Value="model.Description" class="rz-w-100" />
        </ChildContent>
    </RadzenFormField>

    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 class="rz-mt-2"
                 Gap="1rem"
                 AlignItems="AlignItems.Center">
        <RadzenButton Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Success"
                      ButtonType="ButtonType.Submit"
                      Text="Save" Icon="@IconNames.Save" />

        <RadzenButton Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Danger"
                      Text="Close"
                      Click="CloseModal"
                      Icon="@IconNames.Close" />
    </RadzenStack>
</EditForm>
@code {

    private string? searchText = string.Empty;

    public string? SearchText
    {
        get => searchText;

        set
        {
            if (searchText != value)
            {
                searchText = value;
            }
        }
    }

    void ClosedDropDown()
    {
        _ = AddIfNotExists(SearchText ?? "");
    }

    private async Task AddIfNotExists(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return;

        model.IncomeSource = text;

        var exists = _incomeExpenses
                    .Any(x => x.Description
                        .Equals(text, StringComparison.OrdinalIgnoreCase));

        if (!exists)
        {
            var newItem = new IncomeExpenseDto
            {
                Description = text
            };

            _incomeExpenses.Insert(0, newItem);
        }

        StateHasChanged();
    }

}