@using Applications.Features.Incomes.Dto
<EditForm Model="@model" OnValidSubmit="HandleFormSubmit">
    <ValidationSummary />
    <input type="hidden" @bind="model.CustomerId"/>
    <RadzenFormField class="rz-w-100" Text="Income Source" AllowFloatingLabel="true">
        <ChildContent>
            <RadzenDropDown Data="@_incomeExpenses"
                            TextProperty="@nameof(IncomeExpenseDto.Description)"
                            ValueProperty="@nameof(IncomeExpenseDto.Description)"
                            AllowFiltering="true"
                            LoadData="@LoadData"
                            class="rz-w-100"
                            @bind-Value="model.IncomeSource">
            </RadzenDropDown>
        </ChildContent>
        <Helper>
            <ValidationMessage For="() => model.IncomeSource" />
        </Helper>
    </RadzenFormField>
    <RadzenFormField class="rz-w-100 rz-mt-2" Text="Description" AllowFloatingLabel="true">
        <ChildContent>
            <RadzenTextArea @bind-Value="model.Description" class="rz-w-100" />
        </ChildContent>
    </RadzenFormField>
    <RadzenFormField class="rz-w-100 rz-mt-2" Text="Amount" AllowFloatingLabel="true">
        <ChildContent>
            <TCNumbers @bind-Value="model.Amount" Min="0"/>
        </ChildContent>
        <Helper>
            <ValidationMessage For="@(() => model.Amount)" />
        </Helper>
    </RadzenFormField>

    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 class="rz-mt-2"
                 Gap="1rem"
                 AlignItems="AlignItems.Center">
        <RadzenButton Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Success"
                      ButtonType="ButtonType.Submit"
                      Text="Save" Icon="@IconNames.Save"/>

        <RadzenButton Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Danger"
                      Text="Close"
                      Click="CloseModal"
                      Icon="@IconNames.Close"/>
    </RadzenStack>
</EditForm>


