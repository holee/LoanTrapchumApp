<div class="inc-exp-panel inc-panel">
    <div class="inc-exp-header">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <div class="inc-exp-header__icon inc-icon">
                <RadzenIcon Icon="trending_up" />
            </div>
            <div>
                <div class="inc-exp-header__title">Income</div>
                <div class="inc-exp-header__subtitle">@Items.Count() record(s)</div>
            </div>
        </RadzenStack>
        @if (ShowCommand)
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.4rem">
                @if (ShowAdd)
                {
                    <RadzenButton Text="Add Income"
                                  Click="@AddInComeModal"
                                  Icon="add_circle_outline"
                                  ButtonStyle="ButtonStyle.Success"
                                  Variant="Variant.Filled"
                                  Size="ButtonSize.Small" />
                }
                @if (ShowReload)
                {
                    <RadzenButton Click="RefreshIncome"
                                  Icon="refresh"
                                  ButtonStyle="ButtonStyle.Light"
                                  Variant="Variant.Outlined"
                                  Size="ButtonSize.Small" />
                }
            </RadzenStack>
        }
    </div>

    <RadzenDataGrid Data="Items"
                    GridLines="DataGridGridLines.Horizontal"
                    Responsive
                    IsLoading="isLoading"
                    Style="min-height:18rem;max-height:24rem;"
                    Density="Density.Compact"
                    EmptyText="No income records found."
                    class="inc-exp-grid">
        <Columns>
            <RadzenDataGridColumn OrderIndex="0" Property="IncomeId" Context="c" Title="#" Width="3rem" TextAlign="TextAlign.Center" Sortable="false">
                <Template>
                    @{
                        var index = Items.ToList().IndexOf(c) + 1;
                    }
                    <span class="row-idx">@index</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="c" Property="IncomeSource" Title="Source">
                <Template>
                    <span class="cell-semibold">@c.IncomeSource</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="c" Property="InDescription" Title="Description">
                <Template>
                    <span class="cell-muted">@c.InDescription</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="c" Width="7.5rem" Property="IncomeAmount"
                                  TextAlign="TextAlign.Right" Title="Amount" Sortable="false">
                <Template>
                    <span class="cell-amount cell-amount--income">@(c?.IncomeAmount?.ToString("N2"))</span>
                </Template>
                <FooterTemplate>
                    <span class="cell-amount cell-amount--income cell-amount--total">
                        @((Items.Sum(x => x.IncomeAmount) ?? 0m).ToString("N2"))
                    </span>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="c" TextAlign="TextAlign.Center" Width="3rem"
                                  Property="IncomeId" Visible="@ShowAction" Title="" Sortable="false">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall"
                                  Variant="Variant.Text"
                                  ButtonStyle="ButtonStyle.Dark"
                                  Click="@((arg) => ShowContextMenu(arg, c))"
                                  Icon="@IconNames.MoreVert" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
        <LoadingTemplate>
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Success" Value="100"
                                       ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        </LoadingTemplate>
    </RadzenDataGrid>
</div>

@code {

    void ShowContextMenu(MouseEventArgs args, VCustomerIncomes c)
    {
        ContextMenuService.Open(args, ds =>
            @<RadzenMenu Style="font-size:0.8rem;">
                <RadzenMenuItem Click="@(() => GetEditIncome(c))" Icon="@IconNames.Edit" Text="Edit Income"
                                Value="@c.IncomeId"/>
                <RadzenMenuItem Click="@(() => DeleteIncome(c))" Icon="@IconNames.Delete" Text="Delete Income"
                                Value="@c.IncomeId"/>
            </RadzenMenu>
        );
    }


   
}