@page "/App/Customer"
@page "/App/Customer/{BranchId:int}/Branches"
@using Applications.Features.LoanRequests.Interfaces
<PageTitle>Customers</PageTitle>
<style>
    .rz-tabview-nav:hover button {
        visibility: visible;
    }

    .rz-tabview-nav button {
        visibility: hidden;
    }
</style>
<RadzenTabs RenderMode="TabRenderMode.Client" SelectedIndex="@selectedIndex"
            SelectedIndexChanged="SelectedTabChanged">
    <Tabs>
        <RadzenTabsItem Text="Customer" Icon="group">
            <CustomersList ClickedEdit="@AddEditTab"
                           ClickedAddCollateral="AddCollateralTab"
                           BranchId="@BranchId"
                           EditIndex="@EditIndex"
                           ClickedAdd="@AddCustomerTab"
                           ClickedDetails="@Details">
                <ChildContent>
                    <RadzenButton Icon="person_add"
                                  Text="Add Customer"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="@AddCustomerTab"
                                  Size="ButtonSize.Small">
                    </RadzenButton>
                </ChildContent>
            </CustomersList>
        </RadzenTabsItem>
        @foreach (var item in _tabs)
        {
            <RadzenTabsItem Icon="@item.Icon" Text="@item.Title" @key="@item.TabId">
                <Template>
                    <ClosedTab Title="@item.Title"
                               TabId="@item.TabId"
                               Closed="(() => CloseTab(item.TabId))" />
                </Template>
                <ChildContent>
                    @item.ChildContent
                </ChildContent>
            </RadzenTabsItem>
        }
    </Tabs>
</RadzenTabs>

@code {

    void EditIndex(int selectedTabIndex)
    {
        // selectedIndex = selectedTabIndex;

        // isEditTab = true;
    }

    async Task CreateCustomerQuick()
    {

        var options = new DialogOptions
        {
            Width = "45vw",
            Draggable = true,
            Resizable = false
        };

        await DialogService.OpenAsync<CustomerCreateQuick>("Quick Add", options: options);
    }
}



