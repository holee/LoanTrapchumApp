@page "/App/Customer"
@page "/App/Customer/{BranchId:int}/Branches"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Pages.Lists.Collaterals
@using TrapchumApp.Services
<PageTitle>Customers</PageTitle>
<style>
    .rz-tabview-nav:hover button {
        visibility: visible;
    }

    .rz-tabview-nav button {
        visibility: hidden;
    }
</style>
<RadzenTabs RenderMode="TabRenderMode.Server" SelectedIndex="@selectedIndex"
            SelectedIndexChanged="SelectedTabChanged">
    <Tabs>
        <RadzenTabsItem Text="Customer" Icon="group">
            <CustomersList ClickedEdit="@AddEditTab"
                           ClickedAddCollateral="AddCollateralTab"
                           BranchId="@BranchId"
                           EditIndex="@EditIndex"
                           ClickedAdd="AddCustomerTab"
                           ClickedDetails="Details">
                <ChildContent>
                    <RadzenButton Icon="person_add"
                                  Text="Add Customer"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="AddCustomerTab"
                                  Size="ButtonSize.Small">
                    </RadzenButton>
                </ChildContent>
            </CustomersList>
        </RadzenTabsItem>
        <RadzenTabsItem Text="New Customer" Icon="person_add" Visible="isNewTab">
            <Template>
                <CloseTabButton Title="New Customr" Closed="() => CloseTabe(selectedIndex)" />
            </Template>
            <ChildContent>
                <CustomerCreate Closed="CloseTabe" />
            </ChildContent>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Customer" Icon="info" Visible="@isDetailsTab">
            <Template>
                <CloseTabButton Title="Customr Details" Closed="() => CloseTabe(selectedIndex)" />
            </Template>
            <ChildContent>
                <CustomerDetails BranchId="@BranchId" Close="CloseTabe" CustomerId="@customerId" EditClick="@EditIndex" />
            </ChildContent>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Edit"
                        Icon="@IconNames.PersonEdit"
                        Visible="@isEditTab">
            <CustomerUpdateTab CustomerId="@customerId" Closed="CloseTabe" />
        </RadzenTabsItem>


    </Tabs>
</RadzenTabs>
@code {
    void EditIndex(int selectedTabIndex)
    {
        selectedIndex = selectedTabIndex;

        isEditTab = true;
    }

    async Task CreateCustomerQuick()
    {

        var options = new DialogOptions
        {
            Width = "45vw",
            Draggable = true,
            Resizable = false
        };

        await DialogService.OpenAsync<CustomerCreateQuick>("Quick Add", options: options);
    }
}