@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.ViewModels.Vendors
@using TrapchumApp.Services
<div>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenButton Click="ShowGuarantorModal"
                      Icon="add"
                      Text="Add New Guarantor"
                      ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small">
        </RadzenButton>
    </RadzenRow>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
        <div class="container-fluid">
            <div class="input-group">
                <span class="input-group-text"></span>
                <RadzenDropDownDataGrid Data="Guarantors"
                                        TValue="VGuarantorsAvailable"
                                        Placeholder="Guarantor Name"
                                        ValueChanged="SelectGuarantorChanged"
                                        Value="selectedGuarantor"
                                        TextProperty="@nameof(VGuarantorsAvailable.Name)"
                                        ValueProperty="@nameof(VGuarantorsAvailable.Id)"
                                        ValueExpression="@(()=>selectedGuarantor)">
                </RadzenDropDownDataGrid>
            </div>
        </div>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Sex</th>
                    <th>Phone</th>
                    <th>Address</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in SelectedGuarantors!)
                {
                    var index = SelectedGuarantors!.ToList().IndexOf(item) + 1;
                    <tr>
                        <td>@index</td>
                        <td>@item.Name</td>
                        <td>@item.Sex</td>
                        <td>@item.Phone</td>
                        <td>@item.ProInKhmer</td>
                        <td>
                            <RadzenButton Variant="Variant.Outlined"
                                          Size="ButtonSize.Small"
                                          Click="@(()=>RemoveGuarantor(item))"
                                          Icon="delete"
                                          ButtonStyle="ButtonStyle.Danger">
                            </RadzenButton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </RadzenStack>
</div>
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.End">
    <RadzenButton Size="ButtonSize.Small"
                  ButtonStyle="ButtonStyle.Success"
                  Icon="check_circle"
                  Text="Ok"
                  Click="CloseModal">
    </RadzenButton>
    <RadzenButton Size="ButtonSize.Small"
                  ButtonStyle="ButtonStyle.Danger"
                  Icon="cancel"
                  Text="Close"
                  Click="@(()=>DialogService.Close(false))">

    </RadzenButton>
</RadzenStack>

