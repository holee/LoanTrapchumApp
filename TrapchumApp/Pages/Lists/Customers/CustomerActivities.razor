@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Customers.UseCases
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Services
<RadzenStack Orientation="Orientation.Horizontal"
             class="rz-mb-2"
             Visible="ShowCommand"
             AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
    <RadzenButton Text="Add Activity"
                  Click="@AddNewActivity"
                  Icon="add"
                  Visible="@(ShowAdd && ShowCommand)"
                  ButtonStyle="ButtonStyle.Primary"
                  Size="ButtonSize.Small" />

    <RadzenButton Click="RefreshActivity"
                  Icon="refresh"
                  ButtonStyle="ButtonStyle.Secondary"
                  class="ml-2"
                  Visible="@(ShowReload && ShowCommand)"
                  Size="ButtonSize.Small" />

</RadzenStack>
<RadzenDataGrid Data="Items"
                GridLines="DataGridGridLines.Both"
                Responsive
                IsLoading="isLoading"
                ColumnWidth="10rem"
                Style="height:20rem;max-height:30rem;"
                TItem="VCustomerActivities"
                Density="Density.Compact">
    <Columns>
        <RadzenDataGridColumn Context="c" Width="5rem"
                              Property="@nameof(VCustomerActivities.CreatedDT)" 
                              Title="Created">
            <Template>
                @c.CreatedDT.DayFirst()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Width="10rem"
                              Property="@nameof(VCustomerActivities.Description)" Title="Description">
            <Template>
                @c.Description
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Width="5rem"
                              TextAlign="TextAlign.Center"
                              Property="@nameof(VCustomerActivities.Status)" Title="Status">
            <Template>
                <RadzenCheckBox Value="@c.Status" ReadOnly />
            </Template>
        </RadzenDataGridColumn>
        
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>



@code {
    [Parameter] public string? CustomerId { get; set; } = string.Empty;
    [Parameter] public bool ShowAdd { get; set; } = false;
    [Parameter] public bool ShowReload { get; set; } = false;
    [Parameter] public bool ShowCommand { get; set; } = false;
    [Parameter] public IEnumerable<VCustomerActivities> Items { get; set; } = [];


    private readonly GetCustomerActivityUseCase _custActivityGet;

    public CustomerActivities(GetCustomerActivityUseCase custActivityGet)
    {
        _custActivityGet = custActivityGet;
    }

    bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {

        if (!Items.Any())
        {
            await RefreshActivity();
        }

        await base.OnInitializedAsync();
    }

    async Task AddNewActivity()
    {

        var param = new Dictionary<string, object?>
        {
            {"CustomerId",CustomerId}
        };


        bool? addActivitieDialogue = await DialogService.OpenAsync<CustomerActivitiesAdd>("Activity", param);

        if (addActivitieDialogue is not null && addActivitieDialogue == true)
        {
            await RefreshActivity();
        }
    }
    async Task RefreshActivity()
    {
        isLoading = true;

        var rsp = await _custActivityGet.GetCustomerActivities(CustomerId);

        if (rsp.IsSuccess)
        {
            Items = rsp.Data ?? [];
        }

        isLoading = false;
    }
}
