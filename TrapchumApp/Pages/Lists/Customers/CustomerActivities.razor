@using Applications.Commons.Messages.Activities
@using Applications.Features.Activities.ActitvityQuery.GetActivityByCustomer
@using Applications.Features.Activities.Command.DeleteActivity
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Customers.UseCases
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using System.Threading.Tasks
@using TrapchumApp.Services
<RadzenStack Orientation="Orientation.Horizontal"
             class="rz-mb-2"
             Visible="ShowCommand"
             AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
    <RadzenButton Text="Add Activity"
                  Click="@AddNewActivity"
                  Icon="add"
                  Visible="@(ShowAdd && ShowCommand)"
                  ButtonStyle="ButtonStyle.Primary"
                  Size="ButtonSize.Small" />

    <RadzenButton Click="RefreshActivity"
                  Icon="refresh"
                  ButtonStyle="ButtonStyle.Secondary"
                  class="ml-2"
                  Visible="@(ShowReload && ShowCommand)"
                  Size="ButtonSize.Small" />

</RadzenStack>
<RadzenDataGrid Data="Items"
                GridLines="DataGridGridLines.Both"
                Responsive
                IsLoading="isLoading"
                TItem="VCustomerActivities"
                RowRender="@OnRowRender"
                Density="Density.Compact">
    <Columns>
        <RadzenDataGridColumn Context="c"
                              Width="3rem"
                              Property="@nameof(VCustomerActivities.ActivityId)"
                              Title="#">
            <Template>
                @c.RowIndex
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Width="8rem"
                              Property="@nameof(VCustomerActivities.ActivityDate)"
                              Title="Date">
            <Template>
                @c.ActivityDate.DayFirst()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Property="@nameof(VCustomerActivities.Description)"
                              Title="Description">
            <Template>
                @c.Description
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Width="5rem"
                              TextAlign="TextAlign.Center"
                              Property="@nameof(VCustomerActivities.Status)" Title="Status">
            <Template>
                <RadzenCheckBox Value="@c.Status" ReadOnly />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="5rem"
                              Title="Action"
                              TextAlign="TextAlign.Center"
                              Context="c"
                              Property="Created">
            <Template>
                <RadzenButton Size="ButtonSize.Small"
                              Shade="Shade.Dark"
                              Variant="Variant.Text"
                              Icon="@IconNames.MoreVert"
                              Click="@((arg) => ShowContextMenu(arg,c))"
                              ButtonStyle="ButtonStyle.Info">
                </RadzenButton>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>



@code {


    void ShowContextMenu(MouseEventArgs args, VCustomerActivities c)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Click="@(() => Details(c))" Icon="add" Text="Details" Value="@c.ActivityId" Visible="false" />
    <RadzenMenuItem Click="@(() => Edit(c))" Icon="money" Text="Edit" Value="@c.ActivityId" />
    <RadzenMenuItem Click="@(() => Delete(c))" Icon="@IconNames.Delete" Text="Delete" Value="@c.ActivityId" />
</RadzenMenu>
    );
    }


    [Parameter] public string CustomerId { get; set; } = string.Empty;
    [Parameter] public bool ShowAdd { get; set; } = false;
    [Parameter] public bool ShowReload { get; set; } = false;
    [Parameter] public bool ShowCommand { get; set; } = false;
    [Parameter] public IEnumerable<VCustomerActivities> Items { get; set; } = [];


    private readonly GetCustomerActivityUseCase _custActivityGet;

    public CustomerActivities(GetCustomerActivityUseCase custActivityGet)
    {
        _custActivityGet = custActivityGet;
    }

    bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {

        if (!Items.Any())
        {
            await RefreshActivity();
        }

        await base.OnInitializedAsync();
    }


    void Details(VCustomerActivities c)
    {
        var param = new Dictionary<string, object?>
        {
            {"ActivityId",c.ActivityId}
        };
        //DialogService.OpenAsync<CustomerActivitiesDetails>("Activity Details", param);
    }

    async Task Edit(VCustomerActivities c)
    {
        var param = new Dictionary<string, object?>
        {
            {"ActivityId",c.ActivityId},
            {"CustomerId",CustomerId}
        };

        var dia = await DialogService.OpenAsync<CustomerActivitiesAdd>("Edit Activity", param);

        if (dia is bool b && b == true)
        {
            await RefreshActivity();
        }
    }

    async Task Delete(VCustomerActivities c)
    {
        var confirm = await DialogService.Confirm(ActivityMessage.ConfirmDelete, "Confirm Delete");

        if (confirm == false) return;

        var command = new DeleteActivityCommand(c.ActivityId, CustomerId);

        var result = await mediator.Send(command);

        if (!result.IsError)
        {

            await RefreshActivity();

            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Success", Detail = ActivityMessage.DeleteSuccess, Duration = 4000 });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Error", Detail = result.FirstError.Description, Duration = 4000 });
        }

    }

    async Task AddNewActivity()
    {

        var param = new Dictionary<string, object?>
        {
            {"CustomerId",CustomerId}
        };


        bool? addActivitieDialogue = await DialogService.OpenAsync<CustomerActivitiesAdd>("Activity", param);

        if (addActivitieDialogue is not null && addActivitieDialogue == true)
        {
            await RefreshActivity();
        }
    }
    async Task RefreshActivity()
    {

        isLoading = true;
        var query = new GetActivityByCustomerIdQuery(CustomerId);

        var rsp = await mediator.Send(query); //_custActivityGet.GetCustomerActivities(CustomerId);

        if (!rsp.IsError)
        {
            Items = rsp.Value;
        }

        isLoading = false;
    }


    void OnRowRender(RowRenderEventArgs<VCustomerActivities> args)
    {
        args.Data.RowIndex = args.Index + 1; // store 1-based index
    }
}
