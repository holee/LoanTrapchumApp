@using CommunityToolkit.HighPerformance
@using Microsoft.AspNetCore.Components.Web
@using TrapchumApp.Helpers.Constants
@using TrapchumApp.Helpers.Extensions
@using TrapchumApp.Services
@attribute [MustHasPermission(Modules.Customers, Feature.Read)]
<style>
    .rz-grid-table td .rz-cell-data {
        line-height: 1.5rem;
        font-size: 0.8rem;
    }

</style>
<GridToolbar SearchChanged="SearchCustomer"
             CommandText="Add Customer"
             ShowCommandIcon="@IconNames.PersonAdd"
             ShowAddCommand="true"
             AddClick="@(() => AddCustomerTab(1))"
             Placeholder="Search Customer....">
    <RightChildren>
        <div class="text-start">
            <RadzenCheckBox TValue="bool" Value="@includeInactive" Change="@OnChanged" />
            <RadzenLabel Text="Include InActive" />
        </div>

    </RightChildren>
</GridToolbar>
<RadzenDataGrid Count="@counts"
                AllowColumnPicking="true"
                Responsive
                IsLoading="@isLoading"
                GridLines="DataGridGridLines.Both"
                Density="Density.Compact"
                AllowAlternatingRows="true"
                AllowRowSelectOnRowClick="true"
                AllowFiltering="true"
                AllowSorting="true"
                PageSize="@pageSize"
                PagerPosition="PagerPosition.Bottom"
                ShowPagingSummary="true"
                AllowPaging="true"
                PagerHorizontalAlign="HorizontalAlign.Right"
                LoadData="@LoadData"
                TItem="VCustomerList"
                PageSizeOptions="@StorageConstant.PageSizeOptions"
                PageSizeChanged="PageSizeChanged"
                RowRender="OnRowRender"
                RowSelect="OnRowSelected"
                CellRender="@OnCellRender"
                Data="@VCustomers">
    <HeaderTemplate>

    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Title="#"
                              Width="4rem"
                              Context="c"
                              Property="@nameof(VCustomerList.CustomerId)"
                              TextAlign="TextAlign.Center"
                              Pickable="false"
                              Filterable="false"
                              Sortable="false">
            <Template>
                @(VCustomers?.IndexOf(c) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VCustomerList.AltName)"
                              Context="c"
                              Width="8rem"
                              Title="Name">
            <Template>
                <div class="wellNameFormat">
                    <span class="first">@c.AltName?.WellFormName().First</span>
                    <span class="second">@c.AltName?.WellFormName().Last</span>
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VCustomerList.FullName)"
                              Context="c"
                              Width="8rem"
                              Title="FullName">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="@nameof(VCustomerList.Phone)"
                              Context="c"
                              Width="8rem"
                              Property="Phone"
                              Sortable="true">
            <Template>
                @c.Phone
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Email)"
                              Context="c"
                              Width="10rem"
                              Property="@nameof(VCustomerList.EmailAddress)"
                              Sortable="false" />
        <RadzenDataGridColumn Context="c"
                              Sortable="false"
                              Filterable="false"
                              Title="Address">
            <Template>
                <div class="address">
                    <span class="province">
                        @c.ProInKhmer
                    </span>
                    <span class="district">
                        @c.DisInKhmer
                    </span>
                    <span class="commune">
                        @c.ComInKhmer
                    </span>
                    <span class="village">
                        @c.VilInKhmer
                    </span>
                </div>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Width="8rem"
                              TextAlign="TextAlign.Center"
                              Sortable="false"
                              Filterable="false"
                              Title="Loan Active">
            <Template>
                <RadzenCheckBox Value="@c.IsLoanActive" Disabled />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Width="5rem"
                              Sortable="false"
                              CssClass="z"
                              TextAlign="TextAlign.Center"
                              Filterable="false"
                              Pickable="false"
                              Title="Actions">
            <Template>
                <RadzenButton Size="ButtonSize.ExtraSmall"
                              Icon="@IconNames.MoreVert"
                              Variant="Variant.Text"
                              Click="@((args)=>ShowContextMenu(args,c))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
@code {
    void ShowContextMenu(MouseEventArgs args, VCustomerList c)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;" Click="OnMenuItemClick">
    <RadzenMenuItem Icon="add"
                    Click="@(()=>AddLoanRequest(c.CustomerId))"
                    Visible="@CanRequestLoan"
                    Text="Request Loan"
                    Value="@c.CustomerId"></RadzenMenuItem>
    <RadzenMenuItem Click="@(() => AddCollateral(c.CustomerId))" Icon="add" Text="Add Collateral" Value="@c.CustomerId" />
    <RadzenMenuItem Click="@(() => AddInComeModal(c.CustomerId))" Icon="money" Text="Add Income" Value="@c.CustomerId" />
    <RadzenMenuItem Click="@(() => AddExpenseModal(c.CustomerId))" Icon="paid" Text="Add Expense" Value="@c.CustomerId" />
    <RadzenMenuItem Click="@(() => AddDetails(c.CustomerId))" Icon="info" Text="Customer Details" Value="@c.CustomerId" />
    <RadzenMenuItem Visible="@IsAdminOnly" Click="@(() => AddEdit(c.CustomerId))" Icon="edit" Text="Edit" Value="@c.CustomerId" />
    <RadzenMenuItem Visible="@IsAdminOnly" Click="@(() => AddDelete(c.CustomerId))" Icon="delete" Text="Delete" Value="@c.CustomerId" />
</RadzenMenu>
    );
    }
}

