@using Applications.Features.Customers.Response
@using TrapchumApp.Helpers.Enums
@attribute [MustHasPermission(Modules.Customers, Feature.Read)]
<style>
    .rz-grid-table td .rz-cell-data {
        line-height: 1.5rem;
        font-size: 0.8rem;
    }

</style>
<input type="hidden" @bind="@filterText" />
<GridToolbar SearchChanged="SearchCustomer"
             CommandText="Add Customer"
             Value="@filterText"
             ShowCommandIcon="@IconNames.PersonAdd"
             ShowAddCommand="true"
             AddClick="@(() => AddCustomerTab(1))"
             Placeholder="Search Customer....">
    <RightChildren>
        <div class="text-start">
            <RadzenCheckBox TValue="bool" Value="@includeInactive" Change="@OnChanged" />
            <RadzenLabel Text="Include InActive" />
        </div>
    </RightChildren> 
</GridToolbar>
<RadzenDataGrid Count="@counts"
                AllowColumnPicking="true"
                Responsive
                IsLoading="@isLoading"
                GridLines="DataGridGridLines.Both"
                Density="Density.Compact"
                AllowAlternatingRows="true"
                AllowRowSelectOnRowClick="true"
                AllowFiltering="true"
                AllowSorting="true"
                PageSize="@pageSize"
                PagerPosition="PagerPosition.Bottom"
                ShowPagingSummary="true"
                AllowPaging="true"
                PagerHorizontalAlign="HorizontalAlign.Right"
                LoadData="@LoadData"
                TItem="VCustomerList"
                PageSizeOptions="@StorageConstant.PageSizeOptions"
                PageSizeChanged="PageSizeChanged"
                RowRender="OnRowRender"
                RowSelect="OnRowSelected"
                CellRender="@OnCellRender"
                RowDoubleClick="@OnRowDoubleClick"
                Data="@VCustomers">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center">
            <RadzenLabel id="DropDownEditLabel" Text="Filter" Component="DropDownEdit" />
            <RadzenDropDown @bind-Value=@value
                            Placeholder="Filter by"
                            TValue="int"
                            Data="@FilterConstant.CustomerFilters"
                            TextProperty="@nameof(FilterCustomer.Name)"
                            ValueProperty="@nameof(FilterCustomer.Id)"
                            SelectedItemChanged="@SelectedItemChanged"
                            Name="DropDownEdit">
            </RadzenDropDown>
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Title="#"
                              Width="4rem"
                              Context="c"
                              Property="@nameof(VCustomerDetails.CustomerId)"
                              TextAlign="TextAlign.Center"
                              Pickable="false"
                              Filterable="false"
                              Sortable="false">
            <Template>
                @(VCustomers?.IndexOf(c) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VCustomerDetails.AltName)"
                              Context="c"
                              Width="8rem"
                              Title="Name">
            <Template>
                <NavLink href="@($"/App/Customers/{c.CustomerId}/Details")">
                    <KhmerName AltName="@c.AltName" />
                </NavLink>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VCustomerDetails.FullName)"
                              Context="c"
                              Width="8rem"
                              Visible="false"
                              Title="FullName">
            <Template>
                <NavLink>
                    @c.FullName
                </NavLink>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="@nameof(VCustomerDetails.Phone)"
                              Context="c"
                              Width="8rem"
                              Property="Phone"
                              Sortable="true">
            <Template>
                @c.Phone
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Email"
                              Context="c"
                              Width="10rem"
                              Property="@nameof(VCustomerDetails.EmailAddress)"
                              Sortable="false" />
        <RadzenDataGridColumn Context="c"
                              Sortable="false"
                              Filterable="false"
                              Title="Address">
            <Template>
                <AddressInfo ComInKhmer="@c.ComInKhmer"
                             ProInKhmer="@c.ProInKhmer"
                             DisInKhmer="@c.DisInKhmer"
                             VilInKhmer="@c.VilInKhmer" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Width="8rem"
                              TextAlign="TextAlign.Center"
                              Sortable="false"
                              Filterable="false"
                              Title="Loan Active">
            <Template>
                <RadzenCheckBox Value="@c.IsLoanActive" Disabled />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Width="5rem"
                              Sortable="false"
                              CssClass="z"
                              TextAlign="TextAlign.Center"
                              Filterable="false"
                              Pickable="false"
                              Title="Actions">
            <Template>
                <RadzenButton Size="ButtonSize.ExtraSmall"
                              Icon="@IconNames.MoreVert"
                              Variant="Variant.Text"
                              Click="@((args)=>ShowContextMenu(args,c))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
@code {

    int value = 0;


    void ShowContextMenu(MouseEventArgs args, VCustomerList c)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;" Click="OnMenuItemClick">
    <RadzenMenuItem Icon="add"
                    Click="@(()=>AddLoanRequest(c.CustomerId))"
                    Visible="@CanRequestLoan"
                    Text="Request Loan"
                    Value="@c.CustomerId"></RadzenMenuItem>
    <RadzenMenuItem Click="@(() => AddCollateral(c.CustomerId))" Icon="add" Text="Add Collateral" Value="@c.CustomerId" />
    <RadzenMenuItem Click="@(() => AddInComeModal(c.CustomerId))" Icon="money" Text="Add Income" Value="@c.CustomerId" />
    <RadzenMenuItem Click="@(() => AddExpenseModal(c.CustomerId))" Icon="paid" Text="Add Expense" Value="@c.CustomerId" />
    <RadzenMenuItem Click="@(() => AddDetails(c.CustomerId))" Icon="info" Text="Customer Details" Value="@c.CustomerId" />
    <RadzenMenuItem Visible="@IsAdminOnly" Click="@(() => AddEdit(c.CustomerId))" Icon="edit" Text="Edit" Value="@c.CustomerId" />
    <RadzenMenuItem Visible="@IsAdminOnly" Click="@(() => AddDelete(c.CustomerId))" Icon="delete" Text="Delete" Value="@c.CustomerId" />
</RadzenMenu>
    );
    }
}

