@using Applications.Enumerations
@using Applications.Features.AdditionalInformations.Dto
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Documents.Dto
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.Lists.Entities
@using Domains.Models.Files
@using System.Text.Json
@using TrapchumApp.Services
<RadzenFieldset AllowCollapse="true" Collapsed="false" class="rz-mb-2">
    <HeaderTemplate>
        <RadzenIcon Icon="person" /><strong>Customer</strong>
    </HeaderTemplate>
    <ChildContent>
        @* === Top: Photo + Identity === *@
        <RadzenRow Gap="1rem" class="rz-mb-4">
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenCard Style="height:100%; display:flex; align-items:center; justify-content:center; padding:0.75rem;">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                        <input type="hidden" @bind="@tempUrl" />
                        <RadzenImage Path="@Model.Photo"
                                     Style="width:8rem;height:8rem;object-fit:cover;border-radius:50%;border:3px solid var(--rz-primary);" />
                        <RadzenUpload Auto="true"
                                      Multiple="false"
                                      Accept=".jpg,.png"
                                      Url="upload/customers/profiles"
                                      Complete="@OnFileUploadComplete"
                                      Progress="@UploadProgress"
                                      Error="@OnUploadError"
                                      Style="width:100%"
                                      ChooseText="@(Model.Photo == null ? "Upload Photo" : "Change Photo")"
                                      InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select file" }})">
                            <ChildContent>
                                <RadzenText TextStyle="TextStyle.Caption" TextAlign="TextAlign.Center"
                                            Style="color:var(--rz-text-tertiary-color);">
                                    .jpg /.png only
                                </RadzenText>
                            </ChildContent>
                        </RadzenUpload>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="10">
                <RadzenRow Gap="1rem">
                    @* --- Left half --- *@
                    <RadzenColumn Size="12" SizeMD="7">
                        <RadzenStack Gap="0.75rem">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Khmer Name" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                        <RadzenDropDown AllowFiltering="true"
                                                        Name="DropDownSalutions"
                                                        Style="flex:0 0 35%;"
                                                        TValue="string"
                                                        FilterOperator="StringFilterOperator.Contains"
                                                        Placeholder="Salutation"
                                                        @bind-Value="Model.Salutation"
                                                        Data="@Salutations" />
                                        <RadzenTextBox @bind-Value="Model.AltName"
                                                       Style="flex:1;"
                                                       AutoCompleteType="AutoCompleteType.Off"
                                                       Placeholder="ឈ្មោះខ្មែរ..." />
                                    </RadzenStack>
                                    <ValidationMessage For="@(() => Model.AltName)" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="First Name" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenTextBox @bind-Value="Model.FirstName"
                                                   class="rz-w-100"
                                                   AutoCompleteType="AutoCompleteType.Off"
                                                   Placeholder="First name..." />
                                    <ValidationMessage For="@(() => Model.FirstName)" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Last Name" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                        <RadzenTextBox @bind-Value="Model.MiddleName"
                                                       Style="flex:1;"
                                                       AutoCompleteType="AutoCompleteType.Off"
                                                       Placeholder="Middle..." />
                                        <RadzenTextBox @bind-Value="Model.LastName"
                                                       Style="flex:1;"
                                                       AutoCompleteType="AutoCompleteType.Off"
                                                       Placeholder="Last Name..." />
                                    </RadzenStack>
                                    <ValidationMessage For="@(() => Model.LastName)" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Date of Birth" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenDatePicker TValue="DateTime?"
                                                      @bind-Value="Model.DateOfBirth"
                                                      @bind-Value:format="yyyy-MMM-dd"
                                                      DateFormat="dd/MM/yyyy"
                                                      class="rz-w-100"
                                                      Placeholder="Date Of Birth" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Nationality" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenDropDown Data="_nationalities"
                                                    class="rz-w-100"
                                                    TextProperty="@nameof(NationalityDto.NationalityName)"
                                                    ValueProperty="@nameof(NationalityDto.NationalityName)"
                                                    @bind-Value="Model.Nationality" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Married?" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenDropDown @bind-Value="Model.MarritalStatus"
                                                    class="rz-w-100"
                                                    Data="@StorageConstant.MarritalOptions" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenColumn>

                    @* --- Right half --- *@
                    <RadzenColumn Size="12" SizeMD="5">
                        <RadzenStack Gap="0.75rem">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Status" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenStack Orientation="Orientation.Horizontal"
                                                 AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenCheckBox TValue="bool?" @bind-Value="Model.IsActive" />
                                        <RadzenLabel Text="@(Model.IsActive == true ? "Active" : "Inactive")"
                                                     Style="@(Model.IsActive == true
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         ? "color:var(--rz-success);"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         : "color:var(--rz-danger);")" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Phone" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="Model.Phone"
                                                   class="rz-w-100"
                                                   AutoCompleteType="AutoCompleteType.Off"
                                                   Placeholder="Mobile phone..." />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Email" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="Model.EmailAddress"
                                                   class="rz-w-100"
                                                   AutoCompleteType="AutoCompleteType.Off"
                                                   Placeholder="Email address..." />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="ID Card" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="Model.IdCard"
                                                   class="rz-w-100"
                                                   AutoCompleteType="AutoCompleteType.Off"
                                                   Placeholder="ID Card..." />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Passport" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="Model.PassportId"
                                                   class="rz-w-100"
                                                   AutoCompleteType="AutoCompleteType.Off"
                                                   Placeholder="Passport..." />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Occupation" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <OccupationDropDown TypeOf="@Domains.Shared.Enums.TypeOfEnum.Job"
                                                        ShowAdd="true"
                                                        @bind-Value="Model.Occupation" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
    </ChildContent>
</RadzenFieldset>

@if (Model.MarritalStatus != MarritalStateEnum.Single.ToString())
{
    <SpouseInfo model="@Model" Nationalities="@_nationalities" Occupations="@Occupations" />
}

@code {

    private string _errorMessage = string.Empty;
    private bool _isError = false;
    private int _progress = 0;
    private bool _isUploading = false;

    void OnFileUploadComplete(UploadCompleteEventArgs args)
    {
        if (string.IsNullOrEmpty(args.RawResponse))
        {
            Model.Photo = tempUrl;
            return;
        }

        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            var fileModels = JsonSerializer.Deserialize<DocumentDto>(args.RawResponse!, options);

            if (fileModels is not null)
            {
                Model.Photo = fileModels.FileUrl;
            }
            else
            {
                _isError = true;
                Model.Photo = tempUrl;
                _errorMessage = "Failed to parse upload response.";

            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error parsing upload response: {ex.Message}";

            logger.LogError(ex, "Error parsing upload response: {Message}", ex.Message);
        }



    }

    void OnUploadError(UploadErrorEventArgs args)
    {
        _isError = true;

        _errorMessage = $"Upload failed: {args.Message}";

        logger.LogError("Upload failed: {Message}", args.Message);

    }

    void UploadProgress(UploadProgressArgs args)
    {
        _isUploading = true;

        _progress = args.Progress;

        logger.LogInformation("Upload progress: {Progress}%", args.Progress);
    }
}