@using Applications.Enumerations
@using Applications.Features.AdditionalInformations.Dto
@using Applications.Features.AdditionalInformations.Queries.GetOccupations
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Documents.Dto
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.Lists.Entities
@using Domains.Models.Files
@using System.Text.Json
@using TrapchumApp.Services
<RadzenFieldset AllowCollapse="true" Collapsed="false" class="rz-mb-2">
    <HeaderTemplate>
        <RadzenIcon Icon="person" /><strong>Customer</strong>
    </HeaderTemplate>
    <ChildContent>
        <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
            <RadzenColumn Size="12" SizeMD="10">
                <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
                    <RadzenColumn Size="2" SizeMD="2" SizeSM="12">
                        ឈ្មោះ
                    </RadzenColumn>
                    <RadzenColumn Size="10" SizeMD="10" SizeSM="12">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="2">
                                <RadzenFormField Text="គោរព" class="rz-w-100">
                                    <BlaSalutation @bind-Value="@Model.Salutation" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="6">
                                <RadzenFormField Text="ឈ្មោះខ្មែរ" class="rz-w-100">
                                    <ChildContent>
                                        <RadzenTextBox @bind-Value="Model.AltName"
                                                       class="rz-w-100"
                                                       AutoCompleteType="AutoCompleteType.Off"
                                                       Placeholder="ឈ្មោះខ្មែរ..." />
                                    </ChildContent>
                                    <Helper>
                                        <ValidationMessage For="@(() => Model.AltName)" />
                                    </Helper>
                                </RadzenFormField>
                          
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="2">
                                <RadzenFormField Text="ស្ថានភាពអាពាហ៍ពិពាហ៍" class="rz-w-100">
                                    <RadzenDropDown @bind-Value="Model.MarritalStatus"
                                                    class="rz-w-100"
                                                    Data="@StorageConstant.MarritalOptions" />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="2">
                                <div class="rz-p-0 rz-text-align-center">
                                    <RadzenCheckBox TValue="bool?" @bind-Value="Model.IsActive" />
                                    <RadzenLabel Text="@(Model.IsActive == true ? "សកម្ម" : "អសកម្ម")"
                                                 Style="@(Model.IsActive == true ? "color:var(--rz-success);font-weight:600;" : "color:var(--rz-danger);font-weight:600;")" />
                                </div>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
                    <RadzenColumn Size="2">
                        ឈ្មោះឡាតាំង
                    </RadzenColumn>
                    <RadzenColumn Size="10">
                        <RadzenRow Gap="1rem">
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="នាមខ្លួន" class="rz-w-100">
                                    <ChildContent>
                                        <RadzenTextBox @bind-Value="Model.FirstName"
                                                       class="rz-w-100"
                                                       AutoCompleteType="AutoCompleteType.Off"
                                                       Placeholder="នាមខ្លួន..." />
                                    </ChildContent>
                                    <Helper>
                                        <ValidationMessage For="@(() => Model.FirstName)" />
                                    </Helper>
                                </RadzenFormField>
                   
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="នាមកណ្តាល" class="rz-w-100">
                                    <RadzenTextBox @bind-Value="Model.MiddleName"
                                                   class="rz-w-100"
                                                   AutoCompleteType="AutoCompleteType.Off"
                                                   Placeholder="នាមកណ្តាល..." />
                                </RadzenFormField>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMD="4">
                                <RadzenFormField Text="នាមត្រកូល" class="rz-w-100">
                                    <RadzenTextBox @bind-Value="Model.LastName"
                                                   class="rz-w-100"
                                                   AutoCompleteType="AutoCompleteType.Off"
                                                   Placeholder="នាមត្រកូល..." />
                                </RadzenFormField>
                                <ValidationMessage For="@(() => Model.LastName)" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="អត្តសញ្ញាណប័ណ្ណ" class="rz-w-100">
                            <RadzenTextBox @bind-Value="Model.IdCard"
                                           class="rz-w-100"
                                           AutoCompleteType="AutoCompleteType.Off"
                                           Placeholder="លេខអត្តសញ្ញាណប័ណ្ណ..." />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="លិខិតឆ្លងដែន" class="rz-w-100">
                            <RadzenTextBox @bind-Value="Model.PassportId"
                                           class="rz-w-100"
                                           AutoCompleteType="AutoCompleteType.Off"
                                           Placeholder="លេខលិខិតឆ្លងដែន..." />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="លេខទូរស័ព្ទ" class="rz-w-100">
                            <RadzenTextBox @bind-Value="Model.Phone"
                                           class="rz-w-100"
                                           AutoCompleteType="AutoCompleteType.Off"
                                           Placeholder="លេខទូរស័ព្ទ..." />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="3">
                        <RadzenFormField Text="អ៊ីមែល" class="rz-w-100">
                            <RadzenTextBox @bind-Value="Model.EmailAddress"
                                           class="rz-w-100"
                                           AutoCompleteType="AutoCompleteType.Off"
                                           Placeholder="អ៊ីមែល..." />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="ថ្ងៃខែឆ្នាំកំណើត" class="rz-w-100">
                            <RadzenDatePicker TValue="DateTime?"
                                              @bind-Value="Model.DateOfBirth"
                                              @bind-Value:format="yyyy-MMM-dd"
                                              DateFormat="dd/MM/yyyy"
                                              class="rz-w-100"
                                              Placeholder="dd/MM/yyyy" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="សញ្ជាតិ" class="rz-w-100">
                            <RadzenDropDown Data="_nationalities"
                                            class="rz-w-100"
                                            AllowFiltering="true"
                                            Placeholder="ជ្រើសរើសសញ្ជាតិ..."
                                            FilterOperator="StringFilterOperator.Contains"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            TextProperty="@nameof(NationalityDto.NationalityName)"
                                            ValueProperty="@nameof(NationalityDto.NationalityName)"
                                            @bind-Value="Model.Nationality" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenFormField Text="មុខរបរ" class="rz-w-100">
                            <BlaOccupation @bind-Value="@Model.Occupation" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenCard Style="height:100%;display:flex;align-items:center;justify-content:center;padding:0.25rem;">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                        <input type="hidden" @bind="@tempUrl" />
                        <RadzenImage Path="@Model.Photo"
                                     Style="width:8rem;height:8rem;object-fit:cover;border-radius:50%;border:3px solid var(--rz-primary);" />
                        <RadzenUpload Auto="true"
                                      Multiple="false"
                                      Accept=".jpg,.png"
                                      Url="upload/customers/profiles"
                                      Complete="@OnFileUploadComplete"
                                      Progress="@UploadProgress"
                                      Error="@OnUploadError"
                                      Style="width:100%"
                                      ChooseText="@(Model.Photo == null ? "បញ្ចូលរូបថត" : "ផ្លាស់ប្តូររូបថត")"
                                      InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select file" }})">
                            <ChildContent>
                                <RadzenText TextStyle="TextStyle.Caption" TextAlign="TextAlign.Center"
                                            Style="color:var(--rz-text-tertiary-color);">
                                    .jpg / .png
                                </RadzenText>
                            </ChildContent>
                        </RadzenUpload>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
    </ChildContent>
</RadzenFieldset>
@if (Model.MarritalStatus != MarritalStateEnum.Single.ToString())
{
    <SpouseInfo model="@Model" @key="@(Guid.NewGuid().ToString("N"))" />
}
<CustomerAddress model="@Model" @key="@(Guid.NewGuid().ToString("N"))" />
@code {

    private string _errorMessage = string.Empty;
    private bool _isError = false;
    private int _progress = 0;
    private bool _isUploading = false;

    void OnFileUploadComplete(UploadCompleteEventArgs args)
    {
        if (string.IsNullOrEmpty(args.RawResponse))
        {
            Model.Photo = tempUrl;
            return;
        }

        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            var fileModels = JsonSerializer.Deserialize<DocumentDto>(args.RawResponse!, options);

            if (fileModels is not null)
            {
                Model.Photo = fileModels.FileUrl;
            }
            else
            {
                _isError = true;
                Model.Photo = tempUrl;
                _errorMessage = "Failed to parse upload response.";

            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error parsing upload response: {ex.Message}";

            logger.LogError(ex, "Error parsing upload response: {Message}", ex.Message);
        }



    }

    void OnUploadError(UploadErrorEventArgs args)
    {
        _isError = true;

        _errorMessage = $"Upload failed: {args.Message}";

        logger.LogError("Upload failed: {Message}", args.Message);

    }

    void UploadProgress(UploadProgressArgs args)
    {
        _isUploading = true;

        _progress = args.Progress;

        logger.LogInformation("Upload progress: {Progress}%", args.Progress);
    }
}