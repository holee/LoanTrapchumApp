@using Applications.Enumerations
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.Lists.Entities
@using Domains.Models.Files
@using TrapchumApp.Services
<RadzenFieldset AllowCollapse="true" Collapsed="false" class="rz-mb-2">
    <HeaderTemplate>
        <RadzenIcon Icon="person" /><strong>Customer</strong>
    </HeaderTemplate>
    <ChildContent>
        @* === Top: Photo + Identity === *@
        <RadzenRow Gap="1rem" class="rz-mb-4">
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenCard Style="height:100%; display:flex; align-items:center; justify-content:center; padding:0.75rem;">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                        <input type="hidden" value="@tempUrl" />
                        <RadzenImage Path="@Model.Photo"
                                     Style="width:8rem;height:8rem;object-fit:cover;border-radius:50%;border:3px solid var(--rz-primary);" />
                        <RadzenUpload Change="@OnFileUpload"
                                      Auto="false"
                                      Multiple="false"
                                      Accept=".jpg,.jpeg,.png"
                                      Progress=@(args => OnProgress(args, "Single file upload"))
                                      Style="width:100%"
                                      ChooseText="@(Model.Photo == null ? "Upload Photo" : "Change Photo")"
                                      InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select file" }})">
                                <ChildContent>
                                <RadzenText TextStyle="TextStyle.Caption" TextAlign="TextAlign.Center"
                                            Style="color:var(--rz-text-tertiary-color);">
                                    .jpg / .png only
                                </RadzenText>
                                </ChildContent>
                        </RadzenUpload>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="10">
                <RadzenRow Gap="1rem">
                    @* --- Left half --- *@
                    <RadzenColumn Size="12" SizeMD="7">
                        <RadzenStack Gap="0.75rem">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Khmer Name" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                        <RadzenDropDown AllowFiltering="true"
                                                        Name="DropDownSalutions"
                                                        Style="flex:0 0 35%;"
                                                        TValue="string"
                                                        FilterOperator="StringFilterOperator.Contains"
                                                        Placeholder="Salutation"
                                                        @bind-Value="Model.Salutation"
                                                        Data="@Salutations" />
                                        <RadzenTextBox @bind-Value="Model.AltName"
                                                       Style="flex:1;"
                                                       Placeholder="ឈ្មោះខ្មែរ..." />
                                    </RadzenStack>
                                    <ValidationMessage For="@(() => Model.AltName)" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="First Name" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenTextBox @bind-Value="Model.FirstName"
                                                   class="rz-w-100"
                                                   Placeholder="First name..." />
                                    <ValidationMessage For="@(() => Model.FirstName)" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Last Name" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                        <RadzenTextBox @bind-Value="Model.MiddleName"
                                                       Style="flex:1;"
                                                       Placeholder="Middle..." />
                                        <RadzenTextBox @bind-Value="Model.LastName"
                                                       Style="flex:1;"
                                                       Placeholder="Last Name..." />
                                    </RadzenStack>
                                    <ValidationMessage For="@(() => Model.LastName)" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Date of Birth" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenDatePicker TValue="DateTime?"
                                                      @bind-Value="Model.DateOfBirth"
                                                      @bind-Value:format="yyyy-MMM-dd"
                                                      DateFormat="dd/MM/yyyy"
                                                      class="rz-w-100"
                                                      Placeholder="Date Of Birth" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Nationality" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenDropDown Data="Nationalities"
                                                    class="rz-w-100"
                                                    TextProperty="@nameof(Nationality.NationalityName)"
                                                    ValueProperty="@nameof(Nationality.NationalityName)"
                                                    @bind-Value="Model.Nationality" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Married?" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenDropDown @bind-Value="Model.MarritalStatus"
                                                    class="rz-w-100"
                                                    Data="@StorageConstant.MarritalOptions" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenColumn>

                    @* --- Right half --- *@
                    <RadzenColumn Size="12" SizeMD="5">
                        <RadzenStack Gap="0.75rem">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Status" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenStack Orientation="Orientation.Horizontal"
                                                 AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenCheckBox TValue="bool?" @bind-Value="Model.IsActive" />
                                        <RadzenLabel Text="@(Model.IsActive == true ? "Active" : "Inactive")"
                                                     Style="@(Model.IsActive == true
                                                                                                                                                      ? "color:var(--rz-success);"
                                                                                                                                                      : "color:var(--rz-danger);")" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Phone" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="Model.Phone"
                                                   class="rz-w-100"
                                                   Placeholder="Mobile phone..." />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Email" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="Model.EmailAddress"
                                                   class="rz-w-100"
                                                   Placeholder="Email address..." />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="ID Card" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="Model.IdCard"
                                                   class="rz-w-100"
                                                   Placeholder="ID Card..." />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Passport" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="Model.PassportId"
                                                   class="rz-w-100"
                                                   Placeholder="Passport..." />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Occupation" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <OccupationDropDown TypeOf="@Domains.Shared.Enums.TypeOfEnum.Job"
                                                        ShowAdd="true"
                                                        @bind-Value="Model.Occupation" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
    </ChildContent>
</RadzenFieldset>

@if (Model.MarritalStatus != MarritalStateEnum.Single.ToString())
{
    <SpouseInfo model="@Model"
                Nationalities="@Nationalities"
                Occupations="@Occupations" />
}
