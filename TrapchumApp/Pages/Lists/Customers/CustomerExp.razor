@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Services
<RadzenFieldset>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
            <RadzenIcon Icon="payments" /><b>Expense</b>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenStack AlignItems="AlignItems.Center"
                     Gap="1rem" Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.End"
                     Visible="@ShowCommand"
                     class="rz-mb-2">
            <RadzenButton Text="Expense"
                          Click="AddExpenseModal"
                          Icon="add"
                          Visible="@(ShowAdd && ShowCommand)"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.ExtraSmall" />
            <RadzenButton Click="RefreshIncome"
                          Icon="refresh"
                          ButtonStyle="ButtonStyle.Secondary"
                          class="ml-2"
                          Visible="@(ShowReload && ShowCommand)"
                          Size="ButtonSize.ExtraSmall" />
        </RadzenStack>
        <RadzenDataGrid Data="@Items"
                        GridLines="DataGridGridLines.Both"
                        Responsive
                        IsLoading="isLoading"
                        ColumnWidth="10rem"
                        Style="height:20rem;max-height:30rem;"
                        Density="Density.Compact">
            <Columns>
                <RadzenDataGridColumn Property="ExpendId" Context="c" Title="#" Width="3rem">
                    <Template>
                        @{
                            var index = Items.ToList()!.IndexOf(c) + 1;
                        }
                        @index
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="c"
                                      Width="10rem"
                                      Property="ExpenseTitle" Title="Expense">
                    <Template>
                        @c.ExpenseTitle
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="c"
                                      Width="10rem"
                                      TextAlign="TextAlign.Right"
                                      Property="expendAmount" Title="Amount">
                    <Template>
                        @c?.ExpendAmount
                    </Template>
                    <FooterTemplate>
                        <strong>
                            @Items!.Sum(x => x.ExpendAmount)
                        </strong>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="c"
                                      Property="ExDescription" Title="Description">
                    <Template>
                        @c.ExDescription
                    </Template>
                </RadzenDataGridColumn>
                 <RadzenDataGridColumn Context="c"
                                      TextAlign="TextAlign.Center"
                                      Width="3.5rem"
                                      Property="InDescription"
                                      Title="Actions">
                    <Template>
                        <RadzenButton Size="ButtonSize.ExtraSmall"
                                      Variant="Variant.Text"
                                      Click="@((arg) => ShowContextMenu(arg, c))"
                                      Icon="@IconNames.MoreVert" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <LoadingTemplate>
                <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
            </LoadingTemplate>
        </RadzenDataGrid>
    </ChildContent>
</RadzenFieldset>
