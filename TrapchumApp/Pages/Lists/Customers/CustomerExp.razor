    void ShowContextMenu(MouseEventArgs args, VCustomerExpenses c)
    {
    ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Click="@(() => GetEditExpense(c))" Icon="@IconNames.Edit" Text="Edit Expense" Value="@c.ExpendId" />
    <RadzenMenuItem Click="@(() => DeleteExpense(c))" Icon="@IconNames.Delete" Text="Delete Expense" Value="@c.ExpendId" />
    </RadzenMenu>
    );
    }


