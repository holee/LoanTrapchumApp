@using Applications.Features.Loans.Responses
@using Applications.Responses.ViewModels.Loans
<RadzenDataGrid GridLines="DataGridGridLines.Both"
                Responsive
                Density="Density.Compact"
                PagerHorizontalAlign="HorizontalAlign.Right"
                AllowPaging="true"
                PageSize="10"
                AllowSorting="false"
                Data="VLoanDisbursements">
    <Columns>
        <RadzenDataGridColumn Property="LoanDate"
                              Title="#"
                              Context="l"
                              Width="5rem"
                              TextAlign="TextAlign.Center"
                              Sortable="false">
            <Template>
                @(VLoanDisbursements.ToList().IndexOf(l) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="LoanDate"
                              Context="c"
                              Sortable="false">
            <Template>
                @c.RegisterDate!.Value.ToShortDateString()
            </Template>

        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Priciple"
                              Context="c"
                              Sortable="false">
            <Template>
                @c.Amount.Format(c.CurrencyId)
            </Template>

        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Interest"
                              Sortable="false">
            <Template>
                @context.InterestRate
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Fee"
                              Context="c"
                              Sortable="false">
            <Template>
                @c.CollectionFeeRate
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Last Payment"
                              Context="c"
                              Sortable="false">
            <Template>
                @c.LastPaymentDate!.Value.ToShortDateString()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Statust"
                              Context="c"
                              Sortable="false">
            <Template>
                @c.LoanStatus
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Action" Context="c">
            <Template>
                <RadzenButton Icon="@IconNames.MoreVert"
                              Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Text">
                </RadzenButton>
                <NavLink href="@($"/App/Loan/{c.LoanId}/Branches/{c.BranchId}/Currencies/{c.CurrencyId}")">Details</NavLink>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {

    void ShowContextMenu(MouseEventArgs args, VLoanDisbursments b)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Icon="add" Text="Details" Value="@b.LoanId" Visible="false" />
    <RadzenMenuItem Icon="money" Text="Recieve Payment" Value="@b.LoanId" />
</RadzenMenu>
    );
    }
}
