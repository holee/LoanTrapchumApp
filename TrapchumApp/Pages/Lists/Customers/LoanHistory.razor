@using Applications.Features.Loans.Responses
@using Applications.Responses.ViewModels.Loans
@using TrapchumApp.Pages.Transactions.Loans.Menu
<RadzenDataGrid GridLines="DataGridGridLines.Both"
                Responsive
                Density="Density.Compact"
                PagerHorizontalAlign="HorizontalAlign.Right"
                AllowPaging="true"
                PageSize="10"
                AllowSorting="false"
                Data="VLoanDisbursements">
    <Columns>
        <RadzenDataGridColumn Property="LoanDate"
                              Title="#"
                              Context="l"
                              Width="5rem"
                              TextAlign="TextAlign.Center"
                              Sortable="false">
            <Template>
                @(VLoanDisbursements.ToList().IndexOf(l) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="LoanDate"
                              Context="c"
                              Sortable="false">
            <Template>
                @c.RegisterDate!.Value.ToShortDateString()
            </Template>

        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Priciple"
                              Context="c"
                              Sortable="false">
            <Template>
                @c.Amount.Format(c.CurrencyId)
            </Template>

        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Interest"
                              Sortable="false">
            <Template>
                @context.InterestRate
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Fee"
                              Context="c"
                              Sortable="false">
            <Template>
                @c.CollectionFeeRate
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Last Payment"
                              Context="c"
                              Sortable="false">
            <Template>
                @c.LastPaymentDate!.Value.ToShortDateString()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Statust"
                              Context="c"
                              Sortable="false">
            <Template>
                @c.LoanStatus
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Action"
                              TextAlign="TextAlign.Center"
                              Context="c" Width="5rem">
            <Template>
                <RadzenButton Icon="@IconNames.MoreVert"
                              Size="ButtonSize.Small"
                              Click="((arg)=>ShowContextMenu(arg,c))"
                              Variant="Variant.Text">
                </RadzenButton>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {

    private string _getPaymentSchedulesUrl = "";
    private string _getSchedulePayOffUrl = "";
    private string _getChangeCreditAgentUrl = "";
    private string _getLoanDetailsUrl = "";
    private string _getLoanWriteOffUrl = "";

    void ShowContextMenu(MouseEventArgs args, VLoanDisbursments b)
    {
        ContextMenuService.Open(args, ds =>@<LoanMenu Data="@b" />);
    }


    async Task DownLoadScheduleAsExcel(VLoanDisbursments? p)
    {
        ContextMenuService.Close();

        if (p is not null)
        {
            if (p.LoanId.IsNotNullOrEmpty() && p.BranchId > 0)
            {
                await js.InvokeVoidAsync("open", $"/Reports/Schedules/{p.LoanId}/{p.BranchId}/Exel", "_blank");
            }
        }
    }
    private async Task DownLoadScheduleAsPdf(VLoanDisbursments? p)
    {
        ContextMenuService.Close();

        if (p is not null)
        {
            var fileName = $"Loan_Schedule_{Guid.CreateVersion7()}.pdf";

            if (p.LoanId.IsNotNullOrEmpty() && p.BranchId > 0)
            {
                await js.InvokeVoidAsync("open", $"/Reports/Schedules/{p.LoanId}/{p.BranchId}/{fileName}", "_blank");
            }
        }
    }


    void ShowContextMenuWithContent(MouseEventArgs args, VLoanDisbursments p)
    {

        _getSchedulePayOffUrl = $"/Loan/CreditAgent/{p.LoanId}/{p.CreditAgentRefId}?CustomerId={p.CustomerId}&BranchId={p.BranchId}&CurrencyId={p.CurrencyId}";

        _getPaymentSchedulesUrl = $"/App/Loans/{p.BranchId}/Branches/{p.LoanId}/Schedules?CreditAgentId={p.CreditAgentRefId}&CurrencyId={p.CurrencyId}";

        _getLoanDetailsUrl = $"/App/Loan/{p.LoanId}/Branches/{p.BranchId}/Currencies/{p.CurrencyId}";

        _getChangeCreditAgentUrl = $"App/Loans/Disbursments/Credit-Agent/{p.BranchId}/Branches?CreditAgentId={p.CreditAgentRefId}";

        ContextMenuService.Open(args, ds => @<RadzenMenu Style="font-size:0.8rem;">
            <RadzenMenuItem Icon="money"
                            Path="@_getPaymentSchedulesUrl"
                            Visible="@bState.CanRecievePayment"
                            Text="Recieve Payment"></RadzenMenuItem>
            <RadzenMenuItem Icon="paid"
                            Path="@_getSchedulePayOffUrl"
                            Visible="@bState.CanPayOff"
                            Text="Pay Off"></RadzenMenuItem>
            <RadzenMenuItem Icon="paid"
                            Path="@_getLoanWriteOffUrl"
                            Visible="@bState.CanWriteOff"
                            Text="Write Off"></RadzenMenuItem>
            <RadzenMenuItem Icon="change_circle"
                            Path="@_getChangeCreditAgentUrl"
                            Visible="@bState.IsManager"
                            Text="Change Credit Agent"></RadzenMenuItem>
            <RadzenMenuItem Icon="info"
                            Path="@_getLoanDetailsUrl"
                            Text="Schedule Details"></RadzenMenuItem>
            <RadzenMenuItem Icon="file_download"
                            Click="@(()=>DownLoadScheduleAsExcel(p))"
                            Text="Export Loan to Excel" />
            <RadzenMenuItem Icon="picture_as_pdf"
                            Click="@(()=>DownLoadScheduleAsPdf(p))"
                            Text="Export Loan to Pdf" />
        </RadzenMenu>
    );


    }

}

