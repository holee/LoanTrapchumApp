@using Applications.Features.Customers.UseCases
@using Applications.Utils
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Services
<RadzenRow>
    <RadzenColumn Size="6" SizeMD="6" SizeSM="12">
        <CustomerInc Items="@_incomes" ShowCommand="true"
                     CustomerId="@CustomerId"
                     GetIncomes="@GetIncomes"
                     ShowAdd="true" />

    </RadzenColumn>
    <RadzenColumn Size="6" SizeMD="6" SizeSM="12">
        <CustomerExp Items="@_expenses" ShowCommand="true"
                     CustomerId="@CustomerId"
                     GetExpenses="@GetExpenses"
                     ShowAdd="true" />
    </RadzenColumn>
</RadzenRow>

<RadzenStack AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.Normal">
    <RadzenButton ButtonStyle="ButtonStyle.Primary" class="rz-w-100">
        Profit
        <RadzenBadge Variant="Variant.Outlined" BadgeStyle="BadgeStyle.Light"
                     Text="@(_profits.ToString())" class="rz-ms-2" />
    </RadzenButton>

</RadzenStack>

