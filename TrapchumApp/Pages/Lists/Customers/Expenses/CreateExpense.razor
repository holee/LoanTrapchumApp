@using Applications.Features.Incomes.Dto
<EditForm Model="@model" OnValidSubmit="@HandleFormSubmit">
    <ValidationSummary />
    <FluentValidationValidator DisableAssemblyScanning="false" />
    <RadzenRow>
        <RadzenColumn Size="6">
            <RadzenFormField class="rz-w-100" Text="Expense Title" AllowFloatingLabel="true">
                <ChildContent>
                    <RadzenDropDown Data="@_incomeExpenses"
                                    TextProperty="@nameof(IncomeExpenseDto.Description)"
                                    ValueProperty="@nameof(IncomeExpenseDto.Description)"
                                    AllowFiltering="true"
                                    LoadData="@LoadData"
                                    class="rz-w-100"
                                    @bind-Value="model.ExpenseTitle">

                    </RadzenDropDown>
                </ChildContent>
                <Helper>
                    <ValidationMessage For="() => model.ExpenseTitle" />
                </Helper>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenFormField class="rz-w-100" Text="Amount" AllowFloatingLabel="true">
                <ChildContent>
                    <TCNumbers @bind-Value="model.Amount" />
                </ChildContent>
                <Helper>
                    <ValidationMessage For="() => model.Amount" />
                </Helper>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    
    <RadzenFormField class="rz-w-100 rz-mt-2" Text="Description" AllowFloatingLabel="true">
        <ChildContent>
            <RadzenTextArea @bind-Value="model.Description" class="rz-w-100" />
        </ChildContent>
    </RadzenFormField>

    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 class="rz-mt-2"
                 Gap="1rem"
                 AlignItems="AlignItems.Center">
        <RadzenButton Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Success"
                      ButtonType="ButtonType.Submit"
                      Text="Save" Icon="@IconNames.Save" />

        <RadzenButton Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Danger"
                      Text="Close"
                      Click="HandleClose"
                      Icon="@IconNames.Close" />
    </RadzenStack>
</EditForm>


