@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Customers.UseCases
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Domains.Models.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using TrapchumApp.Services
<RadzenStack Orientation="Orientation.Horizontal"
             class="rz-mb-2"
             Visible="ShowCommand"
             AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
    <RadzenButton ButtonStyle="ButtonStyle.Primary"
                  Click="@AddNewNote"
                  Visible="@(ShowAdd && ShowCommand)"
                  Size="ButtonSize.Small" Icon="add" Text="Add Note"></RadzenButton>
</RadzenStack>
<RadzenDataGrid Data="Notes"
                Responsive
                TItem="VCustomerNotes"
                PagerHorizontalAlign="HorizontalAlign.Right"
                AllowPaging="true"
                PageSize="15"
                AllowSorting="false"
                GridLines="DataGridGridLines.Both"
                RowRender="@OnRowRender"
                Density="Density.Compact">
    <Columns>
        <RadzenDataGridColumn Width="3rem"
                              Title="#"
                              Property="Created">
            <Template>
                @context.RowIndex
            </Template>

        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="6rem"
                              Title="Date"
                              Property="Created">
            <Template>
                @context.Created.DayFirst()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="10rem"
                              Title="Create By"
                              Property="CreditAgentName"></RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Description" Property="Description"></RadzenDataGridColumn>
        <RadzenDataGridColumn Width="5rem"
                              Title="Action"
                              TextAlign="TextAlign.Center"
                              Property="Created">
            <Template>
                <RadzenButton Size="ButtonSize.Small"
                              Shade="Shade.Dark"
                              Variant="Variant.Text"
                              Icon="@IconNames.MoreVert"
                              ButtonStyle="ButtonStyle.Info">
                </RadzenButton>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
@code {

    [Parameter] public IEnumerable<VCustomerNotes> Notes { get; set; } = [];
    [Parameter] public string? CustomerId { get; set; } = string.Empty;
    [Parameter] public bool ShowAdd { get; set; } = false;
    [Parameter] public bool ShowCommand { get; set; } = false;
    [CascadingParameter] Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private readonly GetCustomerNotesUseCase _custNoteGet;

    public CustomerNotes(GetCustomerNotesUseCase custNoteGet)
    {
        _custNoteGet = custNoteGet;
    }

    protected override async Task OnInitializedAsync()
    {

        if (CustomerId.IsNotNullOrEmpty() && !Notes.Any())
        {
            await GetCustomerNotes(CustomerId);
        }

        await base.OnInitializedAsync();
    }

    async Task AddNewNote()
    {
        var auth = await AuthenticationState;

        if (auth.User.Identity!.IsAuthenticated == false)
        {
            return;
        }

        var userId = auth.User!.GetId();

        bool? dialogueResult = await DialogService.OpenAsync<CustomerNoteAdd>("New Note", new Dictionary<string, object?>
            {
                { "CustomerId", CustomerId },
                { "UserId", userId }
            });

        if (dialogueResult is not null && dialogueResult == true)
        {
            await GetCustomerNotes(CustomerId);
        }

    }


    async Task GetCustomerNotes(string? customerId)
    {
        var rsp = await _custNoteGet.ExecuteAsync(customerId);

        if (rsp.IsSuccess && rsp.Data is not null)
        {
            Notes = rsp.Data;
        }
        StateHasChanged();
    }



    void OnRowRender(RowRenderEventArgs<VCustomerNotes> args)
    {
        args.Data.RowIndex = args.Index + 1; // store 1-based index
    }

}
