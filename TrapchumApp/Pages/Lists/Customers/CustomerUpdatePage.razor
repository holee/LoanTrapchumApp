@page "/Customers/{CustomerId}/Update"
@using TrapchumApp.Helpers.Constants
<PageTitle>Edit Customer</PageTitle>
@attribute [StreamRendering]

@if (IsLoading)
{
    <RadzenStack AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.Center"
                 Style="min-height:20rem;">
        <RadzenProgressBarCircular ShowValue="false"
                                   Mode="ProgressBarMode.Indeterminate"
                                   Size="ProgressBarCircularSize.Medium" />
        <RadzenText TextStyle="TextStyle.Body2"
                    class="rz-color-base-600">Loading customer...</RadzenText>
    </RadzenStack>
}
else
{
    <EditForm Model="model" @ref="editForm">
        <input type="hidden" @bind="model.CustomerId" />
        <Blazilla.FluentValidator />
        <CreateCustomerInfo Model="@model" @key="@(Guid.NewGuid().ToString("N"))" />
        <RadzenCard Variant="Variant.Flat" class="@($"rz-mt-4 rz-p-3 {Styles.Bg200}")">
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.End"
                         Gap="0.75rem">
                <RadzenButton Click="@FormSubmit"
                              Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Success"
                              Text="Save"
                              Icon="@IconNames.Save"
                              IsBusy="isSaving"
                              BusyText="Saving..." />
                <RadzenButton Click="ClickCloseTab"
                              Size="ButtonSize.Small"
                              Text="Close"
                              ButtonStyle="ButtonStyle.Danger"
                              Icon="@IconNames.Cancel"
                              Disabled="isSaving" />
            </RadzenStack>
        </RadzenCard>
    </EditForm>
}
