@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Services
<RadzenStack class="rz-my-2" AlignItems="AlignItems.Center"
             Orientation="Orientation.Horizontal"
             JustifyContent="JustifyContent.SpaceBetween">
    <RadzenButton Variant="Variant.Flat"
                  Click="InsertedRow"
                  ButtonStyle="ButtonStyle.Primary"
                  Icon="add_circle"
                  Text="Add"
                  Size="ButtonSize.ExtraSmall"/>
</RadzenStack>
<RadzenDataGrid Data="@Expenses"
                Responsive
                TItem="VCustomerExpenses"
                @ref="incomeGrid"
                GridLines="DataGridGridLines.Both"
                Density="Density.Compact">
    <Columns>
        <RadzenDataGridColumn Context="c" Title="#" Width="2rem" TextAlign="TextAlign.Center">
            <Template>
                <input type="hidden" value="@c.ExpendId"/>
                @{
                    var index = Expenses?.IndexOf(c) + 1;
                }
                @index
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c" Title="IncomeSource" Property="IncomeSource">
            <Template>
                @c.ExpenseTitle
            </Template>
            <EditTemplate>
                <RadzenTextBox @bind-Value="c.ExpenseTitle"
                               class="w-100"
                               Style="height:2rem;line-height:1rem;"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="8rem"
                              Context="c" TextAlign="TextAlign.Right" Title="Amount" Property="IncomeAmount">
            <Template>
                @c.ExpendAmount
            </Template>
            <EditTemplate>
                <TCNumbers @bind-Value="c.ExpendAmount" Min="0"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c" Title="Description" Property="InDescription">
            <Template>
                @c.ExDescription
            </Template>
            <EditTemplate>
                <RadzenTextBox @bind-Value="c.ExDescription" class="w-100" Style="height:2rem;line-height:1rem;"/>
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TextAlign="TextAlign.Center" Context="c" Title="Action" Width="4rem">
            <Template>
                <RadzenButton Variant="Variant.Text"
                              Icon="@IconNames.EditPen"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="@(() => EditRow(c))"
                              @onclick:stopPropagation="true"
                              Size="ButtonSize.ExtraSmall"/>
                <RadzenButton Variant="Variant.Text"
                              Icon="delete"
                              ButtonStyle="ButtonStyle.Danger"
                              Click="@(() => DeleteRow(c))"
                              @onclick:stopPropagation="true"
                              Size="ButtonSize.ExtraSmall"/>
            </Template>
            <EditTemplate>
                <RadzenButton Variant="Variant.Text"
                              Icon="@IconNames.Checked"
                              Click="@(() => SaveRow(c))"
                              ButtonStyle="ButtonStyle.Success"
                              @onclick:stopPropagation="true"
                              Size="ButtonSize.ExtraSmall"/>
                <RadzenButton Variant="Variant.Text"
                              Icon="@IconNames.Undo"
                              ButtonStyle="ButtonStyle.Warning"
                              Click="@(() => CancelEdit(c))"
                              @onclick:stopPropagation="true"
                              Size="ButtonSize.ExtraSmall"/>

            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
<RadzenStack Orientation="Orientation.Horizontal"
             class="mt-3"
             AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
    <RadzenButton Text="Save"
                  Click="SaveChanged"
                  Icon="save"
                  ButtonStyle="ButtonStyle.Success"
                  Size="ButtonSize.Small"/>
    <RadzenButton Text="Close"
                  Click="Close"
                  Icon="cancel"
                  ButtonStyle="ButtonStyle.Danger"
                  Size="ButtonSize.Small"/>
</RadzenStack>


