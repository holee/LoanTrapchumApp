@using Applications.Commons.Messages.Incomes
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Commands.Incomes.DeleteIncome
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Services
<RadzenFieldset>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
            <RadzenIcon Icon="money_bag"/>
            <b>Income</b>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenStack AlignItems="AlignItems.Center" Gap="1rem"
                     JustifyContent="JustifyContent.End"
                     Orientation="Orientation.Horizontal" class="rz-mb-2" Visible="@ShowCommand">
            <RadzenButton Text="Income"
                          Click="AddInComeModal"
                          Icon="add"
                          ButtonStyle="ButtonStyle.Primary"
                          Visible="@(ShowAdd && ShowCommand)"
                          Size="ButtonSize.ExtraSmall"/>
            <RadzenButton Click="RefreshIncome"
                          Icon="refresh"
                          class="ml-2"
                          Visible="@(ShowReload && ShowCommand)"
                          ButtonStyle="ButtonStyle.Secondary"
                          Size="ButtonSize.ExtraSmall"/>

        </RadzenStack>
        <RadzenDataGrid Data="Items"
                        GridLines="DataGridGridLines.Both"
                        Responsive
                        IsLoading="isLoading"
                        ColumnWidth="10rem"
                        Style="min-height:20rem;height:20rem;max-height:30rem;"
                        Density="Density.Compact">
            <Columns>
                <RadzenDataGridColumn OrderIndex="0" Property="IncomeId" Context="c" Title="#" Width="3rem">
                    <Template>
                        @{
                            var index = Items.ToList().IndexOf(c) + 1;
                        }

                        @index

                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="c"
                                      Property="IncomeSource"
                                      Title="Income Source">
                    <Template>
                        @c.IncomeSource
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="c"
                                      Width="7.5rem"
                                      Property="IncomeAmount"
                                      TextAlign="TextAlign.Right"
                                      Title="Amount">
                    <Template>
                        @c?.IncomeAmount
                    </Template>
                    <FooterTemplate>
                        <strong>
                            @Items.Sum(x => x.IncomeAmount)
                        </strong>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="c"
                                      Property="InDescription"
                                      Title="Description">
                    <Template>
                        @c.InDescription
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="c"
                                      TextAlign="TextAlign.Center"
                                      Width="3.5rem"
                                      Property="InDescription"
                                      Title="Actions">
                    <Template>
                        <RadzenButton Size="ButtonSize.ExtraSmall"
                                      Variant="Variant.Text"
                                      Click="@((arg) => ShowContextMenu(arg, c))"
                                      Icon="@IconNames.MoreVert"/>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <LoadingTemplate>
                <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false"
                                           Mode="ProgressBarMode.Indeterminate"/>
            </LoadingTemplate>
        </RadzenDataGrid>
    </ChildContent>
</RadzenFieldset>

@code {

    void ShowContextMenu(MouseEventArgs args, VCustomerIncomes c)
    {
        ContextMenuService.Open(args, ds =>
            @<RadzenMenu Style="font-size:0.8rem;">
                <RadzenMenuItem Click="@(() => GetEditIncome(c))" Icon="@IconNames.Edit" Text="Edit Income"
                                Value="@c.IncomeId"/>
                <RadzenMenuItem Click="@(() => DeleteIncome(c))" Icon="@IconNames.Delete" Text="Delete Income"
                                Value="@c.IncomeId"/>
            </RadzenMenu>
        );
    }


    async Task GetEditIncome(VCustomerIncomes c)
    {
        var parameters = new Dictionary<string, object?>()
        {
            { "Id", c.IncomeId },
            { "CustomerId", CustomerId }
        };

        var dia = await DialogService.OpenAsync<CustomerModalIncomeEdit>("Edit Income", parameters);

        if (dia is bool && dia == true)
        {
            await GetCustomerIncomes(CustomerId);
        }
    }

    async Task DeleteIncome(VCustomerIncomes c)
    {
        var parameters = new Dictionary<string, object?>
        {
            { "Id", c.IncomeId },
            { "CustomerId", CustomerId }
        };

        var options = new ConfirmOptions
        {
            OkButtonText = "Ok",
            CancelButtonText = "Cancel"
        };

        var confirm =await DialogService.Confirm(IncomeMessage.confirmDelete, "Confirm Delete", options);
        
        if (confirm == false) return;

        var command = new DeleteIncomeCommand(c.IncomeId,CustomerId);

        var rsp =await mediator.Send(command);

        if (rsp.IsError)
        {
            NotificationService.Notify(NotificationSeverity.Error,rsp.FirstError.Description);
            return;
        }

        await GetCustomerIncomes(CustomerId);
    }

}