@page "/Customers/{CustomerId:guid?}/Update"
@using Applications.Enumerations
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Domains.Models.Files
@using TrapchumApp.Services
<PageTitle>Edit Customer</PageTitle>
<RadzenProgressBar Value="100" ShowValue="false"
                   Mode="ProgressBarMode.Indeterminate"
                   Visible="IsLoading"
                   ProgressBarStyle="ProgressBarStyle.Danger" />
<EditForm Model="model" @ref="editForm">
    <input type="hidden" @bind="model.CustomerId" />
    <FluentValidationValidator DisableAssemblyScanning="true"></FluentValidationValidator>
    <CreateCustomerInfo Model="@model" />
    <CustomerAddress model="@model" Cities="@Cities" Countries="@Countries" />
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 Gap="1rem"
                 class="rz-mt-2"
                 JustifyContent="JustifyContent.End">
        <RadzenButton Click="FormSubmit"
                      Size="ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Success"
                      Text="Save"
                      Icon="save" />
        <RadzenButton Click="ClickCloseTab"
                      Size="ButtonSize.Small"
                      Text="Close"
                      ButtonStyle="ButtonStyle.Danger"
                      Icon="cancel" />

    </RadzenStack>
</EditForm>
