@using Applications.Enumerations
@using Applications.Requests.Lists.OtherNames
@using Applications.Responses.Lists.Entities
@using TrapchumApp.Services

<RadzenFieldset AllowCollapse="true" Collapsed="false" class="rz-mb-2">
    <HeaderTemplate>
        <RadzenIcon Icon="family_restroom" /><strong>Spouse</strong>
    </HeaderTemplate>
    <ChildContent>
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="6">
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Spouse Name</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenTextBox @bind-Value="model.SpouseName"
                                       class="w-100"
                                       Placeholder="Spouse name" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Nationality</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDropDown Data="Nationalities"
                                        class="w-100"
                                        TextProperty="@nameof(Nationality.NationalityName)"
                                        ValueProperty="@nameof(Nationality.NationalityName)"
                                        @bind-Value="model.SpouseNationality">
                        </RadzenDropDown>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Passport No</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenTextBox @bind-Value="model.SpousePassport"
                                       class="w-100"
                                       Placeholder="Spouse Passport" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Spouse Phone</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenTextBox @bind-Value="model.SpousePhoneNo"
                                       class="w-100"
                                       Placeholder="Spouse Phone" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Spouse Birth Date</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDatePicker TValue="DateTime?"
                                          class="w-100"
                                          Placeholder="Spouse Date Of Birth"
                                          @bind-Value:format="yyyy-MMM-dd"
                                          @bind-Value="model.SpouseDateOfBirth">
                        </RadzenDatePicker>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Spouse Occupation</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDropDown class="w-100"
                                        Data="Occupations"
                                        AllowFiltering="true"
                                        FilterOperator="StringFilterOperator.Contains"
                                        TextProperty="OccupationTitle"
                                        Placeholder="Search Occupations"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        ValueProperty="OccupationTitle"
                                        @bind-Value="model.SpouseOccupation">
                        </RadzenDropDown>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Dependents</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenNumeric TValue="int?"
                                       class="w-100"
                                       Min="0"
                                       Max="12"
                                       ShowUpDown="false"
                                       @bind-Value="model.Dependents" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Children</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenNumeric TValue="int?"
                                       Min="0"
                                       Max="12"
                                       class="w-100"
                                       ShowUpDown="false"
                                       @bind-Value="model.NoOfChildren" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
    </ChildContent>
</RadzenFieldset>
@code {
    [Parameter] public EntityNamesCreate model { get; set; } = new();
    [Parameter] public IEnumerable<OcupationResponse> Occupations { get; set; } = [];
    [Parameter] public IEnumerable<Nationality> Nationalities { set; get; } = [];
}