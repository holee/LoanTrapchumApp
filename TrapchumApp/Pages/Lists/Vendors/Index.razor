@page "/App/Vendor"
@using Applications.Features.LoanRequests.Services
@using Applications.Responses.ViewModels.Vendors
@using Microsoft.AspNetCore.Components.Web
@using TrapchumApp.Services
<PageTitle>Vendors</PageTitle>
<style>
    .rz-grid-table td .rz-cell-data {
        line-height: 1.5rem;
        font-size: 0.8rem;
    }
</style>
<RadzenTabs SelectedIndex="@selectedIndex" RenderMode="TabRenderMode.Server">
    <Tabs>
        <RadzenTabsItem Text="Vendors" Icon="list">
            <GridToolbar SearchChanged="@SearchChanged">
                <LeftChildren>
                    <RadzenButton Icon="@IconNames.AddNew"
                                  Size="ButtonSize.Small"
                                  Text="Vendor"
                                  Click="AddTabOtherName"
                                  ButtonStyle="ButtonStyle.Primary" />
                </LeftChildren>
                <RightChildren>
                    <div>
                        <RadzenCheckBox TValue="bool" @bind-Value="@includeInactive"
                                        Change="ex => IncludeInActiveChanged(ex)"
                                        Name="CheckBox1" />
                        <RadzenLabel Text="Include InActive" Component="CheckBox1" Style="margin-left: 8px; vertical-align: middle;" />
                    </div>
                </RightChildren>
            </GridToolbar>
            <RadzenDataGrid TItem="VendorVm"
                            Density="Density.Compact"
                            Responsive
                            Count="@counts"
                            PageSize="@pageSize"
                            LoadData="@LoadData"
                            ColumnWidth="15rem"
                            AllowPaging="true"
                            AllowFiltering="true"
                            AllowSorting="true"
                            PageSizeOptions="@StorageConstant.PageSizeOptions"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            ShowPagingSummary="true"
                            GridLines="DataGridGridLines.Both"
                            IsLoading="@isLoading"
                            FilterMode="FilterMode.Advanced"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            PagerPosition="PagerPosition.Bottom"
                            PageSizeChanged="@PageSizeChanged"
                            AllowColumnPicking="true"
                            Data="@Vendors">
                <HeaderTemplate>

                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn Width="5rem"
                                          TextAlign="TextAlign.Center"
                                          Context="v"
                                          Title="#"
                                          Filterable="false"
                                          Sortable="false"
                                          Property="@(nameof(VendorVm.VendorId))">
                        <Template>
                            @(Vendors.IndexOf(v) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Context="c" Width="10rem" Title="Name" Property="@(nameof(VendorVm.AltName))">
                        <Template>
                            <KhmerName AltName="@c.AltName" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="6rem" Title="Title" Property="@(nameof(VendorVm.Salutation))" />
                    <RadzenDataGridColumn Width="8rem" Title="Phone" Property="@(nameof(VendorVm.Phone))" />
                    <RadzenDataGridColumn Width="15rem" Title="Email" Property="@(nameof(VendorVm.EmailAddress))" Visible="false" />
                    <RadzenDataGridColumn Sortable="false"
                                          Filterable="false"
                                          Title="Address" Property="@(nameof(VendorVm.Description))" Context="v">
                        <Template>
                            <AddressInfo ProInKhmer="@v.ProInKhmer"
                                         DisInKhmer="@v.DisInKhmer"
                                         ComInKhmer="@v.ComInKhmer"
                                         VilInKhmer="@v.VilInKhmer" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Sortable="false"
                                          Width="6rem"
                                          Filterable="false"
                                          TextAlign="TextAlign.Center"
                                          Title="Status" Property="@(nameof(VendorVm.VendorId))" Context="v">
                        <Template>
                            <RadzenCheckBox TValue="bool"
                                            Change="@(arg=>DeactiveOrActive(arg,v.VendorId!))"
                                            Value="@v.IsActive" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="5rem"
                                          Filterable="false"
                                          Sortable="false" Title="Actions" Property="@(nameof(VendorVm.VendorId))" Context="v">
                        <Template>
                            <RadzenButton Size="ButtonSize.ExtraSmall"
                                          Icon="more_vert"
                                          Variant="Variant.Text"
                                          Click="@(args=>ShowContextMenuWithContent(args,v))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
                <LoadingTemplate>
                    <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                </LoadingTemplate>
            </RadzenDataGrid>
        </RadzenTabsItem>
        <RadzenTabsItem Visible="IsEnableNew" Text="New" Icon="person_add">
            <VendorCreate Closed="CloseTabs" SelectIndex="1" />
        </RadzenTabsItem>
        <RadzenTabsItem Visible="IsEnableEdit" Text="Edit" Icon="edit">
            <VendorEdit Id="@vendorId" Closed="@Closing" />
        </RadzenTabsItem>
        <RadzenTabsItem Visible="IsEnableDetail" Text="Details" Icon="person">
            <VendorDetailModal OnEdit="OnEdit" Closed="@CloseTabs" Id="@vendorId" />
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {

    void ShowContextMenuWithContent(MouseEventArgs args, VendorVm e)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Click="@(() => DisplayDetail(e.VendorId))" Icon="info" Text="Details" Value="@e.VendorId"></RadzenMenuItem>
    <RadzenMenuItem Click="@(() => ShowEdit(e.VendorId))" Icon="edit" Text="Edit" Value="@e.VendorId"></RadzenMenuItem>
    <RadzenMenuItem Click="@(() => OnDelete(e.VendorId))" Icon="delete" Text="Delete" Value="@e.VendorId"></RadzenMenuItem>
</RadzenMenu>
    );
    }
}