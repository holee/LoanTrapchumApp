@page "/App/Vendors/{Id}/Edit"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Components.Indicatros
@using TrapchumApp.Services
<PageTitle>Vendor</PageTitle>
@attribute [StreamRendering]
@if (_isLoading)
{
    <Loading Text="កំពុងផ្ទុកទិន្នន័យ..." />
}
else
{
    <EditForm Model="model" OnValidSubmit="HandleFormSubmit">
        <FluentValidationValidator DisableAssemblyScanning="true"></FluentValidationValidator>
        <input type="hidden" @bind="model.Id" />
        <CreateComp model="model" @key="@(Guid.NewGuid().ToString("N"))" />
        <AddressCreate model="model" @key="@(Guid.NewGuid().ToString("N"))" />
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="1rem"
                     class="rz-mt-2"
                     JustifyContent="JustifyContent.End">
            <RadzenButton Size="ButtonSize.ExtraSmall"
                          ButtonStyle="ButtonStyle.Success"
                          ButtonType="ButtonType.Submit"
                          Text="Save"
                          Icon="save" />
            <RadzenButton Click="Close"
                          Size="ButtonSize.ExtraSmall"
                          Text="Close"
                          ButtonStyle="ButtonStyle.Danger"
                          Icon="cancel" />
        </RadzenStack>
    </EditForm>
}


