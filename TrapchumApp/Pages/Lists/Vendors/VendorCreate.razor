@page "/App/Vendor/CreateNewUser"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Services

<EditForm Model="model" @ref="editForm" OnValidSubmit="FormSubmit">
    <FluentValidationValidator DisableAssemblyScanning="true"></FluentValidationValidator>
    <CreateComp model="model" />
    <AddressBaseCreate model="model" />
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 Gap="1rem"
                 class="rz-mt-2"
                 JustifyContent="JustifyContent.End">
        <RadzenButton Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Success"
                      ButtonType="ButtonType.Submit"
                      Text="Save"
                      Icon="save" />
        <RadzenButton Click="@Close"
                      Size="ButtonSize.ExtraSmall"
                      Text="Close"
                      ButtonStyle="ButtonStyle.Danger"
                      Icon="cancel" />
    </RadzenStack>
</EditForm>



