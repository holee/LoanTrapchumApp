@using Applications.Requests.Lists.OtherNames
@using Applications.Responses.Lists.Entities
@using Domains.Models.Addresses
@using TrapchumApp.Services
<RadzenFieldset @key="@(Guid.NewGuid().ToString("N"))" AllowCollapse="false">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal"
                     Gap="0.25rem">
            <RadzenIcon Icon="perm_contact_calendar" /><strong>General</strong>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="3">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="6">
                        <RadzenLabel>Name</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenDropDown Chips="true"
                                        AllowFiltering="true"
                                        Name="DropDownSalutions"
                                        Style="width: 100%;"
                                        TValue="string"
                                        FilterOperator="StringFilterOperator.Contains"
                                        Placeholder="Salutation"
                                        @bind-Value="model.Salutation"
                                        Data="Salutations">
                        </RadzenDropDown>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="12">
                        <RadzenTextBox @bind-Value="model.FirstName"
                                       class="w-100"
                                       Placeholder="First name..." />
                        <ValidationMessage For="@(() => model.FirstName)" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="12">
                        <RadzenTextBox @bind-Value="model.MiddleName"
                                       class="w-100"
                                       Placeholder="Middle Name..." />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="12">
                        <RadzenTextBox @bind-Value="model.LastName"
                                       class="w-100"
                                       Placeholder="Last Name.." />
                        <ValidationMessage For="@(() => model.LastName)" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
            <RadzenColumn Size="6">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Khmer Name</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenTextBox @bind-Value="model.AltName"
                                       class="w-100"
                                       Placeholder="ឈ្មោះខ្មែរ..." />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Married Status</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDropDown @bind-Value="model.MarritalStatus"
                                        class="w-100"
                                        Data="Statuses">
                        </RadzenDropDown>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
            <RadzenColumn Size="6">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">Occupation</RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDropDown class="w-100"
                                        Data="Occupations"
                                        AllowFiltering="true"
                                        FilterOperator="StringFilterOperator.Contains"
                                        TextProperty="OccupationTitle"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        ValueProperty="OccupationTitle"
                                        @bind-Value="model.Occupation">
                        </RadzenDropDown>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Date Of Birth</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDatePicker TValue="DateTime?"
                                          @bind-Value="model.DateOfBirth"
                                          @bind-Value:format="yyyy-MMM-dd"
                                          DateFormat="dd/MM/yyyy"
                                          class="w-100"
                                          Placeholder="Date Of Birth">
                        </RadzenDatePicker>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center" Gap="1rem" class="rz-mt-2">
            <RadzenColumn Size="6">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">Passport</RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenTextBox class="w-100"
                                       @bind-Value="model.PassportId"
                                       Placeholder="Passport...." />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">Nationality</RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDropDown Data="@Nationalities"
                                        TextProperty="@nameof(Nationality.NationalityName)"
                                        ValueProperty="@nameof(Nationality.NationalityName)"
                                        class="w-100"
                                        @bind-Value="model.Nationality" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
    </ChildContent>
</RadzenFieldset>
<RadzenFieldset @key="@(Guid.NewGuid().ToString("N"))" AllowCollapse="false" class="rz-mt-2">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal"
                     Gap="0.25rem">
            <RadzenIcon Icon="call" /><strong>Contact Information</strong>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
            <RadzenColumn Size="6" SizeMD="6" SizeSM="12">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">Phone</RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenTextBox class="w-100"
                                       @bind-Value="model.Phone"
                                       Placeholder="Mobile phone..." />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
            <RadzenColumn Size="6" SizeMD="6" SizeSM="12">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">Alt Phone</RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenTextBox class="w-100"
                                       @bind-Value="model.AltPhone"
                                       Placeholder="Alt. phone..." />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
            <RadzenColumn Size="6" SizeMD="6" SizeSM="12">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">Email</RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenTextBox class="w-100"
                                       @bind-Value="model.EmailAddress"
                                       Placeholder="Email Address" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
            <RadzenColumn Size="6" SizeMD="6" SizeSM="12">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">Company Address</RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenTextBox class="w-100"
                                       @bind-Value="model.CompanyAddress"
                                       Placeholder="Company Address" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
    </ChildContent>
</RadzenFieldset>
