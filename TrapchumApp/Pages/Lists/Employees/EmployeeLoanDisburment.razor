@using Applications.Features.Loans.Dtos.Responses

<RadzenDataGrid Density="Density.Compact"
                AllowAlternatingRows="true"
                TItem="VLoanDisbursments"
                AllowPaging="true"
                AllowSorting="true"
                PageSize="10"
                Responsive="true"
                AllowColumnPicking="true"
                Data="@LoanDisbursments">
    <HeaderTemplate></HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(VLoanDisbursments.CustomerId)"
                              Context="c"
                              Pickable="false"
                              Title="#">
            <Template>
                @(LoanDisbursments.IndexOf(c) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VLoanDisbursments.AltName)"
                              Title="Name" />
        <RadzenDataGridColumn Property="@nameof(VLoanDisbursments.Principle)"
                              Title="Amount" TextAlign="TextAlign.Right" />
        <RadzenDataGridColumn Property="@nameof(VLoanDisbursments.InterestRate)"
                              Title="InterestRate" TextAlign="TextAlign.Right" />
        <RadzenDataGridColumn Property="@nameof(VLoanDisbursments.InstallmentType)"
                              Title="Installment" />
        <RadzenDataGridColumn Property="@nameof(VLoanDisbursments.FirstPaymentDate)"
                              Title="FirstPaymentDate" FormatString="{0:dd/MM/yyyy}" />
        <RadzenDataGridColumn Property="@nameof(VLoanDisbursments.LastPaymentDate)"
                              Title="LastPaymentDate" FormatString="{0:dd/MM/yyyy}" />
        <RadzenDataGridColumn Property="@nameof(VLoanDisbursments.PaidPrinciple)"
                              Title="Paid Principle" TextAlign="TextAlign.Right" />
        <RadzenDataGridColumn Property="@nameof(VLoanDisbursments.PaidInterest)"
                              Title="Paid Interest" TextAlign="TextAlign.Right" />
        <RadzenDataGridColumn Property="@nameof(VLoanDisbursments.PaidCollectionFee)"
                              Title="Paid Collection Fee" TextAlign="TextAlign.Right" />
        <RadzenDataGridColumn Property="@nameof(VLoanDisbursments.OutStanding)"
                              Title="OutStanding" TextAlign="TextAlign.Right" />
        <RadzenDataGridColumn Property="@nameof(VLoanDisbursments.LoanStatus)"
                              TextAlign="TextAlign.Center"
                              Title="Status" />
        <RadzenDataGridColumn Property="@nameof(VLoanDisbursments.LoanId)"
                              TextAlign="TextAlign.Center"
                              Title="Actions" />
    </Columns>
</RadzenDataGrid>
@code {
    [Parameter] public List<VLoanDisbursments> LoanDisbursments { get; set; } = [];
    [Parameter] public string? EmployeeId { get; set; } = string.Empty;

}