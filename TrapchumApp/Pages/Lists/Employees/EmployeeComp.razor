@using Applications.Features.Branches.Dtos
@using Applications.Features.Departments.Dto
@using Applications.Features.Documents.Dto
@using Applications.Features.Entities
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.Lists.Entities
@using Domains.Shared.Enums
@using System.Text.Json

@* ── Employee ── *@
<RadzenFieldset AllowCollapse="true" Collapsed="false" class="rz-mb-2">
    <HeaderTemplate>
        <RadzenIcon Icon="badge" /><strong>Employee</strong>
    </HeaderTemplate>
    <ChildContent>
        <RadzenRow Gap="1rem" class="rz-mb-4">
            @* Photo column *@
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenCard Style="height:100%; display:flex; align-items:center; justify-content:center; padding:0.75rem;">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenImage Path="@model.Photo"
                                     Style="width:8rem;height:8rem;object-fit:cover;border-radius:50%;border:3px solid var(--rz-primary);" />
                        <RadzenUpload Auto="true"
                                      Multiple="false"
                                      Accept=".jpg,.png"
                                      Url="upload/customers/profiles"
                                      Complete="@OnFileUploadComplete"
                                      Progress="@UploadProgress"
                                      Error="@OnUploadError"
                                      Style="width:100%"
                                      ChooseText="@(model.Photo == null ? "Upload Photo" : "Change Photo")"
                                      InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select file" }})">
                            <ChildContent>
                                <RadzenText TextStyle="TextStyle.Caption" TextAlign="TextAlign.Center"
                                            Style="color:var(--rz-text-tertiary-color);">
                                    .jpg / .png only
                                </RadzenText>
                            </ChildContent>
                        </RadzenUpload>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>

            @* Fields column *@
            <RadzenColumn Size="12" SizeMD="10">
                <RadzenRow Gap="1rem">
                    @* ── Left half ── *@
                    <RadzenColumn Size="12" SizeMD="7">
                        <RadzenStack Gap="0.75rem">

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Khmer Name" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                        <RadzenDropDown Name="DropDownSalutions"
                                                        Style="flex:0 0 35%;"
                                                        TValue="string"
                                                        AllowFiltering="true"
                                                        FilterOperator="StringFilterOperator.Contains"
                                                        Placeholder="Salutation"
                                                        @bind-Value="model.Salutation"
                                                        Data="@Salutations" />
                                        <RadzenTextBox @bind-Value="model.AltName"
                                                       Style="flex:1;"
                                                       Placeholder="ឈ្មោះជាខ្មែរ..." />
                                    </RadzenStack>
                                    <ValidationMessage For="@(() => model.AltName)" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="First Name" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenTextBox @bind-Value="model.FirstName"
                                                   class="rz-w-100"
                                                   Placeholder="First name..." />
                                    <ValidationMessage For="@(() => model.FirstName)" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Last Name" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                        <RadzenTextBox @bind-Value="model.MiddleName"
                                                       Style="flex:1;"
                                                       Placeholder="Middle..." />
                                        <RadzenTextBox @bind-Value="model.LastName"
                                                       Style="flex:1;"
                                                       Placeholder="Last name..." />
                                    </RadzenStack>
                                    <ValidationMessage For="@(() => model.LastName)" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Date of Birth" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <RadzenDatePicker TValue="DateTime?"
                                                      @bind-Value="model.DateOfBirth"
                                                      DateFormat="dd/MM/yyyy"
                                                      class="rz-w-100"
                                                      Placeholder="dd/MM/yyyy" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Gender" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <GenderDrowDown @bind-Value="model.Gender"
                                                    Placeholder="Select..." />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Marital Status" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <MarritalDropDown @bind-Value="model.MarritalStatus"
                                                      Placeholder="Select..." />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenLabel Text="Nationality" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="9">
                                    <NationalityDropDown Nationalities="@Nationalities"
                                                         @bind-Value="model.Nationality" />
                                </RadzenColumn>
                            </RadzenRow>

                        </RadzenStack>
                    </RadzenColumn>

                    @* ── Right half ── *@
                    <RadzenColumn Size="12" SizeMD="5">
                        <RadzenStack Gap="0.75rem">

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Status" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenStack Orientation="Orientation.Horizontal"
                                                 AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenCheckBox TValue="bool?" @bind-Value="model.IsActive" />
                                        <RadzenLabel Text="@(model.IsActive == true ? "Active" : "Inactive")"
                                                     Style="@(model.IsActive == true ? "color:var(--rz-success);" : "color:var(--rz-danger);")" />
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Phone" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="model.Phone"
                                                   class="rz-w-100"
                                                   Placeholder="Phone number..." />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Alt Phone" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="model.AltPhone"
                                                   class="rz-w-100"
                                                   Placeholder="Alternative phone..." />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Email" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextBox @bind-Value="model.EmailAddress"
                                                   class="rz-w-100"
                                                   Placeholder="email@example.com" />
                                </RadzenColumn>
                            </RadzenRow>

                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="12" SizeMD="4">
                                    <RadzenLabel Text="Note" />
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="8">
                                    <RadzenTextArea @bind-Value="model.Description"
                                                    class="rz-w-100"
                                                    Rows="3"
                                                    Placeholder="Additional notes..." />
                                </RadzenColumn>
                            </RadzenRow>

                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
    </ChildContent>
</RadzenFieldset>

@* ── Employment ── *@
<RadzenFieldset AllowCollapse="true" Collapsed="false" class="rz-mb-2">
    <HeaderTemplate>
        <RadzenIcon Icon="work" /><strong>Employment</strong>
    </HeaderTemplate>
    <ChildContent>
        <RadzenStack Gap="0.75rem">

            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenLabel Text="Job Title" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <OccupationDropDown @bind-Value="model.Occupation"
                                        TypeOf="TypeOfEnum.Position"
                                        ShowAdd="true" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenLabel Text="Branch" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenDropDown FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    FilterOperator="StringFilterOperator.Contains"
                                    AllowFiltering="true"
                                    Data="@Branches"
                                    AllowClear="false"
                                    class="rz-w-100"
                                    TextProperty="@nameof(VBranch.BranchName)"
                                    ValueProperty="@nameof(VBranch.BranchId)"
                                    @bind-Value="model.BranchRefId"
                                    Placeholder="Select branch..." />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenLabel Text="Department" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenDropDown FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    FilterOperator="StringFilterOperator.Contains"
                                    AllowFiltering="true"
                                    Data="@Departments"
                                    AllowClear="false"
                                    class="rz-w-100"
                                    TextProperty="@nameof(VDepartment.DepartmentName)"
                                    ValueProperty="@nameof(VDepartment.DepartmentId)"
                                    @bind-Value="model.DepartmentRefId"
                                    Placeholder="Select department..." />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenLabel Text="Supervisor" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenDropDown Disabled
                                    @bind-Value="model.EntType"
                                    class="rz-w-100"
                                    Placeholder="Select supervisor..."
                                    Data="@supervisors" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenLabel Text="Hire Date" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenDatePicker TValue="DateTime?"
                                      @bind-Value="model.HireDate"
                                      DateFormat="dd/MM/yyyy"
                                      class="rz-w-100"
                                      Placeholder="dd/MM/yyyy" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenLabel Text="End Date" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenDatePicker TValue="DateTime?"
                                      @bind-Value="model.EndDate"
                                      DateFormat="dd/MM/yyyy"
                                      class="rz-w-100"
                                      Placeholder="dd/MM/yyyy" />
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="12" SizeMD="2">
                    <RadzenLabel Text="Employment Note" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="10">
                    <RadzenTextArea @bind-Value="model.Description"
                                    class="rz-w-100"
                                    Rows="2"
                                    Placeholder="Employment notes..." />
                </RadzenColumn>
            </RadzenRow>

        </RadzenStack>
    </ChildContent>
</RadzenFieldset>

<AddressCreate model="model" />
<ContactRelation />

@code {
    private List<int> Relations = new List<int> { 1, 2, 3, 4 };

    [Parameter]
    public string? ContactName { get; set; }
    [Parameter]
    public int Relation { get; set; } = 1;
    [Parameter]
    public string? ContactPhone { get; set; }
    private string _errorMessage = string.Empty;
    private bool _isError = false;
    private int _progress = 0;
    private bool _isUploading = false;

    void OnFileUploadComplete(UploadCompleteEventArgs args)
    {
        if (string.IsNullOrEmpty(args.RawResponse))
        {
            model.Photo = tempPath;
            return;
        }

        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            var fileModels = JsonSerializer.Deserialize<DocumentDto>(args.RawResponse!, options);

            if (fileModels is not null)
            {
                model.Photo = fileModels.FileUrl;
            }
            else
            {
                _isError = true;
                model.Photo = tempPath;
                _errorMessage = "Failed to parse upload response.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error parsing upload response: {ex.Message}";
            logger.LogError(ex, "Error parsing upload response: {Message}", ex.Message);
        }
    }

    void OnUploadError(UploadErrorEventArgs args)
    {
        _isError = true;
        _errorMessage = $"Upload failed: {args.Message}";
        logger.LogError("Upload failed: {Message}", args.Message);
    }

    void UploadProgress(UploadProgressArgs args)
    {
        _isUploading = true;
        _progress = args.Progress;
        logger.LogInformation("Upload progress: {Progress}%", args.Progress);
    }
}