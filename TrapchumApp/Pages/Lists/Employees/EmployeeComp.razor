@using Applications.Features.Branches.Dtos
@using Applications.Features.Departments.Dto
@using Applications.Features.Documents.Dto
@using Applications.Features.Entities
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.Lists.Entities
@using Domains.Shared.Enums
@using System.Text.Json
<RadzenFieldset AllowCollapse="true" Collapsed="false" class="rz-mb-2">
    <HeaderTemplate>
        <RadzenIcon Icon="badge" /><strong>Employee</strong>
    </HeaderTemplate>
    <ChildContent>
        <RadzenRow class="rz-mb-2">
            <RadzenColumn Size="12" SizeMD="9">
                <RadzenRow class="rz-mb-2">
                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenFormField Text="Salutation" class="rz-w-100">
                            <BlaSalutation @bind-Value="model.Salutation" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="6">
                        <RadzenFormField Text="ឈ្មោះជាខ្មែរ" class="rz-w-100">
                            <ChildContent>
                                <RadzenTextBox @bind-Value="model.AltName"
                                               Style="flex:1;"
                                               Placeholder="ឈ្មោះជាខ្មែរ..." />
                            </ChildContent>
                            <Helper>
                                <ValidationMessage For="@(() => model.AltName)" />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="2">
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenCheckBox TValue="bool?" @bind-Value="model.IsActive" />
                            <RadzenLabel Text="@(model.IsActive == true ? "សកម្ម / Active" : "អសកម្ម / Inactive")"
                                         Style="@(model.IsActive == true ? "color:var(--rz-success);" : "color:var(--rz-danger);")" />
                        </RadzenStack>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow class="rz-mb-2">
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="នាមខ្លួនជាឡាតាំង" class="rz-w-100">
                            <ChildContent>
                                <RadzenTextBox @bind-Value="model.FirstName"
                                               class="rz-w-100"
                                               Placeholder="នាមខ្លួនជាឡាតាំង..." />
                            </ChildContent>
                            <Helper>
                                <ValidationMessage For="@(() => model.FirstName)" />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="ឈ្មោះមធ្យមជាឡាតាំង" class="rz-w-100">
                            <ChildContent>
                                <RadzenTextBox @bind-Value="model.MiddleName"
                                               Style="flex:1;"
                                               Placeholder="ឈ្មោះមធ្យមជាឡាតាំង..." />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="នាមត្រកូលជាឡាតាំង" class="rz-w-100">
                            <ChildContent>
                                <RadzenTextBox @bind-Value="model.LastName"
                                               Style="flex:1;"
                                               Placeholder="នាមត្រកូលជាឡាតាំង..." />
                            </ChildContent>
                            <Helper>
                                <ValidationMessage For="@(() => model.LastName)" />
                            </Helper>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow class="rz-mb-2">
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="លេខទូរស័ព្ទ" class="rz-w-100">
                            <ChildContent>
                                <RadzenTextBox @bind-Value="model.Phone"
                                               class="rz-w-100"
                                               Placeholder="Phone number..." />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="លេខទូរស័ព្ទបន្ថែម" class="rz-w-100">
                            <ChildContent>
                                <RadzenTextBox @bind-Value="model.AltPhone"
                                               class="rz-w-100"
                                               Placeholder="Alternative phone..." />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="អ៊ីមែល" class="rz-w-100">
                            <ChildContent>
                                <RadzenTextBox @bind-Value="model.EmailAddress"
                                               class="rz-w-100"
                                               Placeholder="email@example.com" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow class="rz-mb-2">
                    <RadzenColumn Size="2">
                        <RadzenFormField Text="ភេទ" class="rz-w-100">
                            <ChildContent>
                                <BlaSalutation @bind-Value="model.Gender" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenFormField Text="ស្ថានភាពអាពាហ៍ពិពាហ៍" class="rz-w-100">
                            <ChildContent>
                                <MarritalDropDown @bind-Value="model.MarritalStatus"
                                                  Placeholder="Select..." />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenFormField Text="សញ្ជាតិ" class="rz-w-100">
                            <ChildContent>
                                <BlaNationality @bind-Value="model.Nationality" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenFormField Text="ថ្ងៃខែឆ្នាំកំណើត" class="rz-w-100">
                            <ChildContent>
                                <RadzenDatePicker TValue="DateTime?"
                                                  @bind-Value="model.DateOfBirth"
                                                  DateFormat="dd/MM/yyyy"
                                                  class="rz-w-100"
                                                  Placeholder="dd/MM/yyyy" />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenCard Style="display:flex; align-items:center; justify-content:center; padding:0rem;">
                    <RadzenStack AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenImage Path="@model.Photo"
                                     Style="width:8rem;height:8rem;object-fit:cover;border-radius:50%;border:3px solid var(--rz-primary);" />
                        <RadzenUpload Auto="true"
                                      Multiple="false"
                                      Accept=".jpg,.png"
                                      Url="upload/customers/profiles"
                                      Complete="@OnFileUploadComplete"
                                      Progress="@UploadProgress"
                                      Error="@OnUploadError"
                                      Style="width:100%;background-color:transparent;"
                                      InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select file" }})">
                            <ChildContent>
                                <RadzenText TextStyle="TextStyle.Caption" TextAlign="TextAlign.Center"
                                            Style="color:var(--rz-text-tertiary-color);">
                                    .jpg / .png only
                                </RadzenText>
                            </ChildContent>
                        </RadzenUpload>
                    </RadzenStack>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow Style="margin-top:0.2rem;">
            <RadzenColumn Size="12">
                <RadzenFormField Text="កំណត់ចំណាំ" class="rz-w-100">
                    <ChildContent>
                        <RadzenTextArea @bind-Value="model.Description"
                                        class="rz-w-100"
                                        Rows="3"
                                        Placeholder="Additional notes..." />
                    </ChildContent>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
    </ChildContent>
</RadzenFieldset>
<RadzenFieldset AllowCollapse="true" Collapsed="false" class="rz-mb-2">
    <HeaderTemplate>
        <RadzenIcon Icon="work" /><strong>Employment</strong>
    </HeaderTemplate>
    <ChildContent>
        <RadzenStack Gap="0.75rem">

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="តួនាទី" class="rz-w-100">
                        <ChildContent>
                            <BlaOccupation TypeOf="TypeOfEnum.Position" />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="សាខា" class="rz-w-100">
                        <ChildContent>
                            <RadzenDropDown FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            FilterOperator="StringFilterOperator.Contains"
                                            AllowFiltering="true"
                                            Data="@Branches"
                                            AllowClear="false"
                                            class="rz-w-100"
                                            TextProperty="@nameof(VBranch.BranchName)"
                                            ValueProperty="@nameof(VBranch.BranchId)"
                                            @bind-Value="model.BranchRefId"
                                            Placeholder="Select branch..." />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="នាយកដ្ឋាន" class="rz-w-100">
                        <ChildContent>
                            <RadzenDropDown FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            FilterOperator="StringFilterOperator.Contains"
                                            AllowFiltering="true"
                                            Data="@Departments"
                                            AllowClear="false"
                                            class="rz-w-100"
                                            TextProperty="@nameof(VDepartment.DepartmentName)"
                                            ValueProperty="@nameof(VDepartment.DepartmentId)"
                                            @bind-Value="model.DepartmentRefId"
                                            Placeholder="Select department..." />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="អ្នកត្រួតពិនិត្យ" class="rz-w-100">
                        <ChildContent>
                            <RadzenDropDown Disabled
                                            @bind-Value="model.EntType"
                                            class="rz-w-100"
                                            Placeholder="Select supervisor..."
                                            Data="@supervisors" />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="កាលបរិច្ឆេទចូលធ្វើការ" class="rz-w-100">
                        <ChildContent>
                            <RadzenDatePicker TValue="DateTime?"
                                              @bind-Value="model.HireDate"
                                              DateFormat="dd/MM/yyyy"
                                              class="rz-w-100"
                                              Placeholder="dd/MM/yyyy" />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="កាលបរិច្ឆេទបញ្ចប់" class="rz-w-100">
                        <ChildContent>
                            <RadzenDatePicker TValue="DateTime?"
                                              @bind-Value="model.EndDate"
                                              DateFormat="dd/MM/yyyy"
                                              class="rz-w-100"
                                              Placeholder="dd/MM/yyyy" />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>

            <RadzenFormField Text="កំណត់ចំណាំការងារ" class="rz-w-100">
                <ChildContent>
                    <RadzenTextArea @bind-Value="model.Description"
                                    class="rz-w-100"
                                    Rows="2"
                                    Placeholder="Employment notes..." />
                </ChildContent>
            </RadzenFormField>

        </RadzenStack>
    </ChildContent>
</RadzenFieldset>
<AddressCreate model="model" />
<ContactRelation />
@code {
    private List<int> Relations = new List<int> { 1, 2, 3, 4 };

    [Parameter]
    public string? ContactName { get; set; }
    [Parameter]
    public int Relation { get; set; } = 1;
    [Parameter]
    public string? ContactPhone { get; set; }
    private string _errorMessage = string.Empty;
    private bool _isError = false;
    private int _progress = 0;
    private bool _isUploading = false;

    void OnFileUploadComplete(UploadCompleteEventArgs args)
    {
        if (string.IsNullOrEmpty(args.RawResponse))
        {
            model.Photo = tempPath;
            return;
        }

        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            var fileModels = JsonSerializer.Deserialize<DocumentDto>(args.RawResponse!, options);

            if (fileModels is not null)
            {
                model.Photo = fileModels.FileUrl;

                _toastService.ShowSuccess("Photo uploaded successfully!", "Upload Complete");
            }
            else
            {
                _isError = true;
                model.Photo = tempPath;
                _errorMessage = "Failed to parse upload response.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error parsing upload response: {ex.Message}";
            logger.LogError(ex, "Error parsing upload response: {Message}", ex.Message);
        }
    }

    void OnUploadError(UploadErrorEventArgs args)
    {
        _isError = true;

        _errorMessage = $"Upload failed: {args.Message}";

        _toastService.ShowError(_errorMessage, "Upload Error");

        logger.LogError("Upload failed: {Message}", args.Message);
    }

    void UploadProgress(UploadProgressArgs args)
    {
        _isUploading = true;

        _progress = args.Progress;

        logger.LogInformation("Upload progress: {Progress}%", args.Progress);
    }
}