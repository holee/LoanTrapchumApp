@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Services
@page "/App/Employees/CreateNewUser"
<PageTitle>New Employee</PageTitle>
<EditForm Model="@model" OnValidSubmit="@FormValidSubmit">
    <FluentValidationValidator DisableAssemblyScanning="false" />
    <EmployeeComp model="model" />
    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 class="rz-mt-2"
                 Gap="1rem">
        <RadzenButton ButtonType="ButtonType.Submit"
                      ButtonStyle="ButtonStyle.Success"
                      Size="ButtonSize.Small"
                      Icon="save"
                      Text="Save" />
        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                      Variant="Variant.Flat"
                      Size="ButtonSize.Small"
                      Icon="cancel"
                      Text="Cancel"
                      Click="CloseTab" />
    </RadzenStack>
</EditForm>
