@page "/App/Employees"
@using Applications.Features.Entities
@using Applications.Responses.ViewModels.Employees
<PageTitle>Employees</PageTitle>
<style>
    .rz-grid-table td .rz-cell-data {
        line-height: 1.5rem;
        font-size: 0.8rem;
    }
</style>
<RadzenTabs @ref="@tabs" RenderMode="TabRenderMode.Server" Change="TabChanged" @bind-SelectedIndex="@selectedIndex">
    <Tabs>
        <RadzenTabsItem Text="Employees" Icon="group">
            <GridToolbar SearchChanged="PerformSearch">
                <LeftChildren>
                    <RadzenButton Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="AddNewTab"
                                  Text="Add Employee" />
                    <div class="rz-p-1">
                        <RadzenCheckBox @bind-Value="includeInActive"
                                        @bind-Value:after="GetIncludeInactive"
                                        Name="includeInActive" />
                        <RadzenLabel Text="Include Inactive"
                                     Component="includeInActive"
                                     Style="margin-left: 3px; vertical-align: middle;" />
                    </div>
                </LeftChildren>
                <RightChildren>
                    <div class="rz-p-1">
                        <RadzenDropDown Data="@Branches"
                                        AllowClear="false"
                                        TValue="int"
                                        @bind-Value="@branchId"
                                        TextProperty="@nameof(BranchDto.BranchName)"
                                        ValueProperty="@nameof(BranchDto.BranchId)"
                                        class="w-100"
                                        Name="Branch"
                                        SelectedItemChanged="SelectedItemChanged"
                                        Placeholder="Select branch">
                        </RadzenDropDown>
                    </div>
                </RightChildren>
            </GridToolbar>
            <RadzenDataGrid Data="@Employees"
                            GridLines="DataGridGridLines.Both"
                            ColumnWidth="10rem"
                            RowRender="@OnRowRender"
                            LoadData="@LoadData"
                            Responsive
                            Density="Density.Compact"
                            IsLoading="@isLoading"
                            Count="@counts"
                            PagerPosition="PagerPosition.Bottom"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            PageSize="@pageSize"
                            ShowPagingSummary="true"
                            PageSizeOptions="@StorageConstant.PageSizeOptions"
                            PageSizeChanged="PageSizeChanged"
                            AllowPaging="true"
                            AllowFiltering="true"
                            AllowAlternatingRows="true"
                            AllowRowSelectOnRowClick="true"
                            AllowSorting="true"
                            RowDoubleClick="@OnRowDoubleClick"
                            TItem="VEmployeeList">
                <Columns>
                    <RadzenDataGridColumn Context="c"
                                          Width="5rem"
                                          TextAlign="TextAlign.Center"
                                          Title="#"
                                          Sortable="false"
                                          Property="@nameof(VEmployeeList.EmployeeId)">
                        <Template>
                            @c.RowIndex
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="Name" Property="@nameof(VEmployeeList.AltName)" Context="e">
                        <Template>
                            <KhmerName AltName="@e.AltName" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="Phone" Property="@nameof(VEmployeeList.Phone)" />
                    <RadzenDataGridColumn Title="Email"
                                          Sortable="false"
                                          Property="@nameof(VEmployeeList.EmailAddress)" />
                    <RadzenDataGridColumn Title="Department"
                                          Property="@nameof(VEmployeeList.DepartmentName)" />
                    <RadzenDataGridColumn Title="Occupation"
                                          Property="@nameof(VEmployeeList.Occupation)" />
                    <RadzenDataGridColumn Title="Branch"
                                          Property="@nameof(VEmployeeList.BranchName)" />
                    <RadzenDataGridColumn Width="5rem"
                                          Sortable="false"
                                          TextAlign="TextAlign.Center"
                                          Title="Status"
                                          Property="@nameof(VEmployeeList.EmployeeId)"
                                          Filterable="false"
                                          Context="c">
                        <Template>
                            <RadzenCheckBox TValue="bool" Value="c.IsActive"
                                            Name="chkStatus"
                                            Change="@((arg) => OnCheckChanged(c.EmployeeId,arg))" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="5rem"
                                          Sortable="false"
                                          Title="Action"
                                          TextAlign="TextAlign.Center"
                                          Filterable="false"
                                          Property="@nameof(VEmployeeList.EmployeeId)"
                                          Context="c">
                        <Template>
                            <RadzenButton Size="ButtonSize.ExtraSmall"
                                          Icon="more_vert"
                                          Variant="Variant.Text"
                                          Click="@((args) => ShowContextMenuWithContent(args, c.EmployeeId))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
                <LoadingTemplate>
                    <RadzenProgressBar Value="100"
                                       ProgressBarStyle="ProgressBarStyle.Secondary"
                                       Mode="ProgressBarMode.Indeterminate"
                                       Visible="@isLoading"
                                       ShowValue="false">
                    </RadzenProgressBar>
                </LoadingTemplate>
            </RadzenDataGrid>
        </RadzenTabsItem>
        <RadzenTabsItem Visible="IsEnableNew" Text="New" Icon="person_add">
            <Template>
                <CloseTabButton Title="Employee Create" Closed="@(() => CloseTabe(1))" />
            </Template>
            <ChildContent>
                <CreateEmployee OnClose="OnClosing"
                                Reloaded="Reload" />
            </ChildContent>
        </RadzenTabsItem>
        <RadzenTabsItem Visible="IsEnableEdit" Text="Edit" Icon="edit">
            <Template>
                <CloseTabButton Title="Employee Edit" Closed="@(() => CloseTabe(2))" />
            </Template>
            <ChildContent>
                <EmployeeEdit OnClose="OnIsEditClose"
                              EmployeeId="@_empId"
                              Reloaded="Reload" />
            </ChildContent>
        </RadzenTabsItem>
        <RadzenTabsItem Visible="@IsEnableDetail" Text="Details" Icon="info">
            <Template>
                <CloseTabButton Title="Employee Details" Closed="@(() => CloseTabe(3))" />
            </Template>
            <ChildContent>
                <EmployeeDetails OnEdit="OnEditTab" EmployeeId="@_empId" Close="OnIsDetailClose" />
            </ChildContent>
        </RadzenTabsItem>

    </Tabs>
</RadzenTabs>
@code {

    int tabCount = 0;   
    void CloseTabe(int closeTabIndex)
    {

        if (closeTabIndex == 1)
        {
            IsEnableNew = false;
        }

        if (closeTabIndex == 2)
        {
            IsEnableEdit = false;
        }

        if (closeTabIndex == 3)
        {
            IsEnableDetail = false;
        }

        if(closeTabIndex == 4)
        {
            IsEnableEdit = false;  
        }

        // if(tabCount > 0)
        // {
        //     tabCount--;
        // }
        // else
        // {
        //     tabCount = 0;
        // }

        selectedIndex = 0;

    }



    void ShowContextMenuWithContent(MouseEventArgs args, string? id)
    {
        ContextMenuService.Open(args, ds =>
            @<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Click="@(() => AddDetailsTab(id))" Icon="info" Text="Details"
                    Value="@id"></RadzenMenuItem>
    <RadzenMenuItem Click="@(() => AddEditTab(id))" Icon="edit" Text="Edit" Value="@id"></RadzenMenuItem>
    <RadzenMenuItem Click="@(() => Delete(id))" Icon="delete" Text="Delete" Value="@id"></RadzenMenuItem>
</RadzenMenu>
        );
    }

}

