@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Applications.Requests.Lists.Holidays
@using Applications.Responses.Lists.Holidays
@using Applications.Responses.ViewModels.Holidays
@using TrapchumApp.Services
<PageTitle>New Holiday</PageTitle>
<RadzenButton ButtonStyle="ButtonStyle.Secondary"
              Icon="add" Size="ButtonSize.Small"
              class="rz-mb-2"
              Click="ShowMultipleModal"
              Text="Add Multiple" />
<RadzenFieldset>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25">
            <RadzenIcon Icon="event" /> <span>New Holiday</span>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenRow>
            <RadzenColumn Size="6" SizeSM="12" SizeMD="6">
                <RadzenStack Orientation="Orientation.Horizontal" class="w-100">
                    <RadzenDatePicker Inline
                                      TValue="DateTime?"
                                      AllowInput="true"
                                      CurrentDateChanged="ChangedDate"
                                      DateFormat="dd/MM/yyyy"
                                      Placeholder="select holiday date"
                                      @bind-Value="SelectedDate"
                                      Change="SelectedDateChanged"
                                      @bind-Value:format="yyyy/MM/dd">
                        <FooterTemplate>
                            <RadzenButton Icon="today" Click=@(args => SelectedDate = DateTime.Now) Text="Today" Style="width: 100%;" class="rz-my-1" />
                        </FooterTemplate>
                    </RadzenDatePicker>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="6" SizeMD="6" SizeSM="12">
                <RadzenRow class="rz-mb-2" AlignItems="AlignItems.Center">
                    <RadzenColumn Size="2">
                        Description
                    </RadzenColumn>
                    <RadzenColumn Size="10">
                        <RadzenTextArea Placeholder="Enter event or holiday title..." 
                                        @bind-Value="modelDTO.Description"
                                        class="h-100 w-100 form-control"
                                        aria-label="TextArea with placeholder" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
                    <RadzenColumn Size="2">
                        <RadzenLabel Text="Is Active" Component="IsActive"
                                     Style="margin-right: 12px; vertical-align: middle;" />
                    </RadzenColumn>
                    <RadzenColumn Size="10">
                        <RadzenCheckBox @bind-Value="modelDTO.Status" Name="IsActive" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
        <RadzenStack AlignItems="AlignItems.Center"
                     Orientation="Orientation.Horizontal"
                     class="rz-m-2"
                     JustifyContent="JustifyContent.End">
            <RadzenButton Text="Set"
                          Icon="add"
                          ButtonStyle="ButtonStyle.Success"
                          Click="FormValidSubmit"
                          Size="ButtonSize.Small" />
        </RadzenStack>
        <RadzenDataGrid Data="listvm"
                        Responsive="true"
                        TItem="HolidayVm"
                        RowSelect="RowSelectedChanged"
                        Density="Density.Compact">
            <Columns>
                <RadzenDataGridColumn Property="Id"
                                      Context="h"
                                      Title="#"
                                      Width="50px">
                    <Template>
                        @(listvm?.ToList().IndexOf(h) + 1)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(HolidayVm.HolidayDt)"
                                      Title="Date"
                                      Context="h"
                                      Width="100px">
                    <Template>
                        @h.HolidayDt.DayFirst()
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(HolidayVm.HolidayName)"
                                      Title="Holiday" />
                <RadzenDataGridColumn Property="@nameof(HolidayVm.Description)"
                                      Title="Description" />
                <RadzenDataGridColumn Property="@nameof(HolidayVm.Status)"
                                      Context="h"
                                      Title="Status">
                    <Template>
                        <RadzenCheckBox TValue="bool?"
                                        @bind-Value="h.Status" Disabled />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="h"
                                      TextAlign="TextAlign.Center"
                                      Width="5rem"
                                      Title="Action">
                    <Template>
                        <RadzenButton Icon="delete"
                                      Click="@(() => DeleteHoliday(h.Id))"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Text"
                                      Size="ButtonSize.ExtraSmall" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>

        </RadzenDataGrid>
        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End"
                     class="rz-m-2"
                     Orientation="Orientation.Horizontal">
            <RadzenButton Text="Close"
                          Icon="close"
                          ButtonStyle="ButtonStyle.Danger"
                          Click="CloseTab"
                          Size="ButtonSize.Small" />
        </RadzenStack>
    </ChildContent>
</RadzenFieldset>

