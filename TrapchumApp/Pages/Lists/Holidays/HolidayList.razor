@page "/App/Holiday"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Applications.Responses.ViewModels.Holidays
@using Microsoft.AspNetCore.Components.Web
@using TrapchumApp.Services
<PageTitle>Holiday</PageTitle>
<RadzenTabs @bind-SelectedIndex="SelectedIndex" RenderMode="TabRenderMode.Server">
    <Tabs>
        <RadzenTabsItem Text="Holidays" Icon="list">
            <RadzenCard>
                <RadzenStack AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Orientation="Orientation.Horizontal">

                </RadzenStack>
                <PageDropDown ShowReload="true"
                              ShowSearchBox="true"
                              OnTextChanged="SearchEvent"
                              Reload="Reload"
                              PageSizeChanged="ChangedPageSize">
                    <LeftChildContent>
                        <RadzenButton Text="Add Holiday"
                                      Click="DisplayModal"
                                      Icon="add"
                                      ButtonStyle="ButtonStyle.Success"
                                      Size="ButtonSize.Small" />
                    </LeftChildContent>
                    <RightChildContent>
                        <div class="rz-text-center">
                            <RadzenCheckBox @bind-Value="@IsPreviousSelected"
                                            @bind-Value:after="PreviousSelectedChanged"
                                            Name="CheckBox1" />
                            <RadzenLabel Text="Previous Date" Component="CheckBox1" class="rz-ms-2" />
                        </div>
                    </RightChildContent>
                </PageDropDown>
                <RadzenDataGrid GridLines="DataGridGridLines.Horizontal"
                                Count="@counts"
                                PageSize="@pageSize"
                                AllowPaging="true"
                                ShowPagingSummary="true"
                                Density="Density.Compact"
                                PagerHorizontalAlign="HorizontalAlign.Right"
                                AllowSorting="true"
                                LoadData="LoadData"
                                IsLoading="isLoading"
                                TItem="HolidayVm"
                                Data="HolidaysList">
                    <Columns>
                        <RadzenDataGridColumn Title="#" Context="h" Width="4rem">
                            <Template>
                                @(HolidaysList!.IndexOf(h) + 1)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Holiday Date" Sortable="true"
                                              Width="10rem"
                                              Context="h">
                            <Template>
                                @h?.HolidayDt.DayFirst()
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TextAlign="TextAlign.Left"
                                              Title="Day Name"
                                              Width="8rem"
                                              Property="@nameof(HolidayVm.HolidayName)" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Center"
                                              Title="DayInNumber"
                                              Property="HolidayNum" />
                        <RadzenDataGridColumn Title="Description" Property="Description" />
                        <RadzenDataGridColumn Width="5rem"
                                              TextAlign="TextAlign.Center"
                                              Title="Status" Sortable="false" Context="h">
                            <Template>
                                <RadzenCheckBox TValue="bool?" Disabled @bind-Value="h.Status" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Width="5rem" Title="Actions" Sortable="false" Context="h">
                            <Template>
                                <RadzenButton Size="ButtonSize.ExtraSmall"
                                              Icon="more_vert"
                                              Variant="Variant.Text"
                                              Click="@((args)=>ShowContextMenuWithContent(args,h.Id))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                    <LoadingTemplate>
                        <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal">
                            <RadzenProgressBar ShowValue="false"
                                               ProgressBarStyle="ProgressBarStyle.Info" Visible="isLoading">
                                <Template>
                                    <RadzenText>Loading...</RadzenText>
                                </Template>
                            </RadzenProgressBar>
                        </RadzenStack>
                    </LoadingTemplate>
                </RadzenDataGrid>
            </RadzenCard>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Add Holiday" Visible="visibleAdd" Icon="edit_calendar">
            <CreateHolidayModal Closed="CloseTab" />
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
@code {
    bool visibleAdd = false;
    bool isLoading = false;
    [Parameter] public int SelectedIndex { get; set; } = 0;
    void ShowContextMenuWithContent(MouseEventArgs args, long id)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">
        <RadzenMenuItem Click="@(() => Delete(id))" Icon="delete" Text="Delete" Value="@id" />
        <RadzenMenuItem Click="@(() => ShowEdit(id))" Icon="edit" Text="Edit" Value="@id" />
    </RadzenMenu>
    );
    }
    void CloseTab()
    {
        if (SelectedIndex == 1)
        {
            SelectedIndex = 0;

            visibleAdd = false;

            StateHasChanged();
        }
    }
    async void Reload()
    {
        await GetsHolidays(searchField);
    }

    async void LoadData(LoadDataArgs e)
    {
        pageIndex = e.Skip!.Value;
        if (!string.IsNullOrEmpty(e.OrderBy))
        {
            sortColumn = e.OrderBy.Split(" ")[0];
            string dir = e.OrderBy.Split(" ")[1];
            sortDescending = dir.Contains("asc") ? false : true;
        }
        searchField = e.Filter ?? string.Empty;

        await GetsHolidays(searchField);
    }

    void ChangedPageSize(int page)
    {
        pageSize = page;
    }

}
