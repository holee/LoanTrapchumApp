<div class="address">
    <span class="province">
        @ProInKhmer
    </span>
    <span class="district">
        @DisInKhmer
    </span>
    <span class="commune">
        @ComInKhmer
    </span>
    <span class="village">
        @VilInKhmer
    </span>
</div>
@code{
    [Parameter] public string? ProInKhmer { get; set; } = string.Empty;
    [Parameter] public string? DisInKhmer { get; set; } = string.Empty;
    [Parameter] public string? ComInKhmer { get; set; } = string.Empty;
    [Parameter] public string? VilInKhmer { get; set; } = string.Empty;
}