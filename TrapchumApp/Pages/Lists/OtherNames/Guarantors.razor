@page "/App/Customer/Guarantor"
@using TrapchumApp.Services
<PageTitle>Guarantor</PageTitle>
<RadzenTabs @ref="tabs"
            RenderMode="TabRenderMode.Server"
            SelectedIndexChanged="SelectTabChanged"
            SelectedIndex="selectedTabIndex">
    <Tabs>
        <RadzenTabsItem Text="All" Icon="groups">
            <AllGuarantors OpenDetailTab="DetailGuarantorTab"
                           OpenEditTab="EditGuarantorTab"
                           SetGuarantorId="SetGuarantorId"
                           OpenAddTab="AddGuarantorTab" />
        </RadzenTabsItem>
        <RadzenTabsItem Text="Add" Visible="ShowAddTab" Icon="@IconNames.PersonAdd">
            <GuarantorCreate  Closed="CloseGuarantorTab" @key="@Guid.NewGuid().ToString("N")" />
        </RadzenTabsItem>

        <RadzenTabsItem Text="Edit" Visible="ShowEditTab" Icon="@IconNames.PersonEdit">
            <GuarantorEdit NameId="@SelectedGuarantorId" Closing="CloseGuarantorTab" @key="@Guid.NewGuid().ToString("N")" />
        </RadzenTabsItem>

        <RadzenTabsItem Text="Details" Visible="ShowDetailTab" Icon="info">
            <GuarantorDetails Id="@SelectedGuarantorId" Closing="CloseGuarantorTab" @key="@Guid.NewGuid().ToString("N")" />
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
