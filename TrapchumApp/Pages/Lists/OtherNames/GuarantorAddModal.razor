@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Services
<EditForm Model="model" OnValidSubmit="@OnSaveChanges">
    <ValidationSummary />
    <FluentValidationValidator DisableAssemblyScanning="true"></FluentValidationValidator>
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
        <RadzenColumn Size="5">
            <RadzenFormField Text="Name" AllowFloatingLabel="true" class="rz-w-100">
                <RadzenTextBox @bind-Value="model.Name"
                               @bind-Value:after="SetFirstName"
                               class="rz-w-100"
                               Placeholder="Your Name" />
                <ValidationMessage For="@(() => model.Name)"></ValidationMessage>
            </RadzenFormField>
            <RadzenLabel></RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="5">
            <RadzenFormField Text="Khmer Name" class="rz-w-100">
                <RadzenTextBox @bind-Value="model.AltName"
                               class="rz-w-100"
                               Placeholder="" />
                <ValidationMessage For="@(() => model.AltName)"></ValidationMessage>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="2">
            <div class="rz-text-align-center">
                <RadzenCheckBox TValue="bool?" @bind-Value="model.IsActive" />
                <RadzenLabel>
                    @if (model.IsActive == true)
                    {
                        @("Is Active")
                    }
                    else
                    {
                        @("Is InActive")
                    }
                </RadzenLabel>

            </div>
        </RadzenColumn>
    </RadzenRow>
    <RadzenFieldset>
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                <RadzenIcon Icon="info" /><strong>Contact Info</strong>
            </RadzenStack>
        </HeaderTemplate>
        <ChildContent>
            <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
                <RadzenColumn Size="2">
                    <RadzenLabel>Contact Name</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="10">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="2">
                            <RadzenDropDown TValue="string"
                                            Data="StorageConstant.Salutations"
                                            TextProperty="label"
                                            ValueProperty="value"
                                            class="rz-w-100"
                                            @bind-Value="model.Gender">
                            </RadzenDropDown>
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenTextBox Placeholder="First Name..."
                                           class="rz-w-100"
                                           @bind-Value="model.FirstName" />
                            <ValidationMessage For="@(() => model.FirstName)" />
                        </RadzenColumn>
                        <RadzenColumn Size="2">
                            <RadzenTextBox class="rz-w-100"
                                           Placeholder="Middle Name..."
                                           @bind-Value="model.MiddleName" />
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenTextBox class="rz-w-100"
                                           Placeholder="Last Name"
                                           @bind-Value="model.LastName" />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
                <RadzenColumn Size="2">
                    <RadzenLabel>Contact Number</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="10">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4">
                            <RadzenTextBox Placeholder="Phone Number"
                                           class="rz-w-100"
                                           @bind-Value="model.Phone" />
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenTextBox Placeholder="Alternate Phone"
                                           class="rz-w-100"
                                           @bind-Value="model.AltPhone" />
                        </RadzenColumn>
                        <RadzenColumn Size="4">
                            <RadzenTextBox Placeholder="Email..."
                                           class="rz-w-100"
                                           @bind-Value="model.EmailAddress" />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
                <RadzenColumn Size="2">
                    <RadzenLabel>Note</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="10">
                    <RadzenTextArea class="rz-w-100"
                                    @bind-Value="model.Description"></RadzenTextArea>
                </RadzenColumn>
            </RadzenRow>
        </ChildContent>
    </RadzenFieldset>
    <AddressBaseCreate model="model" />
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 Gap="1rem"
                 JustifyContent="JustifyContent.End">
        <RadzenButton ButtonStyle="ButtonStyle.Success"
                      Icon="save"
                      Text="Save"
                      ButtonType="ButtonType.Submit"
                      Size="ButtonSize.Small" />
        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                      ButtonType="ButtonType.Button"
                      Icon="cancel"
                      Text="Cancel"
                      Click="Cancel"
                      Size="ButtonSize.Small" />
    </RadzenStack>
</EditForm>
@code {
    void SetFirstName()
    {
        model.FirstName = model.Name;
    }
}
