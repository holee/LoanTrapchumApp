@using Applications.Requests.Lists.OtherNames
@using Domains.Models.Bases
@using TrapchumApp.Services
<RadzenFieldset>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
            <RadzenIcon Icon="contacts"/>
            <strong>Contact</strong>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenRow class="rz-my-2">
            <RadzenColumn Size="2">
                <RadzenLabel>Contact Name</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="10">
                <RadzenRow>
                    <RadzenColumn Size="5">
                        <RadzenTextBox @bind-Value="Model.AltName"
                                       class="w-100"
                                       Placeholder="Khmer Name"/>
                        <ValidationMessage For="@(() => Model.AltName)"></ValidationMessage>
                    </RadzenColumn>
                    <RadzenColumn Size="5">
                        <RadzenTextBox @bind-Value="Model.Name"
                                       class="w-100"
                                       Change="SetFirstName"
                                       Placeholder="Your Name"/>
                    </RadzenColumn>
                    <RadzenColumn Size="2">
                        <div class="text-start">
                            <RadzenCheckBox TValue="bool?" @bind-Value="Model.IsActive" Name="IsActive"/>
                            <RadzenLabel Component="IsActive"
                                         Text="@(Model.IsActive == true ? "Active" : "In Active")"/>
                        </div>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow class="rz-my-2">
            <RadzenColumn Size="2">
                <RadzenLabel>Contact Name</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="10">
                <RadzenRow>
                    <RadzenColumn Size="2">
                        <RadzenDropDown TValue="string"
                                        Data="StorageConstant.Salutations"
                                        TextProperty="label"
                                        ValueProperty="value"
                                        class="w-100"
                                        @bind-Value="Model.Gender">
                        </RadzenDropDown>
                        <ValidationMessage For="@(() => Model.Gender)"/>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenTextBox Placeholder="Firstname..."
                                       class="w-100"
                                       @bind-Value="Model.FirstName"/>
                        <ValidationMessage For="@(() => Model.FirstName)"/>
                    </RadzenColumn>
                    <RadzenColumn Size="2">
                        <RadzenTextBox class="w-100"
                                       Placeholder="Middle Name..."
                                       @bind-Value="Model.MiddleName"/>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenTextBox class="w-100"
                                       Placeholder="Last Name"
                                       @bind-Value="Model.LastName"/>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center" class="mb-2">
            <RadzenColumn Size="2">
                <RadzenLabel>Contact Number</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="10">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="4">
                        <RadzenTextBox Placeholder="Phone Number"
                                       class="w-100"
                                       @bind-Value="Model.Phone"/>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenTextBox Placeholder="Alternate Phone"
                                       class="w-100"
                                       @bind-Value="Model.AltPhone"/>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenTextBox Placeholder="Email..."
                                       class="w-100"
                                       @bind-Value="Model.EmailAddress"/>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center" class="mb-2">
            <RadzenColumn Size="2">
                <RadzenLabel>Note</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="10">
                <RadzenTextArea class="w-100"
                                @bind-Value="Model.Description"></RadzenTextArea>
            </RadzenColumn>
        </RadzenRow>
    </ChildContent>
</RadzenFieldset>


