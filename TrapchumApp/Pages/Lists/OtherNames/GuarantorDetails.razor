@page "/App/Customers/Guarantors/{Id:long}/Details"
@using Applications.Responses.ViewModels.Loans
@using Applications.Responses.ViewModels.Loans.Disbursements
@using Applications.Responses.ViewModels.Loans.Requests
@using TrapchumApp.Services
<PageTitle>Guarantor</PageTitle>
<Containers Fluid>
    <table class="table table-sm">
        <tbody>
            <tr>
                <th class="rz-background-color-base-100 w-25">Name</th>
                <td>
                    @Guarantor?.GuarantorName
                </td>
            </tr>
            <tr>
                <th class="rz-background-color-base-100 w-25">Sex</th>
                <td>
                    @Guarantor?.Gender
                </td>
            </tr>
            <tr>
                <th class="rz-background-color-base-100 w-25">Phone</th>
                <td>
                    @Guarantor?.Phone
                </td>
            </tr>
            <tr>
                <th class="rz-background-color-base-100 w-25">NumberOfLoan</th>
                <td>
                    @Guarantor?.NumberOfLoan
                </td>
            </tr>
            <tr>
                <th class="rz-background-color-base-100 w-25 w-25">Address</th>
                <td>
                    @Guarantor?.ToString()
                </td>
            </tr>
            <tr>
                <th class="rz-background-color-base-100">Status</th>
                <td>
                    <RadzenCheckBox TValue="bool?" Value="@Guarantor?.IsActive" ReadOnly />
                </td>
            </tr>
        </tbody>
    </table>
    <RadzenTabs>
        <Tabs>
            <RadzenTabsItem Text="Loans">
                <RadzenDataGrid Responsive
                                AllowAlternatingRows
                                GridLines="DataGridGridLines.Both"
                                TItem="VGuarantorLoan"
                                Density="Density.Compact"
                                Data="@Loans">
                    <Columns>
                        <RadzenDataGridColumn Title="#" 
                                    Property="@nameof(VGuarantorLoan.LoanId)" 
                                    Width="5rem"
                                    TextAlign="TextAlign.Center"
                                    Context="g">
                            <Template>
                                @(Loans.IndexOf(g) + 1)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="CustomerName" Property="@(nameof(VGuarantorLoan.CustomerName))" />
                        <RadzenDataGridColumn Title="Branch" Property="@(nameof(VGuarantorLoan.BranchName))" />
                        <RadzenDataGridColumn Title="Principle" Property="@(nameof(VGuarantorLoan.Principle))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Title="Installments" Property="@(nameof(VGuarantorLoan.Installments))" />
                        <RadzenDataGridColumn Title="InterestRate"
                                              TextAlign="TextAlign.Right"
                                              Property="@(nameof(VGuarantorLoan.InterestRate))" Context="g">
                            <Template>
                                @g.InterestRate
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Title="Currency" Property="@(nameof(VGuarantorLoan.CurrencyName))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Title="AdminFeeRate" Property="@(nameof(VGuarantorLoan.AdminFeeRate))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Title="Col.FeeRate" Property="@(nameof(VGuarantorLoan.CollectionFeeRate))" />

                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Loans Request">
                <RadzenDataGrid Responsive
                                AllowAlternatingRows
                                GridLines="DataGridGridLines.Both"
                                TItem="VGuarantorLoanRequest"
                                Density="Density.Compact"
                                Data="@LoanRequest">
                    <Columns>
                        <RadzenDataGridColumn Title="#" Property="@(nameof(VLoanGuarantors.Id))" Context="g">
                            <Template>
                                @(LoanRequest.ToList().IndexOf(g) + 1)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="CreditAgent" Property="@(nameof(VGuarantorLoanRequest.CreditAgentName))" />
                        <RadzenDataGridColumn Title="Customer" Property="@(nameof(VGuarantorLoanRequest.CustomerName))" />
                        <RadzenDataGridColumn Title="RequestAmount" Property="@(nameof(VGuarantorLoanRequest.RequestAmount))" />
                        <RadzenDataGridColumn Title="AprovedAmount"
                                              TextAlign="TextAlign.Right"
                                              Property="@nameof(VGuarantorLoanRequest.AprovedAmount)" 
                                              Context="g">
                            <Template>
                                @g.AprovedAmount
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Title="Currency" Property="@(nameof(VGuarantorLoanRequest.CurrencyName))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Title="Rate" Property="@(nameof(VGuarantorLoanRequest.InterestRate))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Title="AdminFee" Property="@(nameof(VGuarantorLoanRequest.AdminFeeRate))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Title="CollectionFee" Property="@(nameof(VGuarantorLoanRequest.CollectionFeeRate))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Center"
                                              Title="Status" Property="@(nameof(VGuarantorLoanRequest.Status))" />

                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
    <RadzenStack AlignItems="AlignItems.Center"
                 class="rz-mt-2"
                 Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                      Icon="cancel"
                      Text="Close"
                      Click="CloseGuarantorTab"
                      Size="ButtonSize.Small" />
    </RadzenStack>
</Containers>

