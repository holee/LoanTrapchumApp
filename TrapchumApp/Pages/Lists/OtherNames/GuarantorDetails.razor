@page "/App/Customers/Guarantors/{Id:long}/Details"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Applications.Responses.ViewModels.Loans
@using Applications.Responses.ViewModels.Loans.Disbursements
@using Applications.Responses.ViewModels.Loans.Requests
@using TrapchumApp.Services
<PageTitle>Guarantor</PageTitle>
<Containers Fluid>
    <table class="table table-sm">
        <tbody>
            <tr>
                <th class="rz-background-color-base-100 w-25">Name</th>
                <td>
                    @Guarantor?.GuarantorName
                </td>
            </tr>
            <tr>
                <th class="rz-background-color-base-100 w-25">Sex</th>
                <td>
                    @Guarantor?.Gender
                </td>
            </tr>
            <tr>
                <th class="rz-background-color-base-100 w-25">Phone</th>
                <td>
                    @Guarantor?.Phone
                </td>
            </tr>
            <tr>
                <th class="rz-background-color-base-100 w-25">NumberOfLoan</th>
                <td>
                    @Guarantor?.NumberOfLoan
                </td>
            </tr>
            <tr>
                <th class="rz-background-color-base-100 w-25 w-25">Address</th>
                <td>
                    @Guarantor?.ToString()
                </td>
            </tr>
            <tr>
                <th class="rz-background-color-base-100">Status</th>
                <td>
                    <RadzenCheckBox TValue="bool?" Value="@Guarantor?.IsActive" ReadOnly />
                </td>
            </tr>
        </tbody>
    </table>
    <RadzenTabs>
        <Tabs>
            <RadzenTabsItem Text="Loans">
                <RadzenDataGrid Responsive
                                AllowAlternatingRows
                                GridLines="DataGridGridLines.Both"
                                TItem="VGuarantorLoan"
                                Density="Density.Compact"
                                ColumnWidth="10rem"
                                AllowColumnPicking="true"
                                Data="@Loans">
                                <HeaderTemplate>

                                </HeaderTemplate>
                    <Columns>
                        <RadzenDataGridColumn Title="#"
                                              Property="@nameof(VGuarantorLoan.LoanId)"
                                              Width="5rem"
                                              TextAlign="TextAlign.Center"
                                              Context="g">
                            <Template>
                                @(Loans.IndexOf(g) + 1)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="CustomerName" Property="@(nameof(VGuarantorLoan.CustomerName))" />
                        <RadzenDataGridColumn Title="Branch" Property="@(nameof(VGuarantorLoan.BranchName))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Visible="false"
                                              Title="Installments" Property="@(nameof(VGuarantorLoan.PeriodName))" />
                        <RadzenDataGridColumn Title="InterestRate"
                                              TextAlign="TextAlign.Right"
                                              Visible="false"
                                              Property="@(nameof(VGuarantorLoan.InterestRate))" Context="g">
                            <Template>
                                @g.InterestRate
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TextAlign="TextAlign.Left"
                                              Visible="false"
                                              Title="Currency" 
                                              Property="@(nameof(VGuarantorLoan.CurrencyName))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Visible="false"
                                              Title="Admin Fee Rate" Property="@(nameof(VGuarantorLoan.AdminFeeRate))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Visible="false"
                                              Title="Collection Fee Rate" Property="@(nameof(VGuarantorLoan.CollectionFeeRate))" />
                        <RadzenDataGridColumn Title="Principle" 
                                    Context="g"
                                    TextAlign="TextAlign.Right"
                                    Property="@(nameof(VGuarantorLoan.Principle))">
                                <Template>
                                    @g.Principle
                                </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Paid Principle"
                                              Context="g"
                                              TextAlign="TextAlign.Right"
                                              Property="@(nameof(VGuarantorLoan.PaidPrinciple))">
                            <Template>
                                @g.PaidPrinciple
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="OutStanding"
                                              Context="g"
                                              TextAlign="TextAlign.Right"
                                              Property="@(nameof(VGuarantorLoan.OutStanding))">
                            <Template>
                                @g.OutStanding
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Loans Request">
                <RadzenDataGrid Responsive
                                AllowAlternatingRows
                                GridLines="DataGridGridLines.Both"
                                TItem="VGuarantorsLoanRequest"
                                Density="Density.Compact"
                                ColumnWidth="10rem"
                                AllowColumnPicking="true"
                                Data="@LoanRequest">
                                <HeaderTemplate>

                                </HeaderTemplate>
                    <Columns>
                        <RadzenDataGridColumn Title="#"
                                              Width="5rem"
                                              Property="@(nameof(VLoanRequestGuarantor.Id))"
                                              TextAlign="TextAlign.Center"
                                              Context="g">
                            <Template>
                                @(LoanRequest.IndexOf(g) + 1)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Agent" Property="@(nameof(VGuarantorsLoanRequest.CreditAgentName))" />
                        <RadzenDataGridColumn Title="Customer" Property="@(nameof(VGuarantorsLoanRequest.CustomerName))" />
                        <RadzenDataGridColumn Title="Request Amount"
                                              TextAlign="TextAlign.Right"
                                              Context="g"
                                              Property="@(nameof(VGuarantorsLoanRequest.RequestAmount))">
                            <Template>
                                @g.AprovedAmount.Format(g.CurrencyId)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Aproved Amount"
                                              TextAlign="TextAlign.Right"
                                              Property="@nameof(VGuarantorsLoanRequest.AprovedAmount)"
                                              Context="g">
                            <Template>
                                @g.AprovedAmount.Format(g.CurrencyId)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Title="Currency" Property="@(nameof(VGuarantorsLoanRequest.CurrencyName))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Title="Rate" Property="@(nameof(VGuarantorsLoanRequest.InterestRate))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Title="Admin Fee" Property="@(nameof(VGuarantorsLoanRequest.AdminFeeRate))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                              Title="Collection Fee" Property="@(nameof(VGuarantorsLoanRequest.CollectionFeeRate))" />
                        <RadzenDataGridColumn TextAlign="TextAlign.Center"
                                              Width="5rem"
                                              Title="Status"
                                              Property="@(nameof(VGuarantorsLoanRequest.Status))" />

                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
    <RadzenStack AlignItems="AlignItems.Center"
                 class="rz-mt-2"
                 Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                      Icon="cancel"
                      Text="Close"
                      Click="CloseGuarantorTab"
                      Size="ButtonSize.Small" />
    </RadzenStack>
</Containers>

