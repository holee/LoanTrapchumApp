@page "/App/Names"
@using Applications.Responses.ViewModels.OtherNames
@using Applications.Responses.ViewModels.Vendors
@using Microsoft.AspNetCore.Components.Web
@using TrapchumApp.Services
<PageTitle>Names</PageTitle>
<RadzenTabs @bind-SelectedIndex="@selectedIndex" @ref="tabs" RenderMode="TabRenderMode.Server">
    <Tabs>
        <RadzenTabsItem Text="Names" Icon="patient_list">
            <Card>
                <CardBody>
                    <PageDropDown PageSizeChanged="PageSizeChanged"
                                  Reload="Reload"
                                  ShowSearchBox="true"
                                  OnTextChanged="OnSearch"
                                  ShowReload="true">
                        <LeftChildContent>
                            <RadzenButton Icon="add"
                                          Size="ButtonSize.Small"
                                          Text="New Name"
                                          Click="AddTabOtherName"
                                          ButtonStyle="ButtonStyle.Primary" />
                        </LeftChildContent>
                        <RightChildContent>
                            <div>
                                <RadzenCheckBox TValue="bool" @bind-Value=@includeInactive Change="ex=>IncludeInActiveChanged(ex)" Name="CheckBox1" />
                                <RadzenLabel Text="Include InActive" Component="CheckBox1" Style="margin-left: 8px; vertical-align: middle;" />
                            </div>
                        </RightChildContent>
                    </PageDropDown>
                    <RadzenDataGrid TItem="VOtherNames"
                                    Density="Density.Compact"
                                    Responsive
                                    Count="@counts"
                                    PageSize="@pageSize"
                                    LoadData="@LoadData"
                                    ColumnWidth="15rem"
                                    AllowPaging="true"
                                    PagerHorizontalAlign="HorizontalAlign.Right"
                                    ShowPagingSummary="true"
                                    AllowSorting="true"
                                    Data="Names">
                        <Columns>
                            <RadzenDataGridColumn Title="Name" Property="@(nameof(VOtherNames.AltName))" />
                            <RadzenDataGridColumn Width="6rem" Title="Gender" Property="@(nameof(VendorVm.Gender))" />
                            <RadzenDataGridColumn Sortable="false" Width="8rem" Title="Phone" Property="@(nameof(VOtherNames.Phone))" />
                            <RadzenDataGridColumn Sortable="false" Title="Email" Property="@(nameof(VOtherNames.EmailAddress))" />
                            <RadzenDataGridColumn Sortable="false" Title="Address" Property="@(nameof(VOtherNames.Description))" Context="v">
                                <Template>
                                    @v.ToString()
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Width="8rem" Sortable="false" Title="Actions" Property="@(nameof(VOtherNames.Id))" Context="v">
                                <Template>
                                    <RadzenButton Size="ButtonSize.ExtraSmall"
                                                  Icon="more_vert"
                                                  Variant="Variant.Text"
                                                  Click="@((args)=>ShowContextMenuWithContent(args,v))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </CardBody>
            </Card>
        </RadzenTabsItem>
        <RadzenTabsItem Visible="IsEnableNew" Text="New" Icon="person_add">
            <NameCreateModal Salutations="Salutations"
                             SelectIndex="CloseTabs"
                             ProvinceList="ProvinceList" />
        </RadzenTabsItem>
        <RadzenTabsItem Visible="IsEnableEdit" Text="Edit" Icon="edit">
            <NameEditModal OnClose="@OnEditClose" Id="@_nameId" Salutations="Salutations" />
        </RadzenTabsItem>
        <RadzenTabsItem Visible="IsEnableDetail" Text="Details" Icon="person">
            <NameDetailModal OnEdit="OnNameEdit" OnClose="OnDetailsClose" Id="@_nameId" />
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    void ShowContextMenuWithContent(MouseEventArgs args, VOtherNames e)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">
        <RadzenMenuItem Click="@(()=>DisplayDetail(e.Id))" Icon="info" Text="Details" Value="@e.Id"></RadzenMenuItem>
        <RadzenMenuItem Click="@(()=>ShowEdit(e.Id))" Icon="edit" Text="Edit" Value="@e.Id"></RadzenMenuItem>
        <RadzenMenuItem Click="@(()=>OnDelete(e.Id))" Icon="delete" Text="Delete" Value="@e.Id"></RadzenMenuItem>
        <RadzenMenuItem Click="@(()=>ConvertToEmployee(e.Id))" Icon="subdirectory_arrow_right" Text="To Employee" Value="@e"></RadzenMenuItem>
        <RadzenMenuItem Click="@(()=>ConvertToCustomer(e.Id))" Icon="subdirectory_arrow_right" Text="To Customer" Value="@e"></RadzenMenuItem>
        <RadzenMenuItem Click="@(()=>ConvertToVedor(e.Id))" Icon="subdirectory_arrow_right" Text="To Vendor" Value="@e"></RadzenMenuItem>
    </RadzenMenu>
    );
    }
}

