@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.Guarantor.Dtos
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.ViewModels.OtherNames
@using Microsoft.AspNetCore.Components.Web
@using Radzen.Blazor.Rendering
@using TrapchumApp.Services
<style type="text/css">
    .my-popup1 {
        display: none;
        position: absolute;
        overflow: hidden;
        height: 200px;
        width: 600px;
        border: var(--rz-panel-border);
        background-color: var(--rz-panel-background-color);
        box-shadow: var(--rz-panel-shadow);
        border-radius: var(--rz-border-radius)
    }
</style>
<RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" class="my-2">
    <RadzenTextBox @ref="@textBox1" Value="@FullName" @oninput="@OnInput"
                   @onclick="OpenPopup"
                   class="form-control"
                   @onkeydown="@OnKeyDown" />
    <Popup @ref="popup1" id="popup1" AutoFocusFirstElement="true" class="my-popup1">
        <RadzenDataGrid @ref="grid1" id="grid1"
                        TItem="VGuarantor"
                        Data="@Guarantors"
                        Density="Density.Compact"
                        AllowAlternatingRows="true"
                        RowSelect="@OnRowGuarantorSelect"
                        Responsive="true"
                        AllowSorting="true"
                        Style="height:200px;width:100%;">
            <Columns>
                <RadzenDataGridColumn Context="c" Property="@nameof(VGuarantor.GuarantorName)" Title="Name">
                    <Template>
                        <KhmerName AltName="@c.GuarantorName" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(VGuarantor.FullName)" Title="FullName" />
                <RadzenDataGridColumn Property="@nameof(VGuarantor.Gender)" Title="Salutation" />
                <RadzenDataGridColumn Property="@nameof(VGuarantor.Phone)" Title="Phone" />
            </Columns>
        </RadzenDataGrid>
    </Popup>
</RadzenStack>
<RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal">
    <RadzenDataGrid Data="SelectedGuarantors"
                    GridLines="DataGridGridLines.Both"
                    @ref="gridGuarantors"
                    Density="Density.Compact"
                    SelectionMode="DataGridSelectionMode.Multiple"
                    PagerHorizontalAlign="HorizontalAlign.Right"
                    Style="min-height:20rem;height:20rem;max-height:20rem;">
        <Columns>
            <RadzenDataGridColumn TextAlign="TextAlign.Center" Width="4rem" Property="id" Title="#" Context="g">
                <Template>
                    @(SelectedGuarantors.IndexOf(g) + 1)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="GuarantorName" Title="Name" Sortable="true" />
            <RadzenDataGridColumn Property="Phone" Title="Phone" Width="7rem" />
            <RadzenDataGridColumn Context="g" Property="ProInKhmer" Title="Address">
                <Template>
                    @g.ToString()
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="g"
                                  Property="@nameof(VGuarantor.Id)" Title="Action" Width="5rem">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall"
                                  Variant="Variant.Text"
                                  Click="@(()=>RemoveGuarantor(g))"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Icon="delete"></RadzenButton>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenStack>
<RadzenStack JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" class="my-2">
    <RadzenButton Size="ButtonSize.ExtraSmall"
                  Icon="check"
                  Text="Accept"
                  Click="AcceptSelectedGuarantors"
                  ButtonStyle="ButtonStyle.Success" />
    <RadzenButton Size="ButtonSize.ExtraSmall"
                  Text="Close"
                  Icon="cancel"
                  Click="@(()=>DialogService.Close(Enumerable.Empty<VGuarantor>()))"
                  ButtonStyle="ButtonStyle.Danger" />
</RadzenStack>

@code {
    RadzenTextBox textBox1;

    string? customerId = string.Empty;

    string? FullName = "";

    Popup popup1;

    RadzenDataGrid<VGuarantor> grid1;

    RadzenDataGrid<VGuarantor> gridGuarantors;

    int selectedIndex = 0;

    async Task OnRowGuarantorSelect(VGuarantor g)
    {
        FullName = "";

        FullName = g.FullName;

        if (!SelectedGuarantors.Any(x => x.Id == g.Id))
        {
            SelectedGuarantors.Add(g);

            await gridGuarantors.Reload();
        }

        await popup1.CloseAsync();


    }

    async Task OnInput(ChangeEventArgs args)
    {
        selectedIndex = 0;

        filterText = args.Value!.ToString();

        await GetGuarantors();

        await grid1.Reload();
    }

    async Task OnKeyDown(KeyboardEventArgs args)
    {

        var items = Guarantors;

        var popupOpened = await js.InvokeAsync<bool>("popupOpened", "popup1");

        var key = args.Code != null ? args.Code : args.Key;

        if (!args.AltKey && (key == "ArrowDown" || key == "ArrowUp"))
        {

            var result = await js.InvokeAsync<int[]>("focusTableRow", "grid1", key, selectedIndex, null, false);

            selectedIndex = result.First();

        }
        else if (args.AltKey && key == "ArrowDown" || key == "Enter" || key == "NumpadEnter")
        {

            if (popupOpened && (key == "Enter" || key == "NumpadEnter"))
            {

                customerId = items.ElementAtOrDefault(selectedIndex)?.Id;

            }

            await popup1.ToggleAsync(textBox1.Element);

        }
        else if (key == "Escape" || key == "Tab")
        {
            await popup1.CloseAsync();
        }
    }

    async Task RemoveGuarantor(VGuarantor g)
    {
        if (SelectedGuarantors.Any(x => x.Id == g.Id))
        {
            SelectedGuarantors.Remove(g);

            await gridGuarantors.Reload();
        }


    }


    async Task OpenPopup(MouseEventArgs arg)
    {
        await GetGuarantors();
        await popup1.ToggleAsync(textBox1.Element);
    }

}