@page "/App/Customers/Guarantors"
@using Applications.Features.LoanRequests.Interfaces
@using System.Threading.Tasks
<PageTitle>Guarantor</PageTitle>
<RadzenTabs @ref="tabs"
            RenderMode="TabRenderMode.Client"
            @bind-SelectedIndex="@selectedTabIndex">
    <Tabs>
        <RadzenTabsItem Text="All" Icon="groups">
            <AllGuarantors ShowEdit="@EditGuarantorTab"
                           ShowDetails="@DetailsGuarantorTab">
                <ChildContent>
                    <AddButton Title="Add Guarantor" OnClick="@CreateGuarantorTab" />
                </ChildContent>
            </AllGuarantors>
        </RadzenTabsItem>

        @foreach (var tab in _tabs)
        {
            <RadzenTabsItem Text="@tab.Title" @key="@tab.Key" Icon="@tab.Icon">
                <Template>
                    <ClosedTab TabId="@tab.Key" Title="@tab.Title" Closed="@(() => RemoveTab(tab.Key))" />
                </Template>
                <ChildContent>
                    @tab.Content
                </ChildContent>
            </RadzenTabsItem>
        }
    </Tabs>
</RadzenTabs>
@code {

    private List<CustomTab> _tabs = [];


    private void CreateGuarantorTab()
    {
        var tabKey = Guid.NewGuid().ToString("N");

        RenderFragment content = builder =>
        {
            builder.OpenComponent(0, typeof(GuarantorCreate));

            builder.AddAttribute(1, "ClosedTab", EventCallback.Factory.Create(this, () =>
            {
                RemoveTab(tabKey);
            }));
            builder.CloseComponent();
        };

        _tabs.Add(new CustomTab(tabKey, "Add Guarantor", TabActions.Create, content));

        selectedTabIndex = _tabs.Count; // +1 for the All tab

    }

    private async Task EditGuarantorTab(string key)
    {
        var tabKey = $"edit_{key}";

        var existingIndex = _tabs.FindIndex(t => t.Key == tabKey);

        if (existingIndex != -1)
        {
            selectedTabIndex = existingIndex + 1;

            StateHasChanged();

            return;
        }


        RenderFragment content = builder =>
        {
            builder.OpenComponent(0, typeof(GuarantorEditPage));
            builder.AddAttribute(1, "NameId", key);
            builder.AddAttribute(2, "ClosedTab", EventCallback.Factory.Create(this, () =>
            {
                RemoveTab(tabKey);
            }));
            builder.SetKey(tabKey);
            builder.CloseComponent();
        };

        _tabs.Add(new CustomTab(tabKey, "Edit Guarantor", TabActions.Edit, content));

        selectedTabIndex = _tabs.Count;
    }


    private async Task DetailsGuarantorTab(string key)
    {
        var tabKey = $"details_{key}";

        var existingIndex = _tabs.FindIndex(t => t.Key == tabKey);

        if (existingIndex != -1)
        {
            selectedTabIndex = existingIndex + 1;

            StateHasChanged();

            return;
        }

        RenderFragment content = builder =>
        {
            builder.OpenComponent(0, typeof(GuarantorDetails));
            builder.AddAttribute(1, "Id", key);
            builder.AddAttribute(2, "ClosedTab", EventCallback.Factory.Create(this, () =>
            {
                RemoveTab(tabKey);
            }));
            builder.SetKey(tabKey);
            builder.CloseComponent();
        };

        _tabs.Add(new CustomTab(tabKey, "Guarantor", TabActions.Details, content));

        selectedTabIndex = _tabs.Count;
    }



    private void RemoveTab(string key)
    {

        var tab = _tabs.FirstOrDefault(t => t.Key == key);

        if (tab != null)
        {
            var idx = _tabs.IndexOf(tab);

            _tabs.Remove(tab);

            selectedTabIndex = Math.Max(0, idx - 1);
        }
    }

}