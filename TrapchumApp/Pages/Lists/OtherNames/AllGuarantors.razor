@using Applications.Features.Guarantor.Dtos
@using Applications.Responses.ViewModels.OtherNames
<GridToolbar SearchChanged="SearchTextChanged">
    <LeftChildren>
        @if(ChildContent is not null)
        {
            @ChildContent
        }
    </LeftChildren>
    <RightChildren>
        <div class="rz-text-align-center">
            <RadzenCheckBox TValue="bool"
                            Name="IncludeInActive"
                            Change="@IncludeInactiveCheckedChanged"
                            Value="@includeInactive" />
            <RadzenLabel Text="Include Active Loan" Component="IncludeInActive" />
        </div>
    </RightChildren> 
</GridToolbar>
<RadzenDataGrid Data="guarantors"
                TItem="VGuarantor"
                GridLines="DataGridGridLines.Both"
                Responsive="true"
                Density="Density.Compact"
                ShowPagingSummary="true"
                AllowAlternatingRows="true"
                IsLoading="isLoading"
                AllowPaging="true"
                AllowFiltering="true"
                AllowSorting="true"
                AllowColumnPicking="true"
                PagerHorizontalAlign="HorizontalAlign.Right"
                Count="@counts"
                PageSize="pageSize"
                PageSizeOptions="@StorageConstant.PageSizeOptions"
                PageSizeChanged="@ChangedPageSize"
                PagerPosition="PagerPosition.Bottom"
                RowSelect="@OnRowSelected"
                LoadData="@LoadGuarantors">
    <HeaderTemplate>
    
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Width="4rem"
                              Filterable="false"
                              Sortable="false"
                              Property="id"
                              TextAlign="TextAlign.Center"
                              Pickable="false"
                              Title="#" Context="g">
            <Template>
                @(guarantors.IndexOf(g) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VGuarantor.GuarantorName)"
                              Title="Name"
                              Context="g"
                              Width="10rem"
                              Sortable="true">
            <Template>
                <KhmerName AltName="@g.GuarantorName" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VGuarantor.FullName)"
                              Title="Full Name"
                              Context="g"
                              Visible="false"
                              Sortable="true">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VGuarantor.Phone)"
                              Width="8rem"
                              Title="Phone" />
        <RadzenDataGridColumn Context="g"
                              Property="@nameof(VGuarantor.ProInKhmer)"
                              Filterable="false"
                              Sortable="false"
                              Title="Address">
            <Template>
                <AddressInfo VilInKhmer="@g?.VilInKhmer"
                             ComInKhmer="@g?.ComInKhmer"
                             ProInKhmer="@g?.ProInKhmer"
                             DisInKhmer="@g?.DisInKhmer" />
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                              Context="g"
                              Width="8rem"
                              Visible="false"
                              Property="@nameof(VGuarantor.NumberOfLoan)"
                              Title="Loans">
            <Template>
                @g.NumberOfLoan
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                              Context="g"
                              Width="10rem"
                              Visible="false"
                              Property="@nameof(VGuarantor.Requests)"
                              Title="Requests">
            <Template>
                @g.Requests
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TextAlign="TextAlign.Center"
                              Width="5rem"
                              Context="g"
                              Filterable="false"
                              Sortable="false"
                              Title="Loan Active">
            <Template>
                <RadzenCheckBox Value="@g.IsActive" ReadOnly />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="5rem"
                              Filterable="false"
                              Sortable="false"
                              TextAlign="TextAlign.Center"
                              Context="g" Title="Actions">
            <Template>
                <RadzenButton Size="ButtonSize.ExtraSmall"
                              Icon="more_vert"
                              Variant="Variant.Text"
                              Click="@(args=>ShowContextMenuWithContent(args,g.Id))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>


@code {
    void ShowContextMenuWithContent(MouseEventArgs args, string? id)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Icon="info"
                    Click="@(()=>GetGuarantorDetails(id))"
                    Text="Guarantor Details" Value="@id"></RadzenMenuItem>
    <RadzenMenuItem Icon="edit"
                    Click="@(()=>GetEditGuarantor(id))"
                    Text="Edit" Value="@id"></RadzenMenuItem>
    <RadzenMenuItem Icon="delete"
                    Click="@(()=>DeleteGuarantorAsync(id))"
                    Text="Delete" Value="@id"></RadzenMenuItem>
</RadzenMenu>
    );
    }

    void OnRowSelected(VGuarantor arg) { }
}