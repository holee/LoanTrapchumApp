@using Applications.Features.Guarantor.Dtos
<GridToolbar SearchChanged="SearchTextChanged">
    <LeftChildren>
        @if(ChildContent is not null)
        {
            @ChildContent
        }
    </LeftChildren>
    <RightChildren>
        <div class="rz-text-align-center">
            <RadzenCheckBox TValue="bool"
                            Name="IncludeInActive"
                            Change="@IncludeInactiveCheckedChanged"
                            Value="@includeInactive" />
            <RadzenLabel Text="Include Active Loan" Component="IncludeInActive" />
        </div>
    </RightChildren> 
</GridToolbar>
<RadzenDataGrid Data="guarantors"
                TItem="VGuarantor"
                GridLines="DataGridGridLines.Both"
                Responsive="true"
                Density="Density.Compact"
                ShowPagingSummary="true"
                AllowAlternatingRows="true"
                AllowPaging="true"
                AllowFiltering="true"
                AllowSorting="true"
                AllowColumnPicking="true"
                PagerHorizontalAlign="HorizontalAlign.Right"
                Count="@counts"
                PageSize="pageSize"
                PageSizeOptions="@StorageConstant.PageSizeOptions"
                PageSizeChanged="@ChangedPageSize"
                PagerPosition="PagerPosition.Bottom"
                RowSelect="@OnRowSelected"
                LoadData="@LoadGuarantors"
                CellContextMenu="@ShowCellContextMenu">
    <HeaderTemplate>
    
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Width="4rem"
                              Filterable="false"
                              Sortable="false"
                              Property="id"
                              TextAlign="TextAlign.Center"
                              Pickable="false"
                              Title="#" Context="g">
            <Template>
                @(guarantors.IndexOf(g) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VGuarantor.GuarantorName)"
                              Title="Name"
                              Context="g"
                              Width="10rem"
                              Sortable="true">
            <Template>
                <KhmerName AltName="@g.GuarantorName" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VGuarantor.FullName)"
                              Title="Full Name"
                              Context="g"
                              Visible="false"
                              Sortable="true">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VGuarantor.Phone)"
                              Width="8rem"
                              Title="Phone" />
        <RadzenDataGridColumn Context="g"
                              Property="@nameof(VGuarantor.ProInKhmer)"
                              Filterable="false"
                              Sortable="false"
                              Title="Address">
            <Template>
                <AddressInfo VilInKhmer="@g?.VilInKhmer"
                             ComInKhmer="@g?.ComInKhmer"
                             ProInKhmer="@g?.ProInKhmer"
                             DisInKhmer="@g?.DisInKhmer" />
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                              Context="g"
                              Width="8rem"
                              Visible="false"
                              Property="@nameof(VGuarantor.NumberOfLoan)"
                              Title="Loans">
            <Template>
                @g.NumberOfLoan
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                              Context="g"
                              Width="10rem"
                              Visible="false"
                              Property="@nameof(VGuarantor.Requests)"
                              Title="Requests">
            <Template>
                @g.Requests
            </Template>
        </RadzenDataGridColumn>
        
        <RadzenDataGridColumn TextAlign="TextAlign.Center"
                              Width="5rem"
                              Context="g"
                              Filterable="false"
                              Sortable="false"
                              Title="Loan Active">
            <Template>
                <RadzenBadge BadgeStyle="@(g.IsActive ? BadgeStyle.Success : BadgeStyle.Light)"
                             Text="@(g.IsActive ? "Active" : "None")"
                             IsPill="true" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="5rem"
                              Filterable="false"
                              Sortable="false"
                              TextAlign="TextAlign.Center"
                              Context="g" Title="Actions">
            <Template>
                <RadzenButton Size="ButtonSize.ExtraSmall"
                              Icon="more_vert"
                              Variant="Variant.Text"
                              Click="@(args=>ShowContextMenuWithContent(args,g.Id))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>


@code {
    void ShowContextMenuWithContent(MouseEventArgs args, string? id)
    {
        ContextMenuService.Open(args, BuildGuarantorMenuItems(), me =>
        {
            ContextMenuService.Close();
            HandleGuarantorAction(me.Value?.ToString(), id);
        });
    }

    void ShowCellContextMenu(DataGridCellMouseEventArgs<VGuarantor> args)
    {
        if (args.Data is null) return;

        ContextMenuService.Open(args, BuildGuarantorMenuItems(), me =>
        {
            ContextMenuService.Close();
            HandleGuarantorAction(me.Value?.ToString(), args.Data.Id);
        });
    }

    List<ContextMenuItem> BuildGuarantorMenuItems() =>
    [
        new ContextMenuItem { Text = "Details", Icon = "info",   Value = "1" },
        new ContextMenuItem { Text = "Edit",    Icon = "edit",   Value = "2" },
        new ContextMenuItem { Text = "Delete",  Icon = "delete", Value = "3" },
    ];

    void HandleGuarantorAction(string? value, string? id)
    {
        switch (value)
        {
            case "1": _ = GetGuarantorDetails(id); break;
            case "2": _ = GetEditGuarantor(id);    break;
            case "3": _ = DeleteGuarantorAsync(id); break;
        }
    }

    void OnRowSelected(VGuarantor arg) { }
}