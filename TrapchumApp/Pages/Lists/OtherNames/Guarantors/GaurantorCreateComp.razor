@using Applications.Constants.Others
@using Applications.Features.AdditionalInformations.Dto
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Domains.Models.Bases
@using TrapchumApp.Services

<style>
    .status-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 2px 10px;
        border-radius: 12px;
    }
    .status-active   { background-color: var(--rz-success-lighter); color: var(--rz-success-dark); }
    .status-inactive { background-color: var(--rz-danger-lighter);  color: var(--rz-danger-dark);  }
</style>

<RadzenFieldset AllowCollapse="false">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
            <RadzenIcon Icon="contacts" Style="color:var(--rz-primary)" />
            <strong>ព័ត៌មានទំនាក់ទំនង</strong>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>

        @* ── ជួរទី១: គោរព / ឈ្មោះខ្មែរ / ឈ្មោះឡាតាំង / ស្ថានភាព ── *@
        <RadzenRow AlignItems="AlignItems.End" class="rz-mb-4">
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenFormField Text="គោរព" AllowFloatingLabel="true" class="rz-w-100">
                    <ChildContent>
                        <RadzenDropDown TValue="string"
                                        Data="@_filteredSalutations"
                                        TextProperty="@nameof(SalutationDto.Title)"
                                        ValueProperty="@nameof(SalutationDto.Title)"
                                        FilterAsYouType="true"
                                        AllowFiltering="true"
                                        class="rz-w-100"
                                        SearchText="@_salutationText"
                                        SearchTextChanged="SalutaionSearchChanged"
                                        Placeholder="លោក/លោកស្រី..."
                                        @bind-Value="Model.Gender" />
                    </ChildContent>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="ឈ្មោះជាភាសាខ្មែរ *" AllowFloatingLabel="true" class="rz-w-100">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="Model.AltName"
                                       class="rz-w-100"
                                       Placeholder="ឈ្មោះជាភាសាខ្មែរ..." />
                    </ChildContent>
                    <Helper>
                        <ValidationMessage For="@(() => Model.AltName)" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="4">
                <RadzenFormField Text="ឈ្មោះជាអក្សរឡាតាំង" AllowFloatingLabel="true" class="rz-w-100">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="Model.Name"
                                       class="rz-w-100"
                                       Change="SetFirstName"
                                       Placeholder="ឈ្មោះពេញជាឡាតាំង..." />
                    </ChildContent>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="2">
                <RadzenStack Gap="0.4rem">
                    <RadzenLabel Text="ស្ថានភាព" Style="font-size:0.8rem;font-weight:600;color:var(--rz-text-secondary-color)" />
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenCheckBox TValue="bool?" @bind-Value="Model.IsActive" Name="IsActive" />
                        <span class="status-badge @(Model.IsActive == true ? "status-active" : "status-inactive")">
                            <RadzenIcon Icon="@(Model.IsActive == true ? "check_circle" : "cancel")"
                                        Style="font-size:0.72rem;vertical-align:middle" />
                            @(Model.IsActive == true ? "សកម្ម" : "អសកម្ម")
                        </span>
                    </RadzenStack>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        @* ── ជួរទី២: នាមខ្លួន / នាមកណ្តាល / នាមត្រកូល / មុខរបរ ── *@
        <RadzenRow AlignItems="AlignItems.End" class="rz-mb-4">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="នាមខ្លួនជាឡាតាំង *" AllowFloatingLabel="true" class="rz-w-100">
                    <ChildContent>
                        <RadzenTextBox Placeholder="នាមខ្លួនជាឡាតាំង..."
                                       class="rz-w-100"
                                       AutoCompleteType="AutoCompleteType.Off"
                                       @bind-Value="Model.FirstName" />
                    </ChildContent>
                    <Helper>
                        <ValidationMessage For="@(() => Model.FirstName)" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="នាមកណ្តាលជាឡាតាំង" AllowFloatingLabel="true" class="rz-w-100">
                    <ChildContent>
                        <RadzenTextBox class="rz-w-100"
                                       Placeholder="នាមកណ្តាលជាឡាតាំង..."
                                       AutoCompleteType="AutoCompleteType.Off"
                                       @bind-Value="Model.MiddleName" />
                    </ChildContent>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="នាមត្រកូលជាឡាតាំង" AllowFloatingLabel="true" class="rz-w-100">
                    <ChildContent>
                        <RadzenTextBox class="rz-w-100"
                                       Placeholder="នាមត្រកូលជាឡាតាំង..."
                                       AutoCompleteType="AutoCompleteType.Off"
                                       @bind-Value="Model.LastName" />
                    </ChildContent>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="មុខរបរ" AllowFloatingLabel="true" class="rz-w-100">
                    <ChildContent>
                        <RadzenAutoComplete Data="@_occuptions"
                                           TextProperty="@nameof(OccupationDto.OccupationTitle)"
                                           class="rz-w-100"
                                           OpenOnFocus="true"
                                           FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                           FilterOperator="StringFilterOperator.Contains"
                                           Placeholder="មុខរបរ..."
                                           @bind-Value="Model.Occupation" />
                    </ChildContent>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        @* ── ជួរទី៣: លេខទូរស័ព្ទ / អត្តសញ្ញាណប័ណ្ណ / លេខទូរស័ព្ទបន្ថែម / អ៊ីម៉ែល ── *@
        <RadzenRow AlignItems="AlignItems.End" class="rz-mb-4">
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="លេខទូរស័ព្ទ" AllowFloatingLabel="true" class="rz-w-100">
                    <Start>
                        <RadzenIcon Icon="phone" Style="color:var(--rz-success)" />
                    </Start>
                    <ChildContent>
                        <RadzenTextBox Placeholder="០១២ ៣៤៥ ៦៧៨"
                                       class="rz-w-100"
                                       AutoCompleteType="AutoCompleteType.Off"
                                       @bind-Value="Model.Phone" />
                    </ChildContent>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="អត្តសញ្ញាណប័ណ្ណ" AllowFloatingLabel="true" class="rz-w-100">
                    <Start>
                        <RadzenIcon Icon="badge" Style="color:var(--rz-warning)" />
                    </Start>
                    <ChildContent>
                        <RadzenTextBox Placeholder="លេខអត្តសញ្ញាណប័ណ្ណ..."
                                       class="rz-w-100"
                                       AutoCompleteType="AutoCompleteType.Off"
                                       @bind-Value="Model.IdCard" />
                    </ChildContent>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="លេខទូរស័ព្ទបន្ថែម" AllowFloatingLabel="true" class="rz-w-100">
                    <Start>
                        <RadzenIcon Icon="phone_forwarded" Style="color:var(--rz-info)" />
                    </Start>
                    <ChildContent>
                        <RadzenTextBox Placeholder="លេខបន្ថែម..."
                                       class="rz-w-100"
                                       AutoCompleteType="AutoCompleteType.Off"
                                       @bind-Value="Model.AltPhone" />
                    </ChildContent>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <RadzenFormField Text="អ៊ីម៉ែល" AllowFloatingLabel="true" class="rz-w-100">
                    <Start>
                        <RadzenIcon Icon="email" Style="color:var(--rz-warning)" />
                    </Start>
                    <ChildContent>
                        <RadzenTextBox Placeholder="email@example.com"
                                       class="rz-w-100"
                                       AutoCompleteType="AutoCompleteType.Off"
                                       @bind-Value="Model.EmailAddress" />
                    </ChildContent>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        @* ── ជួរទី៤: កំណត់សម្គាល់ ── *@
        <RadzenRow>
            <RadzenColumn Size="12">
                <RadzenFormField Text="កំណត់សម្គាល់" AllowFloatingLabel="true" class="rz-w-100">
                    <ChildContent>
                        <RadzenTextArea class="rz-w-100"
                                        Rows="3"
                                        Placeholder="កំណត់សម្គាល់បន្ថែម..."
                                        Style="resize:none"
                                        @bind-Value="Model.Description" />
                    </ChildContent>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

    </ChildContent>
</RadzenFieldset>
<AddressCreate model="Model" />

@code{
    
    private string _salutationText = string.Empty;

    private IEnumerable<SalutationDto> _filteredSalutations = [];


    void SalutaionSearchChanged(string? args)
    {
        _salutationText = args ?? string.Empty;

        if (string.IsNullOrEmpty(args))
        {
            _filteredSalutations = _salutations;

            StateHasChanged();

            return;
        }

        var matches = _salutations
                        .Where(x => x.Title!.Contains(args, StringComparison.OrdinalIgnoreCase))
                        .ToList();

        if (matches.Count == 0)
        {
            // Show the typed text as a selectable option
            _filteredSalutations = new List<SalutationDto>
            {
                new SalutationDto 
                {
                      Id = -1, // Use a special ID to indicate it's a new entry
                      Title = args,
                }
            };
            Model.Gender = args;
        }
        else
        {
            _filteredSalutations = matches;
        }

        StateHasChanged();
    }
}