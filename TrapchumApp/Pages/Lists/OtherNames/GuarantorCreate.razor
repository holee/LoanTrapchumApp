@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Domains.Models.Bases
@using TrapchumApp.Services
<PageTitle>Create New Guarantor</PageTitle>
<EditForm Model="@model" OnValidSubmit="OnSaveChanges">
    <FluentValidationValidator DisableAssemblyScanning="false" />
    <GaurantorCreateComp Model="model" />
    <AddressCreate model="model" />
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 Gap="1rem"
                 JustifyContent="JustifyContent.End">
        <RadzenButton ButtonStyle="ButtonStyle.Success"
                      Icon="save"
                      Text="Save"
                      ButtonType="ButtonType.Submit"
                      Size="ButtonSize.Small" />
        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                      Icon="cancel"
                      Text="Close"
                      Click="TabClosing"
                      Size="ButtonSize.Small" />
    </RadzenStack>
</EditForm>

