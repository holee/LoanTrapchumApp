@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Services

<EditForm Model="model" OnValidSubmit="OnSaveChanges">
    <FluentValidationValidator DisableAssemblyScanning="true" />
    <NameCreateInfo model="model" />
    <AddressBaseCreate model="model" />
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 class="rz-mt-2"
                 JustifyContent="JustifyContent.End" Gap="1rem">
        <RadzenButton ButtonStyle="ButtonStyle.Success"
                      Size="ButtonSize.ExtraSmall"
                      Icon="save"
                      ButtonType="ButtonType.Submit"
                      Text="Save & Close" />
        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                      Size="ButtonSize.ExtraSmall"
                      Icon="cancel"
                      Click="@CloseTab"
                      Text="Close" />
    </RadzenStack>
</EditForm>
@code {

    [Parameter]
    public EventCallback<int> SelectIndex { get; set; }

    protected async Task CloseTab()
    {
        await SelectIndex.InvokeAsync(0);
    }

    void SetFirstName()
    {
        model.FirstName = model.Name;
    }
}
