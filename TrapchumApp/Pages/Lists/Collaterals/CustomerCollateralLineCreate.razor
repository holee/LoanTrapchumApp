@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Applications.Responses.Lists.Collaterals
@using TrapchumApp.Services
<EditForm Model="@model" FormName="collateralLineCreate" OnValidSubmit="@HandleFormSubmit">
    <DataAnnotationsValidator />
    <FluentValidationValidator DisableAssemblyScanning="true" />
    <ValidationSummary />
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="6">
            <RadzenFormField Text="Customer" class="rz-w-100">
                <RadzenTextBox class="rz-w-100" Disabled
                               @bind-Value="@model.CustomerName"></RadzenTextBox>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenFormField Text="Document Keeping">
                <RadzenDatePicker class="rz-w-100"
                                  @bind-Value="@model.RegisterDate" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="6">
            <RadzenFormField Text="Remark" class="rz-w-100">
                <RadzenTextBox class="rz-w-100"
                               @bind-Value="@model.Remark"></RadzenTextBox>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenFormField Text="Document Keeping" class="rz-w-100">
                <RadzenTextBox class="rz-w-100"
                               @bind-Value="@model.DocumentKeeping"></RadzenTextBox>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="6">
            <RadzenFormField Text="Type" class="rz-w-100">
                <RadzenDropDown TValue="int?"
                                class="rz-w-100"
                                Data="collateralTypes"
                                TextProperty="@nameof(CollateralTypeResponse.CollateralTypeCode)"
                                ValueProperty="@nameof(CollateralTypeResponse.CollateralTypeId)"
                                SelectedItemChanged="@GetCollateralSubTypes"
                                @bind-Value="@collateralLineDto.CategoryRefId">
                </RadzenDropDown>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenFormField Text="SubTypeName" class="rz-w-100">
                <RadzenDropDown TValue="int?"
                                class="rz-w-100"
                                Data="@allSubTypes"
                                TextProperty="@nameof(CollateralSubTypeResponse.CollateralSubTypeName)"
                                ValueProperty="@nameof(CollateralSubTypeResponse.Id)"
                                @bind-Value="@collateralLineDto.SubCategoryRefId">
                </RadzenDropDown>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="6">
            <RadzenFormField Text="Owner Name" class="rz-w-100">
                <RadzenTextBox class="rz-w-100"
                               @bind-Value="@collateralLineDto.OwnerName"></RadzenTextBox>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenFormField Text="CollateralNo" class="rz-w-100">
                <RadzenTextBox class="rz-w-100"
                               @bind-Value="@collateralLineDto.CollateralNo"></RadzenTextBox>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="6">
            <RadzenFormField Text="Location" class="rz-w-100">
                <RadzenTextBox class="rz-w-100"
                               @bind-Value="@collateralLineDto.Location"></RadzenTextBox>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenFormField Text="Size" class="rz-w-100">
                <RadzenTextBox class="rz-w-100"
                               @bind-Value="@collateralLineDto.Size"></RadzenTextBox>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="6">
            <RadzenFormField Text="Quantity" class="rz-w-100">
                <RadzenNumeric ShowUpDown="false"
                               Min="0"
                               Placeholder="Quantity"
                               class="rz-w-100"
                               TextAlign="TextAlign.End"
                               @bind-Value="@collateralLineDto.Quantity" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenFormField Text="Market Price" class="rz-w-100">
                <RadzenNumeric ShowUpDown="false"
                               Min="0"
                               Placeholder="Market Price"
                               class="rz-w-100"
                               TextAlign="TextAlign.End"
                               @bind-Value="@collateralLineDto.MarketPrice" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="6">
            <RadzenFormField Text="Hot Price" class="rz-w-100">
                <RadzenNumeric ShowUpDown="false"
                               Min="0"
                               Placeholder="Hot Price"
                               class="rz-w-100"
                               TextAlign="TextAlign.End"
                               @bind-Value="@collateralLineDto.HotPrice" />
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenFormField Text="Pawn Price" class="rz-w-100">
                <RadzenNumeric ShowUpDown="false"
                               Min="0"
                               class="rz-w-100"
                               Placeholder="Pawn Price"
                               @bind-Value="@collateralLineDto.PawnPrice"
                               TextAlign="TextAlign.End" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 class="rz-mt-3"
                 JustifyContent="JustifyContent.End">
        <RadzenButton Icon="@IconNames.Save"
                      ButtonStyle="ButtonStyle.Success"
                      ButtonType="ButtonType.Submit"
                      Text="Save"
                      Size="ButtonSize.ExtraSmall">
        </RadzenButton>
        <RadzenButton Icon="@IconNames.Close"
                      ButtonStyle="ButtonStyle.Danger"
                      Text="Close"
                      Click="()=>DialogService.Close(success)"
                      Size="ButtonSize.ExtraSmall">
        </RadzenButton>
    </RadzenStack>
</EditForm>