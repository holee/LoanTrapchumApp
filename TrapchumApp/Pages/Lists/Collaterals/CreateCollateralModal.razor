@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Services
<div class="contianer-fluid">
    <EditForm Model="@model" @ref="editForm">
        <input type="hidden" @bind="model!.CollateralId" />
        <RadzenRow>
            <RadzenColumn Size="6">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">
                        <RadzenLabel>
                            Customer Name
                        </RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDropDown @bind-Value="SelectedCustomer"
                                        Data="cusName"
                                        @bind-Value:after="SelectCustomerChanged">

                        </RadzenDropDown>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>

        </RadzenRow>
        <div class="card">
            <div class="card-header">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="6">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="3">
                                <RadzenLabel>Registered Date</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenDatePicker TValue="DateTime?"
                                                  @bind-Value="model.RegisterDate" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow>
                    <RadzenColumn Size="6">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="3">
                                <RadzenLabel>Remarks</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenTextArea Placeholder="Remark..."
                                                @bind-Value="model.Remark" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="3">
                                <RadzenLabel> Document Keeping</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenTextArea Placeholder="Document keeping..."
                                                @bind-Value="model.DocumentKeeping" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                </RadzenRow>
            </div>
        </div>
        <div class="card">
            <div class="card-header">
                DETAILS INFORMATION
            </div>
            <div class="card-body">
                <RadzenTabs>
                    <Tabs>
                        <RadzenTabsItem Text="Property">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th Style="width:15%;">Category</th>
                                        <th Style="width:15%;">Collateral Number</th>
                                        <th>Owner</th>
                                        <th>Size</th>
                                        <th>Qty</th>
                                        <th>Market Price</th>
                                        <th>Hot Priec</th>
                                        <th>PawnPrice</th>
                                        <th class="text-end">
                                            <RadzenButton Icon="add" Size="ButtonSize.ExtraSmall"
                                                          Click="()=>AddNewRow(1)"
                                                            ButtonStyle="ButtonStyle.Success"></RadzenButton>
                                        </th>
                                    </tr>
                                </thead>
                              
                            </table>
                        </RadzenTabsItem>
                        <RadzenTabsItem Text="Personal">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th Style="width:15%;">Category</th>
                                        <th Style="width:15%;">Collateral Number</th>
                                        <th>Owner</th>
                                        <th>Qty</th>
                                        <th>Market Price</th>
                                        <th>Hot Priec</th>
                                        <th>PawnPrice</th>
                                        <th TextAlignment="TextAlignment.End">
                                            <RadzenButton Icon="add" Size="ButtonSize.ExtraSmall"
                                                          Click="()=>AddNewRow(3)"
                                                          ButtonStyle="ButtonStyle.Success"></RadzenButton>
                                        </th>
                                    </tr>
                                </thead>
                              @*   <tbody>
                                    @if (Model.CollateralLines?.Count > 0)
                                    {
                                        var people = Model.CollateralLines
                                        .Where(x => x.TypeName == "Personal")
                                        .ToList();
                                        @for (int x = 0; x < people?.Count; x++)
                                        {
                                            var row = x;
                                            var currentrow = x + 1;
                                            <tr>
                                                <td>
                                                    @currentrow
                                                    <input type="hidden" @bind="people[row]!.Id" />
                                                    <input type="hidden" @bind="people[row]!.CollateralRefId" />
                                                </td>
                                                <td style="width:15%;">
                                                    <RadzenDropDown TValue="int?"
                                                                    Data="collateralPersonals"
                                                                    TextProperty="CollateralSubTypeName"
                                                                    ValueProperty="Id"
