                                                                    @bind-Value="people[row].SubCategoryRefId">
                                                    </RadzenDropDown>
                                                </td>
                                                <td style="width:15%;">
                                                    <RadzenTextBox @bind-Value="people[row].CollateralNo"></RadzenTextBox>
                                                </td>
                                                <td>
                                                    <RadzenTextBox Placeholder="Owner" @bind-Value="people[row].OwnerName"></RadzenTextBox>
                                                </td>
                                                <td>
                                                    <RadzenNumeric ShowUpDown="false"
                                                                   Placeholder="Qty" @bind-Value="people[row].Quantity" />
                                                </td>
                                                <td>
                                                    <RadzenNumeric ShowUpDown="false"
                                                                   @bind-Value="people[row].MarketPrice" TextAlign="TextAlign.End" />
                                                </td>
                                                <td>
                                                    <RadzenNumeric @bind-Value="people[row].HotPrice" TextAlign="TextAlign.End" />
                                                </td>
                                                <td>
                                                    <RadzenNumeric ShowUpDown="false"
                                                                   @bind-Value="people[row].PawnPrice" TextAlign="TextAlign.End" />
                                                </td>
                                                <td class="text-end">
                                                    <RadzenButton Click="@(()=>Remove(people[row]))"
