@using Applications.Features.Collaterals.Dtos
@using TrapchumApp.Components.Buttons
@attribute [Authorize]
<PageTitle>Collaterals</PageTitle>
<RadzenProgressBar Value="100" Visible="IsProgress" ProgressBarStyle="ProgressBarStyle.Info" Style="height:1px" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
<RadzenTabs @ref="tabs" RenderMode="TabRenderMode.Client" SelectedIndex="@selectedIndex" SelectedIndexChanged="IndexChanged">
    <Tabs>
        <RadzenTabsItem Text="Collaterals" Icon="reorder">
            <GridToolbar SearchChanged="OnSearch">
                <LeftChildren>
                    <AddButton OnClick="@CreateCollateralTab" Text="Add Collateral" Icon="@IconNames.Add" />
                </LeftChildren>
            </GridToolbar>
            <RadzenDataGrid Responsive
                            GridLines="DataGridGridLines.Horizontal"
                            Density="Density.Compact"
                            PageSize="@pageSize"
                            Count="@counts"
                            AllowAlternatingRows="true"
                            AllowSorting="true"
                            AllowPaging="true"
                            ShowPagingSummary="true"
                            PagerPosition="PagerPosition.Bottom"
                            PageSizeOptions="@StorageConstant.PageSizeOptions"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            PageSizeChanged="@PageSizeChanged"
                            TItem="VCollateral"
                            CellContextMenu="@ShowContextMenu"
                            Data="@Collaterals">
                <Columns>
                    <RadzenDataGridColumn Width="5rem" TextAlign="TextAlign.Center" Title="#" Property="CustomerId" Context="c">
                        <Template>
                            @(Collaterals.IndexOf(c) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="CustomerName" Title="Customer" />
                    <RadzenDataGridColumn Property="RegisterDate" Title="Date" Context="c">
                        <Template>
                            @c.RegisterDate.DayFirst()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="Remark" Title="Remark" />
                    <RadzenDataGridColumn Width="6rem" TextAlign="TextAlign.Center" Property="CustomerId" Title="Action" Context="c">
                        <Template>
                            <RadzenButton Size="ButtonSize.ExtraSmall"
                                          Icon="more_vert"
                                          Variant="Variant.Text"
                                          Click="@((args)=>ShowContextMenuWithContent(args, c))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenTabsItem>
        @foreach (var tab in _tabs)
        {
            <RadzenTabsItem Icon="@tab.Icon" Text="@tab.Title" @key="@tab.Key">
                <Template>
                    <ClosedTab Title="@tab.Title"
                               TabId="@tab.Key"
                               Closed="(() => CloseTab(tab.Key))" />
                </Template>
                <ChildContent>
                    @tab.Content
                </ChildContent>
            </RadzenTabsItem>
        }
    </Tabs>
</RadzenTabs>
@code {
    void ShowContextMenuWithContent(MouseEventArgs args, VCollateral c)
    {
        ContextMenuService.Open(args, new List<ContextMenuItem>
        {
            new ContextMenuItem { Text = "Details", Icon = "info", Value = "1" },
            new ContextMenuItem { Text = "Add Collateral", Icon = "add", Value = "2" },
            new ContextMenuItem { Text = "Delete", Icon = "delete", Value = "3" }
        }, (e) =>
        {
            ContextMenuService.Close();
            HandleMenuAction(e, c.CustomerId);
        });
    }

    void ShowContextMenu(DataGridCellMouseEventArgs<VCollateral> args)
    {
        if (args.Data is null) return;

        ContextMenuService.Open(args, new List<ContextMenuItem>
        {
            new ContextMenuItem { Text = "Details", Icon = "info", Value = "1" },
            new ContextMenuItem { Text = "Add Collateral", Icon = "add", Value = "2" },
            new ContextMenuItem { Text = "Delete", Icon = "delete", Value = "3" }
        }, (e) =>
        {
            ContextMenuService.Close();

            HandleMenuAction(e, args.Data.CustomerId);
        });
    }

    void HandleMenuAction(MenuItemEventArgs e, string? customerId)
    {
        if (int.TryParse(e.Value?.ToString(), out int value))
        {
            if (value == 1)
            {
                AddDetailsTab(customerId);

                return;
            }
            if (value == 2)
            {
                CreateCollateralTabForCustomer(customerId);

                return;
            }
            if (value == 3)
            {
                Delete(customerId);

                return;
            }
        }
    }
}