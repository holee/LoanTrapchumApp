@page "/app/customer/collateral"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Microsoft.AspNetCore.Components.Web
@using TrapchumApp.Services
@attribute [Authorize]
<PageTitle>Collateral</PageTitle>
<RadzenProgressBar Value="100" Visible="IsProgress" ProgressBarStyle="ProgressBarStyle.Info" Style="height:1px" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
<RadzenTabs @ref="tabs" RenderMode="TabRenderMode.Server" Change="IndexChanged" @bind-SelectedIndex="selectedIndex">
    <Tabs>
        <RadzenTabsItem Text="Collaterals" Icon="reorder">
            <GridToolbar SearchChanged="OnSearch">

            </GridToolbar>
            <RadzenDataGrid Responsive
                            GridLines="DataGridGridLines.Horizontal"
                            Density="Density.Compact"
                            PageSize="@pageSize"
                            Count="@counts"
                            AllowAlternatingRows="true"
                            AllowSorting="true"
                            AllowPaging="true"
                            ShowPagingSummary="true"
                            PagerPosition="PagerPosition.Bottom"
                            PageSizeOptions="@StorageConstant.PageSizeOptions"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            PageSizeChanged="@PageSizeChanged"
                            Data="@Collaterals">
                <Columns>
                    <RadzenDataGridColumn Width="5rem" TextAlign="TextAlign.Center" Title="#" Property="CustomerId" Context="c">
                        <Template>
                            @(Collaterals.IndexOf(c) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="CustomerName" Title="Customer" />
                    <RadzenDataGridColumn Property="RegisterDate" Title="Date" Context="c">
                        <Template>
                            @c.RegisterDate.DayFirst()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="Remark" Title="Remark" />
                    <RadzenDataGridColumn Width="5rem" TextAlign="TextAlign.Center" Property="CustomerId" Title="Action" Context="c">
                        <Template>
                            <RadzenButton Size="ButtonSize.ExtraSmall"
                                          Icon="more_vert"
                                          Variant="Variant.Text"
                                          Click="@((args)=>ShowContextMenuWithContent(args,c.CustomerId))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Details" Visible="IsShowDetails" Icon="info">
            <CollateralDetail CustomerId="@CustomerId" Close="CloseDetail" />
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
@code {
    void ShowContextMenuWithContent(MouseEventArgs args, string? id)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Click="@(() => AddDetailsTab(id))" Icon="info" Text="Details" Value="@id"></RadzenMenuItem>
    <RadzenMenuItem Click="@(() => Delete(id))" Icon="delete" Text="Delete" Value="@id"></RadzenMenuItem>
</RadzenMenu>
    );
    }


}