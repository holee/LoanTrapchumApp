@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Applications.Responses.Lists.Collaterals
@using TrapchumApp.Services
<EditForm Model="@model" FormName="collateralLineEdt" OnValidSubmit="@HandleFormSubmit">
    <DataAnnotationsValidator />
    <FluentValidationValidator DisableAssemblyScanning="true" />
    <input type="hidden" @bind="@model.Id" />
    <input type="hidden" @bind="model.CollateralRefId" />
    <input type="hidden" @bind="model.SubCategoryRefId" />
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="3">
            <RadzenLabel>Customer</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenTextBox class="rz-w-100" Disabled
                           @bind-Value="@model.SubTypeName"></RadzenTextBox>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="3">
            <RadzenLabel>ReferenceNo</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenTextBox class="rz-w-100" Disabled
                           @bind-Value="@model.ReferenceNo"></RadzenTextBox>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="3">
            <RadzenLabel>CollateralNo</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenTextBox class="rz-w-100"
                           @bind-Value="@model.CollateralNo"></RadzenTextBox>
            <ValidationMessage For="() => model.CollateralNo" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="3">
            <RadzenLabel>Type</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenDropDown TValue="int?"
                            class="rz-w-100"
                            Data="collateralTypes"
                            TextProperty="@nameof(CollateralTypeResponse.CollateralTypeCode)"
                            ValueProperty="@nameof(CollateralTypeResponse.CollateralTypeId)"
                            SelectedItemChanged="@GetCollateralSubTypes"
                            @bind-Value="@model.CategoryRefId">
            </RadzenDropDown>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="3">
            <RadzenLabel>SubType Name</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenDropDown TValue="int?"
                            class="rz-w-100"
                            Data="@allSubTypes"
                            TextProperty="@nameof(CollateralSubTypeResponse.CollateralSubTypeName)"
                            ValueProperty="@nameof(CollateralSubTypeResponse.Id)"
                            @bind-Value="@model.SubCategoryRefId">
            </RadzenDropDown>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="3">
            <RadzenLabel>Owner Name</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenTextBox class="rz-w-100"
                           @bind-Value="@model.OwnerName"></RadzenTextBox>
            <ValidationMessage For="() => model.OwnerName" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="3">
            <RadzenLabel>Location</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenTextBox class="rz-w-100"
                           @bind-Value="@model.Location"></RadzenTextBox>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="3">
            <RadzenLabel>Size</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenTextBox class="rz-w-100"
                           @bind-Value="@model.Size"></RadzenTextBox>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="3">
            <RadzenLabel>Quantity</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenNumeric ShowUpDown="false"
                           Min="0"
                           Placeholder="Quantity"
                           class="rz-w-100"
                           TextAlign="TextAlign.End"
                           @bind-Value="@model.Quantity" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="3">
            <RadzenLabel>Market Price</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenNumeric ShowUpDown="false"
                           Min="0"
                           Placeholder="Market Price"
                           class="rz-w-100"
                           TextAlign="TextAlign.End"
                           @bind-Value="@model.MarketPrice" />
            <ValidationMessage For="() => model.MarketPrice" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="3">
            <RadzenLabel>Hot Price</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenNumeric ShowUpDown="false"
                           Min="0"
                           Placeholder="Hot Price"
                           class="rz-w-100"
                           TextAlign="TextAlign.End"
                           @bind-Value="@model.HotPrice" />
            <ValidationMessage For="() => model.HotPrice" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mb-2">
        <RadzenColumn Size="3">
            <RadzenLabel>Pawn Price</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenNumeric ShowUpDown="false"
                           Min="0"
                           class="rz-w-100"
                           Placeholder="Pawn Price"
                           @bind-Value="@model.PawnPrice"
                           TextAlign="TextAlign.End" />
            <ValidationMessage For="() => model.PawnPrice" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 class="rz-mt-3"
                 JustifyContent="JustifyContent.End">
        <RadzenButton Icon="@IconNames.Save"
                      ButtonStyle="ButtonStyle.Success"
                      ButtonType="ButtonType.Submit"
                      Text="Save"
                      Size="ButtonSize.ExtraSmall">
        </RadzenButton>
        <RadzenButton Icon="@IconNames.Close"
                      ButtonStyle="ButtonStyle.Danger"
                      Text="Close"
                      Click="()=>DialogService.CloseSide(success)"
                      Size="ButtonSize.ExtraSmall">
        </RadzenButton>
    </RadzenStack>

</EditForm>
@code {

}
