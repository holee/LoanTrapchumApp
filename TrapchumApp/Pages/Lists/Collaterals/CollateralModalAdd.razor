@using Applications.Features.Collaterals.Dtos
@using Domains.Models.Collaterals
<EditForm @ref="editForm" EditContext="@editContext">
    <DataAnnotationsValidator />
    <input type="hidden" @bind="model.CollateralId" />
    <RadzenFieldset Text="Summary Information">
        <RadzenRow AlignItems="AlignItems.Center" class="rz-my-2">
            <RadzenColumn Size="6">
                <RadzenFormField Text="Customer Name" class="rz-w-100">
                    <RadzenTextBox @bind-Value="model.CustomerName" disabled class="rz-w-100" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="Registered Date" class="rz-w-100">
                    <RadzenDatePicker Type="InputDateType.Date"
                                      @bind-Value="model.RegisterDate"
                                      @bind-Value:format="dd/MM/yyyy"
                                      TValue="DateTime?"
                                      class="rz-w-100" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="Remarks" class="rz-w-100">
                    <RadzenTextBox class="rz-w-100" @bind-Value="model.Remark" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenFormField Text="Document Keeping" class="rz-w-100">
                    <RadzenTextBox class="rz-w-100" @bind-Value="model.DocumentKeeping" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
    </RadzenFieldset>
    <RadzenTabs RenderMode="TabRenderMode.Client">
        <Tabs>
            <RadzenTabsItem Text="Property">
                <RadzenDataGrid Density="Density.Compact"
                                TItem="VCollateralLines"
                                Responsive
                                ColumnWidth="15rem"
                                EditMode="DataGridEditMode.Single"
                                @ref="@propertiesGrid"
                                RowUpdate="@((arg)=>OnRowUpdate(arg,CollateralTypeEnum.Property))"
                                RowCreate="@((arg)=>OnRowCreate(arg,CollateralTypeEnum.Property))"
                                Data="@_properties">
                    <HeaderTemplate>
                        <RadzenButton Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="()=>InsertNewRow(CollateralTypeEnum.Property)"
                                      Icon="add_circle"
                                      Text="Add" />
                    </HeaderTemplate>
                    <Columns>
                        <RadzenDataGridColumn Property="Id" Title="#" Width="2rem">
                            <Template Context="c">
                                <input type="hidden" @bind="c.Id" />
                                <input type="hidden" @bind="c.CollateralId" />
                                <input type="hidden" @bind="c.CategoryRefId" />
                                @(_properties.IndexOf(c) + 1)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="@nameof(CollateralSubTypeDto.CollateralSubTypeName)"
                                              Title="Category"
                                              Context="c">
                            <Template>
                                @{
                                    c.CollateralSubTypeName = CollateralProperties.FirstOrDefault(x => x.Id == c.SubCategoryRefId)?.CollateralSubTypeName;
                                }
                                @c.CollateralSubTypeName
                                <input type="hidden" @bind="@c.CollateralSubTypeName" />
                                <input type="hidden" @bind="@c.SubCategoryRefId" />
                            </Template>
                            <EditTemplate>
                                <RadzenDropDown TValue="int?"
                                                class="rz-w-100"
                                                Data="@CollateralProperties"
                                                TextProperty="@nameof(CollateralSubTypeDto.CollateralSubTypeName)"
                                                ValueProperty="@nameof(CollateralSubTypeDto.Id)"
                                                Style="height:2rem;line-height:1rem;"
                                                SelectedItemChanged="@((arg)=>PropSelectedItemChanged(arg,c))"
                                                InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select Sub Collateral" }})"
                                                @bind-Value="c.SubCategoryRefId">
                                </RadzenDropDown>
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Width="8rem"
                                              Property="CollateralNo"
                                              Context="c"
                                              Title="Collateral No">
                            <Template>
                                @c.CollateralNo
                            </Template>
                            <EditTemplate>
                                <RadzenTextBox class="rz-w-100"
                                               Style="height:2rem;line-height:2rem;"
                                               @bind-Value="c.CollateralNo"></RadzenTextBox>
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="OwnerName" Title="Owner Name" Context="c">
                            <Template>
                                @c.OwnerName
                            </Template>
                            <EditTemplate>
                                <RadzenTextBox class="rz-w-100"
                                               Style="height:2rem;line-height:2rem;"
                                               @bind-Value="c.OwnerName"></RadzenTextBox>
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Width="5rem"
                                              Property="Size"
                                              Context="c"
                                              Title="Size">
                            <Template>
                                @c.Size
                            </Template>
                            <EditTemplate>
                                <RadzenTextBox class="rz-w-100"
                                               Style="height:2rem;line-height:2rem;"
                                               @bind-Value="c.Size" />
                            </EditTemplate>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Width="4rem"
                                              Context="c"
                                              TextAlign="TextAlign.Right"
                                              Property="Quantity" Title="Qty">
                            <Template>
                                @c.Quantity
                            </Template>
                            <EditTemplate>
                                <RadzenNumeric ShowUpDown="false"
                                               Min="0"
                                               Placeholder="Qty"
                                               class="rz-w-100"
                                               TextAlign="TextAlign.End"
                                               @bind-Value="c.Quantity" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Width="6rem"
                                              Property="MarketPrice"
                                              Context="c"
                                              TextAlign="TextAlign.Right"
                                              Title="Market Price">
                            <Template>
                                @c.MarketPrice
                            </Template>
                            <EditTemplate>
                                <TCNumbers @bind-Value="@c.MarketPrice"
                                           OnValueChanged="@((arg)=>OnMarketPriceChanged(arg,c))"
                                           Min="0" />
                            </EditTemplate>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Width="6rem"
                                              Property="PawnPrice"
                                              Context="c"
                                              TextAlign="TextAlign.Right"
                                              Title="Pawn Price">
                            <Template>
                                @c.PawnPrice
                            </Template>
                            <EditTemplate>
                                <TCNumbers @bind-Value="@c.PawnPrice" Min="0" />
                            </EditTemplate>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Width="6rem"
                                              Property="HotPrice"
                                              Context="c"
                                              TextAlign="TextAlign.Right"
                                              Title="Hot Price">
                            <Template>
                                @c.HotPrice
                            </Template>
                            <EditTemplate>
                                <TCNumbers @bind-Value="@c.HotPrice" Min="0" />
                            </EditTemplate>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Width="4rem"
                                              TextAlign="TextAlign.Center"
                                              Context="c"
                                              Property="Id" Title="Actions">
                            <Template>
                                <RadzenButton Click="@(() => EditRow(c, CollateralTypeEnum.Property))"
                                              Icon="edit"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Variant="Variant.Text"
                                              Size="ButtonSize.ExtraSmall">
                                </RadzenButton>
                            </Template>
                            <EditTemplate>
                                <RadzenButton Click="@(() => SaveRow(c, CollateralTypeEnum.Property))"
                                              Icon="@IconNames.Save"
                                              ButtonStyle="ButtonStyle.Success"
                                              Variant="Variant.Text"
                                              Size="ButtonSize.ExtraSmall">
                                </RadzenButton>
                                <RadzenButton Click="@(() => CancelEdit(c, CollateralTypeEnum.Property))"
                                              Icon="@IconNames.Undo"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Variant="Variant.Text"
                                              Size="ButtonSize.ExtraSmall">
                                </RadzenButton>
                                <RadzenButton Click="@(() => DeleteRow(c, CollateralTypeEnum.Property))"
                                              Icon="@IconNames.Delete"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Variant="Variant.Text"
                                              Size="ButtonSize.ExtraSmall">
                                </RadzenButton>
                            </EditTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Personal">
                <RadzenDataGrid Density="Density.Compact"
                                TItem="VCollateralLines"
                                Responsive
                                ColumnWidth="15rem"
                                EditMode="DataGridEditMode.Single"
                                @ref="@personalGrid"
                                RowUpdate="@((arg)=>OnRowUpdate(arg,CollateralTypeEnum.Personal))"
                                RowCreate="@((arg)=>OnRowCreate(arg,CollateralTypeEnum.Personal))"
                                Data="@_personals">
                    <HeaderTemplate>
                        <RadzenButton Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Click="()=>InsertNewRow(CollateralTypeEnum.Personal)"
                                      Icon="add_circle"
                                      Text="Add" />
                    </HeaderTemplate>
                    <Columns>
                        <RadzenDataGridColumn Property="Id" Title="#" Width="2rem">
                            <Template Context="c">
                                <input type="hidden" @bind="c.Id" />
                                <input type="hidden" @bind="c.CollateralId" />
                                <input type="hidden" @bind="c.CategoryRefId" />
                                @(_personals.IndexOf(c) + 1)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="@nameof(CollateralSubTypeDto.CollateralSubTypeName)"
                                              Title="Category"
                                              Context="c">
                            <Template>
                                @{
                                    c.CollateralSubTypeName = CollateralPersonals.FirstOrDefault(x => x.Id == c.SubCategoryRefId)?.CollateralSubTypeName;
                                }
                                @c.CollateralSubTypeName
                            </Template>
                            <EditTemplate>
                                <RadzenDropDown TValue="int?"
                                                class="rz-w-100"
                                                Data="@CollateralPersonals"
                                                TextProperty="@nameof(CollateralSubTypeDto.CollateralSubTypeName)"
                                                ValueProperty="@nameof(CollateralSubTypeDto.Id)"
                                                Style="height:2rem;line-height:1rem;"
                                                SelectedItemChanged="@((arg)=>PropSelectedItemChanged(arg,c))"
                                                InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select Sub Collateral" }})"
                                                @bind-Value="c.SubCategoryRefId">
                                </RadzenDropDown>
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Width="8rem"
                                              Context="c"
                                              Property="CollateralNo" Title="Collateral No">
                            <Template>
                                @c.CollateralNo
                            </Template>
                            <EditTemplate>
                                <RadzenTextBox class="rz-w-100"
                                               Style="height:2rem;line-height:2rem;"
                                               @bind-Value="c.CollateralNo"></RadzenTextBox>
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="OwnerName" Title="Owner Name" Context="c">
                            <Template>
                                @c.OwnerName
                            </Template>
                            <EditTemplate>
                                <RadzenTextBox class="rz-w-100"
                                               Style="height:2rem;line-height:2rem;"
                                               @bind-Value="c.OwnerName"></RadzenTextBox>
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Width="5rem" Property="Size" Title="Size" Context="c">
                            <Template>
                                @c.Size
                            </Template>
                            <EditTemplate>
                                <RadzenTextBox class="rz-w-100"
                                               Disabled
                                               Style="height:2rem;line-height:2rem;"
                                               @bind-Value="c.Size"></RadzenTextBox>
                            </EditTemplate>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Width="4rem"
                                              Context="c"
                                              TextAlign="TextAlign.Right"
                                              Property="Quantity" Title="Qty">
                            <Template>
                                @c.Quantity
                            </Template>
                            <EditTemplate>
                                <RadzenNumeric ShowUpDown="false"
                                               Min="0"
                                               Placeholder="Qty"
                                               class="rz-w-100"
                                               TextAlign="TextAlign.End"
                                               @bind-Value="c.Quantity" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Width="6rem"
                                              Context="c"
                                              TextAlign="TextAlign.Right"
                                              Property="MarketPrice" Title="Market Price">
                            <Template>
                                @c.MarketPrice
                            </Template>
                            <EditTemplate>
                                <TCNumbers @bind-Value="c.MarketPrice" OnValueChanged="@((arg) => OnMarketPriceChanged(arg, c))" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Width="6rem"
                                              TextAlign="TextAlign.Right"
                                              Property="PawnPrice" Title="Pawn Price" Context="c">
                            <Template>
                                @c.PawnPrice
                            </Template>
                            <EditTemplate>
                                <TCNumbers @bind-Value="c.PawnPrice" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Width="6rem" Property="HotPrice"
                                              TextAlign="TextAlign.Right"
                                              Title="Hot Price" Context="c">
                            <Template>
                                @c.HotPrice
                            </Template>
                            <EditTemplate>
                                <TCNumbers @bind-Value="c.HotPrice" />
                            </EditTemplate>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Width="4rem"
                                              TextAlign="TextAlign.Center"
                                              Context="c"
                                              Property="Id" Title="Actions">
                            <Template>
                                <RadzenButton Click="@(() => EditRow(c, CollateralTypeEnum.Personal))"
                                              Icon="@IconNames.EditPen"
                                              Variant="Variant.Text"
                                              @onclick:stopPropagation="true"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Size="ButtonSize.ExtraSmall">
                                </RadzenButton>
                            </Template>
                            <EditTemplate>
                                <RadzenButton Click="@(() => SaveRow(c, CollateralTypeEnum.Personal))"
                                              Icon="@IconNames.Save"
                                              Variant="Variant.Text"
                                              ButtonStyle="ButtonStyle.Success"
                                              Size="ButtonSize.ExtraSmall">
                                </RadzenButton>
                                <RadzenButton Click="@(() => CancelEdit(c, CollateralTypeEnum.Personal))"
                                              Icon="@IconNames.Undo"
                                              Variant="Variant.Text"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.ExtraSmall">
                                </RadzenButton>
                                <RadzenButton Click="@(() => DeleteRow(c, CollateralTypeEnum.Personal))"
                                              Icon="@IconNames.Delete"
                                              Variant="Variant.Text"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Size="ButtonSize.ExtraSmall">
                                </RadzenButton>
                            </EditTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 class="rz-mt-2"
                 Style="position:absolute;bottom:0.75rem;right:1rem;"
                 JustifyContent="JustifyContent.End">
        <RadzenButton Text="Save"
                      Icon="save"
                      ButtonStyle="ButtonStyle.Success"
                      Size="ButtonSize.Small"
                      Visible="false"
                      Click="@FormValidate" />
        <RadzenButton Text="Close"
                      Icon="close"
                      ButtonStyle="ButtonStyle.Danger"
                      Size="ButtonSize.Small"
                      Click="@CloseDialogue" />
    </RadzenStack>
</EditForm>