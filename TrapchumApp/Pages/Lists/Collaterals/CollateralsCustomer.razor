@using Applications.Bases
@using Applications.Commons.Messages.Collaterals
@using Applications.Features.Collaterals.Commands.DeleteCOmmand
@using Applications.Features.Collaterals.Dtos
@using Applications.Features.LoanRequests.Interfaces
@using Domains.Models.Collaterals
<RadzenFieldset>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
            <RadzenIcon Icon="house" /><b>Collateral Information</b>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                     class="rz-mb-2"
                     Visible="@ShowCommand"
                     JustifyContent="JustifyContent.End">
            <RadzenButton Size="ButtonSize.Small"
                          Click="@AddOne"
                          Icon="add"
                          Text="Add New"
                          Visible="@(ShowAdd && ShowCommand)"
                          ButtonStyle="ButtonStyle.Secondary"></RadzenButton>
            <RadzenButton Size="ButtonSize.Small"
                          Click="@Add"
                          Icon="add"
                          Text="Add New"
                          Visible="@(ShowAdd && ShowCommand)"
                          ButtonStyle="ButtonStyle.Primary"></RadzenButton>
        </RadzenStack>
        <RadzenDataGrid GridLines="DataGridGridLines.Both"
                        Responsive
                        @ref="@refGrid"
                        TItem="VCollateralLines"
                        Density="Density.Compact"
                        RowRender="@OnRowRender"
                        Data="CollateralLines">
            <Columns>
                <RadzenDataGridColumn Title="#" Width="3rem" Property="ReferenceNo" Context="c">
                    <Template>
                        @c.RowIndex
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="ReferenceNo" Property="ReferenceNo" Context="c" />
                <RadzenDataGridColumn Title="Type Name" Property="TypeName" Context="c" />
                <RadzenDataGridColumn Title="Owner Name" Property="OwnerName" Context="c" />
                <RadzenDataGridColumn Title="Location" Property="Location" Context="c" />
                <RadzenDataGridColumn Width="3rem" Title="Qty" Property="Quantity" Sortable="false" />
                <RadzenDataGridColumn Title="Market Price" Context="c" TextAlign="TextAlign.Right">
                    <Template>
                        @c.MarketPrice
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Hot Price" Context="c" TextAlign="TextAlign.Right">
                    <Template>
                        @c.HotPrice
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Pawn Price" Context="c" TextAlign="TextAlign.Right">
                    <Template>
                        @c.PawnPrice
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Size" Property="Size" Sortable="false" />
                <RadzenDataGridColumn Width="3.5rem" Context="c" TextAlign="TextAlign.Center" Title="Status" Sortable="false">
                    <Template>
                        <RadzenCheckBox @bind-Value="c.IsAvailable" Disabled></RadzenCheckBox>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Visible="@ShowAcction" Width="3.5rem" Context="c" TextAlign="TextAlign.Center" Title="Action" Sortable="false">
                    <Template>
                        <RadzenButton Size="ButtonSize.ExtraSmall"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Variant="Variant.Text"
                                      Shade="Shade.Dark"
                                      Click="@((args)=>ShowContextMenuWithContent(args,c))"
                                      Icon="@IconNames.MoreVert" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </ChildContent>
</RadzenFieldset>

@code {

    void ShowContextMenuWithContent(MouseEventArgs args, VCollateralLines c)
    {
        ContextMenuService.Open(args, ds =>
            @<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Click="() => HandleDetails(c)" Icon="@IconNames.Info" Text="Details" Value="@c.Id"></RadzenMenuItem>
    <RadzenMenuItem Click="() => OnCollateralLineEdit(c)" Icon="@IconNames.Edit" Text="Edit Collateral" Value="@c.Id"></RadzenMenuItem>
    <RadzenMenuItem Click="() => HandleDelete(c)" Icon="@IconNames.Delete"
                    Disabled="@c.IsUsed" Text="Delete Collateral" Value="@c.Id"></RadzenMenuItem>
</RadzenMenu>
        );
    }
    private async Task HandleDetails(VCollateralLines c)
    {

        ContextMenuService.Close();
        
        var parameters = new Dictionary<string, object?>
        {
           { "Id",c.Id},
           {"CollateralId",c.CollateralId}
        };

        var options = new SideDialogOptions
        {
            Width = "30rem",
            Position = DialogPosition.Right,
            ShowMask = true,
            CloseDialogOnOverlayClick = true
        };

        DialogService.OpenSide<CollateralLineDetails>("CollateralLine Detail", parameters, options);
    }

    private async Task HandleDelete(VCollateralLines c)
    {
        var parameters = new Dictionary<string, object?>
        {
           { "Id",c.Id},
           {"CollateralId",c.CollateralId}
        };

        var confirmOptions = new ConfirmOptions
        {
            OkButtonText = "Yes, Delete",
            CancelButtonText = "No, Cancel",
            Width = "30rem"
        };

        var confirm = await DialogService.Confirm(CollateralMessages.ConfirmDelete, "Delete Collateral Line", confirmOptions);

        if (confirm == false) return;

        var rsp = await mediator.Send(new DeleteCollateralLineCommand
        {
            Id = c.Id,
            CollateralId = c.CollateralId
        });

        if (rsp.IsError)
        {

        }

        if (rsp.Value.Status == DeleteStatus.InUse)
        {
            var confirmDel = await DialogService.Confirm(CollateralMessages.ConfirmDisable, "Delete Collateral Line", confirmOptions);


            if (confirmDel == false) return;

        }

    }


    void OnRowRender(RowRenderEventArgs<VCollateralLines> args)
    {
        args.Data.RowIndex = args.Index + 1; // store 1-based index
    }
}