@page "/App/Branches"
@using Applications.Responses.ViewModels.Branches
@using Microsoft.AspNetCore.Components.Web
@using TrapchumApp.Services
<PageTitle>Branches</PageTitle>
<style>
    .rz-grid-table td .rz-cell-data {
        line-height: 1.5rem;
        font-size:0.8rem;
    }
</style>
<RadzenTabs RenderMode="TabRenderMode.Server">
    <Tabs>
        <RadzenTabsItem Text="Branches">
            <GridToolbar SearchChanged="SearchChanged">
                <LeftChildren>
                    <AuthorizeView>
                        <Authorized>
                            <RadzenButton Click="OnCreate"
                                          Text="New Branch"
                                          Icon="add"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Size="ButtonSize.Small" />
                        </Authorized>
                    </AuthorizeView>
                </LeftChildren>
                <RightChildren>
                    <div class="ml-2">
                        <RadzenCheckBox TValue="bool" @bind-Value=@InActive Change="ex => OnIncludeInactive(ex)" Name="InActive" />
                        <RadzenLabel Text="Include InActive" Component="CheckBox1" Style="margin-left:3px; vertical-align: middle;" />
                    </div>
                </RightChildren>
            </GridToolbar>
            <RadzenDataGrid GridLines="DataGridGridLines.Horizontal"
                            Count="@counts"
                            PageSize="@pageSize"
                            AllowPaging="true"
                            ShowPagingSummary="true"
                            Density="Density.Compact"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            AllowSorting="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            LogicalFilterOperator="LogicalFilterOperator.Or"
                            AllowFiltering="true"
                            IsLoading="@isLoading"
                            LoadData="@LoadData"
                            PageSizeOptions="@StorageConstant.PageSizeOptions"
                            PageSizeChanged="PageSizeChanged"
                            Data="@Branches">
                <Columns>
                    <RadzenDataGridColumn Property="@nameof(VBranchResponse.BranchId)"
                                          Width="5rem" Title="#" Context="h">
                        <Template>
                            @(Branches!.ToList()!.IndexOf(h) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="10rem" Title="Branch Name" Property="@nameof(VBranchResponse.BranchName)" />
                    <RadzenDataGridColumn Title="Description"
                                          Sortable="false"
                                          Filterable="false"
                                          Property="@nameof(VBranchResponse.Description)" />
                    <RadzenDataGridColumn Title="Address" Context="b">
                        <Template>
                            @b.ToString()
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="5rem" Title="Status"
                                          Filterable="false"
                                          Property="@nameof(VBranchResponse.IsActive)"
                                          Sortable="false" Context="c">
                        <Template>
                            <RadzenCheckBox TValue="bool?"
                                            @bind-Value="@c.IsActive"
                                            Change="@((arg) => OnCheckChanged(c.BranchId,arg!.Value))" />
                        </Template>
                    </RadzenDataGridColumn>
                    <AuthorizeView>
                        <Authorized>
                            <RadzenDataGridColumn Width="5rem" Title="Actions"
                                                  Filterable="false"
                                                  Sortable="false" Context="c">
                                <Template>
                                    <RadzenButton Size="ButtonSize.ExtraSmall"
                                                  Icon="more_vert"
                                                  Variant="Variant.Text"
                                                  Click="@((args)=>ShowContextMenuWithContent(args,c))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Authorized>
                    </AuthorizeView>
                </Columns>
            </RadzenDataGrid>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
@code {
    void ShowContextMenuWithContent(MouseEventArgs args, VBranchResponse e)
    {
        ContextMenuService.Open(args, ds =>
        @<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Click="@(() => OnDetail(e))" Icon="info" Text="Details" Value="@e" />
    <RadzenMenuItem Click="@(() => OnEdit(e))" Icon="edit" Text="Edit" Value="@e" />
    <RadzenMenuItem Click="@(() => OnDelete(e))" Icon="delete" Text="Delete" Value="@e" />
</RadzenMenu>
        );
    }
}
