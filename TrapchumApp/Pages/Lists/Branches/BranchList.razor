@page "/App/Branches"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Branches.Dtos
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Microsoft.AspNetCore.Components.Web
@using TrapchumApp.Services
<PageTitle>Branches</PageTitle>
<style>
    .rz-grid-table td .rz-cell-data {
        line-height: 1.5rem;
        font-size: 0.8rem;
    }
</style>
<RadzenCard class="rz-background-color-base-200" Variant="Variant.Outlined">
    <RadzenTabs RenderMode="TabRenderMode.Server">
        <Tabs>
            <RadzenTabsItem Text="Branches" Icon="account_balance">
                <GridToolbar SearchChanged="SearchChanged">
                    <LeftChildren>
                        <AuthorizeView>
                            <Authorized>
                                <RadzenButton Click="OnCreate"
                                              Text="New Branch"
                                              Icon="add"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Size="ButtonSize.Small" />
                            </Authorized>
                        </AuthorizeView>
                    </LeftChildren>
                    <RightChildren>
                        <div class="ml-2">
                            <RadzenCheckBox TValue="bool" @bind-Value="@InActive" Change="ex => OnIncludeInactive(ex)" Name="InActive" />
                            <RadzenLabel Text="Include InActive" Component="CheckBox1" Style="margin-left:3px; vertical-align: middle;" />
                        </div>
                    </RightChildren>
                </GridToolbar>
                <RadzenDataGrid GridLines="DataGridGridLines.Both"
                                Count="@counts"
                                PageSize="@pageSize"
                                AllowPaging="true"
                                ShowPagingSummary="true"
                                Density="Density.Compact"
                                AllowColumnPicking="true"
                                AllowAlternatingRows="true"
                                AllowRowSelectOnRowClick="true"
                                PagerHorizontalAlign="HorizontalAlign.Right"
                                AllowSorting="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                LogicalFilterOperator="LogicalFilterOperator.Or"
                                AllowFiltering="true"
                                IsLoading="@Tracker.IsLoading"
                                LoadData="@LoadData"
                                PageSizeOptions="@StorageConstant.PageSizeOptions"
                                PageSizeChanged="PageSizeChanged"
                                CellContextMenu="@ShowContextMenu"
                                Data="@Branches"
                                @ref="@_grid"
                                TItem="VBranch">
                    <Columns>
                        <RadzenDataGridColumn Property="@nameof(VBranch.BranchId)"
                                              Width="4rem"
                                              Title="#"
                                              TextAlign="TextAlign.Center"
                                              Pickable="false"
                                              Filterable="false"
                                              Sortable="false"
                                              Context="h">
                            <Template>
                                @(Branches!.ToList()!.IndexOf(h) + 1)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Width="10rem"
                                              Title="Branch Name"
                                              Property="@nameof(VBranch.BranchName)" />
                        <RadzenDataGridColumn Title="Branch Code"
                                              Sortable="false"
                                              Filterable="false"
                                              Property="@nameof(VBranch.Description)" />
                        <RadzenDataGridColumn Title="Address"
                                              Sortable="false"
                                              Filterable="false"
                                              Context="b">
                            <Template>
                                @b.ToString()
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Width="5rem"
                                              Title="Status"
                                              TextAlign="TextAlign.Center"
                                              Filterable="false"
                                              Property="@nameof(VBranch.IsActive)"
                                              Sortable="false"
                                              Context="c">
                            <Template>
                                <RadzenCheckBox TValue="bool?"
                                                Value="@c.IsActive"
                                                Change="@((arg) => OnCheckChanged(c.BranchId, arg!.Value))" />
                            </Template>
                        </RadzenDataGridColumn>
                        <AuthorizeView>
                            <Authorized>
                                <RadzenDataGridColumn Width="5rem"
                                                      Title="Actions"
                                                      Filterable="false"
                                                      Sortable="false"
                                                      Pickable="false"
                                                      TextAlign="TextAlign.Center"
                                                      Context="c">
                                    <Template>
                                        <RadzenButton Size="ButtonSize.ExtraSmall"
                                                      Icon="more_vert"
                                                      Variant="Variant.Text"
                                                      Click="@((args) => ShowContextMenuWithItems(args, c))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Authorized>
                        </AuthorizeView>
                    </Columns>
                    <LoadingTemplate>
                        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                                   ProgressBarStyle="ProgressBarStyle.Danger"
                                                   Value="100" ShowValue="false" />
                    </LoadingTemplate>
                </RadzenDataGrid>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenCard>

@code {
    private RadzenDataGrid<VBranch> _grid = default!;

    void ShowContextMenuWithItems(MouseEventArgs args, VBranch branch)
    {
        ContextMenuService.Open(args, new List<ContextMenuItem>
        {
            new ContextMenuItem { Text = "Details",    Icon = "info",   Value = "1" },
            new ContextMenuItem { Text = "Edit",       Icon = "edit",   Value = "2" },
            new ContextMenuItem { Text = "Delete",     Icon = "delete", Value = "3" },
        }, e =>
        {
            ContextMenuService.Close();
            HandleBranchAction(e.Value?.ToString(), branch);
        });
    }

    void ShowContextMenu(DataGridCellMouseEventArgs<VBranch> args)
    {
        if (args.Data is null) return;

        ContextMenuService.Open(args, new List<ContextMenuItem>
        {
            new ContextMenuItem { Text = "Details",    Icon = "info",   Value = "1" },
            new ContextMenuItem { Text = "Edit",       Icon = "edit",   Value = "2" },
            new ContextMenuItem { Text = "Delete",     Icon = "delete", Value = "3" },
        }, e =>
        {
            ContextMenuService.Close();
            HandleBranchAction(e.Value?.ToString(), args.Data);
        });
    }

    void HandleBranchAction(string? value, VBranch branch)
    {
        switch (value)
        {
            case "1": _ = OnDetail(branch); break;
            case "2": _ = OnEdit(branch);   break;
            case "3": _ = OnDelete(branch); break;
        }
    }
}
