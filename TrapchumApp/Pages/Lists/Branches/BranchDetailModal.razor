@using Applications.Responses.ViewModels.Branches
@using TrapchumApp.Services
<RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
    <RadzenStack>
        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="12" Class="rz-p-2 rz-border-radius-1" Style="border: var(--rz-grid-cell-border)">
                <RadzenText TextStyle="TextStyle.Subtitle1">Branch Info.</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                    <RadzenStack Gap="0" Class="rz-text-truncate">
                        <RadzenText TextStyle="TextStyle.Overline" Class="rz-my-0" Style="color: var(--rz-text-tertiary-color);">Name</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1" Class="rz-text-truncate"><b>@(branch!.BranchName)</b></RadzenText>
                        <RadzenText TextStyle="TextStyle.Overline" Class="rz-my-0" Style="color: var(--rz-text-tertiary-color);">Bank</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Class="rz-text-truncate"><b>@(branch?.BankName)</b></RadzenText>
                        <RadzenText TextStyle="TextStyle.Overline" Class="rz-mt-2 rz-mb-0" Style="color: var(--rz-text-tertiary-color);">Description</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Class="rz-text-truncate"><b>@branch!.Description</b></RadzenText>
                    </RadzenStack>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="12" Class="rz-p-2 rz-border-radius-1" Style="border: var(--rz-grid-cell-border)">
                <RadzenText TextStyle="TextStyle.Subtitle1">Address</RadzenText>
                <RadzenStack Gap="0" Class="rz-text-truncate">
                    <RadzenText TextStyle="TextStyle.Overline" Class="rz-my-0" Style="color: var(--rz-text-tertiary-color);">Address-Khmer</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Class="rz-text-truncate"><b>@branch!.CountryName @branch.City @branch.ProInKhmer @branch.DisInKhmer @branch.ComInKhmer @branch.VilInKhmer</b></RadzenText>
                    <RadzenText TextStyle="TextStyle.Overline" Class="rz-mt-2 rz-my-0" Style="color: var(--rz-text-tertiary-color);">Address-English</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Class="rz-text-truncate"><b>@branch?.ToString()</b></RadzenText>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Icon="cancel"
                      Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Danger"
                      Click="@((args) => DialogService.Close(true))"
                      Variant="Variant.Flat"
                      Text="Close" />
    </RadzenStack>
</RadzenStack>


