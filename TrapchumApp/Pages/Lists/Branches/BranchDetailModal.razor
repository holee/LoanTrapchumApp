<div class="branch-detail-modal-shell">
    @* ── Branch Info ── *@
    <div class="branch-detail-card">
        <div class="branch-detail-header">
            <div class="branch-detail-header-left">
                <div class="branch-detail-icon">
                    <RadzenIcon Icon="corporate_fare" Style="font-size:1.05rem;" />
                </div>

                <div class="branch-detail-heading">
                    <div class="branch-detail-title">Branch Information</div>
                    <div class="branch-detail-subtitle">View branch identity and associated bank details.</div>
                </div>
            </div>
        </div>

        <div class="branch-detail-body">
            <div class="branch-detail-field">
                <div class="branch-detail-label">Branch Name</div>
                <div class="branch-detail-value">@branch?.BranchName</div>
            </div>
            <div class="branch-detail-divider"></div>

            <div class="branch-detail-field">
                <div class="branch-detail-label">Branch Code</div>
                <div class="branch-detail-value">@branch?.Description</div>
            </div>
        </div>
    </div>

    @* ── Address ── *@
    <div class="branch-detail-card">
        <div class="branch-detail-header">
            <div class="branch-detail-header-left">
                <div class="branch-detail-icon" style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.12), rgba(220, 38, 38, 0.2)); color: var(--rz-danger);">
                    <RadzenIcon Icon="location_on" Style="font-size:1.05rem;" />
                </div>

                <div class="branch-detail-heading">
                    <div class="branch-detail-title">Address Information</div>
                    <div class="branch-detail-subtitle">Branch location details in Khmer and English.</div>
                </div>
            </div>
        </div>

        <div class="branch-detail-body">
            <div class="branch-detail-field">
                <div class="branch-detail-label">Address (Khmer)</div>
                <div class="branch-detail-value">
                    @branch?.CountryName @branch?.City @branch?.ProInKhmer @branch?.DisInKhmer @branch?.ComInKhmer @branch?.VilInKhmer
                </div>
            </div>
        </div>
    </div>

    <div class="branch-detail-footer">
        <RadzenButton Click="@(() => DialogService.Close(true))"
                      Text="Close"
                      Icon="close"
                      Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Danger" />
    </div>
</div>


