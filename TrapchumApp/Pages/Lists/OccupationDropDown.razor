@using System.Linq.Expressions
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Applications.Responses.Lists.Entities
@using TrapchumApp.Services
<RadzenDropDownDataGrid Value="@Value"
                        TValue="string"
                        class="w-100"
                        TextProperty="@nameof(OcupationResponse.OccupationTitle)"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        ValueProperty="@nameof(OcupationResponse.OccupationTitle)"
                        ShowAdd="@ShowAdd"
                        Add="@AddOccupation"
                        ShowSearch="false"
                        Density="Density.Compact"
                        @bind-SearchText="@Value"
                        Placeholder="Search Occupation.."
                        ValueChanged="@ValueChanged"
                        AllowClear="@AllowClear"
                        ValueExpression="@ValueExpression"
                        Data="@Occuptions">
    <Columns>
        <RadzenDropDownDataGridColumn Title="Title" Property="@nameof(OcupationResponse.OccupationTitle)" />
    </Columns>
</RadzenDropDownDataGrid>