@page "/App/Operation-Area/Districts"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Applications.Responses.ViewModels.Addresses;
@using TrapchumApp.Helpers.Constants
<PageTitle>Districts</PageTitle>
<RadzenCard>
    <PageDropDown ShowSearchBox="true"
                  PlaceHolder="Search district"
                  OnTextChanged="TextChanged"
                  PageSizeChanged="PageSizeChanged">
        <LeftChildContent>
            <RadzenButton Text="New District"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small"
                          Icon="add"
                          Click="ShowCreate" />
        </LeftChildContent>
        <RightChildContent>
            <RadzenStack Orientation="Orientation.Horizontal">

            </RadzenStack>
        </RightChildContent>
    </PageDropDown>
    <RadzenDataGrid Responsive="true"
                    AllowSorting="true"
                    Count="@counts"
                    PageSize="@pageSize"
                    PagerPosition="PagerPosition.Bottom"
                    ShowPagingSummary="true"
                    AllowPaging="true"
                    AllowFiltering="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    TItem="VDistricts"
                    Density="Density.Compact"
                    LoadData="LoadData"
                    PagerHorizontalAlign="HorizontalAlign.Right"
                    Data="VDistrictList">
        <Columns>
            <RadzenDataGridColumn 
                Width="4rem" 
                Title="#" 
                Sortable="true"
                                  Filterable="false"
                Property="@nameof(VDistricts.DistrictId)" />
            <RadzenDataGridColumn Property="@nameof(VDistricts.DisDescription)"
                                  Title="District-English"
                                  Width="14rem"
                                  Sortable="true"
                                  />
            <RadzenDataGridColumn Property="@nameof(VDistricts.DisInKhmer)"
                                  Title="District-Khmer"
                                  Width="14rem"
                                  Sortable="true"
                                  />
            <RadzenDataGridColumn Property="@nameof(VDistricts.ProDescription)"
                                  Title="Province-Engish"
                                  Sortable="true" />
            <RadzenDataGridColumn Property="@nameof(VDistricts.ProInKhmer)"
                                  Title="Province-Khmer"
                                  Sortable="true" />

            <RadzenDataGridColumn 
                Title="Actions"
                                  Filterable="false"
                                  Sortable="false"
                Context="c" Width="7rem">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall"
                                  Icon="more_vert"
                                  Variant="Variant.Text"
                                  Click="@((args)=>ShowContextMenuWithContent(args,c.DistrictId))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>

    </RadzenDataGrid>
</RadzenCard>

@code {
    void PageSizeChanged(int page)
    {
        pageSize = page;
    }
    void ShowContextMenuWithContent(MouseEventArgs args, int? id)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu>
    <RadzenMenuItem Icon="@IconNames.Add" Click="@(() => AddCommune(id ?? default))" Text="Add Commune" Value="@id"></RadzenMenuItem>
    <RadzenMenuItem Icon="edit" Click="@(() => Edit(id ?? default))" Text="Edit" Value="@id"></RadzenMenuItem>
    <RadzenMenuItem Icon="delete" Click="@(() => Delete (id ?? default))" Text="Delete" Value="@id"></RadzenMenuItem>
</RadzenMenu>
    );
    }
}

