@using Applications.Features.Addresses.Dto
@using Domains.Models.Addresses
<RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
    <RadzenTemplateForm TItem="ProvinceDtoCreate" Data=@Req Submit=@Create>
        <RadzenStack>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenFormField Text="Country" Variant="Variant.Flat" Style="width:100%">
                            <RadzenDropDown Chips="true"
                                            AllowFiltering="true"
                                            Name="DropDownSalutions"
                                            Style="width: 100%;"
                                            Data="Countries"
                                            @bind-Value="Req.CountryId"
                                            TextProperty="@nameof(Country.CountryName)"
                                            ValueProperty="@nameof(Country.CountryId)"
                                            FilterOperator="StringFilterOperator.Contains">
                            </RadzenDropDown>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenFormField Text="Province Code *" Variant="Variant.Flat" Style="width:100%">
                            <RadzenTextBox Name="ProvinceCode" @bind-Value="Req.ProvinceCode" Style="width:100%" />
                            <RadzenRequiredValidator Component="ProvinceCode" Text="Province code is required" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenFormField Text="Province In English" Variant="Variant.Flat" Style="width:100%;margin-top:10px">
                            <RadzenTextBox Name="ProDescription" @bind-Value="Req.ProDescription" Style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenColumn>

            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenFormField Text="Province In Khmer" Variant="Variant.Flat" Style="width:100%;margin-top:10px">
                            <RadzenTextBox Name="ProInKhmer" @bind-Value="Req.ProInKhmer" Style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenColumn>

            </RadzenRow>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" class="rz-mt-2"
                     JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton ButtonType="ButtonType.Submit"
                          Text="Save"
                          Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Primary"
                          Icon="@IconNames.Save"></RadzenButton>
            <RadzenButton Click="@((args) => DialogService!.Close(true))"
                          Variant="Variant.Flat"
                          Size="ButtonSize.Small"
                          Text="Close"
                          Icon="@IconNames.Cancel"
                          ButtonStyle="ButtonStyle.Danger" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenStack>

