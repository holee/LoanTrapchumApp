@page "/App/Operation-Area/Communes"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.ViewModels.Addresses
@using TrapchumApp.Helpers.Constants
<PageTitle>Communes</PageTitle>
<RadzenCard>
    <GridToolbar SearchChanged="TextChanged" Placeholder="Search commune">
        <LeftChildren>
            <RadzenButton Text="New Commune"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small"
                          Icon="add"
                          Click="ShowCreate" />
        </LeftChildren>
    </GridToolbar>
    <RadzenDataGrid Responsive="true"
                    AllowSorting="true"
                    Count="@counts"
                    PageSize="@pageSize"
                    PagerPosition="PagerPosition.Bottom"
                    ShowPagingSummary="true"
                    AllowPaging="true"
                    TItem="VCommunes"
                    AllowFiltering="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    Density="Density.Compact"
                    LoadData="LoadData"
                    PagerHorizontalAlign="HorizontalAlign.Right"
                    PageSizeChanged="PageSizeChanged"
                    PageSizeOptions="@StorageConstant.PageSizeOptions"
                    Data="vCommunelistt">
        <Columns>
            <RadzenDataGridColumn Width="4rem" Title="#" Property="@nameof(VCommunes.CommuneId)" />
            <RadzenDataGridColumn Property="@nameof(VCommunes.ComDescription)"
                                  Title="Commune-English"
                                  Sortable="true" />
            <RadzenDataGridColumn Property="@nameof(VCommunes.ComInKhmer)"
                                  Title="Commune-Khmer"
                                  Sortable="true" />
            <RadzenDataGridColumn Property="@nameof(VCommunes.DisDescription)"
                                  Title="District-English"
                                  Width="14rem"
                                  Sortable="true" />
            <RadzenDataGridColumn Property="@nameof(VCommunes.DisInKhmer)"
                                  Title="District-Khmer"
                                  Width="14rem"
                                  Sortable="true" />


            <RadzenDataGridColumn TextAlign="TextAlign.Center"
                                  Title="Actions" Sortable="false" Filterable="false" Context="c" Width="7rem">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall"
                                  Icon="more_vert"
                                  Variant="Variant.Text"
                                  Click="@((args)=>ShowContextMenuWithContent(args,c.CommuneId))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>

    </RadzenDataGrid>
</RadzenCard>

@code {
    void PageSizeChanged(int page)
    {
        pageSize = page;
        pageIndex = 0;
    }
    void ShowContextMenuWithContent(MouseEventArgs args, int? id)
    {
        ContextMenuService.Open(args, ds =>
        @<RadzenMenu>
    <RadzenMenuItem Icon="@IconNames.Add" Click="@(() => AddVillage(id))" Text="Add Village" Value="@id"></RadzenMenuItem>
    <RadzenMenuItem Icon="edit" Click="@(() => Edit(id ?? default))" Text="Edit" Value="@id"></RadzenMenuItem>
    <RadzenMenuItem Icon="delete" Click="@(() => Delete(id ?? default))" Text="Delete" Value="@id"></RadzenMenuItem>
</RadzenMenu>
    );
    }
}


