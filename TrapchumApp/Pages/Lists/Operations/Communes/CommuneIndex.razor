@page "/App/Operation-Area/Communes"
@using Applications.Responses.ViewModels.Addresses
<PageTitle>Communes</PageTitle>
<RadzenCard>
    <PageDropDown ShowSearchBox="true"
                  PlaceHolder="Search commune"
                  OnTextChanged="TextChanged"
                  PageSizeChanged="PageSizeChanged">
        <LeftChildContent>
            <RadzenButton Text="New Commune"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small"
                          Icon="add"
                          Click="ShowCreate" />
        </LeftChildContent>
        <RightChildContent>
            <RadzenStack Orientation="Orientation.Horizontal">

            </RadzenStack>
        </RightChildContent>
    </PageDropDown>
    <RadzenDataGrid Responsive="true"
                    AllowSorting="true"
                    Count="@counts"
                    PageSize="@pageSize"
                    PagerPosition="PagerPosition.Bottom"
                    ShowPagingSummary="true"
                    AllowPaging="true"
                    TItem="VCommunes"
                    Density="Density.Compact"
                    LoadData="LoadData"
                    PagerHorizontalAlign="HorizontalAlign.Right"
                    Data="vCommunelistt">
        <Columns>
            <RadzenDataGridColumn Width="4rem" Title="#" Property="@nameof(VCommunes.CommuneId)" />
            <RadzenDataGridColumn Property="@nameof(VCommunes.ComDescription)"
                                  Title="Commune-English"
                                  Sortable="true" />
            <RadzenDataGridColumn Property="@nameof(VCommunes.ComInKhmer)"
                                  Title="Commune-Khmer"
                                  Sortable="true" />
            <RadzenDataGridColumn Property="@nameof(VCommunes.DisDescription)"
                                  Title="District-English"
                                  Width="14rem"
                                  Sortable="true"
                                  SortProperty="DisDescription" />
            <RadzenDataGridColumn Property="@nameof(VCommunes.DisInKhmer)"
                                  Title="District-Khmer"
                                  Width="14rem"
                                  Sortable="true"
                                  SortProperty="DisInKhmer" />
            

            <RadzenDataGridColumn Title="Actions" Context="c" Width="7rem">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall"
                                  Icon="more_vert"
                                  Variant="Variant.Text"
                                  Click="@((args)=>ShowContextMenuWithContent(args,c.CommuneId))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>

    </RadzenDataGrid>
</RadzenCard>

@code {
    void PageSizeChanged(int page)
    {
        pageSize = page;
    }
    void ShowContextMenuWithContent(MouseEventArgs args, int? id)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu>
    <RadzenMenuItem Icon="edit" Click="@(() => Edit(id ?? default))" Text="Edit" Value="@id"></RadzenMenuItem>
    <RadzenMenuItem Icon="delete" Click="@(() => Delete(id ?? default))" Text="Delete" Value="@id"></RadzenMenuItem>
</RadzenMenu>
    );
    }
}


