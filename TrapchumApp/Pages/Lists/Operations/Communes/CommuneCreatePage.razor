@using TrapchumApp.Services
@using Domains.Models.Addresses
<RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
    <RadzenTemplateForm TItem="CommuneDtoCreate" Data=@model Submit=@Create>
        <RadzenStack>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenFormField Text="Commune ID *" Variant="Variant.Flat" Style="width:100%">
                            <RadzenNumeric Name="DistrictId" @bind-Value="@model.CommuneId" Style="width:100%" />
                            <RadzenRequiredValidator Component="DistrictId" Text="District ID is required" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenFormField Text="District *" Variant="Variant.Flat" Style="width:100%">
                            <RadzenDropDown Chips="true"
                                            AllowFiltering="true"
                                            Name="DropDownSalutions"
                                            Style="width: 100%;"
                                            Data="districts"
                                            @bind-Value="model.DistrictRefId"
                                            TextProperty="@nameof(District.DisInKhmer)"
                                            ValueProperty="@nameof(District.DistrictId)"
                                            FilterOperator="StringFilterOperator.Contains"
                                            Placeholder="Please select district">

                            </RadzenDropDown>

                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenFormField Text="Commune In English" Variant="Variant.Flat" Style="width:100%">
                            <RadzenTextBox Name="ComDescription" @bind-Value="model.ComDescription" Style="width:100%" />

                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenFormField Text="Commune In Khmer" Variant="Variant.Flat" Style="width:100%">
                            <RadzenTextBox Name="ComInKhmer" @bind-Value="model.ComInKhmer" Style="width:100%" />

                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" class="mt-2"
                     JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton ButtonType="ButtonType.Submit"
                          Text="Save"
                          Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Primary"
                          Icon="save"></RadzenButton>
            <RadzenButton Click="@((args) => DialogService!.Close(true))"
                          Variant="Variant.Flat"
                          Size="ButtonSize.Small"
                          Text="Close"
                          Icon="cancel"
                          ButtonStyle="ButtonStyle.Secondary" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenStack>







