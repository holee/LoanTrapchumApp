@using Applications.Features.Collaterals.Dtos
@using Domains.Models.Collaterals
@using TrapchumApp.Pages.Lists.Collaterals
<style>
    .rz-grid-table td .rz-cell-data {
        line-height: 1.5rem;
        font-size: 0.8rem;
    }
</style>
<RadzenDataGrid Count="@_counts"
                PageSize="@pageSize"
                LoadData="@LoadData"
                Density="Density.Compact"
                GridLines="DataGridGridLines.Both"
                TItem="CollateralSubType"
                EditMode="DataGridEditMode.Single"
                RowUpdate="@OnUpdateRow"
                RowCreate="@OnCreateRow"
                ShowPagingSummary="true"
                AllowPaging="true"
                AllowSorting="true"
                AllowFiltering="true"
                Sort="@Reset"
                Page="@Reset"
                Filter="@Reset"
                @ref="@refGrid"
                PagerPosition="PagerPosition.Bottom"
                PagerHorizontalAlign="HorizontalAlign.Right"
                PageSizeOptions="@StorageConstant.PageSizeOptions"
                IsLoading="@_isLoading"
                Data="@_collateralSubTypes">
    <HeaderTemplate>
        <RadzenButton ButtonStyle="ButtonStyle.Primary"
                      Size="ButtonSize.Small"
                      Text="Add New Collateral"
                      Click="@ClickAdd"
                      Icon="@IconNames.Add" />
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="@nameof(CollateralSubType.Id)"
                              Title="#"
                              Width="4rem"
                              TextAlign="TextAlign.Center"
                              Filterable="false"
                              Sortable="false"
                              Context="c">
            <Template>
                @(_collateralSubTypes.IndexOf(c) + 1)
                <input type="hidden" @bind="c.Id" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(CollateralTypeResponse.CollateralTypeCode)"
                              Title="Category"
                              Width="10rem"
                              Context="c"
                              TextAlign="TextAlign.Left">
            <Template>
                @_colleralTypes.FirstOrDefault(x => x.CollateralTypeId == c.CollateralTypeRefId)?.CollateralTypeCode
            </Template>
            <EditTemplate Context="c">
                <RadzenDropDown @bind-Value="c.CollateralTypeRefId"
                                Data="@_colleralTypes"
                                TextProperty="@nameof(CollateralTypeResponse.CollateralTypeCode)"
                                ValueProperty="@nameof(CollateralTypeResponse.CollateralTypeId)"
                                Style="width:100%; display: block;"
                                InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Select customer" } })" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(CollateralSubType.CollateralSubTypeName)"
                              Title="Type Name"
                              Width="10rem"
                              TextAlign="TextAlign.Left"
                              Context="c">
            <Template>
                @c.CollateralSubTypeName
            </Template>
            <EditTemplate Context="c">
                <RadzenTextBox @bind-Value="c.CollateralSubTypeName" Style="width: 100%;" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(CollateralSubType.CollateralSubTypeNameInKhmer)"
                              Title="Khmer Name"
                              Width="10rem"
                              TextAlign="TextAlign.Left"
                              Context="c">
            <Template>
                @c.CollateralSubTypeNameInKhmer
            </Template>
            <EditTemplate Context="c">
                <RadzenTextBox @bind-Value="c.CollateralSubTypeNameInKhmer" Style="width: 100%;" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(CollateralSubType.ValueRate)"
                              Title="Value Rate"
                              Width="8rem"
                              TextAlign="TextAlign.Left"
                              Context="c">
            <Template>
                @c?.ValueRate
            </Template>
            <EditTemplate Context="c">
                <RadzenNumeric ShowUpDown="false" TValue="decimal?" @bind-Value="c.ValueRate" Style="width: 100%;" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(CollateralSubType.LoanSizeAmuntMin)"
                              Title="Min Amount"
                              Width="10rem"
                              TextAlign="TextAlign.Left"
                              Context="c">
            <Template>
                @c?.LoanSizeAmuntMin
            </Template>
            <EditTemplate Context="c">
                <RadzenNumeric ShowUpDown="false" TValue="decimal?" @bind-Value="c.LoanSizeAmuntMin" Style="width: 100%;" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(CollateralSubType.LoanSizeAmuntMax)"
                              Title="Max Amount"
                              Width="10rem"
                              TextAlign="TextAlign.Left"
                              Context="c">
            <Template>
                @c?.LoanSizeAmuntMax
            </Template>
            <EditTemplate Context="c">
                <RadzenNumeric ShowUpDown="false" TValue="decimal?" @bind-Value="c.LoanSizeAmuntMax" Style="width: 100%;" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(CollateralSubType.IsActive)"
                              Title="Status"
                              Width="4rem"
                              Filterable="false"
                              Sortable="false"
                              TextAlign="TextAlign.Center"
                              Context="c">
            <Template>
                <RadzenCheckBox TValue="bool?" Value="@c.IsActive" ReadOnly />
            </Template>
            <EditTemplate>
                <RadzenCheckBox TValue="bool?" @bind-Value="@c.IsActive" />
            </EditTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(CollateralSubType.Id)"
                              Title="Action"
                              Width="6rem"
                              TextAlign="TextAlign.Center"
                              Filterable="false"
                              Sortable="false"
                              Context="c">
            <Template>
                <RadzenButton Icon="@IconNames.Edit"
                              Variant="Variant.Text"
                              Size="ButtonSize.ExtraSmall"
                              class="rz-my-1 rz-ms-1"
                              Click="@(args => EditRow(c))"
                              @onclick:stopPropagation="true" />
            </Template>
            <EditTemplate Context="order">
                <RadzenButton Icon="@IconNames.Save" ButtonStyle="ButtonStyle.Success"
                              Variant="Variant.Text"
                              Size="ButtonSize.ExtraSmall"
                              Click="@((args) => SaveRow(order))"
                              aria-label="Save" />
                <RadzenButton Icon="@IconNames.Undo" ButtonStyle="ButtonStyle.Danger"
                              Variant="Variant.Text"
                              Size="ButtonSize.ExtraSmall"
                              class="rz-my-1 rz-ms-1" 
                              Click="@((args) => CancelEdit(order))" aria-label="Cancel" />
            </EditTemplate>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Value="100" ShowValue="false"
                                   Mode="ProgressBarMode.Indeterminate"
                                   ProgressBarStyle="ProgressBarStyle.Danger"></RadzenProgressBarCircular>
    </LoadingTemplate>
</RadzenDataGrid>
@code {
    private bool _isLoading = false;
    async Task ClickAdd()
    {
        var options = new DialogOptions
        {
            AutoFocusFirstElement=false,
        };
        var dia= await DialogService.OpenAsync<SubTypeCollateralCreate>("Add", options: options);

        if (dia is bool result && result == true)
        {
            await GetCollateralSubTypes();
        } 
    }
}