<RadzenMenu>
        <RadzenMenuItem Text="Details" Click="@OnDetails" Icon="@IconNames.Info"/>
        <RadzenMenuItem Text="Edit" Click="@OnEdit" Icon="@IconNames.Edit"/>
        <RadzenMenuItem Text="Delete" Click="@OnDelete" Icon="@IconNames.Delete"/>
</RadzenMenu>

@code {
        [Parameter] public int? Id { get; set; } = 0;
        [Parameter] public EventCallback<int?> ClickEdit { get; set; }
        [Parameter] public EventCallback<int?> ClickDelete { get; set; }
        [Parameter] public EventCallback<int?> ClickDetails { get; set; }

        private async Task OnEdit()
        {
                if (ClickEdit.HasDelegate)
                {
                        await ClickEdit.InvokeAsync(Id);
                }
        }

        private async Task OnDetails()
        {
                if (ClickDetails.HasDelegate)
                {
                        await ClickDetails.InvokeAsync(Id);
                }
        }

        private async Task OnDelete()
        {
                if (ClickDelete.HasDelegate)
                {
                        await ClickDelete.InvokeAsync(Id);
                }
        }

}