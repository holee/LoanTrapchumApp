@page "/App/Setting/occupations/Create"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Applications.Requests.Settings
@using Radzen
@using Radzen.Blazor

<RadzenTemplateForm TItem="OccupationDtoCreate" Data="@occupation" Submit="@OnSubmit">
    <RadzenRow class="rz-my-2">
        <RadzenColumn Size="12">
            <RadzenFormField Text="Occupation Title" Variant="Variant.Outlined" class="rz-w-100">
                <RadzenTextBox class="rz-w-100"
                               @bind-Value="@occupation.OccupationTitle"
                               Name="OccupationTitle" />
                <RadzenRequiredValidator Component="OccupationTitle"
                                         Text="Occupation Title is required" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-my-2">
        <RadzenColumn Size="12">
            <RadzenFormField Text="Khmer" Variant="Variant.Outlined" class="rz-w-100">
                <RadzenTextBox @bind-Value="@occupation.Khmer" Name="Khmer" class="rz-w-100" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-my-2">
        <RadzenFormField class="rz-w-100" Text="Type Of" Variant="Variant.Outlined" AllowFloatingLabel="false">
            <RadzenDropDown Data="@StorageConstant.TypeOfOptions"
                            class="rz-w-100"
                            @bind-Value="@occupation.TypeOf">

            </RadzenDropDown>
        </RadzenFormField>
    </RadzenRow>
    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 AlignItems="AlignItems.Center">
        <RadzenButton ButtonType="ButtonType.Submit"
                      Text="Save"
                      ButtonStyle="ButtonStyle.Success"
                      Icon="@IconNames.Save"
                      Size="ButtonSize.ExtraSmall" />
        <RadzenButton ButtonType="ButtonType.Button"
                      Size="ButtonSize.ExtraSmall"
                      Text="Cancel"
                      Icon="@IconNames.Cancel"
                      ButtonStyle="ButtonStyle.Danger"
                      Click="@(()=>DialogService.Close(false))" />
    </RadzenStack>

</RadzenTemplateForm>
@code {
    private OccupationDtoCreate occupation = new();

    private readonly IOccupationServiceImpl _occupationService;

    public OccupationCreate(IOccupationServiceImpl occupationService)
    {
        _occupationService = occupationService;
    }

    private async Task OnSubmit(OccupationDtoCreate model)
    {
        // Handle form submission (e.g., save to database)
        var rsp = await _occupationService.CreateAsync(occupation);

        if (rsp.IsSuccess)
        {
            DialogService.Close(rsp.Data);
        }
    }

    private void CloseForm()
    {
        DialogService.Close(null);
    }


}