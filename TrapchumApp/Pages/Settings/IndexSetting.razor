@page "/App/Settings"
@using Applications.Features.Settings.Commands.AppSettings.DeleteAppSetting
@using Applications.Features.Settings.Dto
@using Applications.Features.Settings.Queries.AppSettings.GetAppSettings
@using TrapchumApp.Pages.Settings.LoanPurposes
@using TrapchumApp.Pages.Settings.AppSettings
@using TrapchumApp.Pages.Settings.Periods
<PageTitle>Settings</PageTitle>
<RadzenFieldset>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
            <RadzenIcon Icon="settings" /><b>Application Settings</b>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <GridToolbar SearchChanged="@TextChanged">
            <LeftChildren>
                <RadzenButton Size="ButtonSize.ExtraSmall"
                              ButtonStyle="ButtonStyle.Primary"
                              Text="Add New"
                              Icon="@IconNames.Add"
                              Click="@AddAppSetting" />
            </LeftChildren>
        </GridToolbar>
        <RadzenDataGrid AllowAlternatingRows="true"
                        AllowFiltering="false"
                        Density="Density.Compact"
                        GridLines="DataGridGridLines.Both"
                        @ref="@_settingsGrid"
                        IsLoading="@_isLoading"
                        Responsive="true"
                        TItem="AppSettingDto"
                        Data="@_settings">
            <Columns>
                <RadzenDataGridColumn Title="#"
                                      Filterable="false"
                                      Sortable="false"
                                      Width="3rem"
                                      TextAlign="TextAlign.Center"
                                      Context="s">
                    <Template>@(_settings.IndexOf(s) + 1)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(AppSettingDto.Code)" Title="Code" Width="10rem" />
                <RadzenDataGridColumn Property="@nameof(AppSettingDto.Value)" Title="Value" Width="10rem" />
                <RadzenDataGridColumn Property="@nameof(AppSettingDto.Description)" Title="Description" />
                <RadzenDataGridColumn TextAlign="TextAlign.Center" Title="Status" Width="6rem" Context="s">
                    <Template>
                        <RadzenBadge BadgeStyle="@(s.IsActive ? BadgeStyle.Success : BadgeStyle.Danger)"
                                     Text="@(s.IsActive ? "Active" : "Inactive")" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Action" Width="4rem" TextAlign="TextAlign.Center" Context="s">
                    <Template>
                        <RadzenButton Size="ButtonSize.ExtraSmall"
                                      Icon="more_vert"
                                      Variant="Variant.Text"
                                      Click="@((args) => ShowContextMenu(args, s))"
                                      @onclick:stopPropagation="true" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </ChildContent>
</RadzenFieldset>
<RadzenFieldset>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
            <RadzenIcon Icon="settings" /><b>Collateral Settings</b>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <CollateralSetting />
    </ChildContent>
</RadzenFieldset>
<RadzenFieldset>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
            <RadzenIcon Icon="@IconNames.Alarm" /><b>Period Settings</b>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <PeriodList />
    </ChildContent>
</RadzenFieldset>
<RadzenFieldset>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
            <RadzenIcon Icon="@IconNames.Edit" /><b>Loan Purpose Settings</b>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <LoanPurposeList />
    </ChildContent>
</RadzenFieldset>
@code {
    private void ShowContextMenu(MouseEventArgs args, AppSettingDto item)
    {
        ContextMenuService.Open(args, ds => @<RadzenMenu>
            <RadzenMenuItem Click="@(async () => await EditAppSetting(item))" Text="Edit" Icon="@IconNames.Edit" />
            <RadzenMenuItem Click="@(async () => await DeleteAppSetting(item))" Text="Delete" Icon="@IconNames.Delete" />
        </RadzenMenu>);
    }
}

