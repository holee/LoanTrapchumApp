@page "/App/Notes/CurrencyCounter"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Currencies.Responses
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Services
<PageTitle>Currency Note</PageTitle>
<GridToolbar>
    <LeftChildren>
        <RadzenButton Click="DisplayCurrencyDialogue"
                      Icon="add"
                      Text="New Note"
                      Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Primary" />
    </LeftChildren>
    <RightChildren>
        <div class="rz-text-align-center">
            <RadzenCheckBox TValue="bool"
                            @bind-Value="includeInactive">
            </RadzenCheckBox>
            <RadzenLabel>Inlcude Inactive</RadzenLabel>
        </div>
    </RightChildren>
</GridToolbar>
<RadzenDataGrid AllowPaging="true"
                PageSize="@pageSize"
                IsLoading="@isLoading"
                Density="Density.Compact"
                AllowAlternatingRows="true"
                TItem="VCurrencyCounter"
                ShowPagingSummary="true"
                AllowColumnPicking="true"
                GridLines="DataGridGridLines.Both"
                RowSelect="@OnRowSelect"
                PagerHorizontalAlign="HorizontalAlign.Right"
                PageSizeOptions="@StorageConstant.PageSizeOptions"
                PageSizeChanged="SelectPageSizeChanged"
                Data="@CurrencyCounters">
    <HeaderTemplate>

    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Context="item"
                              Title="Currency Name"
                              Property="CurrencyName">
            <Template>
                <input @bind="item.Id" type="hidden" />
                @item?.CurrencyName
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="item"
                              Title="Currency Code"
                              Property="@nameof(VCurrencyCounter.CurrencyCode)">
            <Template>
                @item?.CurrencyCode
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="item"
                              Title="Value"
                              Width="7rem"
                              Property="@nameof(VCurrencyCounter.CurrencyValue)">
            <Template>
                @item?.CurrencyValue
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="item"
                              Title="Quantity"
                              TextAlign="TextAlign.Right"
                              Width="7rem"
                              Property="@nameof(VCurrencyCounter.Quantity)">
            <Template>
                @item?.Quantity
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="item"
                              Title="Description"
                              Property="@nameof(VCurrencyCounter.Description)">
            <Template>
                @item?.Description
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="item"
                              Width="4rem"
                              Title="IsActive"
                              TextAlign="TextAlign.Center"
                              Property="@nameof(VCurrencyCounter.IsActive)">
            <Template>
                <RadzenCheckBox TValue="bool"
                                Change="@((arg)=>makeInactiveOrActive(arg,item.Id))"
                                @bind-Value="item.IsActive" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular ShowValue="false"
                                   ProgressBarStyle="ProgressBarStyle.Danger"
                                   Value="100" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>
@code {
    void OnRowSelect() { }
}