<div class="@Styles.W100">
    <EditForm Model="model" @ref="editForm">
        <DataAnnotationsValidator />
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="12">
                <RadzenFormField AllowFloatingLabel="true" Text="Currency Code" class="@Styles.W100">
                    <ChildContent>
                        <RadzenDropDown Data="Currencies"
                                        TValue="int?"
                                        Disabled="@(Id != 0)"
                                        class="@Styles.W100"
                                        TextProperty="Description"
                                        ValueProperty="CurrencyId"
                                        @bind-Value="model.CurrencyRefId">
                        </RadzenDropDown>
                    </ChildContent>
                    <Helper>
                        <ValidationMessage For="@(()=>model.Description)" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center" class="@Defaults.Mt2">
            <RadzenColumn Size="12">
                <IntNumbers IsFloatLabel="true"
                           Placeholder="Currency Value"
                           Label="Currency Value"
                           @bind-Value="model.CurrencyValue" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center" class="@Defaults.Mt2">
            <RadzenColumn Size="12">
                <RadzenFormField Text="Description" class="@Styles.W100">
                    <ChildContent>
                        <RadzenTextArea @bind-Value="model.Description" class="@Styles.W100"/>
                    </ChildContent>
                    <Helper>
                        <ValidationMessage For="@(() => model.Description)"/>
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
    </EditForm>
    <RadzenStack Orientation="Orientation.Horizontal" class="@Defaults.Mt2"
                 Gap="1rem"
                 AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
        <RadzenButton Icon="save"
                      Text="Save"
                      Click="FormSubmit"
                      Size="ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Success" />
        <RadzenButton Icon="cancel"
                      Click="Close"
                      Text="Close"
                      Size="ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Danger" />
    </RadzenStack>
</div>





