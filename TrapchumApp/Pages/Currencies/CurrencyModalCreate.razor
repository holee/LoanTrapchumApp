<PageTitle>CreateNewUser Currency</PageTitle>
<div class="container-fluid">
    <EditForm Model="model">
        <RadzenStack AlignItems="AlignItems.Center"
                     Orientation="Orientation.Horizontal">
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="4">
                    <RadzenLabel>Currency</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenTextBox @bind-Value="model.CurrencyCode"
                                   Placeholder="Currency code" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="4">
                    <RadzenLabel>Exchange Rate</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenNumeric TValue="decimal?"
                                   @bind-Value="model.ExchangeRate"
                                   Placeholder="Exchange Rate Amount" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="4">
                    <RadzenLabel>Currency Code</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenNumeric TValue="decimal?"
                                   @bind-Value="model.SpotRate"
                                   Placeholder="Sport Rate" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="4">
                    <RadzenLabel>Currency Code</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenTextBox @bind-Value="model.CurrencyType"
                                   Placeholder="Currency Type"
                                   Size="Blazorise.Size.Small" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="4">
                    <RadzenLabel>Currency Code</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenNumeric TValue="decimal?"
                                   @bind-Value="model.Limited" />
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <div class="rz-p-12 rz-text-align-center">
                        <RadzenCheckBox @bind-Value="model.IsBaseCurrency" Name="CheckBox1" />
                        <RadzenLabel Text="Is Base Currency" Component="CheckBox1" Style="margin-left: 8px; vertical-align: middle;" />
                    </div>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </EditForm>
</div>
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.End">
    <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Success" Text="Save" Icon="save" />
    @* <LinkButton Path="/Account/Currencies" Text="Close" /> *@
</RadzenStack>


