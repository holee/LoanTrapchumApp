<tr>
    <td>@(RowNumber + 1)</td>
    <td>@Currency?.CurrencyCode</td>
    <td>@Currency?.CurrencyName</td>
    <td class="text-end">@Currency?.SpotRate</td>
    <td class="text-end">@Currency?.BuyingRate</td>
    <td class="text-end">@Currency?.SellingRate</td>
    <td class="class.Center">
        <RadzenSwitch @bind-Value="Currency!.IsBaseCurrency" Disabled />
    </td>
    <td class="class.Center">
        <RadzenSwitch @bind-Checked="Currency.IsActive" Disabled />
    </td>
    <td>
        <div class="rz-p-sm-12" style="margin-bottom: 200px;">
            <RadzenMenu>
                <RadzenMenuItem Text="Action" Icon="home">
                    <RadzenMenuItem Text="Edit" Path="menu" Icon="line_weight" Disabled="true"></RadzenMenuItem>
                    <RadzenMenuItem Click="ShowSpotRateCurrency" Text="Details" Icon="attach_file" Disabled="true"></RadzenMenuItem>
                    @if (!Currency.IsBaseCurrency)
                    {
                        <RadzenMenuItem Text=" Is Base Currency" Path="dialog" Icon="perm_media"></RadzenMenuItem>
                    }
                    <RadzenMenuItem Text="Add Counter" Path="notification" Icon="announcement"></RadzenMenuItem>
                </RadzenMenuItem>
            </RadzenMenu>
        </div>
    </td>
</tr>


