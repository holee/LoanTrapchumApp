@page "/App/Account/ManageLoanSize"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Applications.Responses.ViewModels.Settings
@using TrapchumApp.Helpers.Constants
@using TrapchumApp.Services
<PageTitle>Manage Loan Size</PageTitle>
<RadzenFieldset>
    <HeaderTemplate>
        <RadzenStack AlignItems="AlignItems.Center" Gap="0.25rem" Orientation="Orientation.Horizontal">
            <RadzenIcon class="fa" Icon="@("\ue529")" Style="font-size:1rem;" /><strong>Loan Size</strong>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <GridToolbar SearchChanged="@SearchTextChanged">
            <RightChildren>
                <div class="rz-p-2 rz-text-align-center">
                    <RadzenCheckBox TValue="bool"
                                    Change="CheckedChanged"
                                    Name="isIncludeInActive"
                                    Value="@isIncludeInActive" />
                    <RadzenLabel Text="Include In Active" Component="isIncludeInActive" class="rz-ms-2" />
                </div>
            </RightChildren>
        </GridToolbar>
        <RadzenDataGrid Data="@_loanSizes"
                        Responsive="true"
                        Density="Density.Compact"
                        AllowAlternatingRows="true"
                        AllowPaging="true"
                        IsLoading="@isLoading"
                        Count="@_counts"
                        ColumnWidth="10rem"
                        AllowSorting="true"
                        TItem="VUserLoanSizes"
                        RowSelect="@SelectedRowChanged"
                        PageSize="@pageSize"
                        GridLines="DataGridGridLines.Both"
                        PageSizeChanged="@PageSizeChanged"
                        PageSizeOptions="@StorageConstant.PageSizeOptions"
                        PagerHorizontalAlign="HorizontalAlign.Right"
                        PagerPosition="PagerPosition.Bottom"
                        ShowPagingSummary="true"
                        LoadData="@LoadData">
            <Columns>
                <RadzenDataGridColumn Title="Name"
                                      Property="@nameof(VUserLoanSizes.FullName)">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Min Khr Size"
                                      TextAlign="TextAlign.Right"
                                      Context="c"
                                      Property="@nameof(VUserLoanSizes.MinKhrLoanSize)">
                    <Template>
                        @c.MinKhrLoanSize.Format(1)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Max Khr Size"
                                      TextAlign="TextAlign.Right"
                                      Context="c"
                                      Property="@nameof(VUserLoanSizes.MaxKhrLoanSize)">
                    <Template>
                        @c.MaxKhrLoanSize.Format(1)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Min Usd Size"
                                      TextAlign="TextAlign.Right"
                                      Context="c"
                                      Property="@nameof(VUserLoanSizes.MinUsdLoanSize)">
                    <Template>
                        @c.MinUsdLoanSize.Format(2)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Max Usd Size"
                                      TextAlign="TextAlign.Right"
                                      Context="c"
                                      Property="@nameof(VUserLoanSizes.MaxUsdLoanSize)">
                    <Template>
                        @c.MaxUsdLoanSize.Format(2)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="IsActive"
                                      TextAlign="TextAlign.Center"
                                      Context="c"
                                      Width="5rem"
                                      Property="@nameof(VUserLoanSizes.IsActive)">
                    <Template>
                        <RadzenCheckBox TValue="bool" Value="@c.IsActive" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Description"
                                      TextAlign="TextAlign.Left"
                                      Context="c"
                                      Property="@nameof(VUserLoanSizes.Description)">
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Action"
                                      TextAlign="TextAlign.Center"
                                      Context="c"
                                      Width="5rem"
                                      Property="@nameof(VUserLoanSizes.Description)">
                    <Template>
                        <RadzenButton Size="ButtonSize.ExtraSmall"
                                      Variant="Variant.Text"
                                      Click="@(()=>@ManageLoanSize(c.Id,c.UserRefId))"
                                      Icon="@IconNames.Edit" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </ChildContent>
</RadzenFieldset>
