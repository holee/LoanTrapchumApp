@inherits LayoutComponentBase
<style>
    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        margin: 0;
        overflow: hidden;
        background: linear-gradient(135deg, #0f0c29 0%, #1a1a4e 40%, #24243e 70%, #0f3460 100%);
        background-size: 300% 300%;
        animation: gradientShift 14s ease infinite;
        position: relative;
    }

    /* Glass overlay tint */
    body::before {
        content: '';
        position: fixed;
        inset: 0;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(0px);
        pointer-events: none;
        z-index: 0;
    }

    /* Flying bubbles */
    .bubbles {
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }

    .bubble {
        position: absolute;
        bottom: -80px;
        border-radius: 50%;
        background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.45), rgba(255,255,255,0.06));
        border: 1px solid rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(4px);
        animation: flyBubble linear infinite;
    }

    .bubble:nth-child(1)  { left:  5%; width: 40px;  height: 40px;  animation-duration: 9s;  animation-delay: 0s;   }
    .bubble:nth-child(2)  { left: 12%; width: 20px;  height: 20px;  animation-duration: 12s; animation-delay: 2s;   }
    .bubble:nth-child(3)  { left: 22%; width: 55px;  height: 55px;  animation-duration: 8s;  animation-delay: 1s;   }
    .bubble:nth-child(4)  { left: 33%; width: 30px;  height: 30px;  animation-duration: 14s; animation-delay: 4s;   }
    .bubble:nth-child(5)  { left: 45%; width: 16px;  height: 16px;  animation-duration: 10s; animation-delay: 0.5s; }
    .bubble:nth-child(6)  { left: 55%; width: 48px;  height: 48px;  animation-duration: 11s; animation-delay: 3s;   }
    .bubble:nth-child(7)  { left: 63%; width: 22px;  height: 22px;  animation-duration: 7s;  animation-delay: 1.5s; }
    .bubble:nth-child(8)  { left: 72%; width: 62px;  height: 62px;  animation-duration: 13s; animation-delay: 5s;   }
    .bubble:nth-child(9)  { left: 82%; width: 26px;  height: 26px;  animation-duration: 9s;  animation-delay: 2.5s; }
    .bubble:nth-child(10) { left: 90%; width: 18px;  height: 18px;  animation-duration: 11s; animation-delay: 0s;   }
    .bubble:nth-child(11) { left: 18%; width: 34px;  height: 34px;  animation-duration: 15s; animation-delay: 6s;   }
    .bubble:nth-child(12) { left: 50%; width: 44px;  height: 44px;  animation-duration: 10s; animation-delay: 3.5s; }

    .container {
        text-align: center;
        position: relative;
        z-index: 1;
        animation: fadeSlideUp 0.55s cubic-bezier(.4,0,.2,1) both;
    }

    .logo {
        margin-bottom: 8px;
    }

    .login-box {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(18px) saturate(1.6);
        -webkit-backdrop-filter: blur(18px) saturate(1.6);
        padding: 32px 36px 28px;
        border-radius: 16px;
        width: 380px;
        box-shadow: 0 8px 40px rgba(99, 102, 241, 0.13), 0 2px 12px rgba(0,0,0,0.07);
        border: 1px solid rgba(255,255,255,0.7);
    }

    .login-heading {
        font-size: 1.35rem;
        font-weight: 700;
        color: #1e1b4b;
        margin: 0 0 4px;
    }

    .login-subtitle {
        font-size: 0.82rem;
        color: #6b7280;
        margin: 0 0 20px;
    }

    .form-group {
        margin-bottom: 14px;
        text-align: left;
    }

    .form-group label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 5px;
    }

    .form-input {
        width: 100%;
        padding: 10px 12px;
        font-size: 0.9rem;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: rgba(248, 250, 255, 0.9);
        color: #111827;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        box-sizing: border-box;
    }

    .form-input:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.18);
        background: #fff;
    }

    .form-input::placeholder {
        color: #9ca3af;
    }

    .form-group .validation-message {
        font-size: 0.75rem;
        color: #dc2626;
        margin-top: 4px;
    }

    .remember-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 8px 0 16px;
    }

    .remember-row label {
        font-size: 0.82rem;
        color: #4b5563;
        cursor: pointer;
        user-select: none;
    }

    .btn-login-full {
        width: 100%;
        justify-content: center;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    .login-footer {
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid #e5e7eb;
        font-size: 0.78rem;
        color: #9ca3af;
    }

    .status-alert {
        padding: 10px 14px;
        border-radius: 8px;
        font-size: 0.82rem;
        margin-bottom: 16px;
        text-align: left;
    }

    .status-alert.danger {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

    .status-alert.success {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
    }
</style>

<div class="bubbles">
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
    <div class="bubble"></div>
</div>

<div class="container">
    @Body
</div>