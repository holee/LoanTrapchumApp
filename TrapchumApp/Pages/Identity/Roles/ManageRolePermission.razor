@page "/App/Account/Roles/{Id}/Permissions"
<PageTitle>Role-Permissions</PageTitle>

<div class="perm-page">
    <div class="perm-header">
        <div class="perm-header-left">
            <RadzenIcon Icon="@IconNames.AssignmentInd" Style="font-size:1.5rem;color:#5a6acf;" />
            <div>
                <h2 class="perm-title">@rolePermissions!.Role!.Name</h2>
                <span class="perm-subtitle">Manage permissions for this role</span>
            </div>
        </div>
        <div class="perm-header-actions">
            <RadzenButton ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Flat"
                          Click="@(() => NavigationManager.NavigateTo("/App/Account/Roles"))"
                          Icon="arrow_back"
                          Text="Back"
                          Size="ButtonSize.Small" />
            <RadzenButton ButtonStyle="ButtonStyle.Success"
                          Click="SubmitHandler"
                          Icon="save"
                          Text="Save Changes"
                          Size="ButtonSize.Small" />
        </div>
    </div>

    <div class="perm-card">
        <div class="perm-selectall-row">
            <label class="perm-selectall-label" @onclick="@(() => OnSelectAllChanged(!_selectAll))">
                <span class="perm-selectall-check @(_selectAll ? "perm-selectall-check--active" : "")">
                    @if (_selectAll)
                    {
                        <RadzenIcon Icon="check" Style="font-size:0.8rem;" />
                    }
                </span>
                <span>Select All Permissions</span>
            </label>
            <button type="button" class="perm-restore-btn" @onclick="RestoreDefaults" title="Restore all permissions to saved state">
                <RadzenIcon Icon="restart_alt" Style="font-size:0.9rem;" />
                Restore Default
            </button>
        </div>
        <RadzenRow>
            @foreach (var group in _roleClaimsGrouped ?? [])
            {
                <RadzenColumn Size="3" SizeMD="3" SizeSM="12">
                    <div class="perm-group">
                        <div class="perm-group-header">
                            <label class="perm-group-toggle" @onclick="@(() => OnGroupSelectAllChanged(group, !group.GroupCheck))">
                                <span class="perm-group-check @(group.GroupCheck ? "perm-group-check--active" : "")">
                                    @if (group.GroupCheck)
                                    {
                                        <RadzenIcon Icon="check" Style="font-size:0.75rem;" />
                                    }
                                </span>
                                <span class="perm-group-name">@group.Group</span>
                            </label>
                            <div class="perm-group-actions">
                                <button type="button" class="perm-restore-btn perm-restore-btn--sm" @onclick="@(() => RestoreGroupDefaults(group))" title="Restore group to saved state">
                                    <RadzenIcon Icon="restart_alt" Style="font-size:0.8rem;" />
                                </button>
                                <span class="perm-group-count">
                                    @group.Permissions.Count(p => p.IsAssignedToRole) / @group.Permissions.Count
                                </span>
                            </div>
                        </div>
                        <div class="perm-group-body">
                            @foreach (var item in group.Permissions)
                            {
                                <RoleCheck Model="@item" @key="@($"{group.Group}_{item.ClaimValue}")"
                                           OnChange="((arg)=>OnCheckChanged(arg))" />
                            }
                        </div>
                    </div>
                </RadzenColumn>
 
            }
        </RadzenRow>
           
    </div>

    <div class="perm-bottom-bar">
        <RadzenButton ButtonStyle="ButtonStyle.Light"
                      Variant="Variant.Flat"
                      Click="@(() => NavigationManager.NavigateTo("/App/Account/Roles"))"
                      Icon="arrow_back"
                      Text="Back"
                      Size="ButtonSize.Small" />
        <RadzenButton ButtonStyle="ButtonStyle.Success"
                      Click="SubmitHandler"
                      Icon="save"
                      Text="Save Changes"
                      Size="ButtonSize.Small" />
    </div>
</div>