@page "/App/Account/Roles/{Id}/Permissions"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Services
<PageTitle>Role-Permissions</PageTitle>
<style>
    table tr > th {
        background-color: cornflowerblue;
        color: white;
    }

        table tr > th.group {
            width: 8rem;
            height: 2rem;
            text-align: left;
            padding-left: 0.9rem;
        }

        table tr > th.feature {
            padding:0 0.9rem;
        }

    table tr.Administrator {
        background-color: cadetblue;
    }

    table tr.Operation {
        background-color: aquamarine;
    }

    table tr.Accounting {
        background-color: blueviolet;
        color: white;
    }

    .grid-container {
        display: grid;
        grid-template-columns: repeat(6, 1fr); /* 2 columns */
        gap: 10px; /* space between rows and columns */
    }

        .grid-container .grid-item {
            width: 100%; /* Fills column */
        }
</style>
<RadzenProgressBar ShowValue="false" Value="100" Mode="ProgressBarMode.Indeterminate"
                   ProgressBarStyle="ProgressBarStyle.Primary" Visible="IsLoading"></RadzenProgressBar>
<RadzenFieldset AllowCollapse="false">
    <HeaderTemplate>
        <RadzenBadge BadgeStyle="BadgeStyle.Info" Shade="Shade.Dark">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" Style="padding: 0 0.25rem 0 0; text-transform: none;">
                <RadzenIcon Icon="@IconNames.AssignmentInd" />
                <RadzenText TextStyle="TextStyle.DisplayH6"
                            Text="@rolePermissions!.Role!.Name"
                            TagName="TagName.H3"></RadzenText>
            </RadzenStack>
        </RadzenBadge>
    </HeaderTemplate>
    <ChildContent>
        <table border="1" style="border-collapse:collapse;text-align:center;">
            <tr>
                <th class="group">Group</th>
                <th style="width:5rem;">
                    <RadzenCheckBox TValue="bool"
                                    @bind-Value="@_selectAll"
                                    Change="@((arg) => OnSelectAllChanged(arg))" />
                </th>
                <th style="text-align:left;">Feature</th>
            </tr>
            @foreach (var group in _roleClaimsGrouped ?? [])
            {
                <tr class="@group.Group">
                    <th class="group">
                        @group.Group
                    </th>
                    <td style="vertical-align:central;">
                        <RadzenCheckBox TValue="bool"
                                        @bind-Value="@group.GroupCheck"
                                        Name="@group.Group"
                                        Change="@((arg) => OnGroupSelectAllChanged(group, arg))" />
                    </td>
                    <td style="padding:0 0.5rem;">
                        <RadzenRow Gap="0.5rem" RowGap="0.1rem">
                            @foreach (var item in group.Permissions)
                            {
                                <RadzenColumn Size="3">
                                    <RoleCheck Model="@item" @key="@Guid.NewGuid().ToString("N")"
                                               OnChange="((arg)=>OnCheckChanged(arg))" />

                                </RadzenColumn>
                            }
                        </RadzenRow>
                    </td>
                </tr>
            }
        </table>

    </ChildContent>
</RadzenFieldset>
<RadzenStack>

</RadzenStack>
