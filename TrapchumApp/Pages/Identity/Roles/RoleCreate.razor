@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Microsoft.AspNetCore.Components.Sections
@using TrapchumApp.Services

<EditForm Model="model" @ref="roleCreateForm">
    <FluentValidationValidator DisableAssemblyScanning="true" />
    <RadzenRow Gap="1rem" class="rz-my-1">
        <RadzenColumn Size="6">
            <RadzenFormField Text="Role Name (*)" Variant="Variant.Outlined" Style="width: 100%;">
                <ChildContent>
                    <RadzenTextBox @bind-Value="@model.RoleName" />
                </ChildContent>
                <Helper>
                    <ValidationMessage For="@(() => model.RoleName)" />
                </Helper>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width: 100%;">
                <RadzenTextBox @bind-Value="@model.Description" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
</EditForm>

<div class="perm-card">
    <div class="perm-selectall-row">
        <label class="perm-selectall-label" @onclick="@(() => OnSelectAllChanged(!_selectAll))">
            <span class="perm-selectall-check @(_selectAll ? "perm-selectall-check--active" : "")">
                @if (_selectAll)
                {
                    <RadzenIcon Icon="check" Style="font-size:0.8rem;" />
                }
            </span>
            <span>Select All Permissions</span>
        </label>
    </div>
    <RadzenRow>
        @foreach (var group in RoleClaimsGrouped ?? [])
        {
            <RadzenColumn Size="6" SizeMD="6" SizeSM="12">
                <div class="perm-group">
                    <div class="perm-group-header">
                        <label class="perm-group-toggle" @onclick="@(() => OnGroupSelectAllChanged(group, !group.GroupCheck))">
                            <span class="perm-group-check @(group.GroupCheck ? "perm-group-check--active" : "")">
                                @if (group.GroupCheck)
                                {
                                    <RadzenIcon Icon="check" Style="font-size:0.75rem;" />
                                }
                            </span>
                            <span class="perm-group-name">@group.Group</span>
                        </label>
                        <span class="perm-group-count">
                            @group.Permissions.Count(p => p.IsSelected) / @group.Permissions.Count
                        </span>
                    </div>
                    <div class="perm-group-body">
                        @foreach (var item in group.Permissions)
                        {
                            <RoleCheckCreate Model="@item" @key="@($"{group.Group}_{item.ClaimValue}")"
                                             OnChange="((arg)=>OnCheckChanged(arg))" />
                        }
                    </div>
                </div>
            </RadzenColumn>
        }
    </RadzenRow>
</div>

<RadzenStack Orientation="Orientation.Horizontal"
             class="rz-my-4"
             JustifyContent="JustifyContent.End">
    <RadzenButton Click="@CreateRole"
                  Size="ButtonSize.Small"
                  Icon="@IconNames.Save"
                  Text="Save" ButtonStyle="ButtonStyle.Success" />
    <RadzenButton Size="ButtonSize.Small"
                  Icon="@IconNames.Close"
                  Click="@(()=>DialogService.Close(false))"
                  Text="Close" ButtonStyle="ButtonStyle.Danger" />
</RadzenStack>
<SectionContent SectionName="FabMenu">
    <!-- Place RadzenFabMenu component first or after the Header in RadzenLayout. -->
    <RadzenFabMenu Direction="Radzen.FabMenuDirection.Top" Variant="Variant.Flat">
        <RadzenFabMenuItem Size="ButtonSize.Small" Text="Folder" Icon="folder" Click=@(args => OnClick("New Folder.")) />
        <RadzenFabMenuItem Size="ButtonSize.Small" Text="Message" Icon="chat" Click=@(args => OnClick("New Message.")) />
        <RadzenFabMenuItem Size="ButtonSize.Small" Text="Article" Icon="article" Click=@(args => OnClick("New Article.")) />
    </RadzenFabMenu>
</SectionContent>
@code {

    private List<string> groups = [];

    bool _selectAll = false;

    private void OnSelectAllChanged(bool isChecked)
    {
        _selectAll = isChecked;

        foreach (var group in RoleClaimsGrouped ?? [])
        {
            group.GroupCheck = isChecked;

            foreach (var permission in group.Permissions)
            {
                permission.IsSelected = isChecked;
            }
        }
    }

    private void OnGroupSelectAllChanged(RolePermissionsDtoCreate group, bool isChecked)
    {
        group.GroupCheck = isChecked;

        foreach (var permission in group.Permissions)
        {
            permission.IsSelected = isChecked;
        }

        // Update global select all
        UpdateGlobalSelectAll();
    }


    void OnCheckChanged(PermissionsDtoCreate arg)
    {
        var gr = RoleClaimsGrouped?.Where(x => x.Group == arg.Group).FirstOrDefault();

        gr!.Permissions.Where(x => x.ClaimValue == arg.ClaimValue && x.ClaimType == arg.ClaimType)
                      .First().IsSelected = arg.IsSelected;

        gr!.GroupCheck = gr.Permissions.All(y => y.IsSelected == true);

        UpdateGlobalSelectAll();

    }

    private void UpdateGlobalSelectAll()
    {
        _selectAll = RoleClaimsGrouped!.All(g => g.Permissions.All(p => p.IsSelected));
    }


    private void GetPermissions()
    {
        var rsp = roleServiceImpl.GetAllPermissions();

        if (rsp.Any())
        {
            RoleClaimsGrouped = rsp.GroupBy(g => g.Group)
                                    .Select(x => new RolePermissionsDtoCreate
                                    {
                                        Group = x.Key,
                                        Permissions = x.ToList(),
                                        GroupCheck = x.All(y => y.IsSelected)
                                    }).ToList();
        }

    }

    protected override void OnInitialized()
    {
        GetPermissions();

        base.OnInitialized();
    }

    void OnClick(string message)
    {
        // Handle the click event for RadzenFabMenu items
        Console.WriteLine(message);
    }

}