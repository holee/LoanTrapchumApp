@using TrapchumApp.Services

<EditForm Model="model" @ref="roleCreateForm">
    <FluentValidationValidator DisableAssemblyScanning="true" />
    <ValidationSummary />
    <div class="row mb-2">
        <label class="col-sm-2 col-form-label">Role Name</label>
        <div class="col-sm-10">
            <RadzenTextBox class="form-control"
                       @bind-Value="model.RoleName" />
            <ValidationMessage For="@(() => model.RoleName)" />
        </div>
    </div>
    <div class="row mb-2">
        <label class="col-sm-2 col-form-label">Description</label>
        <div class="col-sm-10">
            <RadzenTextBox Placeholder="Enter here..."
                            class="form-control"
                            @bind-Value="model.Description" />
        </div>
    </div>
    <RadzenStack Orientation="Orientation.Horizontal" 
            class="rz-my-4"
            JustifyContent="JustifyContent.End">
        <RadzenButton Click="CreateRole"
                      Size="ButtonSize.ExtraSmall"
                      Icon="@IconNames.Save"
                      Text="Save" ButtonStyle="ButtonStyle.Success" />
        <RadzenButton Size="ButtonSize.ExtraSmall"
                      Icon="@IconNames.Close"
                      Click="@(()=>DialogService.Close(false))"
                      Text="Close" ButtonStyle="ButtonStyle.Danger" />
    </RadzenStack>

</EditForm>