@page "/App/Account/Roles"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.Identity.Roles.Responses
@using Applications.Features.LoanRequests.Interfaces
@using Microsoft.AspNetCore.Components.Web
@using TrapchumApp.Services 
<PageTitle>Roles</PageTitle>
@* @attribute [MustHasPermission(Modules.Roles, Feature.Read)] *@
<RadzenTabs RenderMode="TabRenderMode.Server">
    <Tabs>
        <RadzenTabsItem Text="Roles" Icon="list">
            <GridToolbar SearchChanged="@SearchChanged">
                <LeftChildren>
                    <RadzenButton Icon="@IconNames.Add"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Text="Add Role"
                                  Click="@AddUserRole"
                                  Size="ButtonSize.ExtraSmall" />
                </LeftChildren>
                <RightChildren>
                    <div class="rz-p-0 rz-text-align-center">
                        <RadzenCheckBox Name="InlcudeInActive" @bind-Value="@includeInActive" />
                        <RadzenLabel Text="Inlcude InActive" Component="InlcudeInActive" class="rz-ms-0" />
                    </div>
                </RightChildren>
            </GridToolbar>
            <RadzenDataGrid Density="Density.Compact"
                            GridLines="DataGridGridLines.Both"
                            Responsive
                            TItem="RoleDto"
                            Count="@counts"
                            AllowPaging="true"
                            AllowSorting="true"
                            PageSize="@pageSize"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            PageSizeOptions="@StorageConstant.PageSizeOptions"
                            PageSizeChanged="@PageSizeChanged"
                            RowSelect="@OnRowSelected"
                            LoadData="@LoadRoleData"
                            CellContextMenu="@OnCellContextMenu"
                            Data="Roles">
                <Columns>
                    <RadzenDataGridColumn Property="Id" Title="#"
                                          Width="3rem"
                                          Sortable="false"
                                          TextAlign="TextAlign.Center"
                                          Context="r">
                        <Template>
                            @(Roles?.ToList().IndexOf(r) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="8rem" Property="RoleName" Title="Name" />
                    <RadzenDataGridColumn Property="Description" Title="Description" Sortable="false" />
                    <RadzenDataGridColumn TextAlign="TextAlign.Center"
                                          Width="5rem"
                                          Property="IsActive"
                                          Title="Status" Context="r" Sortable="false">
                        <Template>
                            <RadzenBadge BadgeStyle="@(r.IsActive ? BadgeStyle.Success : BadgeStyle.Danger)"
                                         Text="@(r.IsActive ? "Active" : "Inactive")" />
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn Width="3rem"
                                          TextAlign="TextAlign.Center"
                                          Property="Id" Title="Action" Context="r" Sortable="false">
                        <Template>
                            <RadzenButton Size="ButtonSize.ExtraSmall"
                                          Icon="more_vert"
                                          Variant="Variant.Text"
                                          Click="@((args)=>ShowContextMenu(args,r.Id))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

