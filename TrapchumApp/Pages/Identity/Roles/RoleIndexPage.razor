@code {
    void ShowContextMenu(MouseEventArgs args, string userId)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Icon="manage_accounts"
                    Click="@(()=>ManageRolePermissions(userId))"
                    Text="Manage Role"
                    Value="@userId" />
    <RadzenMenuItem Icon="@IconNames.Edit"
                    Click="@(()=>UpdateRole(userId))"
                    Text="Edit Role"
                    Value="@userId" />
</RadzenMenu>

    );
    }


    async Task AddUserRole()
    {
        var options = new DialogOptions
        {
            Width = "100vw",
            ShowClose = true,
            Resizable = false,
            Draggable = false
        };
        var dia = await DialogService.OpenAsync<RoleCreate>("Add Role", options: options);

        if (dia is bool success && success)
        {
            await GetRoles();
        }
    }

    async Task UpdateRole(string? roleId)
    {
        var options = new DialogOptions
        {
            ShowClose = false,
            Draggable = true
        };
        var parameters = new Dictionary<string, object?>
        {
            {"RoleId",roleId}
        };
        var dia = await DialogService.OpenAsync<UpdateRole>("Update Role", parameters, options: options);

        if (dia is bool success && success)
        {
            await GetRoles(_filter);
        }
    }


    void OnRowSelected(RoleDto arg) { }

    private void OnCellContextMenu(DataGridCellMouseEventArgs<RoleDto> args)
    {
        if (args.Data is null) return;

        ContextMenuService.Open(args, new List<ContextMenuItem>
        {
            new ContextMenuItem
            {
                Text = "Manage Role",
                Icon = "manage_accounts",
                Value = "1"
            },
            new ContextMenuItem
            {
                Text = "Edit Role",
                Icon = "edit",
                Value = "2"
            }
        }, (e) =>
        {
            ContextMenuService.Close();
            DoRoleAction(e, args);
        });
    }

    private void DoRoleAction(MenuItemEventArgs e, DataGridCellMouseEventArgs<RoleDto> args)
    {
        if (args.Data is null) return;

        if (int.TryParse(e.Value?.ToString(), out int value))
        {
            if (value == 1)
            {
                ManageRolePermissions(args.Data.Id);
                return;
            }
            if (value == 2)
            {
                _ = UpdateRole(args.Data.Id);
                return;
            }
        }
    }
}