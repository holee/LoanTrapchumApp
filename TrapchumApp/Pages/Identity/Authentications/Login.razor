@page "/Account/Login"
@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Pages.Identity.Shared
@using TrapchumApp.Services
<PageTitle>Login</PageTitle>
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout
@inject NavigationManager NavigationManager
<div class="login-box">
    <div class="logo">
        <img src="/assets/logo/tch_Logo.png" alt="Trapchum Cash Pawn Shop Logo" style="width: 200px;">
    </div>
    <StatusMessage Message="@errorMessage" />
    <EditForm Model="@Input" OnValidSubmit="@LoginUser" FormName="login" method="post">
        <DataAnnotationsValidator />
        <div class="form-group">
            <InputText @bind-Value="Input.Email" placeholder="Email or Password" />
            <ValidationMessage For="() => Input.Email" />
        </div>
        <div class="form-group">
            <InputText @bind-Value="Input.Password"
                       type="@(password ? "password" : "text")"
                       placeholder="Password"
                       autocomplete="on" />
            <ValidationMessage For="() => Input.Password" />
        </div>
        <div class="remember-me">
            <InputCheckbox @bind-Value="Input.RememberMe" id="RememberMe" />
            <label for="RememberMe">Remember me</label>
        </div>
        <button type="submit" class="btn-login">Log in</button>
    </EditForm>
</div>

@code {
    bool password = true;
    void TogglePassword()
    {
        password = !password;
        Console.WriteLine("Clicked");
        StateHasChanged();
    }
}