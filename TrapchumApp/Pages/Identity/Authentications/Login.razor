@page "/Account/Login"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Pages.Identity.Shared
@using TrapchumApp.Services
<PageTitle>Login</PageTitle>
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout
@inject NavigationManager NavigationManager
<div class="login-box">
    <div class="logo">
        <img src="/assets/logo/tch_Logo.png" alt="Trapchum Logo" style="width: 160px;">
    </div>
    <h2 class="login-heading">Welcome Back</h2>
    <p class="login-subtitle">Sign in to your account to continue</p>
    <StatusMessage Message="@errorMessage" />
    <EditForm Model="@Input" OnValidSubmit="@LoginUser" FormName="login" method="post">
        <DataAnnotationsValidator />
        <div class="form-group">
            <label for="Input.Email">Your Email</label>
            <InputText id="Input.Email"
                       @bind-Value="@Input.Email"
                       placeholder="abc@email.com"
                       class="form-input" />
            <ValidationMessage For="() => Input.Email" />
        </div>
        <div class="form-group">
            <label for="Input.Password">Password</label>
            <InputText id="Input.Password"
                       @bind-Value="@Input.Password"
                       type="password"
                       placeholder="Enter password"
                       class="form-input" />
            <ValidationMessage For="() => Input.Password" />
        </div>
        <RadzenButton ButtonType="ButtonType.Submit"
                      Text="Sign In"
                      Icon="login"
                      ButtonStyle="ButtonStyle.Primary"
                      IsBusy="@_isBusy"
                      class="btn-login-full" />
    </EditForm>
    <div class="login-footer">
        &copy; @DateTime.Now.Year Trapchum Cash Pawn Shop
    </div>
</div>

