@page "/Account/Login"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Pages.Identity.Shared
@using TrapchumApp.Services
<PageTitle>Login</PageTitle>
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout
@inject NavigationManager NavigationManager
<div class="login-box">
    <div class="logo">
        <img src="/assets/logo/tch_Logo.png" alt="Trapchum Cash Pawn Shop Logo" style="width: 200px;">
    </div>
    <StatusMessage Message="@errorMessage" />
    <EditForm Model="@Input" OnValidSubmit="@LoginUser" FormName="login" method="post">
        <DataAnnotationsValidator />
        <RadzenFormField Text="Email Or UserName" class="@Styles.W100">
            <ChildContent>
                <RadzenTextBox class="@Styles.W100"
                               Name="Input.Email"
                               @bind-Value="@Input.Email"
                               placeholder="abc@email.com" />
            </ChildContent>
            <Helper>
                <ValidationMessage For="() => Input.Email" />
            </Helper>
        </RadzenFormField>
        <PasswordInput Value="@Input.Password"
                       @rendermode="InteractiveServer"
                       Name="Input.Password">
        </PasswordInput>
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.Start"
                     AlignItems="AlignItems.Center">
            <InputCheckbox @bind-Value="Input.RememberMe" id="RememberMe" />
            <label class="rz-ms-1" for="RememberMe">Remember me</label>
        </RadzenStack>
        <RadzenButton ButtonType="ButtonType.Submit"
                      Size="ButtonSize.Small"
                      Text="Log in"
                      class="@Styles.Mt2"
                      Icon="@IconNames.LoginUser"
                      ButtonStyle="ButtonStyle.Success" />
    </EditForm>
</div>

@code {
    bool password = true;
    void TogglePassword()
    {
        password = !password;
        Console.WriteLine("Clicked");
        StateHasChanged();
    }
}
