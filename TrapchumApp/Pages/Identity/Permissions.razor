@page "/App/Account/Permissions"
<PageTitle>Permissions</PageTitle>
<RadzenCard>
    <GridToolbar SearchChanged="@OnTextChanged">
    </GridToolbar>
    <RadzenDataGrid 
        Count="@counts"
        PageSize="@pageSize"
        ColumnWidth="10rem"
        LoadData="LoadData"
        Responsive="true"
        Density="Density.Compact"
        ShowPagingSummary="true"
                    AllowPaging="true"
                    PagerPosition="PagerPosition.Bottom"
                    PagerHorizontalAlign="HorizontalAlign.Right"
                    PageSizeChanged="@PageSizeChanged"
                    PageSizeOptions="@StorageConstant.PageSizeOptions"
        Data="@permissions">
        <Columns>
            <RadzenDataGridColumn Property="@nameof(PermissionsVm.Module)" Title="Module" />
            <RadzenDataGridColumn Property="@nameof(PermissionsVm.Action)" Title="Action" />
            <RadzenDataGridColumn Context="p" Property="@nameof(PermissionsVm.Action)" Title="Feature">
                <Template>
                    @(p.Module).@(p.Action)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="@nameof(PermissionsVm.Description)" Title="Description" />
            <RadzenDataGridColumn Width="6rem" 
                TextAlign="TextAlign.Center"
                Context="p" Property="@nameof(PermissionsVm.IsBasic)" Title="Is Basic">
                <Template>
                       <RadzenCheckBox TValue="bool?" Value="@p.IsBasic" ReadOnly />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</RadzenCard>