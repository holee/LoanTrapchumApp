@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Services
@* @page "/Administrator/Users/{Id:long}/Permissions"
@attribute [Authorize]
<Blazorise.Container Fluid>
    <Card>
        <CardHeader>
            <Strong>Manage User Permissions</Strong>
