@page "/App/Account/Profile/{UserId}/User"
@page "/profile"
@using Applications.Features.Identity.Users
@inject NavigationManager Navigation
@inject IWebHostEnvironment Env

<PageTitle>User Profile</PageTitle>

<style>
    .up-wrap {
        max-width: 820px;
        margin: 1.5rem auto;
    }

    .up-card {
        display: flex;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 6px 32px rgba(0,0,0,0.13);
        background: #fff;
        min-height: 380px;
    }

    /* ── Left panel ── */
    .up-left {
        width: 230px;
        flex-shrink: 0;
        background: linear-gradient(90deg, #25476a 100%, #1a3050 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2.5rem 1.25rem 1.75rem;
        gap: 1rem;
    }

    .up-avatar-ring {
        position: relative;
        width: 110px;
        height: 110px;
    }

    .up-avatar {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #94d1b8;
        display: block;
    }

    .up-cam-btn {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #94d1b8;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        border: 2px solid #fff;
        overflow: hidden;
    }

        .up-cam-btn i {
            font-size: 15px;
            color: #25476a;
            pointer-events: none;
        }

        .up-cam-btn input[type=file] {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }

    .up-name {
        font-size: 1.05rem;
        font-weight: 800;
        color: #fff;
        text-align: center;
        line-height: 1.3;
    }

    .up-role-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: rgba(148,209,184,0.18);
        border: 1px solid rgba(148,209,184,0.45);
        color: #94d1b8;
        border-radius: 999px;
        padding: 3px 12px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .up-left-divider {
        width: 100%;
        border: none;
        border-top: 1px solid rgba(255,255,255,0.1);
        margin: 0;
    }

    /* ── Right panel ── */
    .up-right {
        flex: 1;
        padding: 2rem 2rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .up-section-title {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #94d1b8;
        margin-bottom: 1rem;
        border-left: 3px solid #94d1b8;
        padding-left: 8px;
    }

    .up-field {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 0.65rem 0;
        border-bottom: 1px solid #f0f0f0;
    }

        .up-field:last-of-type {
            border-bottom: none;
        }

    .up-field-label {
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: #9ca3af;
    }

    .up-field-value {
        font-size: 0.93rem;
        font-weight: 600;
        color: #1e293b;
    }

    .up-actions {
        margin-top: auto;
        padding-top: 1.5rem;
        display: flex;
        gap: 0.6rem;
        justify-content: flex-end;
    }

    @@media (max-width: 600px) {
        .up-card { flex-direction: column; }
        .up-left { width: 100%; padding: 2rem 1rem 1.5rem; }
        .up-right { padding: 1.5rem 1rem; }
    }
</style>

<div class="up-wrap">
    <div class="up-card">

        <!-- ── Left: Avatar + identity ── -->
        <div class="up-left">
            <div class="up-avatar-ring">
                <img src="@(string.IsNullOrWhiteSpace(user.FileUrl) ? "assets/logo/tch_Logo.png" : user.FileUrl)"
                     alt="Avatar" class="up-avatar" />
                <EditForm Model="@UploadModel" OnValidSubmit="@ChangeProfile">
                    <FluentValidationValidator />
                    <div class="up-cam-btn" title="Change photo">
                        <i class="notranslate rzi">photo_camera</i>
                        <InputFile OnChange="HandleFileSelected" accept="image/*" />
                    </div>
                    <button type="submit" id="_submitPhotoBtn" hidden></button>
                </EditForm>
            </div>

            <div class="up-name">@user.FullName</div>

            <span class="up-role-badge">
                <i class="notranslate rzi" style="font-size:12px;">shield</i>
                @user.RoleName
            </span>

            <hr class="up-left-divider" />

            <RadzenButton Text="Save Photo"
                          Icon="@IconNames.SwitchAccount"
                          ButtonStyle="ButtonStyle.Success"
                          IsBusy="@Tracker.IsLoading"
                          BusyText="Saving..."
                          Size="ButtonSize.Small"
                          Style="width:100%;background:#94d1b8;border-color:#94d1b8;color:#25476a;font-weight:700;"
                          Click="@ChangeProfile"
                          Disabled="@(UploadModel.FileContent is null)" />
        </div>

        <!-- ── Right: Info + actions ── -->
        <div class="up-right">
            <div class="up-section-title">Account Information</div>

            <div class="up-field">
                <span class="up-field-label">Full Name</span>
                <span class="up-field-value">@(user.FullName ?? "—")</span>
            </div>
            <div class="up-field">
                <span class="up-field-label">Email Address</span>
                <span class="up-field-value">@(user.Email ?? "—")</span>
            </div>
            <div class="up-field">
                <span class="up-field-label">Branch</span>
                <span class="up-field-value">@(user.BranchName ?? "—")</span>
            </div>
            <div class="up-field">
                <span class="up-field-label">Role</span>
                <span class="up-field-value">@(user.RoleName ?? "—")</span>
            </div>

            <div class="up-actions">
                <RadzenButton Text="Change Password"
                              Click="@ChangAccountPassword"
                              Icon="@IconNames.Lock"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" />
            </div>
        </div>

    </div>
</div>

@code {
    private readonly IUserServiceImpl userService;

    public ManageUserProfile(IUserServiceImpl userService)
    {
        this.userService = userService;
    }

    [Parameter]
    public string UserId { get; set; } = string.Empty;

    UserProfileResponse user = new();
    ProfileDtoCreate UploadModel = new();

    protected override async Task OnInitializedAsync()
    {
        var rsp = await _userService.GetUserProfile(UserId);
        if (rsp.IsSuccess)
            user = rsp.Data!;

        await base.OnInitializedAsync();
    }

    async void ChangAccountPassword()
    {
        var param = new Dictionary<string, object?> { { "UserId", UserId } };
        await DialogService.OpenAsync<UserChangePassword>("Change Password", param, new DialogOptions());
    }

    const long maxFileSize = 10 * 1024 * 1024;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (e.FileCount == 0) return;

        using var stream = new MemoryStream();
        using var fileStream = e.File.OpenReadStream(maxFileSize);
        await fileStream.CopyToAsync(stream);

        UploadModel.FileName = e.File.Name;
        UploadModel.FileSize = e.File.Size;
        UploadModel.FileContent = stream.ToArray();

        var base64 = Convert.ToBase64String(UploadModel.FileContent);
        user.FileUrl = $"data:{e.File.ContentType};base64,{base64}";
    }

    async Task ChangeProfile()
    {
        if (UploadModel?.FileContent is null) return;

        Tracker.Show();
        var rsp = await userService.ChangeProfile(UserId, UploadModel);
        if (rsp.IsSuccess)
        {
            UploadModel = new();
            StateHasChanged();
        }
        Tracker.Hide();
    }
}
