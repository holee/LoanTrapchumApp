@page "/App/Account/Profile/{UserId}/User"
@page "/profile"
@using Applications.Features.Identity.Users
@using Applications.Interfaces.Identity
@inject NavigationManager Navigation
@inject IWebHostEnvironment Env
@inject IProfilePhotoService ProfilePhotoService
@inject IUserService UserService

<PageTitle>User Profile</PageTitle>

<div class="up-page">

    <section class="up-hero">
        <div class="up-avatar-ring">
            @if (string.IsNullOrWhiteSpace(user.FileUrl))
            {
                <div class="up-avatar up-avatar--initials">@Initials</div>
            }
            else
            {
                <img src="@user.FileUrl" alt="" class="up-avatar" />
            }
            <label class="up-cam" title="Change photo">
                <i class="notranslate rzi">photo_camera</i>
                <InputFile OnChange="HandleFileSelected" accept="image/*" />
            </label>
        </div>

        <div class="up-hero__meta">
            <h1 class="up-hero__name">@(user.FullName ?? "—")</h1>
            <p class="up-hero__email">@(user.Email ?? "—")</p>

            <div class="up-badges">
                @if (!string.IsNullOrWhiteSpace(user.RoleName))
                {
                    <span class="up-badge">
                        <i class="notranslate rzi">shield</i>
                        @user.RoleName
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(user.BranchName))
                {
                    <span class="up-badge up-badge--branch">
                        <i class="notranslate rzi">apartment</i>
                        @user.BranchName
                    </span>
                }
            </div>
        </div>
    </section>

    @if (_selectedFile is not null)
    {
        <div class="up-pending" role="status">
            <i class="notranslate rzi" style="color:#b45309;">info</i>
            <div class="up-pending__text">
                New photo selected — <span class="up-pending__name">@_selectedFile.Name</span>. Save to apply it.
            </div>
            <RadzenButton Text="Discard"
                          ButtonStyle="ButtonStyle.Light"
                          Size="ButtonSize.Small"
                          Click="@DiscardPhoto" />
            <RadzenButton Text="Save photo"
                          Icon="@IconNames.SwitchAccount"
                          ButtonStyle="ButtonStyle.Success"
                          IsBusy="@Tracker.IsLoading"
                          BusyText="Saving..."
                          Size="ButtonSize.Small"
                          Click="@ChangeProfile" />
        </div>
    }

    <div class="up-grid">
        <article class="up-card">
            <h2 class="up-card__title">Account information</h2>
            <p class="up-card__hint">Details shown across the system for this user.</p>

            <div class="up-rows">
                <div class="up-row">
                    <span class="up-row__icon"><i class="notranslate rzi">person</i></span>
                    <div class="up-row__body">
                        <span class="up-row__label">Full name</span>
                        <span class="up-row__value">@(user.FullName ?? "—")</span>
                    </div>
                </div>
                <div class="up-row">
                    <span class="up-row__icon"><i class="notranslate rzi">mail</i></span>
                    <div class="up-row__body">
                        <span class="up-row__label">Email address</span>
                        <span class="up-row__value">@(user.Email ?? "—")</span>
                    </div>
                </div>
                <div class="up-row">
                    <span class="up-row__icon"><i class="notranslate rzi">apartment</i></span>
                    <div class="up-row__body">
                        <span class="up-row__label">Branch</span>
                        <span class="up-row__value">@(user.BranchName ?? "—")</span>
                    </div>
                </div>
                <div class="up-row">
                    <span class="up-row__icon"><i class="notranslate rzi">badge</i></span>
                    <div class="up-row__body">
                        <span class="up-row__label">Role</span>
                        <span class="up-row__value">@(user.RoleName ?? "—")</span>
                    </div>
                </div>
            </div>
        </article>

        <article class="up-card">
            <h2 class="up-card__title">Security</h2>
            <p class="up-card__hint">Keep the account protected with a strong password.</p>

            <div class="up-security">
                <span class="up-row__icon"><i class="notranslate rzi">lock</i></span>
                <div class="up-security__body">
                    <span class="up-security__title">Password</span>
                    <span class="up-security__sub">Change the sign-in password</span>
                </div>
                <RadzenButton Text="Change"
                              Click="@ChangAccountPassword"
                              Icon="@IconNames.Lock"
                              ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" />
            </div>
        </article>
    </div>

</div>

@code {
    [Parameter]
    public string UserId { get; set; } = string.Empty;

    UserProfileResponse user = new();
    IBrowserFile? _selectedFile;

    private string Initials
    {
        get
        {
            if (string.IsNullOrWhiteSpace(user.FullName)) return "?";
            var parts = user.FullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2
                ? $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[^1][0])}"
                : char.ToUpper(parts[0][0]).ToString();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var rsp = await _userService.GetUserProfile(UserId);
        if (!rsp.IsError)
            user = rsp.Value!;

        await base.OnInitializedAsync();
    }

    async void ChangAccountPassword()
    {
        var param = new Dictionary<string, object?> { { "UserId", UserId } };
        await DialogService.OpenAsync<UserChangePassword>("Change Password", param, new DialogOptions());
    }

    const long maxFileSize = 10 * 1024 * 1024;

    private string? _persistedPhotoUrl;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (e.FileCount == 0) return;

        _selectedFile = e.File;

        _persistedPhotoUrl ??= user.FileUrl;

        using var previewStream = new MemoryStream();

        using var fileStream = e.File.OpenReadStream(maxFileSize);

        await fileStream.CopyToAsync(previewStream);

        var base64 = Convert.ToBase64String(previewStream.ToArray());

        user.FileUrl = $"data:{e.File.ContentType};base64,{base64}";
    }

    private void DiscardPhoto()
    {
        _selectedFile = null;
        user.FileUrl = _persistedPhotoUrl;
        _persistedPhotoUrl = null;
    }

    async Task ChangeProfile()
    {
        if (_selectedFile is null) return;

        // Never trust the client-supplied file name for the stored extension.
        var extension = Path.GetExtension(_selectedFile.Name).ToLowerInvariant();
        if (!AllowedImageExtensions.Contains(extension))
        {
            NotificationService.Notify(NotificationSeverity.Error, "Unsupported image type",
                "Allowed formats: JPG, PNG, GIF, WEBP.");
            return;
        }

        Tracker.Show();
        try
        {
            var newFileName = $"{Guid.NewGuid()}{extension}";
            var destinationPath = Path.Combine(Env.WebRootPath, "assets", "profiles");

            if (!Directory.Exists(destinationPath))
                Directory.CreateDirectory(destinationPath);

            using var ms = new MemoryStream();
            using var stream = _selectedFile.OpenReadStream(maxFileSize);
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            var fullPath = Path.Combine(destinationPath, newFileName);
            await File.WriteAllBytesAsync(fullPath, bytes);

            var fileUrl = $"/assets/profiles/{newFileName}";
            var fileModel = new Domains.Models.Files.FileModel(_selectedFile.Name, newFileName, _selectedFile.Size, bytes)
            {
                FileUrl = fileUrl
            };

            var result = await UserService.ChangeProfile(UserId, fileModel);

            if (!result.IsError)
            {
                user.FileUrl = fileUrl;

                ProfilePhotoService.NotifyPhotoChanged(UserId, fileUrl);

                _selectedFile = null;
                _persistedPhotoUrl = null;

                StateHasChanged();
            }
        }
        finally
        {
            Tracker.Hide();
        }
    }

    private static readonly string[] AllowedImageExtensions = [".jpg", ".jpeg", ".png", ".gif", ".webp"];

    private sealed record UploadResult(string FileUrl);
}
