@page "/App/Account/{Id}/Users"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Services
<PageTitle>User Management</PageTitle>
<div class="rz-background-color-base-200">
    <RadzenTabs class="rz-background-color-base-100" RenderMode="TabRenderMode.Client">
        <Tabs>
            <RadzenTabsItem Text="User Information" Icon="info">
                <RadzenRow AlignItems="AlignItems.Center" class="rz-p-1">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Name</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenText Text="@userModel?.UserName" TagName="TagName.Span" TextStyle="TextStyle.Subtitle2" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="rz-p-1">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Email</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenText Text="@userModel?.Email" TagName="TagName.Span" TextStyle="TextStyle.Subtitle2" />
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="rz-p-1">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Role</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenText Text="@userModel?.Role" TagName="TagName.Span" TextStyle="TextStyle.Subtitle2" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Change Password" Icon="password">
                <EditForm Model="model" OnValidSubmit="@SubmitOnValid">
                    <FluentValidationValidator DisableAssemblyScanning="true"></FluentValidationValidator>
                    <ValidationSummary />
                    <input type="hidden" @bind="model.UserId" />
                    <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-2">
                        <RadzenColumn SizeMD="2">Current Password</RadzenColumn>
                        <RadzenColumn SizeMD="4">
                            <RadzenPassword placeholder="Current Password"
                                            @bind-Value="model.CurrentPassword"
                                            class="rz-w-100"></RadzenPassword>
                            <ValidationMessage For="() => model.CurrentPassword" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-2">
                        <RadzenColumn SizeMD="2">New Password</RadzenColumn>
                        <RadzenColumn SizeMD="4">
                            <RadzenPassword placeholder="New Password"
                                            @bind-Value="model.NewPassword" class="rz-w-100"></RadzenPassword>
                            <ValidationMessage For="() => model.NewPassword" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-2">
                        <RadzenColumn SizeMD="2">Confirm Password</RadzenColumn>
                        <RadzenColumn SizeMD="4">
                            <RadzenPassword placeholder="Confirm Password"
                                            @bind-Value="model.ConfirmPassword" class="rz-w-100"></RadzenPassword>
                            <ValidationMessage For="() => model.ConfirmPassword" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-2">
                        <RadzenColumn SizeMD="6">
                            <RadzenStack AlignItems="AlignItems.Center"
                                         Orientation="Orientation.Horizontal"
                                         class="rz-mt-2"
                                         JustifyContent="JustifyContent.End">
                                <RadzenButton Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Success"
                                              ButtonType="ButtonType.Submit"
                                              Text="Changed"
                                              Icon="save">
                                </RadzenButton>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </EditForm>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Change Role" Icon="person">
                <EditForm Model="formRequest" OnValidSubmit="HandleSubmitOnValid">
                    <FluentValidationValidator DisableAssemblyScanning="true"></FluentValidationValidator>
                    <ValidationSummary />
                    <input type="hidden" @bind="model.UserId" />
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn SizeMD="2">Current Role</RadzenColumn>
                        <RadzenColumn SizeMD="4">
                            <RadzenText TagName="TagName.P">
                                @userModel.Role
                            </RadzenText>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn SizeMD="2">Select New Role</RadzenColumn>
                        <RadzenColumn SizeMD="4">
                            <RadzenDropDown TValue="string"
                                            class="w-100"
                                            @bind-Value="formRequest.RoleName"
                                            Data="@roles">
                            </RadzenDropDown>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn SizeMD="6">
                            <RadzenStack AlignItems="AlignItems.Center"
                                         Orientation="Orientation.Horizontal"
                                         class="mt-2"
                                         JustifyContent="JustifyContent.End">
                                <RadzenButton Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Primary"
                                              ButtonType="ButtonType.Submit"
                                              Text="Update"
                                              Icon="save">
                                </RadzenButton>
                            </RadzenStack>
                        </RadzenColumn>
                    </RadzenRow>
                </EditForm>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Permissions" Icon="admin_panel_settings">
                <RadzenDataGrid Data="userPermission!.Permissions"
                                GridLines="DataGridGridLines.Horizontal"
                                AllowSorting="false"
                                AllowAlternatingRows="true"
                                ColumnWidth="15rem"
                                IsLoading="IsLoading"
                                Style="height:30rem;"
                                Density="Density.Compact">
                    <Columns>
                        <RadzenDataGridColumn Width="6rem"
                                              Property="@(nameof(UserPermissionViewModel.Group))"
                                              Title="Group" />
                        <RadzenDataGridColumn Property="@(nameof(UserPermissionViewModel.ClaimType))"
                                              Title="Type" />
                        <RadzenDataGridColumn Property="@(nameof(UserPermissionViewModel.ClaimValue))"
                                              Title="Value" />
                        <RadzenDataGridColumn Context="c"
                                              Width="5rem"
                                              TextAlign="TextAlign.Center"
                                              Property="@(nameof(UserPermissionViewModel.UserId))"
                                              Title="Assigned">
                            <Template>
                                <RadzenCheckBox @bind-Value="c.IsAssignedToRole"></RadzenCheckBox>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
                <RadzenStack JustifyContent="JustifyContent.End"
                             AlignItems="AlignItems.Center"
                             class="my-2"
                             Orientation="Orientation.Horizontal">
                    <RadzenButton Icon="save"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small"
                                  Click="AddUserPermissions"
                                  IsBusy="isBusy"
                                  Text="Save"></RadzenButton>
                </RadzenStack>
            </RadzenTabsItem>

        </Tabs>
    </RadzenTabs>
    <RadzenStack JustifyContent="JustifyContent.End"
                 AlignItems="AlignItems.Center"
                 class="rz-mt-3"
                 Orientation="Orientation.Horizontal">
        <RadzenLink Icon="arrow_back"
                    Path="/App/Account/Users"
                    Text="Back"></RadzenLink>
    </RadzenStack>
</div>