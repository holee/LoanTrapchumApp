@page "/Administrator/Users/{Id:long}/Roles"
@using TrapchumApp.Services
@attribute [Authorize(Roles = "SuperAdmin,Admin")]
<div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <strong>Manage User Roles</strong>
        </div>
        <div class="card-body">
            <EditForm Model="userRoles" @ref="editForm">
                <RadzenRow AlignItems="AlignItems.Center">
                    @foreach (var x in userRoles ?? Enumerable.Empty<UserRolesViewModel>())
                    {
                        <RadzenColumn>
                            <RadzenStack AlignItems="AlignItems.Center">
                                <input type="hidden" @bind="x.RoleId" />
                                <input type="hidden" @bind="x.RoleName" />
                                <div class="rz-p-12 rz-text-align-center">
                                    <RadzenCheckBox TValue="bool"
                                                    Name="CheckBox1"
                                                    @bind-Value="x.IsSelected" />
                                    <RadzenLabel Text="@x.RoleName"
                                                 Component="CheckBox1"
                                                 Style="margin-left: 8px; vertical-align: middle;" />
                                </div>

                            </RadzenStack>
                        </RadzenColumn>
                    }
                </RadzenRow>
            </EditForm>
        </div>
        <div class="card-footer">
            <RadzenButton ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small" Click="SubmitOnValid">Change</RadzenButton>
            <RadzenLink Path="/Administrator/Users" Text="Back" Icon="back" />
        </div>
    </div>
</div>