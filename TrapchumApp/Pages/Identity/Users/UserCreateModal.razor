@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Branches.Dtos
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.Entities
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Services
<EditForm Model="_model" @ref="_form">
    <FluentValidationValidator DisableAssemblyScanning="true" />
    <RadzenStack Gap="0.5rem;" Orientation="Orientation.Vertical">
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="3">Branch</RadzenColumn>
            <RadzenColumn Size="9">
                <RadzenDropDown @bind-Value="_model.BranchRefId"
                                Data="@_branches"
                                Style="width: 100%;"
                                TextProperty="@(nameof(BranchDto.BranchName))"
                                @bind-Value:after="SelectBranchChanged"
                                ValueProperty="@(nameof(BranchDto.BranchId))"
                                Disabled="@_showBranch"
                                Name="DropDownBindValue" />
                <ValidationMessage For="@(()=>_model.BranchRefId)" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="3">Employee</RadzenColumn>
            <RadzenColumn Size="9">
                <RadzenDropDown @bind-Value="_model.EmployeeId"
                                Data="_bEmployees"
                                Style="width: 100%;"
                                TextProperty="AltName"
                                @bind-Value:after="SelectedEmployeeChanged"
                                AllowFiltering="true"
                                ValueProperty="EmployeeId"
                                Disabled="@_showEmployee"
                                Name="DropDownEmployee" />
                <ValidationMessage For="@(()=>_model.EmployeeId)" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="3">User Name</RadzenColumn>
            <RadzenColumn Size="9">
                <RadzenTextBox @bind-Value="_model.Username" class="rz-w-100" />
                <ValidationMessage For="@(()=>_model.Username)" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="3">Email</RadzenColumn>
            <RadzenColumn Size="9">
                <RadzenTextBox type="email" @bind-Value="_model.Email" class="rz-w-100" />
                <ValidationMessage For="@(()=>_model.Email)" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="3">Role</RadzenColumn>
            <RadzenColumn Size="9">
                <RadzenDropDown @bind-Value="_model.RoleName"
                                Data="_roles"
                                Style="width: 100%;"
                                Name="DropDownRoleName" />
                <ValidationMessage For="@(()=>_model.RoleName)" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="3">Password</RadzenColumn>
            <RadzenColumn Size="9">
                <RadzenPassword Style="width:100%;"
                                @bind-Value="_model.Password" />
                <ValidationMessage For="@(()=>_model.Password)" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="3">Confirm Password</RadzenColumn>
            <RadzenColumn Size="9">
                <RadzenPassword Style="width:100%;"
                                @bind-Value="_model.ConfirmPassword" />
                <ValidationMessage For="@(()=>_model.ConfirmPassword)" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenStack>
    <RadzenStack AlignItems="AlignItems.Center"
                 Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 class="rz-my-3">
        <RadzenButton ButtonStyle="ButtonStyle.Success"
                      Click="SubmitForm"
                      Icon="save"
                      Text="Save"
                      Size="ButtonSize.Small" />
        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                      Icon="close"
                      Text="Cancel"
                      Click="@(()=>DialogService.Close(false))"
                      Size="ButtonSize.Small" />
    </RadzenStack>
</EditForm>

