@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Services
<EditForm Model="model" OnValidSubmit="@SubmitOnValid">
    <FluentValidationValidator DisableAssemblyScanning="true" />
    <input type="hidden" @bind="model.UserId" />
    <RadzenRow class="rz-mt-2">
        <RadzenColumn Size="3">Current Password</RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenPassword placeholder="Current Password"
                            @bind-Value="model.CurrentPassword"
                            class="rz-w-100"></RadzenPassword>
            <ValidationMessage For="() => model.CurrentPassword" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mt-2">
        <RadzenColumn Size="3">New Password</RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenPassword Placeholder="New Password"
                            @bind-Value="model.NewPassword" class="rz-w-100"></RadzenPassword>
            <ValidationMessage For="() => model.NewPassword" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-mt-2">
        <RadzenColumn Size="3">Confirm Password</RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenPassword Placeholder="Confirm Password"
                            @bind-Value="model.ConfirmPassword"
                            class="rz-w-100"></RadzenPassword>
            <ValidationMessage For="() => model.ConfirmPassword" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenStack AlignItems="AlignItems.Center"
                 Orientation="Orientation.Horizontal" class="rz-mt-4"
                 JustifyContent="JustifyContent.End">
        <RadzenButton Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Success"
                      ButtonType="ButtonType.Submit"
                      Text="Changed"
                      Icon="@IconNames.Save">
        </RadzenButton>
        <RadzenButton Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Danger"
                      Click="@(arg=>DialogService.Close(false))"
                      Text="Cancel"
                      Icon="@IconNames.Close">
        </RadzenButton>
    </RadzenStack>
</EditForm>

