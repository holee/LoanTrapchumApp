@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="ep-container">
    <div class="ep-card">

        <span class="material-icons ep-icon">report_problem</span>

        <h2 class="ep-title">Unexpected Error</h2>
        <p class="ep-subtitle">
            An error occurred while processing your request.<br />
            Please try again or contact your administrator.
        </p>

        @if (ShowRequestId)
        {
            <div class="ep-request-id">
                <strong>Request ID:</strong> <code>@RequestId</code>
            </div>
        }

        <div class="ep-actions">
            <a class="ep-btn ep-btn-primary" href="/">
                <span class="material-icons">home</span> Return to Home
            </a>
            <a class="ep-btn ep-btn-outline" href="javascript:history.back()">
                <span class="material-icons">arrow_back</span> Go Back
            </a>
        </div>

    </div>
</div>

<style>
    .ep-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 70vh;
        padding: 2rem;
    }

    .ep-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 3rem 2.5rem;
        max-width: 460px;
        width: 100%;
        text-align: center;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
    }

    .ep-icon {
        font-size: 56px;
        color: #ef4444;
        margin-bottom: 1rem;
        display: block;
    }

    .ep-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 0.5rem;
    }

    .ep-subtitle {
        font-size: 0.9rem;
        color: #6b7280;
        line-height: 1.6;
        margin: 0 0 1.5rem;
    }

    .ep-request-id {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 0.55rem 1rem;
        font-size: 0.82rem;
        color: #374151;
        margin-bottom: 1.5rem;
        word-break: break-all;
    }

    .ep-request-id code {
        color: #dc2626;
        font-family: 'Consolas', monospace;
    }

    .ep-actions {
        display: flex;
        gap: 0.75rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .ep-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 0.5rem 1.25rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        border: none;
        transition: opacity 0.15s;
    }

    .ep-btn .material-icons { font-size: 16px; }
    .ep-btn:hover { opacity: 0.85; }

    .ep-btn-primary {
        background: #16a34a;
        color: #fff;
    }

    .ep-btn-outline {
        background: transparent;
        color: #374151;
        border: 1px solid #d1d5db;
    }
</style>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
