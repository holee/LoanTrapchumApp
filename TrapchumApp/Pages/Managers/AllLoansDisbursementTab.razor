@using Applications.Features.Loans.Dtos.Responses
<PageTitle>All Loans</PageTitle>
<GridToolbar SearchChanged="@TextLoanSearchChanged">
    <LeftChildren>
        <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal">
            <RadzenText TagName="TagName.Span" Text="Filter By:" TextStyle="TextStyle.Body2" />
            <RadzenFormField Text="From">
                <RadzenDatePicker TValue="DateTime?"
                                  Change="@DateFromChanged"
                                  DateFormat="dd/MM/yyyy" @bind-Value="@_from" />
            </RadzenFormField>
            <RadzenFormField Text="To">
                <RadzenDatePicker TValue="DateTime?"
                                  Change="@DateToChanged"
                                  DateFormat="dd/MM/yyyy" @bind-Value="@_to" />
            </RadzenFormField>
        </RadzenStack>
    </LeftChildren>
    <RightChildren>
        <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal">
            <RadzenCheckBox TValue="bool"
                            @bind-Value="includeInactive"
                            @bind-Value:after="CheckedIncludeChanged"
                            Name="IncludeInactive" />
            <RadzenLabel Text="Include Inactive"
                         Component="IncludeInactive" class="rz-ms-2" />
        </RadzenStack>
    </RightChildren>
</GridToolbar>

@code {

    [Parameter]
    public VLoanDisbursments? Data { get; set; }
    [CascadingParameter]
    Task<AuthenticationState> AuthState { get; set; } = default!;
    [Parameter]
    public EventCallback<VLoanDisbursments> OpenDetailTab { get; set; }

    private string _getPaymentSchedulesUrl = "";
    private string _getSchedulePayOffUrl = "";
    private string _getChangeCreditAgentUrl = "";
    private string _getLoanDetailsUrl = "";
    private string _getLoanWriteOffUrl = "";
    private string _loanPayOffUrl = "";
    private string _loanCollateralWidthrawUrl = "";

    void GetLoanDetails(VLoanDisbursments? p)
    {
        ContextMenuService.Close();

        if (p is null) return;

        _getLoanDetailsUrl = $"/App/Loan/{p.LoanId}/Branches/{p.BranchId}/Currencies/{p.CurrencyId}";

        NavigationManager.NavigateTo(_getLoanDetailsUrl);
    }

    void GetPaymentSchedules(VLoanDisbursments? p)
    {
        ContextMenuService.Close();

        if (p is null) return;

        _getPaymentSchedulesUrl = $"/App/Loans/{p.BranchId}/Branches/{p.LoanId}/Schedules?CreditAgentId={p.CreditAgentRefId}&CurrencyId={p.CurrencyId}";

        NavigationManager.NavigateTo(_getPaymentSchedulesUrl);
    }

    void ChangeCreditAgent()
    {
        ContextMenuService.Close();

        NavigationManager.NavigateTo($"/App/Loan/{Data!.LoanId}/CreditAgent/{Data.CreditAgentRefId}?CustomerId={Data.CustomerId}&BranchId={Data.BranchId}&CurrencyId={Data.CurrencyId}");
    }
    void CustomerPayOff()
    {
        ContextMenuService.Close();

        NavigationManager.NavigateTo($"/Loan/CreditAgent/{Data!.LoanId}/{Data.CreditAgentRefId}?CustomerId={Data.CustomerId}&BranchId={Data.BranchId}&CurrencyId={Data.CurrencyId}");
    }

    async Task DownLoadScheduleAsExcel(VLoanDisbursments? p)
    {
        ContextMenuService.Close();

        if (p is not null)
        {
            if (p.LoanId.IsNotNullOrEmpty() && p.BranchId > 0)
            {
                await js.InvokeVoidAsync("open", $"/Reports/Schedules/{p.LoanId}/{p.BranchId}/Exel", "_blank");
            }
        }
    }
    private async Task DownLoadScheduleAsPdf(VLoanDisbursments? p)
    {
        ContextMenuService.Close();

        if (p is not null)
        {
            var fileName = $"Loan_Schedule_{Guid.CreateVersion7()}.pdf";

            if (p.LoanId.IsNotNullOrEmpty() && p.BranchId > 0)
            {
                await js.InvokeVoidAsync("open", $"/Reports/Schedules/{p.LoanId}/{p.BranchId}/{fileName}", "_blank");
            }
        }
    }


    void ShowContextMenuWithContent(MouseEventArgs args, VLoanDisbursments p)
    {

        _getSchedulePayOffUrl = $"/Loan/CreditAgent/{p.LoanId}/{p.CreditAgentRefId}?CustomerId={p.CustomerId}&BranchId={p.BranchId}&CurrencyId={p.CurrencyId}";

        _getPaymentSchedulesUrl = $"/App/Loans/{p.BranchId}/Branches/{p.LoanId}/Schedules?CreditAgentId={p.CreditAgentRefId}&CurrencyId={p.CurrencyId}";

        _getLoanDetailsUrl = $"/App/Loan/{p.LoanId}/Branches/{p.BranchId}/Currencies/{p.CurrencyId}";

        _getChangeCreditAgentUrl = $"App/Loans/Disbursments/Credit-Agent/{p.BranchId}/Branches?CreditAgentId={p.CreditAgentRefId}";

        _loanPayOffUrl = $"/App/Loan/{p.LoanId}/Branches/{p.BranchId}/loan-payoff?currencyId={p.CurrencyId}";

        _loanCollateralWidthrawUrl = $"/App/Loans/{p.LoanId}/WidthrwalCollateral/{p.BranchId}/Branches";

        ContextMenuService.Open(args, ds => @<RadzenMenu Style="font-size:0.8rem;">
            <RadzenMenuItem Icon="money"
                            Path="@_getPaymentSchedulesUrl"
                            Visible="@bState.CanRecievePayment"
                            Text="Recieve Payment"></RadzenMenuItem>
            <RadzenMenuItem Icon="paid"
                            Path="@_getSchedulePayOffUrl"
                            Visible="@bState.CanPayOff"
                            Text="Pay Off"></RadzenMenuItem>
            <RadzenMenuItem Icon="paid"
                            Path="@_getLoanWriteOffUrl"
                            Visible="@bState.CanWriteOff"
                            Text="Write Off"></RadzenMenuItem>
            <RadzenMenuItem Icon="money"
                            Path="@_loanPayOffUrl"
                            Visible="@bState.CanPayOff"
                            Text="Pay Off"></RadzenMenuItem>
            <RadzenMenuItem Icon="change_circle"
                            Path="@_getChangeCreditAgentUrl"
                            Visible="@bState.IsManager"
                            Text="Change Credit Agent"></RadzenMenuItem>
            <RadzenMenuItem Icon="info"
                            Path="@_getLoanDetailsUrl"
                            Text="Schedule Details"></RadzenMenuItem>
            <RadzenMenuItem Icon="info"
                            Path="@_loanCollateralWidthrawUrl"
                            Text="Widtraw Collaterals"></RadzenMenuItem>
            <RadzenMenuItem Icon="file_download"
                            Click="@(()=>DownLoadScheduleAsExcel(p))"
                            Text="Export Loan to Excel" />
            <RadzenMenuItem Icon="picture_as_pdf"
                            Click="@(()=>DownLoadScheduleAsPdf(p))"
                            Text="Export Loan to Pdf" />
        </RadzenMenu>
    );


    }

    void OnRowSelected(VLoanDisbursments arg)
    {

    }

    void OnRowRender(RowRenderEventArgs<VLoanDisbursments> arg)
    {

        if (arg.Data is null) return;

        arg.Data.RowIndex = arg.Index + 1;
    }

    void ContextMenuClick(DataGridCellMouseEventArgs<VLoanDisbursments> args)
    {

        if (args.Data is null) return;

        ContextMenuService.Open(args, new List<ContextMenuItem>
        {
            new ContextMenuItem { Text = "Recieve Payment", Value="1",Icon="money_bag",Disabled=!bState.CanRecievePayment},
            new ContextMenuItem { Text = "Schedule Detials", Value="2",Icon="info"},
            new ContextMenuItem { Text = "Pay Off", Value="7",Icon="money",Disabled=!bState.CanPayOff},
            new ContextMenuItem { Text = "Change Credit Agent", Value="5",Icon="find_replace",Disabled=!bState.IsManager},
            new ContextMenuItem { Text = "Pre Paid", Value="6",Icon="money",Disabled=!bState.CanRecievePayment},
            new ContextMenuItem { Text = "Widthraw Collaterals", Value="8",Icon="remove"},
            new ContextMenuItem { Text = "Export As Excel", Value="3", Icon="file_download"},
            new ContextMenuItem { Text = "Export As Pdf", Value="4", Icon="picture_as_pdf"},
        }, (e) => DoContextMenuAction(e, args.Data));
    }

    void DoContextMenuAction(MenuItemEventArgs e, VLoanDisbursments? data)
    {
        ContextMenuService.Close();

        if (e.Value is null) return;

        if (data is null) return;

        _loanCollateralWidthrawUrl = $"/App/Loans/{data.LoanId}/WidthrwalCollateral/{data.BranchId}/Branches";

        switch (e.Value)
        {
            case "1":
                GetPaymentSchedules(data);
                break;
            case "2":
                GetLoanDetails(data);
                break;
            case "3":
                _ = DownLoadScheduleAsExcel(data);
                break;
            case "4":
                _ = DownLoadScheduleAsPdf(data);
                break;
            case "6":
                NavigationManager.NavigateTo($"App/Loans/{data.LoanId}/Branches/{data.BranchId}/Payments?CreditAgentId={data.CreditAgentRefId}");
                break;
            case "7":
                NavigationManager.NavigateTo($"/App/Loans/{data.LoanId}/Branches/{data.BranchId}/loan-payoff?currencyId={data.CurrencyId}");
                break;
            case "8":
                NavigationManager.NavigateTo(_loanCollateralWidthrawUrl);
                break;
            default:
                NavigationManager.NavigateTo($"App/Loans/Disbursments/Credit-Agent/{data.BranchId}/Branches?CreditAgentId={data.CreditAgentRefId}");
                break;
        }
    }

   
}

