@page "/App/Loans/Managers/Requests/{BranchId:int}/Branches"
@using TrapchumApp.Pages.Transactions.LoanRequests
<PageTitle>Loan Request</PageTitle>
@attribute [MustHasPermission(Resources.LoanRequest, Actions.Read)]
<GridToolbar SearchChanged="@FilterTextChanged"
             @bind-Value="@filtertext"
             Placeholder="Type something to search........">
</GridToolbar>
<RadzenCard>
    <RadzenTabs SelectedIndexChanged="SelectedIndexChanged" RenderMode="TabRenderMode.Server">
        <Tabs>
            <RadzenTabsItem Icon="list" Text="All">
                <LoanRequestAllTab OnSearchChanged="@FilterTextChanged" SearchText="@filtertext" />
            </RadzenTabsItem>
            @foreach (var item in _tabs)
            {
                <RadzenTabsItem Icon="@item.Icon" Text="@item.Title" @key="@item.Key">
                    <Template>
                        <CloseTabButton Title="@item.Title"
                                        Closed="(() => CloseTab(item.Key))" />
                    </Template>
                    <ChildContent>
                        @item.Content
                    </ChildContent>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
</RadzenCard>

@code {

    private List<CustomTab> _tabs = [];

    private int _selectedIndex = 0;

    void CloseTab(string tabId)
    {
        var tabIndex = _tabs.FirstOrDefault(t => t.Key == tabId);

        if (tabIndex is not null)
        {
            _tabs.Remove(tabIndex);

            _selectedIndex = _tabs.Count;
        }
    }


}
