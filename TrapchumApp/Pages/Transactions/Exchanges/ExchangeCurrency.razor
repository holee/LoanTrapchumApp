    <HeaderTemplate>
        <RadzenStack Gap="0.25rem" Orientation="Orientation.Horizontal">
            <RadzenIcon Icon="@IconNames.AccountBalanceWallet"/>
            <strong>Exchange History</strong>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <ExchangeHistory BranchId="@BranchId"/>
    </ChildContent>
</RadzenFieldset>
