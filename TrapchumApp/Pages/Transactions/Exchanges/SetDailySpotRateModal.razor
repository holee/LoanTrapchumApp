@using Applications.Responses.ViewModels.Currencies
@using TrapchumApp.Services
<div class="container-fluid">
     <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12">
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="3">
                    <RadzenText TagName="TagName.H4">Plese Select Date To Set Spot Rate</RadzenText>
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenDatePicker 
                            TValue="DateTime" 
                            Size="Blazorise.Size.Small" 
                            Max="@DateTime.Now"
                            @bind-Date:format="yyyy-MMM-dd"
                            @bind-Date="reqDate"
                            Placeholder="Search Here....." />
                </RadzenColumn>
                 <RadzenColumn Size="2">
                 <a href="https://www.nbc.gov.kh/english/economic_research/exchange_rate.php" target="_blank">NBC Exchange Rate</a>
                </RadzenColumn>
            </RadzenRow>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center">
         <EditForm Model="model">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Currency Name</th>
                            <th>Currency Code</th>
                            <th class="text-end">Spot Rate</th>
                            <th class="text-end">Buying Rate</th>
                            <th class="text-end">Selling Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Currencies ?? Enumerable.Empty<VCurrenciesList>())
                        {
                            var index = Currencies?.ToList().IndexOf(item);
                           <tr>
                               <td>@(index + 1)</td>
                               <td>
                                   <input type="hidden" @bind="item.CurrencyId" />
                                   @item.CurrencyName
                               </td>
                               <td>@item.CurrencyCode</td>
                                <td>
                                   <RadzenNumeric 
                                       Disabled="@(item.IsBaseCurrency?true:false)"
                                     TextAlign="TextAlign.End"
                                       @bind-Value="item.SpotRate"
                                       TValue="decimal?"  />
                               </td>
                               <td>
                                   <RadzenNumeric 
                                       Disabled="@(item.IsBaseCurrency?true:false)"
                                       ShowUpDown="false"
                                       @bind-Value="item.BuyingRate"
                                        TextAlign="TextAlign.End"
                                       TValue="decimal?"  />
                               </td>
                               <td>
                                   <RadzenNumeric 
                                       Disabled="@(item.IsBaseCurrency?true:false)"
                                       ShowUpDown="false"
                                       @bind-Value="item.SellingRate"
                                        TextAlign="TextAlign.End"
                                       TValue="decimal?" 
                                       />
                               </td>
                      
                           </tr>
                        }
                    </tbody>
                </Table>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                     <RadzenButton  Icon="save"
                                    Text="Set Spot Rate" 
                                    ButtonStyle="ButtonStyle.Success"
                                    Click="SetSpotRate" 
                                    Size="ButtonSize.Small" />
                </RadzenStack>
            </div>
         </EditForm>
    </RadzenRow>
</div>
