@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Applications.Responses.ViewModels.Currencies
@using TrapchumApp.Services
<PageTitle>Currency Exchange</PageTitle>
<GridToolbar ShowSearchBox="false">
    <LeftChildren>
        <RadzenButton Size="ButtonSize.Small"
                      Click="ShowCurrencyDialogue"
                      Icon="@IconNames.AddNew"
                      Text="Exchange" ButtonStyle="@AppValue.AddNew" />
    </LeftChildren>
    <RightChildren>
        <RadzenFormField AllowFloatingLabel="false" class="rz-mb-2">
            <Start>
                <RadzenIcon Icon="search" />
            </Start>
            <ChildContent>
                <RadzenDatePicker DateFormat="@AppValue.DefaultDateFormat"
                                  TValue="DateTime?"
                                  CurrentDateChanged="@CurrentDateChanged"
                                  @bind-Value="transactionDate" />
            </ChildContent>
        </RadzenFormField>
    </RightChildren>
</GridToolbar>
<RadzenDataGrid Density="Density.Compact"
                AllowAlternatingRows="true"
                AllowPaging="true"
                TItem="VttCurrencyExchanges"
                Count="@counts"
                PageSize="@pageSize"
                GridLines="DataGridGridLines.Both"
                IsLoading="@isLoading"
                Responsive="true"
                PageSizeChanged="@PageSizeChange"
                PageSizeOptions="@StorageConstant.PageSizeOptions"
                ShowPagingSummary="true"
                PagerHorizontalAlign="HorizontalAlign.Right"
                PagerPosition="PagerPosition.Bottom"
                LoadData="@LoadData"
                Data="ExchangeHostories">
    <Columns>
        <RadzenDataGridColumn Property="@nameof(VttCurrencyExchanges.TransactionDate)"
                              Title="Transaction Date"
                              Context="c">
            <Template>
                @c.TransactionDate.DayFirst()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VttCurrencyExchanges.TransactionTypeName)"
                              Title="TransactionType Name" Context="c" />
        <RadzenDataGridColumn Property="@nameof(VttCurrencyExchanges.BranchName)"
                              Title="Branch" Context="c" />
        <RadzenDataGridColumn Property="@nameof(VttCurrencyExchanges.ExchangeRate)"
                              TextAlign="TextAlign.Right"
                              Title="Exchange Rate" Context="c" />
        <RadzenDataGridColumn Property="@nameof(VttCurrencyExchanges.BuyCurrencyName)"
                              Title="Buy Currency Name" Context="c" />
        <RadzenDataGridColumn Property="@nameof(VttCurrencyExchanges.BuyAmount)"
                              TextAlign="TextAlign.Right"
                              Title="Buy Amount" Context="c">
            <Template>
                @c.BuyAmount.Format(c.BuyCurrencyRefId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@nameof(VttCurrencyExchanges.SellCurrencyName)"
                              Title="Sell Currency Name" Context="c" />
        <RadzenDataGridColumn Property="@nameof(VttCurrencyExchanges.SellAmount)"
                              TextAlign="TextAlign.Right"
                              Title="Sell Amount" Context="c">
            <Template>
                @c.SellAmount.Format(c.SellCurrencyRefId)
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenStack Gap="0.5rem" JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center">
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Value="100" ShowValue="false" />
            <RadzenText TagName="TagName.Span">Loading...</RadzenText>
        </RadzenStack>
    </LoadingTemplate>
</RadzenDataGrid>

