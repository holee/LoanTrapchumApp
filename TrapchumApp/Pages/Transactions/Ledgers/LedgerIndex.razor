@page "/App/Account/Ledgers/{BranchId:int}/Branches"
@using Applications.Responses.ViewModels.Ledgers
<PageTitle>Chart of Accounts</PageTitle>

<div class="ledger-page">
    <div class="ledger-header">
        <h3 class="ledger-title">Chart of Accounts</h3>
        <RadzenButton Click="DisplayModal"
                      ButtonStyle="ButtonStyle.Success"
                      Shade="Shade.Dark"
                      Icon="add"
                      Text="New"
                      Size="ButtonSize.Small" />
    </div>

    <div class="ledger-toolbar">
        <div class="toolbar-left">
            <RadzenDropDown TValue="int"
                            Data="StorageConstant.Currencies"
                            TextProperty="@nameof(Items.Label)"
                            ValueProperty="@nameof(Items.Value)"
                            @bind-Value="currencyId"
                            Placeholder="All currencies"
                            Style="min-width: 180px;"
                            @bind-Value:after="SelectedCurrencyChanged" />
            <div class="toolbar-toggle">
                <RadzenCheckBox TValue="bool"
                                Name="IncludeInactive"
                                @bind-Value:after="OnIncludeInActive"
                                @bind-Value="includeInactive" />
                <RadzenLabel Text="Include inactive" Component="IncludeInactive" class="rz-ms-1" Style="font-size: 0.85rem;" />
            </div>
        </div>
        <div class="toolbar-right">
            <GridToolbar SearchChanged="OnFilters" ShowSearchBox="true" />
        </div>
    </div>

    <RadzenDataGrid Data="Ledgers"
                    Density="Density.Compact"
                    AllowAlternatingRows="false"
                    AllowPaging="true"
                    ShowPagingSummary="true"
                    Count="@counts"
                    PageSize="pageSize"
                    LoadData="@LoadData"
                    AllowSorting="true"
                    AllowMultiColumnSorting="false"
                    IsLoading="isLoading"
                    PagerHorizontalAlign="HorizontalAlign.Right"
                    PageSizeOptions="@StorageConstant.PageSizeOptions"
                    PageSizeChanged="ChangedPageSize"
                    GridLines="DataGridGridLines.Both"
                    class="ledger-grid">
        <Columns>
            <RadzenDataGridColumn Property="LedgerCode"
                                  Title="CODE"
                                  Width="7rem"
                                  Sortable="true" />
            <RadzenDataGridColumn Property="LedgerName"
                                  Title="NAME"
                                  Context="g"
                                  Sortable="true">
                <Template>
                    @if (g.ParentRefId > 0)
                    {
                        <span class="ledger-child-indent">@g.LedgerName</span>
                    }
                    else
                    {
                        <span class="ledger-parent-name">@g.LedgerName</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="LedgerTypeCode"
                                  Title="TYPE"
                                  Width="10rem"
                                  Sortable="true" />
            <RadzenDataGridColumn Property="CurrencyCode"
                                  Width="10rem"
                                  Title="CURRENCY"
                                  Sortable="true" />
            <RadzenDataGridColumn Title="MAIN"
                                  Width="4rem"
                                  TextAlign="TextAlign.Center"
                                  Sortable="false"
                                  Context="emp">
                <Template>
                    <RadzenCheckBox TValue="bool?"
                                    Disabled Value="@emp.IsMainGl" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="c"
                                  Title="ACTIVE"
                                  Width="6rem"
                                  TextAlign="TextAlign.Center"
                                  Sortable="false">
                <Template>
                    <RadzenCheckBox TValue="bool?"
                                    @bind-Value="c.IsActive"
                                    Change="@((arg) => OnCheckChanged(arg, c.LedgerId))" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="6rem"
                                  Title="ACTIONS"
                                  TextAlign="TextAlign.Center"
                                  Context="c"
                                  Sortable="false">
                <Template>
                    <RadzenButton Size="ButtonSize.ExtraSmall"
                                  Icon="more_vert"
                                  Variant="Variant.Text"
                                  Click="@(args => ShowContextMenu(args, c))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {

    async Task ChangedPageSize(int page)
    {
        pageSize = page;
        pageIndex = 0;
        await LoadLedgerPageList(searchField);
    }

    void ShowContextMenu(MouseEventArgs args, VLedger ledger)
    {
        ContextMenuService.Open(args, ds =>
            @<RadzenMenu Style="font-size:0.8rem;">
                <RadzenMenuItem Icon="info"
                                Click="@(() => LedgerDetails(ledger.LedgerId))"
                                Text="Details" />
                <RadzenMenuItem Icon="edit"
                                Click="@(() => Edit(ledger.LedgerId))"
                                Text="Edit" />
                <RadzenMenuItem Icon="delete"
                                Click="@(() => OnDelete(ledger.LedgerId))"
                                Text="Delete" />
            </RadzenMenu>
        );
    }

}