@using Applications.Features.LoanRequests.Interfaces
<EditForm Model="model" @ref="editForm">
    <FluentValidationValidator DisableAssemblyScanning="true" />
    <RadzenRow AlignItems="AlignItems.Start" class="rz-mb-2">
        <RadzenColumn Size="10">
            <RadzenFormField Text="Ledger Type" AllowFloatingLabel="true" class="@Styles.W100">
                <ChildContent>
                    <RadzenDropDownDataGrid Data="LedgerTypes"
                                            AllowColumnResize="true"
                                            @bind-Value="model.LedgerTypeRefId"
                                            TextProperty="LedgerTypeCode"
                                            ValueProperty="LedgerTypeId"
                                            Density="Density.Compact"
                                            class="w-100"
                                            ShowSearch="false"
                                            PageSize="10"
                                            ShowPagingSummary="true"
                                            Placeholder="Ledger Type">
                        <Columns>
                            <RadzenDropDownDataGridColumn Property="LedgerTypeCode"
                                                          Title="LedgerType"
                                                          Sortable="false"
                                                          Width="200px" />
                        </Columns>
                    </RadzenDropDownDataGrid>
                </ChildContent>
                <Helper>
                    <ValidationMessage For="@(() => model.LedgerTypeRefId)" />
                </Helper>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="2">
            <input type="hidden" @bind-value="model.LedgerId" />
            <div class="rz-text-center rz-mt-4">
                <RadzenCheckBox @bind-Value="model.IsActive" TValue="bool" />
                Is Active
            </div>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
        <RadzenColumn Size="12">
            <RadzenFormField Text="Number #" AllowFloatingLabel="true" class="@Styles.W100">
                <ChildContent>
                    <RadzenTextBox @bind-Value="model.LedgerCode"
                                   class="@Styles.W100"
                                   Placeholder="Reference Number..." />
                </ChildContent>
                <Helper>
                    <ValidationMessage For="@(() => model.LedgerCode)" />
                </Helper>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    @* if ledger type is cash and balance *@
    <RadzenRow AlignItems="AlignItems.Start" class="rz-mb-2">
        @if (model.LedgerTypeRefId == 1)
        {
            <RadzenColumn Size="9">
                <RadzenFormField Text="Bank #" AllowFloatingLabel="true" class="@Styles.W100">
                    <ChildContent>
                        <RadzenTextBox class="w-100" @bind-Value="model.BankNumber" Name="BankNumber" />
                    </ChildContent>
                    <Helper>
                        <ValidationMessage For="() => model.BankNumber" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenFormField Text="Currency">
                    <ChildContent>
                        <RadzenDropDown @bind-Value="model.CurrencyRefId"
                                        TextProperty="CurrencyCode"
                                        class="w-100"
                                        ValueProperty="CurrencyId"
                                        SelectedItemChanged="CurrencySelectedChanged"
                                        Data="@Currencies">
                        </RadzenDropDown>
                    </ChildContent>
                    <Helper>
                        <ValidationMessage For="@(() => model.CurrencyRefId)" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
        }
        else
        {
            <RadzenColumn Size="12">
                <RadzenFormField Text="Currency" AllowFloatingLabel="true" class="@Styles.W100">
                    <ChildContent>
                        <RadzenDropDown @bind-Value="model.CurrencyRefId"
                                        TextProperty="CurrencyCode"
                                        ValueProperty="CurrencyId"
                                        class="w-75"
                                        SelectedItemChanged="CurrencySelectedChanged"
                                        Data="Currencies">
                        </RadzenDropDown>
                    </ChildContent>
                    <Helper>
                        <ValidationMessage For="@(() => model.CurrencyRefId)" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
        }
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Start" RowGap="0" class="rz-mb-2">
        <RadzenColumn Size="12">
            <RadzenFormField Text="Ledger Name" AllowFloatingLabel="true" class="@Styles.W100">
                <ChildContent>
                    <RadzenTextBox @bind-Value="model.LedgerName"
                                   class="form-control"
                                   Placeholder="Ledger Name" />
                </ChildContent>
                <End>
                    <div class="rz-text-center rz-background-color-base-100 rz-p-1 rz-m-0">
                        <RadzenCheckBox @bind-Value="model.IsMainGl"
                                        Change="SelectCheckedChanged"
                                        TValue="bool" />
                        Is Main GL
                    </div>
                </End>
                <Helper>
                    <ValidationMessage For="@(() => model.LedgerName)" />
                </Helper>
            </RadzenFormField>
        </RadzenColumn>
        <RadzenColumn Size="12" Visible="!model.IsMainGl" class="rz-mt-2">
            <RadzenFormField Text="Ledger Name" class="@Styles.W100" AllowFloatingLabel="true">
                <Start>
                    <div class="rz-text-center rz-background-color-base-100 rz-p-1 rz-m-0">
                        <RadzenCheckBox TValue="bool"
                                        Change="SubTypeChanged"
                                        @bind-Value="model.IsSubTypeOf" />
                        Sub Type Of
                    </div>
                </Start>
                <ChildContent>
                    <RadzenDropDownDataGrid Data="FilterLedgers"
                                            AllowColumnResize="true"
                                            @bind-Value="model.ParentRefId"
                                            TextProperty="LedgerName"
                                            ValueProperty="LedgerId"
                                            Disabled="!model.IsSubTypeOf"
                                            Density="Density.Compact"
                                            class="@Styles.W100"
                                            ShowSearch="false"
                                            PageSize="10"
                                            LoadData="LoadDataTextChanged"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                        <Columns>
                            <RadzenDropDownDataGridColumn Property="LedgerName"
                                                          Sortable="false"
                                                          Title="Ledger Name" />
                            <RadzenDropDownDataGridColumn Property="LedgerTypeCode"
                                                          Sortable="false"
                                                          Title="LedgerType"
                                                          Width="200px" />
                        </Columns>
                    </RadzenDropDownDataGrid>
                </ChildContent>
                <Helper>
                    <ValidationMessage For="@(() => model.IsSubTypeOf)" />
                    <ValidationMessage For="@(() => model.ParentRefId)" />
                </Helper>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>

    @*  end  if not main GL *@
    <RadzenRow AlignItems="AlignItems.Center" RowGap="1rem" class="rz-mb-2">
        <RadzenColumn Size="12">
            <TTextArea Label="Description" @bind-Text="model.Description" IsFloatLabel="true" />
        </RadzenColumn>
    </RadzenRow>
    <input type="hidden" @bind="@tempIsSubTypeOf" />
    <input type="hidden" @bind="@tempParentRefIdId" />
    <input type="hidden" @bind="@tempCurrencyId" />
</EditForm>
<RadzenStack Orientation="Orientation.Horizontal"
             AlignItems="AlignItems.Center"
             Gap="1rem"
             class="rz-mt-2"
             JustifyContent="JustifyContent.End">
    <RadzenButton ButtonStyle="ButtonStyle.Success"
                  Click="FormValidSubmit"
                  Text="Save"
                  Icon="save"
                  Size="ButtonSize.Small" />
    <RadzenButton ButtonStyle="ButtonStyle.Danger"
                  Icon="cancel"
                  Text="Cancel"
                  Click="@(() => Close())" Size="ButtonSize.Small" />
</RadzenStack>

