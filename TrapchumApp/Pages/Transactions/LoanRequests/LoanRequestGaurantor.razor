@using Applications.Responses.ViewModels.Loans.Requests

<style>
    .guarantor-grid .rz-column-title,
    .guarantor-grid .rz-sortable-column .rz-column-title,
    .guarantor-grid .kh-header {
        font-family: kh_siemreap, "Khmer OS Siemreap", sans-serif;
    }

    .guarantor-grid .kh-header {
        font-size: 0.85rem;
    }
</style>

<div class="guarantor-card rz-shadow-3" style="border-radius:0.75rem;overflow:hidden;background:var(--rz-base-200);">

    <RadzenStack Style="padding:0.6rem 1rem;background:var(--rz-primary);color:#fff;"
                 JustifyContent="JustifyContent.SpaceBetween"
                 Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
            <RadzenIcon Icon="group" Style="font-size:1.2rem;" />
            <RadzenText TextStyle="TextStyle.Subtitle1"
                        Style="margin:0;font-weight:600;color:#fff;">
                Guarantors Information
            </RadzenText>
            @if (Guarantors?.Any() == true)
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Light"
                             Text="@($"{Guarantors.Count()} item{(Guarantors.Count() == 1 ? "" : "s")}")"
                             Style="font-size:0.7rem;" />
            }
        </RadzenStack>
        <RadzenStack AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.End"
                     Orientation="Orientation.Horizontal" Gap="0.4rem">
            @if (ShowAdd && ShowCommand)
            {
                <RadzenButton Text="Add"
                              Icon="person_add"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Outlined"
                              Size="ButtonSize.Small"
                              Click="@ClickedAdd"
                              ButtonType="ButtonType.Button"
                              Style="color:#fff;border-color:rgba(255,255,255,0.6);font-size:0.8rem;" />
            }
        </RadzenStack>
    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 Gap="0.5rem">
        @if (ShowCommand && SearchBoxTemplate is not null)
        {
            <div style="min-width:12rem;">@SearchBoxTemplate</div>
        }
    </RadzenStack>

    <div style="padding:0.5rem 0.75rem 0.75rem;">

        <RadzenDataGrid Data="Guarantors"
                        GridLines="DataGridGridLines.Both"
                        Responsive
                        TItem="VLoanRequestGuarantor"
                        Density="Density.Compact"
                        @ref="gridGuarantors"
                        PagerHorizontalAlign="HorizontalAlign.Right"
                        EmptyText="No guarantors added yet."
                        RowRender="@OnRowRender"
                        class="guarantor-grid"
                        Style="min-height:14rem;height:14rem;max-height:14rem;border-radius:0.5rem;overflow:hidden;">
            <Columns>
                <RadzenDataGridColumn Context="g"
                                      Property="@(nameof(VLoanRequestGuarantor.GuarantorId))"
                                      Width="3rem"
                                      Title="#"
                                      Sortable="false"
                                      TextAlign="TextAlign.Center">
                    <HeaderTemplate>
                        <span class="kh-header">#</span>
                    </HeaderTemplate>
                    <Template>
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@g.RowIndex.ToString()" Style="font-size:0.7rem;padding:0.1rem 0.4rem;" />
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="16rem"
                                      Property="@(nameof(VLoanRequestGuarantor.GuarantorName))"
                                      Title="ឈ្មោះ"
                                      Sortable="false">
                    <HeaderTemplate>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenIcon Icon="person" Style="font-size:0.85rem;color:var(--rz-primary);" />
                            <span class="kh-header">ឈ្មោះ</span>
                        </RadzenStack>
                    </HeaderTemplate>
                    <Template Context="g">
                        <div class="guarantor-name-cell">
                            <div class="guarantor-avatar">
                                @(string.IsNullOrWhiteSpace(g.FullName) ? "?" : g.FullName.Trim()[0].ToString().ToUpper())
                            </div>
                            <span style="font-weight:500;font-size:.85rem;">@g.GuarantorName</span>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="10rem"
                                      Property="@(nameof(VLoanRequestGuarantor.Phone))"
                                      Title="លេខទូរស័ព្ទ"
                                      Sortable="false">
                    <HeaderTemplate>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenIcon Icon="phone" Style="font-size:0.85rem;color:var(--rz-primary);" />
                            <span class="kh-header">លេខទូរស័ព្ទ</span>
                        </RadzenStack>
                    </HeaderTemplate>
                    <Template Context="g">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenIcon Icon="phone" Style="font-size:.85rem;color:var(--rz-text-tertiary-color);" />
                            <span style="font-size:.82rem;">@g.Phone</span>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Context="g" Title="អាសយដ្ឋាន" Sortable="false">
                    <HeaderTemplate>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenIcon Icon="location_on" Style="font-size:0.85rem;color:var(--rz-primary);" />
                            <span class="kh-header">អាសយដ្ឋាន</span>
                        </RadzenStack>
                    </HeaderTemplate>
                    <Template>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenIcon Icon="location_on" Style="font-size:.85rem;color:var(--rz-text-tertiary-color);" />
                            <span style="font-size:.82rem;">@g.Address</span>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>

                @if (ShowRemove)
                {
                    <RadzenDataGridColumn Context="g"
                                          TextAlign="TextAlign.Center"
                                          Width="4.5rem"
                                          Title="សកម្មភាព"
                                          Sortable="false">
                        <HeaderTemplate>
                            <span class="kh-header" style="font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;">សកម្មភាព</span>
                        </HeaderTemplate>
                        <Template>
                            <RadzenButton Icon="delete_outline"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Shade="Shade.Lighter"
                                          Click="@(() => ClickedRemove(g))"
                                          Size="ButtonSize.ExtraSmall"
                                          Variant="Variant.Outlined"
                                          Style="border-radius:6px;" />
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {

    [Parameter] public RenderFragment? SearchBoxTemplate { get; set; }

    private void OnRowRender(RowRenderEventArgs<VLoanRequestGuarantor> args)
    {
        if (args.Data is null) return;

        args.Data.RowIndex = args.Index + 1;

    }
}