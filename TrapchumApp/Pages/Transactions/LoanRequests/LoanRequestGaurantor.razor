@using Applications.Responses.ViewModels.Loans.Requests

<div class="guarantor-card">
    <div class="guarantor-card-header">
        <span class="header-title">
            <RadzenIcon Icon="group" Style="font-size:1.2rem;" />
            Guarantors Information
            @if (Guarantors?.Any() == true)
            {
                <span class="badge-count">@Guarantors.Count()</span>
            }
        </span>
        @if (ShowAdd && ShowCommand)
        {
            <RadzenButton Text="Add Guarantor"
                          Icon="person_add"
                          Click="@ClickedAdd"
                          Size="ButtonSize.Small"
                          ButtonType="ButtonType.Button"
                          Variant="Variant.Outlined"
                          Style="color:#fff;border-color:rgba(255,255,255,.55);font-weight:500;" />
        }
    </div>

    <div class="guarantor-card-body">
        @if (SearchBoxTemplate is not null)
        {
            <div class="guarantor-toolbar">
                <div class="search-slot">
                    @SearchBoxTemplate
                </div>
            </div>
        }

        <RadzenDataGrid Data="Guarantors"
                        GridLines="DataGridGridLines.Horizontal"
                        TItem="VLoanRequestGuarantor"
                        Density="Density.Compact"
                        @ref="gridGuarantors"
                        PagerHorizontalAlign="HorizontalAlign.Right"
                        EmptyText="No guarantors added yet."
                        RowRender="@OnRowRender"
                        Style="min-height:14rem;height:14rem;max-height:14rem;border-radius:8px;overflow:hidden;">
            <Columns>
                <RadzenDataGridColumn Context="g"
                                      Property="@(nameof(VLoanRequestGuarantor.GuarantorId))"
                                      Width="3rem"
                                      Title="#"
                                      Sortable="false"
                                      TextAlign="TextAlign.Center">
                    <HeaderTemplate>
                        <span style="color:var(--rz-text-tertiary-color);font-size:.75rem;">#</span>
                    </HeaderTemplate>
                    <Template>
                        <span style="color:var(--rz-text-tertiary-color);font-size:.8rem;">@g.RowIndex</span>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="16rem"
                                      Property="@(nameof(VLoanRequestGuarantor.GuarantorName))"
                                      Title="Name"
                                      Sortable="false">
                    <HeaderTemplate>
                        <span style="font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;">Name</span>
                    </HeaderTemplate>
                    <Template Context="g">
                        <div class="guarantor-name-cell">
                            <div class="guarantor-avatar">
                                @(string.IsNullOrWhiteSpace(g.FullName) ? "?" : g.FullName.Trim()[0].ToString().ToUpper())
                            </div>
                            <span style="font-weight:500;font-size:.85rem;">@g.GuarantorName</span>
                        </div>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Width="10rem"
                                      Property="@(nameof(VLoanRequestGuarantor.Phone))"
                                      Title="Phone"
                                      Sortable="false">
                    <HeaderTemplate>
                        <span style="font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;">Phone</span>
                    </HeaderTemplate>
                    <Template Context="g">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenIcon Icon="phone" Style="font-size:.85rem;color:var(--rz-text-tertiary-color);" />
                            <span style="font-size:.82rem;">@g.Phone</span>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Context="g" Title="Address" Sortable="false">
                    <HeaderTemplate>
                        <span style="font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;">Address</span>
                    </HeaderTemplate>
                    <Template>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenIcon Icon="location_on" Style="font-size:.85rem;color:var(--rz-text-tertiary-color);" />
                            <span style="font-size:.82rem;">@g.Address</span>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>

                @if (ShowRemove)
                {
                    <RadzenDataGridColumn Context="g"
                                          TextAlign="TextAlign.Center"
                                          Width="4.5rem"
                                          Title="Action"
                                          Sortable="false">
                        <HeaderTemplate>
                            <span style="font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;">Action</span>
                        </HeaderTemplate>
                        <Template>
                            <RadzenButton Icon="delete_outline"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Shade="Shade.Lighter"
                                          Click="@(() => ClickedRemove(g))"
                                          Size="ButtonSize.ExtraSmall"
                                          Variant="Variant.Outlined"
                                          Style="border-radius:6px;" />
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {

    [Parameter] public RenderFragment? SearchBoxTemplate { get; set; }

    private void OnRowRender(RowRenderEventArgs<VLoanRequestGuarantor> args)
    {
        if (args.Data is null) return;

        args.Data.RowIndex = args.Index + 1;

    }
}