@using Applications.Responses.ViewModels.Loans.Requests
<RadzenFieldset>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
            <RadzenIcon Icon="attachment" /><b>Documents</b>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.End"
                     Visible="@ShowCommand"
                     class="rz-mb-2"
                     AlignItems="AlignItems.Center">
            <RadzenButton Text="Upload"
                          Size="ButtonSize.Small"
                          Icon="upload"
                          Click="@ClickUpload"
                          Visible="@(ShowUpload && ShowCommand)"
                          class="rz-mt-0" />
        </RadzenStack>
        <RadzenDataGrid Data="Documents"
                        GridLines="DataGridGridLines.Both"
                        TItem="VLoanRequestsDocuments"
                        Density="Density.Compact"
                        @ref="@gridDocuments"
                        PagerHorizontalAlign="HorizontalAlign.Right"
                        Style="min-height:15rem;height:15rem;max-height:15rem;">
            <Columns>
                <RadzenDataGridColumn Context="g"
                                      Property="@(nameof(VLoanRequestsDocuments.Id))"
                                      Width="3rem"
                                      Title="#"
                                      Sortable="false">
                    <Template>
                        <input type="hidden" @bind="g.Id" />
                        @(Documents.IndexOf(g) + 1)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="g"
                                      Width="15rem"
                                      Title="File Title"
                                      Property="@(nameof(VLoanRequestsDocuments.OriginalName))" />
                <RadzenDataGridColumn Width="25rem"
                                      Property="@(nameof(VLoanRequestsDocuments.NewFileName))"
                                      Title="Name"
                                      Context="d"
                                      Sortable="false">
                    <Template>
                        <RadzenLink Target="_blank" Path="@d.FileUrl">@d.NewFileName</RadzenLink>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="g" Title="Size" 
                    TextAlign="TextAlign.Right"
                        Property="@(nameof(VLoanRequestsDocuments.FileSize))" />
                <RadzenDataGridColumn Context="g" Title="Description" Property="@(nameof(VLoanRequestsDocuments.Description))" />
                @if (ShowDelete)
                {
                    <RadzenDataGridColumn Context="g" TextAlign="TextAlign.Center"
                                          Width="4rem" Property="OriginalName"
                                          Title="Action">
                        <Template>
                            <RadzenButton Icon="delete"
                                          Shade="Shade.Lighter"
                                          Click="@(()=>DeleteDocument(g))"
                                          Size="ButtonSize.ExtraSmall"
                                          Variant="Variant.Outlined" />
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    </ChildContent>
</RadzenFieldset>
@code {

    [Parameter, EditorRequired] public List<VLoanRequestsDocuments> Documents { get; set; } = [];
    [Parameter] public bool ShowUpload { get; set; } = true;
    [Parameter] public bool ShowCommand { get; set; } = true;
    [Parameter] public EventCallback<VLoanRequestsDocuments> RemoveDocument { get; set; }
    [Parameter] public EventCallback UploadDocument { get; set; }
    [Parameter] public bool ShowDelete { get; set; } = false;
    RadzenDataGrid<VLoanRequestsDocuments> gridDocuments = default!;
    public async void ReloadDocument()
    {
        await gridDocuments.Reload();
    }
    async Task DeleteDocument(VLoanRequestsDocuments e)
    {
        await RemoveDocument.InvokeAsync(e);

    }
    async Task ClickUpload()
    {
        await UploadDocument.InvokeAsync();
    }

}
