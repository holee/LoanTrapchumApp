@page "/App/Loans/Requests/{BranchId:int}/Branches/CreateNew"
@page "/App/Loans/Requests/{BranchId:int}/Branches/CreateNew/{CustomerId}/Customers"
@using Applications.Features.Collaterals.Dtos
@using TrapchumApp.Components.Actionbars
@attribute [MustHasPermission(Modules.LoanRequest, Actions.Create)]
<PageTitle>Create New</PageTitle>
<EditForm Model="model" @ref="editForm">
    <Blazilla.FluentValidator />
    <input type="hidden" @bind="model.CreditAgentRefId" />
    <RadzenCard class="rz-px-2 rz-shadow-2 rz-border-radius-2 rz-overflow-hidden">
        <RadzenSteps SelectedIndex="@selectedTabIndex"
                     Change="@SelectTabIndexChanged"
                     Transition="StepsTransition.Fade"
                     Style="background:var(--rz-light);"
                     class="loan-steps">
            <Steps>
                <RadzenStepsItem Text="សំណើរ" Icon="@IconNames.RequestQuote">
                    <RadzenCard class="rz-shadow-0 rz-mt-2 rz-background-color-base-200">
                        <LoanRequestInfo CustomerId="@CustomerId" BranchId="@BranchId" Model="@model" />
                    </RadzenCard>
                    <RadzenCard class="rz-shadow-0 rz-mt-4">
                        <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
                            <RadzenColumn Size="12">
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-base-600 rz-mb-2">
                                    Add notes or comments for this loan request
                                </RadzenText>
                                <RadzenTextArea Rows="3"
                                                @bind-Value="model.Memo"
                                                Placeholder="Enter notes here..."
                                                Style="resize:none;"
                                                class="@Styles.W100" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenCard>
                </RadzenStepsItem>
                <RadzenStepsItem Text="អ្នករួមខ្ខី" Icon="@IconNames.Group">
                    <CoRequestCustomerBox Customers="@CoCustomers"
                                          ShowCommand="true"
                                          ShowAdd="true"
                                          @ref="CoCustomerRef"
                                          Remove="@RemoveCoCustomer"
                                          Add="@AddCoCustomer"
                                          ShowRemove="true">
                        <SearchBoxTemplate>
                            <CoRequestSearchList OnSelected="OnSelectedCoCustomer"
                                                 OnSelecteds="OnSelectedCoCustomers" />
                        </SearchBoxTemplate>
                    </CoRequestCustomerBox>

                </RadzenStepsItem>
                <RadzenStepsItem Text="ទ្រព្យសម្បត្តិបញ្ចាំ" Icon="@IconNames.Collaterals">
                    <LoanRequestCollaterals CustomerId="CustomerId"
                                            ShowCommand="true"
                                            ShowAdd="true"
                                            ShowRemove="true"
                                            @ref="CollateralRef"
                                            Add="@AddCollaterals"
                                            RemoveCollateral="RemovedCollateral"
                                            Collaterals="@requestCollateralLines">
                        <SearchBoxTemplate>
                            <CollateralSearchList CustomerId="@CustomerId"
                                                  SelectedItems="requestCollateralLines.MapToVCollateralLines()"
                                                  MultipleSelected="MultipleSelected"
                                                  SingleSelected="SingleSelected" />
                        </SearchBoxTemplate>
                    </LoanRequestCollaterals>
                </RadzenStepsItem>
                <RadzenStepsItem Text="អ្នកធានា" Icon="@IconNames.Group">
                    <LoanRequestGaurantor Guarantors="Guarantors"
                                          ShowAdd="true"
                                          Add="AddGuarantors"
                                          ShowRemove="true"
                                          ShowCommand="true"
                                          @key="@Guid.NewGuid().ToString("N")"
                                          Remove="RemoveGuarantor"
                                          @ref="GuarantorRef">
                        <SearchBoxTemplate>
                            <GuarantorSearchList OnSelected="SelectedGuarantors"
                                                 @key="@Guid.NewGuid().ToString("N")"
                                                 SelectMany="SelectMany" />
                        </SearchBoxTemplate>
                    </LoanRequestGaurantor>
                </RadzenStepsItem>

                <RadzenStepsItem Text="ឯកសារភ្ជាប់" Icon="@IconNames.AttachFile">
                    <LoanRequestDocument Documents="@Documents"
                                         UploadDocument="@HandleFileDialogue"
                                         RemoveDocument="@RemoveFile"
                                         @ref="DocumentRef"
                                         @key="@Guid.NewGuid().ToString("N")"
                                         ShowDelete="true" />
                </RadzenStepsItem>

                <RadzenStepsItem Text="អតិថិជន" Icon="@IconNames.Customers">
                    <CustomerRequest CustomerId="@CustomerId"
                                     ShowAdditionalInfo="true"
                                     @key="@Guid.NewGuid().ToString("N")" />
                </RadzenStepsItem>
            </Steps>
        </RadzenSteps>
    </RadzenCard>

    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 AlignItems="AlignItems.Center"
                 Gap="0.5rem"
                 class="action-bar rz-mt-2 rz-p-3 rz-border-radius-2">
        <RadzenButton Size="@Styles.DefaultSize"
                      Click="@HandleCreateNew"
                      Text="Save"
                      Icon="@IconNames.Save"
                      ButtonStyle="ButtonStyle.Primary" />
        <RadzenButton Size="@Styles.DefaultSize"
                      Click="HandleCreateRequest"
                      Text="Request Now"
                      Icon="@IconNames.RequestQuote"
                      ButtonStyle="ButtonStyle.Success" />
        <RadzenLink Path="@_navService.PreviousUrl"
                    Icon="@IconNames.ArrowCircleLeft"
                    IconColor="@Colors.Danger"
                    Text="Back" />
    </RadzenStack>
</EditForm>

