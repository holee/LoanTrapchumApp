@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Pages.Transactions.Exchanges
@using TrapchumApp.Pages.Transactions.Loans.Disbursements
@using TrapchumApp.Pages.Transactions.Loans.Repayments
<PageTitle>Loan Repayment</PageTitle>
<LoanInfos BranchId="@BranchId"
           LoanId="@LoanId"
           Currency="@CurrencyId"
           @key="@(Guid.NewGuid().ToString())">
    <ChildContent>
        <RadzenButton Text="Exchange"
                      Visible="@_isPaymentTab"
                      Size="ButtonSize.ExtraSmall"
                      Icon="@IconNames.CurrencyExchange"
                      Click="@ToggleExchangeChanged"
                      ButtonStyle="ButtonStyle.Secondary" />
    </ChildContent>
</LoanInfos>
<RadzenFieldset class="rz-m-0 rz-background-color-base-200">
    <div class="m-0 p-0 rz-background-color-base-200">
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.End"
                     class="rz-mb-2"
                     AlignItems="AlignItems.Center">
            <RadzenFormField AllowFloatingLabel="true" Text="Date">
                <ChildContent>
                    <RadzenDatePicker @bind-Value="paymentDate" TValue="DateTime" disabled />
                </ChildContent>
            </RadzenFormField>
        </RadzenStack>
        <RadzenDataGrid TItem="VSchedule"
                        Data="@schedules"
                        Responsive
                        Density="Density.Compact"
                        SelectionMode="@gridSelectionMode"
                        GridLines="DataGridGridLines.Both"
                        @bind-Value="@_selectedSchedules"
                        RowSelect="SelectedRowEvt"
                        RowDeselect="DeSelectedRowEvt"
                        AllowRowSelectOnRowClick="@allowRowSelected"
                        CellContextMenu="@OnCellContextMenu"
                        IsLoading="isLoading"
                        @ref="gridSchedule">
            <Columns>
                <RadzenDataGridColumn Width="3.5rem"
                                      TextAlign="TextAlign.Center"
                                      OrderIndex="0"
                                      Sortable="false"
                                      Context="s"
                                      Visible="isAllowMultiplePayment"
                                      Filterable="false">
                    <Template>
                        <RadzenCheckBox TabIndex="-1"
                                        TriState="false"
                                        Value="@(_selectedSchedules!.Any() && _selectedSchedules!.Contains(s))"
                                        Change="@(arg=>CheckedChanged(arg,s))"
                                        InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select item" }})"
                                        TValue="bool" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="c"
                                      Width="3rem"
                                      Title="#"
                                      OrderIndex="1"
                                      TextAlign="TextAlign.Center"
                                      Sortable="false">
                    <Template>
                        <input type="hidden" @bind="c.LoanId" />
                        @c.InstallmentNo
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Width="12rem"
                                      Context="c"
                                      Title="ថ្ងៃត្រូវបង់ប្រាក់"
                                      Sortable="false">
                    <Template>
                        <small>
                            <strong>@c.PaymentDate.DayFirst()</strong>-<small>@c.PaymentDate.DayName()</small>
                        </small>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Width="5rem"
                                      Context="c"
                                      TextAlign="TextAlign.Right"
                                      Title="ចំនួនថ្ងៃយឺត"
                                      Sortable="false">
                    <Template>
                        <small>
                            @c.DayArrea
                        </small>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                      Context="c"
                                      Title="ប្រាក់ដើមត្រូវបង់" Sortable="false">
                    <Template>
                        @c.LeftPrinciple.Format(CurrencyId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TextAlign="TextAlign.End"
                                      Context="c"
                                      Title="ការប្រាក់ត្រូវបង់" Sortable="false">
                    <Template>
                        @c.LeftInterestAmount.Format(CurrencyId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                      Title="ប្រាក់ប្រសិទ្ធិភាពត្រូវបង់"
                                      Context="c"
                                      Sortable="false">
                    <Template>
                        @c.LeftCollectionFeeAmount.Format(CurrencyId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                      Title="ប្រាក់ពីន័យ"
                                      Context="c"
                                      Sortable="false">
                    <Template>
                        @c.PenaltyAmount.Format(CurrencyId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                      Property="TotalPay"
                                      Title="សរុបប្រាក់ត្រូវបង់"
                                      Context="c"
                                      Sortable="false">
                    <Template>
                        @c.LeftAmount.Format(CurrencyId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                      Context="c"
                                      Property="LoanOutstanding"
                                      Title="ប្រាក់ដើមនៅសល់"
                                      Sortable="false">
                    <Template>
                        @c.LoanOutstanding.Format(CurrencyId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TextAlign="TextAlign.Center"
                                      Title="ស្ថានភាព"
                                      Sortable="false"
                                      Width="8rem"
                                      Context="s">
                    <Template>
                        @s.ScheduleStatus
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
    @if (!isAllowMultiplePayment)
    {
        <div class="rz-m-0 rz-py-2 rz-background-color-base-200">
            <RadzenFieldset Text="តារាងសងប្រាក់">
                <PaymentScedule SelectedSchedule="@SelectedSchedule" />
            </RadzenFieldset>
            <RadzenFieldset Text="Customer's Payment" class="rz-mt-2">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">
                        <RadzenFormField Text="ប្រាក់ដើម">
                            <Start>
                                <RadzenCheckBox TValue="bool"
                                                Name="PaidNow"
                                                Disabled="disableIsPaidNow"
                                                Change="@CheckPaymentChanged"
                                                Value="@isPaidNow" />
                            </Start>
                            <ChildContent>
                                <RadzenNumeric TextAlign="TextAlign.End"
                                               TValue="decimal?"
                                               ShowUpDown="false"
                                               class="rz-w-auto"
                                               Format="#,##0.00"
                                               onclick="this.querySelector('.rz-numeric-input').select()"
                                               Disabled="!isPaidNow"
                                               Min="0"
                                               Max="@SelectedSchedule?.LeftPrinciple"
                                               @oninput="PrincipleAmountValueChanged"
                                               @bind-Value="_loanPaymentLine!.PaidPrinciple">
                                </RadzenNumeric>
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenFormField Text="ការប្រាក់">
                            <RadzenNumeric TextAlign="TextAlign.End"
                                           TValue="decimal?"
                                           Disabled="!isPaidNow"
                                           Format="#,##0.00"
                                           class="rz-w-auto"
                                           Min="0"
                                           Max="@SelectedSchedule?.LeftInterestAmount"
                                           onclick="this.querySelector('.rz-numeric-input').select()"
                                           ShowUpDown="false"
                                           @oninput="InterestAmountValueChanged"
                                           @bind-Value="_loanPaymentLine!.PaidInterest">
                            </RadzenNumeric>
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenFormField Text="ប្រាក់ប្រសិទ្ធិភាព">
                            <RadzenNumeric TextAlign="TextAlign.End"
                                           TValue="decimal?"
                                           Disabled="!isPaidNow"
                                           class="rz-w-auto"
                                           Format="#,##0.00"
                                           Min="0"
                                           onclick="this.querySelector('.rz-numeric-input').select()"
                                           @bind-Value="_loanPaymentLine!.PaidCollectionFee"
                                           @oninput="CollectionFeeAmountValueChanged"
                                           Max="@SelectedSchedule?.LeftCollectionFeeAmount"
                                           ShowUpDown="false" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenFormField Text="ប្រាក់ពិន័យ">
                            <RadzenNumeric TextAlign="TextAlign.End"
                                           TValue="decimal?"
                                           Format="#,##0.00"
                                           class="rz-w-auto"
                                           Min="0"
                                           onclick="this.querySelector('.rz-numeric-input').select()"
                                           @bind-Value="_loanPaymentLine!.PaidPenaltyAmount"
                                           Disabled="!isPaidNow"
                                           Max="@SelectedSchedule?.PenaltyAmount"
                                           ShowUpDown="false" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow class="rz-mt-2" AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3" Offset="6">
                        <RadzenFormField Text="Reciept No">
                            <RadzenTextBox @bind-Value="@_loanPaymentLine.OfficialReceiptNo"
                                           class="rz-w-100" />
                        </RadzenFormField>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenFormField Text="Total">
                            <ChildContent>
                                <RadzenNumeric Value="@_loanPaymentLine?.TotalWithPenalty"
                                               ShowUpDown="false"
                                               Format="#,##0.00"
                                               class="rz-m-0 rz-p-0"
                                               Disabled />
                            </ChildContent>
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>
            @if (isAllowMultiplePayment)
            {
                <RadzenFieldset Text="ព័ត‌៌មានទូទាត់ប្រាក់" class="rz-mt-2">
                    <PaymentLines @ref="@paymentLinesRef"
                                  Remove="@OnRemoveAdded"
                                  LoanRepaymentLines="LoanPaymentLines" />
                </RadzenFieldset>

            }
        </div>
    }
    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 class="rz-mt-3"
                 Gap="1rem"
                 AlignItems="AlignItems.Center">
        <AuthorizeView Policy="@Policies.MultiplePayment">
            <Authorized>
                <RadzenButton Icon="@IconNames.Paid"
                              Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Primary"
                              Click="ApplyMultipleSchedulePayment"
                              Visible="isAllowMultiplePayment"
                              Text="ApplySchedulePayment" />
            </Authorized>
        </AuthorizeView>
        <RadzenButton Icon="save"
                      Size="ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Success"
                      Click="@ApplySchedulePayment"
                      Visible="!isAllowMultiplePayment"
                      Text="Applied Payment" />
        <RadzenButton Icon="save"
                      Size="ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Danger"
                      Click="@CloseOpenTab"
                      Text="Close" />
    </RadzenStack>
</RadzenFieldset>

@code {

    private bool SetDisabled(VSchedule schedule)
    {
        return (IsAlreadyPaidSchedule(schedule) || !IsFirstScheduleSelected(schedule));
    }

    private bool IsAlreadyPaidSchedule(VSchedule p)
    {
        if (p.IsPaid)
        {
            NotificationService.Notify(NotificationSeverity.Error, "This schedule is already paid.");

            return true;
        }

        return false;
    }

    private bool IsFirstScheduleSelected(VSchedule p)
    {
        var schedulesList = schedules?.ToList();

        var firstSchedule = schedulesList?.First(x => x.IsPaid == false);

        if (p != firstSchedule)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Cannot add new schedule due to previouse schedule not complete paid yet.");

            return false;
        }

        return true;
    }


    void OnCellContextMenu(DataGridCellMouseEventArgs<VSchedule> args)
    {

        if (args == null || args.Data == null)
            return;

        ContextMenuService.Open(args,
            new List<ContextMenuItem> {
                new ContextMenuItem()
                    {
                      Text = "Recieve Payment",
                      Value = 1,
                      Icon = "paid",
                      Disabled=SetDisabled(args.Data)
                    },
                new ContextMenuItem(){
                    Text = "Show Details",
                    Value = 2,
                    Icon = "details"
                },
            },
            (e) =>
            {
                ContextMenuService.Close();

                var selected = (int)e?.Value!;

                if (selected == 1)
                {
                    _ = PayBySchedules(args.Data);
                }
                else if (selected == 2)
                {
                    _ = ShowScheduleDetails(args.Data);
                }

            }
         );
    }

    async Task ShowScheduleDetails(VSchedule? p)
    {
        if (p is null) return;

        var param = new Dictionary<string, object?>
            {
                {"LoanId",p.LoanId },
                {"CurrencyId",p.CurrencyId },
                {"BranchId",p.BranchId },
                {"ScheduleId",p.LoanScheduleId },
            };
        var options = new SideDialogOptions
        {
            Position = DialogPosition.Right,
            ShowMask = true,
            CloseDialogOnOverlayClick = true,
            Width = "60vw"
        };
        await DialogService.OpenSideAsync<ScheduleDetailsPage>($"Schedule-{p.LoanScheduleId}", parameters: param!, options);


    }


    async Task PayBySchedules(VSchedule? p)
    {

        if (p is null) return;

        var options = new SideDialogOptions
        {
            Position = DialogPosition.Right,

            ShowMask = true,

            CloseDialogOnOverlayClick = false,

            ShowClose=false,

            Width = "35rem"
        };

        var param = new Dictionary<string, object?>
            {
                {"LoanId",p.LoanId },
                {"CurrencyId",p.CurrencyId },
                {"BranchId",p.BranchId },
                {"LoanScheduleId",p.LoanScheduleId },
            };

        await DialogService.OpenSideAsync<RecievePaymentSidebar>($"Schedule-{p.LoanScheduleId}", parameters: param!, options);

    }


}