@using Applications.Requests.Journals
@using Applications.Responses.Lists.Currency
@using TrapchumApp.Services
<PageTitle>Journal Entry</PageTitle>
<RadzenFieldset AllowCollapse="false" Collapsed="false">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25">
            <RadzenIcon Icon="book_5"/>
            <strong>Journal Entry</strong>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenAlert AlertStyle="AlertStyle.Warning" Visible="@_isMessage" ShowIcon="true"
                     Variant="Variant.Flat" Shade="Shade.Lighter">
            <span>@_titleMessage: </span> @_messageAlert
        </RadzenAlert>
        <EditForm Model="JLe" @ref="@_editForm">
            <DataAnnotationsValidator/>
            <ValidationSummary/>
            <RadzenRow AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenColumn Size="2">
                    <RadzenLabel Text="Currency"/>
                    <RadzenDropDown @bind-Value="@JLe.CurrencyRefId"
                                    class="form-control"
                                    Data="@_currencies"
                                    TextProperty="@nameof(CurrencyResponse.CurrencyCode)"
                                    ValueProperty="@nameof(CurrencyResponse.CurrencyId)"
                                    SelectedItemChanged="SelectedCurrencyChanged"
                                    Name="DropDownBindValue"/>
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenCheckBox @bind-Value=@JLe.IsAdjustment Name="CheckBox1"/>
                    <RadzenLabel
                        Component="CheckBox1">Adjustment Entry
                    </RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenLabel Text="Journal Type"/>
                    <RadzenDropDown @bind-Value="@JLe.JournalType"
                                    TValue="string"
                                    class="form-control"
                                    Data="@_journalTypes"
                                    Placeholder="Select Journal type"
                                    TextProperty="@nameof(JournalTypeDto.Description)"
                                    ValueProperty="@nameof(JournalTypeDto.Code)"
                                    SelectedItemChanged="SelectedItemChanged"
                                    Name="DropDownBindValue"/>
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenLabel Text="Date"/>
                    <input id="startDate"
                           class="date form-control "
                           type="date"
                           @bind-value="JLe.JournalDate"
                           @bind-value:after="@OnValidateDate"/>
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenLabel Text="Ref #"/>
                    <RadzenTextBox @bind-Value="JLe.ReferrenceNum"
                                   Name="ReferrenceNum"
                                   Placeholder="Ref No "
                                   class="w-100"/>
                </RadzenColumn>
            </RadzenRow>
            <div class="table-responsive rz-mt-2">
                <table class="table table-sm table-bordered table-light">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Account</th>
                        <th>Debit</th>
                        <th>Credit</th>
                        <th>Description</th>
                        <th>Name</th>
                        <th style="width:3rem">Action</th>
                    </tr>
                    </thead>
                    <tbody class="bg-info">
                    @if (JournalLines?.Count > 0)
                    {
                        @for (var x = 0; x < JournalLines?.Count; x++)
                        {
                            var row = x;
                            var currentRow = x + 1;
                            <JournalEntryRowCreate JournalLine="JournalLines[row]"
                                                   RowIndex="@currentRow"
                                                   JournalLineSeq="@currentRow"
                                                   LedgerData="Ledgers"
                                                   JournalLineList="JournalLines"
                                                   AddRow="AddNewRow"
                                                   RemovedRow="DeleteEvent"
                                                   DebitValidated="DebitValidate"
                                                   CreditValidated="CreditValidate"
                                                   TotalValue="GetTotalValue"
                                                   @key="@Guid.NewGuid().ToString("N")"
                                                   ReCalculateTotal="OnNextPerform"/>
                        }
                    }
                    </tbody>
                    <tbody>
                    <tr>
                        <td class="text-end" colspan="2">Totals</td>
                        <td class="text-end">
                            @JLe?.TotalDr
                        </td>
                        <td class="text-end">
                            @JLe?.TotalCr
                        </td>
                        <td colspan="3"></td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </EditForm>
    </ChildContent>
</RadzenFieldset>
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             class="rz-my-2"
             JustifyContent="JustifyContent.End">
    <RadzenButton Size="ButtonSize.ExtraSmall"
                  Icon="save"
                  ButtonStyle="ButtonStyle.Success"
                  Click="@OnSave"
                  IsBusy="@_visibled"
                  BusyText="Saving..."
                  Text="Save"/>
    <RadzenButton Size="ButtonSize.ExtraSmall"
                  Icon="cancel"
                  ButtonStyle="ButtonStyle.Danger"
                  Click="CloseSelectedTab"
                  Text="Close"/>
</RadzenStack>