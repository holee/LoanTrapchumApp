@using Applications.Features.Currencies.Dto
@using Applications.Requests.Journals
@using Applications.Responses.ViewModels.Journals
@using Applications.Responses.ViewModels.Ledgers
<PageTitle>Journal Entry</PageTitle>
<style>
    .journal-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }
    .journal-table th {
        background: var(--rz-base-200);
        padding: 6px 8px;
        text-align: left;
        font-weight: 600;
        border: 1px solid var(--rz-base-300);
        white-space: nowrap;
    }
    .journal-table td {
        padding: 4px 6px;
        border: 1px solid var(--rz-base-300);
        vertical-align: middle;
    }
    .journal-table tfoot td {
        background: var(--rz-base-200);
        padding: 6px 8px;
        font-weight: 600;
        border: 1px solid var(--rz-base-300);
    }
    .journal-totals {
        font-weight: 600;
    }
    .balance-ok {
        color: var(--rz-success);
    }
    .balance-error {
        color: var(--rz-danger);
        font-weight: 700;
    }
    .text-center {
        text-align: center;
    }
    .text-right {
        text-align: right;
    }
</style>
<RadzenFieldset AllowCollapse="false" Text="Journal Entry">
    <RadzenAlert AlertStyle="AlertStyle.Danger" Visible="@_isMessage" ShowIcon="true"
                 Variant="Variant.Flat" Shade="Shade.Lighter">
        <span>@_titleMessage</span> @_messageAlert
    </RadzenAlert>
    <EditForm  Model="JLe" OnValidSubmit="@HandleFormSave" FormName="JournalEntryForm">
        <DataAnnotationsValidator />
        <FluentValidationValidator DisableAssemblyScanning="true" />
        <RadzenRow class="rz-mb-4">
            <RadzenColumn SizeMD="2">
                <RadzenFormField AllowFloatingLabel="true" Text="Journal Date">
                    <ChildContent>
                         <RadzenDatePicker @bind-Value="JLe.JournalDate"
                                      DateFormat="yyyy-MM-dd"
                                      Change="@(_ => OnValidateDate())"
                                      class="w-100" />
                    </ChildContent>
                    <Helper>
                            <ValidationMessage For="@(() => JLe.JournalDate)" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn SizeMD="3">
                <RadzenFormField AllowFloatingLabel="true" Text="Journal Type" Style="width:100%;">
                    <ChildContent>
                        <RadzenDropDown @bind-Value="@JLe.JournalType"
                                    TValue="string"
                                    class="rz-w-100"
                                    Data="@_journalTypes"
                                    Placeholder="Select type"
                                    TextProperty="@nameof(JournalTypeDto.Description)"
                                    ValueProperty="@nameof(JournalTypeDto.Code)"
                                    Name="JournalType" />
                    </ChildContent>
                    <Helper>
                        <ValidationMessage For="@(() => JLe.JournalType)" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn SizeMD="3">
                <RadzenFormField AllowFloatingLabel="true" Text="Currency" class="rz-w-100">
                    <ChildContent>
                        <RadzenDropDown @bind-Value="@JLe.CurrencyRefId"
                                        class="rz-w-100"
                                        Data="@_currencies"
                                        TextProperty="@nameof(CurrencyDto.CurrencyCode)"
                                        ValueProperty="@nameof(CurrencyDto.CurrencyId)"
                                        SelectedItemChanged="SelectedCurrencyChanged"
                                        Name="Currency" />
                    </ChildContent>
                    <Helper>
                        <ValidationMessage For="@(() => JLe.CurrencyRefId)" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn SizeMD="3">
                <RadzenFormField AllowFloatingLabel="true" Text="Ref #" class="rz-w-100">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="JLe.ReferrenceNum"
                                       Placeholder="Reference"
                                       class="rz-w-100" />
                    </ChildContent>
                    <Helper>
                        <ValidationMessage For="@(() => JLe.ReferrenceNum)" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn SizeMD="1">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-pb-1">
                    <RadzenCheckBox @bind-Value="@JLe.IsAdjustment" Name="IsAdjustment" />
                    <RadzenLabel Component="IsAdjustment" Text="Adjustment" />
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <table class="journal-table rz-mt-2">
            <thead>
                <tr>
                    <th style="width:50px;" class="text-center">#</th>
                    <th style="width:260px;">Account</th>
                    <th style="width:140px;" class="text-right">Debit</th>
                    <th style="width:140px;" class="text-right">Credit</th>
                    <th>Description</th>
                    <th style="width:200px;">Name</th>
                    <th style="width:40px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var jl in JournalLines)
                {
                    <tr>
                        <td class="text-center">@jl.LineSeq</td>
                        <td>
                            <RadzenDropDownDataGrid @bind-Value="jl.LedgerRefId"
                                                    Style="width:100%;"
                                                    Density="Density.Compact"
                                                    Data="@Ledgers"
                                                    LoadData="LoadDataLedger"
                                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                    Placeholder="Select account..."
                                                    ValueProperty="@nameof(VLedger.LedgerId)"
                                                    TextProperty="@nameof(VLedger.LedgerName)"
                                                    SelectedItemChanged="@((arg) => OnAccountSelected(arg, jl))"
                                                    Name="@($"Account_{jl.LineSeq}")">
                                <Template Context="c">
                                    <RadzenStack Orientation="Orientation.Horizontal"
                                                 JustifyContent="JustifyContent.SpaceBetween">
                                        <span>@((c as VLedger)?.LedgerName)</span>
                                        <i style="opacity:0.6">@((c as VLedger)?.LedgerTypeCode)</i>
                                    </RadzenStack>
                                </Template>
                            </RadzenDropDownDataGrid>
                            <span>
                                <ValidationMessage For="@(() => jl.LedgerRefId)" />
                            </span>
                        </td>
                        <td class="text-right">
                            <RadzenNumeric @bind-Value="jl.Debit"
                                           TextAlign="TextAlign.Right"
                                           class="rz-w-100"
                                           ShowUpDown="false"
                                           Disabled="@(jl.IsCredit || jl.LedgerRefId is null or 0)"
                                           Change="@((decimal? _) => OnAmountChanged(jl))" />
                        </td>
                        <td class="text-right">
                            <RadzenNumeric @bind-Value="jl.Credit"
                                           TextAlign="TextAlign.Right"
                                           class="rz-w-100"
                                           ShowUpDown="false"
                                           Disabled="@(jl.IsDebit || jl.LedgerRefId is null or 0)"
                                           Change="@((decimal? _) => OnAmountChanged(jl))" />
                        </td>
                        <td>
                            <RadzenTextBox @bind-Value="jl.JournalLineDesc"
                                           Disabled="@(jl.LedgerRefId is null or 0)"
                                           class="rz-w-100" />
                        </td>
                        <td>
                            <RadzenDropDownDataGrid @bind-Value="jl.EntityNameRefId"
                                                    Density="Density.Compact"
                                                    Data="@NameLists"
                                                    LoadData="@LoadNamesList"
                                                    TextProperty="@nameof(VNameList.AltName)"
                                                    ValueProperty="@nameof(VNameList.Id)"
                                                    Placeholder="Name..."
                                                    AllowFilteringByAllStringColumns="true"
                                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                    SelectedItemChanged="@((arg) => OnNameSelected(arg, jl))"
                                                    Name="@($"Name_{jl.LineSeq}")"
                                                    Disabled="@(jl.LedgerRefId is null or 0)">
                                <Columns>
                                    <RadzenDropDownDataGridColumn Property="@nameof(VNameList.AltName)" Title="Name" Width="100px" />
                                    <RadzenDropDownDataGridColumn Property="@nameof(VNameList.EntType)" Title="Type" Width="80px" />
                                </Columns>
                            </RadzenDropDownDataGrid>
                        </td>
                        <td class="text-center">
                            @if (JournalLines.Count > 1 && jl == JournalLines.Last())
                            {
                                <RadzenButton Icon="remove" Size="ButtonSize.ExtraSmall"
                                              ButtonStyle="ButtonStyle.Danger"
                                              Variant="Variant.Text"
                                              Click="@(() => DeleteLine(jl))" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2"></td>
                    <td class="text-right"><strong class="journal-totals">@TotalDebit.Format(JLe.CurrencyRefId)</strong></td>
                    <td class="text-right"><strong class="journal-totals">@TotalCredit.Format(JLe.CurrencyRefId)</strong></td>
                    <td colspan="3"></td>
                </tr>
            </tfoot>
        </table>
            <RadzenRow class="rz-mt-4" AlignItems="AlignItems.Start">
                <RadzenColumn SizeMD="6">
                    <RadzenStack Gap="0.25rem">
                        <RadzenLabel Text="Memo" />
                        <RadzenTextArea @bind-Value="JLe.JournalDesc"
                                        Rows="2"
                                        Placeholder="Add a memo..."
                                        Style="resize: none;"
                                        class="w-100" />
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn SizeMD="6">
                    <RadzenStack AlignItems="AlignItems.End" Gap="0.25rem" class="rz-mt-2">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
                            <span>Total Debit:</span>
                            <strong>@TotalDebit.Format(JLe.CurrencyRefId)</strong>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
                            <span>Total Credit:</span>
                            <strong>@TotalCredit.Format(JLe.CurrencyRefId)</strong>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
                            <span>Difference:</span>
                            <strong class="@(IsBalanced ? "balance-ok" : "balance-error")">
                                @Difference.Format(JLe.CurrencyRefId)
                            </strong>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
            </RadzenRow>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                 class="rz-my-4" JustifyContent="JustifyContent.End" Gap="0.5rem">
                    <RadzenButton Text="Add Line"
                                  Size="ButtonSize.Small"
                                  Icon="add"
                                  ButtonStyle="ButtonStyle.Info"
                                  Click="@AddLine" />
                    <RadzenButton Text="Clear"
                                  Size="ButtonSize.Small"
                                  Icon="refresh"
                                  ButtonStyle="ButtonStyle.Light"
                                  Click="@ClearForm" />
                    <RadzenButton Icon="save"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Success"
                                  IsBusy="@_visibled"
                                  BusyText="Saving..."
                                  ButtonType="ButtonType.Submit"
                                  Text="Save & Close" />
                    <RadzenButton Size="ButtonSize.Small"
                                  Icon="cancel"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Variant="Variant.Outlined"
                                  Click="CloseSelectedTab"
                                  Text="Close" />
             </RadzenStack>

        </EditForm>
    </RadzenFieldset>

