@using Applications.Features.Currencies.Dto
@using Applications.Requests.Journals
@using Applications.Responses.ViewModels.Journals
@using Applications.Responses.ViewModels.Ledgers
<PageTitle>Journal Entry</PageTitle>
<style>
    /* ── Page shell ── */
    .je-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1.25rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    /* ── Page header ── */
    .je-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid var(--rz-primary);
    }
    .je-header-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: var(--rz-primary);
        color: #fff;
        font-size: 1.25rem;
    }
    .je-header h2 {
        margin: 0;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--rz-text-color);
        letter-spacing: 0.01em;
    }
    .je-header p {
        margin: 0;
        font-size: 0.78rem;
        color: var(--rz-text-secondary-color);
    }

    /* ── Cards ── */
    .je-card {
        background: var(--rz-base-background-color);
        border: 1px solid var(--rz-base-300);
        border-radius: 10px;
        padding: 1rem 1.25rem;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
    }
    .je-card-title {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--rz-text-secondary-color);
        margin-bottom: 0.85rem;
    }
    .je-card-title .material-symbols-outlined,
    .je-card-title .material-icons {
        font-size: 1rem;
        color: var(--rz-primary);
    }

    /* ── Journal lines table ── */
    .je-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }
    .je-table thead tr {
        background: var(--rz-base-200);
    }
    .je-table th {
        padding: 7px 8px;
        text-align: left;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--rz-text-secondary-color);
        border-bottom: 2px solid var(--rz-base-300);
        white-space: nowrap;
    }
    .je-table td {
        padding: 4px 6px;
        border-bottom: 1px solid var(--rz-base-200);
        vertical-align: middle;
    }
    .je-table tbody tr:hover td {
        background: var(--rz-base-100);
    }
    .je-table tfoot td {
        background: var(--rz-base-200);
        padding: 7px 8px;
        font-weight: 700;
        border-top: 2px solid var(--rz-base-300);
    }

    /* ── Balance summary card ── */
    .je-summary {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        min-width: 240px;
    }
    .je-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.875rem;
        padding: 4px 0;
    }
    .je-summary-row.divider {
        border-top: 1px solid var(--rz-base-300);
        padding-top: 8px;
        margin-top: 2px;
    }
    .je-summary-label {
        color: var(--rz-text-secondary-color);
    }
    .je-summary-value {
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    /* ── Balance badge ── */
    .je-balance-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
    }
    .je-balance-badge.ok {
        background: color-mix(in srgb, var(--rz-success) 12%, transparent);
        color: var(--rz-success);
    }
    .je-balance-badge.error {
        background: color-mix(in srgb, var(--rz-danger) 12%, transparent);
        color: var(--rz-danger);
    }

    /* ── Line number chip ── */
    .je-line-num {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--rz-base-300);
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--rz-text-secondary-color);
    }

    /* ── Adjustment toggle ── */
    .je-adjustment-wrap {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        height: 100%;
        padding-top: 0.25rem;
    }

    /* ── Helpers ── */
    .text-right { text-align: right; }
    .text-center { text-align: center; }
    .je-amount-positive { color: var(--rz-success); font-weight: 600; }
    .je-diff-ok { color: var(--rz-success); font-weight: 700; }
    .je-diff-err { color: var(--rz-danger); font-weight: 700; }
</style>

<div class="je-page">

    
    <div class="je-header">
        <div class="je-header-icon">
            <RadzenIcon Icon="receipt_long" Style="font-size:1.2rem;" />
        </div>
        <div>
            <h2>Journal Entry</h2>
            <p>Record double-entry transactions across accounts</p>
        </div>
        @if (IsBalanced)
        {
            <span class="je-balance-badge ok" style="margin-left:auto;">
                <RadzenIcon Icon="check_circle" Style="font-size:0.9rem;" /> Balanced
            </span>
        }
        else if (TotalDebit > 0 || TotalCredit > 0)
        {
            <span class="je-balance-badge error" style="margin-left:auto;">
                <RadzenIcon Icon="error" Style="font-size:0.9rem;" /> Out of Balance
            </span>
        }
    </div>

    
    <RadzenAlert AlertStyle="AlertStyle.Danger" Visible="@_isMessage" ShowIcon="true"
                 Variant="Variant.Flat" Shade="Shade.Lighter" style="margin:0;">
        <strong>@_titleMessage</strong>&nbsp;@_messageAlert
    </RadzenAlert>

    <EditForm Model="JLe" OnValidSubmit="@HandleFormSave" FormName="JournalEntryForm">
        <DataAnnotationsValidator />
        <FluentValidationValidator DisableAssemblyScanning="true" />

        
        <div class="je-card">
            <div class="je-card-title">
                <RadzenIcon Icon="tune" />
                Entry Details
            </div>
            <RadzenRow RowGap="0.75rem">
                <RadzenColumn SizeMD="2">
                    <RadzenFormField AllowFloatingLabel="true" Text="Journal Date" Style="width:100%;">
                        <ChildContent>
                            <RadzenDatePicker @bind-Value="JLe.JournalDate"
                                             DateFormat="yyyy-MM-dd"
                                             Change="@(_ => OnValidateDate())"
                                             class="rz-w-100" />
                        </ChildContent>
                        <Helper>
                            <ValidationMessage For="@(() => JLe.JournalDate)" />
                        </Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="3">
                    <RadzenFormField AllowFloatingLabel="true" Text="Journal Type" Style="width:100%;">
                        <ChildContent>
                            <RadzenDropDown @bind-Value="@JLe.JournalType"
                                            TValue="string"
                                            class="rz-w-100"
                                            Data="@_journalTypes"
                                            Placeholder="Select type"
                                            TextProperty="@nameof(JournalTypeDto.Description)"
                                            ValueProperty="@nameof(JournalTypeDto.Code)"
                                            Name="JournalType" />
                        </ChildContent>
                        <Helper>
                            <ValidationMessage For="@(() => JLe.JournalType)" />
                        </Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="2">
                    <RadzenFormField AllowFloatingLabel="true" Text="Currency" Style="width:100%;">
                        <ChildContent>
                            <RadzenDropDown @bind-Value="@JLe.CurrencyRefId"
                                            class="rz-w-100"
                                            Data="@_currencies"
                                            TextProperty="@nameof(CurrencyDto.CurrencyCode)"
                                            ValueProperty="@nameof(CurrencyDto.CurrencyId)"
                                            SelectedItemChanged="SelectedCurrencyChanged"
                                            Name="Currency" />
                        </ChildContent>
                        <Helper>
                            <ValidationMessage For="@(() => JLe.CurrencyRefId)" />
                        </Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="3">
                    <RadzenFormField AllowFloatingLabel="true" Text="Reference #" Style="width:100%;">
                        <ChildContent>
                            <RadzenTextBox @bind-Value="JLe.ReferrenceNum"
                                           Placeholder="e.g. INV-2025-001"
                                           class="rz-w-100" />
                        </ChildContent>
                        <Helper>
                            <ValidationMessage For="@(() => JLe.ReferrenceNum)" />
                        </Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn SizeMD="2">
                    <div class="je-adjustment-wrap">
                        <RadzenCheckBox @bind-Value="@JLe.IsAdjustment" Name="IsAdjustment" />
                        <RadzenLabel Component="IsAdjustment" Text="Adjustment Entry" Style="font-size:0.85rem;" />
                    </div>
                </RadzenColumn>
            </RadzenRow>
        </div>

        
        <div class="je-card" style="padding-bottom:0.75rem;">
            <div class="je-card-title" style="justify-content:space-between;">
                <span style="display:flex;align-items:center;gap:0.4rem;">
                    <RadzenIcon Icon="table_rows" />
                    Journal Lines
                </span>
                <RadzenButton Text="Add Line"
                              Size="ButtonSize.Small"
                              Icon="add"
                              ButtonStyle="ButtonStyle.Primary"
                              Variant="Variant.Text"
                              Click="@AddLine" />
            </div>
            <table class="je-table">
                <thead>
                    <tr>
                        <th style="width:42px;" class="text-center">#</th>
                        <th style="width:260px;">Account</th>
                        <th style="width:140px;" class="text-right">Debit</th>
                        <th style="width:140px;" class="text-right">Credit</th>
                        <th>Description</th>
                        <th style="width:200px;">Name / Entity</th>
                        <th style="width:36px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var jl in JournalLines)
                    {
                        <tr>
                            <td class="text-center">
                                <span class="je-line-num">@jl.LineSeq</span>
                            </td>
                            <td>
                                <RadzenDropDownDataGrid @bind-Value="jl.LedgerRefId"
                                                        Style="width:100%;"
                                                        Density="Density.Compact"
                                                        Data="@Ledgers"
                                                        LoadData="LoadDataLedger"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        Placeholder="Select account…"
                                                        ValueProperty="@nameof(VLedger.LedgerId)"
                                                        TextProperty="@nameof(VLedger.LedgerName)"
                                                        SelectedItemChanged="@((arg) => OnAccountSelected(arg, jl))"
                                                        Name="@($"Account_{jl.LineSeq}")">
                                    <Template Context="c">
                                        <RadzenStack Orientation="Orientation.Horizontal"
                                                     JustifyContent="JustifyContent.SpaceBetween">
                                            <span>@((c as VLedger)?.LedgerName)</span>
                                            <span style="font-size:0.72rem;opacity:0.55;font-style:italic;">
                                                @((c as VLedger)?.LedgerTypeCode)
                                            </span>
                                        </RadzenStack>
                                    </Template>
                                </RadzenDropDownDataGrid>
                                <ValidationMessage For="@(() => jl.LedgerRefId)" />
                            </td>
                            <td class="text-right">
                                <RadzenNumeric @bind-Value="jl.Debit"
                                               TextAlign="TextAlign.Right"
                                               class="rz-w-100"
                                               ShowUpDown="false"
                                               Disabled="@(jl.IsCredit || jl.LedgerRefId is null or 0)"
                                               Change="@((decimal? _) => OnAmountChanged(jl))" />
                            </td>
                            <td class="text-right">
                                <RadzenNumeric @bind-Value="jl.Credit"
                                               TextAlign="TextAlign.Right"
                                               class="rz-w-100"
                                               ShowUpDown="false"
                                               Disabled="@(jl.IsDebit || jl.LedgerRefId is null or 0)"
                                               Change="@((decimal? _) => OnAmountChanged(jl))" />
                            </td>
                            <td>
                                <RadzenTextBox @bind-Value="jl.JournalLineDesc"
                                               Disabled="@(jl.LedgerRefId is null or 0)"
                                               Placeholder="Line description…"
                                               class="rz-w-100" />
                            </td>
                            <td>
                                <RadzenDropDownDataGrid @bind-Value="jl.EntityNameRefId"
                                                        Density="Density.Compact"
                                                        Data="@NameLists"
                                                        LoadData="@LoadNamesList"
                                                        TextProperty="@nameof(VNameList.AltName)"
                                                        ValueProperty="@nameof(VNameList.Id)"
                                                        Placeholder="Search name…"
                                                        AllowFilteringByAllStringColumns="true"
                                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                        SelectedItemChanged="@((arg) => OnNameSelected(arg, jl))"
                                                        Name="@($"Name_{jl.LineSeq}")"
                                                        Disabled="@(jl.LedgerRefId is null or 0)">
                                    <Columns>
                                        <RadzenDropDownDataGridColumn Property="@nameof(VNameList.AltName)" Title="Name" Width="100px" />
                                        <RadzenDropDownDataGridColumn Property="@nameof(VNameList.EntType)" Title="Type" Width="80px" />
                                    </Columns>
                                </RadzenDropDownDataGrid>
                            </td>
                            <td class="text-center">
                                @if (JournalLines.Count > 1 && jl == JournalLines.Last())
                                {
                                    <RadzenButton Icon="delete_outline"
                                                  Size="ButtonSize.ExtraSmall"
                                                  ButtonStyle="ButtonStyle.Danger"
                                                  Variant="Variant.Text"
                                                  Click="@(() => DeleteLine(jl))"
                                                  title="Remove line" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2" style="font-size:0.78rem;color:var(--rz-text-secondary-color);">
                            @JournalLines.Count line(s)
                        </td>
                        <td class="text-right">@TotalDebit.Format(JLe.CurrencyRefId)</td>
                        <td class="text-right">@TotalCredit.Format(JLe.CurrencyRefId)</td>
                        <td colspan="3"></td>
                    </tr>
                </tfoot>
            </table>


        </div>

        
        <div class="je-card">
            <RadzenRow RowGap="1rem" AlignItems="AlignItems.Start">
                <RadzenColumn SizeMD="7">
                    <div class="je-card-title">
                        <RadzenIcon Icon="notes" />
                        Memo
                    </div>
                    <RadzenTextArea @bind-Value="JLe.JournalDesc"
                                    Rows="3"
                                    Placeholder="Add an optional memo or note for this entry…"
                                    Style="resize:none;width:100%;" />
                </RadzenColumn>
                <RadzenColumn SizeMD="5">
                    <div class="je-card-title">
                        <RadzenIcon Icon="calculate" />
                        Balance Summary
                    </div>
                    <div class="je-summary">
                        <div class="je-summary-row">
                            <span class="je-summary-label">Total Debit</span>
                            <span class="je-summary-value">@TotalDebit.Format(JLe.CurrencyRefId)</span>
                        </div>
                        <div class="je-summary-row">
                            <span class="je-summary-label">Total Credit</span>
                            <span class="je-summary-value">@TotalCredit.Format(JLe.CurrencyRefId)</span>
                        </div>
                        <div class="je-summary-row divider">
                            <span class="je-summary-label">Difference</span>
                            <span class="@(IsBalanced ? "je-diff-ok" : "je-diff-err")">
                                @Difference.Format(JLe.CurrencyRefId)
                                @if (IsBalanced)
                                {
                                    <RadzenIcon Icon="check_circle" Style="font-size:1rem;vertical-align:middle;margin-left:3px;" />
                                }
                                else if (TotalDebit > 0 || TotalCredit > 0)
                                {
                                    <RadzenIcon Icon="error_outline" Style="font-size:1rem;vertical-align:middle;margin-left:3px;" />
                                }
                            </span>
                        </div>
                    </div>
                </RadzenColumn>
            </RadzenRow>
        </div>

        
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.End"
                     class="rz-mt-2"
                     Gap="0.5rem">
            <RadzenButton Text="Clear"
                          Size="ButtonSize.Small"
                          Icon="refresh"
                          ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Outlined"
                          Click="@ClearForm" />
            <RadzenButton Text="Close"
                          Size="ButtonSize.Small"
                          Icon="close"
                          ButtonStyle="ButtonStyle.Secondary"
                          Variant="Variant.Outlined"
                          Click="CloseSelectedTab" />
            <RadzenButton Icon="save"
                          Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Success"
                          IsBusy="@_visibled"
                          BusyText="Saving…"
                          ButtonType="ButtonType.Submit"
                          Text="Save & Close"
                          Disabled="@(!IsBalanced)" />
        </RadzenStack>

    </EditForm>
</div>


