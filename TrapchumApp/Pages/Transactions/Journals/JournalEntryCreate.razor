@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Features.Transactions.Journals
@using Applications.Requests.Journals
@using Applications.Responses.Lists.Currency
@using Applications.Responses.ViewModels.Journals
@using Applications.Responses.ViewModels.Ledgers
@using TrapchumApp.Services
<PageTitle>Journal Entry</PageTitle>
<style> 
    .table-cell-edited {
        position: relative;
    }

        .table-cell-edited::after {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 0;
            height: 0;
            border-top: 10px solid red;
            border-left: 10px solid transparent;
        }
</style>
<RadzenFieldset AllowCollapse="false" Collapsed="false" Text="Journal Entry">
    <RadzenAlert AlertStyle="AlertStyle.Danger" Visible="@_isMessage" ShowIcon="true"
                 Variant="Variant.Flat" Shade="Shade.Lighter">
        <span>@_titleMessage: </span> @_messageAlert
    </RadzenAlert>
    <EditForm Model="JLe" @ref="@_editForm">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <RadzenRow AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenColumn Size="2">
                <RadzenLabel Text="Currency" />
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenDropDown @bind-Value="@JLe.CurrencyRefId"
                                class="form-control"
                                Data="@_currencies"
                                TextProperty="@nameof(CurrencyResponse.CurrencyCode)"
                                ValueProperty="@nameof(CurrencyResponse.CurrencyId)"
                                SelectedItemChanged="SelectedCurrencyChanged"
                                Name="DropDownBindValue" />
            </RadzenColumn>
            <RadzenColumn Size="3">
                <div class="text-center">
                    <RadzenCheckBox @bind-Value=@JLe.IsAdjustment Name="CheckBox1" />
                    <RadzenLabel Component="CheckBox1">
                        Adjustment Entry
                    </RadzenLabel>
                </div>
            </RadzenColumn>
            <RadzenColumn Size="1">
                <RadzenLabel Text="Date" />
            </RadzenColumn>
            <RadzenColumn Size="2">
                <input id="startDate"
                       class="date form-control "
                       type="date"
                       @bind-value="JLe.JournalDate"
                       @bind-value:after="@OnValidateDate" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow class="rz-my-2">
            <RadzenColumn Size="2">
                <RadzenLabel Text="Journal Type" />
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenDropDown @bind-Value="@JLe.JournalType"
                                TValue="string"
                                class="form-control"
                                Data="@_journalTypes"
                                Placeholder="Select Journal type"
                                TextProperty="@nameof(JournalTypeDto.Description)"
                                ValueProperty="@nameof(JournalTypeDto.Code)"
                                SelectedItemChanged="SelectedItemChanged"
                                Name="DropDownBindValue" />
            </RadzenColumn>
            <RadzenColumn Size="1">
                <RadzenLabel Text="Ref #" />
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenTextBox @bind-Value="JLe.ReferrenceNum"
                               Name="ReferrenceNum"
                               Placeholder="Ref No "
                               class="w-100" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End"
                     class="rz-my-2"
                     AlignItems="AlignItems.Center">
            <RadzenButton Text="Add New Line"
                          Size="ButtonSize.ExtraSmall"
                          Click="@AddLastRows"
                          ButtonStyle="ButtonStyle.Secondary"
                          Icon="@IconNames.AddTask"></RadzenButton>
        </RadzenStack>
        <RadzenDataGrid Responsive="true"
                        @ref="gridJournalLines"
                        GridLines="DataGridGridLines.Both"
                        AllowAlternatingRows="true"
                        RowUpdate="@OnUpdateRow"
                        TItem="JournalLineDtoCreate"
                        CellClick="@OnCellClick"
                        RowSelect="@OnRowEditInitiated"
                        Data="@JournalLines">
            <Columns>
                <RadzenDataGridColumn Title="#"
                                      Width="5rem"
                                      TextAlign="TextAlign.Center"
                                      Property="@nameof(JournalLineDto.LineSeq)" />
                <RadzenDataGridColumn Title="Account"
                                      Context="jl"
                                      TItem="JournalLineDtoCreate"
                                      IsInEditMode="@IsEditing"
                                      Property="@nameof(JournalLineDtoCreate.LedgerRefId)">
                    <Template>
                        @jl.LedgerName
                    </Template>
                    <EditTemplate>
                        <RadzenDropDownDataGrid @bind-Value="jl.LedgerRefId"
                                                @ref="editor"
                                                Style="width:100%;"
                                                Density="Density.Compact"
                                                Data="@Ledgers"
                                                LoadData="LoadDataLedger"
                                                class="form-control"
                                                ShowSearch="false"
                                                ShowAdd="true"
                                                @bind-SearchText="filter"
                                                AllowSelectAll="true"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                Placeholder="Ledger..."
                                                ValueProperty="@nameof(VLedger.LedgerId)"
                                                TextProperty="@nameof(VLedger.LedgerName)"
                                                SelectedItemChanged="@((arg) => SelectedItemChanged(arg, jl))"
                                                Name="LedgerName">
                            <Template Context="c">
                                <RadzenStack Orientation="Orientation.Horizontal"
                                             JustifyContent="JustifyContent.SpaceBetween">
                                    <span>
                                        @((c as VLedger)?.LedgerName)
                                    </span>
                                    <i>
                                        @((c as VLedger)?.LedgerTypeCode)
                                    </i>
                                </RadzenStack>
                            </Template>
                            <ValueTemplate Context="c2">
                                <span>
                                    @((c2 as VLedger)?.LedgerName)
                                </span>
                            </ValueTemplate>
                        </RadzenDropDownDataGrid>
                        <RadzenRequiredValidator Text="Account is required" Component="LedgerName" Popup="true" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Debit"
                                      Context="jl"
                                      TItem="JournalLineDtoCreate"
                                      Property="@nameof(JournalLineDtoCreate.Debit)">
                    <Template>
                        @jl.Debit
                    </Template>
                    <EditTemplate>
                        <RadzenNumeric TextAlign="TextAlign.Right"
                                       @bind-Value="@jl.Debit"
                                       class="rz-w-100"
                                       @ref="editor"
                                       Disabled="@(jl.IsCredit || jl.LedgerRefId == 0)"
                                       ShowUpDown="false" />
                    </EditTemplate>
                    <FooterTemplate>
                        <strong>
                            @JournalLines.Sum(x => x.Debit)
                        </strong>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Credit"
                                      Context="jl"
                                      TItem="JournalLineDtoCreate"
                                      Property="@nameof(JournalLineDtoCreate.Credit)">
                    <Template>
                        @jl.Credit
                    </Template>
                    <EditTemplate>
                        <RadzenNumeric TextAlign="TextAlign.Right"
                                       @bind-Value="@jl.Credit"
                                       @ref="editor"
                                       class="rz-w-100"
                                       Disabled="@(jl.IsDebit || jl.LedgerRefId == null)"
                                       ShowUpDown="false" />
                    </EditTemplate>
                    <FooterTemplate>
                        <strong>
                            @JournalLines.Sum(x => x.Credit)
                        </strong>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Description"
                                      Context="jl"
                                      TItem="JournalLineDtoCreate"
                                      Property="@nameof(JournalLineDtoCreate.JournalLineDesc)">
                    <Template>
                        @jl.JournalLineDesc
                    </Template>
                    <EditTemplate>
                        <RadzenTextBox @bind-Value="jl.JournalLineDesc"
                                       @ref="editor"
                                       Change="@(args => Update())"
                                       @onfocusout="@(() => Update())"
                                       Disabled="@(jl.LedgerRefId == 0)"
                                       class="rz-w-100" />
                    </EditTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="Name"
                                      Context="jl"
                                      TItem="JournalLineDtoCreate"
                                      IsInEditMode="@IsEditing"
                                      Property="@nameof(JournalLineDtoCreate.EntityNameRefId)">
                    <Template>
                        @jl.EntityName
                    </Template>
                    <EditTemplate>
                        <RadzenDropDownDataGrid @bind-Value="jl.EntityNameRefId"
                                                Density="Density.Compact"
                                                Data="@NameLists"
                                                @ref="editor"
                                                LoadData="@LoadNamesList"
                                                TextProperty="@nameof(VNameList.AltName)"
                                                ValueProperty="@nameof(VNameList.Id)"
                                                ShowSearch="false"
                                                class="form-control"
                                                SelectedItemsText="@jl.EntityName"
                                                Placeholder="Name..."
                                                AllowFilteringByAllStringColumns="true"
                                                ShowPagingSummary="true"
                                                Change="@(args => Update())"
                                                SelectedItemChanged="@((arg) => SelectionChanged(arg, jl))"
                                                Name="@($"EntityNameRefId-{Guid.NewGuid().ToString("N")}")"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="@nameof(VNameList.AltName)" Title="Name" Width="100px" />
                                <RadzenDropDownDataGridColumn Property="@nameof(VNameList.EntType)" Title="Type" Width="100px" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                    </EditTemplate>
                </RadzenDataGridColumn>

            </Columns>
        </RadzenDataGrid>
    </EditForm>
</RadzenFieldset>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
             class="rz-my-2"
             JustifyContent="JustifyContent.End">
    <RadzenButton Size="ButtonSize.ExtraSmall"
                  Icon="save"
                  ButtonStyle="ButtonStyle.Success"
                  Click="@OnSave"
                  IsBusy="@_visibled"
                  BusyText="Saving..."
                  Text="Save" />
    <RadzenButton Size="ButtonSize.ExtraSmall"
                  Icon="cancel"
                  ButtonStyle="ButtonStyle.Danger"
                  Click="CloseSelectedTab"
                  Text="Close" />
</RadzenStack>


@code {

    RadzenDataGrid<JournalLineDtoCreate> gridJournalLines = default!;
    string columnEditing;
    List<KeyValuePair<int, string>> editedFields = new List<KeyValuePair<int, string>>();
    List<JournalLineDtoCreate> lineToUpdate = new List<JournalLineDtoCreate>();
    List<JournalLineDtoCreate> lineToInsert = new List<JournalLineDtoCreate>();

    bool IsEditing(string columnName, JournalLineDtoCreate order)
    {
        return columnEditing == columnName && lineToUpdate.Contains(order);
    }

    string IsEdited(RadzenDataGridColumn<JournalLineDtoCreate> column, JournalLineDtoCreate arg)
    {
        return editedFields.Where(c => c.Key == arg.LineSeq && c.Value == column.Property)
                           .Any() ? "table-cell-edited" : string.Empty;
    }

    async Task OnCellClick(DataGridCellMouseEventArgs<JournalLineDtoCreate> args)
    {

        if (args.Column.Property == nameof(JournalLineDtoCreate.LineSeq))
        {
            return;
        }


        var selectedIndex = JournalLines.IndexOf(args.Data);

        if (selectedIndex > 0)
        {
            if (JournalLines[selectedIndex - 1].LedgerRefId == null ||
                JournalLines[selectedIndex - 1].LedgerRefId == 0)
            {
                _isMessage = true;
                _messageAlert = "Please select previous row first.";
                return;
            }

            _isMessage =false;
            _messageAlert = string.Empty;
        }


        if (!gridJournalLines.IsValid || (lineToUpdate.Contains(args.Data) && columnEditing == args.Column.Property)) return;

        // Record the previous edited field, if you're not using IRevertibleChangeTracking to track object changes

        if (lineToUpdate.Any())
        {
            editedFields.Add(new(lineToUpdate.First().LineSeq, columnEditing));

            await Update();
        }

        // This sets which column is currently being edited.
        columnEditing = args.Column.Property;

        // Set the item to be edited
        await EditRow(args.Data);

    }

    IRadzenFormComponent editor;

    bool editorFocused;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!editorFocused && editor != null)
        {
            editorFocused = true;
        }
    }

    void Reset(JournalLineDtoCreate? order = null)
    {
        editorFocused = false;

        if (order != null)
        {
            lineToUpdate.Remove(order);
        }
        else
        {
            lineToUpdate.Clear();
        }
    }

    async Task Update()
    {
        editorFocused = false;

        if (lineToUpdate.Any())
        {
            await gridJournalLines.UpdateRow(lineToUpdate.First());
        }
    }


    void SelectionChanged(object? arg, JournalLineDtoCreate row)
    {
        if (arg is null) return;

        row.EntityName = ((VNameList)arg).AltName;

    }

    async Task EditRow(JournalLineDtoCreate arg)
    {
        if (!gridJournalLines.IsValid) return;

        Reset();

        lineToUpdate.Add(arg);

        await gridJournalLines.EditRow(arg);

    }


    void OnUpdateRow(JournalLineDtoCreate row)
    {
        Reset();

        if (_editContext == null || !_editContext.Validate())
        {
            //ShowValidationMessage("Please fix validation errors before continuing.");
            return;
        }

        int rowIndex = JournalLines.IndexOf(row);

        if (rowIndex == _currentEditIndex)
        {
            _currentEditIndex++;
        }

        _editingRow = null;

        _editContext = null;

        //editedFields = editedFields.Where(c => c.Key != arg.LineSeq).ToList();
    }



    async Task InsertFirstRow()
    {
        if (!gridJournalLines.IsValid) return;

        if (JournalLines.Count > 0) return;

        var line = new JournalLineDtoCreate
        {
            LineSeq = 1
        };

        JournalLines.Add(line);

        await gridJournalLines.InsertRow(line);
    }



    async Task InsertAfterRow(JournalLineDtoCreate row)
    {
        if (!gridJournalLines.IsValid) return;

        if (JournalLines.Count < 1)
        {
            await InsertFirstRow();

            return;
        }

        var seq = JournalLines.Count() + 1;

        var line = new JournalLineDtoCreate
        {
            LineSeq = seq
        };

        JournalLines.Add(line);

        await gridJournalLines.InsertAfterRow(line, row);

    }


    async Task InsertRow(JournalLineDtoCreate currentRow)
    {
        if (!gridJournalLines.IsValid) return;

        var seq = JournalLines.Count() + 1;

        var line = new JournalLineDtoCreate
        {
            LineSeq = seq
        };

        if (currentRow.IsDebit)
        {
            line.Credit = currentRow.Debit;
        }
        else
        {
            line.Debit = currentRow.Credit;
        }

        JournalLines.Add(line);

        await gridJournalLines.InsertAfterRow(line, currentRow);

    }


    void OnCreateRow(JournalLineDtoCreate arg)
    {

    }

    void ResetLineSequence()
    {
        for (int i = 0; i < JournalLines.Count; i++)
        {
            JournalLines[i].LineSeq = i + 1;
        }
    }


    void OnAmountChanged(JournalLineDtoCreate currentRow)
    {
        if (currentRow == JournalLines.Last())
        {
            _ = InsertAfterRow(currentRow); // non-blocking
        }
    }


    void OnKeyPressHandler(KeyboardEventArgs e, JournalLineDtoCreate row)
    {
        if (e.Key == "Enter" && row == JournalLines.Last())
        {
            _ = InsertAfterRow(row);
        }
    }

    bool IsSameDebitAndCredit()
    {
        return JournalLines.Sum(x => x.Debit) == JournalLines.Sum(x => x.Credit);
    }



    private int _currentEditIndex = 0;
    private EditContext? _editContext;
    private JournalLineDtoCreate? _editingRow;

    void OnRowEditInitiated(JournalLineDtoCreate row)
    {
        int rowIndex = JournalLines.IndexOf(row);

        if (rowIndex > _currentEditIndex)
        {
            // Prevent editing future rows before previous ones are complete
            //ShowValidationMessage("Please complete the previous row first.");
            return;
        }

        if (_editingRow != null && _editContext != null && !_editContext.Validate())
        {
            //ShowValidationMessage("Current row has validation errors.");

            return;
        }

        _editingRow = row;

        _editContext = new EditContext(row);

        gridJournalLines.EditRow(row);
    }

}







