@page "/App/Account/Journals/{BranchId:int}/Branches"
@attribute [Authorize(Policy = "AccountOnly")]
@using Applications.Responses.ViewModels.Journals
<PageTitle>Journal list</PageTitle>
<div class="journal-page">
    <RadzenTabs RenderMode="TabRenderMode.Server" @bind-SelectedIndex="@selectedIndex" Change="e=>TabChanged(e)" @ref="tb" class="journal-tabs">
        <Tabs>
            <RadzenTabsItem Text="Journals">
                <div class="journal-card">
                    <div class="journal-header">
                        <div class="journal-header-left">
                            <span class="journal-header-icon"><RadzenIcon Icon="menu_book" /></span>
                            <div>
                                <h3 class="journal-title">Journals</h3>
                                <span class="journal-subtitle">Review and manage transaction journal entries</span>
                            </div>
                        </div>
                        <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small"
                                      Click="ShowCreatedTab"
                                      Icon="add"
                                      ButtonType="ButtonType.Button"
                                      Text="New Journal"
                                      class="journal-add-btn" />
                    </div>

                    <div class="journal-divider"></div>
                    <div class="rz-px-2">
                        <GridToolbar SearchChanged="@PerformSearch" />
                    </div>

                    <RadzenDataGrid GridLines="DataGridGridLines.None"
                                    AllowAlternatingRows="false"
                                    Density="Density.Compact"
                                    AllowPaging="true"
                                    AllowSorting="true"
                                    LoadData="@LoadData"
                                    PagerHorizontalAlign="HorizontalAlign.Right"
                                    Count="@counts"
                                    TItem="JournalEntryVm"
                                    RowSelect="RowSelecting"
                                    PageSizeOptions="@StorageConstant.PageSizeOptions"
                                    Style="min-height:50dvh"
                                    Data="@JournalItems">
                        <Columns>
                            <RadzenDataGridColumn Property="TransactionDate" Title="Transaction Date" Context="j">
                                <Template>
                                    <span>@j.TransactionDate.DayFirst()</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="TransactionTypeName" Title="Name" Context="j">
                                <Template>
                                    <span class="journal-name">@j.TransactionTypeName</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="JournalType" Title="Journal Type" Context="j">
                                <Template>
                                    <span class="journal-type-badge">@j.JournalType</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="TotalDr" Title="Debit" TextAlign="TextAlign.Right" Context="j">
                                <Template>
                                    <span class="journal-amount debit">@j.TotalDr</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="TotalCr" Title="Credit" TextAlign="TextAlign.Right" Context="j">
                                <Template>
                                    <span class="journal-amount credit">@j.TotalCr</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="IsAdjustment" TextAlign="TextAlign.Center"
                                                  Context="c"
                                                  Sortable="false" Title="Adjustment">
                                <Template>
                                    <span class="@(c.IsAdjustment ? "journal-status-badge active" : "journal-status-badge inactive")">
                                        @(c.IsAdjustment ? "Yes" : "No")
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>

                            <RadzenDataGridColumn Property="IsAdjustment" TextAlign="TextAlign.Center"
                                                  Context="c"
                                                  Sortable="false" Title="Actions">
                                <Template>
                                    <div class="row-actions">
                                        <RadzenButton Size="ButtonSize.ExtraSmall"
                                                      Icon="more_vert"
                                                      Variant="Variant.Text"
                                                      Click="@((args) => ShowContextMenuWithContent(args, c.JournalEntryId))" />
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </RadzenTabsItem>
            <RadzenTabsItem Visible="showCreateTab">
                <Template>
                    <span style="display: flex; gap: 6px">
                        <RadzenButton Icon="close"
                                      @onclick:stopPropagation Click="CloseCreateTab"
                                      Size="ButtonSize.ExtraSmall"
                                      ButtonStyle="ButtonStyle.Danger"
                                      Variant="Variant.Text"/>
                        New Journal
                    </span>
                </Template>
                <ChildContent>
                    <JournalEntryCreate Close="CloseCreateTab" 
                            UserId="@UserId"
                            BranchId="@BranchId"/>
                </ChildContent>
            </RadzenTabsItem>
            <RadzenTabsItem Visible="showDetailTab">
                <Template>
                    <span style="display: flex; gap: 6px">
                        <RadzenButton Icon="close" @onclick:stopPropagation Click="CloseDetailTab"
                                      Size="ButtonSize.ExtraSmall"
                                      ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"/>
                        Journal Details
                    </span>
                </Template>
                <ChildContent>
                    <JournalDetails SelectIndex="CloseDetailJournal" JournalId="@_selectedJournalId"/>
                </ChildContent>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</div>

@code {

    void ShowContextMenuWithContent(MouseEventArgs args, string? id)
    {
        ContextMenuService.Open(args, ds =>
            @<RadzenMenu Style="font-size:0.8rem;">

                <RadzenMenuItem Click="@(() => GetDetailJournal(id))" Icon="info" Text="Details"
                                Value="@id"></RadzenMenuItem>

            </RadzenMenu>
        );
    }


}
