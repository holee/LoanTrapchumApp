@using Applications.Features.LoanRequests.Services
@using Applications.Responses.ViewModels.Journals
@using Applications.Responses.ViewModels.Ledgers
@using TrapchumApp.Services
<tr>
    <td class="text-center align-middle">
        <RadzenLabel>@RowIndex</RadzenLabel>
        @{
            JournalLine.LineSeq = JournalLineSeq;
        }
    </td>
    <td>
        <RadzenDropDownDataGrid @bind-Value="JournalLine.LedgerRefId"
                                Density="Density.Compact"
                                @bind-Value:after="SelectedItemChange"
                                Style="width:100%;cursor:pointer;height:32px;font-size:14px"
                                Data="@LedgerData"
                                class="form-control"
                                ShowSearch="false"
                                AllowSelectAll="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                Placeholder="Ledger..."
                                ValueProperty="@nameof(VLedger.LedgerId)"
                                TextProperty="@nameof(VLedger.LedgerName)"
                                AllowColumnResize="true"
                                AllowFilteringByAllStringColumns="true"
                                Name="@Guid.NewGuid().ToString("N")">
            <Columns>
                <RadzenDropDownDataGridColumn Title="Ledger" Property="LedgerName" Width="100px" />
                <RadzenDropDownDataGridColumn Title="Type" Property="LedgerTypeCode" Width="100px" />
            </Columns>
        </RadzenDropDownDataGrid>
    </td>
    <td class="text-end">
        <RadzenNumeric TValue="decimal?"
                       ShowUpDown="false"
                       Min="0"
                       TextAlign="TextAlign.End"
                       Style="height:32px;"
                       Disabled="JournalLine.IsCredit"
                       Name="@($"Debit-{Guid.NewGuid().ToString("N")}")"
                       @key="@($"Debit-{Guid.NewGuid().ToString("N")}")"
                       @bind-Value="JournalLine!.Debit"
                       @bind-Value:after="(() => DebitValidate(JournalLine))">

        </RadzenNumeric>
    </td>
    <td class="text-end">
        <RadzenNumeric TValue="decimal?"
                       ShowUpDown="false"
                       Min="0"
                       Style="width:100%;height:32px;"
                       Disabled="JournalLine.IsDebit"
                       TextAlign="TextAlign.End"
                       @bind-Value="JournalLine.Credit"
                       Name="@($"Credit-{Guid.NewGuid().ToString("N")}")"
                       @key="@($"Credit-{Guid.NewGuid().ToString("N")}")"
                       @bind-Value:after="(() => CreditValidate(JournalLine))">
        </RadzenNumeric>
    </td>
    <td>
        <RadzenTextBox Placeholder="Memo..."
                       Name="@($"JournalLineDesc-{Guid.NewGuid().ToString("N")}")"
                       @bind-Value="JournalLine.JournalLineDesc" />
    </td>
    <td>
        <RadzenDropDownDataGrid @bind-Value="JournalLine.EntityNameRefId"
                                Density="Density.Compact"
                                Style="width:100%;cursor:pointer;height:32px;font-size:14px"
                                Data="@NameLists"
                                @bind-SearchText="JournalLine.EntityName"
                                TextProperty="@nameof(VNameList.AltName)"
                                ValueProperty="@nameof(VNameList.Id)"
                                ShowSearch="false"
                                PageSize="@pageSize"
                                Count="@counts"
                                class="form-control"
                                Placeholder="Name..."
                                AllowFilteringByAllStringColumns="true"
                                ShowPagingSummary="true"
                                Name="@($"EntityNameRefId-{Guid.NewGuid().ToString("N")}")"
                                LoadData="@LoanNameList"
                                SelectedItemChanged="@SelectedName"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
            <Columns>
                <RadzenDropDownDataGridColumn Property="@nameof(VNameList.AltName)" Title="Name" Width="100px" />
                <RadzenDropDownDataGridColumn Property="@nameof(VNameList.EntType)" Title="Type" Width="100px" />
            </Columns>
        </RadzenDropDownDataGrid>
    </td>
    <td class="text-center align-middle">
        <RadzenButton Click="@AddNewRow"
                      Icon="add_circle_outline"
                      Size="ButtonSize.ExtraSmall"
                      Variant="Variant.Text"
                      Visible="RowIndex < 2"
                      ButtonStyle="ButtonStyle.Primary" />
        <RadzenButton Click="@RemoveRow"
                      Icon="delete_forever"
                      Size="ButtonSize.ExtraSmall"
                      Variant="Variant.Text"
                      Visible="RowIndex > 1"
                      ButtonStyle="ButtonStyle.Danger" />
    </td>
</tr>



