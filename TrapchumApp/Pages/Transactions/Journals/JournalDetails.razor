@using Applications.Requests.Transactions.Journals
@using Applications.Responses.ViewModels.Journals
@using TrapchumApp.Services
<PageTitle>Journal Details</PageTitle>
<RadzenFieldset>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal">
            <RadzenIcon Icon="info"/>
            <strong>Journal Details</strong>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <table class="table table-bordered table-sm">
            <tr>
                <th class="w-25">Referrence #</th>
                <td>@JournalEntry?.ReferrenceNum</td>
            </tr>
            <tr>
                <th>Journal Date</th>
                <td>@JournalEntry?.JournalDate.DayFirst() </td>
            </tr>
            <tr>
                <th>Journal Type</th>
                <td>@JournalEntry?.JournalType</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>@JournalEntry?.Description</td>
            </tr>
        </table>

    </ChildContent>
</RadzenFieldset>

<RadzenDataGrid GridLines="DataGridGridLines.Both"
                Density="Density.Compact"
                AllowAlternatingRows="true"
                AllowFiltering="false"
                AllowSorting="false"
                ColumnWidth="15rem"
                RowSelect="RowSelecting"
                TItem="JournalEntryLineVm"
                Data="@_journalEntryLines">
    <Columns>
        <RadzenDataGridColumn Width="6rem" Property="LedgerName" Context="j" Title="#" Sortable="false">
            <Template>
                @(_journalEntryLines.Index())
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="10rem" Property="LedgerName" Title="Account" Sortable="false"/>
        <RadzenDataGridColumn Width="8rem" Property="Debit" Title="Debit" TextAlign="TextAlign.Right" Sortable="false"/>
        <RadzenDataGridColumn Width="8rem" Property="Credit" Title="Credit" TextAlign="TextAlign.Right"
                              Sortable="false"/>
        <RadzenDataGridColumn Width="8rem" Property="Amount" Title="Amount" TextAlign="TextAlign.Right" Sortable="false"
                              Context="journal">
            <Template>
                @(Math.Abs(journal.Amount))
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="JournalLineDesc" Title="Description" Sortable="false"/>
    </Columns>
</RadzenDataGrid>
<RadzenStack Orientation="Orientation.Horizontal"
             class="rz-my-2"
             AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
    <RadzenButton Icon="close"
                  Click="@ClosedTabEvent"
                  ButtonStyle="ButtonStyle.Danger"
                  Size="ButtonSize.Small"
                  Text="Close"/>
</RadzenStack>

 
