@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Services
<RadzenFieldset Text="Please verify amount and balance then start cash vault." class="rz-p-0 rz-m-0">
    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.SpaceBetween">
        <RadzenStack AlignItems="AlignItems.Center"
                     class="w-50"
                     Orientation="Orientation.Horizontal">
            <RadzenLabel Text="CURRENCY" Component="DropDownBindValue" Style="margin-right: 8px" />
            <RadzenDropDown @bind-Value="@CurrencyId"
                            ValueProperty="@nameof(Domains.Models.Currencies.Currency.CurrencyId)"
                            TextProperty="@nameof(Currency.CurrencyCode)"
                            Data="@CurrencyList"
                            SelectedItemChanged="OnSelectChanges"
                            Style="height:35px"
                            Name="DropDownBindValue" />
        </RadzenStack>
        <RadzenStack class="w-50" AlignItems="AlignItems.Center"
                     Orientation="Orientation.Horizontal">
            <RadzenLabel Text="AMOUNT" Component="Amount" Style="margin-right: 8px;" />
            <RadzenNumeric TValue="decimal?"
                           Disabled
                           Name="Amount"
                           TextAlign="TextAlign.End"
                           Value="@totalAmount"
                           ShowUpDown="false"
                           Format="@sp" />
        </RadzenStack>

    </RadzenStack>
    <table class="table table-bordered table-sm mt-2">
        <thead>
            <tr>
                <th class="text-end w-auto">Currency Note</th>
                <th class="w-auto text-end">Quantity In Vault</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Sub Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cn in cashMDList)
            {
                <VaultOutRow Item="@cn"
                             CurrencyId="@CurrencyId"
                             Calculate="@Calculate" />
            }
        </tbody>
        <tbody>
            <tr>
                <td class="text-end" colspan="3">TOTAL</td>
                <td class="text-end">
                    @total.Format(CurrencyId)
                </td>
            </tr>
        </tbody>
    </table>
    <RadzenStack JustifyContent="JustifyContent.End"
                 AlignItems="AlignItems.Center"
                 class="rz-mt-2"
                 Orientation="Orientation.Horizontal">
        <RadzenButton ButtonStyle="ButtonStyle.Success"
                      Icon="save"
                      Text="Save"
                      Disabled="total==0"
                      Click="@OnSaveChanges"
                      Size="ButtonSize.Small" />
        <RadzenButton ButtonStyle="ButtonStyle.Success"
                      Text="Save & Close"
                      Icon="save"
                      Disabled="total==0"
                      Size="ButtonSize.Small"
                      Click="@OnSaveChangesClose" />
        <RadzenButton Icon="close"
                      ButtonStyle="ButtonStyle.Danger"
                      Click="@(()=>DialogService.Close(false))"
                      Text="Cancel"
                      Size="ButtonSize.Small" />
    </RadzenStack>
</RadzenFieldset>


