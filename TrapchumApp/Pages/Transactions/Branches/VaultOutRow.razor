@using Applications.Enumerations
@using Applications.Requests.Transactions.CashManagements
@using TrapchumApp.Services
<tr class="align-middle" @key="@Item">
    <td class="text-end">@Item?.CurrencyNoteValue</td>
    <td class="text-end">@Item?.QOnHand</td>
    <td>
        <IntNumbers TextAlign="TextAlign.Right"
                    OnValueChanged="CalculateByQuantity"
                    Min="0"
                    @bind-Value="Item!.Quantity" />
    </td>
    <td>
        <TCNumbers Format="@sp"
                   Min="0"
                   OnValueChanged="@CalculateByAmount"
                   MouseLeave="MouseLeaved"
                   Disabled="@editable"
                   @bind-Value="Item!.TotalValue" />
    </td>
</tr>
@code {
    string messageAlert = "";
    string sp = "#,##0.00";
    [Parameter] public CashManagementDetailDtoCreate Item { get; set; } = new();
    [Parameter] public EventCallback Calculate { get; set; }
    [Parameter] public int? CurrencyId { get; set; } = (int)CurrenciesType.Khr;
    bool editable = false;

    protected override void OnInitialized()
    {
        if (Item!.QOnHand > 0)
        {
            editable = false;
        }
        base.OnInitialized();
    }

    async void CalTotal()
    {
        await Calculate.InvokeAsync();
    }

    void CalculateByQuantity(int? qty)
    {
        qty ??= 0;

        bool hasError = qty > 0 && qty > Item!.QOnHand;

        if (hasError)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Input amount is bigger than Onhand amount.");
            Reset();
        }
        else
        {
            Item!.TotalValue = Item.CurrencyNoteValue * qty;
        }

        CalTotal();

    }

    void CalculateByAmount(decimal? value)
    {
        value ??= 0;

        var qty = Convert.ToInt32(value / Item?.CurrencyNoteValue);

        bool hasError = qty > Item?.QOnHand;

        if (hasError)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Input amount is bigger than Onhand amount.");
            Reset();
        }
        else
        {
            Item!.Quantity = qty;
        }

        CalTotal();
    }

    void MouseLeaved()
    {
        Item!.TotalValue = Item.CurrencyNoteValue * Item.Quantity;
        //sp = "#,##0.00";
        CalTotal();
    }

    void Reset()
    {
        Item!.Quantity = 0;
        Item!.TotalValue = 0;
    }



}
