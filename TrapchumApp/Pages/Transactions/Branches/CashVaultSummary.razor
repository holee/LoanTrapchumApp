@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Services
@*
<table class="table table-sm table-hover">
    <thead>
        <tr>
            <th>Currency Name</th>
            <th>Currency Code</th>
            <th class="text-end">Currency Value</th>
            <th class="text-end">Quantity</th>
            <th class="text-end">Sub Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in CurrencyNotes!)
        {
            <tr>
                <td>@item.CurrencyName</td>
                <td>@item.CurrencyCode</td>
                <td class="text-end">@((int)item.CurrencyValue!)</td>
                <td class="text-end">@(item.Quantity ?? 0)</td>
                <td class="text-end">@((item.Quantity * item.CurrencyValue) ?? 0)</td>
            </tr>
        }
        <tr>
            <th colspan="3" class="text-end">Total</th>
            <th class="text-end">@CurrencyNotes?.Sum(x => x.Quantity)</th>
            <th class="text-end">
                @{
                    var value = CurrencyNotes?.Sum(x => x.Quantity * x.CurrencyValue);
                }
                @CurrencyExtension.CurrencyWithSign(value, SelectedCurrencyId)
            </th>
        </tr>
    </tbody>
</Table>
*@