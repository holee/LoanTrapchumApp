@page "/App/Loan/Categories"
@using Applications.Features.LoanRequests.Services
@using Applications.Responses.ViewModels.Loans.Categories
@using Microsoft.AspNetCore.Components.Web
@using TrapchumApp.Services
<PageTitle>Loan Categories</PageTitle>
<style>
    .rz-grid-table td .rz-cell-data {
        line-height: 1.5rem;
        font-size: 0.8rem;
    }
</style>
<RadzenTabs @ref="tabs"
            @bind-SelectedIndex="SelectIndex"
            RenderMode="TabRenderMode.Server">
    <Tabs>
        <RadzenTabsItem Text="Categories">
            <GridToolbar SearchChanged="PerformSearch">
                <LeftChildren>
                    <RadzenButton Size="ButtonSize.Small"
                                  Click="@OnCreate"
                                  Text="Add Category"
                                  Icon="@IconNames.Add"
                                  ButtonStyle="ButtonStyle.Primary" />
                </LeftChildren>
                <RightChildren>
                    <div class="text-start">
                        <RadzenCheckBox TValue="bool" @bind-Value=@InActive @bind-Value:after="OnIsActive" Name="CheckBox1" />
                        <RadzenLabel Text="Include InActive" Component="CheckBox1" Style="margin-left: 8px; vertical-align: middle;" />
                    </div>
                </RightChildren>
            </GridToolbar>
            <RadzenDataGrid GridLines="DataGridGridLines.Both"
                            Responsive="true"
                            Count="@counts"
                            PageSize="@pageSize"
                            AllowPaging="true"
                            AllowSorting="true"
                            AllowFiltering="true"
                            ShowPagingSummary="true"
                            Density="Density.Compact"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            PageSizeOptions="@StorageConstant.PageSizeOptions"
                            PageSizeChanged="@PageChanged"
                            LoadData="@LoadData"
                            IsLoading="@isLoading"
                            Data="@vLCategories">
                <Columns>
                    <RadzenDataGridColumn Width="5rem"
                                          TextAlign="TextAlign.Center"
                                          Filterable="false"
                                          Title="#" Context="h">
                        <Template>
                            @(vLCategories.IndexOf(h) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="Category"
                                          Property="@nameof(VlCategoryList.LoancategoryCode)" />
                    <RadzenDataGridColumn Title="Description"
                                          Property="@nameof(VlCategoryList.Description)" />
                    <RadzenDataGridColumn Width="7rem"
                                          Title="Code"
                                          Property="@nameof(VlCategoryList.Code)" />
                    <RadzenDataGridColumn Title="Description-Khmer"
                                          Filterable="false"
                                          Property="@nameof(VlCategoryList.DesInKhmer)" />
                    <RadzenDataGridColumn Width="5rem"
                                          Title="Status"
                                          Sortable="false"
                                          Filterable="false"
                                          TextAlign="TextAlign.Center"
                                          Context="h">
                        <Template>
                            <RadzenCheckBox TValue="bool?"
                                            Value="@h.IsActive"
                                            Change="@((arg)=>DeactiveOrActive(arg,h))" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="5rem"
                                          Title="Actions"
                                          Sortable="false"
                                          Filterable="false"
                                          Context="c">
                        <Template>
                            <RadzenButton Size="ButtonSize.ExtraSmall"
                                          Icon="@IconNames.MoreVert"
                                          Variant="Variant.Text"
                                          Click="@(args=>ShowContextMenuWithContent(args,c))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
@code {
    void ShowContextMenuWithContent(MouseEventArgs args, VlCategoryList loanCategory)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Click="@(() => Details(loanCategory.LoanCategoryId))" Icon="info" Text="Details" Value="@loanCategory"></RadzenMenuItem>
    <RadzenMenuItem Click="@(() => EditCategory(loanCategory.LoanCategoryId))" Icon="edit" Text="Edit" Value="@loanCategory"></RadzenMenuItem>
    <RadzenMenuItem Click="@(() => OnDelete(loanCategory))" Icon="delete" Text="Delete" Value="@loanCategory"></RadzenMenuItem>
</RadzenMenu>
    );
    }
}


