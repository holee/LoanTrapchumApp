@page "/App/Loan/{LoanId}/Customer/{CustomerId}/WriteOff"
@using TrapchumApp.Pages.Transactions.Loans.Disbursements
<PageTitle>Loan Write Off</PageTitle>
<PageTitle>Loan Pay Off</PageTitle>
<RadzenTabs>
    <Tabs>
        <RadzenTabsItem Text="All">
            <AllLoansTab BranchId="@BranchId">
                <ChildMenu>
                    <RadzenButton Size="ButtonSize.ExtraSmall"
                                  Icon="@IconNames.HMoreVert"
                                  Variant="Variant.Text" />
                </ChildMenu>
            </AllLoansTab>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Some">

        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
@code {
    [CascadingParameter] Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    [CascadingParameter] CascadingAppState bState { get; set; } = default!;
    [Parameter, SupplyParameterFromQuery] public int BranchId { get; set; }
    [Parameter] public string? LoanId { get; set; } = string.Empty;
    [Parameter] public string? CustomerId { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {

        var authState = await AuthenticationState;

        await bState.GetBranchIdByUser();

        await base.OnInitializedAsync();
    }
}
