@using Microsoft.AspNetCore.Components.Web
@using TrapchumApp.Services
<RadzenStack JustifyContent="JustifyContent.End"
             Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
    <div class="rz-p-1 rz-text-align-center">
        <RadzenCheckBox @bind-Value="ShowUnPaindOnly" Name="ShowUnPaindOnly" />
        <RadzenLabel Text="Show UnPaind Only" Component="ShowUnPaindOnly" class="rz-ms-2" />
    </div>
</RadzenStack>
<RadzenDataGrid Data="@loanSchedule!.Schedules"
                PageSize="@loanSchedule!.Schedules!.Count"
                Density="Density.Compact"
                Responsive
                AllowAlternatingRows="true"
                GridLines="DataGridGridLines.Both"
                SelectionMode="DataGridSelectionMode.Single"
                @bind-Value="SelectedSchedules"
                ColumnWidth="15rem"
                CellRender="CellRender"
                Style="min-height:30rem;height:30rem;max-height:35rem;"
                TItem="VSchedule">
    <Columns>
        <RadzenDataGridColumn Property="@(nameof(VSchedule.InstallmentNo))"
                              Title="#"
                              Width="2rem"
                              Sortable="false" />
        <RadzenDataGridColumn Property="@(nameof(VSchedule.PaymentDate))"
                              Title="Date"
                              Width="5rem"
                              Sortable="false">
            <Template>
                @(string.Format("{0:dd/MM/yyyy}", context.PaymentDate))
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VSchedule.TotalDay))"
                              Title="Days"
                              Width="3rem"
                              Context="c"
                              TextAlign="TextAlign.Center"
                              Sortable="false">
            <Template>
                @c.TotalDay
            </Template>
            <FooterTemplate>
                @(loanSchedule!.Schedules.Sum(x => x.TotalDay))
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VSchedule.Principle))"
                              Title="Principal"
                              TextAlign="TextAlign.Right"
                              Width="6rem"
                              Context="c"
                              Sortable="false">
            <Template>
                @c.Principle.Format(c.CurrencyId)
            </Template>
            <FooterTemplate>
                <strong>
                    @(loanSchedule!.Schedules.Sum(x => x.Principle).Format(CurrencyId))
                </strong>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VSchedule.Interest))"
                              Title="Interest"
                              TextAlign="TextAlign.Right"
                              Width="6rem"
                              Sortable="false">
            <Template>
                @context.Interest.Format(context.CurrencyId)
            </Template>
            <FooterTemplate>
                <strong>
                    @(loanSchedule!.Schedules.Sum(x => x.Interest).Format(CurrencyId))
                </strong>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VSchedule.CollectionFee))"
                              Title="Collection Fee"
                              Width="6rem"
                              TextAlign="TextAlign.Right"
                              Sortable="false">
            <Template>
                @context.CollectionFee.Format(context.CurrencyId)
            </Template>
            <FooterTemplate>
                <strong>
                    @(loanSchedule!.Schedules.Sum(x => x.CollectionFee).Format(CurrencyId))
                </strong>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VSchedule.CollectionFee))"
                              Title="Penalty"
                              Width="6rem"
                              TextAlign="TextAlign.Right"
                              Sortable="false">
            <Template>
                @context.PenaltyAmount.Format(context.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VSchedule.TotalPay))"
                              Title="Amount"
                              TextAlign="TextAlign.Right"
                              Width="6rem"
                              Context="c"
                              Sortable="false">
            <Template>
                @c.TotalPay.Format(c.CurrencyId)
            </Template>
            <FooterTemplate>
                <strong>
                    @(loanSchedule!.Schedules.Sum(x => x.TotalPay).Format(CurrencyId))
                </strong>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VSchedule.LoanOutstanding))"
                              Title="OutStanding"
                              Width="7rem"
                              TextAlign="TextAlign.Right"
                              Sortable="false">
            <Template>
                @context.LoanOutstanding.Format(context.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VScheduleVm.ScheduleStatus))"
                              Title="Status"
                              Width="4rem"
                              TextAlign="TextAlign.Center"
                              Sortable="false">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VScheduleVm.ScheduleStatus))"
                              Title="Action"
                              Context="s"
                              Width="3rem"
                              TextAlign="TextAlign.Center"
                              Sortable="false">
            <Template>
                <RadzenButton Size="ButtonSize.ExtraSmall"
                              Icon="more_vert"
                              Variant="Variant.Text"
                              Click="@((args)=>ShowContextMenu(args,s))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
@code {

    void ShowContextMenu(MouseEventArgs args, VSchedule p)
    {
        ContextMenuService.Open(args, ds =>@<RadzenMenu Style="font-size:0.8rem;">
        <RadzenMenuItem Icon="schedule"
                        Visible="@(!p.IsPaid || p.IsPartialPaid)"
                        Text="Payment By Schedule"></RadzenMenuItem>
        <RadzenMenuItem Icon="money"
                        Visible="@(!p.IsPaid || p.IsPartialPaid)"
                        Text="Recieve Payment"></RadzenMenuItem>
        <RadzenMenuItem Icon="paid"
                        Visible="p.IsPaid"
                        Text="Paid Schedule"></RadzenMenuItem>
    </RadzenMenu>
    );
    }


}