<RadzenDataGrid AllowPaging="true"
                AllowAlternatingRows="true"
                AllowRowSelectOnRowClick="true"
                AllowSorting="false"
                PagerHorizontalAlign="HorizontalAlign.Right"
                Density="Density.Compact"
                IsLoading="isLoading"
                GridLines="DataGridGridLines.Both"
                PageSize="pageSize"
                ShowPagingSummary="true"
                RowSelect="RowSelecting"
                TItem="VSchedule"
                Count="@counts"
                Data="@_schedules">
    <Columns>
        <RadzenDataGridColumn Title="#"
                              Width="2rem"
                              Context="p">
            <Template>
                @p.InstallmentNo
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Payment Date"
                              Width="8rem"
                              Property="PaymentDate"
                              Context="p">
            <Template>
                @p.PaymentDate.DayFirst()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Principle"
                              Width="8rem"
                              Property="Principal"
                              Context="p">
            <Template>
                @p.Principle.Format(CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Interest"
                              Width="8rem"
                              Property="Interest"
                              Context="p">
            <Template>
                @p.Interest.Format(CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Collection Fee"
                              Width="8rem"
                              Property="CollectionFee"
                              Context="p">
            <Template>
                @p.CollectionFee.Format(CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Penalty"
                              Width="8rem"
                              Property="PenaltyAmount"
                              Context="p">
            <Template>
                @if (p.PenaltyAmount > 0)
                {
                    <strong class="text-danger">
                        @p.PenaltyAmount.Format(CurrencyId)
                    </strong>
                }
                else
                {
                    @p.PenaltyAmount.Format(CurrencyId)
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Total"
                              Width="8rem"
                              Property="TotalPay"
                              Context="p">
            <Template>
                @p.TotalPay
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Actions"
                              Width="5rem"
                              TextAlign="TextAlign.Center"
                              Context="p">
            <Template>
                <RadzenButton Size="ButtonSize.ExtraSmall"
                              Icon="more_vert"
                              Variant="Variant.Text"
                              Click="@((args)=>ShowContextMenu(args,p))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
@code {
    void ShowContextMenu(MouseEventArgs args, VSchedule p)
    {
        ContextMenuService.Open(args, ds =>@<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Icon="info_i"
                    Click="@((args)=>ShowScheduleDetails(p))"
                    Text="Show Details" />
</RadzenMenu>
    );
    }
}