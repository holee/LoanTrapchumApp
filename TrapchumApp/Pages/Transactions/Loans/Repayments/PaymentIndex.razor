@page "/App/Loans/Schedules/{BranchId:int}/Branches"
@using TrapchumApp.Pages.Transactions.Loans.Menu
@using TrapchumApp.Pages.Transactions.RecievePayements
<PageTitle>Schedules</PageTitle>
<RadzenTabs RenderMode="TabRenderMode.Client" SelectedIndex="@_selectedIndex" @ref="@refTabs">
    <Tabs>
        <RadzenTabsItem Text="All" Icon="@IconNames.List">
            <Template>
                <span class="rz-ms-2">
                    All
                    <RadzenBadge BadgeStyle="BadgeStyle.Primary" IsPill="@true" Text="@AllScheduleCounts.ToString()"
                                 class="rz-ms-1" />
                </span>
            </Template>
            <ChildContent>
                <ClientAllPayTab ShowLateScheduleDetails="@LateScheduleDetails"
                                 BranchId="@BranchId"
                                 RecievePayment="@ShowPaymentSchedule"
                                 ShowCounts="@GetCount" />
            </ChildContent>
        </RadzenTabsItem>

        @foreach (var item in _tabs)
        {
            <RadzenTabsItem Icon="@item.Icon" Text="@item.Title" @key="@item.Key">
                <Template>
                    <CloseTabButton Title="@item.Title"
                                    Closed="(() => CloseTab(item.Key))" />
                </Template>
                <ChildContent>
                    @item.Content
                </ChildContent>
            </RadzenTabsItem>

        }

    </Tabs>
</RadzenTabs>

@code {

    private List<CustomTab> _tabs = [];

    private RadzenTabs refTabs = default!;

    private void ShowLateScheduleDetails(string loanId)
    {
        var existingIndex = _tabs.FindIndex(t => t.Key == loanId);

        if (existingIndex != -1)
        {

            _selectedIndex = existingIndex + 1;

            StateHasChanged();

            return;
        }

        RenderFragment content = builder =>
        {
            builder.OpenComponent(0, typeof(LateScheduleDetail));
            builder.AddAttribute(1, "LoanId", loanId);
            builder.AddAttribute(2, "PaymentDate", paymentDate);
            builder.AddAttribute(3, "BranchId", BranchId);
            builder.AddAttribute(4, "Close", EventCallback.Factory.Create(this, () =>
            {
                CloseTab(loanId);

            }));
            builder.SetKey(loanId);
            builder.CloseComponent();
        };

        var newTab = new CustomTab(loanId, "Late Schedule Details", TabActions.Details, content);

        _tabs.Add(newTab);

        _selectedIndex = _tabs.Count;

    }

    private void LateScheduleDetails(VSchedule schedule)
    {

        var existingIndex = _tabs.FindIndex(t => t.Key == schedule.LoanId);

        if (existingIndex != -1)
        {

            _selectedIndex = existingIndex + 1;

            StateHasChanged();

            return;
        }

        RenderFragment content = builder =>
        {
            builder.OpenComponent(0, typeof(LateScheduleDetail));
            builder.AddAttribute(1, "LoanId", schedule.LoanId);
            builder.AddAttribute(2, "PaymentDate", paymentDate);
            builder.AddAttribute(3, "BranchId", BranchId);
            builder.AddAttribute(4, "Close", EventCallback.Factory.Create(this, () =>
            {
                CloseTab(schedule.LoanId!);

            }));
            builder.SetKey(schedule.LoanId);
            builder.CloseComponent();
        };

        var newTab = new CustomTab(schedule.LoanId!, $"Customer:{schedule.AltName}", TabActions.Details, content);

        _tabs.Add(newTab);

        _selectedIndex = _tabs.Count;

    }

    private void ShowDueDateScheduleTab(string key)
    {

        var newKey = $"{key}_DueDateSchedules";

        var existingIndex = _tabs.FindIndex(t => t.Key == newKey);

        if (existingIndex != -1)
        {

            _selectedIndex = existingIndex + 1;

            StateHasChanged();

            return;
        }

        int counts = 0;

        RenderFragment content = builder =>
        {
            builder.OpenComponent(0, typeof(ClientDuePayTab));
            builder.AddAttribute(1, "BranchId", BranchId);
            builder.AddAttribute(2, "GetCounts", EventCallback.Factory.Create(this, (int x) =>
            {
                counts = x;
            }));
            builder.SetKey(newKey);
            builder.CloseComponent();
        };

        var newTab = new CustomTab(newKey, $"Client Due Day({counts})", TabActions.Details, content);

        _tabs.Add(newTab);

        _selectedIndex = _tabs.Count;
    }

    private void ShowLateSchedule()
    {

        var newKey = $"{BranchId}_LateSchedules";

        var existingIndex = _tabs.FindIndex(t => t.Key == newKey);

        if (existingIndex != -1)
        {

            _selectedIndex = existingIndex + 1;

            StateHasChanged();

            return;
        }

        RenderFragment content = builder =>
        {
            builder.OpenComponent(0, typeof(ClientLateSchedules));

            builder.AddAttribute(1, "BranchId", BranchId);

            builder.AddAttribute(2, "GetScheduleChanged", EventCallback.Factory.Create(this, (VSchedule x) =>
            {
                ShowLateScheduleDetails(x.LoanId!);
            }));

            builder.AddAttribute(3, "GetCounts", EventCallback.Factory.Create(this, (int x) =>
           {
               GetLateScheduleCount(newKey, x);
           }));
            builder.SetKey(newKey);

            builder.CloseComponent();
        };

        var newTab = new CustomTab(newKey, $"Late Schedules({AllLateScheduleCounts})", TabActions.Details, content);

        _tabs.Add(newTab);

        _selectedIndex = _tabs.Count;

    }

    private void ShowPaymentSchedule(VSchedule schedule)
    {

        var newKey = $"{schedule.LoanId}_RecievePayment";

        var existingIndex = _tabs.FindIndex(t => t.Key == newKey);

        if (existingIndex != -1)
        {
            _selectedIndex = existingIndex + 1;

            StateHasChanged();

            return;
        }

        RenderFragment content = builder =>
        {
            builder.OpenComponent(0, typeof(RecievePayementSchesules));

            builder.AddAttribute(1, "LoanId", schedule.LoanId);

            builder.AddAttribute(2, "BranchId", BranchId);

            builder.AddAttribute(3, "CreditAgentId", schedule.CreditAgentId);

            builder.AddAttribute(4, "CurrencyId", schedule.CurrencyId);

            builder.AddAttribute(5, "OnClose", EventCallback.Factory.Create(this, (string x) =>
            {
                CloseTab(schedule.LoanId!);

            }));

            builder.AddAttribute(6, "ReloadTab", EventCallback.Factory.Create(this, () =>
            {
                refTabs.Reload();
            }));

            builder.AddAttribute(7, "AltName", schedule.AltName);

            builder.SetKey(schedule.LoanId);

            builder.CloseComponent();
        };

        var newTab = new CustomTab(newKey, $"Receive From: {schedule.AltName}", TabActions.Details, content);

        _tabs.Add(newTab);

        _selectedIndex = _tabs.Count;

    }


    void CloseTab(string tabId)
    {
        var tabIndex = _tabs.FirstOrDefault(t => t.Key == tabId);

        if (tabIndex is not null)
        {
            _tabs.Remove(tabIndex);

            _selectedIndex = _tabs.Count;
        }
    }




    void ShowContextMenu(MouseEventArgs args, VSchedule p)
    {
        ContextMenuService.Open(args, ds =>@<AllScheduleMenu ShowLateScheduleDetails="@GetCustomerLateSchedules"
                         Schedule="@p" />);
    }


   


}

