@page "/app/loan/schedules/{BranchId:int}/branches"
@using Applications.Features.LoanRequests.Interfaces
<PageTitle>Schedules</PageTitle>
<RadzenTabs RenderMode="TabRenderMode.Server" @bind-SelectedIndex="@_selectedIndex">
    <Tabs>
        <RadzenTabsItem Text="All" Icon="@IconNames.List">
            <Template>
                <span class="rz-ms-2">
                    All
                    <RadzenBadge BadgeStyle="BadgeStyle.Primary" IsPill="@true" Text="@AllScheduleCounts.ToString()"
                                 class="rz-ms-1"/>
                </span>
            </Template>
            <ChildContent>
                <ClientAllPayTab UserId="@_userId" BranchId="@BranchId" ShowCounts="@GetCount"/>
            </ChildContent>
        </RadzenTabsItem>
        <RadzenTabsItem Icon="@IconNames.MoneyBag">
            <Template>
                <span class="rz-ms-2">
                    Client Due Pay
                    <RadzenBadge BadgeStyle="BadgeStyle.Primary" IsPill="@true" Text="@DuePaymentCounts.ToString()"
                                 class="rz-ms-1"/>
                </span>
            </Template>
            <ChildContent>
                <ClientDuePayTab UserId="@_userId" BranchId="@BranchId" GetCountChanged="GetDueDateScheduleCount"/>
            </ChildContent>
        </RadzenTabsItem>
        <RadzenTabsItem>
            <Template>
                <span class="rz-ms-2">
                    Late Schedule
                    <RadzenBadge BadgeStyle="BadgeStyle.Primary"
                                 IsPill="@true" Text="@AllLateScheduleCounts.ToString()"
                                 class="rz-ms-1"/>
                </span>
            </Template>
            <ChildContent>
                <ClientLateSchedules
                    BranchId="@BranchId"
                    UserId="@_userId"
                    GetScheduleChanged="@GetScheduleChanged"
                    GetCountChanged="@GetLateScheduleCount"/>
            </ChildContent>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Details"
                        Icon="@IconNames.SendMoney"
                        Visible="@_isLateTab">
            <LateScheduleDetail
                LoanId="@loanId"
                PaymentDate="@paymentDate"
                Close="Close"
                BranchId="@BranchId"/>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {


    void Close()
    {
        _isLateTab = false;
        _selectedIndex = 2;
    }
    
    void ShowContextMenu(MouseEventArgs args, VSchedule p)
    {
        ContextMenuService.Open(args, ds => @<RadzenMenu Style="font-size:0.8rem;">
                                                <RadzenMenuItem Icon="money"
                                                                Visible="!p.IsPaid"
                                                                Click="@(() => ShowCustomerPayment(p))"
                                                                Text="Receive Payment"/>
                                                <RadzenMenuItem Icon="paid"
                                                                Click="@(() => CustomerPayOff(p))"
                                                                Text="PayOff"/>
                                                <RadzenMenuItem Icon="info"
                                                                Click="@(() => GetCustomerLateSchedules(p))"
                                                                Text="Show Late Schedule"/>
                                            </RadzenMenu>
        );
    }

}
