    void AllTab_ShowContextMenu(MouseEventArgs args, VSchedule p)
    {
        ContextMenuService.Open(args, ds => @<AllScheduleMenu ShowOnTab="true"
                                                                  ShowLateScheduleDetails="@AllTab_ShowLateDetails"
                                                                  RecievePayment="@AllTab_ShowRecievePayment"
                                                                  Schedule="@p" />);
        }



    void AllTabShowContextMenu(MouseEventArgs args, VSchedule ? p)
    {
            if (p is not null)
            {

                recievePaymentUrl = $"/App/Loans/{p.BranchId}/Branches/{p.LoanId}/Schedules?CreditAgentId={p.CreditAgentId}&CurrencyId={p.CurrencyId}";

                payOffUrl = $"/Loan/CreditAgent/{p.LoanId}/Changed?CustomerId={p.CustomerId}&BranchId={p.BranchId}&CreditAgentId={p.CreditAgentId}&CurrencyId={p.CurrencyId}";
            }

            ContextMenuService.Open(args, ds => @<AuthorizeView>
                <Authorized>
                    @if (p is not null)
                    {
                        <RadzenMenu Style="font-size:0.8rem;">

                            <RadzenMenuItem Icon="@IconNames.MoneyBag"
                                            Disabled="@(!p.IsPaid && bState.CanRecievePayment)"
                                            Path="@recievePaymentUrl"
                                            Text="Receive Payment" />

                            @if (bState.CanRecievePayment && ShowOnTab)
                            {
                                <RadzenMenuItem Icon="@IconNames.MoneyBag"
                                                Visible="!p.IsPaid"
                                                Click="() => ShowPaymentOnTab(p)"
                                                Text="Receive Payment" />
                            }


                            @if (bState.CanPayOff)
                            {
                                <RadzenMenuItem Icon="@IconNames.Paid"
                                                Path="@payOffUrl"
                                                Text="Pay Off" />
                            }


                            <RadzenMenuItem Icon="@IconNames.Info"
                                            Click="() => GetCustomerLateSchedules(p)"
                                            Text="Show Late Schedule Details" />
                        </RadzenMenu>
                    }
                </Authorized>
            </AuthorizeView>
    );
        }

        async Task ShowPaymentOnTab(VSchedule? p)
        {
            if (p is
                {
                    BranchId: > 0,
                    LoanId: not null,
                    CustomerId: not null
                })
            {
                ShowPaymentSchedule(p);
            }
        }

        async Task AllTab_ShowLateDetails(VSchedule p)
        {
            ContextMenuService.Close();
            LateScheduleDetails(p);
            StateHasChanged();
        }

        async Task AllTab_ShowRecievePayment(VSchedule p)
        {
            ContextMenuService.Close();
            ShowPaymentSchedule(p);
            StateHasChanged();
        }

        void AllTab_ContextMenuClick(DataGridCellMouseEventArgs<VSchedule> args)
        {
            if (args?.Data is null) return;
            var p = args.Data;
            ContextMenuService.Open(args, new List<ContextMenuItem>
        {
            new ContextMenuItem { Text = "Receive Payment",      Value = "1", Icon = "payments" },
            new ContextMenuItem { Text = "Collection Payment",   Value = "5", Icon = "payments" },
            new ContextMenuItem { Text = "Receive By Schedule",  Value = "2", Icon = "schedule",         Disabled = p.IsLate },
            new ContextMenuItem { Text = "Schedule Details",     Value = "3", Icon = "info" },
            new ContextMenuItem { Text = "Show Late Schedules",  Value = "4", Icon = "credit_card_clock" }
        }, e =>
    {
        ContextMenuService.Close();
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            switch (id)
            {
                case 1: _ = AllTab_ShowRecievePayment(p); break;
                case 4: _ = AllTab_ShowLateDetails(p); break;
                case 5: AllTab_ShowCollectionPayment(p); break;

            }
        }
    });
        }

