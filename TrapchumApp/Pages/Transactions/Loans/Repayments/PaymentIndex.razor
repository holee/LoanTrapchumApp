    private void AllTab_RowRenderChanged(DataGridCellRenderEventArgs<VSchedule> args)
    {
        if (args?.Data is null) return;
        args.Attributes["style"] = args.Data.DayArrea switch
        {
            >= 1 and <= 7 => "background-color:#fff3cd;color:#856404;",
            > 7 and <= 14 => "background-color:#ffe0b2;color:#6d4c41;",
            > 14 => "background-color:#f8d7da;color:#721c24;",
            _ => "background-color:#ffffff;color:#212529;"
        };
    }

