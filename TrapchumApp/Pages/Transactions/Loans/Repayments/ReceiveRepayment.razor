@page "/App/Loans/{BranchId:int}/Branches/{LoanId}/Schedules"
@using Applications.ApplicationPolicies
@using TrapchumApp.Components.Pages.Transactions.Loans.Disbursements
@using TrapchumApp.Services
@using static Applications.ApplicationPolicies.Policies
<PageTitle>Repayment</PageTitle>
<LoanInfos BranchId="@BranchId"
           LoanId="@LoanId"
           Currency="@CurrencyId"
           LoanSchedule="LoanSchedule" @key="@(Guid.NewGuid().ToString())" />
<RadzenFieldset class="rz-my-2">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal"
                     Gap="0.25rem">
            <RadzenIcon Icon="paid" /><strong>Payment Schedules</strong>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <div class="m-0 p-0 rz-background-color-base-200">
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End"
                         class="rz-mb-2"
                         AlignItems="AlignItems.Center">
                <AuthorizeView Policy="@RepaymentPolicies.MultiplePayment">
                    <Authorized>
                        <div class="rz-p-0 rz-text-align-center">
                            <RadzenCheckBox @bind-Value="@isAllowMultiplePayment"
                                            TValue="bool"
                                            Name="isAllowMultiplePayment"
                                            Change="MultipleCheckChanged" />
                            <RadzenLabel Text="Multiple Payments" Component="isAllowMultiplePayment" class="rz-ms-2" />
                        </div>
                    </Authorized>
                </AuthorizeView>
                <div class="input-group input-group-sm w-auto">
                    <span class="input-group-text">Date</span>
                    <InputDate @bind-Value="paymentDate" TValue="DateTime" class="form-control" disabled />
                </div>
            </RadzenStack>
            <RadzenDataGrid TItem="VSchedule"
                            Data="@schedules"
                            Responsive
                            Density="Density.Compact"
                            SelectionMode="@gridSelectionMode"
                            GridLines="DataGridGridLines.Both"
                            @bind-Value="@SelectedSchedules"
                            RowSelect="SelectedRowEvt"
                            RowDeselect="DeSelectedRowEvt"
                            AllowRowSelectOnRowClick="@allowRowSelected"
                            IsLoading="isLoading"
                            @ref="gridSchedule">
                <Columns>
                    <RadzenDataGridColumn Width="3.5rem"
                                          TextAlign="TextAlign.Center"
                                          OrderIndex="0"
                                          Sortable="false"
                                          Context="s"
                                          Visible="isAllowMultiplePayment"
                                          Filterable="false">
                        <Template>
                            <RadzenCheckBox TabIndex="-1"
                                            TriState="false"
                                            Value="@(SelectedSchedules!.Any() && SelectedSchedules!.Contains(s))"
                                            Change="@(arg=>CheckedChanged(arg,s))"
                                            InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select item" }})"
                                            TValue="bool" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Context="c"
                                          Width="3rem"
                                          Title="#"
                                          OrderIndex="1"
                                          TextAlign="TextAlign.Center"
                                          Sortable="false">
                        <Template>
                            <input type="hidden" @bind="c.LoanId" />
                            @c.InstallmentNo
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="6rem"
                                          Context="c"
                                          Title="ថ្ងៃត្រូវបង់ប្រាក់"
                                          Sortable="false">
                        <Template>
                            <small>
                                <strong>@c.PaymentDate!.Value!.ToString("dd/MM/yyyy")</strong>
                                <br />
                                <em>@c.PaymentDate!.Value!.DayOfWeek</em>
                            </small>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="5rem"
                                          Context="c"
                                          TextAlign="TextAlign.Right"
                                          Title="ចំនួនថ្ងៃយឺត"
                                          Sortable="false">
                        <Template>
                            <small>
                                ​@c.DayArrea
                            </small>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                          Context="c"
                                          Title="ប្រាក់ដើមត្រូវបង់" Sortable="false">
                        <Template>
                            @c.LeftPrinciple.Format(CurrencyId)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TextAlign="TextAlign.End"
                                          Context="c"
                                          Title="ការប្រាក់ត្រូវបង់" Sortable="false">
                        <Template>
                            @c.LeftInterestAmount.Format(CurrencyId)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                          Title="ប្រាក់ប្រសិទ្ធិភាពត្រូវបង់"
                                          Context="c"
                                          Sortable="false">
                        <Template>
                            @c.LeftCollectionFeeAmount.Format(CurrencyId)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                          Title="ប្រាក់ពីន័យ"
                                          Context="c"
                                          Sortable="false">
                        <Template>
                            @c.PenaltyAmount.Format(CurrencyId)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                          Property="TotalPay"
                                          Title="សរុបប្រាក់ត្រូវបង់"
                                          Context="c"
                                          Sortable="false">
                        <Template>
                            @c.LeftAmount.Format(CurrencyId)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                          Context="c"
                                          Property="LoanOutstanding"
                                          Title="ប្រាក់ដើមនៅសល់"
                                          Sortable="false">
                        <Template>
                            @c.LoanOutstanding.Format(CurrencyId)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TextAlign="TextAlign.Center"
                                          Title="ស្ថានភាព"
                                          Sortable="false"
                                          Width="8rem"
                                          Context="s">
                        <Template>
                            @s.ScheduleStatus
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
        @if (!isAllowMultiplePayment)
        {
            <div class="rz-m-0 rz-py-2 rz-background-color-base-200">
                <RadzenFieldset Text="តារាងសងប្រាក់">
                    <PaymentScedule SelectedSchedule="@SelectedSchedule" />
                </RadzenFieldset>
                <RadzenFieldset Text="Customer's Payment" class="mt-2">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="3">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="5">
                                    <RadzenStack AlignItems="AlignItems.Center"
                                                 Orientation="Orientation.Horizontal"
                                                 JustifyContent="JustifyContent.SpaceAround">
                                        <RadzenCheckBox TValue="bool"
                                                        Name="PaidNow"
                                                        Disabled="disableIsPaidNow"
                                                        Change="CheckPaymentChanged"
                                                        Value="@isPaidNow">
                                        </RadzenCheckBox>
                                        <RadzenLabel>ប្រាក់ដើម</RadzenLabel>
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="7">
                                    <RadzenNumeric TextAlign="TextAlign.End"
                                                   TValue="decimal?"
                                                   ShowUpDown="false"
                                                   class="w-auto"
                                                   Format="#,##0.00"
                                                   Style="height:var(--input-text-sm)"
                                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                                   Disabled="!isPaidNow"
                                                   Min="0"
                                                   Max="@SelectedSchedule?.LeftPrinciple"
                                                   @oninput="PrincipleAmountValueChanged"
                                                   @bind-Value="recievePayment!.RecievePrincipleAmount">
                                    </RadzenNumeric>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                        <RadzenColumn Size="3">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="4">
                                    <RadzenLabel>ការប្រាក់</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="8">
                                    <RadzenNumeric TextAlign="TextAlign.End"
                                                   TValue="decimal?"
                                                   Disabled="!isPaidNow"
                                                   Format="#,##0.00"
                                                   class="w-auto"
                                                   Min="0"
                                                   Max="@SelectedSchedule?.LeftInterestAmount"
                                                   Style="height:var(--input-text-sm)"
                                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                                   ShowUpDown="false"
                                                   @oninput="InterestAmountValueChanged"
                                                   @bind-Value="recievePayment!.RecieveInterestAmount">
                                    </RadzenNumeric>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                        <RadzenColumn Size="3">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="5">
                                    <RadzenLabel>ប្រាក់ប្រសិទ្ធិភាព</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="7">
                                    <RadzenNumeric TextAlign="TextAlign.End"
                                                   TValue="decimal?"
                                                   Disabled="!isPaidNow"
                                                   Style="height:var(--input-text-sm)"
                                                   class="w-auto"
                                                   Format="#,##0.00"
                                                   Min="0"
                                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                                   @bind-Value="recievePayment!.RecieveCollectionFeeAmount"
                                                   @oninput="CollectionFeeAmountValueChanged"
                                                   Max="@SelectedSchedule?.LeftCollectionFeeAmount"
                                                   ShowUpDown="false">
                                    </RadzenNumeric>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                        <RadzenColumn Size="3">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="5">
                                    <RadzenLabel>ប្រាក់ពិន័យ</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="7">
                                    <RadzenNumeric TextAlign="TextAlign.End"
                                                   TValue="decimal?"
                                                   Format="#,##0.00"
                                                   class="w-auto"
                                                   Min="0"
                                                   Style="height:var(--input-text-sm)"
                                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                                   @bind-Value="recievePayment!.PenaltyAmountAmount"
                                                   Disabled="!isPaidNow"
                                                   Max="@SelectedSchedule?.PenaltyAmount"
                                                   ShowUpDown="false" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow class="mt-2" AlignItems="AlignItems.Center">
                        <RadzenColumn Size="3" Offset="6">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="5">
                                    <RadzenLabel>Reciept No</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="7">
                                    <RadzenTextBox @bind-Value="receiptNo"
                                                   class="w-100"
                                                   Style="height:var(--input-text-sm)" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                        <RadzenColumn Size="3">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="5">
                                    <RadzenLabel>Total</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="7">
                                    <RadzenStack Orientation="Orientation.Horizontal"
                                                 Gap="0"
                                                 AlignItems="AlignItems.Center">
                                        <RadzenNumeric Value="@recievePayment?.TotalPaymentWithPenalty"
                                                       ShowUpDown="false"
                                                       Format="#,##0.00"
                                                       class="rz-m-0 rz-p-0"
                                                       Style="height:var(--input-text-sm)"
                                                       Disabled />
                                        @if (isAllowMultiplePayment)
                                        {

                                            <RadzenButton Disabled="!isPaidNow" Click="OnPaid"
                                                          Size="ButtonSize.Small"
                                                          Icon="add"
                                                          ButtonStyle="ButtonStyle.Primary"
                                                          class="w-auto">
                                            </RadzenButton>

                                        }
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenFieldset>
                @if (isAllowMultiplePayment)
                {
                    <RadzenFieldset Text="ព័ត‌៌មានទូទាត់ប្រាក់" class="mt-2">
                        <PaymentLines @ref="@paymentLinesRef"
                                      Remove="@OnRemoveAdded"
                                      LoanRepaymentLines="LoanPaymentLines" />
                    </RadzenFieldset>

                }
            </div>
        }
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.End"
                     class="rz-mt-3"
                     Gap="1rem"
                     AlignItems="AlignItems.Center">

            <AuthorizeView Policy="@RepaymentPolicies.MultiplePayment">
                <Authorized>
                    <RadzenButton Icon="paid"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Click="ApplyMultipleSchedulePayment"
                                  Visible="isAllowMultiplePayment"
                                  Text="ApplySchedulePayment" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@RepaymentPolicies.PayOff">
                <Authorized>
                    <RadzenButton Icon="paid"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  Click="ApplySchedulePayment"
                                  Text="PayOff" />
                </Authorized>
            </AuthorizeView>
            <RadzenButton Icon="save"
                          Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Success"
                          Click="ApplySchedulePayment"
                          Visible="!isAllowMultiplePayment"
                          Text="Applied Payment" />
            <RadzenLink Path="@($"/App/Loan/{BranchId}/Branches?UserId={UserId}")"
                        Text="Cancel" />
        </RadzenStack>
    </ChildContent>

</RadzenFieldset>
