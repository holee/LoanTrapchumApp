@using TrapchumApp.Pages.Transactions.Loans.Disbursements
<LoanInfos BranchId="@BranchId" LoanId="@LoanId" />
<RadzenDataGrid AllowAlternatingRows="true"
                AllowRowSelectOnRowClick="allowRowSelectOnRowClick"
                AllowSorting="false"
                PagerHorizontalAlign="HorizontalAlign.Right"
                Density="Density.Compact"
                GridLines="DataGridGridLines.Both"
                @bind-Value="@SelectedSchedules"
                SelectionMode="DataGridSelectionMode.Single"
                KeyProperty="PaymentDate"
                @ref="grid"
                TItem="VSchedule"
                Responsive="true"
                Data="@LateSchedules">
    <Columns>
        <RadzenDataGridColumn Title="#"
                              Width="2rem"
                              Context="p">
            <Template>
                <input type="hidden" @bind-value="p.BranchId" />
                <input type="hidden" @bind-value="p.LoanId" />
                <input type="hidden" @bind-value="p.LoanScheduleId" />
                <input type="hidden" @bind-value="p.InstallmentNo" />
                @p.InstallmentNo
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Date"
                              Width="10rem"
                              Property="PaymentDate"
                              Context="p">
            <Template>
                <small>
                    <span>
                        @p.PaymentDate.DayFirst() &ndash;
                        <small>
                            @p.PaymentDate!.DayName()
                        </small>
                    </span>
                </small>
              
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Late"
                              Width="5rem"
                              TextAlign="TextAlign.Right"
                              Property="DayArrea"
                              Context="p">
            <Template>
                <strong class="text-danger">
                    @p.DayArrea
                </strong>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Days"
                              Width="4rem"
                              Property="TotalDay"
                              TextAlign="TextAlign.Right"
                              Context="p">
            <Template>
                @p.TotalDay
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Principle"
                              Width="8rem"
                              Property="Principal"
                              TextAlign="TextAlign.Right"
                              Context="p">
            <Template>
                @p.Principle.Format(p.CurrencyId)
            </Template>
            <FooterTemplate>
                @LateSchedules.Sum(p => p.Principle).Format(currencyId)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Interest"
                              Width="8rem"
                              Property="Interest"
                              TextAlign="TextAlign.Right"
                              TItem="VSchedule"
                              Context="p">
            <Template>
                @p.Interest.Format(p.CurrencyId)
            </Template>
            <FooterTemplate>
                @LateSchedules.Sum(p => p.Interest).Format(currencyId)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Collection Fee"
                              Width="8rem"
                              TextAlign="TextAlign.Right"
                              Property="CollectionFee"
                              Context="p">
            <Template>
                @p.CollectionFee.Format(p.CurrencyId)
            </Template>
            <FooterTemplate>
                @LateSchedules.Sum(p => p.CollectionFee).Format(currencyId)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Penalty"
                              Width="8rem"
                              Property="PenaltyAmount"
                              TextAlign="TextAlign.Right"
                              Context="p">
            <Template>
                @p.PenaltyAmount.Format(p.CurrencyId)
            </Template>
            <FooterTemplate>
                @LateSchedules.Sum(p => p.PenaltyAmount).Format(currencyId)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Total"
                              Width="8rem"
                              Property="TotalPay"
                              TextAlign="TextAlign.Right"
                              Context="p">
            <Template>
                @p.TotalPay.Format(p.CurrencyId)
            </Template>
            <FooterTemplate>
                @LateSchedules.Sum(p => p.TotalPay).Format(currencyId)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Outstanding"
                              Width="8rem"
                              Property="LoanOutstanding"
                              TextAlign="TextAlign.Right"
                              Context="p">
            <Template>
                @(p.LoanOutstanding.Format(p.CurrencyId))
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>
<RadzenStack AlignItems="AlignItems.Center" class="mt-2"
             Gap="1rem"
             Style="position:absolute;right:1rem;bottom:1rem;"
             Orientation="Orientation.Horizontal"
             JustifyContent="JustifyContent.End">
    <RadzenButton Size="ButtonSize.ExtraSmall"
                  ButtonStyle="ButtonStyle.Success"
                  Click="@RecievePayments"
                  Text="Receive Payment" Icon="paid">

    </RadzenButton>
    <RadzenButton Size="ButtonSize.ExtraSmall"
                  ButtonStyle="ButtonStyle.Danger"
                  Click="@OnClose"
                  Text="Close"
                  Variant="Variant.Text"
                  Icon="@IconNames.Cancel">
    </RadzenButton>
</RadzenStack>

    