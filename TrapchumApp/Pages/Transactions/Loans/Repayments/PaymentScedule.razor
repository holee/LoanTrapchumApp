<style>
    .ps-summary-card {
        border-radius: 10px;
        padding: 0.85rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        border: 1px solid rgba(0,0,0,0.07);
        background: #fff;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        transition: box-shadow 0.15s;
    }

        .ps-summary-card:hover {
            box-shadow: 0 3px 10px rgba(0,0,0,0.10);
        }

    .ps-card-label {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #6b7280;
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .ps-card-icon {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
    }

    .ps-card-value {
        font-size: 1.15rem;
        font-weight: 700;
        text-align: right;
        letter-spacing: 0.01em;
    }

    .ps-icon-principle {
        background: #eff6ff;
        color: #3b82f6;
    }

    .ps-icon-interest {
        background: #fefce8;
        color: #ca8a04;
    }

    .ps-icon-fee {
        background: #f0fdf4;
        color: #16a34a;
    }

    .ps-icon-total {
        background: #fdf4ff;
        color: #9333ea;
    }

    .ps-value-principle {
        color: #2563eb;
    }

    .ps-value-interest {
        color: #b45309;
    }

    .ps-value-fee {
        color: #15803d;
    }

    .ps-value-total {
        color: #7e22ce;
    }
</style>

<RadzenRow Gap="0.75rem" AlignItems="AlignItems.Stretch" class="rz-py-1">
    <RadzenColumn Size="3">
        <div class="ps-summary-card">
            <span class="ps-card-label">
                <span class="ps-card-icon ps-icon-principle">&#x1F4B0;</span>
                ប្រាក់ដើម
            </span>
            <span class="ps-card-value ps-value-principle">
                @if (SelectedSchedule is null)
                {
                    <span class="ps-value-principle">0.00</span>
                }
                else
                {
                    @SelectedSchedule?.LeftPrinciple.Format(SelectedSchedule.CurrencyId, 2)
                }
            </span>
        </div>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <div class="ps-summary-card">
            <span class="ps-card-label">
                <span class="ps-card-icon ps-icon-interest">&#x25B2;</span>
                ការប្រាក់
            </span>
            <span class="ps-card-value ps-value-interest">
                @if (SelectedSchedule is null)
                {
                    <span class="ps-value-interest">0.00</span>
                }
                else
                {
                    @SelectedSchedule?.LeftInterestAmount.Format(SelectedSchedule.CurrencyId, 2)
                }
            </span>
        </div>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <div class="ps-summary-card">
            <span class="ps-card-label">
                <span class="ps-card-icon ps-icon-fee">&#x2713;</span>
                ប្រាក់ប្រសិទ្ធិភាព
            </span>
            <span class="ps-card-value ps-value-fee">
                @if (SelectedSchedule is null)
                {
                    <span class="ps-value-fee">0.00</span>
                }
                else
                {
                    @SelectedSchedule?.LeftCollectionFeeAmount.Format(SelectedSchedule.CurrencyId, 2)
                }
            </span>
        </div>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <div class="ps-summary-card" style="border-left: 3px solid #9333ea;">
            <span class="ps-card-label">
                <span class="ps-card-icon ps-icon-total">&#x3A3;</span>
                ប្រាក់សរុប
            </span>
            <span class="ps-card-value ps-value-total">
                @if (SelectedSchedule is null)
                {
                    <span class="ps-value-total">0.00</span>
                }
                else
                {
                    @SelectedSchedule?.LeftAmount.Format(SelectedSchedule.CurrencyId, 2)
                }
            </span>
        </div>
    </RadzenColumn>
</RadzenRow>

@code {
    [Parameter, EditorRequired]
    public VSchedule? SelectedSchedule { get; set; }
}
