@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Services
<RadzenRow AlignItems="AlignItems.Center">
    <RadzenColumn Size="3">
        <RadzenFormField Text="ប្រាក់ដើម">
            <RadzenNumeric Disabled
                           TextAlign="TextAlign.End"
                           ShowUpDown="false"
                           class="rz-w-100"
                           Format="@AppValue.DefaultCurrencyFormat"
                           Value="@SelectedSchedule?.LeftPrinciple" />
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <RadzenFormField Text="ការប្រាក់">
            <RadzenNumeric Disabled
                           TextAlign="TextAlign.End"
                           class="rz-w-100"
                           ShowUpDown="false"
                           Format="@AppValue.DefaultCurrencyFormat"
                           Value="@SelectedSchedule?.LeftInterestAmount" />
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <RadzenFormField Text="ប្រាក់ប្រសិទ្ធិភាព">
            <RadzenNumeric Disabled
                           TextAlign="TextAlign.End"
                           class="rz-w-100"
                           ShowUpDown="false"
                           Format="@AppValue.DefaultCurrencyFormat"
                           Value="@SelectedSchedule?.LeftCollectionFeeAmount" />
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <RadzenFormField Text="ប្រាក់សរុប">
            <RadzenNumeric Disabled
                           TextAlign="TextAlign.End"
                           class="rz-w-100"
                           ShowUpDown="false"
                           Format="@AppValue.DefaultCurrencyFormat"
                           Value="@SelectedSchedule?.LeftAmount" />
        </RadzenFormField>
    </RadzenColumn>
</RadzenRow>
@code {
    [Parameter, EditorRequired]
    public VSchedule? SelectedSchedule { get; set; }
}
