@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Features.Schedules.Dto
@using TrapchumApp.Services
<table class="table-sm">
    <thead>
        <tr>
            <th class="rz-w-25">Principle</th>
            <td>
                @Schedule.Principle.Format(CurrencyId)
            </td>
        </tr>
        <tr>
            <th class="rz-w-25">Interest</th>
            <td>
                @Schedule.Interest.Format(CurrencyId)
            </td>
        </tr>
        <tr>
            <th class="rz-w-25">Collection Fee</th>
            <td>
                @Schedule.CollectionFee.Format(CurrencyId)
            </td>
        </tr>
        <tr>
            <th class="rz-w-25">Total</th>
            <td>
                @Schedule.Total.Format(CurrencyId)
            </td>
        </tr>
        <tr>
            <th class="rz-w-25">Payment Date</th>
            <td>
                @Schedule.PaymentDate.DayFirst()
            </td>
        </tr>
    </thead>
</table>
<RadzenDataGrid Data="@Schedule.PaymentLines"
                Responsive="true"
                Density="Density.Compact"
                GridLines="DataGridGridLines.Both"
                AllowAlternatingRows="true"
                TItem="PaymentLineDetailsDto">
    <Columns>
        <RadzenDataGridColumn Title="#" Context="c" Property="@nameof(PaymentLineDetailsDto.Id)" Width="3rem">
            <Template>
                @{
                    var index = Schedule.PaymentLines.IndexOf(c) + 1;
                }
                @index
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Principle"
                              Property="@nameof(PaymentLineDetailsDto.PaidPrinciple)"
                              Context="c"
                              Width="8rem">
            <Template>
                @c?.PaidPrinciple
            </Template>
            <FooterTemplate>
                @Schedule.PaymentLines?.Sum(x => x.PaidPrinciple).Format(CurrencyId)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Interest"
                              Context="c"
                              Property="@nameof(PaymentLineDetailsDto.PaidInterest)"
                              TextAlign="TextAlign.Right"
                              Width="8rem">
            <Template>
                @c?.PaidInterest
            </Template>
            <FooterTemplate>
                @Schedule.PaymentLines?.Sum(x => x.PaidInterest).Format(CurrencyId)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="CollectionFee"
                              Context="c"
                              TextAlign="TextAlign.Right"
                              Property="@nameof(PaymentLineDetailsDto.PaidCollectionFee)"
                              Width="8rem">
            <Template>
                @c?.PaidCollectionFee
            </Template>
            <FooterTemplate>
                @Schedule.PaymentLines?.Sum(x => x.PaidCollectionFee).Format(CurrencyId)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="PenaltyAmount"
                              Context="c"
                              TextAlign="TextAlign.Right"
                              Property="@nameof(PaymentLineDetailsDto.PenaltyAmount)"
                              Width="8rem">
            <Template>
                @c?.PenaltyAmount
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="SubTotal"
                              Context="c"
                              TextAlign="TextAlign.Right"
                              Property="@nameof(PaymentLineDetailsDto.SubTotal)"
                              Width="8rem">
            <Template>
                @c?.SubTotal
            </Template>
            <FooterTemplate>
                <strong>
                    @Schedule?.Total.Format(CurrencyId)
                </strong>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Recieve Date"
                              Context="c"
                              TextAlign="TextAlign.Right"
                              Property="@nameof(PaymentLineDetailsDto.Created)"
                              Width="8rem">
            <Template>
                @c?.Created.DayFirst()
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>