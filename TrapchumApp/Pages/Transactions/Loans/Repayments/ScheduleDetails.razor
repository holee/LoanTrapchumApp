@using Applications.Responses.ViewModels.Loans.Payments
@using TrapchumApp.Services
<table class="table table-bordered table-sm">
    <thead>
        <tr>
            <th class="w-25 rz-background-color-base-100">Principle</th>
            <td>
                @Schedule.Principle.Format(CurrencyId)
            </td>
        </tr>
        <tr>
            <th class="w-25 rz-background-color-base-100">Interest</th>
            <td>
                @Schedule.Interest.Format(CurrencyId)
            </td>
        </tr>
        <tr>
            <th class="w-25 rz-background-color-base-100">Collection Fee</th>
            <td>
                @Schedule.CollectionFee.Format(CurrencyId)
            </td>
        </tr>
        <tr>
            <th class="w-25 rz-background-color-base-100">Payment Date</th>
            <td>
                @Schedule.PaymentDate.DayFirst()
            </td>
        </tr>
    </thead>
</table>
<RadzenDataGrid Data="@Schedule.PaymentLines"
                Responsive="true"
                Density="Density.Compact"
                GridLines="DataGridGridLines.Both"
                AllowAlternatingRows="true"
                TItem="LoanPaymentLineVm">
    <Columns>
        <RadzenDataGridColumn Title="#" Context="c" Property="@nameof(LoanPaymentLineVm.Id)" Width="3rem">
            <Template>
                @{
                    var index = Schedule.PaymentLines.IndexOf(c) + 1;
                }
                @index
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Principle"
                              Property="@nameof(LoanPaymentLineVm.PaidPrinciple)"
                              Context="c"
                              Width="8rem">
            <Template>
                @c?.PaidPrinciple
            </Template>
            <FooterTemplate>
                @Schedule.PaymentLines?.Sum(x => x.PaidPrinciple).Format(CurrencyId)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Interest"
                              Context="c"
                              Property="@nameof(LoanPaymentLineVm.PaidInterest)"
                              TextAlign="TextAlign.Right"
                              Width="8rem">
            <Template>
                @c?.PaidInterest
            </Template>
            <FooterTemplate>
                @Schedule.PaymentLines?.Sum(x => x.PaidInterest).Format(CurrencyId)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="CollectionFee"
                              Context="c"
                              TextAlign="TextAlign.Right"
                              Property="@nameof(LoanPaymentLineVm.PaidCollectionFee)"
                              Width="8rem">
            <Template>
                @c?.PaidCollectionFee
            </Template>
            <FooterTemplate>
                @Schedule.PaymentLines?.Sum(x => x.PaidCollectionFee).Format(CurrencyId)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="PenaltyAmount"
                              Context="c"
                              TextAlign="TextAlign.Right"
                              Property="@nameof(LoanPaymentLineVm.PenaltyAmount)"
                              Width="8rem">
            <Template>
                @c?.PenaltyAmount
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="SubTotal"
                              Context="c"
                              TextAlign="TextAlign.Right"
                              Property="@nameof(LoanPaymentLineVm.SubTotal)"
                              Width="8rem">
            <Template>
                @c?.SubTotal
            </Template>
            <FooterTemplate>
                <strong>
                    @Schedule?.Total.Format(CurrencyId)
                </strong>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Recieve Date"
                              Context="c"
                              TextAlign="TextAlign.Right"
                              Property="@nameof(LoanPaymentLineVm.Created)"
                              Width="8rem">
            <Template>
                @c?.Created.DayFirst()
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>