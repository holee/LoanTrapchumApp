@page "/App/Loans/{BranchId:int}/Branches/{LoanId}/Schedules"
@using Applications.Features.LoanPayments.Requests
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Pages.Transactions.Exchanges
@using TrapchumApp.Pages.Transactions.Loans.Disbursements
@using TrapchumApp.Pages.Transactions.Loans.Menu
<PageTitle>Repayment</PageTitle>
<LoanInfos BranchId="@BranchId"
           LoanId="@LoanId"
           Currency="@CurrencyId"
           LoanSchedule="@LoanSchedule" @key="@(Guid.NewGuid().ToString())">
    <ChildContent>
        <RadzenButton Text="Exchange"
                      Visible="@_isPaymentTab"
                      Size="ButtonSize.ExtraSmall"
                      Icon="@IconNames.CurrencyExchange"
                      Click="@ToggleExchangeChanged"
                      ButtonStyle="ButtonStyle.Secondary" />
    </ChildContent>
</LoanInfos>
<div class="rz-background-color-base-200 rz-m-0 rz-mt-2">
    <RadzenTabs SelectedIndex="@selectedIndex">
        <Tabs>
            <RadzenTabsItem Text="Loan Schedules" Icon="@IconNames.List">
                <RadzenFieldset class="rz-m-0 rz-background-color-base-200">
                    <div class="m-0 p-0 rz-background-color-base-200">
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     JustifyContent="JustifyContent.End"
                                     class="rz-mb-2"
                                     AlignItems="AlignItems.Center">
                            <AuthorizeView Policy="@Policies.MultiplePayment">
                                <Authorized>
                                    <div class="input-group">
                                        <div class="input-group-text">
                                            <RadzenCheckBox @bind-Value="@isAllowMultiplePayment"
                                                            TValue="bool"
                                                            Name="isAllowMultiplePayment"
                                                            Change="MultipleCheckChanged" />
                                        </div>
                                        <RadzenLabel Text="Multiple Payments" Component="isAllowMultiplePayment" class="rz-ml-2 rz-mt-1" />
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                            <RadzenFormField AllowFloatingLabel="true" Text="Date">
                                <ChildContent>
                                    <RadzenDatePicker @bind-Value="paymentDate" TValue="DateTime" disabled />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenStack>
                        <RadzenDataGrid TItem="VSchedule"
                                        Data="@schedules"
                                        Responsive
                                        Density="Density.Compact"
                                        SelectionMode="@gridSelectionMode"
                                        GridLines="DataGridGridLines.Both"
                                        @bind-Value="@_selectedSchedules"
                                        RowSelect="SelectedRowEvt"
                                        RowDeselect="DeSelectedRowEvt"
                                        AllowRowSelectOnRowClick="@allowRowSelected"
                                        IsLoading="isLoading"
                                        @ref="gridSchedule">
                            <Columns>
                                <RadzenDataGridColumn Width="3.5rem"
                                                      TextAlign="TextAlign.Center"
                                                      OrderIndex="0"
                                                      Sortable="false"
                                                      Context="s"
                                                      Visible="isAllowMultiplePayment"
                                                      Filterable="false">
                                    <Template>
                                        <RadzenCheckBox TabIndex="-1"
                                                        TriState="false"
                                                        Value="@(_selectedSchedules!.Any() && _selectedSchedules!.Contains(s))"
                                                        Change="@(arg=>CheckedChanged(arg,s))"
                                                        InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select item" }})"
                                                        TValue="bool" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Context="c"
                                                      Width="3rem"
                                                      Title="#"
                                                      OrderIndex="1"
                                                      TextAlign="TextAlign.Center"
                                                      Sortable="false">
                                    <Template>
                                        <input type="hidden" @bind="c.LoanId" />
                                        @c.InstallmentNo
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Width="12rem"
                                                      Context="c"
                                                      Title="ថ្ងៃត្រូវបង់ប្រាក់"
                                                      Sortable="false">
                                    <Template>
                                        <small>
                                            <strong>@c.PaymentDate.DayFirst()</strong>-<small>@c.PaymentDate.DayName()</small>
                                        </small>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Width="5rem"
                                                      Context="c"
                                                      TextAlign="TextAlign.Right"
                                                      Title="ចំនួនថ្ងៃយឺត"
                                                      Sortable="false">
                                    <Template>
                                        <small>
                                            @c.DayArrea
                                        </small>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                                      Context="c"
                                                      Title="ប្រាក់ដើមត្រូវបង់" Sortable="false">
                                    <Template>
                                        @c.LeftPrinciple.Format(CurrencyId)
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TextAlign="TextAlign.End"
                                                      Context="c"
                                                      Title="ការប្រាក់ត្រូវបង់" Sortable="false">
                                    <Template>
                                        @c.LeftInterestAmount.Format(CurrencyId)
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                                      Title="ប្រាក់ប្រសិទ្ធិភាពត្រូវបង់"
                                                      Context="c"
                                                      Sortable="false">
                                    <Template>
                                        @c.LeftCollectionFeeAmount.Format(CurrencyId)
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                                      Title="ប្រាក់ពីន័យ"
                                                      Context="c"
                                                      Sortable="false">
                                    <Template>
                                        @c.PenaltyAmount.Format(CurrencyId)
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                                      Property="TotalPay"
                                                      Title="សរុបប្រាក់ត្រូវបង់"
                                                      Context="c"
                                                      Sortable="false">
                                    <Template>
                                        @c.LeftAmount.Format(CurrencyId)
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TextAlign="TextAlign.Right"
                                                      Context="c"
                                                      Property="LoanOutstanding"
                                                      Title="ប្រាក់ដើមនៅសល់"
                                                      Sortable="false">
                                    <Template>
                                        @c.LoanOutstanding.Format(CurrencyId)
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TextAlign="TextAlign.Center"
                                                      Title="ស្ថានភាព"
                                                      Sortable="false"
                                                      Width="8rem"
                                                      Context="s">
                                    <Template>
                                        @s.ScheduleStatus
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TextAlign="TextAlign.Center"
                                                      Title="Actions"
                                                      Sortable="false"
                                                      Width="5rem"
                                                      Context="s">
                                    <Template>
                                        <RadzenButton Size="ButtonSize.ExtraSmall"
                                                      Variant="Variant.Text"
                                                      Click="((arg)=>ShowContextMenu(arg,s))"
                                                      Icon="@IconNames.MoreVert" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                    @if (!isAllowMultiplePayment)
                    {
                        <div class="rz-m-0 rz-py-2 rz-background-color-base-200">
                            <RadzenFieldset Text="តារាងសងប្រាក់">
                                <PaymentScedule SelectedSchedule="@SelectedSchedule" />
                            </RadzenFieldset>
                            <RadzenFieldset Text="Customer's Payment" class="rz-mt-2">
                                <RadzenRow AlignItems="AlignItems.Center">
                                    <RadzenColumn Size="3">
                                        <RadzenFormField Text="ប្រាក់ដើម">
                                            <Start>
                                                <RadzenCheckBox TValue="bool"
                                                                Name="PaidNow"
                                                                Disabled="disableIsPaidNow"
                                                                Change="@CheckPaymentChanged"
                                                                Value="@isPaidNow" />
                                            </Start>
                                            <ChildContent>
                                                <RadzenNumeric TextAlign="TextAlign.End"
                                                               TValue="decimal?"
                                                               ShowUpDown="false"
                                                               class="rz-w-auto"
                                                               Format="#,##0.00"
                                                               onclick="this.querySelector('.rz-numeric-input').select()"
                                                               Disabled="!isPaidNow"
                                                               Min="0"
                                                               Max="@SelectedSchedule?.LeftPrinciple"
                                                               @oninput="PrincipleAmountValueChanged"
                                                               @bind-Value="_loanPaymentLine!.PaidPrinciple">
                                                </RadzenNumeric>
                                            </ChildContent>
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="3">
                                        <RadzenFormField Text="ការប្រាក់">
                                            <RadzenNumeric TextAlign="TextAlign.End"
                                                           TValue="decimal?"
                                                           Disabled="!isPaidNow"
                                                           Format="#,##0.00"
                                                           class="rz-w-auto"
                                                           Min="0"
                                                           Max="@SelectedSchedule?.LeftInterestAmount"
                                                           onclick="this.querySelector('.rz-numeric-input').select()"
                                                           ShowUpDown="false"
                                                           @oninput="InterestAmountValueChanged"
                                                           @bind-Value="_loanPaymentLine!.PaidInterest">
                                            </RadzenNumeric>
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="3">
                                        <RadzenFormField Text="ប្រាក់ប្រសិទ្ធិភាព">
                                            <RadzenNumeric TextAlign="TextAlign.End"
                                                           TValue="decimal?"
                                                           Disabled="!isPaidNow"
                                                           class="rz-w-auto"
                                                           Format="#,##0.00"
                                                           Min="0"
                                                           onclick="this.querySelector('.rz-numeric-input').select()"
                                                           @bind-Value="_loanPaymentLine!.PaidCollectionFee"
                                                           @oninput="CollectionFeeAmountValueChanged"
                                                           Max="@SelectedSchedule?.LeftCollectionFeeAmount"
                                                           ShowUpDown="false" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="3">
                                        <RadzenFormField Text="ប្រាក់ពិន័យ">
                                            <RadzenNumeric TextAlign="TextAlign.End"
                                                           TValue="decimal?"
                                                           Format="#,##0.00"
                                                           class="rz-w-auto"
                                                           Min="0"
                                                           onclick="this.querySelector('.rz-numeric-input').select()"
                                                           @bind-Value="_loanPaymentLine!.PaidPenaltyAmount"
                                                           Disabled="!isPaidNow"
                                                           Max="@SelectedSchedule?.PenaltyAmount"
                                                           ShowUpDown="false" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>
                                <RadzenRow class="rz-mt-2" AlignItems="AlignItems.Center">
                                    <RadzenColumn Size="3" Offset="6">
                                        <RadzenFormField Text="Reciept No">
                                            <RadzenTextBox @bind-Value="@_loanPaymentLine.OfficialReceiptNo"
                                                           class="rz-w-100" />
                                        </RadzenFormField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="3">
                                        <RadzenFormField Text="Total">
                                            <ChildContent>
                                                <RadzenNumeric Value="@_loanPaymentLine?.TotalWithPenalty"
                                                               ShowUpDown="false"
                                                               Format="#,##0.00"
                                                               class="rz-m-0 rz-p-0"
                                                               Disabled />
                                            </ChildContent>
                                        </RadzenFormField>
                                    </RadzenColumn>
                                </RadzenRow>
                            </RadzenFieldset>
                            @if (isAllowMultiplePayment)
                            {
                                <RadzenFieldset Text="ព័ត‌៌មានទូទាត់ប្រាក់" class="rz-mt-2">
                                    <PaymentLines @ref="@paymentLinesRef"
                                                  Remove="@OnRemoveAdded"
                                                  LoanRepaymentLines="LoanPaymentLines" />
                                </RadzenFieldset>

                            }
                        </div>
                    }
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 JustifyContent="JustifyContent.End"
                                 class="rz-mt-3"
                                 Gap="1rem"
                                 AlignItems="AlignItems.Center">
                        <AuthorizeView Policy="@Policies.MultiplePayment">
                            <Authorized>
                                <RadzenButton Icon="@IconNames.Paid"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Click="@ApplyMultipleSchedulePayment"
                                              Visible="isAllowMultiplePayment"
                                              Text="ApplySchedulePayment" />
                            </Authorized>
                        </AuthorizeView>
                        <RadzenButton Icon="save"
                                      Size="ButtonSize.Small"
                                      ButtonStyle="ButtonStyle.Success"
                                      Click="@ApplySchedulePayment"
                                      Visible="!isAllowMultiplePayment"
                                      Text="Applied Payment" />
                        <RadzenLink Path="@_navService.PreviousUrl"
                                    Text="Cancel" />
                    </RadzenStack>
                </RadzenFieldset>
            </RadzenTabsItem>
            @foreach (var item in _tabs)
            {
                <RadzenTabsItem @key="@item.Key" Icon="@item.Icon" Text="@item.Title">
                    <Template>
                        <ClosedTab TabId="@item.Key" Title="@item.Title" Closed="(() => CloseTab(item.Key))" />
                    </Template>
                    <ChildContent>
                        @item.Content
                    </ChildContent>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
</div>

@code {
    private List<CustomTab> _tabs = [];

    private void AddMultiplePaymentTab(IEnumerable<VSchedule>? Schedules, LoanPaymentDtoCreate? LoanPayment)
    {
        var newKey = $"{LoanPayment?.LoanRefId}_details";

        var existingIndex = _tabs.FindIndex(x => x.Key == newKey);

        if (existingIndex != -1)
        {
            _tabs.RemoveAt(existingIndex);
        }

        RenderFragment content = builder =>
        {
            builder.OpenComponent(0, typeof(PaymentMultiples));
            builder.AddAttribute(1, "Schedules", Schedules);
            builder.AddAttribute(2, "LoanPayment", LoanPayment);
            builder.AddAttribute(3, "CurrencyId", CurrencyId);
            builder.AddAttribute(4, "OnClose", EventCallback.Factory.Create(this, () =>
            {
                CloseTab(newKey);
            }));
            builder.SetKey(newKey);
            builder.CloseComponent();
        };

        var newTab = new CustomTab(newKey, "Multiple Payment", TabActions.Details, content);

        _tabs.Add(newTab);

        selectedIndex = _tabs.Count;

    }



    private void AddPaymentTab(string? loanId, long? scheduleId)
    {
        var newKey = $"{loanId}_{scheduleId}_details";

        var existingIndex = _tabs.FindIndex(x => x.Key == newKey);

        if (existingIndex != -1)
        {
            selectIndex = existingIndex + 1;
            return;
        }

        RenderFragment content = builder =>
        {


        };

        var newTab = new CustomTab(newKey, "Schedule Details", TabActions.Details, content);

        _tabs.Add(newTab);

        selectedIndex = _tabs.Count;

    }


    private void CloseTab(string? key)
    {
        var tab = _tabs.FirstOrDefault(t => t.Key == key);

        if (tab != null)
        {
            var idx = _tabs.IndexOf(tab);

            _tabs.Remove(tab);

            selectedIndex = _tabs.Count; //Math.Max(0, idx);
        }

    }



    void ShowContextMenu(MouseEventArgs args, VSchedule schedule)
    {
        ContextMenuService.Open(args,ds=>@<LoanDetailsMenu Schedule="@schedule" />);
    }

}



