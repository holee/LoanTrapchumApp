@using System.Threading.Tasks
@using Applications.Features.Loans.Queries.GetLoanSchedulesByPaymentDate
@using Applications.Responses.Paginations
@using TrapchumApp.Helpers.Enums
@using TrapchumApp.Helpers.Options
@using TrapchumApp.Pages.Lists
@using TrapchumApp.Pages.Transactions.Loans.Menu

<GridToolbar SearchChanged="@TextLoanSearchChanged">
    <LeftChildren>
        <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal">
            <RadzenFormField Text="Filter By">
                <RadzenDropDown Data="@Filters.ScheduleFilters"
                                @bind-Value="@_selectedFilter"
                                ValueProperty="@nameof(ListItem.Id)"
                                TextProperty="@nameof(ListItem.Name)"
                                Change="@OnFilterChanged"
                                Style="width:50%;"
                                TValue="int">
                </RadzenDropDown>
            </RadzenFormField>

            @if (_selectedFilter == (int)ScheduleFilter.MonthToDate ||
                        _selectedFilter == (int)ScheduleFilter.NextWeek)
            {
                <RadzenFormField Text="Start" AllowFloatingLabel="true">
                    <RadzenDatePicker TValue="DateTime?"
                                      DateFormat="dd/MM/yyy"
                                      Change="@OnStartDateChanged"
                                      @bind-Value="@_start" />
                </RadzenFormField>
                <RadzenFormField Text="End" AllowFloatingLabel="true">
                    <RadzenDatePicker TValue="DateTime?" DateFormat="dd/MM/yyy" @bind-Value="@_end" />
                </RadzenFormField>
            }
        </RadzenStack>
    </LeftChildren>
    <RightChildren>
        <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal">

        </RadzenStack>
    </RightChildren>
</GridToolbar>
<RadzenDataGrid Data="@ScheduleItems"
                TItem="VSchedule"
                Count="@counts"
                PageSize="@pageSize"
                Density="Density.Compact"
                GridLines="DataGridGridLines.Both"
                LoadData="LoadData"
                AllowSorting="false"
                RowSelect="RowSelected"
                Responsive="true"
                PagerPosition="PagerPosition.Bottom"
                ShowPagingSummary="true"
                PagerHorizontalAlign="HorizontalAlign.Right"
                IsLoading="@isLoading"
                AllowRowSelectOnRowClick="true"
                PageSizeOptions="@StorageConstant.PageSizeOptions"
                PageSizeChanged="@ChangedPageSize"
                RowRender="@OnRowRender"
                CellRender="@RowRenderChanged"
                AllowPaging="true">
    <Columns>
        <RadzenDataGridColumn Context="p"
                              Width="3rem"
                              Title="#"
                              Sortable="false">
            <Template>
                @(ScheduleItems.IndexOf(p) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="Payment"
                              Context="p"
                              Title="Date"
                              Width="6rem"
                              Sortable="true">
            <Template>
                @p.PaymentDate.DayFirst()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="DayArrea"
                              Context="p"
                              Title="Day Arrea"
                              Width="6rem"
                              TextAlign="TextAlign.Center"
                              Sortable="true">
            <Template>
                @p.DayArrea
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Property="Name"
                              Title="Name"
                              Sortable="true">
            <Template>
                <KhmerName AltName="@p.AltName" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Principle"
                              Property="Principle"
                              TextAlign="TextAlign.Right"
                              Width="8rem"
                              Sortable="true">
            <Template>
                @p.Principle.Format(p.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Interest"
                              Property="InterestRate"
                              Width="8rem"
                              TextAlign="TextAlign.Right"
                              Sortable="true">
            <Template>
                @p.Interest
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Fee"
                              Property="PaidPrinciple"
                              Width="8rem"
                              TextAlign="TextAlign.Right"
                              Sortable="true">
            <Template>
                @p.CollectionFee.Format(p.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Penalty"
                              Property="PenaltyAmount"
                              Width="8rem"
                              TextAlign="TextAlign.Right"
                              Sortable="true">
            <Template>
                @if (p.PenaltyAmount > 0)
                {
                    <strong class="rz-color-danger">
                        @p.PenaltyAmount.FormatUp(2, p.CurrencyId!.Value)
                    </strong>
                }
                else
                {
                    @p.PenaltyAmount.FormatUp(2, p.CurrencyId!.Value)
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Total"
                              Property="TotalPay"
                              Width="8rem"
                              TextAlign="TextAlign.Right"
                              Sortable="true">
            <Template>
                @p.TotalPay.Format(p.CurrencyId)
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Context="p"
                              Title="Actions"
                              Width="7rem"
                              TextAlign="TextAlign.Center">
            <Template>
                <RadzenButton Size="ButtonSize.ExtraSmall"
                              Icon="more_vert"
                              Variant="Variant.Text"
                              Click="@((args)=>ShowContextMenuWithContent(args,p))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Visible="isProgess" ShowValue="false"
                                   ProgressBarStyle="ProgressBarStyle.Primary"
                                   Mode="ProgressBarMode.Determinate"></RadzenProgressBarCircular>
    </LoadingTemplate>
</RadzenDataGrid>
@code {

    void ShowContextMenuWithContent(MouseEventArgs args, VSchedule p)
    {
        ContextMenuService.Open(args, ds =>@<AllScheduleMenu ShowOnTab="true"
                 ShowLateScheduleDetails="@ShowLateDetails"
                 RecievePayment="@ShowRecievePayment"
                 Schedule="@p" />

    );
    }


    private void RowRenderChanged(DataGridCellRenderEventArgs<VSchedule> args)
    {
        switch (args.Data.DayArrea)
        {
            case >= 1 and <= 7:
                args.Attributes.Add("style", "background-color: orange; color: #721c24;"); // Light red background for late schedules
                break;
            case > 7 and <= 14:
                args.Attributes.Add("style", "background-color: orange; color: #856404;"); // Light orange background for schedules with more than 7 days late
                break;
            case > 14:
                args.Attributes.Add("style", "background-color: #E9D1FF; color: #856404;"); // Light yellow background for schedules with more than 14 days late
                break;
            default:
                args.Attributes.Add("style", "background-color: white; color: black;"); // Default style for non-late schedules
                break;
        }
    }

    void OnRowRender(RowRenderEventArgs<VSchedule> args)
    {
        //args.Attributes.Add("style", $"color:{(args.Data.PenaltyAmount > 0 ? "red" : "black")}");
    }

    async Task ShowLateDetails(VSchedule p)
    {
        ContextMenuService.Close();

        await ShowLateScheduleDetails.InvokeAsync(p);

        StateHasChanged();
    }

    async Task ShowRecievePayment(VSchedule p)
    {
        ContextMenuService.Close();

        await RecievePayment.InvokeAsync(p);

        StateHasChanged();
    }


}
