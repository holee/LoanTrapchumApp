@using System.Threading.Tasks
@using TrapchumApp.Pages.Transactions.Loans.Menu
<GridToolbar SearchChanged="@TextLoanSearchChanged">
    <RightChildren>
        <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal">
            <RadzenCheckBox TValue="bool"
                            @bind-Value="includeInactive"
                            @bind-Value:after="CheckedIncludeChanged"
                            Name="IncludeInactive" />
            <RadzenLabel Text="Include Inactive"
                         Component="IncludeInactive" class="rz-ms-2" />
        </RadzenStack>
    </RightChildren>
</GridToolbar>
<RadzenDataGrid Data="@ScheduleItems"
                TItem="VSchedule"
                Count="@counts"
                PageSize="@pageSize"
                Density="Density.Compact"
                GridLines="DataGridGridLines.Both"
                LoadData="LoadData"
                AllowSorting="false"
                RowSelect="RowSelected"
                Responsive="true"
                PagerPosition="PagerPosition.Bottom"
                ShowPagingSummary="true"
                PagerHorizontalAlign="HorizontalAlign.Right"
                IsLoading="@isLoading"
                AllowRowSelectOnRowClick="true"
                PageSizeOptions="@StorageConstant.PageSizeOptions"
                PageSizeChanged="@ChangedPageSize"
                RowRender="@OnRowRender"
                AllowPaging="true">
    <Columns>
        <RadzenDataGridColumn Context="p"
                              Width="3rem"
                              Title="#"
                              Sortable="false">
            <Template>
                @(ScheduleItems.IndexOf(p) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="Payment"
                              Context="p"
                              Title="Date"
                              Width="6rem"
                              Sortable="true">
            <Template>
                @p.PaymentDate.DayFirst()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="DayArrea"
                              Context="p"
                              Title="Day Arrea"
                              Width="6rem"
                              TextAlign="TextAlign.Center"
                              Sortable="true">
            <Template>
                @p.DayArrea
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Property="Name"
                              Title="Name"
                              Sortable="true">
            <Template>
                @p.AltName
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Principle"
                              Property="Principle"
                              TextAlign="TextAlign.Right"
                              Width="8rem"
                              Sortable="true">
            <Template>
                @p.Principle.Format(p.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Interest"
                              Property="InterestRate"
                              Width="8rem"
                              TextAlign="TextAlign.Right"
                              Sortable="true">
            <Template>
                @p.Interest
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Fee"
                              Property="PaidPrinciple"
                              Width="8rem"
                              TextAlign="TextAlign.Right"
                              Sortable="true">
            <Template>
                @p.CollectionFee.Format(p.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Penalty"
                              Property="PenaltyAmount"
                              Width="8rem"
                              TextAlign="TextAlign.Right"
                              Sortable="true">
            <Template>
                @if (p.PenaltyAmount > 0)
                {
                    <strong class="rz-color-danger">
                        @p.PenaltyAmount.FormatUp(2, p.CurrencyId!.Value)
                    </strong>
                }
                else
                {
                    @p.PenaltyAmount.FormatUp(2, p.CurrencyId!.Value)
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Total"
                              Property="TotalPay"
                              Width="8rem"
                              TextAlign="TextAlign.Right"
                              Sortable="true">
            <Template>
                @p.TotalPay.Format(p.CurrencyId)
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Context="p"
                              Title="Actions"
                              Width="7rem"
                              TextAlign="TextAlign.Center">
            <Template>
                <RadzenButton Size="ButtonSize.ExtraSmall"
                              Icon="more_vert"
                              Variant="Variant.Text"
                              Click="@((args)=>ShowContextMenuWithContent(args,p))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Visible="isProgess" ShowValue="false"
                                   ProgressBarStyle="ProgressBarStyle.Primary"
                                   Mode="ProgressBarMode.Determinate"></RadzenProgressBarCircular>
    </LoadingTemplate>
</RadzenDataGrid>
@code {
    void ShowContextMenuWithContent(MouseEventArgs args, VSchedule p)
    {
        ContextMenuService.Open(args, ds =>@<AllScheduleMenu ShowOnTab="true"
                 ShowLateScheduleDetails="@ShowLateDetails"
                 RecievePayment="@ShowRecievePayment"
                 Schedule="@p" />

    );
    }

    void OnRowRender(RowRenderEventArgs<VSchedule> args)
    {
        args.Attributes.Add("style", $"color:{(args.Data.PenaltyAmount > 0 ? "red" : "black")}");
    }

    async Task ShowLateDetails(VSchedule p)
    {
        ContextMenuService.Close();

        await ShowLateScheduleDetails.InvokeAsync(p);

        StateHasChanged();
    }

    async Task ShowRecievePayment(VSchedule p)
    {
        ContextMenuService.Close();

        await RecievePayment.InvokeAsync(p);

        StateHasChanged();
    }

}
