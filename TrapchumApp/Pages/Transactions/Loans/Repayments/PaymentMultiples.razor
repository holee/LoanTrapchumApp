<style>
    .pm-summary-card {
        background: var(--rz-base-background-color, #fff);
        border: 1px solid var(--rz-border-color, #e5e7eb);
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
    }

    .pm-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: .75rem;
    }

    @@media (max-width: 600px) {
        .pm-summary-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    .pm-stat {
        display: flex;
        flex-direction: column;
        gap: .15rem;
    }

    .pm-stat-label {
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--rz-text-secondary-color, #6b7280);
    }

    .pm-stat-value {
        font-size: .95rem;
        font-weight: 700;
        color: var(--rz-text-color, #111827);
    }

    .pm-stat-value.highlight {
        color: var(--rz-success, #16a34a);
    }

    .pm-customer-row {
        display: flex;
        align-items: center;
        gap: .5rem;
        padding-bottom: .75rem;
        margin-bottom: .75rem;
        border-bottom: 1px solid var(--rz-border-color, #e5e7eb);
    }

    .pm-customer-name {
        font-size: 1rem;
        font-weight: 700;
        color: var(--rz-text-color, #111827);
    }

    .table-cell-edited {
        position: relative;
    }

        .table-cell-edited::after {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 0;
            height: 0;
            border-top: 8px solid var(--rz-danger, #ef4444);
            border-left: 8px solid transparent;
        }
</style>

<div class="pm-summary-card">
    <div class="pm-customer-row">
        <RadzenIcon Icon="person" style="color:var(--rz-primary,#6366f1);font-size:1.2rem;" />
        <span class="pm-customer-name">@LoanPayment?.CustomerName</span>
    </div>
    <div class="pm-summary-grid">
        <div class="pm-stat">
            <span class="pm-stat-label">Paid Principle</span>
            <span class="pm-stat-value">@LoanPayment?.PaidPrinciple</span>
        </div>
        <div class="pm-stat">
            <span class="pm-stat-label">Paid Interest</span>
            <span class="pm-stat-value">@LoanPayment?.PaidInterest</span>
        </div>
        <div class="pm-stat">
            <span class="pm-stat-label">Paid Fee</span>
            <span class="pm-stat-value">@LoanPayment?.PaidFeeAmount</span>
        </div>
        <div class="pm-stat">
            <span class="pm-stat-label">Penalty</span>
            <span class="pm-stat-value">@LoanPayment?.PaidPenaltyAmount</span>
        </div>
        <div class="pm-stat" style="grid-column: span 2;">
            <span class="pm-stat-label">Total Amount</span>
            <span class="pm-stat-value highlight">@LoanPayment?.AmountWithPenalty</span>
        </div>
    </div>
</div>

<RadzenStack Orientation="Orientation.Horizontal"
             class="rz-mb-2"
             AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.End">
    <RadzenButton Text="Refresh"
                  Size="ButtonSize.ExtraSmall"
                  Click="Resets"
                  Icon="refresh"
                  Variant="Variant.Outlined"
                  ButtonStyle="ButtonStyle.Secondary" />
</RadzenStack>

<RadzenDataGrid TItem="VSchedule"
                Data="@_schedules"
                Responsive
                Density="Density.Compact"
                AllowFiltering="false"
                AllowPaging="false"
                AllowSorting="false"
                @ref="@gridPopup"
                CellClick="@OnCellClick"
                RowUpdate="@OnUpdateRow"
                GridLines="DataGridGridLines.Both"
                class="rz-border-radius-2">
    <Columns>
        <RadzenDataGridColumn Context="c"
                              Width="3rem"
                              Title="#"
                              OrderIndex="1"
                              TItem="VSchedule"
                              Property="@nameof(VSchedule.InstallmentNo)"
                              TextAlign="TextAlign.Center"
                              Sortable="false">
            <Template>
                <input type="hidden" @bind="c.LoanId" />
                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@c.InstallmentNo.ToString()" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="6rem"
                              Context="c"
                              Title="ថ្ងៃត្រូវបង់ប្រាក់"
                              Property="@nameof(VSchedule.PaymentDate)"
                              TItem="VSchedule"
                              Sortable="false">
            <Template>
                <small>@c.PaymentDate.DayFirst()</small>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                              Property="@nameof(VSchedule.LeftPrinciple)"
                              TItem="VSchedule"
                              Title="ប្រាក់ដើមត្រូវបង់"
                              Context="c"
                              Sortable="false">
            <Template Context="c">
                @c.LeftPrinciple.Format(c.CurrencyId)
            </Template>
            <FooterTemplate>
                <strong>@_schedules.Sum(x => x.LeftPrinciple).Format(CurrencyId)</strong>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TextAlign="TextAlign.End"
                              Context="c"
                              TItem="VSchedule"
                              Property="@nameof(VSchedule.LeftInterestAmount)"
                              Title="ការប្រាក់ត្រូវបង់"
                              Sortable="false">
            <Template>
                @c.LeftInterestAmount.Format(c.CurrencyId)
            </Template>
            <FooterTemplate>
                <strong>@_schedules.Sum(x => x.LeftInterestAmount).Format(CurrencyId)</strong>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                              Title="ប្រាក់ប្រសិទ្ធិភាពត្រូវបង់"
                              Context="c"
                              TItem="VSchedule"
                              Property="@nameof(VSchedule.LeftCollectionFeeAmount)"
                              Sortable="false">
            <Template>
                @c.LeftCollectionFeeAmount.Format(c.CurrencyId)
            </Template>
            <FooterTemplate>
                <strong>@_schedules.Sum(x => x.LeftCollectionFeeAmount).Format(CurrencyId)</strong>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                              Title="ប្រាក់ពីន័យ"
                              Context="c"
                              TItem="VSchedule"
                              Property="@nameof(VSchedule.PenaltyAmount)"
                              IsInEditMode="@IsEditing"
                              Sortable="false">
            <Template>
                @c.PenaltyAmount.Format(c.CurrencyId)
            </Template>
            <EditTemplate>
                <RadzenNumeric @ref="editor"
                               TValue="decimal?"
                               Change="@(args => OnPenaltyChange(args,c))"
                               @bind-Value="c.PenaltyAmount"
                               Style="width:100%;height:2.3rem;"
                               onclick="this.querySelector('.rz-numeric-input').select()"
                               ShowUpDown="false"
                               Min="0"
                               Format="#,#00.00"
                               InputAttributes="@(new Dictionary<string, object>() { { "aria-label", "Select Penalty Amount" } })" />
            </EditTemplate>
            <FooterTemplate>
                <strong>@_schedules.Sum(x => x.PenaltyAmount).Format(CurrencyId)</strong>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TextAlign="TextAlign.Right"
                              Title="សរុបប្រាក់ត្រូវបង់"
                              Context="c"
                              TItem="VSchedule"
                              Property="@nameof(VSchedule.TotalPay)"
                              Sortable="false">
            <Template>
                <strong>@c.LeftAmount.Format(c.CurrencyId)</strong>
            </Template>
            <FooterTemplate>
                <strong style="color:var(--rz-success,#16a34a);">@_schedules.Sum(x => x.LeftAmount).Format(CurrencyId)</strong>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TextAlign="TextAlign.Center"
                              Title=""
                              Context="c"
                              Width="3.5rem"
                              TItem="VSchedule"
                              Property="@nameof(VSchedule.LoanScheduleId)"
                              Sortable="false">
            <Template>
                <RadzenButton Icon="@IconNames.Undo"
                              Variant="Variant.Text"
                              ButtonStyle="ButtonStyle.Warning"
                              Click="@(()=>ResetIndividualSchedule(c))"
                              Size="ButtonSize.ExtraSmall" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

<RadzenStack Orientation="Orientation.Horizontal"
             JustifyContent="JustifyContent.End"
             class="rz-mt-3"
             Gap="0.75rem"
             AlignItems="AlignItems.Center">
    <RadzenButton Icon="@IconNames.Cancel"
                  Size="ButtonSize.Small"
                  Variant="Variant.Outlined"
                  ButtonStyle="ButtonStyle.Secondary"
                  Click="@CloseTab"
                  Text="Close" />
    <AuthorizeView>
        <Authorized>
            <RadzenButton Icon="@IconNames.Paid"
                          Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Success"
                          Click="ApplySchedulePayment"
                          Text="Receive" />
        </Authorized>
    </AuthorizeView>
</RadzenStack>

@code {
    async Task CloseTab()
    {
        await OnClose.InvokeAsync();
    }
}