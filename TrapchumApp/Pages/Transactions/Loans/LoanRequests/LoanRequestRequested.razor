@using Applications.Responses.ViewModels.Loans.Requests
@using TrapchumApp.Components.Pages.Transactions.Loans.LoanRequests.Links
@using TrapchumApp.Services
<PageDropDown PageSizeChanged="PageChanged"
              OnTextChanged="FilterTextChanged"
              ShowSearchBox="true">
    <LeftChildContent>
        <AuthorizeView Policy="@RequestsPolicies.Create">
            <Authorized>
                <RadzenLink Path="@createRequestUrl" Text="Request" Icon="add" />
            </Authorized>
        </AuthorizeView>
    </LeftChildContent>
</PageDropDown>
<RadzenDataGrid Data="LoanRequests"
                TItem="VLoanRequests"
                Responsive="true"
                AllowAlternatingRows="true"
                PagerHorizontalAlign="HorizontalAlign.Right"
                ColumnWidth="10rem"
                RowSelect="RowSelectedChanged"
                LoadData="LoadLoanData"
                Count="@counts"
                PageSize="@pageSize"
                Density="Density.Compact"
                IsLoading="isLoading"
                GridLines="DataGridGridLines.Both"
                AllowPaging="true"
                Style="height:30rem;min-height:30rem;max-height:45rem;--rz-grid-cell-line-height:1.4rem;"
                ShowPagingSummary="true">
    <Columns>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.RequestDate))"
                              Context="r"
                              Title="RequestDate">
            <Template>
                @r.RequestDate.DayFirst()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.AltName))" Title="Name" />
        <RadzenDataGridColumn Width="8rem" 
                    Property="@(nameof(VLoanRequests.BranchName))" 
                    Title="Branch Name" />
       
        <RadzenDataGridColumn Width="8rem" 
                        Property="@(nameof(VLoanRequests.CurrencyName))" 
                        Title="Currency" />
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.AprovedAmount))"
                              Context="r"
                              TextAlign="TextAlign.Right"
                              Title="Amount">
            <Template>
                @r.AprovedAmount.Format(r.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.Summiter))" Title="Summiter" />
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.AprovedBy))" Title="AprovedBy" />
        <RadzenDataGridColumn TextAlign="TextAlign.Right" Width="4rem" Property="@(nameof(VLoanRequests.InterestRate))" Title="Rate" />
        <RadzenDataGridColumn Title="Status" Context="r" Width="7rem" TextAlign="TextAlign.Center">
            <Template>
                <AuthorizeView Policy="@RequestsPolicies.Approve">
                    <Authorized>
                        <LinkRequestApproved BranchId="@BranchId"
                                         LoanRequest="@r"
                                          User="@_user"
                                         UserId="@UserId" />

                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="@($"App/Loan/{BranchId}/Branches/Request/Details?UserId={UserId}&CustomerId={r?.CustomerId}&LoanRequestId={r?.LoanRequestId}")">
                            <RadzenBadge Variant="Variant.Text"
                                         Style="font-size:0.7rem;"
                                         Text="@r?.Status" BadgeStyle="BadgeStyle.Success" />
                        </NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

