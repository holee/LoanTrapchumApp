@using System.Security.Claims
@using Applications.Enumerations
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.ViewModels.Loans.Requests
@using Infrastructures.Authorizations
@if (isAllow && LoanRequest?.StatusId == (int)RequestStatus.New)
{
    <NavLink href="@_requestLoanRequestUrl">
        <RadzenBadge Variant="Variant.Filled"
                     Style="font-size:0.7rem;"
                     Text="Request" BadgeStyle="BadgeStyle.Secondary" />
    </NavLink>
}
else
{
    <NavLink href="@_loanRequestDetailsUrl">
        <RadzenBadge Variant="Variant.Filled"
                     Style="font-size:0.7rem;"
                     Text="Details" BadgeStyle="BadgeStyle.Secondary" />
    </NavLink>
}
@code {
    [Parameter, EditorRequired] public VLoanRequests? LoanRequest { get; set; }
    [Parameter, EditorRequired] public int? BranchId { get; set; }
    [Parameter, EditorRequired] public string? CreditAgentId { get; set; }
    [Parameter] public ClaimsPrincipal? User { get; set; } = default!;
    string _loanRequestDetailsUrl = "";
    string _requestLoanRequestUrl = "";
    bool isAllow = false;
    Task<AuthenticationState> Auth { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if(User is not null)
        {
            isAllow = (await _authorizeService.AuthorizeAsync(User, LoanRequest, new SameUserRequestRequirement())).Succeeded;
        }

        await base.OnInitializedAsync();
    } 

    protected override void OnInitialized()
    {
        _loanRequestDetailsUrl = $"app/loan/{LoanRequest?.LoanRequestId}/request/{BranchId}/branches/{LoanRequest?.CustomerId}/details";
        //loanRequestDetailsUrl = $"/app/loan/{LoanRequest?.LoanRequestId}/request/{BranchId}/branches/details?CreditAgentId={CreditAgentId}&CustomerId={LoanRequest?.CustomerId}";
        _requestLoanRequestUrl = $"/app/loan/{LoanRequest?.LoanRequestId}/request/{BranchId}/branches/{LoanRequest?.CustomerId}/edit";
        base.OnInitialized();
    }

}

