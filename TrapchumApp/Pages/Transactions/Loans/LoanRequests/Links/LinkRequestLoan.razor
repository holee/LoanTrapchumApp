@using System.Security.Claims
@using Applications.Enumerations
@using Applications.Responses.ViewModels.Loans.Requests
@using Infrastructures.Authorizations
@using Microsoft.AspNetCore.Components.Authorization
@using TrapchumApp.Services
@if (isAllow && LoanRequest?.StatusId == (int)RequestStatus.New)
{
    <NavLink href="@loanRequestUrl">
        <RadzenBadge Variant="Variant.Filled"
                     Style="font-size:0.7rem;"
                     Text="Request" BadgeStyle="BadgeStyle.Secondary" />
    </NavLink>
}
else
{
    <NavLink href="@loanRequestDetailsUrl">
        <RadzenBadge Variant="Variant.Filled"
                     Style="font-size:0.7rem;"
                     Text="Details" BadgeStyle="BadgeStyle.Secondary" />
    </NavLink>
}
@code {
    [Parameter, EditorRequired] public VLoanRequests? LoanRequest { get; set; }
    [Parameter, EditorRequired] public int? BranchId { get; set; }
    [Parameter, EditorRequired] public string? CreditAgentId { get; set; }
    [Parameter] public ClaimsPrincipal? User { get; set; } = default!;
    string loanRequestDetailsUrl = "";
    string loanRequestUrl = "";
    bool isAllow = false;
    Task<AuthenticationState> Auth { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if(User is not null)
        {
            isAllow = (await _authorizeService.AuthorizeAsync(User, LoanRequest, new SameUserRequestRequirement())).Succeeded;
        }

        await base.OnInitializedAsync();
    } 

    protected override void OnInitialized()
    {
        loanRequestDetailsUrl = $"App/Loan/{BranchId}/Branches/Request/Details?UserId={CreditAgentId}&CustomerId={LoanRequest?.CustomerId}&LoanRequestId={LoanRequest?.LoanRequestId}";

        loanRequestUrl = $"/App/Request/{BranchId}/Branches/{CreditAgentId}/Customer/{LoanRequest?.CustomerId}/Edit?LoanRequestId={LoanRequest?.LoanRequestId}";
        
        base.OnInitialized();
    }

}

