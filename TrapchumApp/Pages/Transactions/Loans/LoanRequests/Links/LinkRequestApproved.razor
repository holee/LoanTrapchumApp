@using System.Security.Claims
@using Applications.Enumerations
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.ViewModels.Loans.Requests
@using Infrastructures.Authorizations
@using TrapchumApp.Helpers.Extensions
@using TrapchumApp.Services
@if (canApproved && (LoanRequest?.StatusId == (int)RequestStatus.Requested ||
                     LoanRequest?.StatusId == (int)RequestStatus.Checking))
{
    <NavLink href="@_checkloanRequestUrl">
        <RadzenBadge Variant="Variant.Filled"
                     Style="font-size:0.7rem;"
                     Text="Check" BadgeStyle="BadgeStyle.Secondary"/>
    </NavLink>
}
else
{
    <NavLink href="@_loanRequestDetailsUrl">
        <RadzenBadge Variant="Variant.Text"
                     Style="font-size:0.7rem;"
                     Text="Details" BadgeStyle="BadgeStyle.Secondary"/>
    </NavLink>
}


@code {
    [CascadingParameter] Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    [Parameter] public VLoanRequests? LoanRequest { get; set; }
    [Parameter] public string? UserId { get; set; }
    [Parameter] public int? BranchId { get; set; }
    [Parameter] public ClaimsPrincipal? User { get; set; } = default!;
    string _checkloanRequestUrl = "";
    string _loanRequestDetailsUrl = "";
    bool canApproved = false;

    protected override async Task OnInitializedAsync()
    {
        if (User is not null)
        {
            canApproved = (await _authorizeService.AuthorizeAsync(User, LoanRequest, new SameUserApprovedRequirement())).Succeeded;
        }

        if (string.IsNullOrEmpty(UserId))
        {
            UserId = (await AuthenticationState).GetUserId();
        }


        //"/app/loan/{LoanRequestId}/request/{BranchId:int}/branches/{CustomerId}/details"

        _checkloanRequestUrl = $"app/loan/{LoanRequest?.LoanRequestId}/request/{BranchId}/branches/{LoanRequest?.CustomerId}/details";

        _loanRequestDetailsUrl = $"app/loan/{LoanRequest?.LoanRequestId}/request/{BranchId}/branches/{LoanRequest?.CustomerId}/details";
        
        ///app/loan/{LoanRequestId}/request/{BranchId:int}/branches/details
        await base.OnInitializedAsync();
    }

}
