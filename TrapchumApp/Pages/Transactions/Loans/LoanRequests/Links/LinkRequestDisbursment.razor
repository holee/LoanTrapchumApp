@using Applications.Enumerations
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.ViewModels.Loans.Requests
@using TrapchumApp.Helpers.Extensions
@using TrapchumApp.Services
@if (LoanRequest?.StatusId == (int)RequestStatus.Approved)
{
    <NavLink href="@_disburseRequestLoanUrl">
        <RadzenBadge Variant="Variant.Filled"
                     BadgeStyle="BadgeStyle.Success"
                     Style="font-size:0.5rem;"
                     Text="Disburse"></RadzenBadge>
    </NavLink>
}
else
{
    <NavLink href="@_loanRequestDetailsUrl">
        <RadzenBadge Variant="Variant.Text"
                     BadgeStyle="BadgeStyle.Secondary"
                     Text="Details"></RadzenBadge>
    </NavLink>

}
@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    [Parameter, EditorRequired] public VLoanRequests? LoanRequest { get; set; }
    [Parameter, EditorRequired] public int? BranchId { get; set; }
    [Parameter] public string? UserId { get; set; } = string.Empty;
    string? _disburseRequestLoanUrl = "";
    string? _loanRequestDetailsUrl = "";
    protected override void OnInitialized()
    {
        //loanRequestDetailsUrl = $"app/loan/{LoanRequest?.LoanRequestId}/request/{BranchId}/branches/details?CreditAgentId={LoanRequest?.CreditAgentId}&CustomerId={LoanRequest?.CustomerId}";
        _loanRequestDetailsUrl = $"app/loan/{LoanRequest?.LoanRequestId}/request/{BranchId}/branches/{LoanRequest?.CustomerId}/details";
        _disburseRequestLoanUrl = $"/app/loan/request/{LoanRequest?.LoanRequestId}/disbursement/{BranchId}/branches/CreateNew?UserId={UserId}&CustomerRequestId={LoanRequest?.CustomerId}";
        ///app/loan/{LoanRequest?.LoanRequestId}/request/{BranchId}/branches/{LoanRequest?.CustomerId}/edit
    }

    protected override async Task OnInitializedAsync()
    {

        if (string.IsNullOrEmpty(UserId))
        {
            UserId = (await AuthenticationState).GetUserId();
        }

        await base.OnInitializedAsync();
    }
}
