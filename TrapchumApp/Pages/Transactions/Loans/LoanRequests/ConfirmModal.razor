@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Services
<div class="table-responsive rz-background-color-base-200 rz-p-2 rz-m-0">
    <EditForm @ref="@refEditForm" Model="@model">
        <FluentValidationValidator />
        <table class="table-sm">
            <tbody>
                <tr>
                    <th>
                        <input type="hidden" @bind="model!.CustomerId" />
                        <input type="hidden" @bind="model!.LoanRequestId" />
                        <input type="hidden" @bind="model!.BranchId" />
                        <input type="hidden" @bind="model!.AdminFeeAmount" />
                        Request Amount
                    </th>
                    <td>
                        <RadzenText TextAlign="TextAlign.Right"
                                    Text="@($"{Data?.RequestAmount}")" TagName="TagName.P" />
                    </td>
                </tr>
                <tr>
                    <th>Approve Amount</th>
                    <td>
                        <TCNumbers @bind-Value="model!.AprovedAmount" Min="0" />
                        <ValidationMessage For="()=>model.AprovedAmount" />
                    </td>
                </tr>
                <tr>
                    <th>Admin Fee</th>
                    <td>
                        <RadzenText TextAlign="TextAlign.Right"
                                    Text="@($"{Data?.AdminFeeAmount}")" TagName="TagName.P" />
                    </td>
                </tr>
                <tr>
                    <th>Customer</th>
                    <td>@Data?.AltName</td>
                </tr>
                <tr>
                    <th>Request By</th>
                    <td>@Data?.Summiter</td>
                </tr>
                <tr>
                    <th>Branch</th>
                    <td>@Data?.BranchName</td>
                </tr>
                <tr>
                    <th>Accept By</th>
                    <td>@Data?.AprovedBy</td>
                </tr>
                <tr>
                    <th> Note</th>
                    <td>
                        <RadzenTextArea class="rz-w-100" @bind-Value="model.Memo" />
                    </td>
                </tr>
            </tbody>
        </table>
        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End"
                     Orientation="Orientation.Horizontal">
            <RadzenButton Text="Save"
                          ButtonStyle="ButtonStyle.Success"
                          Click="HandleFormRequest"
                          Size="ButtonSize.ExtraSmall"
                          Icon="@IconNames.Save"></RadzenButton>
            <RadzenButton Text="Close"
                          ButtonStyle="ButtonStyle.Danger"
                          Size="ButtonSize.ExtraSmall"
                          Variant="Variant.Filled"
                          Click="@(()=>DialogService.Close(false))"
                          Icon="@IconNames.Cancel"></RadzenButton>
        </RadzenStack>
    </EditForm>
</div>

