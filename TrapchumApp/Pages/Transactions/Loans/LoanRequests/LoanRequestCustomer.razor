@using TrapchumApp.Services
<Containers Fluid>
    <table class="table table-bordered table-sm">
        <tbody>
            <tr>
                <th style="background-color:#F1F1F4" class="w-25">
                    Customer Name
                </th>
                <td>
                    @Customer?.AltName ( @Customer?.FullName )
                </td>
            </tr>
            <tr>
                <th style="background-color:#F1F1F4" class="w-25">
                    Phone
                </th>
                <td>
                    @Customer?.Phone
                </td>
            </tr>
            <tr>
                <th style="background-color:#F1F1F4" class="w-25">DateOfBirth</th>
                <td>
                    <span>
                        @Customer?.DateOfBirth
                    </span>
                </td>
            </tr>
            <tr>
                <th style="background-color:#F1F1F4" class="w-25">
                    Occupation
                </th>
                <td>
                    <span>
                        @Customer?.Occupation
                    </span>
                </td>
            </tr>
            <tr>
                <th style="background-color:#F1F1F4" class="w-25">ID Card</th>
                <td>
                    @Customer?.IdCard
                </td>
            </tr>
            <tr>
                <th style="background-color:#F1F1F4" class="w-25">
                    Circle
                </th>
                <td>
                    @Customer?.Circle
                </td>
            </tr>
            <tr>
                <th style="background-color:#F1F1F4" class="w-25">
                    Salutation
                </th>
                <td>
                    @Customer?.Salutation
                </td>
            </tr>
            <tr>
                <th style="background-color:#F1F1F4" class="w-25">
                    Address
                </th>
                <td>
                    @Customer?.ToString()
                </td>
            </tr>
            <tr>
                <th style="background-color:#F1F1F4" class="w-25">Income</th>
                <td>@Customer?.CustomerIncomes?.Sum(x => x?.IncomeAmount)</td>
            </tr>
            <tr>
                <th style="background-color:#F1F1F4" class="w-25">Expend</th>
                <td>
                    @Customer?.CustomerExpenses?.Sum(x => x?.ExpendAmount)
                </td>
            </tr>
        </tbody>
    </table>
</Containers>
@code {
    [Parameter] public VCustomerList? Customer { get; set; }
}
