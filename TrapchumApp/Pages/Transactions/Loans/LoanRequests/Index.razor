@page "/App/Loans/Requests/{BranchId:int}/Branches"
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Services
<PageTitle>Loan Request</PageTitle>
@attribute [MustHasPermission(Modules.LoanRequest, Feature.Read)]
<style>
    .rz-grid-table td .rz-cell-data {
        line-height: 1.5rem;
        font-size: 0.8rem;
    }
</style>
<Containers Fluid>
    <RadzenTabs SelectedIndexChanged="SelectedIndexChanged" RenderMode="TabRenderMode.Server">
        <Tabs>
            <RadzenTabsItem Icon="list" Text="All">
                <LoanRequestAll BranchId="@BranchId" UserId="@_userId" />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>

</Containers>

