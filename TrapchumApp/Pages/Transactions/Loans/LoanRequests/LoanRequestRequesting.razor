@using Applications.Responses.ViewModels.Loans.Requests
@using TrapchumApp.Pages.Transactions.Loans.Menu
<GridToolbar SearchChanged="@FilterTextChanged" Placeholder="Type something to search........">
</GridToolbar>
<RadzenDataGrid Data="LoanRequests"
                TItem="VLoanRequests"
                Responsive="true"
                AllowAlternatingRows="true"
                PagerHorizontalAlign="HorizontalAlign.Right"
                ColumnWidth="10rem"
                RowSelect="RowSelectedChanged"
                LoadData="LoadLoanData"
                Count="@counts"
                PageSize="@pageSize"
                Density="Density.Compact"
                IsLoading="isLoading"
                GridLines="DataGridGridLines.Both"
                AllowPaging="true"
                PageSizeOptions="@StorageConstant.PageSizeOptions"
                PageSizeChanged="@PageChanged"
                ShowPagingSummary="true">
    <Columns>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.RequestDate))"
                              Context="r"
                              Title="RequestDate">
            <Template>
                @r.RequestDate.DayFirst()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.AltName))" Title="Name" Context="c">
            <Template>
                <TrapchumApp.Pages.Lists.KhmerName AltName="@c.AltName" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.BranchName))" Title="Branch Name" />
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.Summiter))" Title="Summiter" />
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.CurrencyName))" Title="Currency" />
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.AprovedAmount))"
                              Context="r"
                              TextAlign="TextAlign.Right"
                              Title="Amount">
            <Template>
                @r.AprovedAmount.Format(r.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TextAlign="TextAlign.Right" Width="4rem" Property="@(nameof(VLoanRequests.InterestRate))" Title="Rate" />
        <RadzenDataGridColumn Title="Status" Context="r" Width="7rem" TextAlign="TextAlign.Center">
            <Template>
                <AuthorizeView Policy="@RequestsPolicies.Request">
                    <Authorized>
                        <LinkRequestLoan BranchId="@BranchId"
                                         LoanRequest="@r"
                                         User="@_user"
                                         CreditAgentId="@UserId" />
                    </Authorized>
                </AuthorizeView>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Actions"
                              Context="r" Width="4rem"
                              TextAlign="TextAlign.Center">
            <Template>
                <RadzenButton Size="ButtonSize.ExtraSmall"
                              Variant="Variant.Text"
                              Click="((args)=>ShowContextMenu(args,r))"
                              Icon="@IconNames.MoreVert">
                </RadzenButton>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    void ShowContextMenu(MouseEventArgs args, VLoanRequests loanRequest)
    {
        ContextMenuService.Open(args, ds =>@<LoanRequestMenu Request="@loanRequest" />);
    }

}



