@using Applications.Enumerations
@using Applications.Responses.ViewModels.Loans.Requests
@using TrapchumApp.Pages.Transactions.Loans.Menu
<GridToolbar SearchChanged="@FilterTextChanged" Placeholder="Type something to search........">
</GridToolbar>
<RadzenDataGrid Data="LoanRequests"
                TItem="VLoanRequests"
                Responsive="true"
                AllowAlternatingRows="true"
                PagerHorizontalAlign="HorizontalAlign.Right"
                ColumnWidth="10rem"
                RowSelect="RowSelectedChanged"
                LoadData="LoadLoanData"
                Count="@counts"
                PageSize="@pageSize"
                Density="Density.Compact"
                IsLoading="isLoading"
                GridLines="DataGridGridLines.Both"
                AllowPaging="true"
                PageSizeOptions="@StorageConstant.PageSizeOptions"
                PageSizeChanged="@PageChanged"
                ShowPagingSummary="true">
    <Columns>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.RequestDate))"
                              Context="r"
                              Title="RequestDate">
            <Template>
                @r.RequestDate.DayFirst()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.AltName))" Title="Name" Context="c">
            <Template>
                <TrapchumApp.Pages.Lists.KhmerName AltName="@c.AltName" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.BranchName))" Title="Branch Name" />
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.Summiter))" Title="Summiter" />
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.CurrencyName))" Title="Currency" />
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.AprovedAmount))"
                              Context="r"
                              TextAlign="TextAlign.Right"
                              Title="Amount">
            <Template>
                @r.AprovedAmount.Format(r.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TextAlign="TextAlign.Right" Width="4rem" Property="@(nameof(VLoanRequests.InterestRate))" Title="Rate" />
        <RadzenDataGridColumn Title="Status" Context="r" Width="7rem" TextAlign="TextAlign.Center">
            <Template>
                <AuthorizeView Policy="@Policies.RequestLoanRequest">
                    <Authorized>
                        <LinkRequestLoan BranchId="@BranchId"
                                         LoanRequest="@r"
                                         User="@_user"
                                         CreditAgentId="@_userId" />
                    </Authorized>
                </AuthorizeView>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Actions"
                              Context="r" Width="4rem"
                              TextAlign="TextAlign.Center">
            <Template>
                <RadzenButton Size="ButtonSize.ExtraSmall"
                              Variant="Variant.Text"
                              Click="((args)=>ShowContextMenu(args,r))"
                              Icon="@IconNames.MoreVert">
                </RadzenButton>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [CascadingParameter] CascadingAppState bState { get; set; } = default!;
    void ShowContextMenu(MouseEventArgs args, VLoanRequests Request)
    {
        if (Request is null) return;
        var requestNowUrl = $"/App/Loans/{Request.LoanRequestId}/Requests/{Request.BranchId}/Branches/{Request.CustomerId}/Details";
        var checkloanRequestUrl = $"App/Loans/{Request.LoanRequestId}/Requests/{Request.BranchId}/Branches/{Request.CustomerId}/Details";
        var loanRequestDetailsUrl = $"App/Loans/{Request.LoanRequestId}/Requests/{Request.BranchId}/Branches/{Request.CustomerId}/Details";
        var requestLoanRequestUrl = $"/App/Loans/{Request.LoanRequestId}/Requests/{Request.BranchId}/Branches/{Request.CustomerId}/Edit";
        var disburseRequestLoanUrl = $"/App/Loans/{Request.LoanRequestId}/Requests/{Request.BranchId}/Branches/{Request.CustomerId}/Disbursement/CreateNew?CustomerId={Request.CustomerId}";
        ContextMenuService.Open(args, ds =>@<RadzenMenu Style="font-size:0.8rem;">

        @if (bState.CanRequest)
        {
                <RadzenMenuItem Path="@requestNowUrl"
                                Visible="Request.StatusId == (int)RequestStatus.New" Icon="@IconNames.SendMoney" Text="Request Now" Value="@Request.CustomerId" />

                <RadzenMenuItem Visible="Request.StatusId == (int)RequestStatus.New"
                                Path="@requestLoanRequestUrl"
                                Icon="@IconNames.Edit"
                                Text="Edit Request" Value="@Request.CustomerId" />

                <RadzenMenuItem Visible="Request.StatusId == (int)RequestStatus.Rechecked"
                                Path="@requestLoanRequestUrl"
                                Icon="@IconNames.Edit"
                                Text="Review Request" Value="@Request.CustomerId" />
        }

        @if (bState.CanApproved)
        {
                <RadzenMenuItem Visible="Request.StatusId == (int)RequestStatus.Requested"
                                Path="@checkloanRequestUrl"
                                Icon="@IconNames.Info" Text="Approved Now" Value="@Request.CustomerId" />
        }

        @if (bState.CanDisbursed)
        {
                <RadzenMenuItem Visible="Request.StatusId == (int)RequestStatus.Approved"
                                Path="@disburseRequestLoanUrl"
                                Icon="@IconNames.Info" Text="Disburse Now" Value="@Request.CustomerId" />
        }

    <RadzenMenuItem Icon="@IconNames.Details"
                    Path="@loanRequestDetailsUrl"
                    Text="Request Details" Value="@Request.CustomerId" />
</RadzenMenu>
        );
    }








}

