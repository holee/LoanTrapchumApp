@using Applications.Features.LoanRequests.Services
@using Applications.Responses.Auths
@using Applications.Responses.Lists.Collaterals
@using Applications.Responses.Loans.Disbursements
@using Applications.Responses.ViewModels.Loans.Requests
@using Applications.Responses.ViewModels.OtherNames
@using Applications.Responses.ViewModels.Settings
@using Domains.Models.Loans
@using Microsoft.AspNetCore.Components.Web
@using Radzen.Blazor
@using Radzen.Blazor.Rendering
@using TrapchumApp.Services
<style type="text/css">
    .my-popup {
        display: none;
        position: absolute;
        overflow: hidden;
        height: 360px;
        width: 600px;
        border: var(--rz-panel-border);
        background-color: var(--rz-panel-background-color);
        box-shadow: var(--rz-panel-shadow);
        border-radius: var(--rz-border-radius)
    }
</style>
<RadzenFieldset>
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenRow AlignItems="AlignItems.Center" class="my-1">
                <RadzenColumn Size="4">
                    <RadzenLabel>អតិថិជន</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <input type="hidden" @bind="@Model.CustomerRefId" />
                    <RadzenTextBox @ref="@textBox" Value="@Model.FullName"
                                   @oninput="@OnInput"
                                   @onclick="OpenPopup"
                                   class="rz-w-100"
                                   ReadOnly="@(LoanRequestId.IsNotNullOrEmpty() || CustomerId.IsNotNullOrEmpty())"
                                   @onkeydown="@OnKeyDown" />
                    <Popup @ref="popup" id="popup" AutoFocusFirstElement="false"
                           class="my-popup">
                        <RadzenDataGrid @ref="grid" id="grid"
                                        TItem="VCustomerList"
                                        Data="@Customers"
                                        RowSelect="@OnRowSelect"
                                        Responsive="true"
                                        Density="Density.Compact"
                                        AllowSorting="true"
                                        Style="height:360px">
                            <Columns>
                                <RadzenDataGridColumn Property="@nameof(VCustomerList.CustomerId)"
                                                      Context="c"
                                                      Title="#">
                                    <Template>
                                        <span>@(Customers.ToList().IndexOf(c) + 1)</span>
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Property="@nameof(VCustomerList.FullName)"
                                                      Title="FullName" />
                                <RadzenDataGridColumn Property="@nameof(VCustomerList.Salutation)"
                                                      Title="Salutation" />
                                <RadzenDataGridColumn Property="@nameof(VCustomerList.AltName)"
                                                      Title="Name" />
                                <RadzenDataGridColumn Property="@nameof(VCustomerList.Phone)"
                                                      Title="Phone" />
                            </Columns>
                        </RadzenDataGrid>
                    </Popup>
                    <ValidationMessage For="@(() => Model.CustomerRefId)" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Start" class="rz-my-1">
                <RadzenColumn Size="4">
                    <RadzenLabel>ចំនួនទឹកប្រាក់ស្នើរសុំ</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="5">
                    <TCNumbers OnValueChanged="PrincipleValueChanged"
                               @bind-Value="Model.RequestAmount" />
                    <ValidationMessage For="@(() => Model.RequestAmount)" />
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenDropDown Data="StorageConstant.CurrencyTpes"
                                    class="rz-w-100"
                                    TValue="int?"
                                    TextProperty="@nameof(Items.Label)"
                                    ValueProperty="@nameof(Items.Value)"
                                    SelectedItemChanged="CurrencySelectedChanged"
                                    @bind-Value="Model.CurrencyRefId">
                    </RadzenDropDown>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" class="rz-my-1">
                <RadzenColumn Size="4">
                    <RadzenLabel>អ្នកយល់ព្រម</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenDropDown TextProperty="@nameof(VUserLoanSizes.FullName)"
                                    ValueProperty="@nameof(VUserLoanSizes.UserRefId)"
                                    class="rz-w-100"
                                    TValue="string"
                                    @bind-Value="Model.AprovedUserId"
                                    Data="@AprovedUsers">
                    </RadzenDropDown>
                    <ValidationMessage For="@(() => Model.AprovedUserId)" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" class="rz-my-1">
                <RadzenColumn Size="4">
                    <RadzenLabel>ប្រាក់ប្រសិទ្ធិភាព</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="4" class="input-group">
                    <RadzenFormField>
                        <ChildContent>
                            <TCNumbers @bind-Value="Model.CollectionFeeRate" />
                        </ChildContent>
                        <End>
                            <span class="input-group-text">%</span>
                        </End>
                    </RadzenFormField>

                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenFormField>
                        <ChildContent>
                            <RadzenDropDown Data="StorageConstant.CollectionFeeModes"
                                            class="form-select"
                                            TextProperty="@nameof(Items.Label)"
                                            SelectedItemChanged="SelectedChargeModeChanged"
                                            ValueProperty="@nameof(Items.Value)"
                                            @bind-Value="Model.CollectionFeeModeId">
                            </RadzenDropDown>
                        </ChildContent>
                        <End>
                            <span>/Month</span>
                        </End>
                    </RadzenFormField>

                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" class="rz-my-1">
                <RadzenColumn Size="4">
                    <RadzenLabel>អត្រាការប្រាក់</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenFormField>
                        <ChildContent>
                            <TCNumbers @bind-Value="Model.InterestRate" />
                        </ChildContent>
                        <End>
                            <span>%</span>
                        </End>
                    </RadzenFormField>
                </RadzenColumn>
                <ValidationMessage For="@(() => Model.InterestRate)" />
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Start" class="rz-my-1">
                <RadzenColumn Size="4">
                    <RadzenLabel>សេវារដ្ឋបាល</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenFormField>
                        <ChildContent>
                            <TCNumbers OnValueChanged="CalculateAdminFeeAmount"
                                       @bind-Value="Model.AdminFeeRate" />
                        </ChildContent>
                        <End>
                            <span>%</span>
                        </End>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenFormField>
                          <TCNumbers Disabled="true" @bind-Value="Model.AdminFeeAmount" />
                    </RadzenFormField>
                </RadzenColumn>
                <ValidationMessage For="@(() => Model.AdminFeeRate)" />
                <ValidationMessage For="@(() => Model.AdminFeeAmount)" />
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-1">
                <RadzenColumn Size="4">
                    <RadzenLabel>រយៈពេលខ្ចីប្រាក់</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="4">
                    @if (Model.InstallmentTypeId == 1)
                    {
                        <RadzenDropDown @bind-Value="Model.Installments"
                                        class="rz-w-100"
                                        Multiple="false"
                                        Data="StorageConstant.InstallemntOptions">
                        </RadzenDropDown>
                    }
                    else
                    {
                        <IntInput @bind-Value="Model.Installments" />
                    }

                    <ValidationMessage For="@(() => Model.Installments)" />
                </RadzenColumn>
                <RadzenColumn Size="4">
                    <RadzenDropDown TextProperty="@nameof(Items.Label)"
                                    ValueProperty="@nameof(Items.Value)"
                                    @bind-Value="Model.InstallmentTypeId"
                                    class="rz-w-100"
                                    Multiple="false"
                                    SelectedItemChanged="SelectedInstallmentChanged"
                                    Data="StorageConstant.InstallmentTypes">
                    </RadzenDropDown>
                </RadzenColumn>
            </RadzenRow>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <RadzenRow AlignItems="AlignItems.Center" class="rz-my-1">
                <RadzenColumn Size="4">
                    <RadzenLabel>ប្រភេទបង់រំលោះ</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenDropDown TValue="int?"
                                    @bind-Value="Model.RepaymentModeRefId"
                                    class="rz-w-100"
                                    TextProperty="@nameof(Items.Label)"
                                    ValueProperty="@nameof(Items.Value)"
                                    SelectedItemChanged="RepaymentModeSelectedChanged"
                                    Data="StorageConstant.RepaymentModes">
                    </RadzenDropDown>
                </RadzenColumn>
                <RadzenColumn Size="2">
                    <RadzenNumeric Disabled="@(Model.RepaymentModeRefId != 1)"
                                   @bind-Value="Model.PayEvery"
                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                   class="rz-w-100"
                                   Min="1"
                                   ShowUpDown="false"
                                   TValue="int?" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" class="rz-my-1">
                <RadzenColumn Size="4">
                    <RadzenLabel>ខ្ចីលើកទី</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenNumeric class="rz-w-100" ShowUpDown="false" @bind-Value="Model.Circle" Min="1"
                                   Disabled />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" class="rz-my-1">
                <RadzenColumn Size="4">
                    <RadzenLabel>ប្រភេទកម្ចី</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenDropDown @bind-Value="Model.LoanCategoryRefId"
                                    TextProperty="@nameof(LoanCategoryResponse.LoanCategoryCode)"
                                    ValueProperty="@nameof(LoanCategoryResponse.LoanCategoryId)"
                                    AllowFiltering="true"
                                    class="rz-w-100"
                                    Data="loanCategories">
                    </RadzenDropDown>
                    <ValidationMessage For="() => Model.LoanCategoryRefId" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" class="rz-my-1">
                <RadzenColumn Size="4">
                    <RadzenLabel>ថ្ងៃខ្ចីប្រាក់</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <TCDatePicker @bind-Value="Model.RequestDate"
                                  Changed="@((args) => ChangedDate(args))" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" class="rz-my-1">
                <RadzenColumn Size="4">
                    <RadzenLabel>ថ្ងៃបង់ប្រាក់លើកដំបូង</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <TCDatePicker @bind-Value="Model.FirstPaymentDate" />
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-2">
                <RadzenColumn Size="4">
                    <RadzenLabel>កំណត់សម្គាល់</RadzenLabel>
                </RadzenColumn>
                <RadzenColumn Size="8">
                    <RadzenTextArea class="rz-w-100" @bind-Value="Model.Remark" />
                </RadzenColumn>
            </RadzenRow>
        </RadzenColumn>
    </RadzenRow>
</RadzenFieldset>

@code
{
    RadzenTextBox textBox = default!;
    string? FullName = "";
    Popup popup = default!;
    RadzenDataGrid<VCustomerList> grid = default!;

    async Task OnRowSelect(VCustomerList? customer)
    {
        if (customer is null) return;

        if (CustomerId.IsNullOrEmpty())
        {
            Model.CustomerRefId = customer.CustomerId;

            Model.FullName = customer.FullName;

            //await SetCustomerId(customer.CustomerId);
        }
        await popup.CloseAsync();
    }


    int selectedIndex = 0;

    async Task OnInput(ChangeEventArgs args)
    {
        selectedIndex = 0;

        await GetCustomers(CustomerId, 25, filterText);

        filterText = args.Value!.ToString();

        Model.FullName = args.Value?.ToString() ?? string.Empty;

        if (string.IsNullOrEmpty(filterText))
        {
            Model.CustomerRefId = string.Empty;

            Model.FullName = string.Empty;
        }

        await grid.Reload();
    }

    async Task OnKeyDown(KeyboardEventArgs args)
    {
        var items = Customers;

        var popupOpened = await js.InvokeAsync<bool>("Radzen.popupOpened", "popup");

        var key = args.Code != null ? args.Code : args.Key;

        if (!args.AltKey && (key == "ArrowDown" || key == "ArrowUp"))
        {
            var result = await js.InvokeAsync<int[]>("Radzen.focusTableRow", "grid", key, selectedIndex, null, false);

            selectedIndex = result.First();
        }
        else if (args.AltKey && key == "ArrowDown" || key == "Enter" || key == "NumpadEnter")
        {
            if (popupOpened && (key == "Enter" || key == "NumpadEnter"))
            {

                Model.FullName = items.ElementAtOrDefault(selectedIndex)?.FullName;

                Model.CustomerRefId = items.ElementAtOrDefault(selectedIndex)?.CustomerId;

            }

            await popup.ToggleAsync(textBox.Element);
        }
        else if (key == "Escape" || key == "Tab")
        {
            await popup.CloseAsync();
        }
    }


    async Task OpenPopup(MouseEventArgs arg)
    {
        if (LoanRequestId.IsNotNullOrEmpty() || CustomerId.IsNotNullOrEmpty())
        {
            await popup.CloseAsync();

            return;
        }

        await GetCustomers(string.Empty, 10, filterText);

        await popup.ToggleAsync(textBox.Element);
    }


}