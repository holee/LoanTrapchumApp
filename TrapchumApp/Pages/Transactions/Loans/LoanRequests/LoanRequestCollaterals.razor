@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.ViewModels.Loans.Requests
@using TrapchumApp.Services
<RadzenFieldset>
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
            <RadzenIcon Icon="house" /><b>Collateral Information</b>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenRow Visible="@ShowCommand" AlignItems="AlignItems.Center">
            <RadzenColumn Size="8">
                @if (SearchBoxTemplate is not null)
                {
                    @SearchBoxTemplate
                }
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenStack Orientation="Orientation.Horizontal"
                            JustifyContent="JustifyContent.End">
                 <RadzenButton Text="Add New"
                              ButtonStyle="ButtonStyle.Primary"
                              Icon="add"
                              Click="@ClickedAdd"
                              Size="ButtonSize.Small"
                              Visible="@(ShowAdd && ShowCommand)"
                              ButtonType="ButtonType.Button"></RadzenButton>
        </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RadzenDataGrid GridLines="DataGridGridLines.Both"
                        Responsive
                        TItem="VLoanRequestCollateralLines"
                        Density="Density.Compact"
                        @ref="gridColaterals"
                        Style="min-height:15rem;height:15rem;max-height:15rem;"
                        Data="Collaterals">
            <Columns>
                <RadzenDataGridColumn Title="#"
                                      TextAlign="TextAlign.Center"
                                      Property="@(nameof(VLoanRequestCollateralLines.CollateralId))"
                                      Width="3rem" Context="g">
                    <Template>
                        <input type="hidden" @bind="@g.CollateralId" />
                        @(Collaterals.ToList().IndexOf(g) + 1)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="ReferenceNo" Property="@(nameof(VLoanRequestCollateralLines.ReferenceNo))" Context="c" />
                <RadzenDataGridColumn Title="Type" Property="@(nameof(VLoanRequestCollateralLines.TypeName))" Context="c" />
                <RadzenDataGridColumn Title="Owner" Property="@(nameof(VLoanRequestCollateralLines.OwnerName))" Context="c" />
                <RadzenDataGridColumn Title="Quantity" Property="@(nameof(VLoanRequestCollateralLines.Quantity))" Context="c" />
                @if (ShowRemove)
                {
                    <RadzenDataGridColumn Context="g" TextAlign="TextAlign.Center"
                                          Width="4rem" Property="ProInKhmer"
                                          Title="Action">
                        <Template>
                            <RadzenButton Icon="delete"
                                          Shade="Shade.Lighter"
                                          Size="ButtonSize.ExtraSmall"
                                          Click="()=>ClickedRemove(g)"
                                          Variant="Variant.Outlined" />
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    </ChildContent>
</RadzenFieldset>
@code{
    [Parameter] public RenderFragment? SearchBoxTemplate { get; set; } 
}