@using Applications.Responses.ViewModels.Loans.Requests
@using TrapchumApp.Services
<PageDropDown PageSizeChanged="PageChanged"
              OnTextChanged="FilterTextChanged"
              ShowSearchBox="true">
    <LeftChildContent>
        <AuthorizeView Policy="@RequestsPolicies.Request">
            <Authorized>
                <RadzenLink class="rz-button rz-button-sm rz-primary" Path="@createRequestUrl" Text="Request" Icon="add" />
            </Authorized>
        </AuthorizeView>
    </LeftChildContent>
</PageDropDown>
<RadzenDataGrid Data="LoanRequests"
                TItem="VLoanRequests"
                Responsive="true"
                AllowAlternatingRows="true"
                PagerHorizontalAlign="HorizontalAlign.Right"
                RowSelect="RowSelectedChanged"
                LoadData="LoadLoanData"
                Count="@counts"
                PageSize="@pageSize"
                Density="Density.Compact"
                IsLoading="isLoading"
                GridLines="DataGridGridLines.Both"
                AllowPaging="true"
                ShowPagingSummary="true">
    <Columns>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.RequestDate))"
                              Context="r"
                              Width="8rem"
                              Title="Date">
            <Template>
                @r.RequestDate.DayFirst()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.AltName))" Title="Name" />
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.BranchName))" Title="Branch Name" />
        <RadzenDataGridColumn Width="5rem"
                              Property="@(nameof(VLoanRequests.CurrencyName))" Title="Currency" />
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.AprovedAmount))"
                              Context="r"
                              TextAlign="TextAlign.Right"
                              Width="8rem"
                              Title="Amount">
            <Template>
                @r.AprovedAmount.Format(r.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.Summiter))" Title="Summiter" />
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.AprovedBy))" Title="Approved User" />
        <RadzenDataGridColumn TextAlign="TextAlign.Right" Width="4rem"
                              Property="@(nameof(VLoanRequests.InterestRate))" Title="Rate" />
        <RadzenDataGridColumn TextAlign="TextAlign.Right" Width="6rem"
                              Property="@(nameof(VLoanRequests.Status))"
                              Context="x"
                              Title="State">
            <Template>
                <RadzenBadge Variant="Variant.Text" BadgeStyle="@ChangeBadgeStyle(x.StatusId)">
                    @x.Status
                </RadzenBadge>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Action" Context="r"
                              Width="5rem"
                              TextAlign="TextAlign.Center">
            <Template>
                <AuthorizeView Policy="@RequestsPolicies.Request">
                    <Authorized>
                        <LinkRequestLoan BranchId="@BranchId"
                                         LoanRequest="@r"
                                         User="@_user"
                                         CreditAgentId="@UserId" />
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@RequestsPolicies.Disburse">
                    <Authorized>
                        <LinkRequestDisbursment LoanRequest="@r"
                                                BranchId="@BranchId"
                                                UserId="@UserId" />
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@RequestsPolicies.Approve">
                    <Authorized>
                        <LinkRequestApproved LoanRequest="@r"
                                             UserId="@UserId"
                                             User="@_user"
                                             BranchId="@BranchId" />
                    </Authorized>
                </AuthorizeView>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Visible="@isLoading" ShowValue="false"
                                   Mode="ProgressBarMode.Indeterminate"
                                   Value="100"
                                   ProgressBarStyle="ProgressBarStyle.Danger"></RadzenProgressBarCircular>
    </LoadingTemplate>
</RadzenDataGrid>

@code {

    BadgeStyle BadgeStyle = BadgeStyle.Primary;


    BadgeStyle ChangeBadgeStyle(int? state)
    {
        return state switch
        {
            1 => BadgeStyle.Danger, // Pending
            2 => BadgeStyle.Secondary, // Approved
            3 => BadgeStyle.Info, // Disbursed
            4 => BadgeStyle.Primary, // Rejected
            _ => BadgeStyle.Success,
        };
    }

}