@using Applications.Enumerations
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Responses.ViewModels.Loans.Requests
@using TrapchumApp.Pages.Transactions.Loans.LoanRequests
@using TrapchumApp.Pages.Transactions.Loans.Menu
<GridToolbar SearchChanged="@FilterTextChanged"
             @bind-Value="@filtertext"
             Placeholder="Type something to search........">
</GridToolbar>
<RadzenDataGrid Data="LoanRequests"
                TItem="VLoanRequests"
                Responsive="true"
                AllowAlternatingRows="true"
                AllowSorting="true"
                PagerHorizontalAlign="HorizontalAlign.Right"
                RowSelect="@RowSelectedChanged"
                LoadData="@LoadLoanData"
                Count="@counts"
                PageSize="@pageSize"
                Density="Density.Compact"
                IsLoading="isLoading"
                GridLines="DataGridGridLines.Both"
                AllowPaging="true"
                PageSizeOptions="StorageConstant.PageSizeOptions"
                PageSizeChanged="@PageChanged"
                RowRender="@OnRowRender"
                AllowColumnPicking="true"
                CellContextMenu="@OnCellContextMenu"
                ShowPagingSummary="true">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenLabel Text="Filter by Status:" />
            <RadzenDropDown Data="@_dropDownItrem"
                            TValue="string"
                            @bind-Value="SelectedStatus"
                            TextProperty="@nameof(BaseEnum.Name)"
                            SelectedItemChanged="@SelectedItemChanged"
                            ValueProperty="@nameof(BaseEnum.Name)">
            </RadzenDropDown>
        </RadzenStack>
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.RowIndex))"
                              Context="r"
                              Width="4rem"
                              Title="#">
            <Template>
                @r.RowIndex
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.RequestDate))"
                              Context="r"
                              Width="8rem"
                              Title="Date">
            <Template>
                @r.RequestDate.DayFirst()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.AltName))" Title="Name" Context="c">
            <Template>
                <TrapchumApp.Pages.Lists.KhmerName AltName="@c.AltName" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn 
                              Property="@(nameof(VLoanRequests.BranchName))" Title="Branch Name" />
        <RadzenDataGridColumn Width="8rem"
                              Property="@(nameof(VLoanRequests.CurrencyName))" Title="Currency" />
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.AprovedAmount))"
                              Context="r"
                              TextAlign="TextAlign.Right"
                              Width="9rem"
                              Title="Amount">
            <Template>
                @r.AprovedAmount.Format(r.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Visible="false"
                              Property="@(nameof(VLoanRequests.Summiter))" Title="Summiter" />
        <RadzenDataGridColumn Property="@(nameof(VLoanRequests.AprovedBy))"
                              Width="10rem"
                              Title="Approved User" />
        <RadzenDataGridColumn TextAlign="TextAlign.Right" Width="5rem"
                              Property="@(nameof(VLoanRequests.InterestRate))" Title="Rate" />
        <RadzenDataGridColumn TextAlign="TextAlign.Right" Width="6rem"
                              Property="@(nameof(VLoanRequests.Status))"
                              Context="x"
                              Sortable="false"
                              Title="State">
            <Template>
                <RadzenBadge Variant="Variant.Text" BadgeStyle="@ChangeBadgeStyle(x.StatusId)">
                    @x.Status
                </RadzenBadge>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="Action" Context="r"
                              Width="5rem"
                              Sortable="false"
                              TextAlign="TextAlign.Center">
            <Template>
                <AuthorizeView>
                    <Authorized>
                        <RadzenButton Size="ButtonSize.Small"
                                      Variant="Variant.Text"
                                      Click="@((arg)=>ShowLoanRequestMenu(arg,r))"
                                      Icon="@IconNames.MoreVert">
                        </RadzenButton>
                    </Authorized>
                </AuthorizeView>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Visible="@isLoading" ShowValue="false"
                                   Mode="ProgressBarMode.Indeterminate"
                                   Value="100"
                                   ProgressBarStyle="ProgressBarStyle.Danger"></RadzenProgressBarCircular>
    </LoadingTemplate>
</RadzenDataGrid>

@code {

    void ShowLoanRequestMenu(MouseEventArgs args, VLoanRequests Request)
    {
        var requestNowUrl = $"/App/Loans/{Request?.LoanRequestId}/Requests/{Request?.BranchId}/branches/{Request?.CustomerId}/Details";
        var checkloanRequestUrl = $"/App/Loans/{Request?.LoanRequestId}/Requests/{Request?.BranchId}/branches/{Request?.CustomerId}/Details";
        var loanRequestDetailsUrl = $"/App/Loans/{Request?.LoanRequestId}/Requests/{Request?.BranchId}/branches/{Request?.CustomerId}/Details";
        var requestLoanRequestUrl = $"/App/Loans/{Request?.LoanRequestId}/Requests/{Request?.BranchId}/branches/{Request?.CustomerId}/Edit";
        var disburseRequestLoanUrl = $"/App/Loans/Requests/{Request?.LoanRequestId}/Disbursements/{Request?.BranchId}/branches/CreateNew?CustomertId={Request?.CustomerId}";

        ContextMenuService.Open(args, ds =>@<RadzenMenu Style="font-size:0.8rem;">

        @if (bState.CanRequest && Request is not null)
        {
                <RadzenMenuItem Path="@requestNowUrl"
                                Visible="Request.StatusId == (int)RequestStatus.New"
                                Icon="@IconNames.SendMoney" Text="Request Now" Value="@Request.CustomerId" />
                <RadzenMenuItem Visible="Request.StatusId == (int)RequestStatus.New"
                                Path="@requestLoanRequestUrl"
                                Icon="@IconNames.Edit"
                                Text="Edit Request" Value="@Request.CustomerId" />
                <RadzenMenuItem Visible="Request.StatusId == (int)RequestStatus.Rechecked"
                                Path="@requestLoanRequestUrl"
                                Icon="@IconNames.Edit"
                                Text="Review Request" Value="@Request.CustomerId" />
        }

        @if (bState.CanApproved && Request is not null)
        {
                <RadzenMenuItem Visible="Request.StatusId == (int)RequestStatus.Requested"
                                Path="@checkloanRequestUrl"
                                Icon="@IconNames.Info" Text="Approved Now" Value="@Request.CustomerId" />
        }

        @if (bState.CanDisbursed && Request is not null)
        {
                <RadzenMenuItem Visible="Request.StatusId == (int)RequestStatus.Approved"
                                Path="@disburseRequestLoanUrl"
                                Icon="@IconNames.Info" Text="Disburse Now" Value="@Request.CustomerId" />
        }

        @if (Request is not null)
        {
                <RadzenMenuItem Icon="@IconNames.Details"
                                Path="@loanRequestDetailsUrl"
                                Text="Request Details" Value="@Request.CustomerId" />
        }

</RadzenMenu>
    );
    }




    void OnRowRender(RowRenderEventArgs<VLoanRequests> args)
    {
        args.Data.RowIndex = args.Index + 1;
    }

    BadgeStyle BadgeStyle = BadgeStyle.Primary;


    BadgeStyle ChangeBadgeStyle(int? state)
    {
        return state switch
        {
            1 => BadgeStyle.Danger, // Pending
            2 => BadgeStyle.Secondary, // Approved
            3 => BadgeStyle.Info, // Disbursed
            4 => BadgeStyle.Primary, // Rejected
            _ => BadgeStyle.Success,
        };
    }


    void OnCellContextMenu(DataGridCellMouseEventArgs<VLoanRequests> args)
    {
        var selectedRequest = args.Data as VLoanRequests;

        List<ContextMenuItem> items = new();

        if (bState.CanRequest && selectedRequest?.StatusId == (int)RequestStatus.New)
        {
            items.Add(new ContextMenuItem() { Text = "Request Now", Icon = "send_money", Value = 1, Disabled = selectedRequest?.StatusId != (int)RequestStatus.New });
            items.Add(new ContextMenuItem() { Text = "Edit Request", Icon = "edit", Value = 2, Disabled = selectedRequest?.StatusId != (int)RequestStatus.New });
        }
        else if (bState.CanRequest && selectedRequest?.StatusId == (int)RequestStatus.Rechecked)
        {
            items.Add(new ContextMenuItem() { Text = "Review Request", Icon = "edit", Value = 3, Disabled = selectedRequest?.StatusId != (int)RequestStatus.Rechecked });
        }

        if (bState.CanApproved && selectedRequest?.StatusId == (int)RequestStatus.Requested)
        {
            items.Add(new ContextMenuItem() { Text = "Approved Now", Icon = "check_circle", Value = 4 });
        }

        if (bState.CanDisbursed && selectedRequest?.StatusId == (int)RequestStatus.Approved)
        {
            items.Add(new ContextMenuItem() { Text = "Disburse", Icon = "attach_money", Value = 5 });
        }
        else if (bState.CanDisbursed && selectedRequest?.StatusId == (int)RequestStatus.Rechecking)
        {
            items.Add(new ContextMenuItem() { Text = "Disburse", Icon = "attach_money", Value = 5 });
        }

        items.Add(new ContextMenuItem() { Text = "Details Request", Icon = "info", Value = 6 });

        ContextMenuService.Open(args, items, (e) => OpenMenuItemSelected(e, selectedRequest));
    }

    void OpenMenuItemSelected(MenuItemEventArgs args, VLoanRequests? data)
    {

        ContextMenuService.Close();

        if (data is null) return;

        int selectedId = 0;

        if (Int32.TryParse(args.Value.ToString(), out selectedId))
        {
            switch (selectedId)
            {
                case 1:
                    NavigationManager.NavigateTo($"/App/Loans/{data.LoanRequestId}/Requests/{BranchId}/Branches/{data.CustomerId}/Details");
                    break;
                case 2:
                    NavigationManager.NavigateTo($"/App/Loans/{data.LoanRequestId}/Requests/{BranchId}/Branches/{data.CustomerId}/Edit");
                    break;
                case 3:
                    NavigationManager.NavigateTo($"/App/Loans/{data.LoanRequestId}/Requests/{BranchId}/Branches/{data.CustomerId}/Edit");
                    break;
                case 6:
                    NavigationManager.NavigateTo($"/App/Loans/{data.LoanRequestId}/Requests/{BranchId}/Branches/{data.CustomerId}/Details");
                    break;
                default:
                    break;
            }
            return;
        }

        // Handle menu item selection
    }



}
