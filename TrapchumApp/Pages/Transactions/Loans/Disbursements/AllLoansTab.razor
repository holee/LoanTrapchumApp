@using Applications.Responses.ViewModels.Loans
@using Microsoft.AspNetCore.Components.Web
@using TrapchumApp.Services
<PageDropDown PageSizeChanged="ChangedPageSize"
              OnTextChanged="TextLoanSearchChanged"
              ShowSearchBox="true">
    <RightChildContent>
        <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal">
            <RadzenCheckBox TValue="bool"
                            @bind-Value="includeInactive"
                            @bind-Value:after="CheckedIncludeChanged"
                            Name="IncludeInactive" />
            <RadzenLabel Text="Include Inactive"
                         Component="IncludeInactive" class="rz-ms-2" />
        </RadzenStack>
    </RightChildContent>
</PageDropDown>
<RadzenDataGrid Data="LoanItems"
                Count="@counts"
                PageSize="pageSize"
                Density="Density.Compact"
                GridLines="DataGridGridLines.Both"
                LoadData="LoadData"
                AllowSorting="true"
                Responsive="true"
                PagerPosition="PagerPosition.Bottom"
                ShowPagingSummary="true"
                PagerHorizontalAlign="HorizontalAlign.Right"
                IsLoading="isLoading"
                class="h-100"
                Style="min-height:30rem;height:30rem;max-height:35rem;"
                AllowRowSelectOnRowClick="true"
                AllowPaging="true">
    <Columns>
        <RadzenDataGridColumn Context="p"
                              Width="3rem"
                              Title="#"
                              Sortable="false">
            <Template>
                @(LoanItems.IndexOf(p) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="RegisterDate"
                              Context="p"
                              Title="Date"
                              Sortable="true">
            <Template>
                @p.RegisterDate!.Value.ToShortDateString()
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Property="AltName"
                              Title="Name"
                              Sortable="true">
            <Template>
                @p.AltName
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Principle"
                              Property="Principle"
                              TextAlign="TextAlign.Right"
                              Sortable="true">
            <Template>
                @p.Principle.Format(p.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Interest"
                              Property="InterestRate"
                              TextAlign="TextAlign.Right"
                              Sortable="true">
            <Template>
                @p.InterestRate (%) / @p.PeriodName
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Paid Principle"
                              Property="PaidPrinciple"
                              TextAlign="TextAlign.Right"
                              Sortable="true">
            <Template>
                @p.PaidPrinciple.Format(p.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="OutStanding"
                              Property="OutStanding"
                              TextAlign="TextAlign.Right"
                              Sortable="true">
            <Template>
                @p.OutStanding.Format(p.CurrencyId)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Agent"
                              Property="AgentName"
                              TextAlign="TextAlign.Start"
                              Sortable="true">
            <Template>
                @p.AgentName
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Status"
                              Property="LoanStatus"
                              Width="6rem"
                              TextAlign="TextAlign.Center"
                              Sortable="true">
            <Template>
                @p.LoanStatus
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="p"
                              Title="Actions"
                              Width="6rem"
                              TextAlign="TextAlign.Start"
                              Sortable="true">
            <Template>
                <RadzenButton Size="ButtonSize.ExtraSmall"
                              Icon="more_vert"
                              Variant="Variant.Text"
                              Click="@((args)=>ShowContextMenuWithContent(args,p))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular Visible="isProgess" ShowValue="false"
                                   ProgressBarStyle="ProgressBarStyle.Danger"
                                   Mode="ProgressBarMode.Determinate"></RadzenProgressBarCircular>
    </LoadingTemplate>
</RadzenDataGrid>

@code {

    void ShowContextMenuWithContent(MouseEventArgs args, VLoanDisbursments p)
    {
        ContextMenuService.Open(args, ds =>@<RadzenMenu Style="font-size:0.8rem;">
        <RadzenMenuItem Icon="money"
                        Click="@(()=>GetPaymentSchedules(p))"
                        Text="Recieve Payment"></RadzenMenuItem>
        <RadzenMenuItem Icon="paid"
                        Click="@(()=>CustomerPayOff(p))"
                        Text="PayOff"></RadzenMenuItem>
        <RadzenMenuItem Icon="change_circle"
                        Click="@(()=>ChangeCreditAgent(p))"
                        Text="Change Credit Agent"></RadzenMenuItem>
        <RadzenMenuItem Icon="info"
                        Click="@(()=>GetLoanDetails(p))"
                        Text="Details"></RadzenMenuItem>
        <RadzenMenuItem Icon="file_download"
                        Click="@(()=>DownLoadScheduleAsExcel(p.LoanId,p.BranchId!.Value))"
                        Text="Export Loan to Excel" />
        <RadzenMenuItem Icon="picture_as_pdf"
                        Click="@(()=>DownLoadScheduleAsPdf(p.LoanId,p.BranchId!.Value))"
                        Text="Export Loan to Pdf" />
    </RadzenMenu>
    );
    }
}
