@page "/App/Loans/{LoanRequestId}/Disbursements/{BranchId:int}/Branches/CreateNew"
@using Applications.Enumerations
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Features.Loans.Requests
@using Domains.Enumerations
@using TrapchumApp.Helpers.Constants
@using TrapchumApp.Pages.Lists.Customers
@using TrapchumApp.Pages.Transactions.Loans.LoanRequests
@using TrapchumApp.Services
<PageTitle>New Loan Disbursment</PageTitle>
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
    <RadzenButton Size="ButtonSize.ExtraSmall"
                  Click="@ShowCustomerTab"
                  ButtonStyle="ButtonStyle.Primary" Text="Show Customer" />
</RadzenStack>
<RadzenFieldset AllowCollapse="false" Text="Disbursement Info.">
    <RadzenTabs SelectedIndex="selectedTabIndex" RenderMode="TabRenderMode.Client">
        <Tabs>
            <RadzenTabsItem Text="ព័ត៌មានប្រាក់កម្ចី" Icon="@IconNames.AddNew">
                <div class="rz-m-0 rz-p-0">
                    <EditForm Model="model" @ref="editForm">
                        <input type="hidden" @bind-value="penaltyRate" />
                        <input type="hidden" @bind="model.CustomerRefId" />
                        <input type="hidden" @bind="model!.CustomerRefId" />
                        <table class="table-sm">
                            <tbody>
                                <tr>
                                    <th class="rz-w-25">Customer</th>
                                    <td>

                                        <span>@model?.CustomerName</span>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Currency</th>
                                    <td>

                                        <span>@model?.CurrencyName</span>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Principle</th>
                                    <td>
                                        @model?.Principle.Format(model.CurrencyRefId)
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Installment Type</th>
                                    <td>
                                        <input type="hidden" @bind="model!.InstallmentType" />
                                        @model?.InstallmentType
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Repayment Mode</th>
                                    <td>
                                        <input type="hidden" @bind="model!.RepaymentModeRefId" />
                                        <span>
                                            @model?.RepaymentModeName
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Installments</th>
                                    <td>
                                        <input type="hidden" @bind="model!.Installments" />
                                        @model?.Installments @model?.InstallmentName
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Pay Every</th>
                                    <td>
                                        <input type="hidden" @bind="model!.PayEvery" />
                                        @model?.PayEvery @model?.InstallmentName
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Interest Rate</th>
                                    <td>
                                        <input type="hidden" @bind="model!.InterestRate" />
                                        <span>
                                            @model?.InterestRate
                                            <i>%</i>
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Effective Fee Rate</th>
                                    <td>
                                        <input type="hidden" @bind="model!.CollectionFeeRate" />
                                        <input type="hidden" @bind="model!.CollectionFeeModeId" />
                                        <span>
                                            @model?.CollectionFeeRate
                                            <i>%</i>
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Admin Fee Amount</th>
                                    <td>
                                        <input type="hidden" @bind="model!.AdminFeeRate" />
                                        <span>
                                            @model?.AdminFeeAmount
                                        </span>

                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Circle</th>
                                    <td>
                                        <input type="hidden" @bind="model!.Circle" />
                                        <span>
                                            @model?.Circle
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Loan Category</th>
                                    <td>
                                        <input type="hidden" @bind="model!.LoanCategoryRefId" />
                                        @model?.LoanCategoryName
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Request By</th>
                                    <td>
                                        <input type="hidden" @bind="model!.CreditAgentRefId" />
                                        @model?.CreditAgentName
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Approved By</th>
                                    <td>
                                        <input type="hidden" @bind="model!.AprovedUserId" />
                                        @model?.ApprovedBy
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Changed Payment Scedule to</th>
                                    <td>
                                        <RadzenRadioButtonList @bind-Value="model!.PayementSechuleModeId"
                                                               TValue="int"
                                                               Change="OnScheduleChanged">
                                            <Items>
                                                <RadzenRadioButtonListItem Text="Before" Value="1" />
                                                <RadzenRadioButtonListItem Text="After" Value="2" />
                                                <RadzenRadioButtonListItem Text="Skip" Value="3" />
                                            </Items>
                                        </RadzenRadioButtonList>
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Register Date</th>
                                    <td>
                                        <RadzenDatePicker DateFormat="dd/MM/yyyy"
                                                          @bind-Value:format="yyyy/MMM/dd"
                                                          @bind-Value="model!.RegisterDate" />
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Start Date</th>
                                    <td>
                                        <RadzenDatePicker DateFormat="dd/MM/yyyy"
                                                          @bind-Value:format="yyyy/MMM/dd"
                                                          Change="OnStartDateChanged"
                                                          @bind-Value="model!.StartDate" />
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">First Payment</th>
                                    <td>
                                        <RadzenDatePicker DateFormat="dd/MM/yyyy"
                                                          @bind-Value:format="yyyy/MMM/dd"
                                                          @bind-Value="model!.FirstPaymentDate" />
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Last Payment</th>
                                    <td>
                                        <input type="hidden" @bind="model!.LastPaymentDate" />
                                        @model?.LastPaymentDate.DayFirst()
                                    </td>
                                </tr>
                                <tr>
                                    <th class="rz-w-25">Note</th>
                                    <td>
                                        <RadzenTextArea Style="resize:none;" class="rz-w-100" @bind-Value="model!.Remark"></RadzenTextArea>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </EditForm>
                </div>
            </RadzenTabsItem>
            <RadzenTabsItem Text="អ្នកធានានិងទ្រព្យបញ្ចាំ" Icon="@IconNames.Inventory">
                <LoanRequestCollaterals CustomerId="CustomerRequestId"
                                        Collaterals="@req.Collaterals?.ToList()"
                                        ShowAdd="false" />
                <LoanRequestGaurantor Guarantors="@req.Guarantors" ShowAdd="false" />
                <LoanRequestDocument Documents="@req.Documents.ToList()" ShowUpload="false" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Notes" Icon="@IconNames.Comment">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="12">
                        <RadzenTextArea Rows="6" class="rz-w-100" @bind-Value="@memo">

                        </RadzenTextArea>
                    </RadzenColumn>
                </RadzenRow>
                <LoanRequestNotes Data="@req.Descriptions" />
            </RadzenTabsItem>
            @foreach (var tab in _tabs)
            {
                <RadzenTabsItem Text="@tab.Title" Icon="@tab.Icon" @key="@tab.Key">
                    <Template>
                        <ClosedTab Title="@tab.Title" TabId="@tab.Key" Closed="() => CloseTab(tab.Key)" />
                    </Template>
                    <ChildContent>
                        @tab.Content
                    </ChildContent>
                </RadzenTabsItem>
            }
        </Tabs>
    </RadzenTabs>
    <RadzenStack Gap="1rem"
                 Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 class="rz-my-2"
                 AlignItems="AlignItems.Center">

        @if (!disburseStatus && RequestStatusId == (int)RequestStatus.Approved)
        {
            <RadzenButton Click="@SaveLoanDisbursement"
                          Size="ButtonSize.Small"
                          Icon="save"
                          ButtonStyle="ButtonStyle.Primary" Text="Save" />
            <RadzenButton Size="ButtonSize.Small"
                          Click="HandleFormSubmit"
                          Text="Disburse Now"
                          Icon="@IconNames.Save"
                          ButtonStyle="ButtonStyle.Success" />
            <RadzenButton Click="SendRechecked"
                          Size="ButtonSize.Small"
                          Icon="@IconNames.Undo"
                          ButtonStyle="ButtonStyle.Secondary" Text="Rechecked" />
            <RadzenButton Click="ShowLoanPreviews"
                          Size="ButtonSize.Small"
                          Icon="@IconNames.Preview"
                          ButtonStyle="ButtonStyle.Primary" Text="Preview" />
        }
        <RadzenLink Icon="arrow_back"
                    Path="@_navService.PreviousUrl"
                    Text="Back" />
    </RadzenStack>
</RadzenFieldset>
@code {

    private List<CustomTab> _tabs = [];

    void OnScheduleChanged(int arg)
    {
        model.ScheduleMode = arg switch
        {
            1 => AdjustmentOption.Before,
            2 => AdjustmentOption.After,
            _ => AdjustmentOption.Skip
        };
    }


    void ShowCustomerTab()
    {
        var tabId = "customer_" + (_customer.CustomerId ?? Guid.NewGuid().ToString("N"));

        var exists = _tabs.FindIndex(t => t.Key == tabId);

        if (exists != -1)
        {
            selectedTabIndex = exists + 3; // +3 to account for existing tabs
            StateHasChanged();
            return;
        }

        RenderFragment content = builder =>
        {
            builder.OpenComponent(0, typeof(CustomerInfo));
            builder.AddAttribute(1, "Customer", _customer);
            builder.SetKey(tabId);
            builder.CloseComponent();
        };

        var addedTab = new CustomTab(tabId, "Customer Info", TabActions.Details, content);

        _tabs.Add(addedTab);

        selectedTabIndex = _tabs.Count + 2;
    }

    void ShowPreviewTab(IEnumerable<LoanScheduleDtoCreate> schedules, int? currencyId = 1)
    {
        var tabId = "preview_" + (_customer.CustomerId ?? Guid.NewGuid().ToString("N"));

        var exists = _tabs.FindIndex(t => t.Key == tabId);

        if (exists != -1)
        {
            selectedTabIndex = exists + 3;

            StateHasChanged();

            return;
        }

        RenderFragment content = builder =>
        {
            builder.OpenComponent(0, typeof(LoanSchedules));
            builder.AddAttribute(1, "CurrencyId", currencyId);
            builder.AddAttribute(2, "Schedules", schedules);
            builder.SetKey(tabId);
            builder.CloseComponent();
        };

        var addedTab = new CustomTab(tabId, "Schedules", TabActions.Details, content);

        _tabs.Add(addedTab);

        selectedTabIndex = _tabs.Count + 2;
    }



    void CloseTab(string tabId)
    {
        var tabIndex = _tabs.FindIndex(t => t.Key == tabId);

        if (tabIndex != -1)
        {
            _tabs.RemoveAt(tabIndex);
        }

        selectedTabIndex = _tabs.Count + 2;
    }

}