@page "/App/Loans/Disbursements/{BranchId:int}/Branches"
@using Applications.Features.Loans.Dtos.Responses
@using TrapchumApp.Pages.Transactions.Loans.LoanTabs

<PageTitle>Loan Disbursements</PageTitle>

<div class="page-wrapper">

    @* ── Currency Summary Cards ── *@
    <RadzenFieldset AllowCollapse="true"
                    Collapsed="true" class="rz-pl-2 rz-mb-2 summary-fieldset">
        <HeaderTemplate>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                <RadzenIcon Icon="account_balance_wallet" /><b>Disbursement Summary</b>
            </RadzenStack>
        </HeaderTemplate>
        <ChildContent>
            <div class="summary-section">
                @foreach (var s in _summaries)
                {
                    <div class="currency-group">
                        <div class="currency-group-header">
                            <RadzenIcon Icon="paid" style="font-size:1rem;color:var(--rz-primary);" />
                            <span class="currency-label">@s.CurrencyName</span>
                            <RadzenBadge BadgeStyle="BadgeStyle.Primary" IsPill="@true"
                                         Text="@($"{s.LoanCount} loans")"
                                         style="font-size:0.75rem;" />
                        </div>
                        <div class="kpi-grid">
                            <div class="kpi-card kpi-count">
                                <div class="kpi-icon-wrap" style="background:var(--rz-primary-lighter);">
                                    <RadzenIcon Icon="format_list_numbered" style="color:var(--rz-primary);font-size:1.25rem;" />
                                </div>
                                <div class="kpi-body">
                                    <span class="kpi-label">Total Loans</span>
                                    <span class="kpi-value" style="color:var(--rz-primary);">@s.LoanCount</span>
                                </div>
                            </div>
                            <div class="kpi-card kpi-principle">
                                <div class="kpi-icon-wrap" style="background:var(--rz-info-lighter);">
                                    <RadzenIcon Icon="account_balance" style="color:var(--rz-info);font-size:1.25rem;" />
                                </div>
                                <div class="kpi-body">
                                    <span class="kpi-label">Principle</span>
                                    <span class="kpi-value" style="color:var(--rz-info);">@s.TotalPrinciple.ToString("N2")</span>
                                </div>
                            </div>
                            <div class="kpi-card kpi-paid">
                                <div class="kpi-icon-wrap" style="background:var(--rz-success-lighter);">
                                    <RadzenIcon Icon="check_circle" style="color:var(--rz-success);font-size:1.25rem;" />
                                </div>
                                <div class="kpi-body">
                                    <span class="kpi-label">Paid Principle</span>
                                    <span class="kpi-value" style="color:var(--rz-success);">@s.TotalPaidPrinciple.ToString("N2")</span>
                                </div>
                            </div>
                            <div class="kpi-card kpi-outstanding">
                                <div class="kpi-icon-wrap" style="background:var(--rz-danger-lighter);">
                                    <RadzenIcon Icon="pending" style="color:var(--rz-danger);font-size:1.25rem;" />
                                </div>
                                <div class="kpi-body">
                                    <span class="kpi-label">Outstanding</span>
                                    <span class="kpi-value" style="color:var(--rz-danger);">@s.TotalOutstanding.ToString("N2")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </ChildContent>
    </RadzenFieldset>
    @* ── Tabs ── *@
    <RadzenCard Variant="Variant.Outlined" class="tabs-card">
        <RadzenTabs TabPosition="TabPosition.Top"
                    RenderMode="TabRenderMode.Server"
                    @bind-SelectedIndex="@_selectedIndex">
            <Tabs>

                <RadzenTabsItem>
                    <Template>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                            <RadzenIcon Icon="list_alt" style="font-size:1rem;" />
                            <span>All Loans</span>
                            <RadzenBadge BadgeStyle="BadgeStyle.Secondary" IsPill="@true" Text="@loanCount.ToString()" class="rz-ms-1" />
                        </RadzenStack>
                    </Template>
                    <ChildContent>
                        <div class="tab-content-wrapper">
                            <TabAllLoans GetLoanChanged="GetLoanCount"
                                         SummaryChanged="GetSummaryChanged"
                                         OpenDetailTab="@OpenDetailsTab"
                                         BranchId="@BranchId"
                                         UserId="@_userId" />
                        </div>
                    </ChildContent>
                </RadzenTabsItem>

                @foreach (var item in _loanTabs)
                {
                    <RadzenTabsItem @key="@item.TabId">
                        <Template>
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem">
                                <RadzenIcon Icon="person" style="font-size:0.95rem;" />
                                <ClosedTab Closed="@CloseTab" Title="@item.Title" TabId="@item.TabId" />
                            </RadzenStack>
                        </Template>
                        <ChildContent>
                            <div class="tab-content-wrapper">
                                @item.ChildContent
                            </div>
                        </ChildContent>
                    </RadzenTabsItem>
                }

            </Tabs>
        </RadzenTabs>
    </RadzenCard>

</div>

@code {

    private List<LoanTab> _loanTabs = [];
    private int _selectedIndex = 0;

    void OpenDetailsTab(VLoanDisbursments item)
    {
        var existingIndex = _loanTabs.FindIndex(x => x.TabId == item.LoanId);

        if (existingIndex != -1)
        {
            _selectedIndex = existingIndex + 1;
            StateHasChanged();
            return;
        }

        RenderFragment content = builder =>
        {
            builder.OpenComponent<LoanDetails>(0);
            builder.AddAttribute(1, "LoanId", item.LoanId);
            builder.AddAttribute(2, "BranchId", item.BranchId);
            builder.AddAttribute(3, "CurrencyId", item.CurrencyId);
            builder.SetKey(item.LoanId);
            builder.CloseComponent();
        };

        _loanTabs.Add(new LoanTab
        {
            TabId = item.LoanId ?? string.Empty,
            Title = item.AltName ?? string.Empty,
            ChildContent = content
        });

        _selectedIndex = _loanTabs.Count;
    }

    private void CloseTab(string id)
    {
        var tab = _loanTabs.FirstOrDefault(t => t.TabId == id);

        if (tab is null) return;

        var idx = _loanTabs.IndexOf(tab);
        _loanTabs.Remove(tab);
        _selectedIndex = Math.Max(0, idx);
    }
}

<style>
    .summary-fieldset .rz-fieldset-legend {
        display: flex;
        align-items: center;
    }
</style>

