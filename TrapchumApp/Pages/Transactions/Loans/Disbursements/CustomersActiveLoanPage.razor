@page "/App/Customers/Loans/{BranchId:int}/Branches"
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Features.Customers.Response
@using Applications.Responses.Lists.Customers
@using TrapchumApp.Helpers.Enums
@using TrapchumApp.Helpers.Options
@using TrapchumApp.Pages.Lists
<PageTitle>Customers Loan Active</PageTitle>
<GridToolbar SearchChanged="SearchCustomer"
             CommandText="Add Customer"
             @bind-Value="@filterText"
             ShowAddCommand="false"
             Placeholder="Search Customer....">
</GridToolbar>
<RadzenTabs RenderMode="TabRenderMode.Client" SelectedIndex="@selectedIndex" SelectedIndexChanged="SelectedTabChanged">
    <Tabs>
        <RadzenTabsItem Text="Customer" Icon="group">
            <RadzenDataGrid Count="@counts"
                            AllowColumnPicking="true"
                            Responsive
                            IsLoading="@isLoading"
                            GridLines="DataGridGridLines.Both"
                            Density="Density.Compact"
                            AllowAlternatingRows="true"
                            AllowRowSelectOnRowClick="true"
                            AllowFiltering="true"
                            AllowSorting="true"
                            PageSize="@pageSize"
                            @key="@counts"
                            PagerPosition="PagerPosition.Bottom"
                            ShowPagingSummary="true"
                            AllowPaging="true"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            LoadData="@LoadData"
                            TItem="VCustomerList"
                            PageSizeOptions="@StorageConstant.PageSizeOptions"
                            PageSizeChanged="PageSizeChanged"
                            RowRender="OnRowRender"
                            RowSelect="OnRowSelected"
                            CellRender="@OnCellRender"
                            RowDoubleClick="@OnRowDoubleClick"
                            CellContextMenu="@ShowContextMenu"
                            @ref="@_gridCustomer"
                            Data="@VCustomers">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center">
                        <RadzenLabel id="DropDownEditLabel" Text="Filter" Component="DropDownEdit" />
                        <RadzenDropDown @bind-Value="selectedValue"
                                        Placeholder="Filter by"
                                        TValue="int"
                                        Data="@Filters.CustomerFilters"
                                        TextProperty="@nameof(ListItem.Name)"
                                        ValueProperty="@nameof(ListItem.Id)"
                                        SelectedItemChanged="@SelectedItemChanged"
                                        Name="DropDownEdit">
                        </RadzenDropDown>
                    </RadzenStack>
                </HeaderTemplate>
                <Columns>
                    <RadzenDataGridColumn Title="#"
                                          Width="4rem"
                                          Context="c"
                                          Property="@nameof(VCustomerDetails.CustomerId)"
                                          TextAlign="TextAlign.Center"
                                          Pickable="false"
                                          Filterable="false"
                                          Sortable="false">
                        <Template>
                            @(VCustomers?.IndexOf(c) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(VCustomerDetails.AltName)"
                                          Context="c"
                                          Width="8rem"
                                          Title="Name">
                        <Template>
                            <NavLink @onclick="@(() => OnRowDoubleClick(c))">
                                <KhmerName AltName="@c.AltName" />
                            </NavLink>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(VCustomerDetails.FullName)"
                                          Context="c"
                                          Width="8rem"
                                          Visible="false"
                                          Title="FullName">
                        <Template>
                            @c.FullName
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="@nameof(VCustomerDetails.Phone)"
                                          Context="c"
                                          Width="8rem"
                                          Property="Phone"
                                          Sortable="true">
                        <Template>
                            @c.Phone
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="Email"
                                          Context="c"
                                          Width="10rem"
                                          Property="@nameof(VCustomerDetails.EmailAddress)"
                                          Sortable="false" />
                    <RadzenDataGridColumn Context="c"
                                          Sortable="false"
                                          Filterable="false"
                                          Title="Address">
                        <Template>
                            <AddressInfo ComInKhmer="@c.ComInKhmer"
                                         ProInKhmer="@c.ProInKhmer"
                                         DisInKhmer="@c.DisInKhmer"
                                         VilInKhmer="@c.VilInKhmer" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Context="c"
                                          Width="8rem"
                                          TextAlign="TextAlign.Center"
                                          Sortable="false"
                                          Filterable="false"
                                          Property="@nameof(VCustomerDetails.IsLoanActive)"
                                          Title="Loan Active">
                        <Template>
                            <RadzenCheckBox Value="@c.IsLoanActive" Disabled />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Context="c"
                                          Width="5rem"
                                          TextAlign="TextAlign.Center"
                                          Sortable="false"
                                          Filterable="false"
                                          Property="@nameof(VCustomerDetails.IsActive)"
                                          Title="Is Active">
                        <Template>
                            <RadzenCheckBox @bind-Value="@c.IsActive"
                                            Change="ChangedCustomerStatus"
                                            TValue="bool" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Context="c"
                                          Width="5rem"
                                          Sortable="false"
                                          CssClass="z"
                                          TextAlign="TextAlign.Center"
                                          Filterable="false"
                                          Pickable="false"
                                          Title="Actions">
                        <Template>
                            <RadzenButton Size="ButtonSize.ExtraSmall"
                                          Icon="@IconNames.MoreVert"
                                          Variant="Variant.Text"
                                          Click="@((args)=>ShowContextMenu(args,c))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {

    void EditIndex(int selectedTabIndex)
    {
        // selectedIndex = selectedTabIndex;

        // isEditTab = true;
    }

    async Task CreateCustomerQuick()
    {

        var options = new DialogOptions
        {
            Width = "45vw",
            Draggable = true,
            Resizable = false
        };

    }

    private int selectedValue = 0;
    private RadzenDataGrid<VCustomerList> _gridCustomer = default!;
    void ShowContextMenu(MouseEventArgs args, VCustomerList c)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;" Click="OnMenuItemClick">
        <RadzenMenuItem Icon="add"
                        Click="@(()=>AddLoanRequest(c.CustomerId))"
                        Visible="@BState.CanRequest"
                        Text="Request Loan"
                        Value="@c.CustomerId"></RadzenMenuItem>
        <RadzenMenuItem Click="@(() => AddCollateral(c.CustomerId))" Icon="add" Text="Add Collateral" Value="@c.CustomerId" />
        <RadzenMenuItem Click="@(() => AddInComeModal(c.CustomerId))" Icon="money" Text="Add Income" Value="@c.CustomerId" />
        <RadzenMenuItem Click="@(() => AddExpenseModal(c.CustomerId))" Icon="paid" Text="Add Expense" Value="@c.CustomerId" />
        <RadzenMenuItem Click="@(() => AddDetails(c.CustomerId))" Icon="info" Text="Customer Details" Value="@c.CustomerId" />
        <RadzenMenuItem Visible="@BState.IsAdmin" Click="@(() => AddEdit(c.CustomerId))" Icon="edit" Text="Edit" Value="@c.CustomerId" />
        <RadzenMenuItem Visible="@BState.IsAdmin" Click="@(() => AddDelete(c.CustomerId))" Icon="delete" Text="Delete" Value="@c.CustomerId" />
    </RadzenMenu>
    );
    }

    void ChangedCustomerStatus(bool args)
    {

    }


    void OnMenuItemClick(MenuItemEventArgs args)
    {
        ContextMenuService.Close();
    }


    async Task PageSizeChanged(int page)
    {
        pageSize = page;

        pageIndex = 0; // Reset to first page when page size changes

        await FIlterCustomers(selectedValue);
    }


    private void ShowContextMenu(DataGridCellMouseEventArgs<VCustomerList> args)
    {
        if (args.Data is null) return;

        ContextMenuService.Open(args, new List<ContextMenuItem>
        {
            new ContextMenuItem
            {
                Text = "Add Collateral",
                Icon = "add",
                Value = "1"
            },
            new ContextMenuItem
            {
                Text = "Request Loan",
                Icon = "request_quote",
                Value = "2",
                Disabled = (!BState.CanRequest || args.Data.IsLoanActive)
            },
            new ContextMenuItem
            {
                Text = "Add Income",
                Icon = "money",
                Value = "3"
            },
             new ContextMenuItem
            {
                Text = "Add Expense",
                Icon = "paid",
                Value = "4"
            },
            new ContextMenuItem
            {
                Text = "Customer Details",
                Icon = "info",
                Value = "5"
            },

        }, DoShowCustomerActions(args));

        
    }

    private Action<MenuItemEventArgs> DoShowCustomerActions(DataGridCellMouseEventArgs<VCustomerList> args)
    {
        if (args.Data is null) return (e) => { };

        return (e) =>
        {
            ContextMenuService.Close();
            
            if (int.TryParse(e.Value?.ToString(), out int value))
            {
                switch (value)
                {
                    case 1:
                        _ = AddCollateral(args.Data.CustomerId);
                        break;
                    case 2:
                        _ = AddLoanRequest(args.Data.CustomerId);
                        break;
                    case 3:
                        _ = AddInComeModal(args.Data.CustomerId);
                        break;
                    case 4:
                        AddExpenseModal(args.Data.CustomerId);
                        break;
                    case 5:
                        _ = AddDetails(args.Data.CustomerId);
                        break;
                }
            };


        };
    }



}
