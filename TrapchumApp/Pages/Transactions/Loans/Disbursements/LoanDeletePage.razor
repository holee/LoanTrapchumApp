    private async Task HandleApproveRequest()
    {
        var command = new ApproveDeleteRequestCommand(new RequestDeleteDtoCreate(LoanId, BranchId, Note));

        var rsp = await mediator.Send(command);

        if (rsp.IsSuccess())
        {
            resource?.AllowDelete = true;
        }

    }

