@* ── Action Bar ── *@
<RadzenStack Orientation="Orientation.Horizontal"
             AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.SpaceBetween"
             Wrap="FlexWrap.Wrap"
             Gap="0.5rem"
             class="rz-mb-2">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem">
        <RadzenButton Text="@buttonText"
                      Size="ButtonSize.ExtraSmall"
                      Click="@Toggle"
                      Variant="Variant.Outlined"
                      ButtonStyle="ButtonStyle.Primary"
                      Icon="@IconNames.Info" />
        <RadzenButton Size="ButtonSize.ExtraSmall"
                      Click="@DownLoadScheduleAsExcel"
                      ButtonStyle="ButtonStyle.Success"
                      Variant="Variant.Outlined"
                      Icon="file_download"
                      Text="Excel" />
        <RadzenButton Click="@DownLoadScheduleAsPdf"
                      Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Danger"
                      Variant="Variant.Outlined"
                      Text="PDF"
                      Icon="picture_as_pdf" />
    </RadzenStack>
</RadzenStack>

@* ── Expandable Detail Panel ── *@
@if (_showCustomer)
{
    <RadzenCard Variant="Variant.Outlined"
                Style="border-radius:0.875rem;overflow:hidden;padding:0;
                       box-shadow:0 1px 6px rgba(0,0,0,.07);margin-bottom:0.75rem;">
        <RadzenTabs RenderMode="TabRenderMode.Server">
            <Tabs>

                @* Customer *@
                <RadzenTabsItem Text="Customer" Icon="@IconNames.ContactEmergency">
                    <div class="rz-p-3">
                        <RadzenStack Gap="0.75rem">

                            @* Row 1 – identity *@
                            <RadzenRow Gap="0.5rem">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenStack Gap="0.15rem">
                                        <RadzenText TextStyle="TextStyle.Caption"
                                                    Style="color:var(--rz-text-secondary-color);text-transform:uppercase;letter-spacing:.04em;font-size:0.68rem;">
                                            Full Name
                                        </RadzenText>
                                        <RadzenText Style="font-weight:600;font-family:kh_siemreap,'Noto Sans Khmer','Khmer OS Siemreap',sans-serif;">@LoanSchedule?.AltName</RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="3">
                                    <RadzenStack Gap="0.15rem">
                                        <RadzenText TextStyle="TextStyle.Caption"
                                                    Style="color:var(--rz-text-secondary-color);text-transform:uppercase;letter-spacing:.04em;font-size:0.68rem;">
                                            Phone
                                        </RadzenText>
                                        <RadzenText>@LoanSchedule?.Phone</RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="6">
                                    <RadzenStack Gap="0.15rem">
                                        <RadzenText TextStyle="TextStyle.Caption"
                                                    Style="color:var(--rz-text-secondary-color);text-transform:uppercase;letter-spacing:.04em;font-size:0.68rem;">
                                            Address
                                        </RadzenText>
                                        <RadzenText Style="font-family:kh_siemreap,'Noto Sans Khmer','Khmer OS Siemreap',sans-serif;">@LoanSchedule?.Address</RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow Gap="0.5rem">
                                <RadzenColumn Size="6" SizeMD="3">
                                    <RadzenStack Gap="0.15rem">
                                        <RadzenText TextStyle="TextStyle.Caption"
                                                    Style="color:var(--rz-text-secondary-color);text-transform:uppercase;letter-spacing:.04em;font-size:0.68rem;">
                                            Agent
                                        </RadzenText>
                                        <RadzenText Style="font-family:kh_siemreap,'Noto Sans Khmer','Khmer OS Siemreap',sans-serif;">@LoanSchedule?.AgentName</RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="6" SizeMD="3">
                                    <RadzenStack Gap="0.15rem">
                                        <RadzenText TextStyle="TextStyle.Caption"
                                                    Style="color:var(--rz-text-secondary-color);text-transform:uppercase;letter-spacing:.04em;font-size:0.68rem;">
                                            Agent Phone
                                        </RadzenText>
                                        <RadzenText>@LoanSchedule?.AgentPhone</RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="6" SizeMD="3">
                                    <RadzenStack Gap="0.15rem">
                                        <RadzenText TextStyle="TextStyle.Caption"
                                                    Style="color:var(--rz-text-secondary-color);text-transform:uppercase;letter-spacing:.04em;font-size:0.68rem;">
                                            Circle
                                        </RadzenText>
                                        <RadzenText>@LoanSchedule?.Circle</RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                                <RadzenColumn Size="6" SizeMD="3">
                                    <RadzenStack Gap="0.15rem">
                                        <RadzenText TextStyle="TextStyle.Caption"
                                                    Style="color:var(--rz-text-secondary-color);text-transform:uppercase;letter-spacing:.04em;font-size:0.68rem;">
                                            Office
                                        </RadzenText>
                                        <RadzenText>Trapchum</RadzenText>
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                            @* Row 4 – payment summary pills *@
                            <RadzenRow Gap="0.5rem">
                                <RadzenColumn Size="12" SizeMD="3">
                                    <div style="background:var(--rz-success-lighter,#e6f4ea);border-radius:0.5rem;padding:0.6rem 0.875rem;">
                                        <RadzenText Style="font-size:0.68rem;color:var(--rz-success-dark,#1e7e34);text-transform:uppercase;letter-spacing:.04em;margin:0;">
                                            Paid Principal
                                        </RadzenText>
                                        <RadzenText Style="font-weight:700;font-size:0.95rem;color:var(--rz-success-dark,#1e7e34);margin:0;">
                                            @LoanSchedule?.PaidPrinciple.AsCurrencyTitle(LoanSchedule.CurrencyId)
                                        </RadzenText>
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="3">
                                    <div style="background:var(--rz-info-lighter,#e3f2fd);border-radius:0.5rem;padding:0.6rem 0.875rem;">
                                        <RadzenText Style="font-size:0.68rem;color:var(--rz-info-dark,#1565c0);text-transform:uppercase;letter-spacing:.04em;margin:0;">
                                            Paid Interest
                                        </RadzenText>
                                        <RadzenText Style="font-weight:700;font-size:0.95rem;color:var(--rz-info-dark,#1565c0);margin:0;">
                                            @LoanSchedule?.PaidInterest.AsCurrencyTitle(LoanSchedule.CurrencyId)
                                        </RadzenText>
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="3">
                                    <div style="background:var(--rz-warning-lighter,#fff8e1);border-radius:0.5rem;padding:0.6rem 0.875rem;">
                                        <RadzenText Style="font-size:0.68rem;color:var(--rz-warning-dark,#e65100);text-transform:uppercase;letter-spacing:.04em;margin:0;">
                                            Paid Collection Fee
                                        </RadzenText>
                                        <RadzenText Style="font-weight:700;font-size:0.95rem;color:var(--rz-warning-dark,#e65100);margin:0;">
                                            @LoanSchedule?.PaidCollectionFee.AsCurrencyTitle(LoanSchedule.CurrencyId)
                                        </RadzenText>
                                    </div>
                                </RadzenColumn>
                                <RadzenColumn Size="12" SizeMD="3">
                                    <div style="background:var(--rz-danger-lighter,#fdecea);border-radius:0.5rem;padding:0.6rem 0.875rem;">
                                        <RadzenText Style="font-size:0.68rem;color:var(--rz-danger-dark,#c62828);text-transform:uppercase;letter-spacing:.04em;margin:0;">
                                            Outstanding
                                        </RadzenText>
                                        <RadzenText Style="font-weight:700;font-size:0.95rem;color:var(--rz-danger-dark,#c62828);margin:0;">
                                            @LoanSchedule?.OutStanding.AsCurrencyTitle(LoanSchedule.CurrencyId)
                                        </RadzenText>
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>

                        </RadzenStack>
                    </div>
                </RadzenTabsItem>

                <RadzenTabsItem Text="Collaterals" Icon="@IconNames.Collaterals">
                    <div class="rz-p-3">
                        <LoanRelatedCollaterals BranchId="@BranchId" LoanId="@LoanId" />
                    </div>
                </RadzenTabsItem>
                <RadzenTabsItem Text="Guarantors" Icon="@IconNames.PersonBook">
                    <div class="rz-p-3">
                        <LoanRelatedGaurrantors BranchId="@BranchId" LoanId="@LoanId" />
                    </div>
                </RadzenTabsItem>
                <RadzenTabsItem Text="Documents" Icon="@IconNames.AttachFile">
                    <div class="rz-p-3">
                        <LoanRelatedDocuments BranchId="@BranchId" LoanId="@LoanId" />
                    </div>
                </RadzenTabsItem>

            </Tabs>
        </RadzenTabs>
    </RadzenCard>
}
@code {
    [Parameter] public RenderFragment ChildContent { get; set; } = default!;

    string buttonText => _showCustomer ? "Hide Info" : "Customer Info";

    private bool _showCustomer = false;

    void Toggle()
    {
        _showCustomer = !_showCustomer;
    }
}