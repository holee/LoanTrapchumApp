@page "/App/Loan/{LoanId}/Branches/{BranchId:int}/Currencies/{CurrencyId:int?}"
@using TrapchumApp.Pages.Transactions.Loans.Repayments
<PageTitle>Loan-Details</PageTitle>

<RadzenStack Gap="1rem" class="rz-p-1">
    @* ── Customer / Collateral detail panel ── *@
    <button @onclick="@DownloadPdf">DownLoad</button>
    <LoanInfos LoanSchedule="@loanSchedule" LoanId="@LoanId" BranchId="@BranchId" />
    @* ── Hero Banner ── *@
    <div style="background:linear-gradient(135deg,var(--rz-primary) 0%,var(--rz-primary-dark,#1a56a0) 100%);
        border-radius:0.875rem;padding:1rem 1.5rem;color:#fff;box-shadow:0 4px 16px rgba(0,0,0,.15);">
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     JustifyContent="JustifyContent.SpaceBetween"
                     Wrap="FlexWrap.Wrap"
                     Gap="0.75rem">
            @* Left – identity *@
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.875rem">
                <div style="background:rgba(255,255,255,.18);border-radius:0.625rem;width:3rem;height:3rem;
                    display:flex;align-items:center;justify-content:center;">
                    <RadzenIcon Icon="account_balance" Style="font-size:1.6rem;color:#fff;" />
                </div>
                <RadzenStack Gap="0.1rem">
                    <RadzenText TagName="TagName.H1"
                                Style="font-size:1.15rem;font-weight:700;color:#fff;margin:0;line-height:1.25;">
                        @(loanSchedule?.AltName ?? "Loan Details")
                    </RadzenText>
                    <RadzenText Style="font-size:0.78rem;color:rgba(255,255,255,.8);margin:0;">
                        Contract&nbsp;<strong>@(loanSchedule?.ContractNumber ?? "-")</strong>
                        &nbsp;·&nbsp;@(loanSchedule?.CurrencyName)
                        &nbsp;·&nbsp;@(loanSchedule?.InstallmentType)
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>
            @* Right – status + back *@
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <span style="background:rgba(255,255,255,.22);border-radius:2rem;
                    padding:0.2rem 0.85rem;font-size:0.78rem;font-weight:600;color:#fff;white-space:nowrap;">
                    @(loanSchedule?.LoanStatus ?? "—")
                </span>
                <RadzenLink Path="@_navService.PreviousUrl"
                            Style="display:inline-flex;align-items:center;gap:0.25rem;
                    font-size:0.82rem;color:rgba(255,255,255,.9);text-decoration:none;
                    background:rgba(255,255,255,.18);border-radius:2rem;padding:0.3rem 0.9rem;">
                    <RadzenIcon Icon="arrow_back" Style="font-size:0.95rem;" />
                    Back
                </RadzenLink>
            </RadzenStack>
        </RadzenStack>

        @* ── KPI strip ── *@
        <RadzenStack Orientation="Orientation.Horizontal"
                     Wrap="FlexWrap.Wrap"
                     Gap="0"
                     Style="margin-top:1rem;border-top:1px solid rgba(255,255,255,.25);padding-top:0.875rem;">
            <div style="flex:1;min-width:8rem;padding:0 1rem 0 0;border-right:1px solid rgba(255,255,255,.2);">
                <RadzenText Style="font-size:0.7rem;color:rgba(255,255,255,.7);margin:0;text-transform:uppercase;letter-spacing:.05em;">Principal</RadzenText>
                <RadzenText Style="font-size:1rem;font-weight:700;color:#fff;margin:0;">@loanSchedule?.Principle.Format(CurrencyId)</RadzenText>
            </div>
            <div style="flex:1;min-width:8rem;padding:0 1rem;border-right:1px solid rgba(255,255,255,.2);">
                <RadzenText Style="font-size:0.7rem;color:rgba(255,255,255,.7);margin:0;text-transform:uppercase;letter-spacing:.05em;">Outstanding</RadzenText>
                <RadzenText Style="font-size:1rem;font-weight:700;color:#fff;margin:0;">@loanSchedule?.OutStanding.Format(CurrencyId)</RadzenText>
            </div>
            <div style="flex:1;min-width:8rem;padding:0 1rem;border-right:1px solid rgba(255,255,255,.2);">
                <RadzenText Style="font-size:0.7rem;color:rgba(255,255,255,.7);margin:0;text-transform:uppercase;letter-spacing:.05em;">Interest Rate</RadzenText>
                <RadzenText Style="font-size:1rem;font-weight:700;color:#fff;margin:0;">@(loanSchedule?.InterestRate.AsPercent())</RadzenText>
            </div>
            <div style="flex:1;min-width:8rem;padding:0 1rem;border-right:1px solid rgba(255,255,255,.2);">
                <RadzenText Style="font-size:0.7rem;color:rgba(255,255,255,.7);margin:0;text-transform:uppercase;letter-spacing:.05em;">Effective Rate</RadzenText>
                <RadzenText Style="font-size:1rem;font-weight:700;color:#fff;margin:0;">@(loanSchedule?.CollectionFeeRate.AsPercent())</RadzenText>
            </div>
            <div style="flex:1;min-width:8rem;padding:0 1rem;border-right:1px solid rgba(255,255,255,.2);">
                <RadzenText Style="font-size:0.7rem;color:rgba(255,255,255,.7);margin:0;text-transform:uppercase;letter-spacing:.05em;">Admin Rate</RadzenText>
                <RadzenText Style="font-size:1rem;font-weight:700;color:#fff;margin:0;">@(loanSchedule?.AdminFeeRate.AsPercent())</RadzenText>
            </div>
            <div style="flex:1;min-width:8rem;padding:0 1rem;border-right:1px solid rgba(255,255,255,.2);">
                <RadzenText Style="font-size:0.7rem;color:rgba(255,255,255,.7);margin:0;text-transform:uppercase;letter-spacing:.05em;">Period</RadzenText>
                <RadzenText Style="font-size:1rem;font-weight:700;color:#fff;margin:0;">@(loanSchedule?.Period?.ToString() ?? "—") mo</RadzenText>
            </div>
            <div style="flex:1;min-width:8rem;padding:0 1rem;">
                <RadzenText Style="font-size:0.7rem;color:rgba(255,255,255,.7);margin:0;text-transform:uppercase;letter-spacing:.05em;">Expiry</RadzenText>
                <RadzenText Style="font-size:1rem;font-weight:700;color:#fff;margin:0;">@(loanSchedule?.LastPaymentDate?.ToString("dd/MM/yyyy") ?? "—")</RadzenText>
            </div>
        </RadzenStack>
    </div>

    @* ── Tabs ── *@
    <RadzenCard Variant="Variant.Outlined"
                Style="border-radius:0.875rem;overflow:hidden;padding:0;box-shadow:0 1px 6px rgba(0,0,0,.07);">
        <RadzenTabs Change="SelectedTabChanged" RenderMode="TabRenderMode.Server" @bind-SelectedIndex="@_selectedTabIndex">
            <Tabs>
                @* Schedule *@
                <RadzenTabsItem Text="Schedule" Icon="calendar_month">
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 JustifyContent="JustifyContent.End"
                                 AlignItems="AlignItems.Center">
                        <div class="rz-p-1 rz-text-align-center rz-mr-2">
                            <RadzenCheckBox TValue="bool"
                                            @bind-Value="@_includePaid"
                                            Name="PaidOnly"
                                            Change="@((arg) => ShowAllScedules(arg))" />
                            <RadzenLabel Text="Include Paid" Component="PaidOnly" class="rz-ms-2" />
                        </div>
                    </RadzenStack>
                    <div class="rz-p-3">
                        <RadzenDataGrid Data="@Schedules"
                                        Density="Density.Compact"
                                        Responsive
                                        AllowAlternatingRows="false"
                                        GridLines="DataGridGridLines.None"
                                        SelectionMode="DataGridSelectionMode.Single"
                                        @bind-Value="SelectedSchedules"
                                        ColumnWidth="15rem"
                                        CellRender="CellRender"
                                        CellContextMenu="@OnCellContextMenu"
                                        RowDoubleClick="@OnRowDoubleClick"
                                        RowRender="@OnRowRender"
                                        Style="min-height:var(--min-height);height:var(--normal-height);max-height:var(--max-height);overflow:auto;"
                                        TItem="VSchedule">
                            <Columns>
                                <RadzenDataGridColumn Property="@(nameof(VSchedule.InstallmentNo))"
                                                      Title="#" Width="2rem" Sortable="false" />
                                <RadzenDataGridColumn Property="@(nameof(VSchedule.PaymentDate))"
                                                      Title="ថ្ងៃបង់ប្រាក់"
                                                      Width="5rem" Sortable="false">
                                    <Template>@context.PaymentDate.DayFirst()</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Property="@(nameof(VSchedule.TotalDay))"
                                                      Title="ចំនួនថ្ងៃ" Width="4rem" Context="c"
                                                      TextAlign="TextAlign.Center" Sortable="false">
                                    <Template>@c.TotalDay</Template>
                                    <FooterTemplate><strong>@(loanSchedule!.Schedules.Sum(x => x.TotalDay))</strong></FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Property="@(nameof(VSchedule.Principle))"
                                                      Title="ប្រាក់ដើមត្រូវបង់" TextAlign="TextAlign.Right"
                                                      Width="6rem" Context="c" Sortable="false">
                                    <Template>@c.Principle.As(CurrencyId)</Template>
                                    <FooterTemplate><strong>@(loanSchedule!.Schedules.Sum(x => x.Principle).As(CurrencyId))</strong></FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Property="@(nameof(VSchedule.Interest))"
                                                      Title="ការប្រាក់ត្រូវបង់" TextAlign="TextAlign.Right"
                                                      Width="6rem" Sortable="false">
                                    <Template>@context.Interest.As(CurrencyId)</Template>
                                    <FooterTemplate><strong>@(loanSchedule!.Schedules.Sum(x => x.Interest).As(CurrencyId))</strong></FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Property="@(nameof(VSchedule.CollectionFee))"
                                                      Title="ប្រាក់ប្រសិទ្ធភាព" Width="6rem"
                                                      TextAlign="TextAlign.Right" Sortable="false">
                                    <Template>@context.CollectionFee.As(CurrencyId)</Template>
                                    <FooterTemplate><strong>@(loanSchedule!.Schedules.Sum(x => x.CollectionFee).As(CurrencyId))</strong></FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Property="@(nameof(VSchedule.CollectionFee))"
                                                      Title="ប្រាក់ពិន័យ" Width="6rem"
                                                      TextAlign="TextAlign.Right" Sortable="false">
                                    <Template>@context.PenaltyAmount.As(CurrencyId)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Property="@(nameof(VSchedule.TotalPay))"
                                                      Title="ប្រាក់បង់សរុប" TextAlign="TextAlign.Right"
                                                      Width="6rem" Context="c" Sortable="false">
                                    <Template>@c.TotalPay.As(CurrencyId)</Template>
                                    <FooterTemplate><strong>@(loanSchedule!.Schedules.Sum(x => x.TotalPay).As(CurrencyId))</strong></FooterTemplate>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Property="@(nameof(VSchedule.LoanOutstanding))"
                                                      Title="ប្រាក់នៅសល់" Width="7rem"
                                                      TextAlign="TextAlign.Right" Sortable="false">
                                    <Template>@context.LoanOutstanding.As(CurrencyId)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Property="@(nameof(VSchedule.ScheduleStatus))"
                                                      Title="ស្ថានភាព" Width="6rem"
                                                      TextAlign="TextAlign.Center" Sortable="false">
                                    <Template Context="s">
                                        <RadzenBadge BadgeStyle="@(s.ScheduleStatusId switch
                                                     {
                                                         (int)ScheduleStatus.Paid => BadgeStyle.Success,
                                                         (int)ScheduleStatus.Partial => BadgeStyle.Warning,
                                                         (int)ScheduleStatus.Late => BadgeStyle.Danger,
                                                         (int)ScheduleStatus.Cancel => BadgeStyle.Secondary,
                                                         (int)ScheduleStatus.OnDate => BadgeStyle.Info,
                                                         _ => BadgeStyle.Light
                                                     })"
                                                     Text="@s.ScheduleStatus"
                                                     Style="text-transform:uppercase; font-size:0.65rem;" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Property="@(nameof(VSchedule.LoanScheduleId))"
                                                      Title="" Context="s" Width="3rem"
                                                      TextAlign="TextAlign.Center" Sortable="false">
                                    <Template>
                                        <RadzenButton Size="ButtonSize.ExtraSmall"
                                                      Icon="more_vert"
                                                      Variant="Variant.Text"
                                                      Click="@((args) => ShowContextMenu(args, s))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </div>
                </RadzenTabsItem>

                @* Paid Schedule *@
                <RadzenTabsItem Text="Paid" Icon="check_circle">
                    <div class="rz-p-3">
                        <SchedulesPaid BranchId="@BranchId" LoanId="@LoanId" CurrencyId="@CurrencyId" />
                    </div>
                </RadzenTabsItem>

                @* By Schedule *@
                <RadzenTabsItem Text="By Schedule" Icon="view_list">
                    <div class="rz-p-3">
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.End"
                                     class="rz-mb-2">
                            <RadzenButton Click="@DownLoadScheduleAsPdf"
                                          Size="ButtonSize.ExtraSmall"
                                          ButtonStyle="ButtonStyle.Danger"
                                          Variant="Variant.Outlined"
                                          Text="Export PDF"
                                          Icon="@IconNames.Pdf" />
                        </RadzenStack>
                        <div style="height:30rem;max-height:40rem;overflow:auto;">
                            <RadzenStack Gap="0.5rem">
                                @foreach (var s in _loanSchedules ?? [])
                                {
                                    <RadzenCard Variant="Variant.Outlined"
                                                Style="border-radius:0.5rem;padding:0.75rem;">
                                        <SplitSchedule LoanSchedule="@s"
                                                       BranchId="@BranchId"
                                                       LoanId="@LoanId"
                                                       TotalScedules="@_loanSchedules!.Count()"
                                                       ScheduleNum="@s.ScheduleNum" />
                                    </RadzenCard>
                                }
                            </RadzenStack>
                        </div>
                    </div>
                </RadzenTabsItem>

                @* Payment *@
                <RadzenTabsItem Text="Payment" Icon="@IconNames.Paid" Visible="@_isPaymentTab">
                    <div class="rz-p-3">
                        <PaymentTab CurrencyId="@CurrencyId"
                                    LoanPaymentCreate="@_loanPayment"
                                    CloseTab="@CloseTab" />
                    </div>
                </RadzenTabsItem>

            </Tabs>
        </RadzenTabs>
    </RadzenCard>

</RadzenStack>
@code {

    private bool _includePaid = false;

    async Task DownLoadScheduleAsPdf()
    {
        if (string.IsNullOrEmpty(LoanId) || BranchId <= 0)
        {
            _toastService.ShowWarning("LoanId and BranchId are required to download the schedule as PDF.", "Warning");

            return;
        }

        var fileName = $"Loan_Schedule_{Guid.CreateVersion7()}.pdf";

        await js.InvokeVoidAsync("open", $"/reports/schedules/{LoanId}/{BranchId}/{fileName}", "_blank");

    }

    void ShowContextMenu(MouseEventArgs args, VSchedule p)
    {
        _getPaymentSchedulesUrl = $"/App/Loans/{p.BranchId}/Branches/{p.LoanId}/Schedules?CreditAgentId={p.CreditAgentId}&CurrencyId={p.CurrencyId}";

        ContextMenuService.Open(args, ds => @<RadzenMenu Style="font-size:0.8rem;">
            <RadzenMenuItem Icon="money"
                            Disabled="@(SetDisabled(p) || !BState.CanRecievePayment)"
                            Path="@_getPaymentSchedulesUrl"
                            Text="Recieve Payment"></RadzenMenuItem>
            <RadzenMenuItem Icon="schedule"
                            Disabled="@(SetDisabled(p) || !BState.CanRecievePayment)"
                            Click="@(()=>PayBySchedules(p))"
                            Text="Paid By Schedule"></RadzenMenuItem>
            <RadzenMenuItem Icon="paid"
                            Click="@(()=>ShowScheduleDetails(p))"
                            Text="Show Details"></RadzenMenuItem>

        </RadzenMenu>
    );
    }


    void OnRowRender(RowRenderEventArgs<VSchedule> args)
    {

    }

    private async Task DownloadPdf()
    {
        await js.InvokeVoidAsync("open", $"/Reports/Pdf/Loans/Schedules/{LoanId}/{BranchId}", "_blank");
    }
}
