@using Applications.Features.Customers.Response
@using Applications.Features.Loans.Dtos.Requests
@foreach (var item in groupedSchedules)
{
    <RadzenDataGrid Responsive="true"
                    Density="Density.Compact"
                    GridLines="DataGridGridLines.Both"
                    AllowSorting="false"
                    ColumnWidth="15rem"
                    RowSelect="@OnRowSelect"
                    RowRender="@OnRowRender"
                    TItem="LoanScheduleDtoCreate"
                    Data="@item.Value">
        <Columns>
            <RadzenDataGridColumn Width="2.5rem" TextAlign="TextAlign.Center" Property="InstallmentNo" Title="No" Context="c">
                <Template>
                    @c.InstallmentNo
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="12rem"
                                  Property="PaymentDate"
                                  Title="Payment Date"
                                  Context="c">
                <Template>
                    <small>
                        @c.PaymentDate.DayFirst()
                        @* <small>@c.PaymentDate!.Value.DayOfWeek</small> *@
                    </small>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="6rem" TextAlign="TextAlign.Center" Property="TotalDay" Title="Total Day" Context="c">
                <Template>
                    @c.TotalDay
                </Template>
                <FooterTemplate>
                    <strong>
                        @item.Value.Sum(p => p.TotalDay)
                    </strong>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="10rem" TextAlign="TextAlign.Right" Property="Principal" Title="Principal" Context="c">
                <Template>
                    @c.Principal.Format(CurrencyId)
                </Template>
                <FooterTemplate>
                    <strong>
                        @item.Value.Sum(p => p.Principal).Format(CurrencyId)
                    </strong>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="10rem" TextAlign="TextAlign.Right" Property="Interest" Title="Interest" Context="c">
                <Template>
                    @c.Interest.Format(CurrencyId)
                </Template>
                <FooterTemplate>
                    <strong>
                        @item.Value.Sum(p => p.Interest).Format(CurrencyId)
                    </strong>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="10rem" TextAlign="TextAlign.Right" Property="CollectionFee" Title="Collection Fee" Context="c">
                <Template>
                    @c.CollectionFee.Format(CurrencyId)
                </Template>
                <FooterTemplate>
                    <strong>
                        @item.Value.Sum(p => p.CollectionFee).Format(CurrencyId)
                    </strong>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="10rem" TextAlign="TextAlign.Right" Property="TotalPay" Title="Total Pay" Context="c">
                <Template>
                    @c.TotalPay.Format(CurrencyId)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="10rem" TextAlign="TextAlign.Right" Property="LoanOutstanding" Title="Outstanding" Context="c">
                <Template>
                    @c.LoanOutstanding.Format(CurrencyId)
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
@code {
    [Parameter] public int? CurrencyId { get; set; } = 1;
    [Parameter] public VCustomerDetails? Customer { get; set; }
    [Parameter] public IEnumerable<LoanScheduleDtoCreate> Schedules { get; set; } = [];

    private List<LoanScheduleDtoCreate> group1 = new();

    private Dictionary<int, List<LoanScheduleDtoCreate>> groupedSchedules = new();

    int counts = 0;

    protected override void OnInitialized()
    {

        CreateGroupedSchedules();

        base.OnInitialized();
    }

    void OnRowRender(RowRenderEventArgs<LoanScheduleDtoCreate> arg)
    {
        if (arg.Data!.InstallmentNo % 5 == 0)
        {
            //arg.Attributes.Add("class", "rz-state-highlight rz-data-row recently-edited");
        }
    }

    void OnRowSelect(LoanScheduleDtoCreate arg)
    {
        // Handle row selection if needed
    }




    private void CreateGroupedSchedules()
    {
        if (Schedules == null || !Schedules.Any())
        {
            return;
        }

        groupedSchedules = Schedules
            .Chunk(4)
            .Select((chunk, index) => new
            {
                Index = index,
                Group = BuildGroup(chunk)
            })
            .ToDictionary(x => x.Index, x => x.Group);

        base.OnInitialized();
    }

    private static List<LoanScheduleDtoCreate> BuildGroup(IEnumerable<LoanScheduleDtoCreate> source)
    {
        var group = source.ToList();

        var first = group.First();
        var last = group.Last();

        var opening = CreateOpeningRow(first);
        var closing = CreateClosingRow(last);

        group.Add(opening);
        group.Add(closing);

        return group
            .OrderBy(x => x.InstallmentNo)
            .ToList();
    }

    private static LoanScheduleDtoCreate CreateOpeningRow(LoanScheduleDtoCreate first)
    {
        return new LoanScheduleDtoCreate
        {
            InstallmentNo = 0,
            PaymentDate = null,
            TotalDay = 0,
            Principal = 0,
            Interest = 0,
            CollectionFee = 0,
            TotalPay = 0,
            LoanOutstanding = first.LoanOutstanding + first.Principal
        };
    }


    private static LoanScheduleDtoCreate CreateClosingRow(LoanScheduleDtoCreate last)
    {
        return new LoanScheduleDtoCreate
        {
            InstallmentNo = last.InstallmentNo + 1,
            PaymentDate = null,
            TotalDay = 0,
            Principal = last.LoanOutstanding,
            Interest = 0,
            CollectionFee = 0,
            TotalPay = 0,
            LoanOutstanding = 0
        };
    }

}