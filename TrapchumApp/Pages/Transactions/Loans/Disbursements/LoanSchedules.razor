@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Applications.Requests.Loans.Disbursements
@using TrapchumApp.Services
<RadzenDataGrid Responsive="true"
                    Density="Density.Compact"
                    GridLines="DataGridGridLines.Both"
                    AllowSorting="false"
                    ColumnWidth="15rem"
                    RowSelect="@OnRowSelect"
                    RowRender="@OnRowRender"
                    TItem="LoanScheduleDtoCreate"
                    Data="@Schedules">
        <Columns>
            <RadzenDataGridColumn Width="2.5rem" TextAlign="TextAlign.Center" Property="InstallmentNo" Title="No" Context="c">
                <Template>
                    @c.InstallmentNo
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="12rem"
                                  Property="PaymentDate"
                                  Title="Payment Date"
                                  Context="c">
                <Template>
                    <small>
                        @c.PaymentDate.DayFirst()-
                        <small>@c.PaymentDate!.Value.DayOfWeek</small>
                    </small>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="6rem" TextAlign="TextAlign.Center" Property="TotalDay" Title="Total Day" Context="c">
                <Template>
                    @c.TotalDay
                </Template>
                <FooterTemplate>
                    <strong>
                        @Schedules.Sum(p => p.TotalDay)
                    </strong>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="10rem" TextAlign="TextAlign.Right" Property="Principal" Title="Principal" Context="c">
                <Template>
                    @c.Principal.Format(CurrencyId)
                </Template>
                <FooterTemplate>
                    <strong>
                        @Schedules.Sum(p => p.Principal).Format(CurrencyId)
                    </strong>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="10rem" TextAlign="TextAlign.Right" Property="Interest" Title="Interest" Context="c">
                <Template>
                    @c.Interest.Format(CurrencyId)
                </Template>
                <FooterTemplate>
                    <strong>
                        @Schedules.Sum(p => p.Interest).Format(CurrencyId)
                    </strong>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="10rem" TextAlign="TextAlign.Right" Property="CollectionFee" Title="Collection Fee" Context="c">
                <Template>
                    @c.CollectionFee.Format(CurrencyId)
                </Template>
                <FooterTemplate>
                    <strong>
                        @Schedules.Sum(p => p.CollectionFee).Format(CurrencyId)
                    </strong>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="10rem" TextAlign="TextAlign.Right" Property="TotalPay" Title="Total Pay" Context="c">
                <Template>
                    @c.TotalPay.Format(CurrencyId)
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Width="10rem" TextAlign="TextAlign.Right" Property="LoanOutstanding" Title="Outstanding" Context="c">
                <Template>
                    @c.LoanOutstanding.Format(CurrencyId)
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
@code {
    [Parameter] public int? CurrencyId { get; set; } = 1;
    [Parameter] public VCustomerList? Customer { get; set; }
    [Parameter] public IEnumerable<LoanScheduleDtoCreate> Schedules { get; set; } = [];

    void OnRowRender(RowRenderEventArgs<LoanScheduleDtoCreate> arg)
    {
        if (arg.Data.InstallmentNo % 5 == 0)
        {
            arg.Attributes.Add("class", "rz-state-highlight rz-data-row recently-edited");
        }
    }

    void OnRowSelect(LoanScheduleDtoCreate arg)
    {
        // Handle row selection if needed
    }
}