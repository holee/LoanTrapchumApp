<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Icon="info" Text="Show Late Schedule" Click="(() => GetCustomerLateSchedules(Schedule))" />
    <RadzenMenuItem Icon="money" Text="Recieve Payment" />
    <RadzenMenuItem Icon="paid" Text="PayOff" />
</RadzenMenu>
@code {

    [Parameter] public VSchedule? Schedule { set; get; }
    [Parameter] public EventCallback<VSchedule?> GetScheduleChanged { get; set; }
    async Task GetCustomerLateSchedules(VSchedule? p)
    {
        if (p is not null)
        {
            await GetScheduleChanged.InvokeAsync(p);
        }

    }

}


