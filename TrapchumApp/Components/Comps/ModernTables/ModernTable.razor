@typeparam TItem
@using System.Reflection

<CascadingValue Value="this" IsFixed="true">
    <div style="display:none">@Columns</div>
</CascadingValue>

<div class="modern-table-container">
    @if (ShowSearch || ShowPageSize)
    {
        <div class="modern-table-toolbar">
            <div class="toolbar-left">
                @if (ShowPageSize)
                {
                    <span class="text-sm">Show</span>
                    <select class="modern-select" @onchange="OnPageSizeChange">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size" selected="@(size == PageSize)">@size</option>
                        }
                    </select>
                    <span class="text-sm">entries</span>
                }
            </div>
            <div class="toolbar-right">
                @if (ShowSearch)
                {
                    <div class="search-box">
                        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" class="modern-input" placeholder="Search..." @bind="SearchTerm" @bind:event="oninput" />
                    </div>
                }
            </div>
        </div>
    }

    @if (Loading)
    {
        <div class="modern-table-progress">
            <div class="modern-table-progress-indeterminate"></div>
        </div>
    }

    <div class="modern-table-wrapper">
        <table class="modern-table">
            <thead>
                <tr>
                    @foreach (var col in _columns)
                    {
                        <th style="width: @col.Width; text-align: @col.TextAlign;" @onclick="() => OnSort(col)" class="@(col.Sortable ? "sortable" : "")">
                            <div class="th-content" style="justify-content: @(col.TextAlign == "right" ? "flex-end" : col.TextAlign == "center" ? "center" : "flex-start")">
                                <span>@col.Title</span>
                                @if (col.Sortable)
                                {
                                    <span class="sort-icon @GetSortClass(col)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12 5v14M19 12l-7 7-7-7" class="down" />
                                            <path d="M5 12l7-7 7 7" class="up" />
                                        </svg>
                                    </span>
                                }
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Loading)
                {
                    <tr class="no-hover">
                        <td colspan="@_columns.Count" class="loading-state">
                            <div class="loading-content">
                                <span class="loading-spinner"></span>
                                <p>@LoadingText</p>
                            </div>
                        </td>
                    </tr>
                }
                else if (FilteredItems.Any())
                {
                    @foreach (var item in PagedItems)
                    {
                        <tr @onclick="() => OnRowClick(item)">
                            @foreach (var col in _columns)
                            {
                                <td style="text-align: @col.TextAlign;">
                                    @if (col.Template != null)
                                    {
                                        @col.Template(item)
                                    }
                                    else if (!string.IsNullOrEmpty(col.Property))
                                    {
                                        @GetPropertyValue(item, col.Property)
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@_columns.Count" class="empty-state">
                            <div class="empty-content">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                                <p>No data available</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (ShowPagination && TotalPages > 1)
    {
        <div class="modern-pagination">
            <div class="pagination-info">
                Showing @((CurrentPage - 1) * PageSize + 1) to @Math.Min(CurrentPage * PageSize, TotalItems) of @TotalItems entries
            </div>
            <div class="pagination-controls">
                <button class="page-btn" disabled="@(CurrentPage == 1)" @onclick="() => ChangePage(CurrentPage - 1)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                
                @for (int i = 1; i <= TotalPages; i++)
                {
                    var pageIndex = i;
                    if (TotalPages > 7)
                    {
                        if (pageIndex == 1 || pageIndex == TotalPages || (pageIndex >= CurrentPage - 1 && pageIndex <= CurrentPage + 1))
                        {
                            <button class="page-btn @(CurrentPage == pageIndex ? "active" : "")" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                        }
                        else if (pageIndex == CurrentPage - 2 || pageIndex == CurrentPage + 2)
                        {
                            <span class="page-ellipsis">...</span>
                        }
                    }
                    else
                    {
                        <button class="page-btn @(CurrentPage == pageIndex ? "active" : "")" @onclick="() => ChangePage(pageIndex)">@pageIndex</button>
                    }
                }

                <button class="page-btn" disabled="@(CurrentPage == TotalPages)" @onclick="() => ChangePage(CurrentPage + 1)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public IEnumerable<TItem> Items { get; set; } = Array.Empty<TItem>();
    [Parameter] public RenderFragment? Columns { get; set; }
    [Parameter] public bool ShowSearch { get; set; } = true;
    [Parameter] public bool ShowPageSize { get; set; } = true;
    [Parameter] public bool ShowPagination { get; set; } = true;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public int[] PageSizeOptions { get; set; } = new[] { 5, 10, 25, 50, 100 };
    [Parameter] public EventCallback<TItem> OnRowClicked { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string LoadingText { get; set; } = "Loading items...";

    private List<ModernTableColumn<TItem>> _columns = new();
    private string _searchTerm = "";
    private string? _sortProperty;
    private bool _sortAscending = true;
    private int _currentPage = 1;

    public string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            _currentPage = 1; // Reset to first page on search
        }
    }

    public int CurrentPage => _currentPage;
    public int TotalItems => FilteredItems.Count();
    public int TotalPages => TotalItems == 0 ? 1 : (int)Math.Ceiling(TotalItems / (double)PageSize);

    internal void AddColumn(ModernTableColumn<TItem> column)
    {
        _columns.Add(column);
        StateHasChanged();
    }

    internal void RemoveColumn(ModernTableColumn<TItem> column)
    {
        _columns.Remove(column);
        StateHasChanged();
    }

    private IEnumerable<TItem> FilteredItems
    {
        get
        {
            if (Items == null) return Array.Empty<TItem>();
            var query = Items;
            if (!string.IsNullOrWhiteSpace(SearchTerm))
            {
                query = query.Where(item => MatchesSearch(item));
            }

            if (!string.IsNullOrEmpty(_sortProperty))
            {
                var propInfo = typeof(TItem).GetProperty(_sortProperty, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
                if (propInfo != null)
                {
                    if (_sortAscending)
                    {
                        query = query.OrderBy(x => propInfo.GetValue(x));
                    }
                    else
                    {
                        query = query.OrderByDescending(x => propInfo.GetValue(x));
                    }
                }
            }

            return query;
        }
    }

    private IEnumerable<TItem> PagedItems => FilteredItems.Skip((_currentPage - 1) * PageSize).Take(PageSize);

    private bool MatchesSearch(TItem item)
    {
        foreach (var col in _columns.Where(c => !string.IsNullOrEmpty(c.Property)))
        {
            var val = GetPropertyValue(item, col.Property!);
            if (val?.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) == true)
                return true;
        }
        return false;
    }

    private string? GetPropertyValue(TItem item, string propertyName)
    {
        var propInfo = typeof(TItem).GetProperty(propertyName, BindingFlags.Public | BindingFlags.Instance | BindingFlags.IgnoreCase);
        return propInfo?.GetValue(item)?.ToString();
    }

    private void OnSort(ModernTableColumn<TItem> col)
    {
        if (!col.Sortable || string.IsNullOrEmpty(col.Property)) return;

        if (_sortProperty == col.Property)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortProperty = col.Property;
            _sortAscending = true;
        }
        _currentPage = 1; // Reset to first page on sort
    }

    private string GetSortClass(ModernTableColumn<TItem> col)
    {
        if (_sortProperty != col.Property) return "inactive";
        return _sortAscending ? "asc" : "desc";
    }

    private void ChangePage(int newPage)
    {
        if (newPage >= 1 && newPage <= TotalPages)
        {
            _currentPage = newPage;
        }
    }

    private void OnPageSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            PageSize = newSize;
            _currentPage = 1;
        }
    }

    private async Task OnRowClick(TItem item)
    {
        if (OnRowClicked.HasDelegate)
        {
            await OnRowClicked.InvokeAsync(item);
        }
    }
}
