@inherits InputBase<string>
<RadzenFormField Text="@Label" class="@Class">
    <ChildContent>
        <input id="@Id"
               type="@InputType"
               class="rz-textbox rz-w-100"
               @bind="CurrentValueAsString"
               @bind:event="oninput"
               name="@Name"
               placeholder="@Placeholder" />
    </ChildContent>

    <End>
        <RadzenButton Icon="@(IsPassword ? "visibility_off" : "visibility")"
                      Variant="Variant.Text"
                      Size="ButtonSize.Small"
                      @rendermode="InteractiveServer"
                      Click="@TogglePassword" />
    </End>

    <Helper>
        @* <ValidationMessage For="@ValueExpression" /> *@
    </Helper>
</RadzenFormField>

@code {
    [Parameter] public string Name { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string Label { get; set; } = "Password";
    [Parameter] public string Placeholder { get; set; } = "Enter password";
    [Parameter] public string? Class { get; set; }
    private bool IsPassword { get; set; } = true;
    private string InputType => IsPassword ? "password" : "text";
    private string Id => $"{Name}_input";
    private void TogglePassword()
    {
        IsPassword = !IsPassword;
    }

    protected override bool TryParseValueFromString(string? value, out string result, out string validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = string.Empty;
        return true;
    }
}
