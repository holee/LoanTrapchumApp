@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using Radzen
@using Radzen.Blazor

<RadzenCard class="info-card" Style="@($"background: linear-gradient(135deg, {@GradientStart}, {@GradientEnd}); border-radius: 8px; padding: 16px; margin-bottom: 16px;")">
    <RadzenRow>
        <RadzenColumn SizeXS="4" SizeLG="3" style="display: flex; align-items: center;">
            <RadzenIcon Icon="@Icon" style="font-size: 48px; color: white;" />
        </RadzenColumn>
        <RadzenColumn SizeXS="8" SizeLG="9">
            <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.End">
                <RadzenText TextStyle="TextStyle.H4" style="color: white; margin: 0;">@Title</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2" style="color: rgba(255,255,255,0.8);">@Subtitle</RadzenText>
                <RadzenText TextStyle="TextStyle.H3" style="color: white; margin-top: 8px;">@Count.ToString("N0")</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" style="color: rgba(255,255,255,0.7);">
                    <RadzenIcon Icon="trending_up" style="font-size: 16px; margin-right: 4px;" />
                    @PercentageIncrease% increase in 30 days
                </RadzenText>
                <RadzenButton Text="More Info" ButtonStyle="ButtonStyle.Light" style="margin-top: 8px;" Click="@OnMoreInfoClick" />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    @if (ChildContent is not null)
    {
        @ChildContent
    }
</RadzenCard>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    [Parameter]
    public string Title { get; set; } = "Metric";

    [Parameter]
    public string Subtitle { get; set; } = "Last 30 Days";

    [Parameter]
    public int Count { get; set; } = 0;

    [Parameter]
    public double PercentageIncrease { get; set; } = 0.0;

    [Parameter]
    public string Icon { get; set; } = "info";

    [Parameter]
    public string GradientStart { get; set; } = "#4CAF50";

    [Parameter]
    public string GradientEnd { get; set; } = "#81C784";

    [Parameter]
    public EventCallback OnMoreInfoClick { get; set; }
}