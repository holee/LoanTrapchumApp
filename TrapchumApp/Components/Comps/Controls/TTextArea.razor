@using System.Linq.Expressions
@using Applications.Features.LoanRequests.Interfaces
@if (string.IsNullOrEmpty(Label) && (IsFloatLabel || !IsFloatLabel))
{
    <RadzenTextArea
        class="@Styles.W100"
        Disabled="@Disabled"
        Placeholder="@Placeholder"
        ValueChanged="async (val) => await TextChanged.InvokeAsync(val)"
        ValueExpression="@TextExpression"
        Change="@OnChanged"
        @oninput="@OnTextChanged"
        Value="@Text"/>
}
@if (!string.IsNullOrEmpty(Label) && IsFloatLabel)
{
    <RadzenFormField Text="@Label" class="@Styles.W100">
        <ChildContent>
            <RadzenTextArea
                class="@Styles.W100"
                Disabled="@Disabled"
                Placeholder="@Placeholder"
                ValueChanged="async (val) => await TextChanged.InvokeAsync(val)"
                ValueExpression="@TextExpression"
                Change="@OnChanged"
                @oninput="@OnTextChanged"
                Value="@Text"/>
        </ChildContent>
        <Helper>
            <ValidationMessage For="() => TextExpression"/>
        </Helper>
    </RadzenFormField>
}
@if (!string.IsNullOrEmpty(Label) && !IsFloatLabel)
{
    <RadzenRow>
        <RadzenColumn Size="2" SizeMD="2" SizeSM="12">
            <RadzenLabel Text="@Label"/>
        </RadzenColumn>
        <RadzenColumn Size="10" SizeMD="10" SizeSM="12">
            <RadzenTextArea
                class="@Styles.W100"
                Disabled="@Disabled"
                Placeholder="@Placeholder"
                ValueChanged="async (val) => await TextChanged.InvokeAsync(val)"
                ValueExpression="@TextExpression"
                Change="@OnChanged"
                @oninput="@OnTextChanged"
                Value="@Text"/>
            <span>
                <ValidationMessage For="() => TextExpression"></ValidationMessage>
            </span>
        </RadzenColumn>
    </RadzenRow>
}

@code {
    [Parameter] public string? Label { get; set; } = string.Empty;
    [Parameter] public string? Name { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string? Placeholder { get; set; } = "";
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool IsFloatLabel { get; set; } = false;
    [Parameter] public EventCallback<string> OnChanged { get; set; }
    [Parameter] public EventCallback<string> OnValueChanged { get; set; }
    [Parameter] public EventCallback<FocusEventArgs> MouseLeave { get; set; }
    [Parameter] public EventCallback<string> TextChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? TextExpression { get; set; }
    async Task OnTextChanged(ChangeEventArgs e)
    {
        Text = e.Value?.ToString() ?? string.Empty;
        await TextChanged.InvokeAsync(Text);   // ensures two-way bind works
    }

} 