@using System.Linq.Expressions
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Services
@if (string.IsNullOrEmpty(Label))
{
    <RadzenTextBox Value="@Value"
                   ValueExpression="@ValueExpression"
                   Change="OnChanged"
                   @oninput="TextChanged"
                   Placeholder="@PlaceHolder"
                   class="rz-w-100"
                   id="@Id"
                   Disabled="@Disabled"
                   ValueChanged="ValueChanged" />
}
@if (!string.IsNullOrEmpty(Label) && IsFloatLabel)
{
    <RadzenFormField Text="@Label" AllowFloatingLabel="true" class="rz-w-100">
        <ChildContent>
            <RadzenTextBox Value="@Value"
                           ValueExpression="@ValueExpression"
                           Change="@OnChanged"
                           @oninput="@TextChanged"
                           class="rz-w-100"
                           Name="@Name"
                           id="@Id"
                           Disabled="@Disabled"
                           Placeholder="@PlaceHolder"
                           ValueChanged="ValueChanged" />
        </ChildContent>
        <Helper>
            <ValidationMessage For="@ValueExpression" />
        </Helper>
    </RadzenFormField>
}

@if (!string.IsNullOrEmpty(Label) && @IsFloatLabel)
{
    <RadzenRow  AlignItems="AlignItems.Center">
        <RadzenColumn Size="2" SizeSM="12" SizeMD="2">
            @Label
        </RadzenColumn>
        <RadzenColumn Size="10" SizeSM="12" SizeMD="10">
            <RadzenTextBox Value="@Value"
                           ValueExpression="@ValueExpression"
                           Change="@OnChanged"
                           @oninput="@TextChanged"
                           class="rz-w-100"
                           Name="@Name"
                           id="@Id"
                           Disabled="@Disabled"
                           Placeholder="@PlaceHolder"
                           ValueChanged="ValueChanged" />
        </RadzenColumn>
    </RadzenRow>
}


@code {
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public string Name { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Label { get; set; } = string.Empty;
    [Parameter] public string? PlaceHolder { get; set; } = string.Empty;
    [Parameter] public bool IsFloatLabel { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public TextAlign TextAlign { get; set; } = TextAlign.Left;
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? ValueExpression { get; set; }
    [Parameter] public EventCallback<string> OnChanged { get; set; }

    void TextChanged(ChangeEventArgs e)
    {
        if (e.Value is string value && !string.IsNullOrEmpty(value))
        {
            Value = value;
            OnChanged.InvokeAsync(value);
        }
    }
}
