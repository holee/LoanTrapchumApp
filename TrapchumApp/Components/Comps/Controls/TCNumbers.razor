@using System.Linq.Expressions
@if (string.IsNullOrEmpty(Label))
{
    <RadzenNumeric TValue="decimal?"
                   Value="@Value"
                   Name="@Name"
                   id="@Id"
                   ValueExpression="@ValueExpression"
                   Change="@OnChanged"
                   @oninput="@OnTextChanged"
                   @onfocusout="OnMouseOut"
                   onclick="this.querySelector('.rz-numeric-input').select()"
                   ShowUpDown="false"
                   TextAlign="TextAlign"
                   class="form-control"
                   Disabled="@Disabled"
                   Min="@Min"
                   ValueChanged="@ValueChanged"
                   Placeholder="@Placeholder"
                   Format="@Format" />
}
else
{

    @if (Orientation is Orientation.Horizontal)
    {
        <div class="row mb-2">
            <label for="@Id" class="col-sm-2 col-form-label">@Label</label>
            <div class="col-sm-10">
                <RadzenNumeric TValue="decimal?"
                               Value="@Value"
                               Name="@Name"
                               id="@Id"
                               ValueExpression="@ValueExpression"
                               Change="@OnChanged"
                               @oninput="@OnTextChanged"
                               onclick="this.querySelector('.rz-numeric-input').select()"
                               ShowUpDown="false"
                               TextAlign="TextAlign"
                               class="form-control"
                               Disabled="@Disabled"
                               Min="@Min"
                               ValueChanged="@ValueChanged"
                               Placeholder="@Placeholder"
                               Format="Format" />
                <ValidationMessage For="@ValueExpression" />
            </div>
        </div>
    }
    else
    {
        <div class="mb-2">
            <label for="@Id" class="form-label">@Label</label>
            <RadzenNumeric TValue="decimal?"
                           id="@Id"
                           Name="@Name"
                           Value="@Value"
                           ValueExpression="@ValueExpression"
                           Change="@OnChanged"
                           @oninput="@OnTextChanged"
                           onclick="this.querySelector('.rz-numeric-input').select()"
                           ShowUpDown="false"
                           TextAlign="TextAlign"
                           Disabled="@Disabled"
                           Min="@Min"
                           class="form-control"
                           ValueChanged="ValueChanged"
                           Format="@Format" />
            <ValidationMessage For="@ValueExpression" />
        </div>
    }
}

@code {
    [Parameter] public string? Label { get; set; } = string.Empty;
    [Parameter] public string? Name { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string? Format { get; set; } = "#,##0.00";
    [Parameter] public string? Placeholder { get; set; } = "";
    [Parameter] public decimal? Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public TextAlign TextAlign { get; set; } = TextAlign.End;
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;
    [Parameter] public EventCallback<decimal?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<decimal?>> ValueExpression { get; set; } = default!;
    [Parameter] public EventCallback<decimal?> OnChanged { get; set; }
    [Parameter] public decimal? Min { get; set; } = 0;
    [Parameter] public EventCallback<decimal?> OnValueChanged { get; set; }
    [Parameter] public EventCallback<FocusEventArgs> MouseLeave { get; set; }

    async Task OnTextChanged(ChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(e.Value!.ToString()))
        {
            await OnValueChanged.InvokeAsync(0);
        }
        else
        {
            if (decimal.TryParse(e.Value.ToString(), out var test))
            {
                await OnValueChanged.InvokeAsync(test);
            }
            else
            {
                await OnValueChanged.InvokeAsync(0);
            }
        }


    }

    async Task OnMouseOut(FocusEventArgs e)
    {
        await MouseLeave.InvokeAsync(e);
    }
}
