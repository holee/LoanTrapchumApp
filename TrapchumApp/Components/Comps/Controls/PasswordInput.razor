@using System.Linq.Expressions
<RadzenFormField Text="Password" class="rz-my-2 rz-w-100">
    <ChildContent>
        <RadzenTextBox 
                       @bind-Value="@Value"
                       Placeholder="Password"
                       Name="@Name"
                       Visible="@(!IsPassword)" />
        <RadzenPassword @bind-Value="@Value"
                        class="@Styles.W100"
                        Name="@Name"
                        Visible="@IsPassword"
                        placeholder="Password" />
    </ChildContent>
    <End>
        <RadzenButton Icon="@(IsPassword ? "visibility" : "visibility_off")"
                      Click="TogglePassword"
                      Variant="Variant.Text" Size="ButtonSize.Small" />
    </End>
    <Helper>
       
    </Helper>
</RadzenFormField>
@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Name { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public Expression<Func<string>>? ValueExpression { get; set; }
    private bool IsPassword = true;
    private async Task TogglePassword()
    {
        IsPassword = !IsPassword;
        await js.InvokeVoidAsync("toggleInputType", Name, IsPassword ? "password" : "text");
    }
}