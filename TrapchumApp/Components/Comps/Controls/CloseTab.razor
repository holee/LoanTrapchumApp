@using Applications.Features.LoanRequests.Interfaces
@using System.Threading.Tasks
<span style="display: flex;">
    @if (!string.IsNullOrEmpty(Title))
    {
        @Title
    }
    <RadzenButton Icon="@IconNames.Close" @onclick:stopPropagation
                  Variant="Variant.Text"
                  Shade="Shade.Lighter"
                  Click="@ClosedTab"
                  Size="ButtonSize.ExtraSmall" />
</span>
@code {

    [Parameter] public long TabId { get; set; }
    [Parameter] public EventCallback<long> Closed { get; set; }
    [Parameter] public string? Title { get; set; } = string.Empty;

    async Task ClosedTab()
    {
        if (Closed.HasDelegate && TabId > -1)
        {
            await Closed.InvokeAsync(TabId);
        }

    }
}
