@using System.Linq.Expressions
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Services
@if (!string.IsNullOrEmpty(Text))
{
    @if (Orientation == Orientation.Horizontal)
    {
        <div class="row mb-2">
            <label for="@Id" class="col-sm-2 col-form-label">@Text</label>
            <div class="col-sm-10">
                <RadzenDatePicker InputClass="w-100"
                                  Value="@Value"
                                  Change="@Changed"
                                  ValueChanged="@ValueChanged"
                                  ValueExpression="@ValueExpression"
                                  TValue="DateTime?"
                                  id="@Id"
                                  DateFormat="dd/MM/yyyy" />
                @if (ShowError)
                {
                    <div class="invalid-feedback">
                        <ValidationMessage For="@ValueExpression" />
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="mb-2">
            <label for="@Id" class="form-label">@Text</label>
            <RadzenDatePicker InputClass="w-100"
                              Value="@Value"
                              Change="@Changed"
                              ValueChanged="@ValueChanged"
                              ValueExpression="@ValueExpression"
                              TValue="DateTime?"
                              id="@Id"
                              DateFormat="dd/MM/yyyy" />
            @if (ShowError)
            {
                <div class="invalid-feedback">
                    <ValidationMessage For="@ValueExpression" />
                </div>
            }
        </div>

    }
}else{
    <RadzenDatePicker InputClass="rz-w-100"
                      Value="@Value"
                      Change="@Changed"
                      ValueChanged="@ValueChanged"
                      ValueExpression="@ValueExpression"
                      TValue="DateTime?"
                      id="@Id"
                      DateFormat="dd/MM/yyyy" />
}
@code {
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string? Text { get; set; } = string.Empty;
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public bool ShowError { get; set; } = false;
    [Parameter] public EventCallback<DateTime?> Changed { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<DateTime?>>? ValueExpression { get; set; }
}
