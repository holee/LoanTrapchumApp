@using System.Linq.Expressions
@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Services
<RadzenFormField AllowFloatingLabel="false">
    <Start>
        <RadzenIcon Icon="@Icon"></RadzenIcon>
    </Start>
    <ChildContent>
        <RadzenTextBox Value="@Value"
                       Change="@OnChanged"
                       ValueChanged="ValueChanged"
                       ValueExpression="@ValueExpression"
                       @oninput="@OnTextChanged" />
    </ChildContent>
</RadzenFormField>
@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnChanged { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? ValueExpression { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnTextChanged { get; set; }
}
