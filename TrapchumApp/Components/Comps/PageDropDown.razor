@using Applications.Interfaces.Branches
<div class="rz-p-2">
    <RadzenRow AlignItems="AlignItems.Center" Gap="1rem">
        <RadzenColumn Size="12" SizeSM="12" SizeMD="6">
            <RadzenStack AlignItems="AlignItems.Center"
                         Orientation="Radzen.Orientation.Horizontal">
                @if (LeftChildContent is not null)
                {
                    @LeftChildContent
                }
                <div class="dropdown">
                    <RadzenButton class="btn rz-background-color-base-100"
                                  ButtonType="Radzen.ButtonType.Button"
                                  Size="Radzen.ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Light"
                                  data-bs-toggle="dropdown"
                                  Shade="Shade.Default"
                                  aria-expanded="false">
                        Show @(pageSize) rows
                    </RadzenButton>
                    <ul class="dropdown-menu">
                        <li><button onclick="@(()=>ChangedPageSize(10))" class="btn-sm dropdown-item @(pageSize==10?"active":null)" type="button">10 Rows</button></li>
                        <li><button onclick="@(()=>ChangedPageSize(25))" class="btn-sm dropdown-item @(pageSize==25?"active":null)" type="button">25 Rows</button></li>
                        <li><button onclick="@(()=>ChangedPageSize(50))" class="btn-sm dropdown-item @(pageSize==50?"active":null)" type="button">50 Rows</button></li>
                        <li><button onclick="@(()=>ChangedPageSize(100))" class="btn-sm dropdown-item @(pageSize==100?"active":null)" type="button">100 Rows</button></li>
                    </ul>
                </div>
                @if (ShowReload)
                {
                    <RadzenButton Size="Radzen.ButtonSize.Small"
                                  Icon="refresh"
                                  class="w-auto"
                                  Click="Reload"
                                  ButtonStyle="ButtonStyle.Secondary" />
                }
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="12" SizeMD="6">
            <RadzenStack AlignItems="AlignItems.Center"
                         Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End">
                @if (RightChildContent is not null)
                {
                    @RightChildContent
                }
                @if (ShowSearchBox)
                {
                    <RadzenFormField AllowFloatingLabel="false">
                        <Start>
                            <RadzenIcon Icon="search" />
                        </Start>
                        <ChildContent>
                            <RadzenTextBox @bind-Value="@filterText"
                                           Placeholder="@PlaceHolder"
                                           @oninput="TextChangedHandler" />
                        </ChildContent>
                    </RadzenFormField>
                }
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
</div>
@code {
    int pageSize { get; set; } = 10;
    string filterText = "";
    [Parameter] public RenderFragment LeftChildContent { get; set; } = default!;
    [Parameter] public RenderFragment RightChildContent { get; set; } = default!;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public EventCallback Reload { get; set; }
    [Parameter] public bool ShowReload { get; set; } = false;
    [Parameter] public bool ShowSearchBox { get; set; } = false;
    [Parameter] public EventCallback<string> OnTextChanged { get; set; }
    [Parameter] public string? PlaceHolder { get; set; } = "Type here to search";
    async void ChangedPageSize(int pageSize)
    {
        this.pageSize = pageSize;
        await PageSizeChanged.InvokeAsync(pageSize);
    }
    async Task ReloadAction()
    {
        await Reload.InvokeAsync();
    }

    async Task TextChangedHandler(ChangeEventArgs e)
    {
        filterText = e.Value?.ToString() ?? string.Empty;
        await OnTextChanged.InvokeAsync(filterText);
    }


}
