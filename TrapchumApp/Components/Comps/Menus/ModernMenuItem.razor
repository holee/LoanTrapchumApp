@namespace TrapchumApp.Components.Comps.Menus

@if (string.IsNullOrEmpty(Href))
{
    <div class="mud-menu-item @(Disabled ? "mud-item-disabled" : "") @Class"
         style="@Style"
         role="menuitem"
         @onclick="OnClickHandler">
        @if (!string.IsNullOrEmpty(Icon))
        {
            @if (IsRadzenIcon)
            {
                <RadzenIcon Icon="@Icon" class="mud-item-icon" />
            }
            else
            {
                <i class="@Icon mud-item-icon" aria-hidden="true"></i>
            }
        }
        <span class="mud-item-text">
            @if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                @Label
            }
        </span>
    </div>
}
else
{
    <a href="@Href"
       target="@Target"
       class="mud-menu-item @(Disabled ? "mud-item-disabled" : "") @Class"
       style="@Style"
       role="menuitem"
       @onclick="OnClickHandler">
        @if (!string.IsNullOrEmpty(Icon))
        {
            @if (IsRadzenIcon)
            {
                <RadzenIcon Icon="@Icon" class="mud-item-icon" />
            }
            else
            {
                <i class="@Icon mud-item-icon" aria-hidden="true"></i>
            }
        }
        <span class="mud-item-text">
            @if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                @Label
            }
        </span>
    </a>
}

@code {
    [CascadingParameter] public ModernMenu? Menu { get; set; }

    [Parameter] public string? Label { get; set; }
    /// <summary>
    /// Icon name. Supports both:
    /// - Material Icons (Radzen): "person", "settings", "delete" 
    /// - Line Awesome / Font Awesome: "la la-user", "fa fa-cog"
    /// Auto-detected based on prefix.
    /// </summary>
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }

    /// <summary>
    /// Returns true if the icon is a Material/Radzen icon (no prefix like "la", "fa", "bi", "ri").
    /// Returns false if it's a CSS class-based icon (Line Awesome, Font Awesome, etc.).
    /// </summary>
    private bool IsRadzenIcon =>
        !string.IsNullOrEmpty(Icon) &&
        !Icon.StartsWith("la ", StringComparison.OrdinalIgnoreCase) &&
        !Icon.StartsWith("la-", StringComparison.OrdinalIgnoreCase) &&
        !Icon.StartsWith("fa ", StringComparison.OrdinalIgnoreCase) &&
        !Icon.StartsWith("fa-", StringComparison.OrdinalIgnoreCase) &&
        !Icon.StartsWith("bi ", StringComparison.OrdinalIgnoreCase) &&
        !Icon.StartsWith("bi-", StringComparison.OrdinalIgnoreCase) &&
        !Icon.StartsWith("ri-", StringComparison.OrdinalIgnoreCase) &&
        !Icon.StartsWith("icon-", StringComparison.OrdinalIgnoreCase);

    private async Task OnClickHandler(Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        if (Disabled) return;

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(args);
        }

        if (Menu != null)
        {
            await Menu.Close();
        }
    }
}
