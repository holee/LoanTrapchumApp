@using Applications.ApplicationPolicies
@using Applications.Extensions.Identity.Authorizations.Extensions
<RadzenPanelMenuItem Text="Loan Management" Icon="dataset">
    @* 
     for account only
    *@
    <RadzenPanelMenuItem Text="Loans" Icon="lists" Path="@($"/App/Loan/{BranchId}/Branches?UserId={UserId}")" Visible="@_canShowLoan" />
    <RadzenPanelMenuItem Text="Client Due Pay" Icon="schedule" Path="@($"/App/Loan/{BranchId}/Branches/{UserId}/Users/Schedules")" Visible="@_canShowLoan"/>
    <RadzenPanelMenuItem Text="Loan Write Off" Icon="person_off" Path="/App/Loan/WriteOff" Visible="@_isAccountOnly"/>
    @* 
        for admin only
    *@
    <RadzenPanelMenuItem Text="Guarantor" Icon="how_to_reg" Path="/App/Customer/Guarantor" Visible="@_isAdminOnly"/>
    <RadzenPanelMenuItem Text="Credit Officer" Icon="switch_account" Path="/App/Employee/CreditAgent" Visible="@_isAdminOnly"/>
    <RadzenPanelMenuItem Text="Loan Product" Icon="inventory_2" Path="/App/Loan/LoanProduct" Visible="@_isAdminOnly"/>
    <RadzenPanelMenuItem Text="Loan Category" Icon="lists" Path="/App/Loan/Categories" Visible="@_isAdminOnly"/>
    <RadzenPanelMenuItem Text="Holidays" Icon="calendar_add_on" Path="/App/Holiday" Visible="@_isAdminOnly"/>
    @* 
     for all roles
    *@
    
    <RadzenPanelMenuItem Text="Customers" Icon="group" Path="@($"/App/Customer/{BranchId}/Branches?UserId={UserId}")" />
    <RadzenPanelMenuItem Text="Collaterals" Icon="invert_colors" Path="/App/Customer/Collateral"/>
    <RadzenPanelMenuItem Text="Loan Request" Icon="request_quote" Path="@($"/App/Request/{BranchId}/Branches/?UserId={UserId}")" Visible="_canShowLoanRequest" />
</RadzenPanelMenuItem>

@code {
    [Parameter] public int BranchId { get; set; } = 0;
    [Parameter] public string UserId { get; set; } = string.Empty;
    [Parameter] public bool BranchState { get; set; } = false;
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    string _loanRequestUrl = "";
    string _changeCreditUrl = "";
    string _clientDuePayUrl = "";
    string _customerUrl = "";
    string _loanUrl = "";
    bool _canShowLoan = false;
    bool _canShowLoanRequest = false;
    bool _isAdminOnly = false;
    bool _isCreditAgentOnly = false;
    bool _isManagerOnly = false;
    bool _canReadLoanRequest = false;
    bool _isAccountOnly = false;
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState;

        var user = state.User;

        _canShowLoan = await _authorizeService.MustHasPermissionAsync(user, LoanPolicies.Read);

        _canShowLoanRequest = await _authorizeService.MustHasPermissionAsync(user, RequestsPolicies.Read);

        _isAdminOnly = await _authorizeService.MustHasPermissionAsync(user, RolePolicies.AdminOnly);

        _isCreditAgentOnly = await _authorizeService.MustHasPermissionAsync(user, RolePolicies.CreditOfficerOnly);

        _isManagerOnly = await _authorizeService.MustHasPermissionAsync(user, RolePolicies.ManagerOnly);

        _canReadLoanRequest = await _authorizeService.MustHasPermissionAsync(user, AppPermission.RuleFor(Modules.LoanRequest, Feature.Read));

        _isAccountOnly = await _authorizeService.MustHasPermissionAsync(user, RolePolicies.AccountOnly);
        
        _changeCreditUrl = $"/App/Loan/CreditAgent/{BranchId}/Branches?UserId={UserId}";
        _loanRequestUrl = $"/App/Request/{BranchId}/Branches/?UserId={UserId}";
        _clientDuePayUrl = $"/App/Loan/{BranchId}/Branches/{UserId}/Users/Schedules";
        _customerUrl = $"/App/Customer/{BranchId}/Branches?UserId={UserId}";
        _loanUrl = $"/App/Loan/{BranchId}/Branches?UserId={UserId}";
        
        await base.OnInitializedAsync();
    }

}
