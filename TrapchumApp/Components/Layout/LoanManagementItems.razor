@using Applications.Extensions.Identity.Authorizations.Extensions
@using Applications.Features.LoanRequests.Interfaces
@using TrapchumApp.Helpers.Extensions
<RadzenPanelMenuItem Text="Loan Management" Icon="dataset">
    <RadzenPanelMenuItem Text="Loans Disbursement" Icon="lists" Path="@($"/app/loan/disbursment/{BranchId}/branches")" Visible="@_canShowLoan" />
    <RadzenPanelMenuItem Text="Client Due Pay"
                         Icon="schedule"
                         Path="@($"/app/loan/schedules/{BranchId}/branches")" Visible="@_canShowLoan"/>
    <RadzenPanelMenuItem Text="Loan Write Off" Icon="person_off" Path="@($"/app/loan/disbursement/write-off/{BranchId}")" Visible="@_isAccountOnly" />
    <RadzenPanelMenuItem Text="Loan Pay Off" Icon="person_off" Path="@($"/app/loan/disbursement/pay-off/{BranchId}")" Visible="@_isAccountOnly" />
    <RadzenPanelMenuItem Text="Loans Request" Icon="request_quote" Path="@($"/app/loan/request/{BranchId}/branches")"
                         Visible="@_isAccountOnly"/>
</RadzenPanelMenuItem>

@code {
    [Parameter] public int BranchId { get; set; } = 0;
    [Parameter] public bool BranchState { get; set; } = false;
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    string _loanRequestUrl = "";
    string _changeCreditUrl = "";
    string _clientDuePayUrl = "";
    string _customerUrl = "";
    string _loanUrl = "";
    private string? _userId = string.Empty;
    bool _canShowLoan = false;
    bool _canShowLoanRequest = false;
    bool _isAdminOnly = false;
    bool _isCreditAgentOnly = false;
    bool _isManagerOnly = false;
    bool _canReadLoanRequest = false;
    bool _isAccountOnly = false;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState;

        var user = state.User;
        
        _userId = state.GetUserId();

        _canShowLoan = await _authorizeService.MustHasPermissionAsync(user, LoanPolicies.Read);

        _canShowLoanRequest = await _authorizeService.MustHasPermissionAsync(user, RequestsPolicies.Read);

        _isAdminOnly = await _authorizeService.MustHasPermissionAsync(user, RolePolicies.AdminOnly);

        _isCreditAgentOnly = await _authorizeService.MustHasPermissionAsync(user, RolePolicies.CreditOfficerOnly);

        _isManagerOnly = await _authorizeService.MustHasPermissionAsync(user, RolePolicies.ManagerOnly);

        _canReadLoanRequest = await _authorizeService.MustHasPermissionAsync(user, AppPermission.RuleFor(Modules.LoanRequest, Feature.Read));

        _isAccountOnly = await _authorizeService.MustHasPermissionAsync(user, RolePolicies.AccountOnly);

        _changeCreditUrl = $"/App/Loan/CreditAgent/{BranchId}/Branches";

        _loanRequestUrl = $"/App/Request/{BranchId}/Branches";

        _clientDuePayUrl = $"/App/Loan/{BranchId}/Branches/Schedules";

        _customerUrl = $"/App/Customer/{BranchId}/Branches";

        _loanUrl = $"/App/Loan/{BranchId}/Branches";

        await base.OnInitializedAsync();
    }

}
