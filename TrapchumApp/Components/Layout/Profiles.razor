@implements IDisposable
@inject TrapchumApp.Services.IProfilePhotoService ProfilePhotoService

<div class="fb-profile-wrap">
<div class="fb-profile-trigger" @ref="_triggerRef" data-fb-trigger @onclick="ToggleMenu" @onclick:stopPropagation="true">
    <div class="fb-avatar fb-avatar--sm">
        @if (!string.IsNullOrWhiteSpace(_photoUrl))
        {
            <img src="@_photoUrl" alt="@_displayName" class="fb-avatar__img" />
        }
        else
        {
            @_initials
        }
    </div>
    <span class="fb-trigger-name">@_displayName</span>
    <span class="fb-trigger-chevron @(_open ? "fb-trigger-chevron--up" : "")">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M7 10l5 5 5-5z" />
        </svg>
    </span>
</div>

@if (_open)
{
    <div class="fb-backdrop" @onclick="CloseMenu"></div>
    <div class="fb-dropdown" style="@_dropdownStyle" @onclick:stopPropagation="true">
        <AuthorizeView Context="u">
            <Authorized>

                @* ── Profile card ── *@
                <a class="fb-profile-card" href="@($"App/Account/Profile/{_userId}/User")">
                    <div class="fb-avatar fb-avatar--lg">
                        @if (!string.IsNullOrWhiteSpace(_photoUrl))
                        {
                            <img src="@_photoUrl" alt="@_displayName" class="fb-avatar__img" />
                        }
                        else
                        {
                            @_initials
                        }
                    </div>
                    <div class="fb-profile-card__info">
                        <span class="fb-profile-card__name">@u.User.Identity!.Name</span>
                        <span class="fb-profile-card__sub">See your profile →</span>
                    </div>
                </a>

                <div class="fb-divider"></div>

                @* ── Quick actions ── *@
                <div class="fb-section-label">Account</div>
                <a class="fb-menu-item" href="@($"App/Account/Profile/{_userId}/User")">
                    <span class="fb-menu-item__icon fb-menu-item__icon--blue">
                        <RadzenIcon Icon="contact_page" />
                    </span>
                    <div class="fb-menu-item__body">
                        <span class="fb-menu-item__title">My Profile</span>
                        <span class="fb-menu-item__sub">View and edit your profile</span>
                    </div>
                    <RadzenIcon Icon="chevron_right" Style="color:var(--rz-text-secondary-color);font-size:1.1rem;" />
                </a>
                <a class="fb-menu-item" href="/">
                    <span class="fb-menu-item__icon fb-menu-item__icon--gray">
                        <RadzenIcon Icon="manage_accounts" />
                    </span>
                    <div class="fb-menu-item__body">
                        <span class="fb-menu-item__title">Settings</span>
                        <span class="fb-menu-item__sub">Privacy, security &amp; preferences</span>
                    </div>
                    <RadzenIcon Icon="chevron_right" Style="color:var(--rz-text-secondary-color);font-size:1.1rem;" />
                </a>

                <div class="fb-divider"></div>

                @* ── Log out ── *@
                <div class="fb-section-label">Session</div>
                <div class="fb-menu-item fb-menu-item--logout">
                    <span class="fb-menu-item__icon fb-menu-item__icon--red">
                        <RadzenIcon Icon="logout" />
                    </span>
                    <div class="fb-menu-item__body">
                        <form action="/Account/Logout" method="post" style="margin:0;">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@_currentUrl" />
                            <button type="submit" class="fb-logout-btn">
                                <span class="fb-menu-item__title">Log Out</span>
                                <span class="fb-menu-item__sub">@u.User.Identity!.Name</span>
                            </button>
                        </form>
                    </div>
                </div>

                <div class="fb-dropdown__footer">
                    <span>Privacy · Terms · Advertising · Cookies</span>
                    <span>&copy; @DateTime.Now.Year LoanMS</span>
                </div>

            </Authorized>
        </AuthorizeView>
    </div>
}
</div>

@code {
    [CascadingParameter] Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private ElementReference _triggerRef;
    private string? _userId = string.Empty;
    private string _displayName = string.Empty;
    private string _initials = "?";
    private string? _photoUrl;
    private string _currentUrl = string.Empty;
    private bool _open = false;
    private string _dropdownStyle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationState;
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            _userId = authState.GetUserId();

            _displayName = user.Identity.Name ?? string.Empty;

            _initials = BuildInitials(_displayName);

            var profile = await _userService.GetUserProfile(_userId);
            if (!profile.IsError)
                _photoUrl = profile.Value?.FileUrl;
        }

        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        NavigationManager.LocationChanged += OnLocationChanged;

        ProfilePhotoService.OnPhotoChanged += OnProfilePhotoChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        _open = false;
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleMenu()
    {
        _open = !_open;

        if (_open)
        {
            var rect = await js.InvokeAsync<BoundingRect>("getElementRect", _triggerRef);
            _dropdownStyle = $"top:{rect.Bottom:F1}px;right:{rect.Right:F1}px;";
        }
    }
    private void CloseMenu() => _open = false;

    private static string BuildInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[^1][0])}"
            : char.ToUpper(parts[0][0]).ToString();
    }

    private void OnProfilePhotoChanged(string userId, string? newUrl)
    {
        if (userId != _userId) return;
        _photoUrl = newUrl;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        ProfilePhotoService.OnPhotoChanged -= OnProfilePhotoChanged;
    }

    private sealed record BoundingRect(double Bottom, double Right);
}
