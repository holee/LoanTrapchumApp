@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Services
<RadzenPanelMenuItem Text="Currencies" Icon="money" Visible="IsBranchOpen">
    <RadzenPanelMenuItem Text="Currencies List" Icon="attach_money" Path="/App/Currencies" />
    <RadzenPanelMenuItem Text="Currency Note" Icon="money" Path="@($"/App/Currencies/CurrencyCounter?BranchId={BranchId}")" />
    <RadzenPanelMenuItem Text="Set Daily Spot Rate" Icon="mintmark" Path="/App/Currencies/SetDailySpotRate" />
    <RadzenPanelMenuItem Text="Money Exchange" Icon="currency_exchange" Path="@($"/App/Currencies/Exchange/{BranchId}/Branches")" />
</RadzenPanelMenuItem>
@code {
    [Parameter] public string? UserId { get; set; } = string.Empty;
    [Parameter] public int BranchId { get; set; } = 0;
    [Parameter] public bool IsBranchOpen { get; set; } = false;
    [Parameter] public EventCallback ShowDialogue { get; set; } = default!;
    async Task ShowCurrencyDialogue()
    {
        await ShowDialogue.InvokeAsync();
    }
}
