@using Applications.Features.LoanRequests.Services
@using TrapchumApp.Helpers.Constants
@using TrapchumApp.Services
<RadzenPanelMenuItem Text="Operated Person" Icon="@IconNames.PersonBook">
    <RadzenPanelMenuItem Text="Customers" Icon="group" Path="@($"/App/Customer/{BranchId}/Branches?UserId={@UserId}")" />
    <RadzenPanelMenuItem Text="Employees" Icon="person" Path="@($"/App/Employee?UserId={@UserId}")" />
    <RadzenPanelMenuItem Text="Vendors" Icon="supervisor_account" Path="@($"/App/Vendor?UserId={@UserId}")" />
    <RadzenPanelMenuItem Text="Guarantors" Icon="contact_page" Path="@($"/App/Customer/Guarantor?UserId={@UserId}")" />
    <RadzenPanelMenuItem Text="Names" Icon="contacts" Path="@($"/App/Names?UserId={@UserId}")" />
</RadzenPanelMenuItem>
@code {
    [Parameter] public string? UserId { get; set; }
    [Parameter] public int? BranchId { get; set; } = 0;
}