@using Applications.Features.Addresses
@using Applications.Features.Branches
@using Applications.Features.Currencies
@using Applications.Features.Customers.Services
@using Applications.Features.Employees
@using Applications.Features.LoanRequests.Interfaces
@using Applications.Features.Notifications.Dto
@using Microsoft.AspNetCore.Components.Routing
@using TrapchumApp.Helpers.Constants
@using TrapchumApp.Pages.Transactions.Exchanges
@using TrapchumApp.Services
@inherits LayoutComponentBase
<RadzenComponents @rendermode="InteractiveServer" />
<RadzenProgressBar Visible="@isLoading"
                   Mode="ProgressBarMode.Indeterminate"
                   Value="100"
                   ShowValue="false"
                   ProgressBarStyle="ProgressBarStyle.Danger"
                   Style="height: 2px; position: fixed; top: 0; left: 0; width: 100%; z-index: 9999;" />
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Center" Gap="0">


            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center">
                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center">
                <NotificationBell />
                <TopMenus IsBranchOpen="true" ShowDialogue="ShowCurrencyDialogue" />
                <Profiles UserId="@userId" />
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar Responsive="false" Style="width: max-content;">
        <RadzenPanelMenu DisplayStyle="@(sidebarExpanded? MenuItemDisplayStyle.IconAndText: MenuItemDisplayStyle.Icon)">
            <RadzenPanelMenuItem Path="/" Text="សហគ្រាសបញ្ចាំទ្រព្យជុំ" Icon="dashboard" />
        </RadzenPanelMenu>
        <RadzenPanelMenu DisplayStyle="@(sidebarExpanded? MenuItemDisplayStyle.IconAndText: MenuItemDisplayStyle.Icon)"
                         ShowArrow="sidebarExpanded">
            <AuthorizeView>
                <Authorized>

                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.AdminOnly">
                <Authorized>
                    <RadzenPanelMenuItem Text="Departments" Icon="auto_awesome">
                        <RadzenPanelMenuItem Text="Departments List" Path="/App/Department" Icon="list" />
                    </RadzenPanelMenuItem>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.AccountOnly">
                <Authorized>
                    <RadzenPanelMenuItem Text="Bussiness Insight" Icon="dataset">
                        <RadzenPanelMenuItem Icon="lists" Path="#">
                            Bussiness Perf.
                        </RadzenPanelMenuItem>
                        <RadzenPanelMenuItem Icon="lists" Path="#">
                            Business Insight
                        </RadzenPanelMenuItem>
                    </RadzenPanelMenuItem>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.AdminOnly">
                <Authorized>
                    <RadzenPanelMenuItem Text="Branches" Icon="auto_awesome">
                        <RadzenPanelMenuItem Text="Branches List"
                                             Icon="color_lens"
                                             Visible="@bState.IsAdmin"
                                             Path="/App/Branches" />
                    </RadzenPanelMenuItem>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.AccountOnly">
                <Authorized>
                    <AccountsItems UserId="@userId" BranchId="@branchId" IsBranchOpen="@bState.State" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.AdminOnly">
                <Authorized>
                    <OperatedPerson BranchId="@branchId" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    @if (bState.IsAdmin)
                    {
                        <RadzenPanelMenuItem Text="Loan Management" Icon="dataset">
                            <RadzenPanelMenuItem Text="Credit Officer" Icon="switch_account"
                                                 Path="/App/Employees/Credit-Agent" />
                            <RadzenPanelMenuItem Text="Loan Product" Icon="inventory_2" Path="/App/Loans/Products" />
                            <RadzenPanelMenuItem Text="Loan Category" Icon="lists" Path="/App/Loans/Categories" />
                            <RadzenPanelMenuItem Text="Collaterals" Icon="invert_colors"
                                                 Path="/App/Customer/Collaterals" />
                            <RadzenPanelMenuItem Text="Holidays" Icon="calendar_add_on" Path="/App/Holidays" />
                            <RadzenPanelMenuItem Text="Change Credit Agent" Icon="@IconNames.SwitchAccount"
                                                 Path="@($"/App/Loans/Disbursments/Credit-Agent/{branchId}/Branches")" />
                        </RadzenPanelMenuItem>
                    }
                    @if (bState is { IsAccount: true, State: true })
                    {
                        <LoanManagementItems BranchId="@branchId"
                                             BranchState="@bState.State" />
                    }
                    @if (bState.IsCreditAgent)
                    {
                        <RadzenPanelMenuItem Text="Loan Management" Icon="dataset">
                            <RadzenPanelMenuItem Text="Customers" Icon="group"
                                                 Path="@($"/App/Customers/{branchId}/Branches")" />
                            <RadzenPanelMenuItem Text="Collaterals" Icon="invert_colors"
                                                 Path="/App/Customer/Collaterals" />
                            <RadzenPanelMenuItem Text="Loan Request" Icon="request_quote"
                                                 Path="@($"/App/Loans/Requests/{branchId}/Branches")" />
                            <RadzenPanelMenuItem Text="Loans Disbursement" Icon="@IconNames.MoneyBag"
                                                 Path="@($"/App/Loans/Disbursements/{branchId}/Branches")" />
                            <RadzenPanelMenuItem Text="Notifications"
                                                 Icon="notifications"
                                                 Path="/App/Notifications" />

                        </RadzenPanelMenuItem>
                    }
                    @if (bState.IsManager)
                    {
                        <RadzenPanelMenuItem Text="Loan Management" Icon="dataset">
                            <RadzenPanelMenuItem Text="Loan Request" Icon="request_quote"
                                                 Path="@($"/App/Loans/Requests/{branchId}/Branches")" />
                            <RadzenPanelMenuItem Text="Loans Disbursement" Icon="@IconNames.MoneyBag"
                                                 Path="@($"/App/Loans/Disbursements/{branchId}/Branches")" />
                            <RadzenPanelMenuItem Text="Notifications"
                                                 Icon="notifications"
                                                 Path="/App/Notifications" />
                        </RadzenPanelMenuItem>
                    }
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    @if (bState.IsAccount)
                    {
                        <ReportsItems IsBranchOpen="@bState.State" />
                    }
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.AccountOnly">
                <Authorized>
                    <CurrencyItems IsBranchOpen="@bState.State" BranchId="@branchId" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.AdminOnly">
                <Authorized>
                    <AdminstrationsItems />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.CEOOnly">
                <Authorized>
                    <RadzenPanelMenuItem Text="Audit Trail" Icon="@IconNames.DataProtection">
                        <RadzenPanelMenuItem Text="Audit" Icon="@IconNames.PolicyAlert" Path="/App/Audit" />
                    </RadzenPanelMenuItem>
                </Authorized>
            </AuthorizeView>
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        @Body
    </RadzenBody>
</RadzenLayout>

@code {

    private string? currentUrl;
    private bool isLoading;
    private bool ShowPanel;
    private Action<bool>? _loadingHandler;

    private void TogglePanel() => ShowPanel = !ShowPanel;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        NavigationManager.LocationChanged += OnLocationChanged;

        _loadingHandler = state =>
        {
            isLoading = state;
            InvokeAsync(StateHasChanged);
        };

        Tracker.OnLoadingChanged += _loadingHandler;

        bState.OnChange += StateHasChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);

        StateHasChanged();
    }

    async Task ShowCurrencyDialogue()
    {
        var param = new Dictionary<string, object?>
        {
            { "BranchId", branchId },
            { "UserId", userId }
        };

        var options = new SideDialogOptions
        {
        };

        await DialogService.OpenSideAsync<ExchangesSidebar>("Currency Exchange", param, options);
    }

}