@using Applications.ApplicationPolicies
@using Microsoft.AspNetCore.Components.Routing
@using TrapchumApp.Pages.Transactions.Exchanges
@using TrapchumApp.Services
@implements IDisposable
@inherits LayoutComponentBase
@attribute [StreamRendering(false)]
<RadzenComponents @rendermode="InteractiveServer" />
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Center" Gap="0">
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center">
                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center">
                <AuthorizeView>
                    <Authorized>
                        <TopMenus IsBranchOpen="@bState.State" ShowDialogue="ShowCurrencyDialogue" />
                    </Authorized>
                </AuthorizeView>
                <Profiles UserId="@userId" />
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar Responsive="false" Style="width: max-content;">
        <RadzenPanelMenu DisplayStyle="@(sidebarExpanded? MenuItemDisplayStyle.IconAndText: MenuItemDisplayStyle.Icon)">
            <RadzenPanelMenuItem Path="/" Text="សហគ្រាសបញ្ចាំទ្រព្យជុំ" Icon="dashboard" />
        </RadzenPanelMenu>
        <RadzenPanelMenu DisplayStyle="@(sidebarExpanded? MenuItemDisplayStyle.IconAndText: MenuItemDisplayStyle.Icon)"
                         ShowArrow="sidebarExpanded">
            <AuthorizeView>
                <Authorized>

                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@RolePolicies.AdminOnly">
                <Authorized>
                    <RadzenPanelMenuItem Text="Departments" Icon="auto_awesome">
                        <RadzenPanelMenuItem Text="Departments List" Path="/App/Department" Icon="list" />
                    </RadzenPanelMenuItem>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@RolePolicies.AccountOnly">
                <Authorized>
                    <RadzenPanelMenuItem Text="Bussiness Insight" Icon="dataset">
                        <RadzenPanelMenuItem Icon="lists" Path="#">
                            Bussiness Perf.
                        </RadzenPanelMenuItem>
                        <RadzenPanelMenuItem Icon="lists" Path="#">
                            Business Insight
                        </RadzenPanelMenuItem>
                    </RadzenPanelMenuItem>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@RolePolicies.AdminOnly">
                <Authorized>
                    <RadzenPanelMenuItem Text="Branches" Icon="auto_awesome">
                        <RadzenPanelMenuItem Text="Branches List"
                                             Icon="color_lens"
                                             Visible="IsAdminOnly"
                                             Path="/App/Branches" />
                    </RadzenPanelMenuItem>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@RolePolicies.AccountOnly">
                <Authorized>
                    <AccountsItems UserId="@userId" BranchId="@branchId" IsBranchOpen="@bState.State" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@RolePolicies.AdminOnly">
                <Authorized>
                    <OperatedPerson UserId="@userId" BranchId="@branchId" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    @if (bState.IsAdmin)
                    {
                        <RadzenPanelMenuItem Text="Loan Management" Icon="dataset">
                            <RadzenPanelMenuItem Text="Guarantor" Icon="how_to_reg" Path="/App/Customer/Guarantor" />
                            <RadzenPanelMenuItem Text="Credit Officer" Icon="switch_account" Path="/App/Employee/CreditAgent" />
                            <RadzenPanelMenuItem Text="Loan Product" Icon="inventory_2" Path="/App/Loan/LoanProduct" />
                            <RadzenPanelMenuItem Text="Loan Category" Icon="lists" Path="/App/Loan/Categories" />
                            <RadzenPanelMenuItem Text="Collaterals" Icon="invert_colors" Path="/App/Customer/Collateral" />
                            <RadzenPanelMenuItem Text="Holidays" Icon="calendar_add_on" Path="/App/Holiday" />
                        </RadzenPanelMenuItem>
                    }
                    @if (bState.IsAccount && bState.State)
                    {
                        <LoanManagementItems UserId="@userId"
                                             BranchId="@branchId"
                                             BranchState="@bState.State" />
                    }

                    @if (bState.IsCreditAgent)
                    {
                        <RadzenPanelMenuItem Text="Loan Management" Icon="dataset">
                            <RadzenPanelMenuItem Text="Customers" Icon="group" Path="@($"/App/Customer/{branchId}/Branches?UserId={userId}")" />
                            <RadzenPanelMenuItem Text="Collaterals" Icon="invert_colors" Path="/App/Customer/Collateral" />
                            <RadzenPanelMenuItem Text="Loan Request" Icon="request_quote" Path="@($"/App/Request/{branchId}/Branches/?UserId={userId}")" />
                        </RadzenPanelMenuItem>

                    }

                    @if (bState.IsManager)
                    {
                        <RadzenPanelMenuItem Text="Loan Management" Icon="dataset">
                            <RadzenPanelMenuItem Text="Loan Request" Icon="request_quote" Path="@($"/App/Request/{branchId}/Branches/?UserId={userId}")" />
                        </RadzenPanelMenuItem>

                    }

                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    @if (bState.IsAccount)
                    {
                        <ReportsItems IsBranchOpen="@bState.State" />
                    }
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@RolePolicies.AccountOnly">
                <Authorized>
                    <CurrencyItems IsBranchOpen="@bState.State" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@RolePolicies.AdminOnly">
                <Authorized>
                    <AdminstrationsItems />
                </Authorized>
            </AuthorizeView>
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody class="rz-background-color-base-200">
        @Body
    </RadzenBody>
</RadzenLayout>

@code {

    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    async Task ShowCurrencyDialogue()
    {
        var param = new Dictionary<string, object?> { { "BranchId", branchId }, { "UserId", userId }, { "ShowCloseButton", true } };

        var options = new DialogOptions
        {
            Draggable = true,
            Resizable = false,
            Width = "50rem"
        };

        await DialogService.OpenAsync<MoneyExchanges>("Currency Exchange", param, options);
    }

}