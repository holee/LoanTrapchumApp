@using Applications.ApplicationPolicies
@using TrapchumApp.Components.Pages.Transactions.Exchanges
@implements IDisposable
@inherits LayoutComponentBase
@attribute [StreamRendering(false)]
<RadzenComponents @rendermode="InteractiveServer"/>
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Center" Gap="0">
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center">
                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)"/>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center">
                <AuthorizeView>
                    <Authorized>
                        <TopMenus IsBranchOpen="@bState.State" ShowDialogue="ShowCurrencyDialogue"/>
                    </Authorized>
                </AuthorizeView>
                <Profiles UserId="@userId"/>
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar Responsive="false" Style="width: max-content;">
        <RadzenPanelMenu
            DisplayStyle="@(sidebarExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)">
            <RadzenPanelMenuItem Path="/" Text="សហគ្រាសបញ្ចាំទ្រព្យជុំ" Icon="dashboard"/>
        </RadzenPanelMenu>
        <RadzenPanelMenu
            DisplayStyle="@(sidebarExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)"
            ShowArrow="sidebarExpanded">
            <AuthorizeView>
                <Authorized>

                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@RolePolicies.AdminOnly">
                <Authorized>
                    <RadzenPanelMenuItem Text="Departments" Icon="auto_awesome">
                        <RadzenPanelMenuItem Text="Departments List" Path="/App/Department" Icon="list"/>
                    </RadzenPanelMenuItem>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <RadzenPanelMenuItem Text="Bussiness Insight" Icon="dataset">
                        <RadzenPanelMenuItem Icon="lists" Path="#">
                            Bussiness Perf.
                        </RadzenPanelMenuItem>
                        <RadzenPanelMenuItem Icon="lists" Path="#">
                            Business Insight
                        </RadzenPanelMenuItem>
                    </RadzenPanelMenuItem>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <BranchItems BranchId="@branchId"
                                 BranchState="@bState.State"
                                 UserId="@userId"/>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@RolePolicies.AccountOnly">
                <Authorized>
                    <AccountsItems BranchId="@branchId" IsBranchOpen="@bState.State"/>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <OperatedPerson Visible="@IsAdminOnly" UserId="@userId" BranchId="@branchId"/>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <LoanManagementItems UserId="@userId"
                                         BranchId="@branchId"
                                         BranchState="@bState.State"/>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <ReportsItems IsBranchOpen="@bState.State"/>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <CurrencyItems IsBranchOpen="@bState.State"/>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Policy="@RolePolicies.AdminOnly">
                <Authorized>
                    <AdminstrationsItems/>
                </Authorized>
            </AuthorizeView>
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody class="rz-background-color-base-200">
        @Body
    </RadzenBody>
</RadzenLayout>

@code {

    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    async Task ShowCurrencyDialogue()
    {
        var param = new Dictionary<string, object?> { { "BranchId", branchId }, { "UserId", userId }, { "ShowCloseButton", true } };

        var options = new DialogOptions
        {
            Draggable = true,
            Resizable = false,
            Width = "50rem"
        };

        await DialogService.OpenAsync<MoneyExchanges>("Currency Exchange", param, options);
    }

}