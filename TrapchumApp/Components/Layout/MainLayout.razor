@using Applications.Interfaces.Branches
@using System.Security.Claims
@implements IDisposable
@inherits LayoutComponentBase
<RadzenComponents @rendermode="InteractiveServer" />
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Center" Gap="0">
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center">
                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.SpaceBetween"
                         AlignItems="AlignItems.Center">
                <AuthorizeView>
                    <Authorized>

                    </Authorized>
                </AuthorizeView>
                <Profiles UserId="@userId" />
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar Responsive="false" Style="width: max-content;">
        <RadzenPanelMenu DisplayStyle="@(sidebarExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)">
            <RadzenPanelMenuItem Path="/" Text="សហគ្រាសបញ្ចាំទ្រព្យជុំ" Icon="dashboard" />
        </RadzenPanelMenu>
        <RadzenPanelMenu DisplayStyle="@(sidebarExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)" ShowArrow="sidebarExpanded">
            <AuthorizeView>
                <Authorized>

                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <RadzenPanelMenuItem Text="Departments" Icon="auto_awesome">
                        <RadzenPanelMenuItem Text="Departments List" Path="/App/Departments" Icon="list" />
                    </RadzenPanelMenuItem>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <RadzenPanelMenuItem Text="Bussiness Insight" Icon="dataset">
                        <RadzenPanelMenuItem Icon="lists" Path="#">
                            Bussiness Perf.
                        </RadzenPanelMenuItem>
                        <RadzenPanelMenuItem Icon="lists" Path="#">
                            Business Insight
                        </RadzenPanelMenuItem>
                    </RadzenPanelMenuItem>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <BranchItems BranchId="@brandId"
                                 BranchState="true"
                                 UserId="@userId" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <AccountsItems IsBranchOpen="true" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <OperatedPerson Visible="true" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <LoanManagementItems UserId="@userId"
                                         BranchId="1" BranchState="true" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <ReportsItems IsBranchOpen="true" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <CurrencyItems IsBranchOpen="true" />
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <Authorized>
                    <AdminstrationsItems />
                </Authorized>
            </AuthorizeView>
            <NavMenu />
        </RadzenPanelMenu>
    </RadzenSidebar>
    <RadzenBody>
        <div class="container-fluid">
            @Body
        </div>
        <div id="blazor-error-ui" data-nosnippet>
            An unhandled error has occurred.
            <a href="." class="reload">Reload</a>
            <span class="dismiss">🗙</span>
        </div>
    </RadzenBody>
</RadzenLayout>
@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}