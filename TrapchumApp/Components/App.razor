<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Khmer:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["TrapchumApp.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="/assets/logo/tch_Logo.ico" />
    <HeadOutlet @rendermode="@PageRenderMode" />
    <RadzenTheme Theme="material" @rendermode="@PageRenderMode" />
    <script src="@Assets["assets/js/chart.umd.min.js"]"></script>
    <script src="@Assets["assets/js/chartjs-interop.js"]"></script>
</head>

<body style="font-family: kh_siemreap, 'Noto Sans Khmer', 'Khmer OS Siemreap', Arial, sans-serif;">
    <div id="app-loading" style="display:none">
        <div class="app-loading-bubbles">
            <div class="app-loading-bubble"></div>
            <div class="app-loading-bubble"></div>
            <div class="app-loading-bubble"></div>
            <div class="app-loading-bubble"></div>
            <div class="app-loading-bubble"></div>
            <div class="app-loading-bubble"></div>
            <div class="app-loading-bubble"></div>
            <div class="app-loading-bubble"></div>
            <div class="app-loading-bubble"></div>
            <div class="app-loading-bubble"></div>
            <div class="app-loading-bubble"></div>
            <div class="app-loading-bubble"></div>
        </div>
        <div class="app-loading-card">
            <div class="app-loading-logo">
                <img src="/assets/logo/tch_Logo.ico" alt="Logo" />
            </div>
            <div class="app-loading-dots">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <p class="app-loading-text">កំពុងផ្ទុក, សូមរងចាំ…………</p>
        </div>
    </div>
    <Routes @rendermode="@PageRenderMode" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"]"></script>
    <script src="@Assets["assets/js/printer.js"]"></script>
    <script src="@Assets["assets/js/toggle.js"]"></script>
    <script src="@Assets["assets/js/dropdownoutsideclick.js"]"></script>
    <!-- Add a reference to Chart.js. -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js" integrity="sha512-ZwR1/gSZM3ai6vCdI+LVF1zSq/5HznD3ZSTk7kajkaj4D292NLuduDCO1c/NT8Id+jE58KYLKT7hXnbtryGmMg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <!-- Add a reference to chartjs-plugin-datalabels.min.js if your application uses chart components with the data labels feature. -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js" integrity="sha512-JPcRR8yFa8mmCsfrw4TNte1ZvF1e3+1SdGMslZvmrzDYxS69J7J49vkFL8u6u8PlPJK+H3voElBtUCzaXj+6ig==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <!-- Add a reference to blazorexpress.chartjs.js. -->
    <script src="@Assets["_content/BlazorExpress.ChartJS/blazorexpress.chartjs.js"]"></script>
    <script>
        window.addEventListener("DOMContentLoaded", () => {
           
            const loading = document.getElementById("app-loading");

            // Only show overlay after a successful login (flag set via cookie by server)
            const hasCookie = document.cookie.split(';').some(c => c.trim() === 'showAppLoading=1');
            if (!hasCookie) {
                loading?.remove();
                return;
            }

            // Consume the cookie immediately so it only fires once
            document.cookie = 'showAppLoading=; Max-Age=0; path=/';
            loading.style.display = "";

            const removeLoading = () => {
                if (loading) {
                    loading.classList.add("app-loading-fade-out");
                    setTimeout(() => loading.remove(), 1000);
                }
            };

            if (document.querySelector("main")) {
                removeLoading();
                return;
            }

            const observer = new MutationObserver(() => {
                if (document.querySelector("main")) {
                    removeLoading();
                    observer.disconnect();
                }
            });

            observer.observe(document.body, {
                childList: true,
                subtree: true
            });

            // Fallback: remove loading after 5 seconds regardless
            setTimeout(removeLoading, 5000);
        });
    </script>
    <script>
        window.setCaretToStart = () => {
            setTimeout(() => {
            const input = document.querySelector('.rz-numeric-input input');
                if (input) {
                    input.focus();
                    input.setSelectionRange(0, 0);
                }
            }, 0.50);
        };
    </script>


</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? RenderModeForPage => HttpContext.Request.Path.StartsWithSegments("/Account")
       ? null
       : new InteractiveServerRenderMode(false);

    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? new InteractiveServerRenderMode(prerender: false) : null;
}
