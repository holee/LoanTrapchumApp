@using Applications.Features.Documents.Dto
@using System.Text.Json

<div class="blab-dropzone-wrapper">
    @if (_showProgress)
    {
        <div class="blab-upload-overlay">
            <div class="blab-upload-overlay-content">
                <RadzenProgressBar Mode="ProgressBarMode.Determinate"
                                   Value="@_progressValue"
                                   ShowValue="true"
                                   ProgressBarStyle="ProgressBarStyle.Info"
                                   Style="width:100%;height:0.5rem;" />
                <div style="margin-top:10px;">Uploading files, please wait... @_progressValue%</div>
            </div>
        </div>
    }

    <div class="blab-dropzone @(_isDragOver ? "blab-dropzone-active" : "")"
         @ondragenter="OnDragEnter"
         @ondragover:preventDefault="true"
         @ondragover="OnDragOver"
         @ondragleave="OnDragLeave"
         @ondrop:preventDefault="true"
         @ondrop="OnDrop">
        <div class="blab-dropzone-content">
            <RadzenIcon Icon="cloud_upload" Style="font-size:48px; color:#1976d2;" />
            <div class="blab-dropzone-text">
                <h3>@Title</h3>
                <p class="muted">@HintText</p>
            </div>
            <RadzenUpload @ref="_radzenUpload"
                          ChooseText="@ChooseText"
                          Multiple="@Multiple"
                          Auto="true"
                          Url="@Url"
                          Accept="@Accept"
                          Complete="@OnUploadComplete"
                          Error="@OnUploadError"
                          Progress="@OnUploadProgress"
                          InputAttributes="@(new Dictionary<string, object> { { "aria-label", "select file" } })"
                          Style="position:absolute; inset:0; opacity:0; cursor:pointer;" />
        </div>
    </div>

    @if (!_showProgress && !_isError && _uploadedFiles.Count > 0)
    {
        <div class="blab-upload-indicator blab-upload-complete">
            <RadzenIcon Icon="check_circle" Style="color:green;vertical-align:middle;" />
            <span style="color:green;">Upload complete</span>
        </div>
    }

    @if (_isError)
    {
        <div class="blab-upload-indicator blab-upload-error">
            <RadzenIcon Icon="error" Style="color:red;vertical-align:middle;" />
            <span style="color:red;">Upload failed: @_errorMessage</span>
        </div>
    }

    @if (ShowFileList && _uploadedFiles.Count > 0)
    {
        <div class="blab-files-preview">
            @foreach (var file in _uploadedFiles)
            {
                <div class="blab-file-item">
                    <RadzenIcon Icon="insert_drive_file" Style="color:#1976d2;" />
                    <div class="blab-file-meta">
                        <div class="blab-file-name">@file.OriginalName</div>
                        <div class="blab-file-size">@FormatSize(file.FileSize)</div>
                    </div>
                    <RadzenButton Icon="close"
                                  Size="ButtonSize.Small"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Click="@(() => RemoveFile(file))" />
                </div>
            }
        </div>
    }
</div>

<style>
    .blab-dropzone-wrapper { padding: 1rem; position: relative; }
    .blab-dropzone { position: relative; border: 2px dashed #cfcfcf; border-radius: 8px; background: #fff; padding: 2.5rem; text-align: center; transition: border-color .15s, background .15s, box-shadow .15s; }
    .blab-dropzone-active { border-color: #1976d2; background: #f4f8ff; box-shadow: 0 4px 12px rgba(25,118,210,0.08); }
    .blab-dropzone-content { display: flex; flex-direction: column; align-items: center; gap: 8px; position: relative; }
    .blab-dropzone-text h3 { margin: 0; font-size: 1.1rem; }
    .blab-dropzone-text .muted { margin: 0; color: #666; font-size: 0.9rem; }
    .blab-files-preview { margin-top: 1rem; max-height: 220px; overflow: auto; display: flex; flex-direction: column; gap: 8px; }
    .blab-file-item { display: flex; align-items: center; gap: 12px; padding: 8px; border: 1px solid #eee; border-radius: 6px; }
    .blab-file-meta { flex: 1; display: flex; flex-direction: column; }
    .blab-file-name { font-weight: 500; }
    .blab-file-size { color: #666; font-size: 0.85rem; }
    .blab-upload-indicator { display: flex; align-items: center; gap: 8px; margin: 10px 0; justify-content: center; }
    .blab-upload-complete { color: green; }
    .blab-upload-error { color: red; }
    .blab-upload-overlay { position: absolute; inset: 0; background: rgba(255,255,255,0.75); display: flex; align-items: center; justify-content: center; z-index: 10; border-radius: 8px; }
    .blab-upload-overlay-content { text-align: center; min-width: 220px; }
</style>

@code {
    [Parameter] public string Url { get; set; } = "Upload/Files";
    [Parameter] public string Accept { get; set; } = ".pdf";
    [Parameter] public bool Multiple { get; set; } = true;
    [Parameter] public string Title { get; set; } = "Drop files here or click to browse";
    [Parameter] public string HintText { get; set; } = "Supported: pdf only";
    [Parameter] public string ChooseText { get; set; } = "Browse files";
    [Parameter] public bool ShowFileList { get; set; } = true;
    [Parameter] public int MaxFileSize { get; set; } = 10 * 1024 * 1024; // 10 MB

    [Parameter] public EventCallback<List<DocumentDto>> OnFilesUploaded { get; set; }
    [Parameter] public EventCallback<DocumentDto> OnFileRemoved { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    private RadzenUpload _radzenUpload = default!;
    private List<DocumentDto> _uploadedFiles = new();
    private bool _isDragOver;
    private bool _showProgress;
    private bool _isError;
    private string? _errorMessage;
    private int _progressValue;

    public IReadOnlyList<DocumentDto> UploadedFiles => _uploadedFiles;

    public void Clear()
    {
        _uploadedFiles.Clear();
        _isError = false;
        _errorMessage = null;
        _progressValue = 0;
        StateHasChanged();
    }

    private async Task OnUploadComplete(UploadCompleteEventArgs args)
    {
        _showProgress = false;
        _isError = false;

        if (string.IsNullOrWhiteSpace(args.RawResponse))
            return;

        try
        {
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var files = JsonSerializer.Deserialize<List<DocumentDto>>(args.RawResponse!, options);

            if (files is not null && files.Count > 0)
            {
                _uploadedFiles.AddRange(files);

                if (OnFilesUploaded.HasDelegate)
                    await OnFilesUploaded.InvokeAsync(_uploadedFiles);
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _errorMessage = $"Error parsing response: {ex.Message}";

            if (OnError.HasDelegate)
                await OnError.InvokeAsync(_errorMessage);
        }
    }

    private void OnUploadProgress(UploadProgressArgs args)
    {
        _showProgress = args.Progress < 100;
        _progressValue = args.Progress;
        StateHasChanged();
    }

    private async Task OnUploadError(UploadErrorEventArgs args)
    {
        _isError = true;
        _showProgress = false;
        _errorMessage = args.Message;

        if (OnError.HasDelegate)
            await OnError.InvokeAsync(args.Message);
    }

    private async Task RemoveFile(DocumentDto file)
    {
        if (!_uploadedFiles.Contains(file)) return;

        _uploadedFiles.Remove(file);

        if (OnFileRemoved.HasDelegate)
            await OnFileRemoved.InvokeAsync(file);

        StateHasChanged();
    }

    private void OnDragEnter(DragEventArgs e) => _isDragOver = true;
    private void OnDragOver(DragEventArgs e) => _isDragOver = true;
    private void OnDragLeave(DragEventArgs e) => _isDragOver = false;
    private void OnDrop(DragEventArgs e) => _isDragOver = false;

    private static string FormatSize(long? size)
    {
        if (size is null or 0) return "0 B";
        if (size < 1024) return $"{size} B";
        if (size < 1024 * 1024) return $"{size / 1024} KB";
        return $"{size / (1024.0 * 1024.0):F2} MB";
    }
}
