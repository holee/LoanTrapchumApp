<div class="msgbox">
    @* ─── Title bar (drag handle) ─── *@
    <div class="msgbox-titlebar">
        <span class="msgbox-titlebar-text">@Title</span>
        <button class="msgbox-close-btn" @onclick="() => Close(DefaultCloseResult)">✕</button>
    </div>

    @* ─── Body ─── *@
    <div class="msgbox-body">
        @if (Icon != MessageBoxIcon.None)
        {
            <RadzenIcon Icon="@IconName" Style="@IconStyle" />
        }
        <span class="msgbox-text">@Message</span>
    </div>

    @* ─── Button bar ─── *@
    <div class="msgbox-btnbar">
        @foreach (var btn in GetButtons())
        {
            <button class="msgbox-btn" style="@GetButtonStyle(btn.Result)" @onclick="() => Close(btn.Result)">@btn.Label</button>
        }
    </div>
</div>

@code {
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = "Message";
    [Parameter] public MsgBoxButtons Buttons { get; set; } = MsgBoxButtons.OK;
    [Parameter] public MessageBoxIcon Icon { get; set; } = MessageBoxIcon.None;
    [Parameter] public Dictionary<MsgBoxResult, MessageBoxButtonColor> ButtonColors { get; set; } = [];

    void Close(MsgBoxResult result) => DialogService.Close(result);

    string GetButtonStyle(MsgBoxResult result)
    {
        if (ButtonColors.TryGetValue(result, out var color))
            return color.ToCss();
        return DefaultButtonColor(result).ToCss();
    }

    static MessageBoxButtonColor DefaultButtonColor(MsgBoxResult result) => result switch
    {
        MsgBoxResult.OK     => MessageBoxButtonColor.Primary,
        MsgBoxResult.Yes    => MessageBoxButtonColor.Success,
        MsgBoxResult.No     => MessageBoxButtonColor.Danger,
        MsgBoxResult.Cancel => MessageBoxButtonColor.Default,
        MsgBoxResult.Retry  => MessageBoxButtonColor.Warning,
        MsgBoxResult.Abort  => MessageBoxButtonColor.Danger,
        MsgBoxResult.Ignore => MessageBoxButtonColor.Dark,
        _                       => MessageBoxButtonColor.Default
    };

    MsgBoxResult DefaultCloseResult => Buttons switch
    {
        MsgBoxButtons.YesNo => MsgBoxResult.No,
        MsgBoxButtons.YesNoCancel => MsgBoxResult.Cancel,
        MsgBoxButtons.OKCancel => MsgBoxResult.Cancel,
        MsgBoxButtons.RetryCancel => MsgBoxResult.Cancel,
        MsgBoxButtons.AbortRetryIgnore => MsgBoxResult.Ignore,
        _ => MsgBoxResult.OK
    };

    string IconName => Icon switch
    {
        MessageBoxIcon.Error       => "error",
        MessageBoxIcon.Warning     => "warning",
        MessageBoxIcon.Question    => "help",
        MessageBoxIcon.Success     => "check_circle",
        MessageBoxIcon.Information => "info",
        _                          => "info"
    };

    string IconStyle => Icon switch
    {
        MessageBoxIcon.Error       => "font-size:2rem;color:#d32f2f;flex-shrink:0;",
        MessageBoxIcon.Warning     => "font-size:2rem;color:#ed6c02;flex-shrink:0;",
        MessageBoxIcon.Question    => "font-size:2rem;color:#0288d1;flex-shrink:0;",
        MessageBoxIcon.Success     => "font-size:2rem;color:#2e7d32;flex-shrink:0;",
        MessageBoxIcon.Information => "font-size:2rem;color:#0288d1;flex-shrink:0;",
        _                          => "font-size:2rem;color:#757575;flex-shrink:0;"
    };

    record ButtonDef(string Label, MsgBoxResult Result);

    List<ButtonDef> GetButtons() => Buttons switch
    {
        MsgBoxButtons.OK              => [new("OK", MsgBoxResult.OK)],
        MsgBoxButtons.OKCancel        => [new("OK", MsgBoxResult.OK), new("Cancel", MsgBoxResult.Cancel)],
        MsgBoxButtons.YesNo           => [new("Yes", MsgBoxResult.Yes), new("No", MsgBoxResult.No)],
        MsgBoxButtons.YesNoCancel     => [new("Yes", MsgBoxResult.Yes), new("No", MsgBoxResult.No), new("Cancel", MsgBoxResult.Cancel)],
        MsgBoxButtons.RetryCancel     => [new("Retry", MsgBoxResult.Retry), new("Cancel", MsgBoxResult.Cancel)],
        MsgBoxButtons.AbortRetryIgnore=> [new("Abort", MsgBoxResult.Abort), new("Retry", MsgBoxResult.Retry), new("Ignore", MsgBoxResult.Ignore)],
        _                                 => [new("OK", MsgBoxResult.OK)]
    };
}
