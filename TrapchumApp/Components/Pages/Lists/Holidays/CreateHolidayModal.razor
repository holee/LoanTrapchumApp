@using Applications.Requests.Lists.Holidays
@using Applications.Responses.Lists.Holidays
<div>
    <RadzenProgressBar ProgressBarStyle="ProgressBarStyle.Primary" Visible="@visibled" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    <Card>
        <CardHeader>
            <div class="d-flex justify-content-between">
                <span>New Holiday</span>
                <strong @onclick="CloseTab" class="text-danger" style="cursor:pointer">X</strong>
            </div>
        </CardHeader>
        <CardBody>
            <div class="row">
                <div class="col-md-6">
                    <RadzenStack Orientation="Orientation.Horizontal" class="w-100">
                        <RadzenDatePicker Inline
                                          CurrentDateChanged="e=>ChangedDate(e)"
                                          DateFormat="dd/MM/yyyy"
                                          Placeholder="select holiday date"
                                          @bind-Value="SelectedDate"
                                          
                                          @bind-Value:format="yyyy/MM/dd"
                                          @bind-Value:after="SelectedDateChanged">
                        </RadzenDatePicker>
                    </RadzenStack>
                </div>
                <div class=" col-md-6">
                    <RadzenText >Description</RadzenText>
                    <RadzenTextArea Placeholder="Enter here..." @bind-Value="modelDTO.Description" Style="width: 100%;height:150px" aria-label="TextArea with placeholder" />
                    <div class="mt-2">
                        <div class="input-group mb-3">
                            <span class="input-group-text" id="basic-addon1">CreateNewUser Multi-Year <RadzenCheckBox class="ml-3" @bind-Value="IsMultiYear" @bind-Value:after="MultiYear" Name="IsActive" /></span>
                            <RadzenNumeric @bind-Value="endYear" Disabled="IsDisible" class="form-control" Placeholder="Ex: 5 or 10 or 15 or 20" aria-label="Username" aria-describedby="basic-addon1" />
                            <span class="text-muted">Ex: 5 or 10 or 15 or 20</span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <RadzenLabel Text="Is Active" Component="IsActive" Style="margin-right: 12px; vertical-align: middle;" />
                        <RadzenCheckBox @bind-Value="modelDTO.Status" Name="IsActive" />
                    </div>
                </div>
            </div>
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center">
                <table class="mt-2 table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Date</th>
                            <th>Descriptions</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in listvm.OrderBy(e => e.HolidayName) ?? Enumerable.Empty<HolidayDto>())
                        {
                            var index = listvm.OrderBy(e => e.HolidayName).ToList().IndexOf(item) + 1;
                            <tr @onclick="@(()=>OnSelectRow(item))" style="cursor:pointer">
                                <td>@index</td>
                                <td>@item.HolidayName!.Value.ToString("dd/MM/yyyy")</td>
                                <td>@item.Description</td>
                                <td>
                                    <RadzenCheckBox TValue="bool?"
                                                    @bind-Value="item.Status" Disabled>
                                    </RadzenCheckBox>
                                </td>
                                <td class="">
                                    <RadzenButton Icon="delete" 
                                        Click="@(()=>DeleteHoliday(item.Id))" 
                                        ButtonStyle="ButtonStyle.Danger" 
                                        Size="ButtonSize.ExtraSmall"/>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </RadzenStack>
        </CardBody>
        <div class="card-footer">
            <div class="d-flex justify-content-end gap-2">

                    <RadzenButton Text="Set"
                                  Icon="add" 
                                  
                                  ButtonStyle="ButtonStyle.Success"
                                  Click="FormValidSubmit"
                                  Size="ButtonSize.Small" />
                    <RadzenButton Text="Close"
                                  Icon="close"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Click="CloseTab"
                                  Size="ButtonSize.Small" />
            </div>
        </div>
        @*  </RadzenTemplateForm> *@
    </Card>
</div>

