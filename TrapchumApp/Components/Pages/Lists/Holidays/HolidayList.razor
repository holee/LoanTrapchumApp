@page "/App/Holiday"
<PageTitle>Holiday</PageTitle>
<RadzenTabs @bind-SelectedIndex="SelectedIndex" RenderMode="TabRenderMode.Client">
    <Tabs>
        <RadzenTabsItem Text="Holiday List">
            <RadzenCard>
                <RadzenStack AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Orientation="Orientation.Horizontal">
                    <RadzenButton Text="Add Holiday"
                                  Click="DisplayModal"
                                  Icon="add"
                                  ButtonStyle="ButtonStyle.Success"
                                  Size="ButtonSize.Small" />
                    <div class="rz-text-center">
                        <RadzenCheckBox @bind-Value=@IsPreviousSelected
                                        @bind-Value:after="PreviousSelectedChanged"
                                        Name="CheckBox1" />
                        <RadzenLabel Text="Previous Date" Component="CheckBox1" class="rz-ms-2" />
                    </div>
                </RadzenStack>
                <RadzenStack Style="margin-bottom:7px"
                             JustifyContent="JustifyContent.SpaceBetween"
                             Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Wrap="FlexWrap.Wrap">
                    <RadzenStack JustifyContent="JustifyContent.Start"
                                 class="w-25"
                                 AlignItems="AlignItems.Center"
                                 Orientation="Orientation.Horizontal">
                        <div class="dropdown-center">
                            <RadzenButton class="rz-background-color-base-100"
                                          ButtonType="ButtonType.Button"
                                          Size="ButtonSize.Small"
                                          ButtonStyle="ButtonStyle.Light"
                                          data-bs-toggle="dropdown"
                                          Shade="Shade.Darker"
                                          aria-expanded="false">
                                Show @(pageSize) rows
                            </RadzenButton>
                            <ul class="dropdown-menu">
                                <li><button onclick="@(()=>ChangedPageSize(10))" class="btn-sm dropdown-item" type="button">10 Rows</button></li>
                                <li><button onclick="@(()=>ChangedPageSize(25))" class="btn-sm dropdown-item" type="button">25 Rows</button></li>
                                <li><button onclick="@(()=>ChangedPageSize(50))" class="btn-sm dropdown-item" type="button">50 Rows</button></li>
                                <li><button onclick="@(()=>ChangedPageSize(100))" class="btn-sm dropdown-item" type="button">100 Rows</button></li>
                            </ul>
                        </div>
                        <div>
                            <RadzenButton Size="ButtonSize.Small"
                                          Icon="refresh"
                                          Click="Reload"
                                          ButtonStyle="ButtonStyle.Primary" />
                        </div>
                    </RadzenStack>
                    <RadzenStack Style="width:30%" JustifyContent="JustifyContent.End">
                        <RadzenFormField AllowFloatingLabel="false"
                                         Variant="Variant.Outlined"
                                         class="mb-2 w-100">
                            <Start>
                                <RadzenIcon Icon="search" />
                            </Start>
                            <ChildContent>
                                <RadzenTextBox Placeholder="Type here to search employee...."
                                               Style="width:100%;height:34px;font-size:13px"
                                               class="form-control-sm"
                                               @oninput="e=>SearchEvent(e)"
                                               @bind-Value="searchField">
                                </RadzenTextBox>
                            </ChildContent>
                        </RadzenFormField>

                    </RadzenStack>
                </RadzenStack>
                <RadzenDataGrid GridLines="DataGridGridLines.Horizontal"
                                Count="@counts"
                                PageSize="@pageSize"
                                AllowPaging="true"
                                ShowPagingSummary="true"
                                Density="Density.Compact"
                                PagerHorizontalAlign="HorizontalAlign.Right"
                                AllowSorting="true"
                                LoadData="LoadData"
                                IsLoading="isLoading"
                                Data="HolidaysList">
                    <Columns>
                        <RadzenDataGridColumn Title="#" Context="h">
                            <Template>
                                @(HolidaysList!.IndexOf(h) + 1)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Holiday Date" Sortable="true"
                                              Context="h">
                            <Template>
                                @(h?.HolidayName.ToShortDateString())-<small>@(h?.HolidayName.DayOfWeek)</small>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Description" Property="p=>p.Description" />
                        <RadzenDataGridColumn Title="Status" Sortable="false" Context="h">
                            <Template>
                                <RadzenCheckBox TValue="bool?" Disabled @bind-Value="h.Status" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Actions" Sortable="false" Context="h">
                            <Template>
                                <RadzenButton Size="ButtonSize.ExtraSmall"
                                              Icon="more_vert"
                                              Variant="Variant.Text"
                                              Click="@((args)=>ShowContextMenuWithContent(args,h.Id))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenCard>
        </RadzenTabsItem>
        <RadzenTabsItem Text="Add Holiday" Visible="visibleAdd">
            <CreateHolidayModal Closed="CloseTab" />
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
@code {
    bool visibleAdd = false;
    bool isLoading = false;
    [Parameter] public int SelectedIndex { get; set; } = 0;
    void ShowContextMenuWithContent(MouseEventArgs args, long id)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">


        <RadzenMenuItem Click="@(()=>Delete(id))" Icon="delete" Text="Delete" Value="@id"></RadzenMenuItem>
    </RadzenMenu>
    );
    }
    void CloseTab()
    {
        if (SelectedIndex == 1)
        {
            SelectedIndex = 0;
            visibleAdd = false;
            StateHasChanged();
        }
    }
    async void Reload()
    {
        await OnInitializedAsync();
        StateHasChanged();
    }

    async void LoadData(LoadDataArgs e)
    {
        pageIndex = e.Skip!.Value;
        if (!string.IsNullOrEmpty(e.OrderBy))
        {
            sortColumn = e.OrderBy.Split(" ")[0];
            string dir = e.OrderBy.Split(" ")[1];
            sortDescending = dir.Contains("asc") ? false : true;
        }
        searchField = e.Filter ?? string.Empty;
        await GetsHolidays(searchField);
    }

    void ChangedPageSize(int page)
    {
        pageSize = page;
    }

}
