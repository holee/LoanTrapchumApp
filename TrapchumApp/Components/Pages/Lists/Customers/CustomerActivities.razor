@using Applications.Responses.ViewModels.Customers
<RadzenDataGrid Data="Items"
GridLines="DataGridGridLines.Both"
Responsive
IsLoading="isLoading"
ColumnWidth="10rem"
Style="height:20rem;max-height:30rem;"
TItem="VCustomerActivities"
Density="Density.Compact">

    <HeaderTemplate>
        @if (ShowAdd)
        {
            <RadzenButton Text="Expense"
            Click="AddNewActivity"
            Icon="add"
            ButtonStyle="ButtonStyle.Primary"
            Size="Radzen.ButtonSize.Small" />
        }
        @if (ShowReload)
        {
            <RadzenButton Click="RefreshActivity"
            Icon="refresh"
            ButtonStyle="ButtonStyle.Secondary"
            class="ml-2"
            Size="Radzen.ButtonSize.Small" />
        }
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="ActivityId" Context="c" Title="#" Width="3rem">
            <Template>
                @c.ActivityId
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
        Width="10rem"
        Property="@nameof(VCustomerActivities.Description)" Title="Expense">
            <Template>
                @c.Description
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
        Width="5rem"
        TextAlign="TextAlign.Center"
                              Property="@nameof(VCustomerActivities.Status)" Title="Status">
            <Template>
                <RadzenSwitch Value="@c.Status" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c" Width="5rem"
        Property="@nameof(VCustomerActivities.CreatedDT)" Title="Created">
            <Template>
                @c.CreatedDT.DayFirst()
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>



@code {
    [Parameter] public Guid? CustomerId { get; set; } = Guid.Empty;
    [Parameter] public bool ShowAdd { get; set; } = false;
    [Parameter] public bool ShowReload { get; set; } = false;
    [Parameter] public IEnumerable<VCustomerActivities> Items { get; set; } = [];

    bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {

        if (!Items.Any())
        {
            await RefreshActivity();
        }

        await base.OnInitializedAsync();
    }

    async Task AddNewActivity()
    {

        var param = new Dictionary<string, object?>
        {
            {"CustomerId",CustomerId}
        };


        bool? addActivitieDialogue = await DialogService.OpenAsync<CustomerActivitiesAdd>("Activity",param);

        if (addActivitieDialogue is not null && addActivitieDialogue == true)
        {
          await  RefreshActivity();
        }
    }
    async Task RefreshActivity()
    {
        isLoading = true;

        var rsp = await _customerService.GetCusomerActivies<VCustomerActivities>(CustomerId);

        if (rsp.IsSuccess)
        {
            Items = rsp.Data ?? [];
        }

        isLoading = false;
    }
}
