<RadzenDataGrid Data="Items"
                GridLines="DataGridGridLines.Both"
                Responsive
                IsLoading="isLoading"
                Style="--rz-grid-header-background-color:var(--rz-base-200);min-height:20rem;height:20rem;max-height:30rem;"
                Density="Density.Compact">
    <HeaderTemplate>
        @if (ShowAdd)
        {
            <RadzenButton Text="Income"
                          Click="AddInComeModal"
                          Icon="add"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="Radzen.ButtonSize.Small" />
        }
        @if (ShowReload)
        {
            <RadzenButton Click="RefreshIncome"
                          Icon="refresh"
                          class="ml-2"
                          ButtonStyle="ButtonStyle.Secondary"
                          Size="Radzen.ButtonSize.Small" />
        }

    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="IncomeId" Context="c" Title="#" Width="3rem">
            <Template>
                @c.IncomeId
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Property="IncomeSource"
                              Width="20rem"
                              Title="Income Source">
            <Template>
                @c.IncomeSource
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Width="10rem"
                              Property="IncomeAmount"
                              TextAlign="TextAlign.Right"
                              Title="Amount">
            <Template>
                @c?.IncomeAmount
            </Template>
            <FooterTemplate>
                <strong>
                    @Items.Sum(x => x.IncomeAmount)
                </strong>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Property="InDescription"
                              Title="Description">
            <Template>
                @c.InDescription
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>
@code {

    [Parameter] public long? CustomerId { get; set; } = 0;
    [Parameter] public bool ShowAdd { get; set; } = true;
    [Parameter] public bool ShowReload { get; set; } = false;
    [Parameter] public IEnumerable<VCustomerIncomes> Items { get; set; } = [];
    bool isLoading = false;
    protected override async Task OnInitializedAsync()
    {
        await GetCustomerIncomes(CustomerId);

        await base.OnInitializedAsync();
    }

    async Task GetCustomerIncomes(long? customerId)
    {

        isLoading = true;

        if (customerId > 0)
        {
            var resp = await _customerService.GetCustomerIncomesAsync(customerId);

            if (resp.IsSuccess)
            {
                Items = resp.Data!;
                isLoading = false;
            };
        }

        isLoading = false;

        StateHasChanged();
    }

    async void RefreshIncome()
    {
        await GetCustomerIncomes(CustomerId);

    }

    protected async void AddInComeModal()
    {

        if (CustomerId <= 0)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Please select cusotmer..");
            return;
        }

        var options = new Radzen.DialogOptions
            {
                Width = "50vw",
                Resizable = false,
                Draggable = true,
            };

        var param = new Dictionary<string, object?>
            {
                { "CustomerId",CustomerId }
            };

        bool result = await DialogService.OpenAsync<CustomerModalIncome>("Add Income", param, options);

        if (bool.TryParse(result.ToString(), out bool success) && success)
        {
            await GetCustomerIncomes(CustomerId);
        }

    }


}
