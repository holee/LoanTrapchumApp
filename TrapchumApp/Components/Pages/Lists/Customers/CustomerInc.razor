@using Applications.Responses.ViewModels.Customers
<RadzenDataGrid Data="Items"
                GridLines="DataGridGridLines.Both"
                Responsive
                IsLoading="isLoading"
                Style="min-height:20rem;height:20rem;max-height:30rem;"
                Density="Density.Compact">
    <HeaderTemplate>
        @if (ShowAdd)
        {
            <RadzenButton Text="Income"
                          Click="AddInComeModal"
                          Icon="add"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="Radzen.ButtonSize.Small" />
        }
        @if (ShowReload)
        {
            <RadzenButton Click="RefreshIncome"
                          Icon="refresh"
                          class="ml-2"
                          ButtonStyle="ButtonStyle.Secondary"
                          Size="Radzen.ButtonSize.Small" />
        }

    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="IncomeId" Context="c" Title="#" Width="3rem">
            <Template>
                @c.IncomeId
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Property="IncomeSource"
                              Width="20rem"
                              Title="Income Source">
            <Template>
                @c.IncomeSource
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Width="10rem"
                              Property="IncomeAmount"
                              TextAlign="TextAlign.Right"
                              Title="Amount">
            <Template>
                @c?.IncomeAmount
            </Template>
            <FooterTemplate>
                <strong>
                    @Items.Sum(x => x.IncomeAmount)
                </strong>
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Context="c"
                              Property="InDescription"
                              Title="Description">
            <Template>
                @c.InDescription
            </Template>
        </RadzenDataGridColumn>
    </Columns>
    <LoadingTemplate>
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </LoadingTemplate>
</RadzenDataGrid>

