<EditForm Model="model" OnValidSubmit="FormSubmit">
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="12">
            <RadzenLabel>Note</RadzenLabel>
            <RadzenTextArea @bind-Value="model.Description" class="w-100"></RadzenTextArea>
        </RadzenColumn>
    </RadzenRow>
    <RadzenStack AlignItems="AlignItems.Center"
    Orientation="Orientation.Horizontal"
    JustifyContent="JustifyContent.End">
        <RadzenButton ButtonType="Radzen.ButtonType.Submit"
                      IsBusy="isBusy"
                      Icon="save"
                      Size="Radzen.ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Success"
                      Text="Save">
        </RadzenButton>
    </RadzenStack> 
</EditForm>

@code {
    [Parameter] public long CustomerId { get; set; }
    [Parameter] public long UserId { get; set; }
    bool isBusy = false;
    private CustomerNoteDtoCreate model = new();

    async void FormSubmit()
    {
        isBusy = true;

        model.CustomerRefId = CustomerId;
        model.CreditAgentRefId = UserId;
        var noteResponse = await _customerService.AddCusomerNoteAsync(model);

        if (noteResponse.IsSuccess)
        {
            isBusy = false;
            DialogService.Close(false);
        }

    }
}
