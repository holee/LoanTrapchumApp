@page "/Customers"
@using Radzen.Blazor.Rendering
@using TCLMS.Front.Pages.Lists.Collaterals
@using TCLMS.Shared.Entities.ViewModels.Options
<PageTitle>Customers</PageTitle>
<RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Value="100" Visible="isVisble" ShowValue="false"></RadzenProgressBar>
<Containers Fluid>
    <Card CssClass="rz-background-color-base-100">
        <CardBody>
            <RadzenTabs RenderMode="TabRenderMode.Server"
                        Change="SelectedTabChanged"
                        @bind-SelectedIndex="selectedIndex"
                        @ref="@tabs">
                <Tabs>
                    <RadzenTabsItem Text="Customer" Icon="group" Selected="true">
                        <CustomersList ClickedEdit="AddEditTab"
                                       ClickedAddCollateral="AddCollateralTab"
                                       ClickedDetails="Details">
                            <ChildContent>
                                <RadzenButton Icon="person_add"
                                              Text="Add Customer"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Click="AddCustomerTab"
                                              Size="Radzen.ButtonSize.Small">
                                </RadzenButton>
                            </ChildContent>
                        </CustomersList>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="New Customer" Icon="person_add" Visible="isNewTab">
                        <CustomerCreate Closed="CloseTabe" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Customer" Icon="info" Visible="isDetailsTab">
                        <CustomerDetails Close="CloseTabe" CustomerId="@customerId" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Edit"
                                    Icon="edit_square"
                                    Visible="isEditTab">
                        <CustomerUpdateTab CustomerId="customerId"
                                           Closed="CloseTabe"></CustomerUpdateTab>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Customer Colleral"
                                    Icon="inventory"
                                    Visible="isCollateralTab">
                        <CollateralCreate Close="CloseTabe" CustomerId="customerId"></CollateralCreate>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </CardBody>
    </Card>
</Containers>
@code {
    [CascadingParameter]
    Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    void SelectedTabChanged(int index)
    {
        selectedIndex = index;
    }
    RadzenTabs tabs;
    List<int> tabCounts = [0];
    protected int totalCstomers;
    int tabIndex = 1;
    int selectedIndex = 0;
    bool isNewTab = false;
    bool isDetailsTab = false;
    bool isEditTab = false;
    long customerId = 0;
    bool isVisble = false;
    bool isCollateralTab = false;
    bool IsLoading = true;
    void Details(long id)
    {
        isVisble = true;
        if (!isDetailsTab)
        {
            isDetailsTab = true;
            tabCounts.Add(2);
        }
        customerId = id;
        tabs.Reload();
        selectedIndex = 2;
        isVisble = false;
    }

    void AddCollateralTab(long id)
    {
        isVisble = true;
        if (!isCollateralTab)
        {
            isCollateralTab = true;
            tabCounts.Add(4);
        }
        customerId = id;
        tabs.Reload();
        selectedIndex = 4;
        isVisble = false;
    }

    void AddEditTab(long id)
    {
        isVisble = true;
        if (!isEditTab)
        {
            isEditTab = true;
            tabCounts.Add(3);
        }
        customerId = id;
        tabs.Reload();
        selectedIndex = 3;
        isVisble = false;
    }
    void AddCustomerTab()
    {
        if (!isNewTab)
        {
            isNewTab = true;
            tabCounts.Add(1);
        }
        tabs.Reload();
        selectedIndex = 1;
    }
    void CloseTabe()
    {
        if (selectedIndex == 1)
        {
            isNewTab = false;
            tabCounts.Remove(1);
            selectedIndex = tabCounts.Count - 1;
        }
        if (selectedIndex == 2)
        {
            isDetailsTab = false;
            tabCounts.Remove(2);
            selectedIndex = tabCounts.Count - 1;
        }
        if (selectedIndex == 3)
        {
            isEditTab = false;
            tabCounts.Remove(3);
            selectedIndex = tabCounts.Count - 1;
        }
        if (selectedIndex == 4)
        {
            isCollateralTab = false;
            tabCounts.Remove(4);
            selectedIndex = tabCounts.Count - 1;
        }
    }

}
