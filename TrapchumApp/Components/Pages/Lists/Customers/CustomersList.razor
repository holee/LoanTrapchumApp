@using Microsoft.AspNetCore.WebUtilities
@using Radzen.Blazor.Rendering
@using TCLMS.Front.Pages.Lists.Collaterals
@using TCLMS.Shared.Entities.Dtos.Lists.Customers
@using TCLMS.Shared.Entities.ViewModels.Options
@attribute [MustHasPermission(Modules.Customers, Feature.Read)]
<Containers Fluid CssClass="rz-m-0 rz-p-0">
    <PageDropDown PageSizeChanged="ChangedPageSize"
                  ShowSearchBox="true"
                  PlaceHolder="Search Customers?"
                  OnTextChanged="SearchCustomer">
        <LeftChildContent>
            @ChildContent
        </LeftChildContent>
    </PageDropDown>
    <RadzenDataGrid Count="@counts"
                    AllowPaging="true"
                    Responsive
                    IsLoading="isLoading"
                    GridLines="DataGridGridLines.Both"
                    Density="Density.Compact"
                    AllowAlternatingRows="true"
                    AllowRowSelectOnRowClick="true"
                    AllowSorting="true"
                    ColumnWidth="200px"
                    PageSize="@pageSize"
                    PagerPosition="PagerPosition.Bottom"
                    RowRender="OnRowRender"
                    ShowPagingSummary="true"
                    PagerHorizontalAlign="HorizontalAlign.Right"
                    @bind-Value="SelectedCustomers"
                    LoadData="LoadData"
                    Style="min-height:30rem;height:30rem;max-height:45rem;"
                    TItem="CustomerList"
                    Data="VCustomers">
        <Columns>
            <RadzenDataGridColumn Title="#"
                                  Width="5rem"
                                  Context="c"
                                  Property="CustomerId"
                                  Sortable="true">
                <Template>
                    @c.CustomerId
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Property="AltName"
                                  Context="c"
                                  Width="8rem"
                                  Title="Name">
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Title="Phone"
                                  Context="c"
                                  Width="6rem"
                                  Property="Phone"
                                  Sortable="false">
                <Template>
                    @c.Phone
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="c"
                                  Sortable="false"
                                  Title="Address">
                <Template>
                    @c.ToString()
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="c"
                                  Width="5rem"
                                  TextAlign="TextAlign.Center"
                                  Sortable="false"
                                  Title="IsLoanActive">
                <Template>
                    <RadzenCheckBox Value="@c.IsLoanActive" Disabled />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn Context="c"
                                  Width="3rem"
                                  Sortable="false"
                                  CssClass="z"
                                  TextAlign="TextAlign.Start"
                                  Title="Actions">
                <Template>
                    <RadzenButton Size="Radzen.ButtonSize.ExtraSmall"
                                  Icon="more_vert"
                                  Variant="Variant.Text"
                                  Click="@((args)=>ShowContextMenu(args,c))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</Containers>

@code {

    [CascadingParameter]
    Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    [Parameter] public EventCallback<long> ClickedDetails { get; set; }
    [Parameter] public EventCallback<long> ClickedEdit { get; set; }
    [Parameter] public EventCallback<long> ClickedDelete { get; set; }
    [Parameter] public EventCallback<long> ClickedAddCollateral { get; set; }
    [Parameter] public EventCallback<CustomerList> SelectedRowChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; } = default!;
    bool IsAccountOnly = false;
    bool IsAdminOnly = false;

    protected CustomerDto? Customer;
    protected List<CustomerList>? VCustomers = [];
    protected bool includeInactive = false;
    protected string SearchTerm = string.Empty;
    private int counts = 0;
    private int pageSize = 10;
    int branchId = 0;
    long userId = 0;
    void ShowContextMenu(MouseEventArgs args, CustomerList c)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;" Click="OnMenuItemClick">
        <RadzenMenuItem Visible="@CanRequestLoan"
                        Icon="add"
                        Click="@(()=>AddLoanRequest(c.CustomerId))"
                        Text="Request Loan"
                        Value="@c.CustomerId"></RadzenMenuItem>
        <RadzenMenuItem Click="@(()=>AddCollateral(c.CustomerId))" Icon="add" Text="Add Collateral" Value="@c.CustomerId" />
        <RadzenMenuItem Click="@(()=>AddInComeModal(c.CustomerId))" Icon="money" Text="Add Income" Value="@c.CustomerId" />
        <RadzenMenuItem Click="@(()=>AddExpenseModal(c.CustomerId))" Icon="paid" Text="Add Expense" Value="@c.CustomerId" />
        <RadzenMenuItem Click="@(()=>AddDetails(c.CustomerId))" Icon="info" Text="Customer Details" Value="@c.CustomerId" />
        <RadzenMenuItem Visible="@IsAdminOnly" Click="@(()=>AddEdit(c.CustomerId))" Icon="edit" Text="Edit" Value="@c.CustomerId" />
        <RadzenMenuItem Visible="@IsAdminOnly" Click="@(()=>AddDelete(c.CustomerId))" Icon="delete" Text="Delete" Value="@c.CustomerId" />
    </RadzenMenu>
    );
    }

    void OnMenuItemClick(MenuItemEventArgs args)
    {
        ContextMenuService.Close();
    }

    IList<CustomerList> SelectedCustomers = [];
    bool isLoading = false;
    bool CanRequestLoan = false;
    IList<Items> pages = new Items[]
       {
        new Items(10,"10"),
        new Items(25,"25"),
        new Items(50,"50"),
        new Items(100,"100"),
       };

    void ChangedPageSize(int page)
    {
        pageSize = page;
    }

    protected async void AddInComeModal(long customerId)
    {
        await DialogService.OpenAsync<CustomerModalIncome>("Income", options: new Radzen.DialogOptions
            {
                Width = "50rem",
                Height = "25rem",
                Resizable = false,
                Draggable = true,
            }, parameters: new Dictionary<string, object>
            {
                { "CustomerId",customerId }
            });
    }
    protected async Task AddCollateral(long customerId)
    {
        ContextMenuService.Close();
        await ClickedAddCollateral.InvokeAsync(customerId);

    }
    protected void AddLoanRequest(long customerId)
    {
        ContextMenuService.Close();
        var uri = $"/Loan/{customerId}/Customer/Request?BranchId={branchId}&UserId={userId}&ActionMode={ActionMode.Create}";
        NavigationManager.NavigateTo(uri);

    }
    protected async void AddExpenseModal(long customerId)
    {
        await DialogService.OpenAsync<CustomerModalExpense>("Add Expense", options: new Radzen.DialogOptions
            {
                Width = "60rem",
                Height = "25rem",
                Resizable = false,
                Draggable = true,
            }, parameters: new Dictionary<string, object>
            {
                { "CustomerId",customerId }
            });
    }
    protected async void AddDetails(long customerId)
    {
        await ClickedDetails.InvokeAsync(customerId);
        ContextMenuService.Close();
    }
    protected async void AddEdit(long customerId)
    {
        await ClickedEdit.InvokeAsync(customerId);
        ContextMenuService.Close();
    }
    protected async void AddDelete(long customerId)
    {
        var confirm = await DialogService.Confirm("do you want to delete this customer?", "Delete", options: new ConfirmOptions
            {
                OkButtonText = "Yes",
                CancelButtonText = "No"
            });
        if (confirm == true)
        {

        }
    }

    async void SearchCustomer(string? searchText = null)
    {
        SearchTerm = searchText ?? string.Empty;
        await LoadCustomerPageList();
    }

    async Task SelectedPageChanged(int pageSize)
    {
        this.pageSize = pageSize;
        await LoadCustomerPageList();
    }
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationState;
        branchId = auth.User.GetBranchId();
        userId = auth.User.GetId();
        CanRequestLoan = await _authorizeService.MustHasPermissionAsync(auth.User, LoanRequestsPolicies.Request);
        IsAccountOnly = await _authorizeService.MustHasPermissionAsync(auth.User, Policies.AccountOnly);
        IsAdminOnly = await _authorizeService.MustHasPermissionAsync(auth.User, Policies.AdminOnly);
        await LoadCustomerPageList();
        await base.OnInitializedAsync();
    }

    async Task LoadData(LoadDataArgs args)
    {
        string sortField = "CustomerId";
        bool sortDescending = false;
        int pageIndex = args.Skip!.Value;
        if (!string.IsNullOrEmpty(args.OrderBy))
        {
            sortField = args.OrderBy.Split(" ")[0];
            string dir = args.OrderBy.Split(" ")[1];
            sortDescending = dir.Contains("asc") ? false : true;
        }

        await LoadCustomerPageList(pageIndex, sortField, sortDescending);
    }
    async Task LoadCustomerPageList(int pageIndex = 0, string sortField = "CustomerId", bool sortDescending = false)
    {
        try
        {
            isLoading = true;
            var res = await _customerService.GetCustomersAsync(pageIndex, pageSize, sortField, sortDescending, includeInactive, SearchTerm);
            VCustomers = res.Items;
            counts = res.Count;
            isLoading = false;
            StateHasChanged();
        }
        catch
        {
            isLoading = false;
        }

    }
    void Details(long id)
    {
        NavigationManager.NavigateTo($"");
    }
    void Edit(long id)
    {
        NavigationManager.NavigateTo($"/Customers/Edit/{id}");
    }
    private async void GetCustomerById(long id)
    {
        Customer = await _customerService!.GetCustomerByIdAsync(id);
    }

    void OnRowRender(RowRenderEventArgs<CustomerList> e)
    {
        if (e.Data.IsLoanActive)
        {
            e.Attributes.Add("style", "font-weight:bold;color:red;background-color:yellow;");
        }
    }
}

