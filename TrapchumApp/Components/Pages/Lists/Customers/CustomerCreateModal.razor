<div class="container-fluid rz-background-color-base-100">
    <EditForm Model="model" @ref="editForm">
        <FluentValidationValidator DisableAssemblyScanning="true"></FluentValidationValidator>
        <RadzenFieldset Text="Customer">
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="3">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="6">
                            <RadzenLabel>Name</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn Size="6">
                            <RadzenDropDown @bind-Value="model.Salutation"
                                            Chips="true"
                                            Name="DropDownSalutions"
                                            class="w-100"
                                            TValue="string"
                                            Placeholder="Salutation"
                                            Data="Salutations">
                                <ValueTemplate Context="s">
                                    <RadzenTextBox @bind-Value="model.Salutation"
                                                   @onkeydown="AddNewSalutation"
                                                   @oninput="OnTextChangedSalution"
                                                   Style="width:120%;height:120%;margin:-15px"
                                                   aria-labelledby="DropDownEditLabel" />
                                </ValueTemplate>
                            </RadzenDropDown>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12">
                            <RadzenTextBox @bind-Value="model.FirstName"
                                           class="w-100"
                                           Placeholder="First name..." />
                            <ValidationMessage For="@(()=>model.FirstName)" />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12">
                            <RadzenTextBox @bind-Value="model.MiddleName"
                                           class="w-100"
                                           Placeholder="Middle Name..." />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12">
                            <RadzenTextBox @bind-Value="model.LastName"
                                           class="w-100"
                                           Placeholder="Last Name.." />
                            <ValidationMessage For="@(()=>model.LastName)" />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                <RadzenColumn Size="6">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="3">
                            <RadzenLabel>Khmer Name</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn Size="9">
                            <RadzenTextBox @bind-Value="model.AltName"
                                           class="w-100 h-100"
                                           Placeholder="ឈ្មោះខ្មែរ..." />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="4">
                            <RadzenLabel>Date Of Birth</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn Size="8">
                            <RadzenDatePicker TValue="DateTime?"
                                              @bind-Value="model.DateOfBirth"
                                              @bind-Value:format="yyyy-MMM-dd"
                                              DateFormat="dd/MM/yyyy"
                                              class="w-100"
                                              Placeholder="Date Of Birth">
                            </RadzenDatePicker>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
                <RadzenColumn Size="3">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="5">
                            <RadzenLabel>Married Status</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn Size="7">
                            <RadzenDropDown @bind-Value="model.MarritalStatus"
                                            class="w-100"
                                            Data="Statuses">
                            </RadzenDropDown>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                <RadzenColumn Size="6">
                    <RadzenRow AlignItems="AlignItems.Center">
                        <RadzenColumn Size="3">Occupation</RadzenColumn>
                        <RadzenColumn Size="9">
                            <RadzenDropDown class="w-100"
                                            Data="Occupations"
                                            AllowFiltering="true"
                                            FilterOperator="StringFilterOperator.Contains"
                                            TextProperty="OccupationTitle"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            ValueProperty="OccupationTitle"
                                            @bind-Value="model.Occupation">
                            </RadzenDropDown>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="3">Phone</RadzenColumn>
                        <RadzenColumn Size="9">
                            <RadzenTextBox class="w-100"
                                           @bind-Value="model.Phone"
                                           Placeholder="Mobile phone..." />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="3">Email</RadzenColumn>
                        <RadzenColumn Size="9">
                            <RadzenTextBox class="w-100"
                                           @bind-Value="model.EmailAddress"
                                           Placeholder="Email Address" />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="3">Passport</RadzenColumn>
                        <RadzenColumn Size="9">
                            <RadzenTextBox class="w-100"
                                           @bind-Value="model.PassportId"
                                           Placeholder="Passport...." />
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="3">Nationality</RadzenColumn>
                        <RadzenColumn Size="9">
                            <RadzenTextBox class="w-100"
                                           @bind-Value="model.Nationality"
                                           Placeholder="Nationality...." />
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenCard class="w-100 h-100">
                        <RadzenText TextStyle="TextStyle.Subtitle2"
                                    TagName="TagName.H3">Drag and drop files to upload</RadzenText>
                        <RadzenUpload id="ddUpload"
                                      ChooseText="Drag and drop here or click to choose files"
                                      Auto="false"
                                      Multiple="false"
                                      Url="upload/multiple"
                                      InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select file" }})"
                                      Progress=@(args => OnProgress(args, "Drag and drop files to upload")) class="w-100" />
                        <RadzenButton Text="Upload"
                                      class="d-block mt-4" />
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>
        <RadzenFieldset Text="Address">
            <RadzenRow AlignItems="AlignItems.Center">
                <RadzenColumn Size="6">
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="3">
                            <RadzenLabel>Country</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn Size="9">
                            <RadzenDropDown class="w-100"
                                            Data="Countries"
                                            Disabled="true"
                                            AllowFiltering="true"
                                            Placeholder="Search Countries"
                                            FilterOperator="StringFilterOperator.Contains"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            @bind-Value="model.CountryName">
                            </RadzenDropDown>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="3">
                            <RadzenLabel>Province</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn Size="9">
                            <RadzenDropDown class="w-100"
                                            Data="Provinces"
                                            Placeholder="Search Province"
                                            AllowFiltering="true"
                                            TextProperty="ProInKhmer"
                                            ValueProperty="ProvinceID"
                                            @bind-Value:after="GetDistrictsByprovince"
                                            FilterOperator="StringFilterOperator.Contains"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            @bind-Value="model.ProvinceRefId">
                            </RadzenDropDown>
                        </RadzenColumn>
                    </RadzenRow>

                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="3">
                            <RadzenLabel>Commune</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn Size="9">
                            <RadzenDropDown class="w-100"
                                            Data="CommuneList"
                                            Placeholder="Search Commune"
                                            AllowFiltering="true"
                                            TextProperty="ComInKhmer"
                                            ValueProperty="CommuneId"
                                            @bind-Value:after="GetVillagesByCommune"
                                            FilterOperator="StringFilterOperator.Contains"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            @bind-Value="model.CommuneRefId">
                            </RadzenDropDown>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="3">
                            <RadzenLabel>City</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn Size="9">
                            <RadzenDropDown class="w-100"
                                            Data="Cities"
                                            TValue="string"
                                            Placeholder="Search City"
                                            AllowFiltering="true"
                                            @onkeydown="OnKeyPress"
                                            Disabled="true"
                                            FilterOperator="StringFilterOperator.Contains"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            @bind-Value="model.City">
                            </RadzenDropDown>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="3">
                            <RadzenLabel>District</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn Size="9">
                            <RadzenDropDown class="w-100"
                                            Data="DistrictList"
                                            Placeholder="Search District"
                                            AllowFiltering="true"
                                            TextProperty="DisInKhmer"
                                            ValueProperty="DistrictId"
                                            @bind-Value:after="GetCommunesByDistrict"
                                            FilterOperator="StringFilterOperator.Contains"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            @bind-Value="model.DistrictRefId">
                            </RadzenDropDown>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="3">
                            <RadzenLabel>Village</RadzenLabel>
                        </RadzenColumn>
                        <RadzenColumn Size="9">
                            <RadzenDropDown class="w-100"
                                            Data="VillageList"
                                            Placeholder="Search Village"
                                            AllowFiltering="true"
                                            TextProperty="VilInKhmer"
                                            ValueProperty="VillageID"
                                            FilterOperator="StringFilterOperator.Contains"
                                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                            @bind-Value="model.CommuneRefId"></RadzenDropDown>
                        </RadzenColumn>
                    </RadzenRow>
                </RadzenColumn>
            </RadzenRow>
        </RadzenFieldset>
        @if (model.MarritalStatus != "Single")
        {
            <RadzenFieldset Text="Spouse">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="6">
                        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                            <RadzenColumn Size="3">
                                <RadzenLabel>Spouse Name</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenTextBox @bind-Value="model.SpouseName"
                                               class="w-100"
                                               Placeholder="Spouse name" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                            <RadzenColumn Size="3">
                                <RadzenLabel>Nationality</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenTextBox @bind-Value="model.SpouseNationality"
                                               class="w-100"
                                               Placeholder="Spouse Nationality" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                            <RadzenColumn Size="3">
                                <RadzenLabel>Passport No</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenTextBox @bind-Value="model.SpousePassport"
                                               class="w-100"
                                               Placeholder="Spouse Passport" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                            <RadzenColumn Size="3">
                                <RadzenLabel>Spouse Phone</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenTextBox @bind-Value="model.SpousePhoneNo"
                                               class="w-100"
                                               Placeholder="Spouse Phone" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                            <RadzenColumn Size="3">
                                <RadzenLabel>Spouse Birth Date</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenDatePicker TValue="DateTime?"
                                                  class="w-100"
                                                  Placeholder="Spouse Date Of Birth"
                                                  @bind-Value:format="yyyy-MMM-dd"
                                                  @bind-Value="model.SpouseDateOfBirth">
                                </RadzenDatePicker>
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                            <RadzenColumn Size="3">
                                <RadzenLabel>Spouse Occupation</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenDropDown class="w-100"
                                                Data="Occupations"
                                                AllowFiltering="true"
                                                FilterOperator="StringFilterOperator.Contains"
                                                TextProperty="OccupationTitle"
                                                Placeholder="Search Occupations"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                ValueProperty="OccupationTitle"
                                                @bind-Value="model.SpouseOccupation">
                                </RadzenDropDown>
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                            <RadzenColumn Size="3">
                                <RadzenLabel>Dependents</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenNumeric TValue="int?"
                                               class="w-100"
                                               Min="0"
                                               Max="12"
                                               @bind-Value="model.Dependents" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                            <RadzenColumn Size="3">
                                <RadzenLabel>Children</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenNumeric TValue="int?"
                                               Min="0"
                                               Max="12"
                                               class="w-100"
                                               @bind-Value="model.NoOfChildren" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenFieldset>
        }
        <RadzenStack Orientation="Radzen.Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="1rem"
                     JustifyContent="Radzen.JustifyContent.End">
            <RadzenButton Click="FormSubmit"
                          Size="Radzen.ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Success"
                          Text="Save"
                          Icon="save" />
            <RadzenButton Click="Close"
                          Size="Radzen.ButtonSize.Small"
                          Text="Close"
                          ButtonStyle="ButtonStyle.Danger"
                          Icon="cancel" />
        </RadzenStack>
    </EditForm>
</div>
@code {

    private IEnumerable<Nationality> Nationalities { get; set; } = [];
    private IEnumerable<StOcupationDto> Occuptions { get; set; } = [];
    private IEnumerable<string> Statuses = ["Single", "Married", "Divorced", "Widow"];
    string selectedTab = "info";
    string city = "";
    private Task OnSelectedTabChanged(string name)
    {
        selectedTab = name;
        return Task.CompletedTask;
    }
    void OnChanged(ChangeEventArgs e)
    {
        city = e!.Value!.ToString()!;
    }
    void OnProgress(UploadProgressArgs args, string name)
    {
        if (args.Progress == 100)
        {
            foreach (var file in args.Files)
            {

            }
        }
    }
    void OnImageChange(UploadChangeEventArgs args, string name)
    {
        if (args.Files.Count() == 0) return;
        var imageFile = args.Files.FirstOrDefault();
        model.Photo = imageFile!.Name;
    }
    async Task OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Code == "Enter")
        {
            await _addressService.AddCity(new CityDtoCreate
                {
                    CityName = city
                });
            Cities = await _addressService.GetCities();
        }

    }

    async Task GetAdditionalInformation()
    {
        Nationalities = await _nationalityService!.GetAllAsync();

        Provinces = await _addressService.GetAllProvinceAsync();

        Occuptions = await _employeeService!.GetOccupationsAsync("Position");

        Countries = await _addressService.GetCountries(105);

        Cities = await _addressService.GetCities();
    }
}





