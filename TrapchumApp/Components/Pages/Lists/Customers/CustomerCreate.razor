@page "/App/Customers/CreateNewUser"
@using Applications.Enumerations
<Containers Fluid>
    <EditForm Model="model" @ref="editForm" OnValidSubmit="FormSubmit">
        <FluentValidationValidator DisableAssemblyScanning="true"></FluentValidationValidator>
        <RadzenFieldset AllowCollapse="true" Collapsed="false" class="rz-mb-2">
            <HeaderTemplate>
                <RadzenIcon Icon="person" /><strong>Customer</strong>
            </HeaderTemplate>
            <ChildContent>
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="6">
                                <RadzenLabel>Name</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="6">
                                <RadzenDropDown Chips="true"
                                                AllowFiltering="true"
                                                Name="DropDownSalutions"
                                                Style="width: 100%;"
                                                TValue="string"
                                                FilterOperator="StringFilterOperator.Contains"
                                                Placeholder="Salutation"
                                                @bind-Value="model.Salutation"
                                                Data="Salutations">
                                    Data="Salutations">
                                </RadzenDropDown>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12">
                                <RadzenTextBox @bind-Value="model.FirstName"
                                               class="w-100"
                                               Placeholder="First name..." />
                                <ValidationMessage For="@(() => model.FirstName)" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12">
                                <RadzenTextBox @bind-Value="model.MiddleName"
                                               class="w-100"
                                               Placeholder="Middle Name..." />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12">
                                <RadzenTextBox @bind-Value="model.LastName"
                                               class="w-100"
                                               Placeholder="Last Name.." />
                                <ValidationMessage For="@(() => model.LastName)" />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="6">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="3">
                                <RadzenLabel>Khmer Name</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenTextBox @bind-Value="model.AltName"
                                               class="w-100"
                                               Placeholder="ឈ្មោះខ្មែរ..." />
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="4">
                                <RadzenLabel>Date Of Birth</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenDatePicker TValue="DateTime?"
                                                  @bind-Value="model.DateOfBirth"
                                                  @bind-Value:format="yyyy-MMM-dd"
                                                  DateFormat="dd/MM/yyyy"
                                                  class="w-100"
                                                  Placeholder="Date Of Birth">
                                </RadzenDatePicker>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                    <RadzenColumn Size="3">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="5">
                                <RadzenLabel>Married Status</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="7">
                                <RadzenDropDown @bind-Value="model.MarritalStatus"
                                                class="w-100"
                                                Data="Statuses">
                                </RadzenDropDown>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="6">
                        <RadzenRow AlignItems="AlignItems.Center">
                            <RadzenColumn Size="3">Occupation</RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenDropDown class="w-100"
                                                Data="Occupations"
                                                AllowFiltering="true"
                                                FilterOperator="StringFilterOperator.Contains"
                                                TextProperty="OccupationTitle"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                ValueProperty="OccupationTitle"
                                                @bind-Value="model.Occupation">
                                </RadzenDropDown>
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                            <RadzenColumn Size="3">Phone</RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenTextBox class="w-100"
                                               @bind-Value="model.Phone"
                                               Placeholder="Mobile phone..." />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                            <RadzenColumn Size="3">Email</RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenTextBox class="w-100"
                                               @bind-Value="model.EmailAddress"
                                               Placeholder="Email Address" />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                            <RadzenColumn Size="3">Passport</RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenTextBox class="w-100"
                                               @bind-Value="model.PassportId"
                                               Placeholder="Passport...." />
                            </RadzenColumn>
                        </RadzenRow>
                        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                            <RadzenColumn Size="3">
                                <RadzenLabel>Nationality</RadzenLabel>
                            </RadzenColumn>
                            <RadzenColumn Size="9">
                                <RadzenDropDown Data="Nationalities"
                                                class="w-100"
                                                TextProperty="@nameof(Nationality.NationalityName)"
                                                ValueProperty="@nameof(Nationality.NationalityName)"
                                                @bind-Value="model.Nationality">
                                </RadzenDropDown>
                            </RadzenColumn>
                        </RadzenRow>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenCard class="rz-m-0 rz-m-md-0 w-100">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenImage Path="@model.Photo"
                                                 class="rz-p-0 rz-m-0"
                                                 Style="width:4.5rem;height:4.5rem;" />
                                </RadzenColumn>
                                <RadzenColumn Size="9">
                                    <RadzenUpload Change=@(args => HandleFileUpload(args, "Single file upload"))
                                                  Auto="false"
                                                  Progress=@(args => OnProgress(args, "Single file upload"))
                                                  Style="width: 100%"
                                                  InputAttributes="@(new Dictionary<string, object> { { "aria-label", "select file" } })">
                                    </RadzenUpload>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenCard>
                    </RadzenColumn>
                </RadzenRow>

            </ChildContent>
        </RadzenFieldset>
        <CustomerAddress Cities="@Cities"
                         model="@model"
                         Countries="@Countries" />
        @if (model.MarritalStatus != MarritalStateEnum.Single.ToString())
        {
            <SpouseInfo model="@model"
                        Nationalities="@Nationalities"
                        Occupations="@Occupations" />
        }
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="1rem"
                     class="rz-mt-2"
                     JustifyContent="JustifyContent.End">
            <RadzenButton Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Success"
                          ButtonType="ButtonType.Submit"
                          Text="Save"
                          Icon="save" />
            <RadzenButton Click="Close"
                          Size="ButtonSize.Small"
                          Text="Close"
                          ButtonStyle="ButtonStyle.Danger"
                          Icon="cancel" />
        </RadzenStack>
    </EditForm>
</Containers>




