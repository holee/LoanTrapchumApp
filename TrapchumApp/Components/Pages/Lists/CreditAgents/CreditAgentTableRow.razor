       <TableRowCell>@CreditAgent?.Phone</TableRowCell>
        <TableRowCell>
            <input type="hidden" @bind="CreditAgent.EditSeq" />
            <input type="hidden" @bind="CreditAgent.LoanCreditAgentId" />
            <Switch 
                CheckedChanged="OnCheckChanged" 
                Background="Background.Danger"
                TValue="bool"
                    Checked="CreditAgent.IsRemove"
                    CheckedExpression="@(()=>CreditAgent.IsRemove)" />
        </TableRowCell>
