@page "/Employees/CreditAgents"
@using Applications.Responses.ViewModels.Employees;
<RadzenCard>
    <RadzenTabs SelectedIndex="selectedTabIndex"
                SelectedIndexChanged="SelectedTabChanged"
                @ref="tabs"
                RenderMode="TabRenderMode.Server">
        <Tabs>
            <RadzenTabsItem Text="All" Icon="people_alt">
                <RadzenRow AlignItems="AlignItems.Center" RowGap="0.5rem" class="mb-2">
                    <RadzenColumn Size="2">
                        <RadzenStack AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.Start"
                                     Orientation="Orientation.Horizontal">
                            <div class="dropdown-center">
                                <RadzenButton class="rz-background-color-base-100"
                                              ButtonType="Radzen.ButtonType.Button"
                                              Size="Radzen.ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Light"
                                              data-bs-toggle="dropdown"
                                              Shade="Shade.Darker"
                                              aria-expanded="false">
                                    Show @(pageSize) rows
                                </RadzenButton>
                                <ul class="dropdown-menu">
                                    <li><button onclick="@(()=>ChangedPageSize(10))" class="btn-sm dropdown-item" type="button">10 Rows</button></li>
                                    <li><button onclick="@(()=>ChangedPageSize(25))" class="btn-sm dropdown-item" type="button">25 Rows</button></li>
                                    <li><button onclick="@(()=>ChangedPageSize(50))" class="btn-sm dropdown-item" type="button">50 Rows</button></li>
                                    <li><button onclick="@(()=>ChangedPageSize(100))" class="btn-sm dropdown-item" type="button">100 Rows</button></li>
                                </ul>
                            </div>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="4">
                        <RadzenStack AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.Center"
                                     Orientation="Orientation.Horizontal">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">
                                    Branch
                                </span>
                                <RadzenDropDown TValue="int"
                                                TextProperty="BranchName"
                                                ValueProperty="BranchId"
                                                Data="Branches"
                                                Style="width:75%"
                                                @bind-Value:after="SelectedBranchChanged"
                                                @bind-Value="BranchId">
                                </RadzenDropDown>
                            </div>
                        </RadzenStack>
                    </RadzenColumn>
                    <RadzenColumn Size="6">
                        <RadzenStack AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.End"
                                     Orientation="Orientation.Horizontal">
                            <RadzenFormField AllowFloatingLabel="false" Variant="Variant.Outlined">
                                <Start>
                                    <RadzenIcon Icon="search" />
                                </Start>
                                <ChildContent>
                                    <RadzenTextBox @bind-Value="searchText"
                                                   @bind-Value:after="GetSearchChandged"
                                                   Placeholder="Search Credit Agent Here.." />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenStack>

                    </RadzenColumn>
                </RadzenRow>
                <RadzenStack AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.Center"
                             Orientation="Orientation.Horizontal">
                    <RadzenDataGrid Data="CreditAgents"
                                    Density="Density.Compact"
                                    AllowPaging="true"
                                    ShowPagingSummary="true"
                                    PageSize="pageSize"
                                    PagerHorizontalAlign="HorizontalAlign.Right"
                                    LoadData="LoadData"
                                    IsLoading="isLoading"
                                    Count="@counts"
                                    GridLines="DataGridGridLines.Both">
                        <HeaderTemplate>
                            <RadzenStack Orientation="Orientation.Horizontal"
                                         AlignItems="AlignItems.Center"
                                         JustifyContent="JustifyContent.SpaceBetween">
                                <RadzenButton Text="Credit Officer"
                                              Click="AddCreditAgentTab"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Icon="add"
                                              Size="Radzen.ButtonSize.Small" />
                            </RadzenStack>
                        </HeaderTemplate>
                        <Columns>
                            <RadzenDataGridColumn Property="LoanCreditAgentId"
                                                  Title="#"
                                                  Width="3rem"
                                                  Context="em">
                                <Template>
                                    <strong>
                                        @{
                                            var rowNumber = CreditAgents!.IndexOf(em) + 1;
                                        }
                                        @rowNumber
                                    </strong>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="FirstName" Title="First Name" Sortable="true" />
                            <RadzenDataGridColumn Property="LastName" Title="Last Name" Sortable="true" />
                            <RadzenDataGridColumn Property="Phone" Title="Phone" Sortable="false" />
                            <RadzenDataGridColumn Property="BranchName" Title="Branch" Sortable="true" />
                            <RadzenDataGridColumn Width="5rem" Context="c" Title="Remove" Sortable="false">
                                <Template>
                                    <CreditAgentSwitch Reload="Reload" CreditAgent="@c" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Width="5rem"
                                                  TextAlign="TextAlign.Center"
                                                  Context="c" Title="Remove" Sortable="false">
                                <Template>
                                    <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                                  Size="Radzen.ButtonSize.ExtraSmall"
                                                  Click="@(()=>AddUserAccount(c))"
                                                  Icon="person_add" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenStack>
            </RadzenTabsItem>
            <RadzenTabsItem Text="New C.O" Visible="ShowAddedTab" Icon="person_add">
                <RadzenStack AlignItems="AlignItems.Center"
                             Orientation="Orientation.Horizontal"
                             class="mb-2"
                             JustifyContent="JustifyContent.End">
                    <RadzenFormField>
                        <Start>
                            <RadzenIcon Icon="search" />
                        </Start>
                        <ChildContent>
                            <RadzenTextBox Placeholder="Search Employee"
                                           @bind-Value="searchText"
                                           @bind-Value:after="SearchCreditAgent" />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenStack>
                <RadzenDataGrid TItem="VEmployeeCreateCreditAgent"
                                PageSize="10"
                                ColumnWidth="10rem"
                                style="--rz-grid-header-background-color:var(--rz-base-200);"
                                Density="Density.Compact"
                                Data="CreditAgentPageList">
                    <Columns>
                        <RadzenDataGridColumn Property="FirstName" Title="First Name" />
                        <RadzenDataGridColumn Property="LastName" Title="Last Name" />
                        <RadzenDataGridColumn Property="Gender" Title="Gender" />
                        <RadzenDataGridColumn Property="BranchName" Title="Branch Name" />
                        <RadzenDataGridColumn Width="6rem" Title="Action" Sortable="false">
                            <Template>
                                <RadzenButton Size="Radzen.ButtonSize.ExtraSmall"
                                              Click="@(()=>AddCreditAgent(context!.EmployeeId!.Value))"
                                              Variant="Variant.Text"
                                              Text="Make C.O"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Icon="person_add" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
    <RadzenStack AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.End"
                 Gap="1rem"
                 class="mt-2"
                 Orientation="Orientation.Horizontal">
        <RadzenButton Text="Close"
                      Icon="cancel"
                      Size="Radzen.ButtonSize.Small"
                      Click="RemoveTab"
                      ButtonStyle="ButtonStyle.Danger" />
    </RadzenStack>
</RadzenCard>

