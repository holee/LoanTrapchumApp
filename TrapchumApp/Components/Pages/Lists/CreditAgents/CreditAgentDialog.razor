@using AppilcationServices.Interfaces
@using ApplicationServices.Interfaces
@using TCLMS.Shared.Entities.Paginations

<div class="card">
    <div class="card-header">
        <RadzenTextBox Placeholder="Search Employee"
                       @bind-Value="searchText"
                       @bind-Value:after="SearchCreditAgent" />
    </div>
    <div class="card">
        <RadzenDataGrid TItem="VEmployeeCreateCreditAgent"
                        PageSize="10"
                        ColumnWidth="10rem"
                        Density="Density.Compact"
                        Data="CreditAgentPageList">
            <Columns>
                <RadzenDataGridColumn Property="FirstName" Title="First Name" />
                <RadzenDataGridColumn Property="LastName" Title="Last Name" />
                <RadzenDataGridColumn Property="Gender" Title="Gender" />
                <RadzenDataGridColumn Property="BranchName" Title="Branch Name" />
                <RadzenDataGridColumn Title="EmployeeId" Sortable="false">
                    <Template>
                        <RadzenButton Size="Radzen.ButtonSize.ExtraSmall"
                                      Click="@(()=>AddCreditAgent(context!.EmployeeId!.Value))"
                                      Variant="Variant.Text"
                                      Text="Make C.O"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Icon="person_add" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>


<RadzenStack Orientation="Orientation.Horizontal"
             AlignItems="AlignItems.Center"
             JustifyContent="JustifyContent.End">
    <RadzenButton Icon="cancel"
                  Click="CloseModal"
                  Text="Close" Size="Radzen.ButtonSize.Small"
                  Variant="Variant.Text"
                  ButtonStyle="ButtonStyle.Danger" />
</RadzenStack>
@code {
    protected IEnumerable<EntEmployeeDto> Employees { get; set; } = [];
    private LoanCreditAgentDtoCreate model = new LoanCreditAgentDtoCreate();
    private IEnumerable<VEmployeeCreateCreditAgent> CreditAgentPageList = [];
    private List<VEmployeeCreateCreditAgent> CreditAgents = [];
    [Parameter] public long Id { get; set; }
    [Parameter] public Func<bool, Task<bool>> onVildated { get; set; } = default!;
    [Parameter] public Func<bool, Task> OnSuccess { get; set; } = default!;
    [Inject] protected IEmployeeService EmployeeService { get; set; } = default!;
    [Inject] protected ICreditAgentServiceImpl CreditAgentService { get; set; } = default!;

    private bool isValid = true;
    private string? searchText = "";
    protected override async Task OnInitializedAsync()
    {
        await LoadPageList();
        await base.OnInitializedAsync();
    }
    async Task SearchCreditAgent()
    {
        await LoadPageList(searchText);
    }

    private async Task AddCreditAgent(long id)
    {
        try
        {
            var response = await CreditAgentService.AddCreditAgent(id, model);
            if (response!.IsSuccess)
            {
                if (onVildated is not null)
                {
                    isValid = await onVildated(response.IsSuccess);
                }
                if (!isValid) return;
                await OnSuccess(response.IsSuccess);

                await LoadPageList(searchText);
            }
            else
            {

            }
        }
        catch (Exception ex)
        {

        }

    }


    async Task LoadPageList(string? filter = null)
    {
        try
        {
            CreditAgentPageList = await CreditAgentService.GetEmployeeForCreateCreditAgents(filter);
        }
        catch (Exception ex)
        {

        }
    }



    async Task CloseModal()
    {
        await Task.CompletedTask;
    }


}
