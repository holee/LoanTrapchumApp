@page "/Employees/List"
@page "/Trapchum/Employees"
<PageTitle>Employees</PageTitle>
<SectionContent SectionName="Progressbar">
    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate"
                       ProgressBarStyle="ProgressBarStyle.Danger"
                       Visible="isLoading" Value="100" ShowValue="false" />
</SectionContent>
<Containers Fluid>
    <RadzenTabs @ref="tabs" RenderMode="TabRenderMode.Client" Change="TabChanged" @bind-SelectedIndex="selectedIndex">
        <Tabs>
            <RadzenTabsItem Text="Employees" Icon="group">
                <Card>
                    <CardBody>
                        <PageDropDown PageSizeChanged="PageSizeChanged"
                                      ShowReload="true"
                                      ShowSearchBox="true"
                                      OnTextChanged="PerformSearch"
                                      Reload="Reload">
                            <LeftChildContent>
                                <RadzenButton Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Click="AddNewTab"
                                              Text="Add Employee" />
                            </LeftChildContent>
                            <RightChildContent>
                                <div class="rz-p-1">
                                    <RadzenCheckBox @bind-Value="includeInActive"
                                                    @bind-Value:after="GetIncludeInactive"
                                                    Name="includeInActive" />
                                    <RadzenLabel Text="Include Inactive"
                                                 Component="includeInActive" Style="margin-left: 8px; vertical-align: middle;" />
                                </div>
                            </RightChildContent>
                        </PageDropDown>
                        <RadzenDataGrid Data="Employees"
                                        Responsive
                                        PageSize="@pageSize"
                                        AllowPaging="true"
                                        AllowSorting="true"
                                        GridLines="DataGridGridLines.Both"
                                        Density="Density.Compact"
                                        AllowAlternatingRows="true"
                                        AllowRowSelectOnRowClick="true"
                                        LoadData="@LoadData"
                                        @bind-Value="SelectedEmployees"
                                        Count="@counts"
                                        IsLoading="@isLoading"
                                        PagerPosition="PagerPosition.Bottom"
                                        RowRender="OnRowRender"
                                        ShowPagingSummary="true"
                                        Style="height:30rem;max-height:45rem;"
                                        PagerHorizontalAlign="HorizontalAlign.Right"
                                        TItem="VEmployees">
                            <Columns>
                                <RadzenDataGridColumn Title="#" Property="@nameof(VEmployees.EmployeeId)" />
                                <RadzenDataGridColumn Title="Name" Property="@nameof(VEmployees.AltName)" />
                                <RadzenDataGridColumn Title="Phone" Property="@nameof(VEmployees.Phone)" />
                                <RadzenDataGridColumn Title="Email" Property="@nameof(VEmployees.EmailAddress)" />
                                <RadzenDataGridColumn Title="Department" Property="@nameof(VEmployees.DepartmentName)" />
                                <RadzenDataGridColumn Title="Occupation" Property="@nameof(VEmployees.Occupation)" />
                                <RadzenDataGridColumn Title="Branch" Property="@nameof(VEmployees.BranchName)" />
                                <RadzenDataGridColumn Width="5rem" Sortable="false" Title="Status" Property="@nameof(VEmployees.EmployeeId)" Context="c">
                                    <Template>
                                        <RadzenCheckBox TValue="bool" @bind-Value="c.IsActive"
                                                        Name="chkStatus"
                                                        Change="@(()=> OnCheckChanged(c))" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Width="8rem" Sortable="false" Title="Action" Property="@nameof(VEmployees.EmployeeId)" Context="c">
                                    <Template>
                                        <RadzenButton Size="Radzen.ButtonSize.ExtraSmall"
                                                      Icon="more_vert"
                                                      Variant="Variant.Text"
                                                      Click="@((args)=>ShowContextMenuWithContent(args,c.EmployeeId))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    </CardBody>
                </Card>

            </RadzenTabsItem>
            <RadzenTabsItem Visible="IsEnableNew" Text="New Employee" Icon="person_add">
                <CreateEmployee Departments="Departments"
                                Branches="Branches"
                                Cities="Cities"
                                Countries="Countries"
                                Nationalities="Nationalities"
                                Occuptions="Occuptions"
                                Close="RemoveTab"
                                Reloaded="Reload"
                                Salutations="Salutations"
                                Provinces="Provinces" />
            </RadzenTabsItem>
            <RadzenTabsItem Visible="IsEnableEdit" Text="Edit Employee" Icon="edit">
                <Edit Nationalities="Nationalities"
                      Close="RemoveTab"
                      Reloaded="Reload"
                      Salutations="Salutations"
                      model="EmployeeEdit" />
            </RadzenTabsItem>
            <RadzenTabsItem Visible="IsEnableDetail" Text="Employee Details" Icon="info">
                <EmployeeDetails Model="Employee" Close="RemoveTab" />
            </RadzenTabsItem>

        </Tabs>
    </RadzenTabs>
</Containers>
@code {
    RadzenTabs tabs;
    List<TabItems> tabItems = [];
    string? filter = string.Empty;
    IList<VEmployees> SelectedEmployees = [];
    void OnRowRender(RowRenderEventArgs<VEmployees> e)
    {
        if (e.Data.IsActive)
        {
            e.Attributes.Add("style", "font-weight:bold;color:red;background-color:yellow;");
        }
    }
    bool IsEnableEdit = false;
    bool IsEnableNew = false;
    bool IsEnableDetail = false;
    [Parameter] public int selectedIndex { get; set; } = 0;
    EmployeeDto Employee = new();
    IEnumerable<ProvinceDto> Provinces = [];
    IEnumerable<string> Salutations = [];
    IEnumerable<BranchDto> Branches = [];
    IEnumerable<DepartmentDto> Departments = [];
    IEnumerable<Country> Countries = [];
    IEnumerable<Nationality> Nationalities = [];
    IEnumerable<StOcupationDto>? Occuptions = [];
    IEnumerable<string> Cities = [];
    EmployeeDtoUpdate EmployeeEdit = new();
    int pageSize = 10;
    int counts = 0;
    int pageIndex = 0;
    string sortField = "EmployeeId";
    bool sortDescending = false;
    void PageSizeChanged(int page)
    {
        pageSize = page;
    }


    async Task OnCheckChanged(VEmployees param)
    {
        var responseResult = await _employeeService!.UpdateIsActiveAsync(param.EmployeeId);

        if (!responseResult.IsSuccess)
        {
            var error = responseResult.Errors!.FirstOrDefault();
            NotificationService.Notify(NotificationSeverity.Error, error);
            return;
        }
        NotificationService.Notify(NotificationSeverity.Success, responseResult.Data!.Message);

        await GetEmployees(searchText);
    }

    async void AddNewTab()
    {

        IsEnableNew = true;
        selectedIndex = 1;
        StateHasChanged();
        await GetSalutations();
        tabs.Reload();
    }

    void ShowContextMenuWithContent(MouseEventArgs args, long id)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">
        <RadzenMenuItem Click="@(()=>AddDetailsTab(id))" Icon="info" Text="Details" Value="@id"></RadzenMenuItem>
        <RadzenMenuItem Click="@(()=>AddEditTab(id))" Icon="edit" Text="Edit" Value="@id"></RadzenMenuItem>
        <RadzenMenuItem Click="@(()=>Delete(id))" Icon="delete" Text="Delete" Value="@id"></RadzenMenuItem>
    </RadzenMenu>
    );
    }


    async void AddDetailsTab(long employeeId)
    {
        try
        {
            var updatedResponse = await _employeeService!.GetEmployeeById(employeeId);

            if (updatedResponse.IsSuccess)
            {
                Employee = updatedResponse.Data!;
                IsEnableDetail = true;
                selectedIndex = 3;
                StateHasChanged();
                ContextMenuService.Close();

                tabs.Reload();
            }
            else
            {
                var error = updatedResponse.Errors!.First();
                NotificationService.Notify(NotificationSeverity.Error, error);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, ex.Message);
        }
    }

    async Task AddEditTab(long employeeId)
    {
        var updatedResponse = await _employeeService.GetEmployeeForEdit(employeeId);
        StateHasChanged();

        IsEnableEdit = true;
        selectedIndex = 2;
        if (updatedResponse.IsSuccess)
        {
            EmployeeEdit = updatedResponse.Data!;
        }
        else
        {
            var error = updatedResponse.Errors!.First();
            NotificationService.Notify(NotificationSeverity.Error, error);
        }
        ContextMenuService.Close();

    }
    void TabChanged(int e)
    {
        selectedIndex = e;
        StateHasChanged();
    }
    void RemoveTab()
    {
        if (selectedIndex == 1)
        {
            IsEnableNew = false;
            selectedIndex = 0;
            tabs.Reload();
            return;

        }
        else if (selectedIndex == 2)
        {
            IsEnableEdit = false;
            selectedIndex = 0;

            tabs.Reload();
            return;

        }
        else if (selectedIndex == 3)
        {
            IsEnableDetail = false;
            selectedIndex = 0;

            tabs.Reload();
            return;

        }
        StateHasChanged();
    }

    async void GetIncludeInactive()
    {
        await GetEmployees(searchText);
    }
    private async Task GetSalutations()
    {
        var salutations = await _salutationService.GetSalutions();
        if (salutations.IsSuccess)
        {
            Salutations = salutations!.Data!.Select(x => x.Title!).ToList();
        }
        else
        {
            Salutations = [];
        }

    }

}

