<RadzenDataGrid Density="Density.Compact"
                TItem="CollateralLineDto"
                Responsive
                ColumnWidth="15rem"
                @ref="personalGrid"
                Style="--rz-grid-header-background-color:var(--rz-base-200)"
                EditMode="editMode"
                Data="Personals">
    <HeaderTemplate>
        <RadzenButton Size="Radzen.ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Primary"
                      Icon="add_circle"
                      Click="@InsertRow"
                      Text="Add" />
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Property="Id" Title="#" Width="2rem">
            <Template Context="c">
                <input type="hidden" @bind="c.Id" />
                <input type="hidden" @bind="c.CollateralRefId" />
                @(Personals.IndexOf(c) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="SubCategoryRefId" Title="Category">
            <Template Context="c">
                <RadzenDropDown TValue="int?"
                                class="w-100"
                                Data="CollateralPersonals"
                                TextProperty="CollateralSubTypeName"
                                ValueProperty="Id"
                                Style="height:2rem;line-height:1rem;"
                                @bind-Value="c.SubCategoryRefId">
                </RadzenDropDown>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="8rem"
                              Property="CollateralNo" Title="Collateral No">
            <Template Context="c">
                <RadzenTextBox class="w-100"
                               Style="height:2rem;line-height:2rem;"
                               @bind-Value="c.CollateralNo"></RadzenTextBox>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="OwnerName" Title="Owner Name">
            <Template Context="c">
                <RadzenTextBox class="w-100"
                               Style="height:2rem;line-height:2rem;"
                               @bind-Value="c.OwnerName"></RadzenTextBox>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="5rem" Property="Size" Title="Size">
            <Template Context="c">
                <RadzenTextBox class="w-100"
                               Style="height:2rem;line-height:2rem;"
                               @bind-Value="c.Size"></RadzenTextBox>
            </Template>
        </RadzenDataGridColumn>

        <RadzenDataGridColumn Width="6rem"
                              Property="Quantity" Title="Quantity">
            <Template Context="c">
                <RadzenNumeric ShowUpDown="false"
                               Min="0"
                               Placeholder="Qty"
                               class="w-100"
                               TextAlign="TextAlign.End"
                               Style="height:2rem;line-height:1rem;"
                               @bind-Value="c.Quantity" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="6rem"
                              Property="MarketPrice" Title="Market Price">
            <Template Context="c">
                <RadzenNumeric ShowUpDown="false"
                               Min="0"
                               Placeholder="Market Price"
                               class="w-100"
                               TextAlign="TextAlign.End"
                               Style="height:2rem;line-height:2rem;"
                               @bind-Value="c.MarketPrice" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="6rem" Property="HotPrice" Title="Hot Price">
            <Template Context="c">
                <RadzenNumeric @bind-Value="c.HotPrice"
                               Min="0"
                               class="w-100"
                               ShowUpDown="false"
                               Placeholder="Hot Price"
                               Style="height:2rem;line-height:2rem;"
                               TextAlign="TextAlign.End" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="6rem" Property="PawnPrice" Title="Hot Price">
            <Template Context="c">
                <RadzenNumeric ShowUpDown="false"
                               Min="0"
                               class="w-100"
                               Placeholder="Pawn Price"
                               @bind-Value="c.PawnPrice"
                               Style="height:2rem;line-height:2rem;"
                               TextAlign="TextAlign.End" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Width="4rem"
                              TextAlign="TextAlign.Center"
                              Context="c"
                              Property="Id" Title="Actions">
            <Template>
                <RadzenButton Icon="remove"
                              ButtonStyle="ButtonStyle.Danger"
                              Size="Radzen.ButtonSize.ExtraSmall">
                </RadzenButton>
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    [Parameter]
    public List<CollateralLineDto> Personals { get; set; } = [];
    [Parameter]
    public EventCallback<CollateralLineDto> ClickedSave{ get; set; }
    RadzenDataGrid<CollateralLineDto> personalGrid = default!;
    DataGridEditMode editMode = DataGridEditMode.Multiple;
    IEnumerable<CollateralSubTypeDto> CollateralPersonals { get; set; } = [];
    protected override async Task OnInitializedAsync()
    {
        CollateralPersonals = await _collateralService.GetCollateralSubTypes(3);
        await base.OnInitializedAsync();
    }

    void Reset()
    {
        Personals.Clear();
    }

    void Reset(CollateralLineDto order)
    {
        Personals.Remove(order);
    }

    void OnCreateRow(CollateralLineDto order)
    {
        Personals.Remove(order);
    }
    async Task InsertRow()
    {
        if (editMode == DataGridEditMode.Single)
        {
            Reset();
        }
        var order = new CollateralLineDto();
        Personals.Add(order);
        await personalGrid.InsertRow(order);
    }


}
