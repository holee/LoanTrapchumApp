<RadzenDataGrid GridLines="DataGridGridLines.Both"
                Responsive
                TItem="VCollateralLines"
                Density="Density.Compact"
                ColumnWidth="10rem"
                @ref="grid"
                @bind-Value="SelectedCollateralLines"
                SelectionMode="DataGridSelectionMode.Multiple"
                AllowRowSelectOnRowClick="@allowRowSelectOnRowClick"
                Style="--rz-grid-header-background-color:var(--rz-base-200);min-height:20rem;height:20rem;max-height:20rem;"
                Data="CollateralLines">
    <HeaderTemplate>
        <RadzenButton Size="Radzen.ButtonSize.Small"
                      Click="Add"
                      Icon="add"
                      Text="Add New"
                      ButtonStyle="ButtonStyle.Primary" />
    </HeaderTemplate>
    <Columns>
        <RadzenDataGridColumn Title="#"
                              TextAlign="TextAlign.Center"
                              Context="g"
                              Width="3rem"
                              Property="@(nameof(VCollateralLines.CollateralId))">
            <Template>
                @(CollateralLines.ToList().IndexOf(g) + 1)
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Title="#"
                              TextAlign="TextAlign.Center"
                              Context="g"
                              Width="3rem"
                              Property="@(nameof(VCollateralLines.CollateralId))">
            <HeaderTemplate>
                <RadzenCheckBox InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select item" }})"
                                Value="@HeaderChecked"
                                TValue="bool"
                                Change="@(args => SelectedCollateralLines = args == true ? CollateralLines!.ToList() : [])"
                                TriState="false" />
            </HeaderTemplate>
            <Template>
                <RadzenCheckBox InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select item" }})"
                                TriState="false"
                                Value="@(SelectedCollateralLines.Any() && SelectedCollateralLines.Contains(g))"
                                Change=@(args => { if(!allowRowSelectOnRowClick) { grid.SelectRow(g); }})
                                TValue="bool" />
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VCollateralLines.ReferenceNo))" Title="ReferenceNo" />
        <RadzenDataGridColumn Property="@(nameof(VCollateralLines.OwnerName))" Title="Owner" />
        <RadzenDataGridColumn Property="@(nameof(VCollateralLines.TypeName))" Title="Type" />
        <RadzenDataGridColumn Property="@(nameof(VCollateralLines.RegisterDate))" Title="Register Date" FormatString="{0:dd/MM/yyyy}" />
        <RadzenDataGridColumn Width="3rem" Title="Qty" Property="Quantity" Sortable="false" />
    </Columns>
</RadzenDataGrid>
<RadzenStack AlignItems="AlignItems.Center"
             Orientation="Orientation.Horizontal"
             class="my-2"
             JustifyContent="JustifyContent.End">
    <RadzenButton Size="Radzen.ButtonSize.ExtraSmall"
                  ButtonStyle="ButtonStyle.Success"
                  Icon="check"
                  Click="@(()=>DialogService.Close(SelectedCollateralLines))"
                  Text="Accept" />
    <RadzenButton Size="Radzen.ButtonSize.ExtraSmall"
                  ButtonStyle="ButtonStyle.Danger"
                  Icon="cancel"
                  Click="@(()=>DialogService.Close(SelectedCollateralLines))"
                  Text="Close" />
</RadzenStack>
@code {
    [Parameter]
    public long? CustomerId { get; set; } = 0;
    [Parameter]
    public IList<VCollateralLines> SelectedCollateralLines { get; set; } = [];
    IEnumerable<VCollateralLines> CollateralLines = [];
    bool allowRowSelectOnRowClick = true;
    RadzenDataGrid<VCollateralLines> grid = default!;
    protected override async Task OnInitializedAsync()
    {
        await GetCustomerCollaterals();
        await base.OnInitializedAsync();
    }

    bool HeaderChecked => !SelectedCollateralLines.Any() ? false : !CollateralLines.All(i => SelectedCollateralLines.Contains(i)) ? false : CollateralLines.Any(i => SelectedCollateralLines.Contains(i));

    async void Add()
    {
        if (CustomerId == 0)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Please selected customer first");
            return;
        }
        var parameters = new Dictionary<string, object?> {

            {"CustomerId", CustomerId }
        };

        var options = new DialogOptions
            {
                Width = "90vw",
                Draggable = true,
                Resizable = false
            };


        bool result = await DialogService.OpenAsync<CollateralModalAdd>("Add Collateral", parameters, options);

        if (bool.TryParse(result.ToString(), out bool success) && success)
        {
            await GetCustomerCollaterals();
        }
    }

    async Task GetCustomerCollaterals()
    {
        var resp = await _customerService.GetCustomerCollateralLineAsync(CustomerId);

        if (resp.IsSuccess)
        {
            CollateralLines = resp.Data!;
        }
        StateHasChanged();
    }
}
