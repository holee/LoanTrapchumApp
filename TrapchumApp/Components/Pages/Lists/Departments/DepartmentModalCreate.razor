<RadzenStack Gap="1rem" Orientation="Radzen.Orientation.Vertical" JustifyContent="Radzen.JustifyContent.SpaceBetween" Style="height: 100%;">
    <RadzenTemplateForm TItem="DepartmentDtoCreate" Data=@Req Submit=@Create>
        <RadzenStack>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenFormField Text="Department Name*" Variant="Variant.Flat" Style="width:100%">
                            <RadzenTextBox Name="DepartmentName" @bind-Value="Req.DepartmentName" Style="width:100%" />
                            <RadzenRequiredValidator Component="DepartmentName" Text="Department name is required" Style="position: absolute" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12">
                    <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
                        <RadzenFormField Text="Description" Variant="Variant.Flat" Style="width:100%;margin-top:10px">
                            <RadzenTextBox Name="Description" @bind-Value="Req.Description" Style="width:100%" />
                        </RadzenFormField>
                    </RadzenColumn>
                </RadzenColumn>

            </RadzenRow>
        </RadzenStack>
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" class="mt-2" 
        JustifyContent="Radzen.JustifyContent.End" Gap="0.5rem">
            <RadzenButton ButtonType="Radzen.ButtonType.Submit"
                          Text="Save"
                          Size="Radzen.ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Primary"
                          Icon="save"></RadzenButton>
            <RadzenButton Click="@((args) => DialogService!.Close(true))"
                          Variant="Variant.Flat"
                          Size="Radzen.ButtonSize.Small"
                          Text="Close"
                          Icon="cancel"
                          ButtonStyle="ButtonStyle.Secondary" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenStack>



