@using Applications.Enumerations
@using Applications.Requests.Lists.OtherNames
@using Domains.Models.Addresses
<RadzenFieldset AllowCollapse="true" Collapsed="false" class="rz-my-2">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
            <RadzenIcon Icon="home" /><strong>Address</strong>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="6">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Country</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDropDown class="w-100"
                                        Data="Countries"
                                        AllowFiltering="true"
                                        Placeholder="Search Countries"
                                        FilterOperator="StringFilterOperator.Contains"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        TextProperty="@nameof(Country.DesInKhmer)"
                                        ValueProperty="@nameof(Country.DesInKhmer)"
                                        @bind-Value="model.CountryName">
                        </RadzenDropDown>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Province</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDropDown class="w-100"
                                        Data="Provinces"
                                        Placeholder="Search Province"
                                        AllowFiltering="true"
                                        TextProperty="@nameof(ProvinceDto.ProInKhmer)"
                                        ValueProperty="@nameof(ProvinceDto.ProvinceId)"
                                        SelectedItemChanged="SelectedProvinceChanged"
                                        FilterOperator="StringFilterOperator.Contains"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        @bind-Value="model.ProvinceRefId">
                        </RadzenDropDown>
                    </RadzenColumn>
                </RadzenRow>

                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Commune</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDropDown class="w-100"
                                        Data="Communes"
                                        Placeholder="Search Commune"
                                        AllowFiltering="true"
                                        TextProperty="@nameof(CommuneDto.ComInKhmer)"
                                        ValueProperty="@nameof(CommuneDto.CommuneId)"
                                        SelectedItemChanged="SelectedCommuneChanged"
                                        FilterOperator="StringFilterOperator.Contains"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        @bind-Value="model.CommuneRefId">
                        </RadzenDropDown>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
            <RadzenColumn Size="6">
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="3">
                        <RadzenLabel>City</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDropDown class="w-100"
                                        Data="Cities"
                                        TValue="string"
                                        Placeholder="Search City"
                                        AllowFiltering="true"
                                        FilterOperator="StringFilterOperator.Contains"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        @bind-Value="model.City">
                            <HeaderTemplate>
                                <div class="rz-dropdown-filter-container">
                                    <input aria-label="Search" id="@Guid.NewGuid().ToString("N")"
                                           tabindex="0"
                                           placeholder="type to search..."
                                           class="rz-dropdown-filter rz-inputtext"
                                           autocomplete="Off"
                                           aria-autocomplete="none"
                                           autofocus="true"
                                           @bind="@searchText"
                                           @oninput="@OnSearchTextChanged"
                                           @onkeypress="@OnKeyPress"
                                           type="search">
                                    <span class="notranslate rz-dropdown-filter-icon rzi rzi-search"></span>
                                </div>
                            </HeaderTemplate>
                        </RadzenDropDown>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="3">
                        <RadzenLabel>District</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDropDown class="w-100"
                                        Data="Districts"
                                        Placeholder="Search District"
                                        AllowFiltering="true"
                                        TextProperty="@nameof(DistrictDto.DisInKhmer)"
                                        ValueProperty="@nameof(DistrictDto.DistrictId)"
                                        SelectedItemChanged="SelectedDistrictChanged"
                                        FilterOperator="StringFilterOperator.Contains"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        @bind-Value="model.DistrictRefId">
                        </RadzenDropDown>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                    <RadzenColumn Size="3">
                        <RadzenLabel>Village</RadzenLabel>
                    </RadzenColumn>
                    <RadzenColumn Size="9">
                        <RadzenDropDown class="w-100"
                                        Data="Villages"
                                        Placeholder="Search Village"
                                        AllowFiltering="true"
                                        TextProperty="@nameof(VillageDto.VilInKhmer)"
                                        ValueProperty="@nameof(VillageDto.VillageId)"
                                        SelectedItemChanged="SelectedVillageChanged"
                                        FilterOperator="StringFilterOperator.Contains"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        @bind-Value="model.VillageRefId"></RadzenDropDown>
                    </RadzenColumn>
                </RadzenRow>
            </RadzenColumn>
        </RadzenRow>
    </ChildContent>
</RadzenFieldset>

