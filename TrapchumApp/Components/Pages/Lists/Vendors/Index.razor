@page "/Vendors"
@page "/trapchum/vendors"
@using TCLMS.Shared.Entities.Dtos.Lists.Vendors
@using TCLMS.Shared.Entities.ViewModels.Vendors
@using TCLMS.Shared.Entities.Dtos.Lists.OtherNames
<PageTitle>Vendors</PageTitle>
<RadzenTabs @bind-SelectedIndex=@selectedIndex @ref="tabs" RenderMode="TabRenderMode.Client">
    <Tabs>
        <RadzenTabsItem Text="Vendors" Icon="list">
            <BCard>
                <CardHeader>
                    <RadzenStack AlignItems="AlignItems.Center"
                                 Orientation="Orientation.Horizontal"
                                 JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenButton Icon="add"
                                      Size="Radzen.ButtonSize.Small"
                                      Text="Vendor"
                                      Click="AddTabOtherName"
                                      ButtonStyle="ButtonStyle.Primary" />
                        <div>
                            <RadzenCheckBox TValue="bool" @bind-Value=@includeInactive Change="ex=>IncludeInActiveChanged(ex)" Name="CheckBox1" />
                            <RadzenLabel Text="Include InActive" Component="CheckBox1" Style="margin-left: 8px; vertical-align: middle;" />
                        </div>
                    </RadzenStack>
                </CardHeader>
                <CardBody>
                    <RadzenStack Style="margin-bottom:10px"
                                 JustifyContent="Radzen.JustifyContent.SpaceBetween"
                                 Orientation="Radzen.Orientation.Horizontal"
                                 Wrap="Radzen.FlexWrap.Wrap">
                        <PageDropDown PageSizeChanged="PageSizeChanged"
                                      Reload="Reload"
                                      ShowReload="true" />
                        <RadzenStack Style="width:25%" JustifyContent="Radzen.JustifyContent.End">
                            <RadzenFormField AllowFloatingLabel="false">
                                <Start>
                                    <RadzenIcon Icon="search" />
                                </Start>
                                <ChildContent>
                                    <RadzenTextBox Style="width:100%;height:33px;font-size:13px"
                                                   Placeholder="Search here..."
                                                   @bind-Value="q"
                                                   @oninput="OnSearch" />
                                </ChildContent>
                            </RadzenFormField>
                        </RadzenStack>
                    </RadzenStack>
                    <RadzenDataGrid TItem="VVendor"
                                    Density="Density.Compact"
                                    Responsive
                                    Count="@counts"
                                    Style="--rz-grid-header-background-color:var(--rz-base-200);height:30rem;min-height:30rem;max-height:45rem;"
                                    PageSize="@pageSize"
                                    LoadData="@LoadData"
                                    ColumnWidth="15rem"
                                    AllowPaging="true"
                                    PagerHorizontalAlign="HorizontalAlign.Right"
                                    ShowPagingSummary="true"
                                    AllowSorting="true"
                                    IsLoading="@isLoading"
                                    Data="Vendors">
                        <Columns>
                            <RadzenDataGridColumn Width="10rem" Title="Name" Property="@(nameof(VVendor.AltName))" />
                            <RadzenDataGridColumn Width="6rem" Title="Gender" Property="@(nameof(VVendor.Sex))" />
                            <RadzenDataGridColumn Sortable="false" Width="8rem" Title="Phone" Property="@(nameof(VVendor.Phone))" />
                            <RadzenDataGridColumn Sortable="false" Width="15rem" Title="Email" Property="@(nameof(VVendor.EmailAddress))" />
                            <RadzenDataGridColumn Sortable="false" Title="Address" Property="@(nameof(VVendor.Description))" Context="v">
                                <Template>
                                    @v.ToString()
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Sortable="false"
                                                  Width="6rem"
                                                  Title="Status" Property="@(nameof(VVendor.EntId))" Context="v">
                                <Template>
                                    <RadzenCheckBox TValue="bool"
                                                    Change="@((arg)=>DeactiveOrActive(arg,v))"
                                                    @bind-Value="v.IsActive" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Width="8rem" Sortable="false" Title="Actions" Property="@(nameof(VVendor.EntId))" Context="v">
                                <Template>
                                    <RadzenButton Size="Radzen.ButtonSize.ExtraSmall"
                                                  Icon="more_vert"
                                                  Variant="Variant.Text"
                                                  Click="@((args)=>ShowContextMenuWithContent(args,v))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </CardBody>
            </BCard>
        </RadzenTabsItem>
        <RadzenTabsItem Visible="IsEnableNew" Text="New" Icon="add">
            <VendorCreate SelectIndex="CloseTabs"
                          ProvinceList="@ProvinceList" />
        </RadzenTabsItem>
        <RadzenTabsItem Visible="IsEnableEdit" Text="Edit" Icon="edit">
            <VendorEdit ProvinceList="@ProvinceList"
                        Id="@vendorId"
                        SelectIndex="CloseTabs" />
        </RadzenTabsItem>
        <RadzenTabsItem Visible="IsEnableDetail" Text="Details">
            <NameDetailModal SelectIndex="CloseTabs" model="OtherNames" />
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    [Parameter] public int selectedIndex { get; set; } = 0;
    RadzenTabs? tabs;
    bool IsEnableEdit = false;
    bool IsEnableNew = false;
    bool IsEnableDetail = false;
    string? q;
    long NameId { get; set; }
    IEnumerable<ProvinceDto>? ProvinceList = [];
    EntNameDtoUpdate? model = new();
    IEnumerable<CommuneDto>? CommuneList = [];
    IEnumerable<DistrictDto>? DistrictList = [];
    IEnumerable<VillageDto>? VillageList = [];
    EntNameDto? OtherNames = new();
    ProvinceDto? SelectedProvince;
    DistrictDto? SelectedDistrict;
    CommuneDto? SelectedCommune;
    VillageDto? SelectedVillage;
    IEnumerable<VVendor> Vendors = [];
    int pageIndex = 0;
    int pageSize = 10;
    int counts = 0;
    string sortField = "EntId";
    bool sortDescending = false;
    bool includeInactive = false;
    bool isLoading = false;
    long vendorId = 0;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            await GetVendors();
            ProvinceList = await _addressService!.GetAllProvinceAsync();
        }
        catch (Exception ex)
        {
            await DialogService.Alert(ex.Message, "Exception");
        }
        await base.OnInitializedAsync();

    }


    protected async Task OnSearch(ChangeEventArgs e)
    {
        q = e.Value!.ToString();
        await GetVendors(q);
    }

    async Task PageSizeChanged(int page)
    {
        pageSize = page;
        await GetVendors(q);
    }

    async Task GetVendors(string? filterText = "")
    {

        isLoading = true;

        var param = new QueryParam(pageIndex, pageSize, sortField, sortDescending, includeInactive, filterText);

        var resp = await _vendorService.GetVendorsAsync(param);

        if (resp.IsSuccess)
        {
            counts = resp.Data!.Count;
            Vendors = resp.Data!.Items;
        }

        isLoading = false;

        StateHasChanged();
    }

    async Task LoadData(LoadDataArgs e)
    {
        q = e.Filter ?? string.Empty;
        pageIndex = e.Skip!.Value;
        if (!string.IsNullOrEmpty(e.OrderBy))
        {
            sortField = e.OrderBy.Split(" ")[0];
            string dir = e.OrderBy.Split(" ")[1];
            sortDescending = dir.Contains("asc") ? false : true;
        }
        await GetVendors(q);

    }
    void ShowEdit(long id)
    {
        NavigationManager.NavigateTo($"/trapchum/vendors/{id}/edit");
    }

    void SelectedId(long id)
    {
        vendorId = id;
    }

    protected async Task DisplayDetail(long e)
    {
        if (e != 0)
        {
            try
            {
                OtherNames = await _otherNameService!.GetByIdAsync(e);
                IsEnableDetail = true;
                selectedIndex = 3;
                await InvokeAsync(StateHasChanged);
                ContextMenuService.Close();

            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Exception", ex.Message);
            }

        }
    }
    async Task OnDelete(long id)
    {
        ContextMenuService.Close();
        var confirm = (bool)await DialogService.Confirm("Other Name deleted will not be able to recover, would you like to continue?", "Delete Other Name",
    new Radzen.ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
        if (!confirm)
        {
            return;
        }
        var result = await _otherNameService!.DeleteAsync(id);
        if (result.IsSuccess)
        {
            NotificationService.Notify(Radzen.NotificationSeverity.Success, "Delete Other Name", "Other Name was deleted successful!");
            await GetVendors(q);
        }

    }
    protected async Task IncludeInActiveChanged(bool e)
    {
        includeInactive = e;
        await GetVendors(q);
    }
    protected async Task Reload()
    {
        await GetVendors(q);
    }

    void ShowContextMenuWithContent(MouseEventArgs args, VVendor e)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">
        <RadzenMenuItem Click="@(()=>DisplayDetail(e.EntId))" Icon="info" Text="Details" Value="@e.EntId"></RadzenMenuItem>
        <RadzenMenuItem Click="@(()=>ShowEdit(e.EntId))" Icon="edit" Text="Edit" Value="@e.EntId"></RadzenMenuItem>
        <RadzenMenuItem Click="@(()=>OnDelete(e.EntId))" Icon="delete" Text="Delete" Value="@e.EntId"></RadzenMenuItem>
    </RadzenMenu>
    );
    }


    void AddTabOtherName()
    {
        IsEnableNew = true;
        selectedIndex = 1;
        StateHasChanged();
    }
    async void CloseTabs(int e)
    {
        if (selectedIndex == 1)
        {
            IsEnableNew = false;
            selectedIndex = 0;

            await OnInitializedAsync();
        }
        else if (selectedIndex == 2)
        {
            IsEnableEdit = false;
            selectedIndex = 0;

            await OnInitializedAsync();
        }
        else if (selectedIndex == 3)
        {
            IsEnableDetail = false;
            selectedIndex = 0;

        }
        StateHasChanged();
    }

    protected async Task DeactiveOrActive(bool arg, VVendor e)
    {
        var entVendor = new EntVendorDtoChangeStatus
            {
                VendorId = e.EntId,
                EditSeq = e.EditSeq,
                IsActive = arg
            };
        var response = await _vendorService.ChangeVendorStatus(entVendor);
        if (response.IsSuccess)
        {
            NotificationService.Notify(NotificationSeverity.Success, "", response.Data!.Message);
            await GetVendors(q);
        }
        else
        {
            await IncludeInActiveChanged(false);
            NotificationService.Notify(NotificationSeverity.Warning, "", "Changing status failded!");
        }
    }
}