@using TCLMS.Shared.Entities.Dtos.Lists.OtherNames

<EditForm Model="model" OnValidSubmit="HandleFormSubmit">
    <BCard BodyCssClass="rz-background-color-base-200" HeaderCssClass="bg-primary">
        <CardHeader>
            <span>Informations</span>
        </CardHeader>
        <CardBody>
            <div class="row">
                <div class="col-md-3 text-md-end">
                    <RadzenLabel>Khmer Name</RadzenLabel>
                </div>
                <div class="col-md-9">
                    <RadzenTextBox @bind-Value="model.AltName"
                                   Style="width:100%;height:33px;font-size:14px"
                                   Placeholder="ញ្ឈ្មោះជាខ្មែរ..."
                                   Name="AltName" />
                </div>
                <div class="col-md-3 text-md-end mt-3">
                    <RadzenLabel>Name <span class="text-danger">*</span></RadzenLabel>
                </div>
                <div class="col-md-9 mt-3">
                    <RadzenTextBox @bind-Value="model.Name"
                                   Style="width:100%;height:33px;font-size:14px"
                                   AutoComplete="true"
                                   Placeholder="Enter Eng-Name or FullName"
                                   Name="Name" />
                    <ValidationMessage For="@(()=>model.Name)"></ValidationMessage>
                </div>
                <div class="col-md-3 text-md-end mt-3">
                    <RadzenLabel>Record Status</RadzenLabel>
                </div>
                <div class="col-md-9 mt-3">
                    <RadzenCheckBox @bind-Value=@model.IsActive Name="CheckBox1" />
                    <RadzenLabel Text="Is Active" Component="CheckBox1" Style="margin-left: 8px; vertical-align: middle;" />
                </div>
            </div>
            <div class="row">

                <div class="col-md-3 text-md-end mt-3">
                    <RadzenLabel>First Name</RadzenLabel>
                </div>
                <div class="col-md-5 mt-3">
                    <RadzenTextBox @bind-Value="model.FirstName"
                                   Style="width:100%;height:33px;font-size:14px"
                                   Placeholder="Enter First Name"
                                   Name="FirstName" />
                </div>
                <div class="col-md-4 mt-3">
                    <RadzenTextBox @bind-Value="model.MiddleName"
                                   Style="width:100%;height:33px;font-size:14px"
                                   Placeholder="Enter Middle Name(Optional)"
                                   Name="MiddleName" />
                </div>
                <div class="col-md-3 text-md-end mt-3">
                    <RadzenLabel>Last Name</RadzenLabel>
                </div>
                <div class="col-md-9 mt-3">
                    <RadzenTextBox @bind-Value="model.LastName"
                                   Style="width:100%;height:33px;font-size:14px"
                                   Placeholder="Enter Last Name"
                                   Name="LastName" />
                </div>
                <div class="col-md-3 text-md-end mt-3">
                    <RadzenLabel>Salutation</RadzenLabel>
                </div>
                <div class="col-md-9 mt-3">
                    <RadzenDropDown @bind-Value="model.Sex"
                                    Chips="true"
                                    Name="DropDownSalutions"
                                    Style="width:100%;height:35px;font-size:14px"
                                    TValue="string"
                                    Placeholder="Salutation"
                                    Data="Salutations">
                        <ValueTemplate Context="s">
                            <RadzenTextBox @bind-Value="model.Sex"
                                           @onkeydown="AddNewSalutation"
                                           @oninput="OnTextChangedSalution"
                                           Style="width:120%;height:35px;font-size:14px;margin:-15px"
                                           aria-labelledby="DropDownEditLabel" />
                        </ValueTemplate>
                    </RadzenDropDown>

                </div>

                <div class="col-md-3 text-md-end mt-3">
                    <RadzenLabel>Contact Number</RadzenLabel>
                </div>
                <div class="col-md-5 mt-3">
                    <RadzenTextBox @bind-Value="model.Phone"
                                   Style="width:100%;height:33px;font-size:14px"
                                   Placeholder="Enter Phone Number"
                                   Name="Phone" />
                </div>
                <div class="col-md-4 mt-3">
                    <RadzenTextBox @bind-Value="model.AltPhone"
                                   Style="width:100%;height:33px;font-size:14px"
                                   Placeholder="Enter Alt Phone Number"
                                   Name="AltPhone" />
                </div>
                <div class="col-md-3 text-md-end mt-3">
                    <RadzenLabel>Contact Email</RadzenLabel>
                </div>
                <div class="col-md-9 mt-3">
                    <RadzenTextBox @bind-Value="model.EmailAddress"
                                   Style="width:100%;height:33px;font-size:14px"
                                   Placeholder="Enter Email"
                                   Name="Email" />
                </div>
                <div class="col-md-3 text-md-end mt-3">
                    <RadzenLabel>Description</RadzenLabel>
                </div>
                <div class="col-md-9 mt-3">
                    <RadzenTextArea @bind-Value="model.Description"
                                    Style="width:100%;font-size:14px"
                                    Placeholder="Enter Description"
                                    Name="Description" />
                </div>

            </div>
        </CardBody>
    </BCard>
    <BCard BodyCssClass="rz-background-color-base-200" HeaderCssClass="bg-primary">
        <CardHeader>
            Address
        </CardHeader>
        <CardBody>
            <div class="row">
                <div class="col-md-3 text-md-end mt-3">
                    <RadzenLabel>Province</RadzenLabel>
                </div>
                <div class="col-md-9 mt-3">
                    <RadzenDropDown FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    FilterOperator="StringFilterOperator.Contains"
                                    AllowFiltering="true"
                                    Data=@ProvinceList AllowClear="true"
                                    TextProperty="ProInKhmer"
                                    TValue="ProvinceDto"
                                    ValueChanged="x=>SelectProvince(x)"
                                    Style="width: 100%;height:33px;font-size:14px"
                                    Value="SelectedProvince"
                                    Name="DropDownFiltering2"
                                    Placeholder="Select province">

                    </RadzenDropDown>
                </div>
                <div class="col-md-3 text-md-end mt-3">
                    <RadzenLabel>District</RadzenLabel>
                </div>
                <div class="col-md-9 mt-3">
                    <RadzenDropDown FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    FilterOperator="StringFilterOperator.Contains"
                                    AllowFiltering="true"
                                    Data=@DistrictList AllowClear="true"
                                    TextProperty="DisInKhmer"
                                    TValue="DistrictDto"
                                    ValueChanged="x=>SelectDistrict(x)"
                                    Style="width: 100%;height:33px;font-size:14px"
                                    Value="SelectedDistrict"
                                    Name="DropDownFiltering3"
                                    Placeholder="Select district">

                    </RadzenDropDown>
                </div>
                <div class="col-md-3 text-md-end mt-3">
                    <RadzenLabel>Commune</RadzenLabel>
                </div>
                <div class="col-md-9 mt-3">
                    <RadzenDropDown FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    FilterOperator="StringFilterOperator.Contains"
                                    AllowFiltering="true"
                                    Data=@CommuneList AllowClear="true"
                                    TextProperty="ComInKhmer"
                                    TValue="CommuneDto"
                                    ValueChanged="x=>SelectCommune(x)"
                                    Style="width: 100%;height:33px;font-size:14px"
                                    Value="SelectedCommune"
                                    Name="DropDownFiltering4"
                                    Placeholder="Select commune">

                    </RadzenDropDown>
                </div>
                <div class="col-md-3 text-md-end mt-3">
                    <RadzenLabel>Village</RadzenLabel>
                </div>
                <div class="col-md-9 mt-3">
                    <RadzenDropDown FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    FilterOperator="StringFilterOperator.Contains"
                                    AllowFiltering="true"
                                    Data=@VillageList AllowClear="true"
                                    TextProperty="VilInKhmer"
                                    TValue="VillageDto"
                                    Style="width: 100%;height:33px;font-size:14px"
                                    Value="SelectedVillage"
                                    ValueChanged="x=>SelectVillage(x)"
                                    Name="DropDownFiltering5"
                                    Placeholder="Select village">

                    </RadzenDropDown>
                </div>
            </div>
        </CardBody>
    </BCard>
    <RadzenStack AlignItems="AlignItems.Center"
                 Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End">
        <RadzenButton ButtonStyle="ButtonStyle.Success"
                      Size="Radzen.ButtonSize.Small"
                      Icon="save"
                      ButtonType="Radzen.ButtonType.Submit"
                      Text="Save" />
        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                      Size="Radzen.ButtonSize.Small"
                      Icon="cancel"
                      ButtonType="Radzen.ButtonType.Button"
                      Click="SelectedIndex"
                      Text="Cancel" />
    </RadzenStack>
</EditForm>
@code {
    [Parameter] public EventCallback<int> SelectIndex { get; set; }
    [Parameter] public IEnumerable<ProvinceDto>? ProvinceList { get; set; }
    EntNameDtoCreate model = new EntNameDtoCreate();
    CustomValidation? customValidation;
    IEnumerable<CommuneDto>? CommuneList = [];
    IEnumerable<DistrictDto>? DistrictList = [];
    IEnumerable<VillageDto>? VillageList = [];
    ProvinceDto? SelectedProvince { get; set; }
    DistrictDto? SelectedDistrict { get; set; }
    CommuneDto? SelectedCommune { get; set; }
    VillageDto? SelectedVillage { get; set; }
    IEnumerable<string> Salutations = [];
    private bool isValid = true;
    //protected List<string> salutations = ["Mr.", "Mrs.", "Miss.", "Others"];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            model.Sex = "Mr";
        }
        catch (Exception ex)
        {
            NotificationService.Notify(Radzen.NotificationSeverity.Error, "Exception", ex.Message);


        }

        await base.OnInitializedAsync();
    }
    protected async void SelectedIndex()
    {
        await SelectIndex.InvokeAsync(0);
    }

    void SetFirstName()
    {
        model.FirstName = model.Name;
    }

    private async Task GetSalutations()
    {
        var salutations = await _salutationService.GetSalutions();
        if (salutations.IsSuccess)
        {
            Salutations = salutations!.Data!.Select(x => x.Title!).ToList();
        }
        else
        {
            Salutations = [];
        }

    }

    protected async Task HandleFormSubmit()
    {
        try
        {
            model.EntType = EntityTypes.Vendor.ToString();
            model.CountryName = "Cambodia";
            model.City = SelectedProvince?.ProDescription;
            model.ProvinceRefId = SelectedProvince?.ProvinceID;
            model.ProDescription = SelectedProvince?.ProDescription;
            model.ProInKhmer = SelectedProvince?.ProInKhmer;
            model.DistrictRefId = SelectedDistrict?.DistrictId;
            model.DisDescription = SelectedDistrict?.DisDescription;
            model.DisInKhmer = SelectedDistrict?.DisInKhmer;
            model.CommuneRefId = SelectedCommune?.CommuneId;
            model.ComDescription = SelectedCommune?.ComDescription;
            model.ComInKhmer = SelectedCommune?.ComInKhmer;
            model.VillageRefId = SelectedVillage?.VillageId;
            model.VillDescription = SelectedVillage?.VillDescription;
            model.VilInKhmer = SelectedVillage?.VilInKhmer;
            var message = await _vendorService!.CreateAsync(model);
            if (message.IsSuccess)
            {
                NotificationService.Notify(Radzen.NotificationSeverity.Success, "Other Name", "Other Name created successfully!");
                model = new();
                return;
            }
            else
            {
                NotificationService.Notify(Radzen.NotificationSeverity.Error, "Other Name", "Other Name create failed");

            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(Radzen.NotificationSeverity.Error, "Exception", ex.Message);
        }

    }

    async void SelectProvince(ProvinceDto e)
    {
        SelectedProvince = e;
        if (SelectedProvince is not null)
        {
            DistrictList = await _addressService!.GetDistrictByProvinceAsync(SelectedProvince.ProvinceID);
        }
        else
        {
            SelectedProvince = null;
            DistrictList = null;
        }
        StateHasChanged();

    }
    async Task SelectDistrict(DistrictDto e)
    {
        if (e is not null)
        {
            SelectedDistrict = e;
            CommuneList = await _addressService!.GetCommuneByDistricteAsync(SelectedDistrict.DistrictId);
        }
        else
        {
            SelectedDistrict = null;
            CommuneList = null;
        }
        StateHasChanged();
    }
    async Task SelectCommune(CommuneDto e)
    {
        if (e is not null)
        {
            SelectedCommune = e;
            VillageList = await _addressService!.GetVillageByCommuneAsync(SelectedCommune.CommuneId);
        }
        else
        {
            SelectedCommune = null;
            VillageList = null;
        }
        StateHasChanged();
    }
    void SelectVillage(VillageDto e)
    {
        if (e is not null)
        {
            SelectedVillage = e;

        }
        else
        {
            SelectedVillage = null;
        }
        StateHasChanged();
    }

    protected string? newSalution = "";

    protected async Task AddNewSalutation(KeyboardEventArgs e)
    {
        if (e.Code == "Enter")
        {
            await _salutationService.AddSalution(new Salutation
                {
                    Title = newSalution
                });
            await GetSalutations();
        }
    }
    protected void OnTextChangedSalution(ChangeEventArgs e)
    {
        newSalution = e?.Value?.ToString();
    }


}