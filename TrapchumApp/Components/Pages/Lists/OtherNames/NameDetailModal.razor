@using TCLMS.Shared.Entities.Dtos.Lists.OtherNames
<div class="card">
    <div class="card-header bg-primary">
        <div class="d-flex justify-content-between">
            <span>Name Details: @model!.Sex @model?.Name <span><RadzenCheckBox @bind-Value="model.IsActive" /></span></span>
            <strong @onclick="SelectedIndex" class="text-danger" style="cursor:pointer">X</strong>
        </div>
    </div>
    <div class="card-body">
        <div>
            <div class="table-responsive">
                <table class="table">
                    <tbody>
                        <tr>
                            <th class="w-25 rz-background-color-base-100">Alternative Name</th>
                            <td>
                                @model!.AltName
                            </td>
                        </tr>
                        <tr>
                            <th class="w-25 rz-background-color-base-100">First Name</th>
                            <td>
                                @model.FirstName
                            </td>
                        </tr>
                        <tr>
                            <th class="w-25 rz-background-color-base-100">Last Name</th>
                            <td>
                                @model.LastName
                            </td>
                        </tr>
                        <tr>
                            <th class="w-25 rz-background-color-base-100">Phone</th>
                            <td>
                                @model.Phone / @model.AltPhone (Alt Phone)
                            </td>
                        </tr>
                        <tr>
                            <th class="w-25 rz-background-color-base-100">Email</th>
                            <td>
                                @model.EmailAddress
                            </td>
                        </tr>
                        <tr>
                            <th class="w-25 rz-background-color-base-100">Note</th>
                            <td>
                                @model.Description
                            </td>
                        </tr>

                        <tr>
                            <th class="w-25 rz-background-color-base-100">Address In Khmer</th>
                            <td>
                                @model?.ProInKhmer @model?.DisInKhmer @model?.ComInKhmer @model?.VilInKhmer
                            </td>
                        </tr>
                        <tr>
                            <th class="w-25 rz-background-color-base-100">Address In English</th>
                            <td>
                                @model?.ProDescription @model?.DisDescription @model?.ComDescription @model?.VillDescription
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card-footer ">
        <div class="d-flex justify-content-between">
            <div>
                <label class="text-muted">Created: @string.Format("{0:dd MMM yyyy hh:mm tt}", model?.CreatedDT) Modified: @string.Format("{0:dd MMM yyyy hh:mm tt}", model?.ModifiedDT)</label>
            </div>
            <div>
                <TButton Click="SelectedIndex"
                         Text="Close"
                         Icon="BtnIconType.Close"
                         Size="BtnSize.Small"
                         Color="Kalor.Danger" />
            </div>
        </div>


    </div>
</div>

@code {
    [Parameter] public EntNameDto? model { get; set; }
    [Parameter]
    public EventCallback<int> SelectIndex { get; set; }

    protected async Task SelectedIndex()
    {
        await SelectIndex.InvokeAsync(0);
    }
}

