@using Applications.Requests.Lists.OtherNames
<RadzenFieldset AllowCollapse="false" Collapsed="false">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
            <RadzenIcon Icon="account_box" /><b>General</b>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
            <RadzenColumn Size="2">
                <RadzenLabel>Status</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="10">
                <RadzenCheckBox @bind-Value=@model.IsActive Name="CheckBox1" />
                <RadzenLabel Text="@(model.IsActive==true? "Active" : "Is InActive")" Component="CheckBox1" Style="margin-left: 8px; vertical-align: middle;" />
            </RadzenColumn>
            <RadzenColumn Size="2">
                <RadzenLabel>Khmer Name</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="10">
                <RadzenTextBox @bind-Value="model.AltName"
                               Style="width:100%;height:33px;font-size:14px"
                               Placeholder="ញ្ឈ្មោះជាខ្មែរ..."
                               Name="AltName" />
            </RadzenColumn>
            <RadzenColumn Size="2">
                <RadzenLabel>Name <span class="text-danger">*</span></RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="10">
                <RadzenTextBox @bind-Value="model.Name"
                               Style="width:100%;height:33px;font-size:14px"
                               AutoComplete="true"
                               Placeholder="Enter Eng-Name or FullName"
                               Name="Name" />
                <ValidationMessage For="@(()=>model.Name)"></ValidationMessage>
            </RadzenColumn>
        </RadzenRow>
    </ChildContent>
</RadzenFieldset>

<RadzenFieldset AllowCollapse="true" Collapsed="false">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
            <RadzenIcon Icon="account_box" /><b>Personal Informations</b>
        </RadzenStack>
    </HeaderTemplate>
    <ChildContent>
        <RadzenRow AlignItems="AlignItems.Center">
            <RadzenColumn Size="2">
                <RadzenLabel>Full Name</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="2">
                <RadzenDropDown @bind-Value="model.Gender"
                                Chips="false"
                                Name="DropDownSalutions"
                                TValue="string"
                                Placeholder="Salutation"
                                Data="Salutations">
                </RadzenDropDown>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenTextBox @bind-Value="model.FirstName"
                               Style="width:100%;height:33px;font-size:14px"
                               Placeholder="First Name"
                               Name="FirstName" />
            </RadzenColumn>
            <RadzenColumn Size="2">
                <RadzenTextBox @bind-Value="model.MiddleName"
                               Style="width:100%;height:33px;font-size:14px"
                               Placeholder="Middle Name(Optional)"
                               Name="MiddleName" />
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenTextBox @bind-Value="model.LastName"
                               Style="width:100%;height:33px;font-size:14px"
                               Placeholder="Last Name"
                               Name="LastName" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
            <RadzenColumn Size="2">
                <RadzenLabel>Contact Number</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenTextBox @bind-Value="model.Phone"
                               Style="width:100%;height:33px;font-size:14px"
                               Placeholder="Phone Number"
                               Name="Phone" />
            </RadzenColumn>
            <RadzenColumn Size="3">
                <RadzenTextBox @bind-Value="model.AltPhone"
                               Style="width:100%;height:33px;font-size:14px"
                               Placeholder="Alt Phone Number"
                               Name="AltPhone" />
            </RadzenColumn>
            <RadzenColumn Size="4">
                <RadzenTextBox @bind-Value="model.EmailAddress"
                               Style="width:100%;height:33px;font-size:14px"
                               Placeholder="Email"
                               Name="Email" />
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
            <RadzenColumn Size="2">
                <RadzenLabel>Description</RadzenLabel>
            </RadzenColumn>
            <RadzenColumn Size="10">
                <RadzenTextArea @bind-Value="model.Description"
                                Style="width:100%;font-size:14px"
                                Placeholder="Description"
                                Name="Description" />
            </RadzenColumn>
        </RadzenRow>
    </ChildContent>
</RadzenFieldset>

@code {
    [Parameter] public EntityNamesCreate model { get; set; } = new();
    List<string> Salutations = ["Mr.", "Mrs.", "Miss.", "Others"];
}
