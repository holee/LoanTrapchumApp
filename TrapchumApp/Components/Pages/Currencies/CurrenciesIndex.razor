@page "/App/Currencies"
@using Applications.Responses.Paginations
@using Applications.Responses.ViewModels.Currencies
@using TrapchumApp.Components.Pages.Transactions.Exchanges
<PageTitle>Currency List</PageTitle>
<RadzenCard class="card rz-background-color-base-100">
    <RadzenTabs>
        <Tabs>
            <RadzenTabsItem Text="Currencies List" Icon="attach_money">
                <RadzenDataGrid Responsive
                                GridLines="DataGridGridLines.Horizontal"
                                AllowAlternatingRows="true"
                                Style="height:30rem;min-height:30rem;max-height:auto;"
                                Density="Density.Compact"
                                AllowSorting="false"
                                Data="Currencies">
                    <Columns>
                        <RadzenDataGridColumn Title="#" Context="item">
                            <Template>
                                @(Currencies?.IndexOf(item) + 1)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Currency Name" Context="item">
                            <Template>
                                @item.CurrencyName
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Currency Code" Context="item">
                            <Template>
                                @item.CurrencyCode
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Spot Rate" Context="item" TextAlign="TextAlign.Right">
                            <Template>
                                @item.SpotRate
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Buying Rate" Context="item" TextAlign="TextAlign.Right">
                            <Template>
                                @item.BuyingRate
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="SellingRate"
                                              Title="Selling Rate"
                                              TextAlign="TextAlign.Right"
                                              Context="item">
                            <Template>
                                @item.SellingRate
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Base Currency"
                                              Property="IsBaseCurrency"
                                              TextAlign="TextAlign.Center"
                                              Context="item">
                            <Template>
                                <RadzenCheckBox @bind-Value="item.IsBaseCurrency" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="IsActive"
                                              Title="Status"
                                              TextAlign="TextAlign.Center"
                                              Context="item">
                            <Template>
                                <RadzenCheckBox @bind-Value="item.IsActive" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Title="Actions" Context="item">
                            <Template>
                                <RadzenButton Size="Radzen.ButtonSize.ExtraSmall"
                                              Icon="more_vert"
                                              Variant="Variant.Text"
                                              Click="@((args)=>ShowContextMenuWithContent(args,item.CurrencyId))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Set spot rate" Icon="currency_exchange">
                <SetDailySpotRate />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenCard>
@code {
    void ShowContextMenuWithContent(MouseEventArgs args, int? id)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">
        <RadzenMenuItem Click="(()=>ShowCurrencyDetials(id))" Icon="info" Text="Details" Value="@id"></RadzenMenuItem>
        <RadzenMenuItem Click="(()=>SpotRateCurrency(id))" Icon="info" Text="Set Spot Rate" Value="@id"></RadzenMenuItem>

    </RadzenMenu>
    );
    }
}
