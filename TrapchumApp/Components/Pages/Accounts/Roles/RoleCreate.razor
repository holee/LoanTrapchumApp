<RadzenCard>
    <EditForm Model="model" @ref="roleCreateForm">
        <FluentValidationValidator DisableAssemblyScanning="true" />
        <Microsoft.AspNetCore.Components.Forms.ValidationSummary />
        <div class="row mb-2">
            <label class="col-sm-2 col-form-label">Role Name</label>
            <div class="col-sm-10">
                <InputText  class="form-control"
                               @bind-Value="model.RoleName" />
                <ValidationMessage For="@(()=>model.RoleName)" />
            </div>
        </div>
        <div class="row mb-2">
            <label class="col-sm-2 col-form-label">Description</label>
            <div class="col-sm-10">
                <RadzenTextArea Placeholder="Enter here..."
                                class="form-control"
                                @bind-Value="model.Description" />
            </div>
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="3">
            <RadzenButton Click="CreateRole"
                          Size="ButtonSize.Small"
                          Icon="save"
                          Text="Save" ButtonStyle="ButtonStyle.Success" />
            <RadzenButton Size="ButtonSize.Small"
                          Icon="close"
                          Text="Close" ButtonStyle="ButtonStyle.Danger" />
        </RadzenStack>

    </EditForm>
</RadzenCard>