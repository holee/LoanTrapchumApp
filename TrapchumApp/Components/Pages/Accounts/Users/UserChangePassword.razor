<EditForm Model="model" OnValidSubmit="SubmitOnValid">
    <FluentValidationValidator DisableAssemblyScanning="true"></FluentValidationValidator>
    <Microsoft.AspNetCore.Components.Forms.ValidationSummary />
    <input type="hidden" @bind="model.UserId" />
    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
        <RadzenColumn SizeMD="2">Current Password</RadzenColumn>
        <RadzenColumn SizeMD="4">
            <InputText type="password"
                       placeholder="Current Password"
                       @bind-Value="model.CurrentPassword"
                       class="form-control"></InputText>
            <ValidationMessage For="()=>model.CurrentPassword" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
        <RadzenColumn SizeMD="2">New Password</RadzenColumn>
        <RadzenColumn SizeMD="4">
            <InputText type="password"
                       placeholder="New Password"
                       @bind-Value="model.NewPassword" class="form-control"></InputText>
            <ValidationMessage For="()=>model.NewPassword" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
        <RadzenColumn SizeMD="2">Confirm Password</RadzenColumn>
        <RadzenColumn SizeMD="4">
            <InputText type="password"
                       placeholder="Confirm Password"
                       @bind-Value="model.ConfirmPassword" class="form-control"></InputText>
            <ValidationMessage For="()=>model.ConfirmPassword" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
        <RadzenColumn SizeMD="6">
            <RadzenStack AlignItems="AlignItems.Center"
                         Orientation="Orientation.Horizontal"
                         class="mt-2"
                         JustifyContent="JustifyContent.End">
                <RadzenButton Size="Radzen.ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Success"
                              ButtonType="Radzen.ButtonType.Submit"
                              Text="Changed"
                              Icon="save">
                </RadzenButton>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
</EditForm>

