@page "/App/Account/{Id}/Users"
@using Applications.Responses.ViewModels.Auths
@using TrapchumApp.Components.Account.Shared
@using TrapchumApp.Components.Pages.Shared
<PageTitle>User Management</PageTitle>
<div class="container-fluid">
    <div class="card">
        <div class="card-body rz-background-color-base-100">
            <RadzenTabs class="rz-background-color-base-100" RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="User Information" Icon="info">
                        <table class="table">
                            <tbody>
                                <tr>
                                    <th class="w-25 rz-background-color-base-100">Name</th>
                                    <td class="w-auto">@userModel?.UserName</td>
                                </tr>
                                <tr>
                                    <th class="w-25 rz-background-color-base-100">Email</th>
                                    <td>@(userModel!.Email)</td>
                                </tr>
                                <tr>
                                    <th class="w-25 rz-background-color-base-100">Role</th>
                                    <td>@(userModel!.Role)</td>
                                </tr>
                            </tbody>
                        </table>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Change Password" Icon="password">
                        <EditForm Model="model" OnValidSubmit="SubmitOnValid">
                            <FluentValidationValidator DisableAssemblyScanning="true"></FluentValidationValidator>
                            <Microsoft.AspNetCore.Components.Forms.ValidationSummary />
                            <input type="hidden" @bind="model.UserId" />
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn SizeMD="2">Current Password</RadzenColumn>
                                <RadzenColumn SizeMD="4">
                                    <InputText type="password"
                                               placeholder="Current Password"
                                               @bind-Value="model.CurrentPassword"
                                               class="form-control"></InputText>
                                    <ValidationMessage For="()=>model.CurrentPassword" />
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn SizeMD="2">New Password</RadzenColumn>
                                <RadzenColumn SizeMD="4">
                                    <InputText type="password"
                                               placeholder="New Password"
                                               @bind-Value="model.NewPassword" class="form-control"></InputText>
                                    <ValidationMessage For="()=>model.NewPassword" />
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn SizeMD="2">Confirm Password</RadzenColumn>
                                <RadzenColumn SizeMD="4">
                                    <InputText type="password"
                                               placeholder="Confirm Password"
                                               @bind-Value="model.ConfirmPassword" class="form-control"></InputText>
                                    <ValidationMessage For="()=>model.ConfirmPassword" />
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn SizeMD="6">
                                    <RadzenStack AlignItems="AlignItems.Center"
                                                 Orientation="Orientation.Horizontal"
                                                 class="mt-2"
                                                 JustifyContent="JustifyContent.End">
                                        <RadzenButton Size="Radzen.ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Success"
                                                      ButtonType="Radzen.ButtonType.Submit"
                                                      Text="Changed"
                                                      Icon="save">
                                        </RadzenButton>
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </EditForm>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Change Role" Icon="person">
                        <EditForm Model="formRequest" OnValidSubmit="HandleSubmitOnValid">
                            <FluentValidationValidator DisableAssemblyScanning="true"></FluentValidationValidator>
                            <Microsoft.AspNetCore.Components.Forms.ValidationSummary />
                            <input type="hidden" @bind="model.UserId" />
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn SizeMD="2">Current Role</RadzenColumn>
                                <RadzenColumn SizeMD="4">
                                    <RadzenText TagName="TagName.P">
                                        @userModel.Role
                                    </RadzenText>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn SizeMD="2">Select New Role</RadzenColumn>
                                <RadzenColumn SizeMD="4">
                                    <RadzenDropDown TValue="string"
                                                    class="w-100"
                                                    @bind-Value="formRequest.RoleName"
                                                    Data="@roles">
                                    </RadzenDropDown>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn SizeMD="6">
                                    <RadzenStack AlignItems="AlignItems.Center"
                                                 Orientation="Orientation.Horizontal"
                                                 class="mt-2"
                                                 JustifyContent="JustifyContent.End">
                                        <RadzenButton Size="Radzen.ButtonSize.Small"
                                                      ButtonStyle="ButtonStyle.Primary"
                                                      ButtonType="Radzen.ButtonType.Submit"
                                                      Text="Update"
                                                      Icon="save">
                                        </RadzenButton>
                                    </RadzenStack>
                                </RadzenColumn>
                            </RadzenRow>
                        </EditForm>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Permissions" Icon="admin_panel_settings">
                        <MessageStatus Message="@message" />
                        <RadzenDataGrid Data="userPermission!.Permissions"
                                        GridLines="DataGridGridLines.Horizontal"
                                        AllowSorting="false"
                                        AllowAlternatingRows="true"
                                        Style="--rz-grid-header-background-color:var(--rz-base-200);height:30rem;min-height:30rem;max-height:40rem"
                                        ColumnWidth="15rem"
                                        IsLoading="IsLoading"
                                        Density="Density.Compact">
                            <Columns>
                                <RadzenDataGridColumn Width="6rem"
                                                      Property="@(nameof(UserPermissionViewModel.Group))"
                                                      Title="Group" />
                                <RadzenDataGridColumn Property="@(nameof(UserPermissionViewModel.ClaimType))"
                                                      Title="Type" />
                                <RadzenDataGridColumn Property="@(nameof(UserPermissionViewModel.ClaimValue))"
                                                      Title="Value" />
                                <RadzenDataGridColumn Context="c"
                                                      Width="5rem"
                                                      TextAlign="TextAlign.Center"
                                                      Property="@(nameof(UserPermissionViewModel.UserId))"
                                                      Title="Assigned">
                                    <Template>
                                        <RadzenCheckBox @bind-Value="c.IsAssignedToRole"></RadzenCheckBox>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                        <RadzenStack JustifyContent="JustifyContent.End"
                                     AlignItems="AlignItems.Center"
                                     class="my-2"
                                     Orientation="Orientation.Horizontal">
                            <RadzenButton Icon="save"
                                          ButtonStyle="ButtonStyle.Primary"
                                          Size="Radzen.ButtonSize.Small"
                                          Click="AddUserPermissions"
                                          IsBusy="isBusy"
                                          Text="Save"></RadzenButton>
                        </RadzenStack>
                    </RadzenTabsItem>

                </Tabs>
            </RadzenTabs>

        </div>
        <div class="card-footer">
            <RadzenStack JustifyContent="JustifyContent.End"
                         AlignItems="AlignItems.Center"
                         class="mt-2"
                         Orientation="Orientation.Horizontal">
                <RadzenLink Icon="arrow_back"
                            Path="/App/Account/Users"
                            Text="Back"></RadzenLink>
            </RadzenStack>
        </div>
    </div>
</div>


