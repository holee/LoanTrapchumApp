@using AppilcationServices.Interfaces
@using Applications.Interfaces.Branches

<RadzenStack Gap="1rem" Orientation="Radzen.Orientation.Vertical" JustifyContent="Radzen.JustifyContent.SpaceBetween" Style="height: 100%;">
    <RadzenStack>
        <RadzenRow>
            <RadzenColumn Size="12" SizeMD="12" Class="rz-p-2 rz-border-radius-1" Style="border: var(--rz-grid-cell-border)">
                <RadzenText TextStyle="TextStyle.Subtitle1">Branch Info.</RadzenText>
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                    
                    <RadzenStack Gap="0" Class="rz-text-truncate">
                        <RadzenText TextStyle="TextStyle.Overline" Class="rz-my-0" Style="color: var(--rz-text-tertiary-color);">Name</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1" Class="rz-text-truncate"><b>@(branch!.BranchName)</b></RadzenText>
                        <RadzenText TextStyle="TextStyle.Overline" Class="rz-my-0" Style="color: var(--rz-text-tertiary-color);">Bank</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Class="rz-text-truncate"><b>@(branch?.Bank?.BankName)</b></RadzenText>
                        <RadzenText TextStyle="TextStyle.Overline" Class="rz-mt-2 rz-mb-0" Style="color: var(--rz-text-tertiary-color);">Description</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body2" Class="rz-text-truncate"><b>@branch!.Description</b></RadzenText>
                    </RadzenStack>
                </RadzenStack>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="12" Class="rz-p-2 rz-border-radius-1" Style="border: var(--rz-grid-cell-border)">
                <RadzenText TextStyle="TextStyle.Subtitle1">Address</RadzenText>
                <RadzenStack Gap="0" Class="rz-text-truncate">
                    <RadzenText TextStyle="TextStyle.Overline" Class="rz-my-0" Style="color: var(--rz-text-tertiary-color);">Address-Khmer</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Class="rz-text-truncate"><b>@branch!.CountryName @branch.City @branch.ProInKhmer @branch.DisInKhmer @branch.ComInKhmer @branch.VilInKhmer</b></RadzenText>
                    <RadzenText TextStyle="TextStyle.Overline" Class="rz-mt-2 rz-my-0" Style="color: var(--rz-text-tertiary-color);">Address-English</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Class="rz-text-truncate"><b>@branch!.CountryName @branch.City @branch.ProDescription @branch.DisDescription @branch.ComDescription @branch.VillDescription</b></RadzenText>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        
    </RadzenStack>
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="Radzen.JustifyContent.SpaceBetween" Gap="0.5rem">
        <p class="text-muted text-sm text-center">Created: @branch!.CreatedDT Modified: @branch.ModifiedDT</p>
        <RadzenButton Icon="cancel" Click="@((args) => DialogService.Close(true))" Variant="Variant.Flat" Text="Close" />
    </RadzenStack>
</RadzenStack>
 @code {
    [Parameter] public int Id { get; set; }
    [Inject] private IBranchService? service { get; set; }
    private BranchDto? branch = new BranchDto();
    protected override async Task OnInitializedAsync()
    {
        var result = await service!.GetBranchByIdAsync(Id);
        if (result.IsSuccess)
            branch = result.Data;
        await base.OnInitializedAsync();
    }
}

