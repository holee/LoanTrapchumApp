@using Applications.Requests.Loans
@using Applications.Requests.Transactions.ForiegnExchanges
@using Applications.Responses.ViewModels.Currencies
<div class="container-fluid rz-p-1 rz-m-0 rz-background-color-base-100">
    <RadzenRow AlignItems="AlignItems.Center" class="rz-px-1 rz-py-2 rz-m-0">
        <RadzenColumn Size="6">
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Shade="Shade.Dark">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap="0.25rem"
                             Style="padding: 0.4rem 0.25rem 0.4rem 0; text-transform: none;">
                    Paid Amount
                    <strong style="font-size:1rem;color:black;">
                        @(paidAmount.FormatUp(2, CurrencyId));
                    </strong>
                </RadzenStack>
            </RadzenBadge>
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Shade="Shade.Dark">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap="0.25rem"
                             Style="padding: 0.4rem 0.25rem 0.4rem 0; text-transform: none;">
                    Pentalty
                    <strong class="text-danger">
                        @(totalPenaltyAmount.FormatUp(2, CurrencyId))
                    </strong>
                </RadzenStack>
            </RadzenBadge>
        </RadzenColumn>
        <RadzenColumn Size="3">
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End"
                         AlignItems="AlignItems.Center">
                <RadzenButton Click="RestoreDefault"
                              ButtonStyle="ButtonStyle.Primary"
                              Text="Set Default"
                              Size="Radzen.ButtonSize.Small">
                </RadzenButton>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
        <RadzenColumn Size="4"></RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenBadge BadgeStyle="BadgeStyle.Info" Shade="Shade.Dark" class="w-100">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.Center"
                             Gap="0.25rem"
                             Style="padding: 0.2rem 0.25rem 0.2rem 0; text-transform:uppercase;">
                    <strong>USD</strong>
                </RadzenStack>
            </RadzenBadge>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenBadge BadgeStyle="BadgeStyle.Info" Shade="Shade.Dark" class="w-100">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.Center"
                             Gap="0.25rem"
                             Style="padding: 0.2rem 0.25rem 0.2rem 0; text-transform: uppercase;">
                    <strong>KHR</strong>
                </RadzenStack>
            </RadzenBadge>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenLabel>Penalty Amount</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="8">
            <RadzenNumeric Min="0"
                           ShowUpDown="false"
                           onclick="this.querySelector('.rz-spinner-input').select()"
                           @bind-Value="penaltyAmount"
                           TValue="decimal?"
                           @oninput="CalculatePenaltyAmount"
                           TextAlign="TextAlign.End"
                           Format="#,00.00"
                           Disabled="@(penaltyAmount<=0)"
                           class="w-100">
            </RadzenNumeric>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
        <RadzenColumn Size="4">
            <RadzenLabel>Applied Amount</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenNumeric TValue="decimal?"
                           @bind-Value="appliedAmountUSD"
                           onclick="this.querySelector('.rz-spinner-input').select()"
                           TextAlign="TextAlign.End"
                           class="w-100 input-height"
                           Disabled
                           Format="#,00.00"
                           ShowUpDown="false" />
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenNumeric TValue="decimal?"
                           @bind-Value="appliedAmountKHR"
                           TextAlign="TextAlign.End"
                           Format="#,00.00"
                           class="w-100"
                           InputAttributes="@attributes"
                           Disabled
                           Style="cursor:not-allowed;"
                           ShowUpDown="false" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
        <RadzenColumn Size="4">
            <RadzenLabel>
                Recieve Amount
            </RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenNumeric TValue="decimal?"
                           ShowUpDown="false"
                           class="w-100 input-height"
                           onclick="this.querySelector('.rz-spinner-input').select()"
                           @bind-Value="receiveAmountUsd"
                           Change="ReceivePaymentUSDChanged"
                           Format="#,00.00"
                           TextAlign="TextAlign.End" />
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenNumeric TValue="decimal?"
                           ShowUpDown="false"
                           Format="#,00.00"
                           @bind-Value="receiveAmountKhr"
                           onclick="this.querySelector('.rz-spinner-input').select()"
                           class="w-100 input-height"
                           Change="ReceivePaymentKHRChanged"
                           TextAlign="TextAlign.End" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
        <RadzenColumn Size="4">
            <RadzenLabel>Change</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenNumeric TValue="decimal?"
                           @bind-Value="changedAmountUSD"
                           TextAlign="TextAlign.End"
                           class="w-100"
                           Format="#,00.00"
                           Disabled
                           Style="cursor:not-allowed;"
                           ShowUpDown="false">
            </RadzenNumeric>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenNumeric TValue="decimal?"
                           @bind-Value="changedAmountKHR"
                           TextAlign="TextAlign.End"
                           Disabled
                           Style="cursor:not-allowed"
                           class="w-100 input-height"
                           Format="#,00.00"
                           ShowUpDown="false"></RadzenNumeric>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
        <RadzenColumn Size="4">
            <RadzenLabel>Change Applied</RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenNumeric TValue="decimal?"
                           @bind-Value="changeAppliedAmountUSD"
                           TextAlign="TextAlign.End"
                           class="w-100"
                           Change="CalculateChangeAppliedUsd"
                           Format="#,00.00"
                           onclick="this.querySelector('.rz-spinner-input').select()"
                           ShowUpDown="false"></RadzenNumeric>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenNumeric TValue="decimal?"
                           @bind-Value="changeAppliedAmountKHR"
                           TextAlign="TextAlign.End"
                           Disabled
                           Format="#,00.00"
                           class="w-100"
                           Style="cursor:not-allowed"
                           ShowUpDown="false"></RadzenNumeric>
        </RadzenColumn>
    </RadzenRow>
</div>
<RadzenStack Orientation="Radzen.Orientation.Horizontal"
             AlignItems="AlignItems.Center"
             class="mt-3"
             JustifyContent="Radzen.JustifyContent.End"
             Gap="1rem">
    <RadzenButton ButtonStyle="ButtonStyle.Success"
                  Size="Radzen.ButtonSize.Small"
                  Icon="save"
                  Text="Recieve Payment"
                  IsBusy="isBusy"
                  Disabled="disableButton"
                  Click="OnSaveChanges">
    </RadzenButton>
    <RadzenButton Size="Radzen.ButtonSize.Small"
                  ButtonStyle="ButtonStyle.Danger"
                  Icon="cancel"
                  Text="Close"
                  Click="@CloseModal">
    </RadzenButton>
</RadzenStack>

