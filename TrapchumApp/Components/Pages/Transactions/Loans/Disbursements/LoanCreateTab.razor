@* <SectionContent SectionName="progressbar">
    <RadzenProgressBar Value="100"
                       ShowValue="false"
                       Visible="isProgressing"
                       Mode="ProgressBarMode.Indeterminate">
    </RadzenProgressBar>
</SectionContent>
<RadzenCard class="rz-background-color-base-100 rz-p-0 rz-m-0">
    <RadzenStack AlignItems="AlignItems.Center"
                 Orientation="Orientation.Vertical"
                 class="w-100 rz-m-0 rz-p-0"
                 Gap="0">
        <div class="card card-header w-100 m-0 rz-background-color-info-lighter">
            <RadzenStack AlignItems="AlignItems.Center"
                         Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.Normal">
                <strong>ព័ត៌មានអតិថិជន</strong>
                <RadzenButton Size="Radzen.ButtonSize.ExtraSmall"
                              Icon="@collapseIcon"
                              data-bs-toggle="collapse"
                              data-bs-target="#collapseExample"
                              aria-expanded="@collapse"
                              aria-controls="collapseExample"
                              Click="CollapseButton"></RadzenButton>
            </RadzenStack>
        </div>
        <div class="rz-background-color-base-100 collapse mt-0 w-100" id="collapseExample">
            <RadzenRow AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenColumn Size="6">
                    <CustomerInfo SelectedCustomer="selectedCustomer" />
                </RadzenColumn>
                <RadzenColumn Size="6">
                    <table class="table table-sm table-bordered">
                        <tbody>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">Principle</th>
                                <td>
                                    @model?.Principle.Format(model.CurrencyRefId)
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">អត្រការប្រាក់</th>
                                <td>
                                    <span>@model?.InterestRate </span>
                                    <i>%</i>
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">ប្រាក់ប្រសិទ្ធភាព</th>
                                <td>
                                    <span>
                                        @model?.CollectionFeeRate
                                    </span>
                                    <i>%</i>
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">ប្រាក់រដ្ឋបាល</th>
                                <td>
                                    @model?.AdminFeeAmount.Format(model.CurrencyRefId)
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">ថ្ងៃបង់ប្រាក់លើទីមួយ</th>
                                <td>
                                    @model?.FirstPaymentDate
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">ថ្ងៃបង់ប្រាក់ចុងក្រោយ</th>
                                <td>
                                    @model?.LastPaymentDate
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">ប្រភេទសងប្រាក់</th>
                                <td>
                                    @model?.InstallmentType
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </RadzenColumn>
            </RadzenRow>
        </div>
    </RadzenStack>
    <RadzenTabs class="rz-m-2 rz-p-0"
                RenderMode="TabRenderMode.Server"
                @ref="tb"
                Change="SelectedTabChanged"
                @bind-SelectedIndex="selectedTabIndex">
        <Tabs>
            <RadzenTabsItem Text="New" Icon="add">
                <div class="card mt-0">
                    <div class="card-header rz-background-color-info-lighter">
                        <strong>ព័ត៌មានប្រាក់កម្ចី</strong>
                    </div>
                    <div class="card-body rz-background-color-base-100">
                        <EditForm Model="model" @ref="editForm">
                            <input type="hidden" @bind-value="penaltyRate" />
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>អតិថិជន</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="9">
                                            <RadzenDropDownDataGrid class="w-100"
                                                                    Style="cursor:pointer"
                                                                    @bind-Value="model.CustomerRefId"
                                                                    @bind-Value:after="SelectCustomerValueChanged"
                                                                    Data="CustomersList"
                                                                    @ref="DropDownCustomer"
                                                                    TextProperty="AltName"
                                                                    ValueProperty="CustomerId"
                                                                    AllowClear="true"
                                                                    AllowColumnResize="true"
                                                                    Multiple="false"
                                                                    ShowSearch="false"
                                                                    LoadData="LoadCustomers"
                                                                    ShowAdd="true"
                                                                    Density="Density.Compact"
                                                                    PageSize="10"
                                                                    Add="ShowCustomerModal"
                                                                    AllowRowSelectOnRowClick="true"
                                                                    Name="DropDownCustomer">
                                                <Columns>
                                                    <RadzenDropDownDataGridColumn Visible="false" Property="CustomerId" Title="Id" Width="5px" />
                                                    <RadzenDropDownDataGridColumn Property="AltName" Title="Name" Width="200px" />
                                                    <RadzenDropDownDataGridColumn Property="Phone" Title="Phone" Width="100px" />
                                                    <RadzenDropDownDataGridColumn Property="Address" Title="Address" Width="200px" />
                                                </Columns>
                                            </RadzenDropDownDataGrid>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>ចំនួនទឹកប្រាក់កម្ចី</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="6">
                                            <RadzenNumeric TextAlign="TextAlign.End"
                                                           class="w-100"
                                                           @bind-Value="model.Principle"
                                                           Change="PrincipleTextChanged"
                                                           onclick="this.querySelector('.rz-spinner-input').select()"
                                                           Min="0.00M"
                                                           TValue="decimal?"
                                                           Disabled="@(selectedCustomer!.CustomerId<=0)"
                                                           ShowUpDown="false">
                                            </RadzenNumeric>
                                        </RadzenColumn>
                                        <RadzenColumn Size="3">
                                            <RadzenDropDown Data="StorageConstant.CurrencyTpes"
                                                            class="w-100"
                                                            TextProperty="@nameof(Items.Label)"
                                                            ValueProperty="@nameof(Items.Value)"
                                                            @bind-Value="model.CurrencyRefId">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>ប្រាក់ប្រសិទ្ធិភាព</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="5" class="input-group">
                                            <RadzenNumeric ShowUpDown="false"
                                                           TextAlign="TextAlign.End"
                                                           class="form-control"
                                                           Min="0.00M"
                                                           onclick="this.querySelector('.rz-spinner-input').select()"
                                                           Disabled="@(selectedCustomer!.CustomerId<=0)"
                                                           @bind-Value="model.CollectionFeeRate"
                                                           TValue="decimal?" />
                                            <span class="input-group-text">%</span>
                                        </RadzenColumn>
                                        <RadzenColumn Size="4" class="input-group">
                                            <RadzenDropDown Data="StorageConstant.OtherChargedModes"
                                                            TextProperty="@nameof(Items.Label)"
                                                            class="form-select"
                                                            ValueProperty="@nameof(Items.Value)"
                                                            @bind-Value="SelectedCollectionFee">
                                            </RadzenDropDown>
                                            <span class="input-group-text">/Month</span>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>អត្រាការប្រាក់</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="9" class="input-group">
                                            <RadzenNumeric TValue="decimal?"
                                                           Disabled="@(selectedCustomer!.CustomerId<=0)"
                                                           Format="#.00"
                                                           TextAlign="TextAlign.End"
                                                           Min="0.00M"
                                                           onclick="this.querySelector('.rz-spinner-input').select()"
                                                           ShowUpDown="false"
                                                           @bind-Value="model.InterestRate" />
                                            <span class="input-group-text">%</span>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>Admin Fee</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="5" class="input-group">
                                            <RadzenNumeric TextAlign="TextAlign.End"
                                                           ShowUpDown="false"
                                                           Disabled="@(selectedCustomer!.CustomerId<=0)"
                                                           @bind-Value="model.AdminFeeRate"
                                                           class="form-control"
                                                           Min="0.00M"
                                                           onclick="this.querySelector('.rz-spinner-input').select()"
                                                           @bind-Value:after="CalculateAdminFeeAmount"
                                                           TValue="decimal?" />
                                            <span class="input-group-text">%</span>
                                        </RadzenColumn>
                                        <RadzenColumn Size="4">
                                            <RadzenNumeric TextAlign="TextAlign.End"
                                                           ShowUpDown="false"
                                                           Disabled="@(selectedCustomer!.CustomerId<=0)"
                                                           @bind-Value="model.AdminFeeAmount"
                                                           TValue="decimal?" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>រយៈពេលខ្ចីប្រាក់</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="6">
                                            <RadzenNumeric Disabled="@(selectedCustomer!.CustomerId<=0)"
                                                           TextAlign="TextAlign.End"
                                                           ShowUpDown="false"
                                                           class="w-100"
                                                           @bind-Value="model.Installments"
                                                           @bind-Value:after="PeriodChanged"
                                                           onclick="this.querySelector('.rz-spinner-input').select()"
                                                           Min="0.00M"
                                                           TValue="int?">
                                            </RadzenNumeric>
                                        </RadzenColumn>
                                        <RadzenColumn Size="3">
                                            <RadzenDropDown TextProperty="InstallmentTypeCode"
                                                            ValueProperty="InstallmentTypeId"
                                                            @bind-Value="model.InstallmentTypeId"
                                                            class="w-100"
                                                            Multiple="false"
                                                            Disabled="@(selectedCustomer!.CustomerId<=0)"
                                                            SelectedItemChanged="SelectedInstallmentChanged"
                                                            Data="LoanInstallments">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>ប្រភេទបង់រំលោះ</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="6">
                                            <RadzenDropDown TValue="int?"
                                                            @bind-Value="model.RepaymentModeRefId"
                                                            @bind-Value:after="SelectionChanged"
                                                            class="w-100"
                                                            TextProperty="RepaymentModeCode"
                                                            ValueProperty="RepaymentModeId"
                                                            Data="LoanRepaymentModes">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                        <RadzenColumn Size="3">
                                            <RadzenNumeric Disabled="@(model.RepaymentModeRefId !=1)"
                                                           @bind-Value="model.PayEvery"
                                                           onclick="this.querySelector('.rz-spinner-input').select()"
                                                           class="w-100"
                                                           Min="1"
                                                           TValue="int?" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>ថ្ងៃខ្ចីប្រាក់</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="9">
                                            <RadzenDatePicker @bind-Value="model.StartDate"
                                                              @bind-Value:after="ChangedDate"
                                                              @bind-Value:format="yyyy/MMM/dd"
                                                              DateFormat="dd/MM/yyyy"
                                                              Min="DateTime.Now"
                                                              class="w-100"
                                                              Name="StartDate"
                                                              ShowCalendarWeek />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>ឈ្មោះភ្នាក់ងារ</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="9">
                                            <RadzenDropDown @bind-Value="model.CreditAgentRefId"
                                                            TextProperty="Name"
                                                            AllowFiltering="true"
                                                            ValueProperty="Id"
                                                            class="w-100"
                                                            Data="CreditAgents">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>ថ្ងៃបង់ប្រាក់លើកដំបូង</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="9">
                                            <RadzenDatePicker @bind-Value="model.FirstPaymentDate"
                                                              @bind-Value:after="ChangedFirstPayment"
                                                              @bind-Value:format="yyyy/MMM/dd"
                                                              DateFormat="dd/MM/yyyy"
                                                              Name="FirstPaymentDate"
                                                              class="w-100"
                                                              Min="DateTime.Now"
                                                              ShowCalendarWeek />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>ប្រភេទកម្ចី</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="9">
                                            <RadzenDropDown @bind-Value="model.LoanCategoryRefId"
                                                            TextProperty="LoancategoryCode"
                                                            ValueProperty="LoanCategoryId"
                                                            AllowFiltering="true"
                                                            class="w-100"
                                                            Data="loanCategories">
                                            </RadzenDropDown>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>ខ្ចីលើកទី</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="9">
                                            <RadzenNumeric ShowUpDown="false"
                                                           TValue="int"
                                                           class="w-100"
                                                           Disabled
                                                           @bind-Value="model.Circle"
                                                           Placeholder="Enter or clear value" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>Guarantor</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="9">
                                            <RadzenDropDownDataGrid class="w-100"
                                                                    @ref="grid"
                                                                    @bind-Value="SelectedGuarantors"
                                                                    Data="Guarantors"
                                                                    AllowColumnResize="true"
                                                                    TextProperty="GuarantorName"
                                                                    ShowSearch="false"
                                                                    Chips="true"
                                                                    Multiple="true"
                                                                    PageSize="10"
                                                                    ShowAdd="true"
                                                                    LoadData="SearchGaurantors"
                                                                    Add="AddGuarantorModals"
                                                                    Density="Density.Compact"
                                                                    AllowRowSelectOnRowClick="true"
                                                                    Name="DropDownGuarantors">
                                                <Columns>
                                                    <RadzenDropDownDataGridColumn Width="60px" Sortable="false">
                                                        <HeaderTemplate>
                                                            <RadzenCheckBox InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select all" }})"
                                                                            Disabled="@(!grid!.AllowSelectAll)"
                                                                            TriState="false"
                                                                            TValue="bool"
                                                                            Value="@(Guarantors!.Any(c => SelectedGuarantors !=null && SelectedGuarantors.Contains(c)))"
                                                                            Change="@(args =>CkeckedGuarantorsChanged(args))" />
                                                        </HeaderTemplate>
                                                        <Template Context="data">
                                                            <RadzenCheckBox InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select item" }})"
                                                                            TriState="false"
                                                                            TValue="bool"
                                                                            Value="@(SelectedGuarantors != null && SelectedGuarantors.Contains(((VGuarantor)data)))"
                                                                            Change="@(args => grid!.SelectItem(data))" @onclick:stopPropagation />
                                                        </Template>
                                                    </RadzenDropDownDataGridColumn>
                                                    <RadzenDropDownDataGridColumn Property="Id" Title="Id" Width="50px" Visible="false" />
                                                    <RadzenDropDownDataGridColumn Property="GuarantorName" Title="Name" Width="200px" />
                                                    <RadzenDropDownDataGridColumn Property="Phone" Title="Phone" Width="100px" />
                                                </Columns>
                                            </RadzenDropDownDataGrid>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                            </RadzenRow>
                            <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>កំណត់សម្គាល់</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="9">
                                            <RadzenTextArea class="w-100"
                                                            @bind-Value="model.Remark" />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenRow AlignItems="AlignItems.Center">
                                        <RadzenColumn Size="3">
                                            <RadzenLabel>Collateral</RadzenLabel>
                                        </RadzenColumn>
                                        <RadzenColumn Size="9">
                                            <RadzenDropDownDataGrid class="w-100"
                                                                    @ref="gridCols"
                                                                    @bind-Value="SelectedCollateralLines"
                                                                    Data="CollateralLines"
                                                                    AllowColumnResize="false"
                                                                    ShowSearch="false"
                                                                    Chips="true"
                                                                    Multiple="true"
                                                                    Density="Density.Compact"
                                                                    AllowRowSelectOnRowClick="true"
                                                                    TextProperty="ReferenceNo"
                                                                    ShowAdd="true"
                                                                    Add="TabCollateralTab"
                                                                    Name="DropDownCollateralLines">
                                                <Columns>
                                                    <RadzenDropDownDataGridColumn Width="60px" Sortable="false">
                                                        <HeaderTemplate>
                                                            <RadzenCheckBox InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select all" }})"
                                                                            Disabled="@(!gridCols!.AllowSelectAll)"
                                                                            TriState="false"
                                                                            TValue="bool"
                                                                            Value="@(CollateralLines!.Any(c => SelectedCollateralLines !=null && SelectedCollateralLines.Contains(c)))"
                                                                            Change="@(args => CkeckedCollateralsChanged(args))" />
                                                        </HeaderTemplate>
                                                        <Template Context="data">
                                                            <RadzenCheckBox InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select item" }})"
                                                                            TriState="false"
                                                                            TValue="bool"
                                                                            Value="@(SelectedCollateralLines != null && SelectedCollateralLines.Contains(((CollateralLineDtoCreate)data)))"
                                                                            Change="@(args => gridCols!.SelectItem(data))"
                                                                            @onclick:stopPropagation />
                                                        </Template>
                                                    </RadzenDropDownDataGridColumn>
                                                    <RadzenDropDownDataGridColumn Property="Id" Title="Id" Width="50px" Visible="false" />
                                                    <RadzenDropDownDataGridColumn Property="OwnerName" Title="OwnerName" Width="100px" />
                                                    <RadzenDropDownDataGridColumn Property="ReferenceNo" Title="ReferenceNo" Width="200px" />
                                                </Columns>
                                            </RadzenDropDownDataGrid>
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenColumn>
                            </RadzenRow>
                        </EditForm>
                    </div>
                    <div class="card-footer">
                        <RadzenStack class="mt-2"
                                     Orientation="Radzen.Orientation.Horizontal"
                                     JustifyContent="Radzen.JustifyContent.End"
                                     Gap="0.5rem"
                                     AlignItems="AlignItems.Center">
                            <RadzenButton Disabled="model.Principle <=0"
                                          Click="ShowLoanPreviews"
                                          Size="Radzen.ButtonSize.Small"
                                          Icon="preview"
                                          ButtonStyle="ButtonStyle.Primary" Text="Preview" />
                            <RadzenButton Disabled="model.Principle <=0"
                                          Size="Radzen.ButtonSize.Small"
                                          Click="SubmitForm"
                                          Text="Save & New"
                                          Icon="save"
                                          ButtonStyle="ButtonStyle.Success" />
                        </RadzenStack>
                    </div>
                </div>
            </RadzenTabsItem>
            <RadzenTabsItem Text="Preview" Icon="preview"
                            Visible="isPreviewScheduleTab">
                 <PreviewSchedules Schedules="previewSchedule"
                                  CurrencyId="model.CurrencyRefId" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Collaterals"
                            Icon="inventory"
                            Visible="isCollateralTab">
                <CollateralCreateTab CustomerId="model.CustomerRefId!.Value"
                                     SaveChanged="SaveThenClose"
                                     Close="CloseTab"
                                     CustomerName="@customerName" />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenCard>



 *@