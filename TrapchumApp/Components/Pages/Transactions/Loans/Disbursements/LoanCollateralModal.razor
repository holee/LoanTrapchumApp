@* @using TCLMS.Shared.Entities.Models.Lists.Customers
@using TCLMS.Shared.Entities.ViewModels.Customers
<div class="container-fluid">
        <div class="card">
        <div
             class="card-header">
            <RadzenButton
                    ButtonStyle="ButtonStyle.Success"
                    Size="Radzen.ButtonSize.Small"
                    Icon="add"
                    Text=" Add New Collateral"
                    Click="OnQuickAddCollateral">
            </RadzenButton>
        </div>
        <div class="card-body">
            <table class="table tabls-sm">
                <thead>
                    <tr>
                        <th>#</th>
                    <th>Collateral number</th>
                    <th>Collateral Type</th>
                    <th>Category</th>
                    <th>Owner</th>
                    <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var value in collateralList ?? Enumerable.Empty<CollateralDto>())
                    {
                        var index = collateralList?.IndexOf(value) + 1;
                        if (value.IsAvailable == false && value.IsReturn == false)
                        {
                            <tr Background="Background.Secondary" Color="Color.Secondary">
                                <td>@index</td>
                                    <td>@value?.CollateralNumber</td>
                                    <td>@value?.TypeName</td>
                                    <td>@value?.CollateralSubTypeDto?.CollateralSubTypeName</td>
                                    <td>@value?.Owner</td>
                                    <td>Unavailable</td>
                                </tr>
                        }
                        else if (value.IsAvailable == true && value.IsReturn == false)
                        {
                            <tr>
                                <td>@index</td>
                                    <td>@value?.CollateralNumber</td>
                                    <td>@value?.TypeName</td>
                                    <td>@value?.CollateralSubTypeDto?.CollateralSubTypeName</td>
                                    <td>@value?.Owner</td>
                                    <td TextAlignment="TextAlignment.Center">
                                        <Button 
                                               Clicked="@(()=>AddNewCollateral(value))"
                                                Outline
                                                 Color="Color.Success"
                                                Size="Blazorise.Size.Small">
                                                <Icon Name="IconName.Add" />
                                        </Button>
                                    </td>

                                </tr>
                        }

                    }
                </tbody> 

            </table>
        </div>
    </div>
    <div class="card">
        <div
            class="card-header">
            Loan Collateral
        </div>
        <div class="card-body">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Collateral number</th>
                        <th>Collateral Type</th>
                        <th>Category</th>
                        <th>Owner</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var value in Collaterals!)
                    {
                        var index = Collaterals?.IndexOf(value) + 1;
                        <tr>
                            <td>@index</td>
                                <td>@value</td>
                                <td>@value?.DocumentKeeping</td>
                                <td>@value?.CollateralSubTypeDto?.CollateralSubTypeName</td>
                                <td>@value?.Owner</td>
                                <td class="text-center">
                                    <RadzenButton Click="@(()=>RemovedCollateral(value))"
                                    Variant="Variant.Flat"
                                        Icon="delete"
                                         ButtonStyle="ButtonStyle.Danger"
                                         Size="Radzen.ButtonSize.Small">
                                 </RadzenButton>
                             </td>
                         </tr>
                    }
                </tbody>
            </Table>
        </div>
    </div>
<div class="card-footer">
    <RadzenButton Size="Radzen.ButtonSize.Small" 
                ButtonStyle="ButtonStyle.Success"
                  Icon="circle_check"
                  Text="OK"
                Click="CloseModal" />
    <RadzenButton Size="Radzen.ButtonSize.Small" 
                ButtonStyle="ButtonStyle.Danger"
                Icon="cancel" 
                  Text=" Close"
            Click="@(()=>DialogService.Close(false))">
    </RadzenButton>
</div>
</div>

@code {
    //Parameters
    [Parameter] public long CustomerId{ get; set; }
    [Parameter] 
    public LoanCustomerQuery? Customer { get; set; }
    [Parameter]
    public List<CollateralDto>? Collaterals { get; set; } = new();  
    [Parameter]
    public Func<List<CollateralDto>, Task<bool>> OnValidated { get; set; } = default!;
    [Parameter]
    public Func<List<CollateralDto>, Task> OnSucceed { get; set; } = default!;
    [Inject] ICollateralNew CollateralService { get; set; } = default!;
    // Properties
    List<CollateralDto> collateralList =[];
    bool isValid = false;
    //Actions
    protected override async Task OnInitializedAsync()
    {
        var results = await CollateralService!.GetCollateralById(CustomerId);
        // if (results )
        // {
        //     collateralList = results!.Data!.ToList();
        // }
        await base.OnInitializedAsync();
    }
    async Task CloseModal()
    {
        if (OnValidated is not null) isValid = await OnValidated(Collaterals!);
        if (!isValid) return;
        await OnSucceed(Collaterals!);
    }
    protected void AddNewCollateral(CollateralDto collateral)
    {
        var cols = Collaterals!.Where(x => x.CustomerRefId == collateral.CustomerRefId);
        if (cols.Any()) return;
        Collaterals!.Add(collateral);
        StateHasChanged();
    }
    protected void RemovedCollateral(CollateralDto collateral) 
    {
        Collaterals!.Remove(collateral);
        StateHasChanged();
    }

    private async Task OnQuickAddCollateral()
    {
       await DialogService.OpenAsync<CreateNewUserCollateralModal>("Add Collateral");

    }

}
 *@