@page "/Loan/Disbursement/CreateNew"
@using Domains.Enumerations
@using TrapchumApp.Components.Pages.Transactions.Loans.LoanRequests
<PageTitle>New Loan Disbursment</PageTitle>
<SectionContent SectionName="Progressbar">
    <RadzenProgressBar Visible="IsLoading" Value="100"
                       ProgressBarStyle="ProgressBarStyle.Danger"
                       ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
</SectionContent>
<Containers CssClass="rz-m-0 rz-p-0 rz-background-color-base-200" Fluid>
    <Card CssClass="rz-background-color-base-200">
        <CardBody>
            <RadzenTabs @bind-SelectedIndex="selectedTabIndex" RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="ព័ត៌មានប្រាក់កម្ចី" Icon="add">
                        <div class="rz-m-0 rz-p-0">
                            <EditForm Model="model" @ref="editForm">
                                <input type="hidden" @bind-value="penaltyRate" />
                                <table class="table table-bordered table-sm">
                                    <tbody>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Customer</th>
                                            <td>
                                                <input type="hidden" @bind="model.CustomerRefId" />
                                                @model?.CustomerName
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Currency</th>
                                            <td>
                                                <input type="hidden" @bind="model!.CustomerRefId" />
                                                <span>@model?.CurrencyName</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Principle</th>
                                            <td>
                                                @model?.Principle.Format(model.CurrencyRefId)
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Installment Type</th>
                                            <td>
                                                <input type="hidden" @bind="model!.InstallmentType" />
                                                @model?.InstallmentType
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Repayment Mode</th>
                                            <td>
                                                <input type="hidden" @bind="model!.RepaymentModeRefId" />
                                                <span>
                                                    @model?.RepaymentModeName
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Installments</th>
                                            <td>
                                                <input type="hidden" @bind="model!.Installments" />
                                                @model?.Installments @model?.InstallmentName
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Pay Every</th>
                                            <td>
                                                <input type="hidden" @bind="model!.PayEvery" />
                                                @model?.PayEvery @model?.InstallmentName
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Interest Rate</th>
                                            <td>
                                                <input type="hidden" @bind="model!.InterestRate" />
                                                <span>
                                                    @model?.InterestRate
                                                    <i>%</i>
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Effective Fee Rate</th>
                                            <td>
                                                <input type="hidden" @bind="model!.CollectionFeeRate" />
                                                <input type="hidden" @bind="model!.CollectionFeeModeId" />
                                                <span>
                                                    @model?.CollectionFeeRate
                                                    <i>%</i>
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Admin Fee Amount</th>
                                            <td>
                                                <input type="hidden" @bind="model!.AdminFeeRate" />
                                                <span>
                                                    @model?.AdminFeeAmount
                                                </span>

                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Circle</th>
                                            <td>
                                                <input type="hidden" @bind="model!.Circle" />
                                                <span>
                                                    @model?.Circle
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Loan Category</th>
                                            <td>
                                                <input type="hidden" @bind="model!.LoanCategoryRefId" />
                                                @model?.LoanCategoryName
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Agent Name</th>
                                            <td>
                                                <input type="hidden" @bind="model!.CreditAgentRefId" />
                                                @model?.CreditAgentName
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Start Date</th>
                                            <td>
                                                <input type="hidden" @bind="model!.StartDate" />
                                                @model?.StartDate.DayFirst()
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Changed Payment Scedule to</th>
                                            <td>
                                                <RadzenRadioButtonList @bind-Value="model!.PayementSechuleModeId"
                                                                       TValue="int"
                                                                       Change="OnScheduleChanged">
                                                    <Items>
                                                        <RadzenRadioButtonListItem Text="Before" Value="1" />
                                                        <RadzenRadioButtonListItem Text="After" Value="2" />
                                                        <RadzenRadioButtonListItem Text="Skip" Value="3" />
                                                    </Items>
                                                </RadzenRadioButtonList>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">First Payment</th>
                                            <td>
                                                <RadzenDatePicker DateFormat="dd/MM/yyyy"
                                                                  @bind-Value:format="yyyy/MM/dd"
                                                                  @bind-Value="model!.FirstPaymentDate" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Last Payment</th>
                                            <td>
                                                <input type="hidden" @bind="model!.LastPaymentDate" />
                                                @model?.LastPaymentDate.DayFirst()
                                            </td>
                                        </tr>
                                        <tr>
                                            <th style="background-color:#F1F1F4" class="w-25">Note</th>
                                            <td>
                                                <RadzenTextArea class="w-100" @bind-Value="model!.Remark"></RadzenTextArea>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </EditForm>
                        </div>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="អ្នកធានានិងទ្រព្យបញ្ចាំ" Icon="inventory">
                        <LoanRequestCollaterals CustomerId="CustomerRequestId"
                                                Collaterals="@req.Collaterals?.ToList()"
                                                ShowAdd="false" />
                        <LoanRequestGaurantor Guarantors="@req.Guarantors" ShowAdd="false" />
                        <LoanRequestDocument Documents="@req.Documents.ToList()" ShowUpload="false" />
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Preview" Icon="preview">
                        <LoanSchedules Schedules="previewSchedule"
                                       CurrencyId="model.CurrencyRefId" />
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </CardBody>
        <CardFooter>
            <RadzenStack Gap="1rem"
                         Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End"
                         class="py-2"
                         AlignItems="AlignItems.Center">

                @if (!disburseStatus)
                {
                    <RadzenButton Click="ShowLoanPreviews"
                                  Size="ButtonSize.Small"
                                  Icon="preview"
                                  ButtonStyle="ButtonStyle.Primary" Text="Preview" />
                    <RadzenButton Click="HandleFormSubmit"
                                  Size="ButtonSize.Small"
                                  Icon="save"
                                  ButtonStyle="ButtonStyle.Primary" Text="Save" />
                    <RadzenButton Size="ButtonSize.Small"
                                  Click="HandleFormSubmit"
                                  Text="Disburse Now"
                                  Icon="save"
                                  ButtonStyle="ButtonStyle.Success" />
                }
                <RadzenLink Icon="arrow_back"
                            Path="@($"/App/Request/{BranchId}/Branches?UserId={UserId}")"
                            Text="Back" />
            </RadzenStack>
        </CardFooter>
    </Card>
</Containers>

@code {

    void OnScheduleChanged(int arg)
    {
        model.ScheduleMode = arg switch
        {
            1 => AdjustmentOption.Before,
            2 => AdjustmentOption.After,
            _ => AdjustmentOption.Skip
        };
    }

}