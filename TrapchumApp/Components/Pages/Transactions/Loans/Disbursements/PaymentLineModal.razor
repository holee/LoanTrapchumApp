@using Applications.Responses.ViewModels.Loans.Payments
<RadzenDataGrid Data="paymentLines"
                Responsive
                GridLines="DataGridGridLines.Horizontal"
                AllowAlternatingRows="true"
                Density="Density.Compact"
                Style="--rz-grid-header-background-color:var(--rz-base-200);min-height:10rem;height:10rem;max-height:15rem;"
                TItem="VPaymentLines">
    <Columns>
        <RadzenDataGridColumn Property="@(nameof(VPaymentLines.InstallmentNo))"
                              Title="#"
                              Width="4rem"
                              TextAlign="TextAlign.Center"
                              Sortable="false" />
        <RadzenDataGridColumn Property="@(nameof(VPaymentLines.PaidPrinciple))"
                              Title="Principle"
                              TextAlign="TextAlign.Right"
                              Sortable="false">
            <Template>
                @context?.PaidPrinciple
            </Template>
            <FooterTemplate>
                @paymentLines.Sum(x => x.PaidPrinciple)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VPaymentLines.PaidInterest))"
                              Title="Interest"
                              TextAlign="TextAlign.Right"
                              Sortable="false">
            <Template>
                @context?.PaidInterest
            </Template>
            <FooterTemplate>
                @paymentLines.Sum(x => x.PaidInterest)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VPaymentLines.PaidCollectionFee))"
                              Title="Coll. Fee"
                              TextAlign="TextAlign.Right"
                              Sortable="false">
            <Template>
                @context?.PaidCollectionFee
            </Template>
            <FooterTemplate>
                @paymentLines.Sum(x => x.PaidCollectionFee)
            </FooterTemplate>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VPaymentLines.PenaltyAmount))"
                              Title="Penalty"
                              TextAlign="TextAlign.Right"
                              Sortable="false">
            <Template>
                @context?.PenaltyAmount
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn Property="@(nameof(VPaymentLines.SubTotal))"
                              Title="SubTotal"
                              Context="c"
                              TextAlign="TextAlign.Center"
                              Sortable="false">
            <Template>
                @c?.SubTotal
            </Template>
            <FooterTemplate>
                @paymentLines.Sum(x => x.SubTotal)
            </FooterTemplate>
        </RadzenDataGridColumn>
    </Columns>
    <EmptyTemplate>
        <RadzenStack AlignItems="AlignItems.Center"
                     Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <strong>There is no any payemnt yet.....!</strong>
        </RadzenStack>
    </EmptyTemplate>
</RadzenDataGrid>
@code {
    [Parameter] public long? LoanId { get; set; }
    [Parameter] public int? BranchId { get; set; }
    [Parameter] public int? InstallmentNo { get; set; }
    IEnumerable<VPaymentLines> paymentLines = [];
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        // var resp = await _repaymentService.GetLoanRepaymentLinesAsync(LoanId, InstallmentNo, BranchId);

        // if (resp.IsSuccess)
        // {
        //     paymentLines = resp.Data!;
        // }
    }
}
