@using Applications.Responses.ViewModels.Loans.Requests
<Card>
    <CardHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Center">
            <strong>Guarantors Information</strong>
            @if (ShowAdd)
            {
                <RadzenButton Text="Add"
                              ButtonStyle="ButtonStyle.Primary"
                              Icon="add"
                              Click="@ClickedAdd"
                              Size="Radzen.ButtonSize.ExtraSmall"
                              ButtonType="Radzen.ButtonType.Button"></RadzenButton>
            }
        </RadzenStack>
    </CardHeader>
    <CardBody>
        <RadzenDataGrid Data="Guarantors"
                        GridLines="DataGridGridLines.Both"
                        TItem="VLoanRequestGuarantors"
                        Density="Density.Compact"
                        @ref="gridGuarantors"
                        PagerHorizontalAlign="HorizontalAlign.Right"
                        Style="min-height:15rem;height:15rem;max-height:15rem;">
            <Columns>
                <RadzenDataGridColumn Context="g"
                                      Property="@(nameof(VLoanRequestGuarantors.EntId))"
                                      Width="3rem"
                                      Title="#"
                                      Sortable="false">
                    <Template>
                        @(Guarantors.ToList().IndexOf(g) + 1)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Width="15rem" Property="@(nameof(VLoanRequestGuarantors.FullName))" Title="Name" Sortable="false" />
                <RadzenDataGridColumn Width="10rem" Property="@(nameof(VLoanRequestGuarantors.Phone))" Title="Phone" Sortable="false" />
                <RadzenDataGridColumn Context="g" Title="Address">
                    <Template>
                        @g.ToString()
                    </Template>
                </RadzenDataGridColumn>
                @if (ShowRemove)
                {
                    <RadzenDataGridColumn Context="g" TextAlign="TextAlign.Center"
                                          Width="4rem" Property="ProInKhmer"
                                          Title="Action">
                        <Template>
                            <RadzenButton Icon="delete"
                                          Shade="Shade.Lighter"
                                          Click="@(()=>ClickedRevmove(g))"
                                          Size="Radzen.ButtonSize.ExtraSmall"
                                          Variant="Variant.Outlined" />
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    </CardBody>
</Card>

