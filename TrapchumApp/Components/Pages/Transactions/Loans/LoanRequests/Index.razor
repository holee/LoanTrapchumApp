@page "/Loan/Request"
<PageTitle>Loan Request</PageTitle>
<Containers Fluid>
    <RadzenTabs SelectedIndexChanged="SelectedIndexChanged"
    RenderMode="TabRenderMode.Server">
        <Tabs>
            <RadzenTabsItem Icon="list" Text="All">
                <LoanRequestAll BranchId="@BranchId" UserId="@UserId" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Requesting" Icon="pending_actions">
                <LoanRequestRequesting BranchId="@BranchId"
                UserId="@UserId" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Requested" Icon="request_quote">
                <LoanRequestRequested BranchId="@BranchId"
                UserId="@UserId" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Approved" Icon="fact_check">
                <LoanRequestApprove BranchId="@BranchId" UserId="@UserId" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="Completed" Icon="done_outline">
                <LoanRequestCompleted BranchId="@BranchId" CreditAgentId="@UserId" />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>

</Containers>


