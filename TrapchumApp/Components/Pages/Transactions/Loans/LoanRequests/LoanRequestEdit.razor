@page "/App/Request/{BranchId:int}/Branches/{UserId}/Customer/{CustomerId}/Edit"
@using Applications.Responses.Auths
@using Applications.Responses.Lists.Collaterals
@using Applications.Responses.Loans.Disbursements
@using Applications.Responses.ViewModels.Loans.Requests
@using Applications.Responses.ViewModels.OtherNames
@using Radzen.Blazor.Rendering
<PageTitle>Loan Request</PageTitle>
<Card>
    <EditForm Model="model" @ref="editForm">
        <input type="hidden" @bind="model.LoanRequestId" />
        <FluentValidationValidator DisableAssemblyScanning="true" />
        <CardBody BodyCssClass="rz-background-color-base-200">
            <RadzenTabs SelectedIndexChanged="SelectTabIndexChanged" RenderMode="TabRenderMode.Server">
                <Tabs>
                    <RadzenTabsItem Text="សំណើរ">
                        <LoanRequestInfo model="@model" CustomerId="@CustomerId" LoanRequestId="@LoanRequestId" />
                        <RadzenFieldset>
                            <LoanRequestCollaterals CustomerId="@CustomerId"
                                                    ShowCommand="true"
                                                    ShowAdd="true"
                                                    ShowRemove="true"
                                                    @ref="CollateralRef"
                                                    Add="AddCollaterals"
                                                    RemoveCollateral="RemovedCollateral"
                                                    Collaterals="CollateralLines">
                                <SearchBoxTemplate>
                                    <CollateralSearchList CustomerId="@CustomerId"
                                                          SelectMany="SelectManyCollaterals"
                                                          OnSelected="SelectedCollateral" />
                                </SearchBoxTemplate>
                            </LoanRequestCollaterals>
                            <LoanRequestGaurantor Guarantors="Guarantors"
                                                  ShowAdd="true"
                                                  Add="AddGuarantors"
                                                  ShowRemove="true"
                                                  ShowCommand="true"
                                                  Remove="RemoveGaurantor"
                                                  @ref="GuarantorRef">
                                <SearchBoxTemplate>
                                    <GuarantorSearchList OnSelected="SelectedGuarantors" SelectMany="SelectMany" />
                                </SearchBoxTemplate>
                            </LoanRequestGaurantor>
                            <LoanRequestDocument Documents="@Documents"
                                                 UploadDocument="@HandleFileDialogue"
                                                 RemoveDocument="RemoveFile"
                                                 @ref="DocumentRef"
                                                 ShowDelete="true" />
                        </RadzenFieldset>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="អតិថិជន">
                        <RadzenFieldset>
                            <CustomerRequest CustomerId="@CustomerId" />
                        </RadzenFieldset>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </CardBody>
        <CardFooter>
            <RadzenStack class="mt-2"
                         Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End"
                         Gap="0.5rem"
                         AlignItems="AlignItems.Center">

                <RadzenButton Disabled="model.RequestAmount <=0"
                              Size="ButtonSize.Small"
                              Click="HandleCreateNew"
                              Text="Save"
                              Icon="save"
                              ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton Disabled="model.RequestAmount <=0"
                              Size="ButtonSize.Small"
                              Click="HandleCreateRequest"
                              Text="Request"
                              Icon="save"
                              ButtonStyle="ButtonStyle.Success" />
                <RadzenLink Path="@($"/App/Request/{BranchId}/Branches?UserId={UserId}")"
                            Text="Back" />
            </RadzenStack>
        </CardFooter>
    </EditForm>
</Card>

@code
{
    async Task SelectedCollateral(VCollateralLines? c)
    {
        if (c is null || c.Id <= 0) return;

        var item = new VLoanRequestCollateralLines
            {
                CollateralLineId = c.Id,
                CollateralId = c.CollateralId,
                OwnerName = c.OwnerName,
                ReferenceNo = c.ReferenceNo,
                TypeName = c.TypeName,
                Quantity = c.Quantity,
            };


        if (CollateralLines.Any(x => x.Id == item.Id))
        {
            NotificationService.Notify(NotificationSeverity.Info, "Collateral already exists");
            return;
        }
        CollateralLines.Add(item);

        await CollateralRef.CollateralReload();
    }

    async Task SelectMany(IEnumerable<VGuarantor> gs)
    {
        if (!gs.Any()) return;

        foreach (var g in gs)
        {
            if (Guarantors.Any(x => x.EmployeeRefId == g.Id)) continue;

            var item = new VLoanRequestGuarantors
                {
                    EmployeeRefId = g.Id,
                    FullName = g.FullName,
                    AltName = g.GuarantorName,
                    Phone = g.Phone,
                    VilInKhmer = g.VilInKhmer,
                    ComInKhmer = g.ComInKhmer,
                    DisInKhmer = g.DisInKhmer,
                    ProInKhmer = g.ProInKhmer
                };


            Guarantors.Add(item);
        }

        await GuarantorRef.GuarantorReload();

    }

    async Task SelectManyCollaterals(IEnumerable<VCollateralLines> cs)
    {
        if (!cs.Any()) return;

        foreach (var g in cs)
        {

            if (CollateralLines.Any(x => x.CollateralId == g.CollateralId)) continue;

            var item = new VLoanRequestCollateralLines
                {
                    CollateralLineId = g.Id,
                    CollateralId = g.CollateralId,
                    OwnerName = g.OwnerName,
                    ReferenceNo = g.ReferenceNo,
                    TypeName = g.TypeName,
                    Quantity = g.Quantity,
                };

            CollateralLines.Add(item);
        }

        await GuarantorRef.GuarantorReload();

    }



    async Task SelectedGuarantors(VGuarantor? g)
    {
        if (g is null || string.IsNullOrEmpty(g.Id)) return;

        var gs = new VLoanRequestGuarantors
            {
                EmployeeRefId = g.Id,
                FullName = g.FullName,
                AltName = g.GuarantorName,
                Phone = g.Phone,
                VilInKhmer = g.VilInKhmer,
                ComInKhmer = g.ComInKhmer,
                DisInKhmer = g.DisInKhmer,
                ProInKhmer = g.ProInKhmer
            };

        if (Guarantors.Any(x => x.EmployeeRefId == g.Id))
        {
            NotificationService.Notify(NotificationSeverity.Info, "Guarantor already exists");

            return;
        }

        Guarantors.Add(gs);

        await GuarantorRef.GuarantorReload();
    }


