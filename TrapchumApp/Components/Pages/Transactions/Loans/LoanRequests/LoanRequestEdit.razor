@page "/App/Request/{BranchId:int}/Branches/{UserId}/Customer/{CustomerId}/Edit"
@using Applications.Requests.Loans.LoanRequests
@using Applications.Responses.Auths
@using Applications.Responses.Lists.Collaterals
@using Applications.Responses.Loans.Disbursements
@using Applications.Responses.ViewModels.Loans.Requests
@using Applications.Responses.ViewModels.OtherNames
@using Domains.Models.Collaterals
@using Domains.Models.Loans
@using Radzen.Blazor.Rendering
<PageTitle>Loan Request</PageTitle>
<Card>
    <EditForm Model="model" @ref="editForm">
        <input type="hidden" @bind="model.LoanRequestId" />
        <FluentValidationValidator DisableAssemblyScanning="true" />
        <CardBody BodyCssClass="rz-background-color-base-200">
            <RadzenTabs SelectedIndexChanged="SelectTabIndexChanged" RenderMode="TabRenderMode.Client">
                <Tabs>
                    <RadzenTabsItem Text="សំណើរ">
                        <LoanRequestInfo Model="@model" CustomerId="@CustomerId" LoanRequestId="@LoanRequestId" BranchId="@BranchId" />
                        <RadzenFieldset>
                            <LoanRequestCollaterals CustomerId="@CustomerId"
                                                    ShowCommand="true"
                                                    ShowAdd="true"
                                                    ShowRemove="true"
                                                    @ref="CollateralRef"
                                                    Add="AddCollaterals"
                                                    RemoveCollateral="RemovedCollateral"
                                                    Collaterals="CollateralLines">
                                <SearchBoxTemplate>
                                    <CollateralSearchList CustomerId="@CustomerId"
                                                          MultipleSelected="SelectManyCollaterals"
                                                          SingleSelected="SelectedCollateral" />
                                </SearchBoxTemplate>
                            </LoanRequestCollaterals>
                            <LoanRequestGaurantor Guarantors="Guarantors"
                                                  ShowAdd="true"
                                                  Add="AddGuarantors"
                                                  ShowRemove="true"
                                                  ShowCommand="true"
                                                  Remove="RemoveGaurantor"
                                                  @ref="GuarantorRef">
                                <SearchBoxTemplate>
                                    <GuarantorSearchList OnSelected="SelectedGuarantors" SelectMany="SelectMany" />
                                </SearchBoxTemplate>
                            </LoanRequestGaurantor>
                            <LoanRequestDocument Documents="@Documents"
                                                 UploadDocument="@HandleFileDialogue"
                                                 RemoveDocument="RemoveFile"
                                                 @ref="DocumentRef"
                                                 ShowDelete="true" />
                        </RadzenFieldset>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="អតិថិជន">
                        <RadzenFieldset>
                            <CustomerRequest CustomerId="@CustomerId" />
                        </RadzenFieldset>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="Notes">
                        <RadzenFieldset>
                          <RadzenRow AlignItems="AlignItems.Center">
                              <RadzenColumn Size="12">
                                  <RadzenTextArea Rows="10" @bind-Value="model.Memo" class="form-control">

                                  </RadzenTextArea>
                              </RadzenColumn>
                          </RadzenRow>
                            <div class="comments-list">
                                @foreach (var item in _loanDescriptions ?? [])
                                {
                                    <div class="comment">
                                        <div class="comment-header">
                                            <span class="comment-author">@item.FullName</span>
                                            <span class="comment-date">@item.PretierDate</span>
                                        </div>
                                        <p>
                                            @item.Memo
                                        </p>
                                    </div>
                                }
                            </div>
                        </RadzenFieldset>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </CardBody>
        <CardFooter>
            <RadzenStack class="mt-2"
                         Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End"
                         Gap="0.5rem"
                         AlignItems="AlignItems.Center">

                <RadzenButton Disabled="model.RequestAmount <=0"
                              Size="ButtonSize.Small"
                              Click="HandleCreateNew"
                              Text="Save"
                              Icon="save"
                              ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton Disabled="model.RequestAmount <=0"
                              Size="ButtonSize.Small"
                              Click="HandleCreateRequest"
                              Text="Request"
                              Icon="save"
                              ButtonStyle="ButtonStyle.Success" />
                <RadzenLink Path="@($"/App/Request/{BranchId}/Branches?UserId={UserId}")"
                            Text="Back" />
            </RadzenStack>
        </CardFooter>
    </EditForm>
</Card>

@code
{
    RadzenTextBox textBox = default!;
    string? FullName = "";
    Popup popup = default!;
    RadzenDataGrid<VCustomerList> grid = default!;

    async Task SelectMany(IEnumerable<VGuarantor> gs)
    {
        if (!gs.Any()) return;

        var gLinks = new LoanRequestGuarantorsDtoCreate
        {
             BranchRefId=BranchId,
             CustomerRefId=CustomerId,
             LoanRequestId=LoanRequestId,
             GuarantorsLink=[]
        };

        foreach (var g in gs)
        {
            if (Guarantors.Any(x => x.EmployeeRefId == g.Id)) continue;

            var guarantor = new LoanGuarantorLink
            {
                 EntityNameRefId=g.Id,
                 IsActive=true,
                 BranchId=BranchId,
                 LoanRequestRefId=LoanRequestId
            };

            gLinks.GuarantorsLink.Add(guarantor);

            var item = new VLoanRequestGuarantors
                {
                    EmployeeRefId = g.Id,
                    FullName = g.FullName,
                    AltName = g.GuarantorName,
                    Phone = g.Phone,
                    VilInKhmer = g.VilInKhmer,
                    ComInKhmer = g.ComInKhmer,
                    DisInKhmer = g.DisInKhmer,
                    ProInKhmer = g.ProInKhmer
                };

            Guarantors.Add(item);
        }

        var rsp = await _loanRequestService.AddLoanRequestGuarantorAsync(gLinks);

        if (rsp.IsSuccess)
        {
            NotificationService.Notify(NotificationSeverity.Success, rsp.Data);
            await GuarantorRef.GuarantorReload();
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, rsp.ErrMessage);
        }

    }

    async Task SelectedGuarantors(VGuarantor? g)
    {
        if (g is null || string.IsNullOrEmpty(g.Id)) return;

        if (Guarantors.Any(x => x.EmployeeRefId == g.Id))
        {
            NotificationService.Notify(NotificationSeverity.Info, "Guarantor already exists");
            
            return;
        }

        var gLinks = new LoanRequestGuarantorsDtoCreate
        {
            BranchRefId = BranchId,
            CustomerRefId = CustomerId,
            LoanRequestId = LoanRequestId,
            GuarantorsLink = []
        };

        var guarantor = new LoanGuarantorLink
        {
            EntityNameRefId = g.Id,
            IsActive = true,
            BranchId = BranchId,
            LoanRequestRefId = LoanRequestId
        };

        gLinks.GuarantorsLink.Add(guarantor);

        var rsp = await _loanRequestService.AddLoanRequestGuarantorAsync(gLinks);

        if (rsp.IsSuccess)
        {
            NotificationService.Notify(NotificationSeverity.Success, rsp.Data);

            var gs = new VLoanRequestGuarantors
            {
                EmployeeRefId = g.Id,
                FullName = g.FullName,
                AltName = g.GuarantorName,
                Phone = g.Phone,
                VilInKhmer = g.VilInKhmer,
                ComInKhmer = g.ComInKhmer,
                DisInKhmer = g.DisInKhmer,
                ProInKhmer = g.ProInKhmer
            };

            Guarantors.Add(gs);

            await GuarantorRef.GuarantorReload();
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, rsp.ErrMessage);
        }

        
    }



    async Task SelectedCollateral(VCollateralLines? c)
    {
        if (c is null || c.Id <= 0) return;

        if (CollateralLines.Any(x => x.Id == c.Id))
        {
            NotificationService.Notify(NotificationSeverity.Info, "Collateral already exists");
            return;
        }


        var collaterals = new LoanCollateralRequest(BranchId, LoanRequestId, CustomerId);

        var collateralLink = new CollateralLink
        {
            CollateralLineRefId = c.Id,
            CollateralRefId = c.CollateralId,
            ModifiedDt = DateTime.Now
        };

        collaterals.CollateralLinesLink.Add(collateralLink);

        var rsp = await _loanRequestService.AddLoanRequestCollateralAsync(collaterals);

        if (rsp.IsSuccess)
        {
            var item = new VLoanRequestCollateralLines
            {
                CollateralLineId = c.Id,
                CollateralId = c.CollateralId,
                OwnerName = c.OwnerName,
                ReferenceNo = c.ReferenceNo,
                TypeName = c.TypeName,
                Quantity = c.Quantity,
            };

            CollateralLines.Add(item);

            await CollateralRef.CollateralReload();
        }
    }

    async Task SelectManyCollaterals(IEnumerable<VCollateralLines> cs)
    {
        if (!cs.Any()) return;

        var collaterals = new LoanCollateralRequest(BranchId,LoanRequestId,CustomerId);

        foreach (var g in cs)
        {

            if (CollateralLines.Any(x => x.CollateralId == g.CollateralId)) continue;

            var collateralLink = new CollateralLink
            {
                 CollateralLineRefId=g.Id,
                 CollateralRefId=g.CollateralId,
                 ModifiedDt=DateTime.Now
            };

            collaterals.CollateralLinesLink.Add(collateralLink);

            var item = new VLoanRequestCollateralLines
                {
                    CollateralLineId = g.Id,
                    CollateralId = g.CollateralId,
                    OwnerName = g.OwnerName,
                    ReferenceNo = g.ReferenceNo,
                    TypeName = g.TypeName,
                    Quantity = g.Quantity,
                };

            CollateralLines.Add(item);
        }

        var rsp= await _loanRequestService.AddLoanRequestCollateralAsync(collaterals);

        if (rsp.IsSuccess)
        {
            NotificationService.Notify(NotificationSeverity.Success, rsp.Data);
            await GuarantorRef.GuarantorReload();
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Success, rsp.ErrMessage);
        }

    }

