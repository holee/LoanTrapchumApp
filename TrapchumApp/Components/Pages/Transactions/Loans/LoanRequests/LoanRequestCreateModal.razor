<RadzenTabs @bind-SelectedIndex="selectedTabIndex" RenderMode="TabRenderMode.Server">
    <Tabs>
        <RadzenTabsItem Text="សំណើរ">
            <div class="m-0 p-0">
                <EditForm Model="model" @ref="editForm">
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>អតិថិជន</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="9">
                                    <RadzenDropDownDataGrid TextProperty="AltName"
                                                            Density="Density.Compact"
                                                            ValueProperty="CustomerId"
                                                            ShowSearch="false"
                                                            TValue="Guid?"
                                                            @bind-Value="model.CustomerRefId"
                                                            LoadData="LoadCustomers"
                                                            SelectedItemChanged="SelectCustomerChanged"
                                                            AllowClear="true"
                                                            PageSize="10"
                                                            class="w-50"
                                                            Disabled="@(CustomerId.IsNotNullOrEmpty())"
                                                            PagerHorizontalAlign="HorizontalAlign.Right"
                                                            ShowPagingSummary="true"
                                                            Data="Customers">
                                        <Columns>
                                            <RadzenDropDownDataGridColumn Property="CustomerId" Title="Id" />
                                            <RadzenDropDownDataGridColumn Property="AltName" Title="Name" />
                                        </Columns>
                                    </RadzenDropDownDataGrid>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>អ្នកយល់ព្រម</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="9">
                                    <RadzenDropDownDataGrid TextProperty="AprovedTitle"
                                                            Density="Density.Compact"
                                                            ValueProperty="AprovedId"
                                                            ShowSearch="false"
                                                            TValue="int?"
                                                            class="w-50"
                                                            @bind-Value="model.ApprovalLevel"
                                                            Data="AprovedLevels">
                                        <Columns>
                                            <RadzenDropDownDataGridColumn Property="AprovedTitle" Title="Name" />
                                            <RadzenDropDownDataGridColumn Property="Description" Title="Description" />
                                        </Columns>
                                    </RadzenDropDownDataGrid>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>ចំនួនទឹកប្រាក់ស្នើរសុំ</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenNumeric TextAlign="TextAlign.End"
                                                   class="w-100"
                                                   @bind-Value="model.RequestAmount"
                                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                                   Min="0.00M"
                                                   Format="#,##0.00"
                                                   TValue="decimal?"
                                                   @oninput="PrincipleValueChanged"
                                                   ShowUpDown="false">
                                    </RadzenNumeric>
                                </RadzenColumn>
                                <RadzenColumn Size="3">
                                    <RadzenDropDown Data="StorageConstant.CurrencyTpes"
                                                    class="w-100"
                                                    TextProperty="label"
                                                    ValueProperty="index"
                                                    @bind-Value="model.CurrencyRefId">
                                    </RadzenDropDown>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>ប្រាក់ប្រសិទ្ធិភាព</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="5" class="input-group">
                                    <RadzenNumeric ShowUpDown="false"
                                                   TextAlign="TextAlign.End"
                                                   class="form-control"
                                                   Min="0.00M"
                                                   Format="#,##0.00"
                                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                                   @bind-Value="model.CollectionFeeRate"
                                                   TValue="decimal?" />
                                    <span class="input-group-text">%</span>
                                </RadzenColumn>
                                <RadzenColumn Size="4" class="input-group">
                                    <RadzenDropDown Data="StorageConstant.OtherChargedModes"
                                                    TextProperty="label"
                                                    class="form-select"
                                                    Disabled
                                                    ValueProperty="index"
                                                    @bind-Value="SelectedCollectionFee">
                                    </RadzenDropDown>
                                    <span class="input-group-text">/Month</span>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>សេវ៉ារដ្ធបាល</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="5" class="input-group">
                                    <RadzenNumeric ShowUpDown="false"
                                                   TextAlign="TextAlign.End"
                                                   class="form-control"
                                                   Format="#,##0.00"
                                                   Min="0.00M"
                                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                                   @bind-Value="model.AdminFeeRate"
                                                   TValue="decimal?" />
                                    <span class="input-group-text">%</span>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>អត្រាការប្រាក់</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="5">
                                    <div class="input-group">
                                        <RadzenNumeric TValue="decimal?"
                                                       class="form-control"
                                                       Format="#,##0.00"
                                                       TextAlign="TextAlign.End"
                                                       Min="0.00M"
                                                       onclick="this.querySelector('.rz-numeric-input').select()"
                                                       ShowUpDown="false"
                                                       @bind-Value="model.InterestRate" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>រយៈពេលខ្ចីប្រាក់</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="5">
                                    <RadzenNumeric TextAlign="TextAlign.End"
                                                   ShowUpDown="false"
                                                   class="w-100"
                                                   @bind-Value="model.Installments"
                                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                                   Min="0"
                                                   TValue="int?">
                                    </RadzenNumeric>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenDropDown TextProperty="InstallmentTypeCode"
                                                    ValueProperty="InstallmentTypeCode"
                                                    @bind-Value="model.InstallmentType"
                                                    class="w-100"
                                                    Disabled
                                                    Multiple="false"
                                                    Data="LoanInstallments">
                                    </RadzenDropDown>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>កំណត់សម្គាល់</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="9">
                                    <RadzenTextArea class="w-100"
                                                    @bind-Value="model.Remark" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                </EditForm>
            </div>
        </RadzenTabsItem>
        <RadzenTabsItem Text="អតិថិជន">
            <div class="m-0 p-0">
                @if (SelectedCustomer!.CustomerId.IsNotNullOrEmpty())
                {
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">ID Card</th>
                                <td>
                                    @SelectedCustomer.IdCard
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">
                                    Customer Name
                                </th>
                                <td>
                                    @SelectedCustomer.AltName ( @SelectedCustomer.FullName )
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">
                                    Phone
                                </th>
                                <td>
                                    @SelectedCustomer.Phone
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">DateOfBirth</th>
                                <td>
                                    <span>
                                        @SelectedCustomer.DateOfBirth
                                    </span>

                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">
                                    Occupation
                                </th>
                                <td>
                                    <span>
                                        @SelectedCustomer.Occupation
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">
                                    Circle
                                </th>
                                <td>
                                    @SelectedCustomer.Circle
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">
                                    Salutation
                                </th>
                                <td>
                                    @SelectedCustomer.Salutation
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">
                                    Address
                                </th>
                                <td>
                                    @SelectedCustomer.ToString()
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">Income</th>
                                <td>@SelectedCustomer.CustomerIncomes.Sum(x => x.IncomeAmount)</td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">Expend</th>
                                <td>
                                    @SelectedCustomer.CustomerExpenses.Sum(x => x.ExpendAmount)
                                </td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 Style="min-height:25rem;height:25rem;max-height:100vh;"
                                 JustifyContent="JustifyContent.Center">
                        <RadzenText TagName="TagName.H4" TextAlign="TextAlign.Center"
                                    TextStyle="TextStyle.DisplayH4">
                            There is no customer selected.
                        </RadzenText>
                    </RadzenStack>
                }
            </div>
        </RadzenTabsItem>
        <RadzenTabsItem Text="តេស្តសាកល្បង">
            <div class="p-0 m-0">
                @if (previewSchedule.Any())
                {
                 @*    <PreviewSchedules Schedules="previewSchedule"
                                      CurrencyId="model.CurrencyRefId" /> *@
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 style="min-height:25rem;height:25rem;max-height:100vh;"
                                 JustifyContent="JustifyContent.Center">
                        <RadzenText TagName="TagName.H4" TextAlign="TextAlign.Center"
                                    TextStyle="TextStyle.DisplayH4">
                            There is no schedule to preview.
                        </RadzenText>
                    </RadzenStack>
                }
            </div>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
<RadzenStack class="mt-2"
             Orientation="Radzen.Orientation.Horizontal"
             JustifyContent="Radzen.JustifyContent.End"
             Gap="0.5rem"
             AlignItems="AlignItems.Center">
    <RadzenButton Disabled="model.RequestAmount <=0"
                  Click="ShowLoanPreviews"
                  Size="Radzen.ButtonSize.Small"
                  Icon="preview"
                  ButtonStyle="ButtonStyle.Primary" Text="Preview" />
    <RadzenButton Disabled="model.RequestAmount <=0"
                  Size="Radzen.ButtonSize.Small"
                  Click="SubmitForm"
                  Text="Save & New"
                  Icon="save"
                  ButtonStyle="ButtonStyle.Success" />
    <RadzenLink Path="@($"/Loans?BranchId={BranchId}&UserId={UserId}")"
                Text="Back" />
</RadzenStack>



