@using TCLMS.Front.Core.LoanCalculators
@using TCLMS.Shared.Entities.Models.Auth
<RadzenTabs @bind-SelectedIndex="selectedTabIndex" RenderMode="TabRenderMode.Server">
    <Tabs>
        <RadzenTabsItem Text="សំណើរ">
            <div class="m-0 p-0">
                <EditForm Model="model" @ref="editForm">
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>អតិថិជន</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="9">
                                    <RadzenDropDownDataGrid TextProperty="AltName"
                                                            Density="Density.Compact"
                                                            ValueProperty="CustomerId"
                                                            ShowSearch="false"
                                                            TValue="long?"
                                                            @bind-Value="model.CustomerRefId"
                                                            LoadData="LoadCustomers"
                                                            SelectedItemChanged="SelectCustomerChanged"
                                                            AllowClear="true"
                                                            PageSize="10"
                                                            class="w-50"
                                                            Disabled="@(CustomerId!=0)"
                                                            PagerHorizontalAlign="HorizontalAlign.Right"
                                                            ShowPagingSummary="true"
                                                            Data="Customers">
                                        <Columns>
                                            <RadzenDropDownDataGridColumn Property="CustomerId" Title="Id" />
                                            <RadzenDropDownDataGridColumn Property="AltName" Title="Name" />
                                        </Columns>
                                    </RadzenDropDownDataGrid>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>អ្នកយល់ព្រម</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="9">
                                    <RadzenDropDownDataGrid TextProperty="AprovedTitle"
                                                            Density="Density.Compact"
                                                            ValueProperty="AprovedId"
                                                            ShowSearch="false"
                                                            TValue="int?"
                                                            class="w-50"
                                                            @bind-Value="model.ApprovalLevel"
                                                            Data="AprovedLevels">
                                        <Columns>
                                            <RadzenDropDownDataGridColumn Property="AprovedTitle" Title="Name" />
                                            <RadzenDropDownDataGridColumn Property="Description" Title="Description" />
                                        </Columns>
                                    </RadzenDropDownDataGrid>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>ចំនួនទឹកប្រាក់ស្នើរសុំ</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="6">
                                    <RadzenNumeric TextAlign="TextAlign.End"
                                                   class="w-100"
                                                   @bind-Value="model.RequestAmount"
                                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                                   Min="0.00M"
                                                   Format="#,##0.00"
                                                   TValue="decimal?"
                                                   @oninput="PrincipleValueChanged"
                                                   ShowUpDown="false">
                                    </RadzenNumeric>
                                </RadzenColumn>
                                <RadzenColumn Size="3">
                                    <RadzenDropDown Data="StorageConstant.CurrencyTpes"
                                                    class="w-100"
                                                    TextProperty="label"
                                                    ValueProperty="index"
                                                    @bind-Value="model.CurrencyRefId">
                                    </RadzenDropDown>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>ប្រាក់ប្រសិទ្ធិភាព</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="5" class="input-group">
                                    <RadzenNumeric ShowUpDown="false"
                                                   TextAlign="TextAlign.End"
                                                   class="form-control"
                                                   Min="0.00M"
                                                   Format="#,##0.00"
                                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                                   @bind-Value="model.CollectionFeeRate"
                                                   TValue="decimal?" />
                                    <span class="input-group-text">%</span>
                                </RadzenColumn>
                                <RadzenColumn Size="4" class="input-group">
                                    <RadzenDropDown Data="StorageConstant.OtherChargedModes"
                                                    TextProperty="label"
                                                    class="form-select"
                                                    Disabled
                                                    ValueProperty="index"
                                                    @bind-Value="SelectedCollectionFee">
                                    </RadzenDropDown>
                                    <span class="input-group-text">/Month</span>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>សេវ៉ារដ្ធបាល</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="5" class="input-group">
                                    <RadzenNumeric ShowUpDown="false"
                                                   TextAlign="TextAlign.End"
                                                   class="form-control"
                                                   Format="#,##0.00"
                                                   Min="0.00M"
                                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                                   @bind-Value="model.AdminFeeRate"
                                                   TValue="decimal?" />
                                    <span class="input-group-text">%</span>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>អត្រាការប្រាក់</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="5">
                                    <div class="input-group">
                                        <RadzenNumeric TValue="decimal?"
                                                       class="form-control"
                                                       Format="#,##0.00"
                                                       TextAlign="TextAlign.End"
                                                       Min="0.00M"
                                                       onclick="this.querySelector('.rz-numeric-input').select()"
                                                       ShowUpDown="false"
                                                       @bind-Value="model.InterestRate" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>រយៈពេលខ្ចីប្រាក់</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="5">
                                    <RadzenNumeric TextAlign="TextAlign.End"
                                                   ShowUpDown="false"
                                                   class="w-100"
                                                   @bind-Value="model.Installments"
                                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                                   Min="0"
                                                   TValue="int?">
                                    </RadzenNumeric>
                                </RadzenColumn>
                                <RadzenColumn Size="4">
                                    <RadzenDropDown TextProperty="InstallmentTypeCode"
                                                    ValueProperty="InstallmentTypeCode"
                                                    @bind-Value="model.InstallmentType"
                                                    class="w-100"
                                                    Disabled
                                                    Multiple="false"
                                                    Data="LoanInstallments">
                                    </RadzenDropDown>
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                    <RadzenRow AlignItems="AlignItems.Center" class="mt-2">
                        <RadzenColumn Size="12">
                            <RadzenRow AlignItems="AlignItems.Center">
                                <RadzenColumn Size="3">
                                    <RadzenLabel>កំណត់សម្គាល់</RadzenLabel>
                                </RadzenColumn>
                                <RadzenColumn Size="9">
                                    <RadzenTextArea class="w-100"
                                                    @bind-Value="model.Remark" />
                                </RadzenColumn>
                            </RadzenRow>
                        </RadzenColumn>
                    </RadzenRow>
                </EditForm>
            </div>
        </RadzenTabsItem>
        <RadzenTabsItem Text="អតិថិជន">
            <div class="m-0 p-0">
                @if (SelectedCustomer!.CustomerId > 0)
                {
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">ID Card</th>
                                <td>
                                    @SelectedCustomer.IDCard
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">
                                    Customer Name
                                </th>
                                <td>
                                    @SelectedCustomer.AltName ( @SelectedCustomer.FullName )
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">
                                    Phone
                                </th>
                                <td>
                                    @SelectedCustomer.Phone
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">DateOfBirth</th>
                                <td>
                                    <span>
                                        @SelectedCustomer.DateOfBirth
                                    </span>

                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">
                                    Occupation
                                </th>
                                <td>
                                    <span>
                                        @SelectedCustomer.Occupation
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">
                                    Circle
                                </th>
                                <td>
                                    @SelectedCustomer.Circle
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">
                                    Salutation
                                </th>
                                <td>
                                    @SelectedCustomer.Salutation
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">
                                    Address
                                </th>
                                <td>
                                    @SelectedCustomer.ToString()
                                </td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">Income</th>
                                <td>@SelectedCustomer.CustomerIncomes.Sum(x => x.IncomeAmount)</td>
                            </tr>
                            <tr>
                                <th style="background-color:#F1F1F4" class="w-25">Expend</th>
                                <td>
                                    @SelectedCustomer.CustomerExpenses.Sum(x => x.ExpendAmount)
                                </td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 Style="min-height:25rem;height:25rem;max-height:100vh;"
                                 JustifyContent="JustifyContent.Center">
                        <RadzenText TagName="TagName.H4" TextAlign="TextAlign.Center"
                                    TextStyle="TextStyle.DisplayH4">
                            There is no customer selected.
                        </RadzenText>
                    </RadzenStack>
                }
            </div>
        </RadzenTabsItem>
        <RadzenTabsItem Text="តេស្តសាកល្បង">
            <div class="p-0 m-0">
                @if (previewSchedule.Any())
                {
                    <PreviewSchedules Schedules="previewSchedule"
                                      CurrencyId="model.CurrencyRefId" />
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center"
                                 style="min-height:25rem;height:25rem;max-height:100vh;"
                                 JustifyContent="JustifyContent.Center">
                        <RadzenText TagName="TagName.H4" TextAlign="TextAlign.Center"
                                    TextStyle="TextStyle.DisplayH4">
                            There is no schedule to preview.
                        </RadzenText>
                    </RadzenStack>
                }
            </div>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>
<RadzenStack class="mt-2"
             Orientation="Radzen.Orientation.Horizontal"
             JustifyContent="Radzen.JustifyContent.End"
             Gap="0.5rem"
             AlignItems="AlignItems.Center">
    <RadzenButton Disabled="model.RequestAmount <=0"
                  Click="ShowLoanPreviews"
                  Size="Radzen.ButtonSize.Small"
                  Icon="preview"
                  ButtonStyle="ButtonStyle.Primary" Text="Preview" />
    <RadzenButton Disabled="model.RequestAmount <=0"
                  Size="Radzen.ButtonSize.Small"
                  Click="SubmitForm"
                  Text="Save & New"
                  Icon="save"
                  ButtonStyle="ButtonStyle.Success" />
    <RadzenLink Path="@($"/Loans?BranchId={BranchId}&UserId={UserId}")"
                Text="Back" />
</RadzenStack>
@code {
    [Parameter, SupplyParameterFromQuery] public int BranchId { get; set; }
    [Parameter, SupplyParameterFromQuery] public long UserId { get; set; }
    [Parameter] public long CustomerId { get; set; } = 0;
    [CascadingParameter]
    Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    IEnumerable<LoanScheduleDtoCreate> previewSchedule = [];
    IEnumerable<AprovePerson> AprovedLevels = [];
    IEnumerable<VCustomerList> Customers = [];
    LoanRequestDtoCreate model = new();
    DateTime? RegisterDate = DateTime.Now;
    IEnumerable<VBranch> Branches = Enumerable.Empty<VBranch>();
    IEnumerable<LoanInstallmentTypeDto>? LoanInstallments = [];
    SelectedCreditAgent? selectCreditAgent = new();
    EditForm editForm = default!;
    LoanInstallmentTypeDto? SelectedInstallment { get; set; }
    VCustomerList? SelectedCustomer = new();
    bool isVible = false;
    int selectedTabIndex = 0;
    bool isProgressing = false;
    bool isCollateralTab = false;
    bool isPreviewScheduleTab = false;
    int SelectedCollectionFee = 1;
    decimal? TotalAdminFee = 0;
    int SelectedPeriodName = 1;
    int installId = 1;
    string branchName = "";
    string customerName = "";
    protected override async Task OnParametersSetAsync()
    {
        LoanInstallments = await _loanSettingService!.GetLoanInstallmentTypes();
        var branchResponse = await _branchService.GetBranchByIdAsync(BranchId);
        if (branchResponse.IsSuccess)
        {
            branchName = branchResponse.Data!.BranchName;
        }
        await base.OnParametersSetAsync();
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (CustomerId > 0)
            {
                await GetCustomers(CustomerId, 10);
            }
            else
            {
                await GetCustomers(CustomerId, 10);
            }

            var resp = await _customerService.GetCustomerDetailsAsync(CustomerId);

            if (resp.IsSuccess)
            {
                SelectedCustomer = resp.Data!;

                model.CustomerRefId = SelectedCustomer.CustomerId;

            }

            var aproveResp = await _settingsServiceImpl.GetAprovedUserAsync(BranchId);

            if (aproveResp.IsSuccess)
            {
                AprovedLevels = aproveResp.Data!;
            }
            SetDefault();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, ex.Message);
        }

        await base.OnInitializedAsync();
    }


    private async Task GetCustomers(long customerId = 0, int take = 10, string? filter = null)
    {
        var customerResponse = await _customerService!.GetCustomersAsync(customerId, take, false, true, filter);

        if (customerResponse.IsSuccess)
        {
            Customers = customerResponse.Data!;
        }
        else
        {
            Customers = [];
            var error = customerResponse.Errors!.FirstOrDefault();
            NotificationService.Notify(NotificationSeverity.Error, error);
        }


    }

    private async Task LoadCustomers(LoadDataArgs e)
    {
        //
        var filterText = e.Filter ?? "";

        var customersResponse = await _customerService!.GetCustomersAsync(0, e.Top!.Value, false, false, filterText);

        if (!customersResponse.IsSuccess)
        {
            Customers = [];
            var error = customersResponse.Errors!.FirstOrDefault();
            NotificationService.Notify(NotificationSeverity.Error, error);
        }
        else
        {
            Customers = customersResponse.Data!;
        }

    }


    void SetDefault()
    {
        model.CurrencyRefId = 1;
        model.InterestRate = 1.10M;
        model.CollectionFeeRate = 2.90M;
        model.AdminFeeRate = 3.00M;
        model.Installments = 12;
        model.InstallmentType = "Monthly";
        model.RequestAmount = 0.00M;
        previewSchedule = [];
    }
    protected async Task SubmitForm()
    {
        editForm.EditContext!.Validate();
        var calculator = SelectLoanType(3);
        calculator.PayEvery = 1;
        calculator.EffectiveRate = model.CollectionFeeRate!.Value;
        calculator.CollectionFeeMode = SelectedCollectionFee;
        calculator.InstallmentTypeId = 1;
        calculator.CurrencyId = model.CurrencyRefId!.Value;
        var schedule = calculator.Calculate(model.Installments, model.InterestRate, model.RequestAmount);
        var scheduleDto = schedule.Select(x => new LoanRequestScheduleCreateDto
            {
                InstallmentNo = x.InstallmentNo,
                Principal = x.Principal,
                InterestAmount = x.Interest,
                CollectionFeeAmount = x.CollectionFeeAmount,
                LoanOutstanding = x.OutStanding,
                TotalPay = x.TotalPay
            }).ToList();
        try
        {
            model.RequestUserRefId = UserId;
            model.RequestDate = DateTime.UtcNow;
            model.RepaymentMode = "Flat";
            model.LoanRequestStatusRefId = 1;
            model.BranchRefId = BranchId;
            //model.LoanRequestSchedules.AddRange(scheduleDto);
            var resp = await _loanRequestService.CreateLoanRequest(model);
            if (resp.IsSuccess)
            {
                NotificationService.Notify(NotificationSeverity.Error, resp.Data!.Message);
                NavigationManager.NavigateTo("Loan/Request");
            }
            else
            {
                var errMessage = resp.Errors!.First();
                NotificationService.Notify(NotificationSeverity.Error, errMessage);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, ex.Message);
        }

    }

    private LoanCaloulator SelectLoanType(int? paymentMode)
    {
        return paymentMode switch
        {
            1 => new Balloon(),
            2 => new Decline(),
            3 => new Flat(),
            4 => new Annuarity(),
            _ => new Flat(),
        };
    }

    void PrincipleTextChanged(decimal? principle)
    {
        if (principle is null || principle < 0)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Invalid principle input");
            model.RequestAmount = 0.00M;
            return;
        }

        if (principle <= 50000)
        {
            model.CurrencyRefId = 2;
            model.AdminFeeAmount = (model.RequestAmount!.Value * (model.AdminFeeRate!.Value / 100)).RoundUp(2);
        }
        else
        {
            model.CurrencyRefId = 1;
            model.AdminFeeAmount = (model.RequestAmount!.Value * (model.AdminFeeRate!.Value / 100)).RoundUp(-2);
        }
    }



    void PrincipleValueChanged(ChangeEventArgs e)
    {
        var principle = e.Value?.ToNumer<decimal>();

        if (principle is null || principle < 0)
        {
            NotificationService.Notify(NotificationSeverity.Warning, "Invalid principle input");
            model.RequestAmount = 0.00M;
            return;
        }

        if (principle <= 50000)
        {
            model.CurrencyRefId = 2;
            model.AdminFeeAmount = (principle.Value * (model.AdminFeeRate!.Value / 100)).RoundUp(2);
        }
        else
        {
            model.CurrencyRefId = 1;
            model.AdminFeeAmount = (principle!.Value * (model.AdminFeeRate!.Value / 100)).RoundUp(-2);
        }
    }


    void ShowLoanPreviews()
    {
        if (model.RequestAmount == 0) return;
        selectedTabIndex = 2;
        var calculator = SelectLoanType(3);
        calculator.PayEvery = 1;
        calculator.EffectiveRate = model.CollectionFeeRate!.Value;
        calculator.StartDate = DateTime.Now;
        calculator.FirstPayment = DateTime.Now.AddMonths(1);
        calculator.CollectionFeeMode = SelectedCollectionFee;
        calculator.InstallmentTypeId = 1;
        calculator.CurrencyId = model.CurrencyRefId!.Value;
        var schedule = calculator.Calculate(model.Installments!.Value, model.InterestRate!.Value, model.RequestAmount!.Value);
        previewSchedule = schedule.Select(x => new LoanScheduleDtoCreate
            {
                InstallmentNo = x.InstallmentNo,
                PaymentDate = x.PaymentDate,
                Principal = x.Principal,
                Interest = x.Interest,
                CollectionFee = x.CollectionFeeAmount,
                LoanOutstanding = x.OutStanding,
                TotalDay = x.TotalDay,
                TotalPay = x.TotalPay,
                AgentRefId = selectCreditAgent!.Id,
                ScheduleStatusRefId = 2

            }).ToList();
    }

    void SelectedInstallmentChanged(object arg)
    {
        if (arg is not null)
        {
            var installType = (LoanInstallmentTypeDto)arg;
            installId = installType.InstallmentTypeId;
            model.InstallmentType = installType.InstallmentTypeCode;
        }


    }
    protected async void SelectCustomerValueChanged()
    {
        previewSchedule = [];

        if (model.CustomerRefId > 0)
        {
            var customerResponse = await _customerService.GetCustomerForRequestLoanAsync(CustomerId);

            if (customerResponse.IsSuccess)
            {
                SelectedCustomer = customerResponse.Data!;
            }
        }
        else
        {
            SelectedCustomer = new();
        }
        StateHasChanged();
    }



    async void SelectCustomerChanged(object? e)
    {
        if (e is not null)
        {
            var id = ((VCustomerList)e).CustomerId;
            var customerResponse = await _customerService.GetCustomerForRequestLoanAsync(id);
            if (customerResponse.IsSuccess)
            {
                //model.CustomerRefId = id;
                SelectedCustomer = customerResponse.Data!;
            }
            else
            {
                SelectedCustomer = new();
            }
        }
        else
        {
            SelectedCustomer = new();
        }
        StateHasChanged();
    }

}


