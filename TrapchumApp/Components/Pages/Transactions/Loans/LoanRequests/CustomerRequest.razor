
@using TrapchumApp.Components.Pages.Lists.Customers
<table class="table table-bordered">
    <tbody>
        <tr>
            <th class="w-25">
                Customer Name
            </th>
            <td>
                @Customer?.AltName (@Customer?.FullName )
            </td>
        </tr>
        <tr>
            <th class="w-25">
                Phone
            </th>
            <td>
                @Customer?.Phone
            </td>
        </tr>
        <tr>
            <th class="w-25">DateOfBirth</th>
            <td>
                <span>
                    @Customer?.DateOfBirth
                </span>

            </td>
        </tr>
        <tr>
            <th class="w-25">
                Occupation
            </th>
            <td>
                <span>
                    @Customer?.Occupation
                </span>
            </td>
        </tr>
        <tr>
            <th class="w-25">ID Card</th>
            <td>
                @Customer?.IdCard
            </td>
        </tr>
        <tr>
            <th class="w-25">
                Circle
            </th>
            <td>
                @Customer?.Circle
            </td>
        </tr>
        <tr>
            <th class="w-25">
                Salutation
            </th>
            <td>
                @Customer?.Salutation
            </td>
        </tr>
        <tr>
            <th class="w-25">
                Address
            </th>
            <td>
                @Customer?.ToString()
            </td>
        </tr>
        <tr>
            <th class="w-25">Income</th>
            <td>@Customer?.CustomerIncomes.Sum(x => x.IncomeAmount)</td>
        </tr>
        <tr>
            <th class="w-25">Expend</th>
            <td>
                @Customer?.CustomerExpenses.Sum(x => x.ExpendAmount)
            </td>
        </tr>
    </tbody>
</table>
<RadzenRow AlignItems="AlignItems.Center">
    <RadzenColumn Size="12" SizeMD="6">
        <Card>
            <CardHeader>
                <strong>Income</strong>
            </CardHeader>
            <CardBody>
                <CustomerInc CustomerId="CustomerId" ShowAdd="true" ShowReload="false" />
            </CardBody>
        </Card>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeMD="6">
        <Card>
            <CardHeader>
                <strong>Expense</strong>
            </CardHeader>
            <CardBody>
                <CustomerExp CustomerId="CustomerId" ShowAdd="true" ShowReload="false" />
            </CardBody>
        </Card>
    </RadzenColumn>
</RadzenRow>

