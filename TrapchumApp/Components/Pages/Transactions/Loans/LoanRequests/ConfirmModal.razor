@using TCLMS.Shared.Entities.ViewModels.Auths
<Containers Fluid CssClass="rz-background-color-base-100 rz-p-2">
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
        <RadzenColumn Size="3">
            Customer
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenTextBox Value="@AltName" class="w-100" ReadOnly />
            <input type="hidden" value="@CustomerId" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
        <RadzenColumn Size="3">
            Request By
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenTextBox Value="@RequestUserName" ReadOnly class="w-100" />
            <input type="hidden" value="@RequestUserId" />

        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
        <RadzenColumn Size="3">
            Branch
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenTextBox Value="@BranchName" class="w-100" ReadOnly />
            <input type="hidden" value="@BranchId" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
        <RadzenColumn Size="3">
            Amount
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenNumeric ReadOnly
                           class="w-100" Value="@AprovedAmount"
                           ShowUpDown="false" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
        <RadzenColumn Size="3">
            Accept By
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenTextBox Value="@AprovedUserName" ReadOnly class="w-100" />
            <input type="hidden" value="@AprovedUserId" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
        <RadzenColumn Size="3">
            Note
        </RadzenColumn>
        <RadzenColumn Size="9">
            <RadzenTextArea class="w-100" @bind-Value="memo" />
        </RadzenColumn>
    </RadzenRow>
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End"
                 Orientation="Orientation.Horizontal">
        <RadzenButton Text="Save"
                      ButtonStyle="ButtonStyle.Success"
                      Click="LoanRequestVerified"
                      Size="Radzen.ButtonSize.ExtraSmall"
                      Icon="Save"></RadzenButton>
        <RadzenButton Text="Close"
                      ButtonStyle="ButtonStyle.Danger"
                      Size="Radzen.ButtonSize.ExtraSmall"
                      Variant="Variant.Filled"
                      Click="@(()=>DialogService.Close(false))"
                      Icon="cancel"></RadzenButton>
    </RadzenStack>
</Containers>

@code {
    [Parameter] public string AltName { get; set; } = string.Empty;
    [Parameter] public long CustomerId { get; set; }
    [Parameter] public string BranchName { get; set; } = string.Empty;
    [Parameter] public string RequestUserName { get; set; } = string.Empty;
    [Parameter] public long RequestUserId { get; set; }
    [Parameter] public string AprovedUserName { get; set; } = string.Empty;
    [Parameter] public long AprovedUserId { get; set; } = 0;
    [Parameter] public int BranchId { get; set; } = 0;
    [Parameter] public decimal AprovedAmount { get; set; } = 0;
    [Parameter] public decimal AdmindFeeAmount { get; set; } = 0;
    [Parameter] public long LoanRequestId { get; set; } = 0;
    string memo = "";
    async void LoanRequestVerified()
    {

        var confirm = await DialogService.Confirm("Are you sure to aprove this loan request", "Loan Request");

        if (confirm == true)
        {

            var model = new AproveLoanDtoCreate(BranchId, CustomerId, LoanRequestId, AprovedAmount, AdmindFeeAmount, DateTime.Now, memo);
            
            var resp = await _loanRequestService.AprovedLoanReuqest(model);

            if (resp.IsSuccess)
            {
                NotificationService.Notify(NotificationSeverity.Success, resp.Data!.Message);
                DialogService.Close(true);
            }
            else
            {
                var errorMessage = resp.Errors!.First();
                NotificationService.Notify(NotificationSeverity.Error, errorMessage);
            }
        }
    }





