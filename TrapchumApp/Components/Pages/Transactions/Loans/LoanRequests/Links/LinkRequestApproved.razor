@using Applications.Enumerations
@using Applications.Responses.ViewModels.Loans.Requests
@if (LoanRequest?.StatusId == (int)RequestStatus.Requested || LoanRequest?.StatusId == (int)RequestStatus.Verified)
{
    <NavLink href="@loanRequestUrl">
        <RadzenBadge Variant="Variant.Filled"
                     Style="font-size:0.7rem;"
                     Text="Check" BadgeStyle="BadgeStyle.Secondary" />
    </NavLink>
}
else
{
    <NavLink href="@loanRequestDetailsUrl">
        <RadzenBadge Variant="Variant.Text"
                     Style="font-size:0.7rem;"
                     Text="Details" BadgeStyle="BadgeStyle.Secondary" />
    </NavLink>
}


@code {
    [Parameter] public VLoanRequests? LoanRequest { get; set; }
    [Parameter] public string? UserId { get; set; }
    [Parameter] public int? BranchId { get; set; }
    string loanRequestUrl = "";
    string loanRequestDetailsUrl = "";

    protected override void OnParametersSet()
    {

        //"App/Loan/{BranchId}/Branches/Request/Details?UserId={UserId}&CustomerId={LoanRequest?.CustomerId}&LoanRequestId={LoanRequest?.LoanRequestId}")
        loanRequestUrl = $"App/Loan/{BranchId}/Branches/Request/Details?UserId={UserId}&CustomerId={LoanRequest?.CustomerId}&LoanRequestId={LoanRequest?.LoanRequestId}";
        //loanRequestDetailsUrl = $"/Loan/Request/{LoanRequest?.LoanRequestId}/Details?CustomerId={LoanRequest?.CustomerId}&BranchId={BranchId}&UserId={UserId}";
        loanRequestDetailsUrl = $"App/Loan/{BranchId}/Branches/Request/Details?UserId={UserId}&CustomerId={LoanRequest?.CustomerId}&LoanRequestId={LoanRequest?.LoanRequestId}";
        base.OnParametersSet();
    }

}
