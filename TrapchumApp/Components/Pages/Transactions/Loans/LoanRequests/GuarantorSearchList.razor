@using Applications.Responses.ViewModels.Loans.Requests
@using Applications.Responses.ViewModels.OtherNames
@using Radzen.Blazor.Rendering
<style type="text/css">
    .my-popup2 {
        display: none;
        position: absolute;
        overflow: hidden;
        height: 300px;
        width: 50%;
        border: var(--rz-panel-border);
        background-color: var(--rz-panel-background-color);
        box-shadow: var(--rz-panel-shadow);
        border-radius: var(--rz-border-radius)
    }
</style>
<RadzenStack AlignItems="AlignItems.Center"
             Orientation="Orientation.Horizontal" class="rz-my-1">
    <RadzenTextBox @onclick="@OpenPopup"
                   @ref="@_guarantorSearchText"
                   @bind-Value="@FullName"
                   @onkeydown="@OnKeyDown"
                   Placeholder="Search Guarantor...."
                   @oninput="@OnGuarantorSearchText" />
    <Popup @ref="@_guarantorPopup" id="pGuarantorSearchText"
           autoFocusFirstElement="false"
           class="my-popup2">
        <RadzenDataGrid @ref="@_gridGuarantors"
                        id="grid1GuarantorSearchText"
                        TItem="VGuarantor"
                        Data="@_guarantors"
                        Density="Density.Compact"
                        AllowAlternatingRows="true"
                        GridLines="DataGridGridLines.Both"
                        Responsive="true"
                        AllowSorting="true"
                        ColumnWidth="10rem"
                        AllowPaging="true"
                        AllowRowSelectOnRowClick="@allowRowSelectOnRowClick"
                        SelectionMode="DataGridSelectionMode.Multiple"
                        ShowPagingSummary="true"
                        @bind-Value="@SelectedGuarantors"
                        Count="@counts"
                        PageSize="10"
                        Style="height:100%;width:100%;">
            <Columns>
                <RadzenDataGridColumn Title="#"
                                      TextAlign="TextAlign.Center"
                                      Context="g"
                                      Width="3rem"
                                      Sortable="false"
                                      Property="@(nameof(VGuarantor.Id))">
                    <Template>
                        <RadzenCheckBox InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "Select item" }})"
                                        TriState="false"
                                        Value="@(SelectedGuarantors.Any() && SelectedGuarantors.Contains(g))"
                                        Change=@(args => { if(!allowRowSelectOnRowClick) { _gridGuarantors.SelectRow(g); }})
                                        TValue="bool" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="@nameof(VGuarantor.FullName)" Title="FullName" />
                <RadzenDataGridColumn Width="8rem" Property="@nameof(VGuarantor.Gender)" Title="Salutation" />
                <RadzenDataGridColumn Width="8rem" Property="@nameof(VGuarantor.Phone)" Title="Phone" />
                <RadzenDataGridColumn Width="8rem"
                                      TextAlign="TextAlign.Center"
                                      Property="@nameof(VGuarantor.NumberOfLoan)" Title="Loans" />
                <RadzenDataGridColumn Width="5rem"
                                      TextAlign="TextAlign.Center"
                                      Context="g" Property="@nameof(VGuarantor.Id)" Title="Action">
                    <Template>
                        <RadzenButton Icon="add_task"
                                      Click="@(()=>GetSelectedGuarantor(g))"
                                      Size="ButtonSize.ExtraSmall"
                                      Variant="Variant.Outlined" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
            <FooterTemplate>
                <RadzenStack AlignItems="AlignItems.Center"
                             Orientation="Orientation.Horizontal"
                             class="rz-m-2"
                             JustifyContent="JustifyContent.End">
                    <RadzenButton Icon="done_all"
                                  Text="Accept"
                                  Click="@(()=>GetSelectedGuarantors(SelectedGuarantors))"
                                  Size="ButtonSize.ExtraSmall" />
                </RadzenStack>
            </FooterTemplate>
        </RadzenDataGrid>

    </Popup>
</RadzenStack>
