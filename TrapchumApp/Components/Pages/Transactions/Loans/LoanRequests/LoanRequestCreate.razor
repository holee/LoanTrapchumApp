@page "/App/Request/{BranchId:int}/Branches/{UserId}/CreateNew"
@using Applications.Responses.Auths
@using Applications.Responses.Loans.Disbursements
@using Radzen.Blazor.Rendering
@attribute [MustHasPermission(Modules.LoanRequest,Feature.Read)]
<PageTitle>Create New</PageTitle>
<EditForm Model="model" @ref="editForm">
        <FluentValidationValidator DisableAssemblyScanning="true" />
        <CardBody BodyCssClass="rz-background-color-base-200">
            <RadzenTabs SelectedIndexChanged="SelectTabIndexChanged" RenderMode="TabRenderMode.Server">
                <Tabs>
                    <RadzenTabsItem Text="សំណើរ">
                        <LoanRequestInfo SelectCustomer="@SetCustomer" BranchId="@BranchId" model="@model" />
                        <RadzenFieldset>
                            <LoanRequestCollaterals CustomerId="CustomerId"
                                                    ShowCommand="true"
                                                    ShowAdd="true"
                                                    ShowRemove="true"
                                                    @ref="CollateralRef"
                                                    Add="AddCollaterals"
                                                    RemoveCollateral="RemovedCollateral"
                                                    Collaterals="CollateralLines">
                                                    <SearchBoxTemplate>
                                                        <CollateralSearchList CustomerId="@CustomerId"/>
                                                    </SearchBoxTemplate>
                                                </LoanRequestCollaterals>

                            <LoanRequestGaurantor Guarantors="Guarantors"
                                                  ShowAdd="true"
                                                  Add="AddGuarantors"
                                                  ShowRemove="true"
                                                  ShowCommand="true"
                                                  Remove="RemoveGaurantor"
                                                  @ref="GuarantorRef">
                                <SearchBoxTemplate>
                                    <GuarantorSearchList />

                                                  </SearchBoxTemplate>
                                              </LoanRequestGaurantor>
                            <LoanRequestDocument Documents="@Documents"
                                                 UploadDocument="@HandleFileDialogue"
                                                 RemoveDocument="RemoveFile"
                                                 @ref="DocumentRef"
                                                 ShowDelete="true" />
                        </RadzenFieldset>
                    </RadzenTabsItem>
                    <RadzenTabsItem Text="អតិថិជន">
                        <RadzenFieldset>
                                <CustomerRequest CustomerId="@CustomerId" />
                        </RadzenFieldset>
                    </RadzenTabsItem>
                </Tabs>
            </RadzenTabs>
        </CardBody>
        <CardFooter>
            <RadzenStack class="mt-2"
                         Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End"
                         Gap="0.5rem"
                         AlignItems="AlignItems.Center">

                <RadzenButton 
                              Size="ButtonSize.Small"
                              Click="HandleCreateNew"
                              Text="Save"
                              Icon="save"
                              ButtonStyle="ButtonStyle.Primary" />
                <RadzenButton 
                              Size="ButtonSize.Small"
                              Click="HandleCreateRequest"
                              Text="Request"
                              Icon="save"
                              ButtonStyle="ButtonStyle.Success" />
                <RadzenLink Path="@($"/App/Request/{BranchId}/Branches/?UserId={UserId}")"
                            Text="Back" />
            </RadzenStack>
        </CardFooter>
    </EditForm>
@code
{

    RadzenTextBox textBox = default!;
    string? FullName = "";
    Popup popup = default!;
    RadzenDataGrid<VCustomerList> grid = default!;

    async Task OnRowSelect(VCustomerList customer)
    {
        FullName = "";
        model.CustomerRefId = customer.CustomerId;
        CustomerId = customer.CustomerId;
        FullName = customer.FullName;
        await popup.CloseAsync();
    }


    int selectedIndex = 0;

    async Task OnInput(ChangeEventArgs args)
    {
        selectedIndex = 0;

        filterText = args.Value!.ToString();

        if (string.IsNullOrEmpty(filterText))
        {
            model.CustomerRefId = string.Empty;
            CustomerId = string.Empty;
            FullName = string.Empty;
        }

        await GetCustomers(CustomerId, 25, filterText);

        await grid.Reload();
    }

    async Task OnKeyDown(KeyboardEventArgs args)
    {
        var items = Customers;

        var popupOpened = await js.InvokeAsync<bool>("Radzen.popupOpened", "popup");

        var key = args.Code != null ? args.Code : args.Key;

        if (!args.AltKey && (key == "ArrowDown" || key == "ArrowUp"))
        {
            var result = await js.InvokeAsync<int[]>("Radzen.focusTableRow", "grid", key, selectedIndex, null, false);

            selectedIndex = result.First();
        }
        else if (args.AltKey && key == "ArrowDown" || key == "Enter" || key == "NumpadEnter")
        {
            if (popupOpened && (key == "Enter" || key == "NumpadEnter"))
            {
                CustomerId = items.ElementAtOrDefault(selectedIndex)?.CustomerId;
            }

            await popup.ToggleAsync(textBox.Element);
        }
        else if (key == "Escape" || key == "Tab")
        {
            await popup.CloseAsync();
        }
    }


    async Task OpenPopup(MouseEventArgs arg)
    {
        await popup.ToggleAsync(textBox.Element);
    }
}