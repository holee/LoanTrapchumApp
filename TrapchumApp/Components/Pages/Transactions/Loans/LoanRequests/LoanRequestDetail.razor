@page "/App/Loan/{BranchId:int}/Branches/Request/Details"
@using Applications.Enumerations
@using TrapchumApp.Components.Pages.Lists.Customers
@attribute [MustHasPermission(Modules.LoanRequest, Feature.Read)]
<PageTitle>Details</PageTitle>
<RadzenFieldset Text="Loan Request">
    <Containers Fluid>
        <table class="table table-bordered">
            <tbody>
                <tr>
                    <th class="w-25">ចំនួនទឹកប្រាក់ស្នើរសុំ</th>
                    <td class="text-end">
                        @data?.RequestAmount.Format(data.CurrencyId)
                    </td>
                    <th class="w-25">ប្រភេទបង់រំលោះ</th>
                    <td>
                        @data?.RepaymentMode
                    </td>
                </tr>
                <tr>
                    <th class="w-25">ខ្ចីលើកទី</th>
                    <td class="text-end">
                        @data?.Circle
                    </td>
                    <th class="w-25">រយៈពេលខ្ចីប្រាក់</th>
                    <td>
                        @data?.Installments @data?.InstallmentType
                    </td>
                </tr>
                <tr>
                    <th class="w-25">ប្រាក់ប្រសិទ្ធិភាព</th>
                    <td class="text-end">
                        @data?.CollectionFeeRate (%)
                    </td>
                    <th class="w-25">ប្រភេទកម្ចី</th>
                    <td>
                        @data?.LoanCategoryName
                    </td>
                </tr>
                <tr>
                    <th class="w-25">អត្រាការប្រាក់</th>
                    <td class="text-end">
                        @data?.InterestRate (%)
                    </td>
                    <th class="w-25">ថ្ងៃខ្ចីប្រាក់</th>
                    <td>
                        @data?.RequestDate.DayFirst()
                    </td>
                </tr>
                <tr>
                    <th class="w-25">សេវារដ្ឋបាល</th>
                    <td class="text-end">
                        @data?.AdminFeeAmount.Format(data?.CurrencyId)
                    </td>
                    <th class="w-25">ថ្ងៃបង់ប្រាក់លើកដំបូង</th>
                    <td>
                        @data?.FirstPaymentDate.DayFirst()
                    </td>
                </tr>
                <tr>
                    <th class="w-25">ស្ថានភាព</th>
                    <td class="text-end">
                        @data?.Status
                    </td>
                    <th class="w-25">ថ្ងៃពិនិត្យ</th>
                    <td>
                        @data?.AprovedDate.DayFirst()
                    </td>
                </tr>
                <tr>
                    <th class="w-25">មន្ត្រីស្នើរសុំ</th>
                    <td class="text-end">
                        @data?.Summiter
                    </td>
                    <th class="w-25">អ្នកអនុម័ត្ត</th>
                    <td>
                        @data?.AprovedBy
                    </td>
                </tr>
            </tbody>
        </table>
    </Containers>
    <RadzenTabs RenderMode="TabRenderMode.Server">
        <Tabs>
            <RadzenTabsItem Text="ព័ត៌មានអតិថិជន">
                <LoanRequestCustomer Customer="@data?.Customer" @key="@(Guid.NewGuid().ToString("N"))" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="ទ្រព្យបញ្ចាំនិងអ្នកធានា">
                <LoanCollateralLine CollateralLines="@data?.Collaterals" @key="@(Guid.NewGuid().ToString("N"))" />
                <LoanRequestGaurantor Guarantors="@data?.Guarantors" @key="@(Guid.NewGuid().ToString("N"))" />
            </RadzenTabsItem>
            <RadzenTabsItem Text="ចំណូលនិងចំណាយ">
                <RadzenRow AlignItems="AlignItems.Center">
                    <RadzenColumn Size="6" SizeMD="6" SizeSM="12">
                        <CustomerInc Items="@data!.Customer.CustomerIncomes" ShowAdd="false"
                                     @key="@(Guid.NewGuid().ToString("N"))" />
                    </RadzenColumn>
                    <RadzenColumn Size="6" SizeMD="6" SizeSM="12">
                        <CustomerExp Items="@data!.Customer.CustomerExpenses" ShowAdd="false"
                                     @key="@(Guid.NewGuid().ToString("N"))" />
                    </RadzenColumn>
                </RadzenRow>
            </RadzenTabsItem>
            <RadzenTabsItem Text="ឯកសារផ្សេងៗ">
                <LoanRequestDocument Documents="@data?.Documents.ToList()" ShowUpload="false"
                                     @key="@(Guid.NewGuid().ToString("N"))" />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>
</RadzenFieldset>
<RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal"
             class="rz-m-2"
             JustifyContent="JustifyContent.End">
    <AuthorizeView Policy="@RequestsPolicies.Request">
        <Authorized>
            @if (canAllow && (data?.StatusId == (int)RequestStatus.New ||
                        data?.StatusId == (int)RequestStatus.Rechecked))
            {
                <RadzenButton ButtonStyle="ButtonStyle.Primary"
                              Icon="request_quote" Size="ButtonSize.ExtraSmall"
                              Click="ApplyLoanRequest"
                              Text="Request Now"></RadzenButton>
                <RadzenLink Icon="edit"
                            IconColor="@Colors.Success"
                            Path="@($"App/Request/{BranchId}/Branches/{UserId}/{CustomerId}/Customer/Edit?LoanRequestId={LoanRequestId}")">
                    Edit
                </RadzenLink>
            }
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@RequestsPolicies.Approve">
        <Authorized>
            @if (canApprove && (data?.StatusId == (int)RequestStatus.Requested ||
                        data?.StatusId == (int)RequestStatus.Verified))
            {
                <RadzenButton ButtonStyle="ButtonStyle.Primary"
                              Icon="request_quote" Size="ButtonSize.ExtraSmall"
                              Click="SaveLoanRequest"
                              Text="Save"></RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Success"
                              Icon="request_quote" Size="ButtonSize.ExtraSmall"
                              Click="AprovedLoanRequest"
                              Text="Approved"></RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Secondary"
                              Icon="request_quote" Size="ButtonSize.ExtraSmall"
                              Click="DeniedLoanRequest"
                              Text="Denied"></RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Primary"
                              Icon="request_quote" Size="ButtonSize.ExtraSmall"
                              Click="RecheckedLoanRequest"
                              Text="Rechecked"></RadzenButton>
            }
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Policy="@RequestsPolicies.Disburse">
        <Authorized>
            @if ((data?.StatusId == (int)RequestStatus.Aprove))
            {
                <RadzenButton ButtonStyle="ButtonStyle.Primary"
                              Icon="request_quote" Size="ButtonSize.ExtraSmall"
                              Click="SaveLoanRequest"
                              Text="Save"></RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Success"
                              Icon="request_quote" Size="ButtonSize.ExtraSmall"
                              Click="AprovedLoanRequest"
                              Text="Disburse Now"></RadzenButton>
            }
        </Authorized>
    </AuthorizeView>
    <RadzenLink Icon="arrow_back" Text="Back"
                Match="NavLinkMatch.All"
                Path="@($"/App/Request/{BranchId}/Branches?UserId={UserId}")"/>

</RadzenStack>