@page "/Loans/WriteOff"
<PageTitle>Loan Write Off</PageTitle>
<BCard>
    <CardBody>
        <RadzenRow AlignItems="AlignItems.Center" RowGap="1rem" class="mb-2">
            <RadzenColumn SizeSM="2" Size="6">
                <PageDropDown></PageDropDown>
            </RadzenColumn>
            <RadzenColumn SizeSM="1" Size="6">
                <RadzenButton ButtonStyle="ButtonStyle.Primary"
                              Size="Radzen.ButtonSize.Small" Icon="add">Write Off</RadzenButton>
            </RadzenColumn>
            <RadzenColumn SizeSM="9" Size="12">
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.End">
                    <RadzenFormField>
                        <Start><RadzenIcon Icon="search" /></Start>
                        <ChildContent>
                            <RadzenTextBox />
                        </ChildContent>
                    </RadzenFormField>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RadzenDataGrid Data="LoanItems"
                        Count="@counts"
                        PageSize="pageSize"
                        Density="Density.Compact"
                        GridLines="DataGridGridLines.Both"
                        LoadData="LoadData"
                        AllowSorting="true"
                        Responsive="true"
                        PagerPosition="PagerPosition.Bottom"
                        ShowPagingSummary="true"
                        PagerHorizontalAlign="HorizontalAlign.Right"
                        IsLoading="isLoading"
                        class="h-100"
                        AllowRowSelectOnRowClick="true"
                        RowSelect="RowSelectedArg"
                        TItem="VLoanDisbursments"
                        SelectionMode="DataGridSelectionMode.Single"
                        AllowPaging="true">
            <Columns>
                <RadzenDataGridColumn Context="p"
                                      Width="3rem"
                                      Title="#"
                                      Sortable="false">
                    <Template>
                        @(LoanItems.IndexOf(p) + 1)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="RegisterDate"
                                      Context="p"
                                      Title="Date"
                                      Sortable="true">
                    <Template>
                        @p.RegisterDate!.Value.ToShortDateString()
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="p"
                                      Property="AltName"
                                      Title="Name"
                                      Sortable="true">
                    <Template>
                        @p.AltName
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="p"
                                      Title="Principle"
                                      Property="Principle"
                                      TextAlign="TextAlign.Right"
                                      Sortable="true">
                    <Template>
                        @p.Amount.Format(p.CurrencyId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="p"
                                      Title="Interest"
                                      Property="InterestRate"
                                      TextAlign="TextAlign.Right"
                                      Sortable="true">
                    <Template>
                        @p.InterestRate (%) / @p.PeriodName
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="p"
                                      Title="Paid Principle"
                                      Property="PaidPrinciple"
                                      TextAlign="TextAlign.Right"
                                      Sortable="true">
                    <Template>
                        @p.PaidPrinciple.Format(p.CurrencyId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="p"
                                      Title="OutStanding"
                                      Property="OutStanding"
                                      TextAlign="TextAlign.Right"
                                      Sortable="true">
                    <Template>
                        @p.OutStanding.Format(p.CurrencyId)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="p"
                                      Title="Agent"
                                      Property="AgentName"
                                      TextAlign="TextAlign.Start"
                                      Sortable="true">
                    <Template>
                        @p.AgentName
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Context="p"
                                      Title="Status"
                                      Property="LoanStatus"
                                      Width="6rem"
                                      TextAlign="TextAlign.Center"
                                      Sortable="true">
                    <Template>
                        @p.LoanStatus
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </CardBody>

</BCard>
@code {
    [Parameter, SupplyParameterFromQuery] public int BranchId { get; set; } = 2;
    [CascadingParameter] Task<AuthenticationState> AuthenticationState { get; set; } = default!;
    List<VLoanDisbursments> LoanItems = [];
    IEnumerable<VBranch> Branches = [];
    bool isLoading = false;
    int pageSize = 10;
    string sortField = "RegisterDate";
    bool sortDescending = true;
    int pageIndex = 0;
    bool includeInactive = false;
    string searchText = string.Empty;
    int counts = 0;



    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationState;
        var UserId = auth!.User!.GetId();
        await GetLoans();
        var branchResponse = await _branchService.GetBranchesAsync(UserId);
        if (branchResponse.IsSuccess)
        {
            Branches = branchResponse.Data!;
        }
        else
        {
            Branches = [];
        }

        await base.OnInitializedAsync();
    }
    private async Task LoadData(LoadDataArgs args)
    {
        pageIndex = args.Skip!.Value;

        if (!string.IsNullOrEmpty(args.OrderBy))
        {
            sortField = args.OrderBy.Split(" ")[0];

            string dir = args.OrderBy.Split(" ")[1];

            sortDescending = dir.Contains("asc") ? false : true;
        }
        await GetLoans();
    }

    private async Task GetLoans()
    {
        try
        {
            isLoading = true;
            var res = await _dService!.GetLoansAsync(2, sortField, pageIndex, pageSize,0,4, sortDescending, includeInactive, searchText);
            LoanItems = res.Items;
            counts = res.Count;
            isLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            isLoading = false;
            NotificationService.Notify(NotificationSeverity.Error, ex.Message);
        }
        finally
        {
            isLoading = false;
        }

    }


    void RowSelectedArg(VLoanDisbursments e) { }

}
