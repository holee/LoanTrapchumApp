@page "/LoanCategories"
@using TCLMS.Shared.Entities.ViewModels.Loans.Categories
<PageTitle>Loan Categories</PageTitle>
<div>
    <RadzenTabs @ref="tabs" @bind-SelectedIndex="SelectIndex" Change="e=>TabChanged(e)" RenderMode="Radzen.TabRenderMode.Client">
        <Tabs>
            <RadzenTabsItem Text="Loan Category">

                <div>
                    <div class="card">

                        <div class="card-header">
                            <div class="d-flex justify-content-between">

                                <button class="btn btn-success btn-sm" @onclick="AddNewCategory">Add Loan Category</button>
                                <div>
                                    <RadzenCheckBox TValue="bool" @bind-Value=@InActive @bind-Value:after="OnIsActive" Name="CheckBox1" />
                                    <RadzenLabel Text="Include InActive" Component="CheckBox1" Style="margin-left: 8px; vertical-align: middle;" />
                                </div>
                            </div>
                        </div>
                        <div class="card-body">
                            <RadzenStack AlignItems="AlignItems.Center"
                                         JustifyContent="Radzen.JustifyContent.SpaceBetween"
                                         Orientation="Radzen.Orientation.Horizontal"
                                         Wrap="Radzen.FlexWrap.Wrap">
                                <RadzenStack JustifyContent="Radzen.JustifyContent.Start" Style="width:15%" Orientation="Radzen.Orientation.Horizontal">
                                    <RadzenDropDown TValue="int"
                                                    @bind-Value="pageSize"
                                                    Data="SelectedRow"
                                                    PopupStyle="10"
                                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                    Style="width: 100%; max-width: 100px;height:34px;font-size:14px"
                                                    Name="DropDownBindValue" />
                                    <div>
                                        <RadzenButton Size="ButtonSize.Small"
                                                      Icon="BtnIconType.Reload"
                                                      Click="Reload"
                                                      ButtonStyle="ButtonStyle.Primary" />
                                    </div>
                                </RadzenStack>


                                <RadzenStack Style="width:25%" JustifyContent="Radzen.JustifyContent.End">
                                    <RadzenFormField AllowFloatingLabel="false">
                                        <Start>
                                            <RadzenIcon Icon="search" />
                                        </Start>
                                        <ChildContent>
                                            <RadzenTextBox Style="width:100%;height:34px;font-size:14px"
                                                           Placeholder="Search here..."
                                                           @oninput="e=>PerformSearch(e)"
                                                           @bind-Value="searchText" />
                                        </ChildContent>
                                    </RadzenFormField>

                                </RadzenStack>
                            </RadzenStack>
                            <div>
                                <RadzenDataGrid GridLines="DataGridGridLines.Horizontal"
                                                Count="@counts"
                                                PageSize="@pageSize"
                                                AllowPaging="true"
                                                ShowPagingSummary="true"
                                                Density="Density.Compact"
                                                PagerHorizontalAlign="HorizontalAlign.Right"
                                                AllowSorting="true"
                                                LoadData="LoadData"
                                                IsLoading="isLoading"
                                                Data="vLCategories">
                                    <Columns>
                                        <RadzenDataGridColumn Title="#" Context="h">
                                            <Template>
                                                @(vLCategories!.ToList()!.IndexOf(h) + 1)
                                            </Template>
                                        </RadzenDataGridColumn>

                                        <RadzenDataGridColumn Title="Category" Property="p=>p.LoancategoryCode" />
                                        <RadzenDataGridColumn Title="Description" Property="p=>p.Description" />
                                        <RadzenDataGridColumn Title="Description-Khmer" Property="p=>p.DesInKhmer" />
                                        <RadzenDataGridColumn Title="Code" Property="p=>p.Code" />
                                        <RadzenDataGridColumn Title="Status" Sortable="false" Context="h">
                                            <Template>

                                                <RadzenCheckBox TValue="bool?"
                                                                Value="h.IsActive"
                                                                Change="@(()=>DeactiveOrActive(h))" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                        <RadzenDataGridColumn Title="Actions" Sortable="false" Context="c">
                                            <Template>
                                                <RadzenButton Size="Radzen.ButtonSize.ExtraSmall"
                                                              Icon="more_vert"
                                                              Variant="Variant.Text"
                                                              Click="@((args)=>ShowContextMenuWithContent(args,c))" />
                                            </Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>

                            </div>
                        </div>

                    </div>
                </div>


            </RadzenTabsItem>
            <RadzenTabsItem Visible="IsNew" Text="New LoanCategory">
                <LoanCategoryModalCreate CloseTab="CloseTabs" />
            </RadzenTabsItem>
            <RadzenTabsItem Visible="IsEdit" Text="Edit LoanCategory">
                <LoanCategoryModalEdit model="modelEdit" CloseTab="CloseTabs" />
            </RadzenTabsItem>
            <RadzenTabsItem Visible="IsDetails" Text="Details LoanCategory">
                <LCDetailModal category="detailsModel" CloseTab="CloseTabs" />
            </RadzenTabsItem>
        </Tabs>
    </RadzenTabs>

</div>
@code {
    int pageSize = 10;
    bool sortDescending = false;
    string sortColumn = "Id";
    bool isLoading = false;
    int counts = 0;
    RadzenTabs? tabs;
    private bool IsNew = false;
    private bool IsEdit = false;
    private bool IsDetails = false;
    [Parameter] public int SelectIndex { get; set; } = 0;
    protected LoanCategoryDTOUpdate? modelEdit = new();
    protected LoanCategoryDto? detailsModel = new();
    void ShowContextMenuWithContent(MouseEventArgs args, VLCategoryList? loanCategory)
    {
        ContextMenuService.Open(args, ds =>
    @<RadzenMenu Style="font-size:0.8rem;">

        <RadzenMenuItem Click="@(()=>Details(loanCategory!.LoanCategoryID))" Icon="info" Text="Details" Value="@loanCategory"></RadzenMenuItem>
        <RadzenMenuItem Click="@(()=>EditCategory(loanCategory!.LoanCategoryID))" Icon="edit" Text="Edit" Value="@loanCategory"></RadzenMenuItem>
        <RadzenMenuItem Click="@(()=>OnDelete(loanCategory))" Icon="delete" Text="Delete" Value="@loanCategory"></RadzenMenuItem>
    </RadzenMenu>
    );
    }
    async void MenuClicked(RadzenSplitButtonItem args, VLCategoryList? loanCategory)
    {
        if (args is not null)
        {
            if (args.Value == "1")
            {
                await Details(loanCategory!.LoanCategoryID);
                return;
            }
            if (args.Value == "2")
            {
                EditCategory(loanCategory!.LoanCategoryID);
                return;
            }
            if (args.Value == "3")
            {
                await OnDelete(loanCategory);
                return;
            }

        }
        return;
    }
    void TabChanged(int e)
    {
        SelectIndex = e;
        StateHasChanged();

    }
    void AddNewCategory()
    {
        IsNew = true;
        SelectIndex = 1;
        tabs!.Reload();
    }
    async void EditCategory(int id)
    {
        try
        {

            modelEdit = await service!.GetForEditAsync(id);
            IsEdit = true;
            SelectIndex = 2;
            StateHasChanged();
            tabs!.Reload();
            ContextMenuService.Close();

        }
        catch (Exception ex)
        {
            NotificationService.Notify(Radzen.NotificationSeverity.Error, "Exception", ex.Message);
            ContextMenuService.Close();

        }
    }
    async Task Details(int Id)
    {
        try
        {
            var result = await service!.GetByIdAsync(Id);
            if (result is not null)
            {
                detailsModel = result;

                IsDetails = true;
                SelectIndex = 3;
                tabs!.Reload();
            }
            ContextMenuService.Close();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(Radzen.NotificationSeverity.Error, "Exception", ex.Message);
            ContextMenuService.Close();

        }
    }
    void CloseTabs(int e)
    {
        if (SelectIndex == 1)
        {
            IsNew = false;
        }
        else if (SelectIndex == 2)
        {
            IsEdit = false;
        }
        else if (SelectIndex == 3)
        {
            IsDetails = false;
        }
        SelectIndex = 0;
        StateHasChanged();
    }
}


