<EditForm Model="model" OnValidSubmit="OnSaveNew">
    <div class="modal-body">
        <DataAnnotationsValidator />
        <div class="card">
            <div class="card-header bg-primary">
                <div class="d-flex justify-content-between">
                    <span>Loan Category Informations:</span>
                    <strong class="text-danger" @onclick="ClosedTab" style="cursor:pointer">X</strong>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 text-md-end">
                        <RadzenLabel Component="Name">Loan Category Name <span class="text-danger">*</span></RadzenLabel>
                    </div>
                    <div class="col-md-9">
                        @*   <RadzenFormField> *@
                        <RadzenTextBox @bind-Value="model.LoancategoryCode"
                                       Style="width:100%;height:33px;font-size:14px"
                                       AutoComplete="true"
                                       Placeholder="Enter Category Name..."
                                       Name="Name" />
                        <ValidationMessage For="@(()=>model.LoancategoryCode)"></ValidationMessage>
                        <span>@messageName</span>
                        @*  </RadzenFormField> *@

                    </div>
                    <div class="col-md-3 text-md-end mt-3">
                        <RadzenLabel>Record Status</RadzenLabel>
                    </div>
                    <div class="col-md-9 mt-3">
                        <RadzenCheckBox @bind-Value=@model.IsActive Name="CheckBox1" />
                        <RadzenLabel Component="CheckBox1" Style="margin-left: 8px; vertical-align: middle;">
                            @(model.IsActive!.Value ? "Is Active" : "Is Inactive")
                        </RadzenLabel>
                    </div>
                    <div class="col-md-3 text-md-end mt-3">
                        <RadzenLabel>Description</RadzenLabel>
                    </div>
                    <div class="col-md-9 mt-3">
                        <RadzenTextBox @bind-Value="model.Description"
                                       Style="width:100%;height:33px;font-size:14px"
                                       AutoComplete="true"
                                       Placeholder="Enter Description..."
                                       Name="Description" />
                        <ValidationMessage For="@(()=>model.Description)"></ValidationMessage>
                    </div>
                    <div class="col-md-3 text-md-end mt-3">
                        <RadzenLabel>Description-InKhmer</RadzenLabel>
                    </div>
                    <div class="col-md-9 mt-3">
                        <RadzenTextBox @bind-Value="model.DesInKhmer"
                                       Style="width:100%;height:33px;font-size:14px"
                                       AutoComplete="true"
                                       Placeholder="Enter Description in Khmer..."
                                       Name="DesInKhmer" />
                        <ValidationMessage For="@(()=>model.DesInKhmer)"></ValidationMessage>
                    </div>
                    <div class="col-md-3 text-md-end mt-3">
                        <RadzenLabel>Code</RadzenLabel>
                    </div>
                    <div class="col-md-9 mt-3">
                        <RadzenTextBox @bind-Value="model.Code"
                                       Style="width:100%;height:33px;font-size:14px"
                                       AutoComplete="true"
                                       Placeholder="Enter Code..."
                                       Name="Code" />
                        <ValidationMessage For="@(()=>model.Code)"></ValidationMessage>
                        <span>@messageCode</span>

                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="d-flex justify-content-end gap-3">
                    <RadzenButton ButtonStyle="ButtonStyle.Success"
                                  Icon="BtnIconType.Save"
                                  Text="Save"
                                  Size="ButtonSize.Small"
                                  ButtonType="ButtonType.Submit" />
                    <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                  Icon="BtnIconType.Close"
                                  Text="Cancel"
                                  Click="@ClosedTab"
                                  Size="ButtonSize.Small" />
                </div>
            </div>
        </div>
    </div>

</EditForm>
@code {
    [Parameter] public EventCallback<int> CloseTab { get; set; }
    async void ClosedTab()
    {
        await CloseTab.InvokeAsync(0);
        StateHasChanged();
    }
}





