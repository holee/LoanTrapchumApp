@using Applications.Extensions
<RadzenFieldset Text="Please verify amount and balance then start cash vault.">
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mb-2">
        <RadzenColumn SizeSM="12" Size="12" SizeMD="4">
            <InputGroup Size="InputSize.Small">
                <Start>CURRENCY</Start>
                <ChildContent>
                    <RadzenDropDown @bind-Value="@CurrencyId"
                                    ValueProperty="CurrencyId"
                                    TextProperty="CurrencyCode"
                                    Data="@CurrencyList"
                                    SelectedItemChanged="SelectedItemChanged"
                                    Name="DropDownBindValue" />
                </ChildContent>
            </InputGroup>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeSM="12" SizeMD="4">
            <InputGroup Size="InputSize.Small">
                <Start>User Balance</Start>
                <ChildContent>
                    <InputNumber 
                        @bind-Value="userBalance" 
                        class="form-control text-end" disabled />
                </ChildContent>
            </InputGroup>
        </RadzenColumn>
        <RadzenColumn SizeSM="12" Size="12" SizeMD="4">
            <InputGroup Size="InputSize.Small">
                <Start>AMOUNT</Start>
                <ChildContent>
                    <TCNumbers Name="Amount"
                               @bind-Value="totalAmount"
                               Disabled="true"
                               Format="@sp" />
                </ChildContent>
            </InputGroup>
        </RadzenColumn>
    </RadzenRow>
    <div class="table-responsive">
        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th class="text-end">Note</th>
                    <th class="text-end">Qty In Vault</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Sub Total</th>
                    <th class="text-end">Total Quantity</th>
                    <th class="text-end">Total Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cn in cashMDList)
                {
                    <VaultInRow Item="@cn"
                                Calculate="@CalTotal"
                                CurrencyId="@CurrencyId" />
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end">TOTAL</td>
                    <td class="text-end">
                        @total.Format(CurrencyId)
                    </td>
                    <td class="text-end">
                        @cashMDList.Sum(x => x.TotalQuantity)
                    </td>
                    <td class="text-end">
                        @{
                            var value = cashMDList?.Sum(x => x.TotalValue);
                            @value.Format(CurrencyId)
                        }
                    </td>
                </tr>
                <tr>
                    <td class="text-end" colspan="3">CURRENT BALANCE</td>
                    <td class="text-end">
                        @vCashVault?.UserBalance.Format(CurrencyId)
                    </td>
                    <td class="" colspan="2">
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
    <RadzenStack JustifyContent="Radzen.JustifyContent.End"
                 Orientation="Radzen.Orientation.Horizontal">
        <RadzenButton Size="Radzen.ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Success"
                      Text="Save"
                      Icon="save"
                      Click="@OnSaveChanges" />
        <RadzenButton Size="Radzen.ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Success"
                      Text="Save & Close"
                      Icon="save"
                      Click="@OnSaveChangesClose" />

        <RadzenButton Size="Radzen.ButtonSize.Small"
                      ButtonStyle="ButtonStyle.Danger"
                      Text="Cancel"
                      Icon="Close"
                      Click="@(() => DialogService.Close(true))" />

    </RadzenStack>

</RadzenFieldset>
