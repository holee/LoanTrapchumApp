@page "/Branches/{BranchId:int?}/OpenBranch"
<PageTitle>Open Branch</PageTitle>
@implements IDisposable
@attribute [MustHasPermission(Modules.Transactions, Feature.OpenBranch)]
<RadzenCard class="rz-mx-auto" Style="width:100%;">
    <RadzenAlert AlertStyle="AlertStyle.Warning"
                 ShowIcon="true"
                 Visible="!bState.State"
                 AllowClose="false"
                 Variant="Variant.Filled" Shade="Shade.Lighter">
        <RadzenText TagName="TagName.P" TextAlign="TextAlign.Center"
                    TextStyle="TextStyle.DisplayH6">
            This branch is close!, please open branch to do operation.
        </RadzenText>
    </RadzenAlert>
    <RadzenStack Gap="0.5rem" class="rz-my-2">
        <RadzenCard class="rz-mx-auto h-100" Style="width:100%;">
            <RadzenRow JustifyContent="JustifyContent.Center"
                       AlignItems="AlignItems.Start"
                       Visible="bState.State"
                       Gap="1rem">
                <RadzenColumn SizeMD="5" Size="12" SizeSM="12">
                    <RadzenDataGrid Responsive
                                    Density="Density.Compact"
                                    GridLines="DataGridGridLines.Both"
                                    Data="CashVaultBalances">
                        <Columns>
                            <RadzenDataGridColumn Title="Currency Name"
                                                  Context="c"
                                                  Property="CurrencyName">
                                <Template>
                                    @c.CurrencyName
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Title="Vault Balance"
                                                  Context="c"
                                                  Property="VaultBalance">
                                <Template>
                                    @c.VaultBalance.Format(c.CurrencyId)
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Title="Action"
                                                  Context="c"
                                                  Property="CurrencyId">
                                <Template>
                                    <RadzenButton Click="@(()=>OpenSideDialog(c.CurrencyId))"
                                                  Size="ButtonSize.ExtraSmall"
                                                  Icon="attach_money"
                                                  class="rz-primary"
                                                  Text="Cash Note"
                                                  Variant="Variant.Filled" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenColumn>
                <RadzenColumn SizeMD="7" Size="12" SizeSM="12">
                    <RadzenDataGrid Density="Density.Compact"
                                    Responsive
                                    GridLines="DataGridGridLines.Both"
                                    Data="CurrencyNotes">
                        <Columns>
                            <RadzenDataGridColumn Title="Currency Name"
                                                  Context="c"
                                                  Property="CurrencyName">
                                <Template>
                                    @c.CurrencyName
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Title="Code"
                                                  Context="c"
                                                  Property="CurrencyCode">
                                <Template>
                                    @c.CurrencyCode
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Title="Value"
                                                  Context="c"
                                                  TextAlign="TextAlign.Right"
                                                  Property="CurrencyValue">
                                <Template>
                                    @c.CurrencyValue
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Title="Quantity"
                                                  Context="c"
                                                  TextAlign="TextAlign.Right"
                                                  Property="Quantity">
                                <Template>
                                    @(c.Quantity ?? 0)
                                </Template>
                                <FooterTemplate>
                                    @CurrencyNotes?.Sum(x => x.Quantity)
                                </FooterTemplate>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Title="Sub Total"
                                                  Context="c"
                                                  TextAlign="TextAlign.Right"
                                                  Property="Quantity">
                                <Template>
                                    @((c.Quantity * c.CurrencyValue) ?? 0)
                                </Template>
                                <FooterTemplate>
                                    @{
                                        var value = CurrencyNotes?.Sum(x => x.Quantity * x.CurrencyValue);
                                    }
                                    @value.Format(currencyId)
                                </FooterTemplate>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenColumn>
            </RadzenRow>
            <AuthorizeView>
                <Authorized>
                    <RadzenStack Gap="1rem"
                                 class="mt-2"
                                 Orientation="Orientation.Horizontal"
                                 AlignItems="AlignItems.Center">
                        @if (bState.State)
                        {
                            @if (bState.VaultOut)
                            {
                                <RadzenButton Click="OnCashVaultOut"
                                              Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Success"
                                              Icon="lock_open"
                                              Text="Valut Out"
                                              ButtonType="ButtonType.Button" />

                            }
                            @if (canOpenBranch)
                            {
                                <RadzenButton Click="SubmitCloseBranch"
                                              Icon="lock_open"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              ButtonType="ButtonType.Button"
                                              Size="ButtonSize.Small"
                                              Text="Close Branch" />
                            }

                        }
                        else
                        {

                            @if (canOpenBranch)
                            {
                                <RadzenButton Click="SubmitOpenBranch"
                                              ButtonType="ButtonType.Button"
                                              Size="ButtonSize.Small"
                                              Icon="lock"
                                              Text="Open Branch"
                                              ButtonStyle="ButtonStyle.Success" />
                            }

                        }
                    </RadzenStack>
                </Authorized>
            </AuthorizeView>
        </RadzenCard>
    </RadzenStack>
</RadzenCard>


