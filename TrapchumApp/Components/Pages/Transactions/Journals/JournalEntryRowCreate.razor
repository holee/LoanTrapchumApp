@using Radzen
@using Radzen.Blazor
<tr>
    <td class="text-center">
        <RadzenLabel>@RowIndex</RadzenLabel>
        @{
            JournalLine.LineSeq = JournalLineSeq;
        }
    </td>
    <td>
        <RadzenDropDownDataGrid @bind-Value="JournalLine.LedgerRefId"
                                Density="Density.Compact"
                                @bind-Value:after="SelectedItemChange"
                                Style="width:100%;cursor:pointer;height:32px;font-size:14px"
                                Data="LedgerData"
                                TextProperty="LedgerName"
                                PageSize="10"
                                class="form-control"
                                ShowSearch="false"
                                AllowSelectAll="true"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                AllowClear="true"
                                Placeholder="Ledger..."
                                ValueProperty="LedgerId"
                                AllowColumnResize="true"
                                AllowFilteringByAllStringColumns="true"
                                Name="DropDownJournalLine">
            <Columns>
                <RadzenDropDownDataGridColumn Title="Ledger" Property="LedgerName" Width="100px" />
                <RadzenDropDownDataGridColumn Title="Type" Property="LedgerTypeCode" Width="100px" />
            </Columns>
        </RadzenDropDownDataGrid>
    </td>
    <td class="text-end">
        <RadzenNumeric TValue="decimal?"
                       ShowUpDown="false"
                       Min="0"
                       @onkeydown="e=>OnNedLine(e)"
                       TextAlign="TextAlign.End"
                       Style="height:32px;"
                       Disabled="JournalLine.IsCredit"
                       @bind-Value="JournalLine!.Debit"
                       @bind-Value:after="(()=>DebitValidate(JournalLine))">

        </RadzenNumeric>
    </td>
    <td class="text-end">
        <RadzenNumeric TValue="decimal?"
                       ShowUpDown="false"
                       Min="0"
                       Style="width:100%;height:32px;"
                       Disabled="JournalLine.IsDebit"
                       TextAlign="TextAlign.End"
                       @onkeydown="e=>OnNedLine(e)"
                       @bind-Value="JournalLine.Credit"
                       @bind-Value:after="(()=>CreditValidate(JournalLine))">
        </RadzenNumeric>
    </td>
    <td>
        <RadzenTextBox Placeholder="Memo..."
                       @onkeydown="e=>OnNedLine(e)"
                       Name="JournalLineDesc"
                       @bind-Value="JournalLine.JournalLineDesc"
                       Style="height:32px;font-size:14px;width:100%;" />
    </td>
    <td>
        <RadzenDropDownDataGrid @bind-Value="JournalLine.EntityNameRefId"
                                @bind-Value:after="GetName"
                                Density="Density.Compact"
                                Style="width:100%;cursor:pointer;height:32px;font-size:14px"
                                @bind-SearchText="JournalLine.EntityName"
                                Data="NameData"
                                TextProperty="FullName"
                                ValueProperty="Id"
                                ShowSearch="false"
                                PageSize="10"
                                class="form-control"
                                Placeholder="Name..."
                                AllowClear="true"
                                AllowColumnResize="true"
                                AllowFilteringByAllStringColumns="true"
                                Name="DropDownEntityNameRefId"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
            <Columns>
                <RadzenDropDownDataGridColumn Property="FullName" Title="Name" Width="100px" />
                <RadzenDropDownDataGridColumn Property="EntType" Title="Type" Width="100px" />
            </Columns>
        </RadzenDropDownDataGrid>
    </td>
    <td>
        <RadzenButton Click=@AddNewRow
                      Icon="add_circle_outline"
                      Size="Radzen.ButtonSize.ExtraSmall"
                      Variant="Variant.Text"
                      ButtonStyle="ButtonStyle.Primary" />
        <RadzenButton Click=@RemoveRow
                      Icon="delete_forever"
                      Size="Radzen.ButtonSize.ExtraSmall"
                      Variant="Variant.Text"
                      ButtonStyle="ButtonStyle.Danger" />


    </td>
</tr>



