        justify-content: space-between;
        align-items: center;
        padding: 8px;
        border-bottom: 1px solid #eee;
    }

        .uploaded-files li:hover {
            background-color: #f5f5f5;
        }

    .uploaded-files button {
        margin-left: 10px;
    }
</style>
Welcome to your new app.
@if (files.Any())
{
    <div class="uploaded-files">
        <h4>Uploaded Files:</h4>
        <ul>
            @foreach (var file in Files)
            {
                <li>
                    <span>@file.FileName</span>
                    <span>@FormatFileSize(file.FileSize)</span>
                    <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete"
                                  Click="@(() => RemoveFile(file))" />
                    <RadzenButton ButtonStyle="ButtonStyle.Secondary" Icon="download"
                                  Click="@(() => DownloadFile(file))" />
                </li>
            }
        </ul>
    </div>
}
<RadzenCard Variant="Variant.Outlined">
    <RadzenUpload Multiple="true"
                  Auto="false"
                  Change="@OnFileUpload"
                  Accept=".jpg,.jpeg,.png,.doc,.docx,.pdf,.xls,.xlsx"
                  Style="width: 100%"
                  Progress="@OnProgress"
                  InputAttributes="@(new Dictionary<string,object>{ { "aria-label", "select file" }})">
        <ChildContent>


        </ChildContent>
    </RadzenUpload>
    <RadzenButton Text="Upload" Click=@OnUpload class="rz-mt-4" />
</RadzenCard>
@code {

    bool CanDownload => files.Count > 0;
    const long maxFileSize = 2L * 1024 * 1024 * 1024;
    internal class FileUpload
    {
        public string FileName { get; set; } = "fileName";
        public string? Extension { get; set; } = "";
        public long FileSize { get; set; } = 0;
        public byte[] FileContent { get; set; } = Array.Empty<byte>();
    }

    IEnumerable<FileModel> Files = [];

    private async Task OnFileUpload(UploadChangeEventArgs args)
    {
        try
        {
            foreach (var file in args.Files)
            {
                if (file is null)
                {
                    continue;
                }
                using (var stream = new MemoryStream())
                {

                    using (var fileStream = file.OpenReadStream(maxFileSize)) // 30 MB limit
                    {
                        await fileStream.CopyToAsync(stream); // ✅ Read the file content

                        files.Add(new FileUploadModel
                            {
                                FileName = file.Name,
                                FileSize = file.Size,
                                FileContent = stream.ToArray(),
                                Extension = Path.GetExtension(file.Name)
                            });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error uploading files: {ex.Message}");
            // Handle error (e.g., show notification)
        }
    }


    ICollection<FileUploadModel> files = new List<FileUploadModel>();

    RadzenUpload upload;

    async Task OnUpload()
    {

        var rsp = await _fileUploadService.UploadFiles(files);

        if (rsp.IsSuccess)
        {
            Files = rsp.Data ?? [];
        }

    }
    void OnProgress(UploadProgressArgs args)
    {

        foreach (var file in args.Files)
        {
            Console.WriteLine($"Uploaded: {file.Name} / {file.Size} bytes");

            // files.Add(new FileUpload
            //     {
            //         Name = file.Name,
            //         Size = file.Size
            //     });
        }
        if (args.Progress == 100)
        {
            Console.WriteLine($"Upload progress: {args.Progress}% / {args.Loaded} of {args.Total} bytes.");
        }
    }
    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        int order = 0;
        while (bytes >= 1024 && order < sizes.Length - 1)
        {
            order++;
            bytes /= 1024;
        }
        return $"{bytes:0.##} {sizes[order]}";
    }
   
    private string GetContentType(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLowerInvariant();
        return extension switch
        {
            ".pdf" => "application/pdf",
            ".doc" => "application/msword",
            ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".xls" => "application/vnd.ms-excel",
            ".xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".jpg" => "image/jpeg",
            ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            _ => "application/octet-stream",
        };
    }
   
    
    private async Task SaveFilesToServer()
    {
        try
        {
            foreach (var file in files)
            {
                var savePath = Path.Combine("wwwroot/uploads", file.FileName);
                await System.IO.File.WriteAllBytesAsync(savePath, file.FileContent);
            }

            // Optionally clear the uploaded files list
            files.Clear();

            // Show success message
        }
        catch (Exception ex)
        {
            // Handle error
        }
    }
