<PageTitle>Home</PageTitle>
@inject IFileUploadServiceImp _fileUploadService;
<h1>Hello, Trapchum!</h1>
<style>
    .file-upload-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 5px;
    }

    .file-info {
