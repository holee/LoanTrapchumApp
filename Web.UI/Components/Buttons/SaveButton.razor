<RadzenButton Size="ButtonSize.ExtraSmall"
              Text="@Title"
              Click="@HandleClick"
              ButtonStyle="ButtonStyle.Success"
              ButtonType="@ButtonType"
              IsBusy="@IsBusy"
              BusyText="@BusyText"
              Icon="@Icon"></RadzenButton>
@code {
    [Parameter]
    public string Title { get; set; } = "Save";
    [Parameter]
    public EventCallback OnClick { get; set; }
    [Parameter]
    public string Icon { get; set; } = "save";
    [Parameter]
    public ButtonType ButtonType { get; set; } = ButtonType.Submit;
    [Parameter]
    public bool IsBusy { get; set; } = false;
    [Parameter]
    public string BusyText { get; set; } = "Saving...";

    private void HandleClick()
    {
        if (OnClick.HasDelegate && ButtonType == ButtonType.Button)
        {
            OnClick.InvokeAsync();
        }
    }
}