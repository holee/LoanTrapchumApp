@namespace Web.UI.Components.Buttons

<div class="fab-menu-item-wrapper" @onclick="OnClickHandler">
    @if (!string.IsNullOrEmpty(Label) && (Menu?.Direction == FabDirection.Up || Menu?.Direction == FabDirection.Down))
    {
        <span class="fab-menu-item-label">@Label</span>
    }
    
    <ModernFab StartIcon="@StartIcon" 
               Color="Color" 
               Size="Size" 
               DisableElevation="DisableElevation"
               DisableRipple="DisableRipple" 
               Href="@Href"
               Target="@Target"
               Disabled="Disabled" />
               
    @if (!string.IsNullOrEmpty(Label) && (Menu?.Direction == FabDirection.Left || Menu?.Direction == FabDirection.Right))
    {
        <span class="fab-menu-item-label side-label">@Label</span>
    }
</div>

@code {
    [CascadingParameter] public ModernFabMenu? Menu { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? StartIcon { get; set; }
    [Parameter] public FabColor Color { get; set; } = FabColor.Surface;
    [Parameter] public FabSize Size { get; set; } = FabSize.Small;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool DisableElevation { get; set; }
    [Parameter] public bool DisableRipple { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Target { get; set; }
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }

    private async Task OnClickHandler(Microsoft.AspNetCore.Components.Web.MouseEventArgs args)
    {
        if (Disabled) return;
        
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(args);
        }

        Menu?.Close();
    }
}
