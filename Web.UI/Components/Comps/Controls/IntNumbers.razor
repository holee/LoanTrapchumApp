@using System.Linq.Expressions
@if (string.IsNullOrEmpty(Label) && (IsFloatLabel && !IsFloatLabel))
{
    <RadzenNumeric TValue="int?"
                   Value="@Value"
                   Name="@Name"
                   id="@Id"
                   ValueExpression="@ValueExpression"
                   Change="@OnChanged"
                   @oninput="@OnTextChanged"
                   @onfocusout="OnMouseOut"
                   onclick="this.querySelector('.rz-numeric-input').select()"
                   ShowUpDown="false"
                   TextAlign="TextAlign"
                   class="@Styles.W100"
                   Disabled="@Disabled"
                   Min="@Min"
                   Placeholder="@PlaceHolder"
                   ValueChanged="@ValueChanged"/>
}

@if (!string.IsNullOrEmpty(Label) && IsFloatLabel)
{
    <RadzenFormField Text="@Label" AllowFloatingLabel="true" class="@Styles.W100">
        <ChildContent>
            <RadzenNumeric TValue="int?"
                           Value="@Value"
                           Name="@Name"
                           id="@Id"
                           ValueExpression="@ValueExpression"
                           Change="@OnChanged"
                           @oninput="@OnTextChanged"
                           onclick="this.querySelector('.rz-numeric-input').select()"
                           ShowUpDown="false"
                           TextAlign="TextAlign"
                           class="@Styles.W100"
                           Disabled="@Disabled"
                           Min="@Min"
                           Placeholder="@PlaceHolder"
                           ValueChanged="@ValueChanged"/>
        </ChildContent>
        <Helper>
            <ValidationMessage For="@ValueExpression"/>
        </Helper>
    </RadzenFormField>
}
@if (!string.IsNullOrEmpty(Label) && !IsFloatLabel)
{
    <RadzenRow AlignItems="AlignItems.Center">
        <RadzenColumn Size="2" SizeMD="2" SizeSM="12">
            <RadzenLabel Text="@Label"></RadzenLabel>
        </RadzenColumn>
        <RadzenColumn Size="10" SizeMD="10" SizeSM="12">
            <RadzenNumeric TValue="int?"
                           id="@Id"
                           Name="@Name"
                           Value="@Value"
                           ValueExpression="@ValueExpression"
                           Change="@OnChanged"
                           @oninput="@OnTextChanged"
                           onclick="this.querySelector('.rz-numeric-input').select()"
                           ShowUpDown="false"
                           TextAlign="TextAlign"
                           Disabled="@Disabled"
                           Min="@Min"
                           class="@Styles.W100"
                           Placeholder="@PlaceHolder"
                           ValueChanged="ValueChanged"/>
            <span class="rz-text-danger">
                <ValidationMessage For="@ValueExpression"/>
            </span>
        </RadzenColumn>
       
    </RadzenRow>
}

@code {
    [Parameter] public string? Label { get; set; } = string.Empty;
    [Parameter] public string? Name { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string Id { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string? PlaceHolder { get; set; } = "Number";
    [Parameter] public string? Format { get; set; } = "#,##0.00";
    [Parameter] public int? Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public TextAlign TextAlign { get; set; } = TextAlign.End;
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<int?>> ValueExpression { get; set; } = default!;
    [Parameter] public EventCallback<int?> OnChanged { get; set; }
    [Parameter] public decimal? Min { get; set; } = 0;
    [Parameter] public EventCallback<int?> OnValueChanged { get; set; }
    [Parameter] public EventCallback<FocusEventArgs> MouseOut { get; set; }
    [Parameter] public bool IsFloatLabel { get; set; } = false;

    async Task OnTextChanged(ChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(e.Value!.ToString()))
        {
            await OnValueChanged.InvokeAsync(0);
        }
        else
        {
            if (int.TryParse(e.Value.ToString(), out var test))
            {
                await OnValueChanged.InvokeAsync(test);
            }
            else
            {
                await OnValueChanged.InvokeAsync(0);
            }
        }
    }

    async Task OnMouseOut(FocusEventArgs e)
    {
        await MouseOut.InvokeAsync(e);
    }

}
