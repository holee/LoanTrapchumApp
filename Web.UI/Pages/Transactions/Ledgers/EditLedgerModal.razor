<RadzenCard>
    <EditForm Model="model" @ref="editForm">
       <FluentValidator />
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-3">
            <RadzenIcon Icon="category" Style="color: var(--rz-primary); font-size:1.1rem;" />
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0" style="font-weight:600; letter-spacing:.03em; text-transform:uppercase; color: var(--rz-text-tertiary-color);">Classification</RadzenText>
        </RadzenStack>

        <RadzenRow AlignItems="AlignItems.Start" Gap="1rem">
            <RadzenColumn Size="12" SizeMD="9">
                <RadzenFormField Text="Ledger Type" AllowFloatingLabel="true" class="@Styles.W100">
                    <ChildContent>
                        <RadzenDropDownDataGrid Data="LedgerTypes"
                                                AllowColumnResize="true"
                                                @bind-Value="model.LedgerTypeRefId"
                                                TextProperty="LedgerTypeCode"
                                                ValueProperty="LedgerTypeId"
                                                Density="Density.Compact"
                                                class="@Styles.W100"
                                                ShowSearch="false"
                                                PageSize="10"
                                                ShowPagingSummary="true"
                                                Placeholder="Select a ledger type">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="LedgerTypeCode"
                                                              Title="Type"
                                                              Sortable="false"
                                                              Width="200px" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                    </ChildContent>
                    <Helper>
                        <ValidationMessage For="@(() => model.LedgerTypeRefId)" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="3">
                <input type="hidden" @bind-value="model.LedgerId" />
                <RadzenStack Orientation="Orientation.Horizontal"
                             AlignItems="AlignItems.Center"
                             Gap="0.35rem"
                             class="rz-px-2 rz-py-1 rz-mt-3"
                             style="background:var(--rz-base-100); border:1px solid var(--rz-border-disabled-color); border-radius: var(--rz-border-radius);">
                    <RadzenCheckBox @bind-Value="model.IsActive" TValue="bool" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" style="white-space:nowrap; font-weight:500;">Is Active</RadzenText>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow AlignItems="AlignItems.Start" Gap="1rem" class="rz-mt-2">
            <RadzenColumn Size="12">
                <RadzenFormField Text="Reference Number" AllowFloatingLabel="true" class="@Styles.W100">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="model.LedgerCode"
                                       class="@Styles.W100"
                                       Placeholder="e.g. GL-0001" />
                    </ChildContent>
                    <Helper>
                        <ValidationMessage For="@(() => model.LedgerCode)" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="0.5rem" class="rz-my-2">
            <RadzenIcon Icon="account_balance" Style="color: var(--rz-primary); font-size:1.1rem;" />
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0" style="font-weight:600; letter-spacing:.03em; text-transform:uppercase; color: var(--rz-text-tertiary-color);">Banking &amp; Currency</RadzenText>
        </RadzenStack>

        <RadzenRow AlignItems="AlignItems.Start" Gap="1rem">
            @if (model.LedgerTypeRefId == 1)
            {
                <RadzenColumn Size="12" SizeMD="8">
                    <RadzenFormField Text="Bank Account Number" AllowFloatingLabel="true" class="@Styles.W100">
                        <ChildContent>
                            <RadzenTextBox class="@Styles.W100" @bind-Value="model.BankNumber" Name="BankNumber" Placeholder="Enter bank account number" />
                        </ChildContent>
                        <Helper>
                            <ValidationMessage For="() => model.BankNumber" />
                        </Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Currency" AllowFloatingLabel="true" class="@Styles.W100">
                        <ChildContent>
                            <RadzenDropDown @bind-Value="model.CurrencyRefId"
                                            TextProperty="CurrencyCode"
                                            class="@Styles.W100"
                                            ValueProperty="CurrencyId"
                                            SelectedItemChanged="CurrencySelectedChanged"
                                            Data="@Currencies" />
                        </ChildContent>
                        <Helper>
                            <ValidationMessage For="@(() => model.CurrencyRefId)" />
                        </Helper>
                    </RadzenFormField>
                </RadzenColumn>
            }
            else
            {
                <RadzenColumn Size="12">
                    <RadzenFormField Text="Currency" AllowFloatingLabel="true" class="@Styles.W100">
                        <ChildContent>
                            <RadzenDropDown @bind-Value="model.CurrencyRefId"
                                            TextProperty="CurrencyCode"
                                            ValueProperty="CurrencyId"
                                            class="@Styles.W100"
                                            SelectedItemChanged="CurrencySelectedChanged"
                                            Data="Currencies" />
                        </ChildContent>
                        <Helper>
                            <ValidationMessage For="@(() => model.CurrencyRefId)" />
                        </Helper>
                    </RadzenFormField>
                </RadzenColumn>
            }
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-my-2">
            <RadzenIcon Icon="account_tree" Style="color: var(--rz-primary); font-size:1.1rem;" />
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0" style="font-weight:600; letter-spacing:.03em; text-transform:uppercase; color: var(--rz-text-tertiary-color);">Identity &amp; Hierarchy</RadzenText>
        </RadzenStack>

        <RadzenRow AlignItems="AlignItems.Start" Gap="0.75rem">
            <RadzenColumn Size="12">
                <RadzenFormField Text="Ledger Name" AllowFloatingLabel="true" class="@Styles.W100">
                    <ChildContent>
                        <RadzenTextBox @bind-Value="model.LedgerName"
                                       class="@Styles.W100"
                                       Placeholder="Enter ledger name" />
                    </ChildContent>
                    <End>
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     Gap="0.35rem"
                                     class="rz-px-2 rz-py-1"
                                     style="background:var(--rz-base-100); border-left:1px solid var(--rz-border-disabled-color);">
                            <RadzenCheckBox @bind-Value="model.IsMainGl"
                                            Change="SelectCheckedChanged"
                                            TValue="bool" />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" style="white-space:nowrap; font-weight:500;">Main GL</RadzenText>
                        </RadzenStack>
                    </End>
                    <Helper>
                        <ValidationMessage For="@(() => model.LedgerName)" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>

            <RadzenColumn Size="12" Visible="!model.IsMainGl">
                <RadzenFormField Text="Parent Ledger" AllowFloatingLabel="true" class="@Styles.W100">
                    <Start>
                        <RadzenStack Orientation="Orientation.Horizontal"
                                     AlignItems="AlignItems.Center"
                                     Gap="0.35rem"
                                     class="rz-px-2 rz-py-1"
                                     style="background:var(--rz-base-100); border-right:1px solid var(--rz-border-disabled-color);">
                            <RadzenCheckBox TValue="bool"
                                            Change="SubTypeChanged"
                                            @bind-Value="model.IsSubTypeOf" />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0" style="white-space:nowrap; font-weight:500;">Sub Type Of</RadzenText>
                        </RadzenStack>
                    </Start>
                    <ChildContent>
                        <RadzenDropDownDataGrid Data="FilterLedgers"
                                                AllowColumnResize="true"
                                                @bind-Value="model.ParentRefId"
                                                TextProperty="LedgerName"
                                                ValueProperty="LedgerId"
                                                Disabled="!model.IsSubTypeOf"
                                                Density="Density.Compact"
                                                class="@Styles.W100"
                                                ShowSearch="false"
                                                PageSize="10"
                                                LoadData="LoadDataTextChanged"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                Placeholder="Select parent ledger">
                            <Columns>
                                <RadzenDropDownDataGridColumn Property="LedgerName"
                                                              Sortable="false"
                                                              Title="Ledger Name" />
                                <RadzenDropDownDataGridColumn Property="LedgerTypeCode"
                                                              Sortable="false"
                                                              Title="Type"
                                                              Width="120px" />
                            </Columns>
                        </RadzenDropDownDataGrid>
                    </ChildContent>
                    <Helper>
                        <ValidationMessage For="@(() => model.IsSubTypeOf)" />
                        <ValidationMessage For="@(() => model.ParentRefId)" />
                    </Helper>
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-my-2">
            <RadzenIcon Icon="notes" Style="color: var(--rz-primary); font-size:1.1rem;" />
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0" style="font-weight:600; letter-spacing:.03em; text-transform:uppercase; color: var(--rz-text-tertiary-color);">Notes</RadzenText>
        </RadzenStack>
         <RadzenFormField Text="Description" class="@Styles.W100">
        <ChildContent>
            <RadzenTextArea class="@Styles.W100" @bind-Text="model.Description" />
        </ChildContent>
    </RadzenFormField>
        <input type="hidden" @bind="@tempIsSubTypeOf" />
        <input type="hidden" @bind="@tempParentRefIdId" />
        <input type="hidden" @bind="@tempCurrencyId" />
    </EditForm>
    <RadzenStack Orientation="Orientation.Horizontal" 
                 AlignItems="AlignItems.Center"
                 Gap="0.75rem"
                 class="rz-mt-4"
                 JustifyContent="JustifyContent.End">
        <RadzenButton ButtonStyle="ButtonStyle.Danger"
                      Icon="cancel"
                      Text="Cancel"
                      Click="@(() => Close())"
                      Size="ButtonSize.Small"
                      Variant="Variant.Filled" />
        <RadzenButton ButtonStyle="ButtonStyle.Success"
                      Click="FormValidSubmit"
                      Text="Save Ledger"
                      Icon="save"
                      Size="ButtonSize.Small"
                      Variant="Variant.Filled" />
    </RadzenStack>
</RadzenCard>

