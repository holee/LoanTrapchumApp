@using Radzen.Blazor.Rendering
@using Web.UI.Pages.Transactions.Exchanges
<PageTitle>Payments</PageTitle>
<style type="text/css">
    .my-popup {
        display: none;
        position: absolute;
        overflow: hidden;
        height: 420px;
        width: 550px;
        padding: 1.2rem;
        border: var(--rz-panel-border);
        box-shadow: var(--rz-panel-shadow);
        background: var(--rz-base-300);
        border-radius: var(--rz-border-radius)
    }
</style>
<RadzenStack Gap="0">

    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 JustifyContent="JustifyContent.SpaceBetween"
                 class="rz-px-3 rz-py-2 rz-border-bottom">
        <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0 rz-color-on-base-2">
            <RadzenIcon Icon="receipt_long" class="rz-me-1" style="vertical-align:middle;font-size:1rem;" />
            Receive Payment
        </RadzenText>
        <RadzenButton @ref="@_exchangeBtn"
                      Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Light"
                      Icon="currency_exchange"
                      Text="Exchange"
                      Click="OpenPopup" />
    </RadzenStack>
    <Popup @ref="_exchangePopup" Lazy="true"
           AutoFocusFirstElement="false"
           CloseOnClickOutside="true"
           PreventDefault="true"
           class="my-popup">
        <ExchangesPopup CurrencyId="@_selectedCurrencyId"
                        Amount="@_exchangedAmount"
                        ClosePopup="@ClosedPopup" />
    </Popup>
    <RadzenRow class="rz-px-3 rz-pt-3 rz-pb-1" Gap="0.5rem">
        <RadzenColumn Size="6">
            <RadzenCard class="rz-p-2 rz-text-align-center" style="border-radius:0.75rem;background:var(--rz-primary-lighter);">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-on-base-2 rz-mb-1">Paid Amount</RadzenText>
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0 rz-color-primary">
                    @LoanRepayment.AmountWithoutPenalty.Format(CurrencyId)
                </RadzenText>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="6">
            <RadzenCard class="rz-p-2 rz-text-align-center" style="border-radius:0.75rem;background:var(--rz-danger-lighter);">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-color-on-base-2 rz-mb-1">Penalty</RadzenText>
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0 rz-color-danger">
                    @LoanRepayment.PaidPenaltyAmount.Format(CurrencyId)
                </RadzenText>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <EditForm Model="LoanRepayment" @ref="@editForm">
        <FluentValidationValidator DisableAssemblyScanning="true" />

        <RadzenStack Gap="0.75rem" class="rz-px-3 rz-pt-2 rz-pb-3">

            <RadzenFormField Text="Receipt No" AllowFloatingLabel="true" class="@Styles.W100">
                <Start>
                    <RadzenIcon Icon="receipt" class="rz-color-on-base-2" />
                </Start>
                <ChildContent>
                    <RadzenTextBox @bind-Value="LoanRepayment.OfficialReceiptNo"
                                   Disabled="@isBusy"
                                   class="@Styles.W100" />
                </ChildContent>
                <Helper>
                    <ValidationMessage For="@(() => LoanRepayment.OfficialReceiptNo)" />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Penalty Amount" AllowFloatingLabel="true" class="@Styles.W100">
                <Start>
                    <RadzenIcon Icon="warning_amber" class="rz-color-on-base-2" />
                </Start>
                <ChildContent>
                    <RadzenNumeric TValue="decimal?"
                                   Value="LoanRepayment.PenaltyAmount"
                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                   TextAlign="TextAlign.End"
                                   class="@Styles.W100"
                                   Format="@Defaults.DefaultCurrencyFormat"
                                   Min="0"
                                   Disabled="@isBusy"
                                   @oninput="CalculatePenaltyAmount"
                                   ShowUpDown="false" />
                </ChildContent>
            </RadzenFormField>

            <RadzenFormField Text="Total Amount" AllowFloatingLabel="true" class="@Styles.W100">
                <Start>
                    <RadzenIcon Icon="calculate" class="rz-color-on-base-2" />
                </Start>
                <ChildContent>
                    <RadzenNumeric TValue="decimal?"
                                   Value="LoanRepayment.SubTotal"
                                   ShowUpDown="false"
                                   TextAlign="TextAlign.End"
                                   class="@Styles.W100"
                                   ReadOnly
                                   Min="0"
                                   Format="@Defaults.DefaultCurrencyFormat" />
                </ChildContent>
                <Helper>
                    <ValidationMessage For="@(() => LoanRepayment.SubTotal)" />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Receive Amount" AllowFloatingLabel="true" class="@Styles.W100">
                <Start>
                    <RadzenIcon Icon="payments" class="rz-color-on-base-2" />
                </Start>
                <ChildContent>
                    <RadzenNumeric TValue="decimal?"
                                   ShowUpDown="false"
                                   class="@Styles.W100"
                                   onclick="this.querySelector('.rz-numeric-input').select()"
                                   @bind-Value="LoanRepayment.RecieveAmount"
                                   Format="#,##0.00"
                                   Min="0"
                                   Disabled="@isBusy"
                                   @oninput="@ReceivePaymentChanged"
                                   @onfocusout="ReceivePaymentFocus"
                                   TextAlign="TextAlign.End" />
                </ChildContent>
                <Helper>
                    <ValidationMessage For="@(() => LoanRepayment.RecieveAmount)" />
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Change" AllowFloatingLabel="true" class="@Styles.W100">
                <Start>
                    <RadzenIcon Icon="currency_exchange" class="rz-color-on-base-2" />
                </Start>
                <ChildContent>
                    <RadzenNumeric TValue="decimal?"
                                   @bind-Value="LoanRepayment.ChangeAmount"
                                   TextAlign="TextAlign.End"
                                   class="@Styles.W100"
                                   Format="#,##0.00"
                                   ReadOnly
                                   Min="0"
                                   ShowUpDown="false" />
                </ChildContent>
            </RadzenFormField>

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween"
                         class="rz-pt-1"
                         Gap="0.5rem">
                <RadzenButton ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small"
                              Icon="restart_alt"
                              Text="Default"
                              Disabled="@isBusy"
                              Click="RestoreDefault" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.Small"
                                  Icon="cancel"
                                  Text="Close"
                                  Disabled="@isBusy"
                                  Click="@CloseModal" />
                    <RadzenButton ButtonStyle="ButtonStyle.Success"
                                  Size="ButtonSize.Small"
                                  Icon="@IconNames.Save"
                                  Text="Receive Payment"
                                  IsBusy="isBusy"
                                  BusyText="Processing..."
                                  Click="@OnSaveChanges" />
                </RadzenStack>
            </RadzenStack>

        </RadzenStack>
    </EditForm>

</RadzenStack>

@code {

    RadzenButton _exchangeBtn = default!;

    Popup _exchangePopup = default!;

    private int? _selectedCurrencyId = 0;

    private decimal? _exchangedAmount = 0;

    DialogOptions options = new DialogOptions
    {
        Width = "40rem",
        CloseDialogOnOverlayClick = true,
        Left = "0"
    };

    async Task OpenPopup()
    {
        if (LoanRepayment.ChangeAmount <= 0)
        {
            _selectedCurrencyId = LoanRepayment.CurrencyRefId;

            _exchangedAmount = LoanRepayment.RecieveAmount ?? 0;
        }
        else
        {
            _selectedCurrencyId = LoanRepayment.CurrencyRefId;

            _exchangedAmount = LoanRepayment.ChangeAmount;
        }

        await _exchangePopup.ToggleAsync(_exchangeBtn.Element);
    }

    async Task ClosedPopup()
    {
        await _exchangePopup.CloseAsync(_exchangeBtn.Element);
    }

}