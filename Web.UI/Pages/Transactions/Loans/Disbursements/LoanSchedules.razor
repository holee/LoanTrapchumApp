@using Applications.Features.Customers.Response
@using Applications.Features.Loans.Dtos.Requests

<style>
    .schedule-page {
        font-family: 'Kantumruy Pro', 'Battambang', 'Inter', sans-serif;
        color: #1a1a1a;
        background: #ffffff;
        padding: 2.5rem;
        max-width: 1050px;
        margin: 0 auto 2.5rem auto;
        box-shadow: 0 8px 24px rgba(0,0,0,0.06);
        border-radius: 12px;
    }
    .table-container {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
        margin-bottom: 2.5rem;
    }
    .table-container th, .table-container td {
        border: 1px solid #cbd5e0;
        padding: 0.75rem 0.5rem;
    }
    .table-container th {
        font-weight: 700;
        text-align: center;
        background-color: #f1f5f9;
        color: #2d3748;
    }
    .table-container td.num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }
    .table-container td.center {
        text-align: center;
    }
    .table-footer td {
        font-weight: 700;
        background-color: #f8fafc;
    }
    @@media print {
        .schedule-page {
            box-shadow: none;
            border-radius: 0;
            margin: 0;
            padding: 0;
            page-break-after: always;
        }
        body {
            background: #fff;
        }
        .table-container th {
            background-color: #f8fafc !important;
            -webkit-print-color-adjust: exact;
        }
    }
</style>

@foreach (var item in groupedSchedules)
{
    <div class="schedule-page">
        <table style="width: 100%; margin-bottom: 2rem; border: none; font-size: 0.9rem;">
            <tr>
                <td colspan="2" style="width: 33%; vertical-align: top; border: none; padding: 0;">
                    <img src="/assets/logo/trapchum.jpg" alt="Trapchum Logo" style="height: 70px; object-fit: contain;" />
                </td>
                <td colspan="2" style="width: 34%; text-align: center; vertical-align: top; border: none; padding: 0;">
                    <h2 style="margin: 0; font-size: 1.6rem; font-weight: 700; color: #2c3e50; letter-spacing: 0.5px;">ទ្រព្យជុំ វ័យស ដន សប</h2>
                    <h3 style="margin: 0.3rem 0; font-size: 1rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #555;">TRAP CHUM CASH PAWN SHOP</h3>
                    <h1 style="margin: 1rem 0 0 0; font-size: 1.5rem; font-weight: 700;">កាលវិភាគបង់ប្រាក់</h1>
                </td>
                <td colspan="2" style="width: 33%; border: none; padding: 0;"></td>
            </tr>
            <tr><td colspan="6" style="height: 2rem; border: none;"></td></tr>
            <tr>
                <td style="width: 15%; font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">ឈ្មោះអតិថិជន</td>
                <td style="width: 18%; font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @(Customer?.FullName ?? "-")</td>
                
                <td style="width: 15%; font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">អាសយដ្ឋាន</td>
                <td style="width: 19%; font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @(Customer?.ToString() ?? "-")</td>
                
                <td style="width: 10%; font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">ទូរស័ព្ទ</td>
                <td style="width: 23%; font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @(Phone1 ?? Customer?.Phone ?? "-")</td>
            </tr>
            <tr>
                <td style="font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">កិច្ចសន្យាលេខ</td>
                <td style="font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @(ContractNo ?? "-")</td>
                
                <td style="font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">ចំនួនទឹកប្រាក់ខ្ចី</td>
                <td style="font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @(LoanAmount?.ToString("N2") ?? "0.00")</td>
                
                <td style="font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">ការប្រាក់</td>
                <td style="font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @(InterestRateStr ?? "-")</td>
            </tr>
            <tr>
                <td style="font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">គណនីលេខ</td>
                <td style="font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @(AccountNo ?? "-")</td>
                
                <td style="font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">ថ្ងៃផុតកំណត់</td>
                <td style="font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @(MaturityDate?.ToString("dd-MM-yyyy") ?? "-")</td>
                
                <td style="font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">ទូរស័ព្ទ</td>
                <td style="font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @(Phone2 ?? Customer?.AltPhone ?? "-")</td>
            </tr>
            <tr>
                <td style="font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">ថ្ងៃខ្ចីប្រាក់</td>
                <td style="font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @(LoanDate?.ToString("dd-MM-yyyy") ?? "-")</td>
                
                <td style="font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">ភ្នាក់ងារ</td>
                <td style="font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @(AgentName ?? Customer?.CreatedByUserName ?? "-")</td>
                
                <td style="font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">ច្បាប់ទី</td>
                <td style="font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @CopyNo</td>
            </tr>
            <tr>
                <td style="font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">រយៈពេលខ្ចីប្រាក់</td>
                <td style="font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @(LoanTerm != null ? $"{LoanTerm} ខែ" : "-")</td>
                
                <td style="font-weight: 600; color: #4a5568; border: none; padding: 0 0 6px 0;">ការិយាល័យ</td>
                <td style="font-weight: 700; color: #1a202c; border: none; padding: 0 0 6px 0;">: @(OfficeName ?? Customer?.BranchName ?? "-")</td>
                
                <td colspan="2" style="border: none; padding: 0 0 6px 0;"></td>
            </tr>
        </table>

        <table class="table-container">
            <thead>
                <tr>
                    <th>ល.រ</th>
                    <th>ថ្ងៃត្រូវបង់ប្រាក់</th>
                    <th>ចំនួនថ្ងៃ</th>
                    <th>ប្រាក់ដើមត្រូវបង់</th>
                    <th>ការប្រាក់ត្រូវបង់</th>
                    <th>ប្រាក់ប្រសិទ្ធភាព</th>
                    <th>សរុបប្រាក់ត្រូវបង់</th>
                    <th>ប្រាក់ដើមនៅសល់</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in item.Value)
                {
                    <tr>
                        <td class="center">@(c.InstallmentNo == 0 ? "-" : c.InstallmentNo.ToString())</td>
                        <td class="center">@(c.PaymentDate?.ToString("dd-MM-yyyy") ?? "-")</td>
                        <td class="center">@(c.TotalDay) ថ្ងៃ</td>
                        <td class="num">@c.Principal.Format(CurrencyId)</td>
                        <td class="num">@c.Interest.Format(CurrencyId)</td>
                        <td class="num">@c.CollectionFee.Format(CurrencyId)</td>
                        <td class="num">@c.TotalPay.Format(CurrencyId)</td>
                        <td class="num">@c.LoanOutstanding.Format(CurrencyId)</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-footer">
                <tr>
                    <td class="center" colspan="2">សរុប</td>
                    <td class="center">@item.Value.Sum(p => p.TotalDay) ថ្ងៃ</td>
                    <td class="num">@item.Value.Sum(p => p.Principal).Format(CurrencyId)</td>
                    <td class="num">@item.Value.Sum(p => p.Interest).Format(CurrencyId)</td>
                    <td class="num">@item.Value.Sum(p => p.CollectionFee).Format(CurrencyId)</td>
                    <td class="num">@item.Value.Sum(p => p.TotalPay).Format(CurrencyId)</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        <table style="width: 100%; margin-top: 3rem; font-size: 0.95rem; font-weight: 700; color: #2d3748; text-align: center; border: none;">
            <tr>
                <td style="width: 50%; padding: 0 4rem; border: none; vertical-align: top;">
                    <div>ស្នាមមេដៃអតិថិជន</div>
                    <div style="height: 100px; margin-top: 10px;"></div>
                </td>
                <td style="width: 50%; padding: 0 4rem; border: none; vertical-align: top;">
                    <div>ហត្ថលេខាអ្នករៀបចំ</div>
                    <div style="height: 100px; margin-top: 10px;"></div>
                </td>
            </tr>
        </table>
    </div>
}

@code {
    [Parameter] public int? CurrencyId { get; set; } = 1;
    [Parameter] public VCustomerDetails? Customer { get; set; }
    [Parameter] public IEnumerable<LoanScheduleDtoCreate> Schedules { get; set; } = [];

    // Additional info fields mapping to the print header
    [Parameter] public string? ContractNo { get; set; }
    [Parameter] public string? AccountNo { get; set; }
    [Parameter] public DateTime? LoanDate { get; set; }
    [Parameter] public int? LoanTerm { get; set; }
    [Parameter] public decimal? LoanAmount { get; set; }
    [Parameter] public DateTime? MaturityDate { get; set; }
    [Parameter] public string? AgentName { get; set; }
    [Parameter] public string? OfficeName { get; set; }
    [Parameter] public string? Phone1 { get; set; }
    [Parameter] public string? Phone2 { get; set; }
    [Parameter] public string? InterestRateStr { get; set; }
    [Parameter] public int? CopyNo { get; set; } = 1;

    private Dictionary<int, List<LoanScheduleDtoCreate>> groupedSchedules = new();

    protected override void OnInitialized()
    {
        CreateGroupedSchedules();
        base.OnInitialized();
    }

    private void CreateGroupedSchedules()
    {
        if (Schedules == null || !Schedules.Any())
        {
            return;
        }

        groupedSchedules = Schedules
            .Chunk(15) // Changed chunk size from 4 to 15 for a cleaner printed page since Radzen is gone
            .Select((chunk, index) => new
            {
                Index = index,
                Group = BuildGroup(chunk)
            })
            .ToDictionary(x => x.Index, x => x.Group);
    }

    private static List<LoanScheduleDtoCreate> BuildGroup(IEnumerable<LoanScheduleDtoCreate> source)
    {
        var group = source.ToList();

        // In the original design, there was an Opening and Closing row inserted per chunk.
        // I have kept it here for consistency with the original logic but adjusted it
        // so it looks decent in the new UI.
        var first = group.First();
        var last = group.Last();

        var opening = CreateOpeningRow(first);
        var closing = CreateClosingRow(last);

        group.Add(opening);
        group.Add(closing);

        return group
            .OrderBy(x => x.InstallmentNo)
            .ToList();
    }

    private static LoanScheduleDtoCreate CreateOpeningRow(LoanScheduleDtoCreate first)
    {
        return new LoanScheduleDtoCreate
        {
            InstallmentNo = 0,
            PaymentDate = null,
            TotalDay = 0,
            Principal = 0,
            Interest = 0,
            CollectionFee = 0,
            TotalPay = 0,
            LoanOutstanding = first.LoanOutstanding + first.Principal
        };
    }

    private static LoanScheduleDtoCreate CreateClosingRow(LoanScheduleDtoCreate last)
    {
        return new LoanScheduleDtoCreate
        {
            InstallmentNo = last.InstallmentNo + 1,
            PaymentDate = null,
            TotalDay = 0,
            Principal = last.LoanOutstanding,
            Interest = 0,
            CollectionFee = 0,
            TotalPay = 0,
            LoanOutstanding = 0
        };
    }
}