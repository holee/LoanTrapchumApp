@page "/App/Loans/Products"
@using Applications.Responses.ViewModels.Loans.Products
<PageTitle>Loan Products</PageTitle>
<RadzenTabs @ref="tabs" RenderMode="TabRenderMode.Server" @bind-SelectedIndex="SelectIndex">
    <Tabs>
        <RadzenTabsItem Text="Products" Icon="list">
            <GridToolbar>
                <LeftChildren>
                    <RadzenButton Click="OnCreate" Disabled
                                  Icon="add"
                                  Text="New LoanProduct"
                                  ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small">
                    </RadzenButton>
                </LeftChildren>
                <RightChildren>
                    <div class="text-start">
                        <RadzenCheckBox TValue="bool"
                                        Value="@IsIncludeInActive"
                                        Name="inactive"
                                        Change="OnIsActive" />
                        <RadzenLabel Text="Include inactive" Component="inactive" />
                    </div>
                </RightChildren>
            </GridToolbar>
            <RadzenDataGrid GridLines="DataGridGridLines.Both"
                            Count="@counts"
                            PageSize="@pageSize"
                            PagerPosition="PagerPosition.Bottom"
                            ShowPagingSummary="true"
                            Density="Density.Compact"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            PageSizeOptions="@StorageConstant.PageSizeOptions"
                            PageSizeChanged="@PageSizeChanged"
                            AllowSorting="true"
                            AllowFiltering="true"
                            AllowPaging="true"
                            IsLoading="isLoading"
                            LoadData="@LoadData"
                            TItem="VlProductList"
                            CellContextMenu="@ShowCellContextMenu"
                            Data="@VLProducts">
                <Columns>
                    <RadzenDataGridColumn Width="5rem"
                                          Title="#"
                                          Filterable="false"
                                          Context="h"
                                          TextAlign="TextAlign.Center"
                                          Sortable="false">
                        <Template>
                            @(VLProducts.IndexOf(h) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="Code" 
                                          Width="7rem"
                                          Property="@nameof(VlProductList.LoanProductCode)" />
                    <RadzenDataGridColumn Title="Product Name" Property="@nameof(VlProductList.LoanProductName)" />
                    <RadzenDataGridColumn Title="Loan Size" Property="@nameof(VlProductList.LoanSize)" />
                    <RadzenDataGridColumn Title="Currency" Property="@nameof(VlProductList.CurrencyCode)" />
                    <RadzenDataGridColumn Title="Installment"
                                          Filterable="false"
                                          Sortable="false"
                                          Property="@nameof(VlProductList.Installments)" />
                    <RadzenDataGridColumn Title="Status"
                                          Filterable="false"
                                          Width="6rem"
                                          TextAlign="TextAlign.Center"
                                          Sortable="false" Context="c">
                        <Template>
                            <RadzenCheckBox TValue="bool"
                                            Value="c.IsActive"
                                            Change="@((arg)=>ChangeStatus(arg,c.LoanProductId))" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="5rem"
                                          Title="Actions"
                                          Filterable="false"
                                          TextAlign="TextAlign.Center"
                                          Sortable="false"
                                          Context="c">
                        <Template>
                            <RadzenButton Size="ButtonSize.ExtraSmall"
                                          Icon="@IconNames.MoreVert"
                                          Variant="Variant.Text"
                                          Click="@((args)=>ShowContextMenuWithContent(args,c))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>

        </RadzenTabsItem>
        <RadzenTabsItem Text="Loan Product Details" Visible="IsDetails">
            <LPModalDetail Id="@Id" CloseTab="@CloseTabs" />
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    void ShowContextMenuWithContent(MouseEventArgs args, VlProductList e)
    {
        ContextMenuService.Open(args, BuildProductMenuItems(e), me =>
        {
            ContextMenuService.Close();
            HandleProductAction(me.Value?.ToString(), e);
        });
    }

    void ShowCellContextMenu(DataGridCellMouseEventArgs<VlProductList> args)
    {
        if (args.Data is null) return;

        ContextMenuService.Open(args, BuildProductMenuItems(args.Data), me =>
        {
            ContextMenuService.Close();
            HandleProductAction(me.Value?.ToString(), args.Data);
        });
    }

    List<ContextMenuItem> BuildProductMenuItems(VlProductList e) =>
    [
        new ContextMenuItem { Text = "Details", Icon = "info",   Value = "1" },
        new ContextMenuItem { Text = "Edit",    Icon = "edit",   Value = "2", Disabled = true },
        new ContextMenuItem { Text = "Delete",  Icon = "delete", Value = "3" },
    ];

    void HandleProductAction(string? value, VlProductList e)
    {
        switch (value)
        {
            case "1": LPDetails(e.LoanProductId); break;
            case "2": _ = OnEdit(e);              break;
            case "3": _ = OnDelete(e);            break;
        }
    }
}
