@using Web.UI.Pages.Transactions.Exchanges
<RadzenFieldset>
    <RadzenRow AlignItems="AlignItems.Center" class="rz-px-1 rz-py-2 rz-m-0">
        <RadzenColumn Size="5">
            <RadzenButton class="rz-w-100"
                          Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Primary">
                Paid Amount
                <RadzenBadge BadgeStyle="BadgeStyle.Secondary"
                             IsPill="@true"
                             class="rz-ms-2">
                    <ChildContent>
                        @LoanRepayment.AmountWithoutPenalty.Format(CurrencyId)
                    </ChildContent>
                </RadzenBadge>
            </RadzenButton>
        </RadzenColumn>
        <RadzenColumn Size="5">
            <RadzenButton class="rz-w-100"
                          Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Primary">
                Penalty Amount
                <RadzenBadge BadgeStyle="BadgeStyle.Danger"
                             IsPill="@true"
                             class="rz-ms-2">
                    <ChildContent>
                        @(LoanRepayment.PaidPenaltyAmount.Format(CurrencyId))
                    </ChildContent>
                </RadzenBadge>
            </RadzenButton>
        </RadzenColumn>
        <RadzenColumn Size="2">
            <RadzenStack Orientation="Orientation.Horizontal"
                         JustifyContent="JustifyContent.End"
                         AlignItems="AlignItems.Center">
                <RadzenButton Click="RestoreDefault"
                              ButtonStyle="ButtonStyle.Primary"
                              Text="Default"
                              Size="ButtonSize.Small">
                </RadzenButton>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-2">
        <RadzenColumn Size="12">
            <RadzenFormField Text="Receipt No" AllowFloatingLabel="true" class="rz-w-100">
                <RadzenTextBox @bind-Value="LoanRepayment.OfficialReceiptNo"
                                ReadOnly="@(!(string.IsNullOrEmpty(LoanRepayment.OfficialReceiptNo)))"
                               class="rz-w-100" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-2">
        <RadzenColumn Size="12">
            <RadzenFormField Text="Penalty Amount" AllowFloatingLabel="true" class="rz-w-100">
                <RadzenNumeric TValue="decimal?"
                               Value="LoanRepayment.PenaltyAmount"
                               onclick="this.querySelector('.rz-numeric-input').select()"
                               TextAlign="TextAlign.End"
                               class="rz-w-100"
                               Format="#,##0.00"
                               Min="0"
                               @oninput="CalculatePenaltyAmount"
                               ShowUpDown="false" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-2">
        <RadzenColumn Size="12">
            <RadzenFormField Text="Total Amount" AllowFloatingLabel="true" class="rz-w-100">
                <RadzenNumeric TValue="decimal?"
                               Value="LoanRepayment.SubTotal"
                               ShowUpDown="false"
                               TextAlign="TextAlign.End"
                               class="rz-w-100"
                               ReadOnly
                               Min="0"
                               Format="#,##0.00" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-2">
        <RadzenColumn Size="12">
            <RadzenFormField Text="Recieve Amount" AllowFloatingLabel="true" class="rz-w-100">
                <RadzenNumeric TValue="decimal?"
                               ShowUpDown="false"
                               class="rz-w-100"
                               onclick="this.querySelector('.rz-numeric-input').select()"
                               @bind-Value="LoanRepayment.RecieveAmount"
                               Format="#,##0.00"
                               Min="0"
                               @oninput="@ReceivePaymentChanged"
                               @onfocusout="ReceivePaymentFocus"
                               TextAlign="TextAlign.End" />
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow AlignItems="AlignItems.Center" class="rz-mt-2">
        <RadzenColumn Size="12">
            <RadzenFormField Text="Change" AllowFloatingLabel="true" class="rz-w-100">
                <RadzenNumeric TValue="decimal?"
                               @bind-Value="LoanRepayment.ChangeAmount"
                               TextAlign="TextAlign.End"
                               class="rz-w-100"
                               Format="#,##0.00"
                               ReadOnly
                               Min="0"
                               ShowUpDown="false">
                </RadzenNumeric>
            </RadzenFormField>
        </RadzenColumn>
    </RadzenRow>
    <RadzenStack Orientation="Orientation.Horizontal"
                 AlignItems="AlignItems.Center"
                 class="rz-mt-3"
                 JustifyContent="JustifyContent.End"
                 Gap="1rem">
        <RadzenButton ButtonStyle="ButtonStyle.Success"
                      Size="ButtonSize.ExtraSmall"
                      Icon="@IconNames.Save"
                      Text="Recieve Payment"
                      IsBusy="isBusy"
                      BusyText="Recieving..."
                      Click="@OnSaveChanges">
        </RadzenButton>
        <RadzenButton Size="ButtonSize.ExtraSmall"
                      ButtonStyle="ButtonStyle.Danger"
                      Icon="cancel"
                      Text="Close"
                      Click="@CloseModal">
        </RadzenButton>
    </RadzenStack>
</RadzenFieldset>
@code {

    SideDialogOptions options = new SideDialogOptions
    {
        Width = "30rem",
        CloseDialogOnOverlayClick = true,
    };

    void OpenSide()
    {
        DialogService.OpenSide<ExchangesSidebar>("Money Exchanged", options: options);
    }
}