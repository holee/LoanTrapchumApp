@page "/App/Account/Login"
@attribute [AllowAnonymous]
@layout Web.UI.Layout.EmptyLayout
@using System.ComponentModel.DataAnnotations
@using Applications.Features.Identity.Users
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Radzen.Blazor
@using Web.UI.Services.Authentications
@inject AuthenticationClient _authClient
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider _authStateProvider

<PageTitle>Sign in</PageTitle>

<div class="login-shell">
    <div class="login-card">
        <div class="login-card__head">
            <RadzenIcon Icon="account_balance" />
            <h1 class="login-card__title">សហគ្រាសបញ្ចាំទ្រព្យជុំ</h1>
            <p class="login-card__sub">Sign in to continue to the Loan Management System</p>
        </div>

        <EditForm Model="_model" OnValidSubmit="SignInAsync" FormName="login">
            <DataAnnotationsValidator />

            <div class="login-field">
                <label for="login-email">Email</label>
                <InputText id="login-email" class="login-input" @bind-Value="_model.Email"
                           autocomplete="username" placeholder="you@example.com" />
                <ValidationMessage For="@(() => _model.Email)" />
            </div>

            <div class="login-field">
                <label for="login-password">Password</label>
                <InputText id="login-password" type="password" class="login-input" @bind-Value="_model.Password"
                           autocomplete="current-password" placeholder="••••••••" />
                <ValidationMessage For="@(() => _model.Password)" />
            </div>

            <label class="login-remember">
                <InputCheckbox @bind-Value="_model.RememberMe" />
                <span>Remember me</span>
            </label>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="login-error" role="alert">@_error</div>
            }

            <button type="submit" class="login-submit" disabled="@_busy">
                @if (_busy)
                {
                    <span>Signing in…</span>
                }
                else
                {
                    <span>Sign in</span>
                }
            </button>
        </EditForm>

        <div class="login-card__foot">&copy; @DateTime.Now.Year LoanMS</div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private readonly LoginModel _model = new();
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var state = await _authStateProvider.GetAuthenticationStateAsync();

        if (state.User.Identity?.IsAuthenticated == true)
        {
            NavigationManager.NavigateTo(Destination(), replace: true);
        }
    }

    private async Task SignInAsync()
    {
        _busy = true;
        _error = null;

        var request = new LoginRequest
        {
            Email = _model.Email,
            Password = _model.Password,
            RememberMe = _model.RememberMe
        };

        var (success, message) = await _authClient.LoginAsync(request);

        _busy = false;

        if (!success)
        {
            _error = string.IsNullOrWhiteSpace(message) ? "Invalid credentials." : message;
            return;
        }

        NavigationManager.NavigateTo(Destination(), replace: true);
    }

    private string Destination()
        => string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : $"/{ReturnUrl.TrimStart('/')}";

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
