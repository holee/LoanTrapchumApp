@page "/app/administration/areas"
@using Applications.Features.Addresses.Dto
@using Applications.Features.Addresses.Queries.GetAreas
<PageTitle>Areas</PageTitle>

<div class="rz-background-color-base-200 rounded p-2">
    <GridToolbar SearchChanged="SearchChanged" Placeholder="Search areas...">
        <LeftChildren>
            <RadzenButton Text="New Area"
                          Click="ShowCreate"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small"
                          Icon="add" />
        </LeftChildren>
    </GridToolbar>

    <RadzenDataGrid TItem="AreaDto"
                    Data="@Areas"
                    Responsive="true"
                    Density="Density.Compact"
                    AllowPaging="true"
                    AllowFiltering="true"
                    AllowSorting="true"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    ShowPagingSummary="true"
                    PagerPosition="PagerPosition.Bottom"
                    PagerHorizontalAlign="HorizontalAlign.Right"
                    PageSize="@pageSize"
                    Count="@counts"
                    LoadData="LoadAreaData"
                    CellContextMenu="ShowCellContextMenu"
                    IsLoading="@isLoading"
                    Style="min-height:75dvh;"
                    RowRender="@OnRowRender"
                    PageSizeOptions="@StorageConstant.PageSizeOptions">
        <Columns>
            <RadzenDataGridColumn TItem="AreaDto" Width="5rem" Title="#" Sortable="false" Filterable="false">
                <Template Context="c">@c.RowIndex</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AreaDto" Property="@nameof(AreaDto.Code)" Title="Code" Width="8rem" />
            <RadzenDataGridColumn TItem="AreaDto" Property="@nameof(AreaDto.Phum)" Title="ភូមិ" />
            <RadzenDataGridColumn TItem="AreaDto" Property="@nameof(AreaDto.Khum)" Title="ឃុំ/សង្កាត់" />
            <RadzenDataGridColumn TItem="AreaDto" Property="@nameof(AreaDto.Srok)" Title="ស្រុក/ខណ្ឌ" />
            <RadzenDataGridColumn TItem="AreaDto" Property="@nameof(AreaDto.Khet)" Title="ខេត្រ/ក្រុង" />
            <RadzenDataGridColumn TItem="AreaDto" Property="@nameof(AreaDto.AreaName)" Title="ឈ្មោះតំបន់" Width="14rem" />
            <RadzenDataGridColumn TItem="AreaDto" Title="Actions" Width="5rem" Filterable="false" Sortable="false">
                <Template Context="c">
                    <RadzenButton Size="ButtonSize.ExtraSmall"
                                  Icon="more_vert"
                                  Variant="Variant.Text"
                                  Click="@((args) => ShowContextMenuWithContent(args, c.Id))" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
        <EmptyTemplate>
            <RadzenStack AlignItems="AlignItems.Center" Gap="4px" class="p-4">
                <RadzenIcon Icon="location_off" Style="font-size: 2rem;" class="rz-color-base-500" />
                <RadzenText TextStyle="TextStyle.Body1" class="rz-color-base-500">No areas found.</RadzenText>
            </RadzenStack>
        </EmptyTemplate>
    </RadzenDataGrid>
</div>

@code {
    public IEnumerable<AreaDto>? Areas { get; set; }
    private string? searchText = string.Empty;
    private int pageSize = 15;
    private int pageIndex = 0;
    private int counts = 0;
    private bool isLoading;
    private bool _isDescending = false;
    private string _sortColumn = nameof(AreaDto.Id);
    private string? _filterColumn = null;

    private readonly string[] _fieldProps = [
        nameof(AreaDto.Code),
        nameof(AreaDto.AreaName),
        nameof(AreaDto.Khet),
        nameof(AreaDto.Srok),
        nameof(AreaDto.Khum),
        nameof(AreaDto.Phum)
    ];

    protected override async Task OnInitializedAsync()
    {
        if (Areas is null)
        {
            await LoadAreas();
        }
    }

    private async Task SearchChanged(string? text)
    {
        searchText = text;

        await LoadAreas();
    }

    private async Task LoadAreaData(LoadDataArgs args)
    {

        (_sortColumn, _filterColumn, _isDescending, pageIndex, pageSize) = args.GetInfo(nameof(AreaDto.Id));

        searchText = args.FilterValue(_fieldProps);

        await LoadAreas();
    }




    private async Task LoadAreas()
    {
        isLoading = true;

        try
        {
            var param = new QueryParam(pageIndex, pageSize, searchText, _sortColumn, _filterColumn, false, _isDescending);

            var query = new GetAreasQuery(0, param);

            var result = await mediator.Send(query);

            Areas = result.Items;

            counts = result.TotalCount;

            isLoading = false;

        }
        finally
        {
            isLoading = false;
        }

        StateHasChanged();
    }

    private void ShowContextMenuWithContent(MouseEventArgs args, long id)
    {
        ContextMenuService.Open(args, BuildAreaMenuItems(), me =>
        {
            ContextMenuService.Close();

            HandleAreaAction(me.Value?.ToString(), id);
        });
    }

    private void ShowCellContextMenu(DataGridCellMouseEventArgs<AreaDto> args)
    {
        if (args.Data is null) return;

        ContextMenuService.Open(args, BuildAreaMenuItems(), me =>
        {
            ContextMenuService.Close();
            HandleAreaAction(me.Value?.ToString(), args.Data.Id);
        });
    }

    private static List<ContextMenuItem> BuildAreaMenuItems() =>
    [
        new ContextMenuItem { Text = "Details", Icon = "info",   Value = "1" },
        new ContextMenuItem { Text = "Edit",    Icon = "edit",   Value = "2" },
        new ContextMenuItem { Text = "Delete",  Icon = "delete", Value = "3" },
    ];

    private void HandleAreaAction(string? value, long id)
    {
        switch (value)
        {
            case "1": Details(id); break;
            case "2": Edit(id); break;
            case "3": _ = Delete(id); break;
        }
    }

    private void Details(long id)
    {
        NotificationService.Notify(NotificationSeverity.Info, "Area details are not implemented yet.");
    }

    private void ShowCreate()
    {
        DialogService.OpenAsync<AreaCreateComponent>("Create Area",
        new Dictionary<string, object?>
        {

        },
        new DialogOptions
        {
            Width = "500px",
            Height = "auto",
            Resizable = false,
            Draggable = true,
        });
    }

    private void Edit(long id)
    {
        NotificationService.Notify(NotificationSeverity.Info, "Area editing is not implemented yet.");
    }

    private async Task Delete(long id)
    {
        var confirm = await DialogService.Confirm("Do you want to delete this area record?", "Delete", new ConfirmOptions
        {
            CancelButtonText = "Cancel",
            OkButtonText = "OK",
        });

        if (confirm == true)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Area deletion is not implemented yet.");
        }
    }

    private void OnRowRender(RowRenderEventArgs<AreaDto> args)
    {
        if (args.Data is null) return;

        args.Data.RowIndex = args.Index + 1;
    }
}
