@using Applications.Features.Addresses.Dto
@using Domains.Models.Addresses
<RadzenRow AlignItems="AlignItems.Center" class="rz-my-3">
    <RadzenColumn Size="12">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
            <RadzenIcon Icon="home" IconStyle="IconStyle.Primary" />
            <strong>Address</strong>
        </RadzenStack>
    </RadzenColumn>
</RadzenRow>
<RadzenRow AlignItems="AlignItems.Center">
    <RadzenColumn Size="3">
        <RadzenFormField AllowFloatingLabel="true" Text="ប្រទេស" class="rz-w-100">
            <RadzenDropDown class="rz-w-100"
                            Data="Countries"
                            AllowFiltering="true"
                            Placeholder="Search Countries"
                            FilterOperator="StringFilterOperator.Contains"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            TextProperty="@nameof(Country.DesInKhmer)"
                            ValueProperty="@nameof(Country.DesInKhmer)"
                            @bind-Value="model.CountryName">
            </RadzenDropDown>
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <RadzenFormField Text="ខេត្ត/រាជធានី" AllowFloatingLabel="true" class="rz-w-100">
            <RadzenDropDown class="rz-w-100"
                            Data="Provinces"
                            Placeholder="Search Province"
                            AllowFiltering="true"
                            TextProperty="@nameof(ProvinceDto.ProInKhmer)"
                            ValueProperty="@nameof(ProvinceDto.ProvinceId)"
                            SelectedItemChanged="@SelectedProvinceChanged"
                            FilterOperator="StringFilterOperator.Contains"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            @bind-Value="model.ProvinceRefId">
            </RadzenDropDown>
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="2">
        <RadzenFormField Text="ស្រុក/ខណ្ឌ" AllowFloatingLabel="true" class="rz-w-100">
            <RadzenDropDown class="rz-w-100"
                            Data="Districts"
                            Placeholder="Search District"
                            AllowFiltering="true"
                            TextProperty="@nameof(DistrictDto.DisInKhmer)"
                            ValueProperty="@nameof(DistrictDto.DistrictId)"
                            SelectedItemChanged="SelectedDistrictChanged"
                            FilterOperator="StringFilterOperator.Contains"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            @bind-Value="model.DistrictRefId">
            </RadzenDropDown>
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="2">
        <RadzenFormField AllowFloatingLabel="true" Text="ឃុំ/សង្កាត់" class="rz-w-100">
            <RadzenDropDown class="rz-w-100"
                            Data="Communes"
                            Placeholder="Search Commune"
                            AllowFiltering="true"
                            TextProperty="@nameof(CommuneDto.ComInKhmer)"
                            ValueProperty="@nameof(CommuneDto.CommuneId)"
                            SelectedItemChanged="SelectedCommuneChanged"
                            FilterOperator="StringFilterOperator.Contains"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            @bind-Value="model.CommuneRefId">
            </RadzenDropDown>
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="2">
        <RadzenFormField Text="ភូមិ" AllowFloatingLabel="false" class="rz-w-100">
            <RadzenDropDown class="rz-w-100"
                            Data="Villages"
                            Placeholder="Search Village"
                            AllowFiltering="true"
                            TextProperty="@nameof(VillageDto.VilInKhmer)"
                            ValueProperty="@nameof(VillageDto.VillageId)"
                            SelectedItemChanged="SelectedVillageChanged"
                            FilterOperator="StringFilterOperator.Contains"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            @bind-Value="model.VillageRefId">
            </RadzenDropDown>
        </RadzenFormField>
    </RadzenColumn>
</RadzenRow>
