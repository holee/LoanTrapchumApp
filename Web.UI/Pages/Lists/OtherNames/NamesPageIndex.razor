@page "/App/Names"
@using Applications.Responses.ViewModels.OtherNames
@using Web.UI.Components.Buttons
<PageTitle>Names</PageTitle>
<RadzenTabs @bind-SelectedIndex="@selectedIndex" @ref="tabs" RenderMode="TabRenderMode.Server">
    <Tabs>
        <RadzenTabsItem Text="Names" Icon="patient_list">
            <GridToolbar SearchChanged="@SearchChanged">
                <LeftChildren>
                    <AddButton OnClick="@AddTabOtherName" Text="Add New Name" />
                </LeftChildren>
                <RightChildren>
                    <div class="text-center">
                        <RadzenCheckBox TValue="bool"
                                        @bind-Value="@includeInactive"
                                        Change="@((ex)=>IncludeInActiveChanged(ex))"
                                        Name="CheckBox1" />
                        <RadzenLabel Text="Include InActive" Component="CheckBox1" Style="margin-left: 8px; vertical-align: middle;" />
                    </div>
                </RightChildren>
            </GridToolbar>
            <RadzenDataGrid TItem="VOtherNames"
                            Density="Density.Compact"
                            Responsive
                            Count="@counts"
                            PageSize="@pageSize"
                            LoadData="@LoadData"
                            ColumnWidth="15rem"
                            AllowPaging="true"
                            AllowFiltering="true"
                            AllowAlternatingRows="true"
                            IsLoading="@isLoading"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            ShowPagingSummary="true"
                            GridLines="DataGridGridLines.Both"
                            AllowSorting="true"
                            PageSizeOptions="@StorageConstant.PageSizeOptions"
                            PageSizeChanged="@PageSizeChanged"
                            CellContextMenu="@ShowCellContextMenu"
                            Data="@Names">
                <Columns>
                    <RadzenDataGridColumn Title="#"
                                          Filterable="false"
                                          Sortable="false"
                                          Context="name"
                                          Width="5rem"
                                          Property="@(nameof(VOtherNames.Id))">
                        <Template>
                            @(Names.IndexOf(name) + 1)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="10rem" Title="Name" Context="x" Property="@(nameof(VOtherNames.AltName))">
                        <Template>
                            <KhmerName AltName="@x.AltName" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="8rem" Title="Gender" Property="@(nameof(VOtherNames.Gender))" />
                    <RadzenDataGridColumn Sortable="false" Width="8rem" Title="Phone" Property="@(nameof(VOtherNames.Phone))" />
                    <RadzenDataGridColumn Sortable="false" Title="Email" Property="@(nameof(VOtherNames.EmailAddress))" />
                    <RadzenDataGridColumn Sortable="false" Filterable="false" Title="Address" Property="@(nameof(VOtherNames.Description))" Context="v">
                        <Template>
                            <AddressInfo VilInKhmer="@v.VilInKhmer"
                                         ComInKhmer="@v.ComInKhmer"
                                         DisInKhmer="@v.DisInKhmer"
                                         ProInKhmer="@v.ProInKhmer" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Sortable="false"
                                          Title="Status"
                                          Filterable="false"
                                          TextAlign="TextAlign.Center"
                                          Width="6rem"
                                          Property="@(nameof(VOtherNames.Id))"
                                          Context="v">
                        <Template>
                            <RadzenBadge Text="@(v.IsActive ? "Active" : "Inactive")"
                                         BadgeStyle="@(v.IsActive ? BadgeStyle.Success : BadgeStyle.Danger)"
                                         Shade="Shade.Default" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="5rem" Sortable="false"
                                          Filterable="false"
                                          Title="Actions"
                                          TextAlign="TextAlign.Center"
                                          Property="@(nameof(VOtherNames.Id))"
                                          Context="v">
                        <Template>
                            <RadzenButton Size="ButtonSize.ExtraSmall"
                                          Icon="@IconNames.MoreVert"
                                          Variant="Variant.Text"
                                          Click="@((args)=>ShowContextMenuWithContent(args,v))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
                <LoadingTemplate>
                    <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Danger"
                                               Value="100" ShowValue="false"
                                               Mode="ProgressBarMode.Indeterminate" />
                </LoadingTemplate>

            </RadzenDataGrid>
        </RadzenTabsItem>

        @foreach (var tab in _dynamicTabs)
        {
            <RadzenTabsItem @key="tab.Id">
                <Template>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="6px">
                        <RadzenIcon Icon="@tab.Icon" Style="font-size:16px;" />
                        <span>@tab.Title</span>
                        <RadzenButton Icon="close"
                                      Size="ButtonSize.ExtraSmall"
                                      Variant="Variant.Text"
                                      ButtonStyle="ButtonStyle.Light"
                                      Style="padding:2px;min-width:0;"
                                      Click="@(() => CloseTab(tab.Id))"
                                      Click.StopPropagation="true" />
                    </RadzenStack>
                </Template>
                <ChildContent>
                    @switch (tab.Type)
                    {
                        case DynamicTabType.Create:
                            <NameCreateModal SelectIndex="@((e) => CloseTab(tab.Id))" />
                            break;
                        case DynamicTabType.Edit:
                            <NameEditModal OnClose="@(async (edited) => { await OnDynamicEditClose(tab.Id, edited); })"
                                           Id="@tab.EntityId" Salutations="Salutations" />
                            break;
                        case DynamicTabType.Detail:
                            <NameDetailModal OnEdit="@((id) => OpenEditTab(id))"
                                             OnClose="@((e) => CloseTab(tab.Id))"
                                             Id="@tab.EntityId" />
                            break;
                    }
                </ChildContent>
            </RadzenTabsItem>
        }
    </Tabs>
</RadzenTabs>

@code {
    void ShowContextMenuWithContent(MouseEventArgs args, VOtherNames e)
    {
        ContextMenuService.Open(args, BuildNamesMenuItems(e), me =>
        {
            ContextMenuService.Close();
            HandleNameAction(me.Value?.ToString(), e);
        });
    }

    void ShowCellContextMenu(DataGridCellMouseEventArgs<VOtherNames> args)
    {
        if (args.Data is null) return;

        ContextMenuService.Open(args, BuildNamesMenuItems(args.Data), me =>
        {
            ContextMenuService.Close();
            HandleNameAction(me.Value?.ToString(), args.Data);
        });
    }

    List<ContextMenuItem> BuildNamesMenuItems(VOtherNames e) =>
    [
        new ContextMenuItem { Text = "Details",     Icon = "info",                    Value = "1" },
        new ContextMenuItem { Text = "Edit",         Icon = "edit",                    Value = "2" },
        new ContextMenuItem { Text = "Delete",       Icon = "delete",                  Value = "3" },
        new ContextMenuItem { Text = "To Employee",  Icon = "subdirectory_arrow_right", Value = "4" },
        new ContextMenuItem { Text = "To Customer",  Icon = "subdirectory_arrow_right", Value = "5" },
        new ContextMenuItem { Text = "To Vendor",    Icon = "subdirectory_arrow_right", Value = "6" },
    ];

    void HandleNameAction(string? value, VOtherNames e)
    {
        switch (value)
        {
            case "1": OpenDetailTab(e.Id, e.AltName); break;
            case "2": OpenEditTab(e.Id, e.AltName);   break;
            case "3": _ = OnDelete(e.Id);             break;
            case "4": _ = ConvertToEmployee(e.Id);    break;
            case "5": _ = ConvertToCustomer(e.Id);    break;
            case "6": _ = ConvertToVedor(e.Id);       break;
        }
    }
}

