@page "/App/Department"
@using Applications.Features.Departments.Commands.ChangeDepartmentState
@using Applications.Features.Departments.Dto
@using Web.UI.Helpers.Extensions
<PageTitle>Departments</PageTitle>
<RadzenTabs>
    <Tabs>
        <RadzenTabsItem Text="Departments">
            <GridToolbar SearchChanged="SearchChanged"> 
                <LeftChildren>
                    <RadzenButton Text="New Department"
                                  Click="ShowCreate"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Size="ButtonSize.Small"
                                  Icon="add" />
                </LeftChildren>
                <RightChildren>
                    <RadzenStack Orientation="Orientation.Horizontal">
                        <RadzenCheckBox TValue="bool" @bind-Value=@includeInactive Change="ex => ShowInactiveAndActive(ex)" Name="CheckBox1" />
                        <RadzenLabel Text="Include InActive" Component="CheckBox1" Style="margin-left:2px; vertical-align: middle;" />
                    </RadzenStack>
                </RightChildren>
            </GridToolbar>
            <RadzenDataGrid Responsive="true"
                            TItem="VDepartment"
                            Density="Density.Compact"
                            LoadData="LoadDepartmentData"
                            PageSize="@pageSize"
                            Count="@counts"
                            AllowPaging="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            ShowPagingSummary="true"
                            PagerPosition="PagerPosition.Bottom"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            AllowFiltering="true"
                            AllowSorting="true"
                            IsLoading="@isLoading"
                            PageSizeOptions="@StorageConstant.PageSizeOptions"
                            CellRender="@OnCellRender"
                            RowRender="@OnRowRender"
                            RowSelect="@OnRowSelect"
                            @ref="@_depRef"
                            CellContextMenu="@ShowCellContextMenu"
                            Data="@Departments">
                <Columns>
                    <RadzenDataGridColumn Width="5rem" Title="#"
                                          Context="c"
                                          Sortable="false"
                                          Filterable="false"
                                          Property="@nameof(VDepartment.DepartmentId)">
                        <Template>
                            @c.RowIndex
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="@nameof(VDepartment.DepartmentName)"
                                          Title="Department"
                                          Width="14rem"
                                          Sortable="true" />
                    <RadzenDataGridColumn Property="@nameof(VDepartment.Description)"
                                          Title="Description"
                                          Sortable="false" />
                    <RadzenDataGridColumn Context="c"
                                          Title="Active"
                                          Width="5rem"
                                          Filterable="false"
                                          Sortable="false">
                        <Template>
                            <RadzenBadge Text="@(c.IsActive ? "Active" : "Inactive")"
                                         BadgeStyle="@(c.IsActive ? BadgeStyle.Success : BadgeStyle.Danger)"
                                         Shade="Shade.Light"
                                         IsPill="true" />
                        </Template>

                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Filterable="false"
                                          Sortable="false"
                                          Title="Actions" Context="c" Width="4rem">
                        <Template>
                            <RadzenButton Size="ButtonSize.ExtraSmall"
                                          Icon="more_vert"
                                          Variant="Variant.Text"
                                          Click="@((args)=>ShowContextMenuWithContent(args,c.DepartmentId))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
                <LoadingTemplate>
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate"
                                               ShowValue="false" Value="100"
                                               ProgressBarStyle="ProgressBarStyle.Danger" />
                </LoadingTemplate>

            </RadzenDataGrid>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {

    void ShowContextMenuWithContent(MouseEventArgs args, int id)
    {
        ContextMenuService.Open(args, BuildDepartmentMenuItems(), me =>
        {
            ContextMenuService.Close();
            HandleDepartmentAction(me.Value?.ToString(), id);
        });
    }

    void ShowCellContextMenu(DataGridCellMouseEventArgs<VDepartment> args)
    {
        if (args.Data is null) return;

        ContextMenuService.Open(args, BuildDepartmentMenuItems(), me =>
        {
            ContextMenuService.Close();
            HandleDepartmentAction(me.Value?.ToString(), args.Data.DepartmentId);
        });
    }

    List<ContextMenuItem> BuildDepartmentMenuItems() =>
    [
        new ContextMenuItem { Text = "Details", Icon = "info",   Value = "1" },
        new ContextMenuItem { Text = "Edit",    Icon = "edit",   Value = "2" },
        new ContextMenuItem { Text = "Delete",  Icon = "delete", Value = "3" },
    ];

    void HandleDepartmentAction(string? value, int id)
    {
        switch (value)
        {
            case "1": _ = Details(id); break;
            case "2": _ = Edit(id);    break;
            case "3": _ = Delete(id);  break;
        }
    }

  




    async void SelectedPageChanged(int page)
    {
        pageIndex = 0;

        pageSize = page;

        await GetDepartments(searchText);
    }
    protected async Task OnCheckChanged(int? id, bool state)
    {

        var confirm = await DialogService.Confirm($"Do you want to deactivate department with ID#{id}?", options: new ConfirmOptions
        {
            CancelButtonText = "Cancel",
            OkButtonText = "OK",
        });

        if (confirm == false) return;


        var command = new ChangeDepartmentStateCommand(id,state);

        var rsp = await mediator.Send(command);

        if (rsp.IsSuccess())
        {

            NotificationService.Notify(NotificationSeverity.Success,"Department State was changed.");

            await GetDepartments(searchText);
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Success, rsp.GetMessage());
        }

    }

}