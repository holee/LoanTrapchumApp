@using Applications.Features.CollateralValuations.Dtos

<RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" Style="height:100%">
    <RadzenTemplateForm TItem="CollateralValuationDtoCreate" Data="@Req" Submit="@Create">
        <RadzenStack>
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Collateral Ref" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenTextBox @bind-Value="Req.CollateralRefId" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Collateral Line Ref ID" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenNumeric TValue="long?" @bind-Value="Req.CollateralLineRefId" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Value Date" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenDatePicker TValue="DateOnly?" @bind-Value="Req.ValueDate" DateFormat="dd/MM/yyyy" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Valued By" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenTextBox @bind-Value="Req.ValueBy" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Value Amount" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenNumeric TValue="decimal?" @bind-Value="Req.ValueAmount" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Currency Ref ID" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenNumeric TValue="int?" @bind-Value="Req.CurrencyRefId" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenRow>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Created By" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenTextBox @bind-Value="Req.CreatedBy" Style="width:100%" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" class="rz-mt-2" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton ButtonType="ButtonType.Submit"
                          Text="Save"
                          Size="ButtonSize.Small"
                          ButtonStyle="ButtonStyle.Primary"
                          Icon="save" />
            <RadzenButton Click="@Close"
                          Variant="Variant.Flat"
                          Size="ButtonSize.Small"
                          Text="Close"
                          Icon="cancel"
                          ButtonStyle="ButtonStyle.Secondary" />
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenStack>
