@page "/App/Holidays"
@using Applications.Bases
@using Applications.Features.Holidays.Command.ActivateOrDeactivate
@using Applications.Features.Holidays.Command.DeleteHoliday
@using Applications.Features.Holidays.Dtos
@using Web.UI.Helpers.Extensions
<PageTitle>Holiday</PageTitle>
<RadzenTabs @bind-SelectedIndex="SelectedIndex" RenderMode="TabRenderMode.Server">
    <Tabs>
        <RadzenTabsItem Text="Holidays" Icon="list">
            <GridToolbar>
                <LeftChildren>
                    <RadzenButton Text="Add Holiday"
                                  Click="@DisplayModal"
                                  Icon="add"
                                  ButtonStyle="ButtonStyle.Success"
                                  Size="ButtonSize.Small" />
                    <RadzenButton ButtonStyle="ButtonStyle.Secondary"
                                  Icon="add" Size="ButtonSize.Small"
                                  Click="ShowMultipleModal"
                                  Text="Add Multiple" />
                </LeftChildren>
                <RightChildren>
                    <div class="rz-text-center">
                        <RadzenCheckBox @bind-Value="@IsPreviousSelected"
                                        @bind-Value:after="PreviousSelectedChanged"
                                        Name="CheckBox1" />
                        <RadzenLabel Text="Previous Date" Component="CheckBox1" class="rz-ms-2" />
                    </div>
                </RightChildren>
            </GridToolbar>
            <RadzenDataGrid GridLines="DataGridGridLines.Horizontal"
                            Count="@counts"
                            PageSize="@pageSize"
                            AllowPaging="true"
                            ShowPagingSummary="true"
                            Density="Density.Compact"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            AllowSorting="true"
                            LoadData="LoadData"
                            IsLoading="isLoading"
                            TItem="HolidayDto"
                            PageSizeOptions="@StorageConstant.PageSizeOptions"
                            PageSizeChanged="@ChangedPageSize"
                            PagerPosition="@PagerPosition.Bottom"
                            RowRender="@OnRowRedner"
                            Data="HolidaysList">
                <Columns>
                    <RadzenDataGridColumn Title="#" Context="h" Width="4rem">
                        <Template>
                            @h?.RowIndex
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="Holiday Date" Sortable="true"
                                          Width="10rem"
                                          Context="h">
                        <Template>
                            @h?.HolidayDt.DayFirst()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TextAlign="TextAlign.Left"
                                          Title="Day Name"
                                          Width="8rem"
                                          Property="@nameof(HolidayDto.HolidayName)" />
                    <RadzenDataGridColumn TextAlign="TextAlign.Center"
                                          Title="DayInNumber"
                                          Property="HolidayNum" />
                    <RadzenDataGridColumn Title="Description" Property="Description" />
                    <RadzenDataGridColumn Width="5rem"
                                          TextAlign="TextAlign.Center"
                                          Title="Status" Sortable="false" Context="h">
                        <Template>
                            <RadzenCheckBox TValue="bool?" Disabled @bind-Value="h.Status" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Width="5rem" Title="Actions" Sortable="false" Context="h">
                        <Template>
                            <RadzenButton Size="ButtonSize.ExtraSmall"
                                          Icon="@IconNames.MoreVert"
                                          Variant="Variant.Text"
                                          Click="@((args)=>ShowContextMenuWithContent(args,h.Id))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
                <LoadingTemplate>
                    <RadzenStack JustifyContent="JustifyContent.Center" AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal">
                        <RadzenProgressBar ShowValue="false"
                                           ProgressBarStyle="ProgressBarStyle.Info" Visible="isLoading">
                            <Template>
                                <RadzenText>Loading...</RadzenText>
                            </Template>
                        </RadzenProgressBar>
                    </RadzenStack>
                </LoadingTemplate>
            </RadzenDataGrid>
        </RadzenTabsItem>
        @foreach (var tab in _tabs)
        {
            <RadzenTabsItem Text="@tab.Title" Icon="@tab.Icon" @key="@tab.Key">
                <Template>
                    <ClosedTab Title="@tab.Title" TabId="@tab.Key" Closed="@(() => CloseAddTab(tab.Key))" />
                </Template>
                <ChildContent>
                    @tab.Content
                </ChildContent>
            </RadzenTabsItem>
        }
    </Tabs>
</RadzenTabs>
@code {
    bool visibleAdd = false;
    bool isLoading = false;
    private List<CustomTab> _tabs = [];

    [Parameter] public int SelectedIndex { get; set; } = 0;

    void ShowContextMenuWithContent(MouseEventArgs args, long? id)
    {
        ContextMenuService.Open(args, ds =>
            @<RadzenMenu Style="font-size:0.8rem;">
    <RadzenMenuItem Click="@(() => Delete(id))" Icon="delete" Text="Delete" Value="@id" />
</RadzenMenu>
    );
    }

    void ShowEdit(long? id)
    {

    }
    protected async Task Delete(long? id)
    {
        ContextMenuService.Close();

        var comfirm = await DialogService.Confirm("Holiday deleted will not be able to recover, would you like to continue?",
            "Delete Holiday",
                 new ConfirmOptions
                 {
                     OkButtonText = "OK",
                     CancelButtonText = "Cancel",
                     CloseDialogOnEsc = true,

                 });


        if (comfirm == false) return;

        var command = new DeleteHolidayCommand(id);

        var rsp = await mediator.Send(command);

        if (!rsp.IsSuccess())
        {
            NotificationService.Notify(NotificationSeverity.Error, rsp.GetMessage());

            return;
        }

        if (rsp.Value.Status == DeleteStatus.Success)
        {
            NotificationService.Notify(NotificationSeverity.Success, "Holiday was deleted successfully.");

            return;
        }


        var confirm1 = await DialogService.Confirm(@"Holiday is used by other data, deleting it may cause data integrity issues, would you like to inactive?",
            "Delete Holiday",
                 new ConfirmOptions
                 {
                     OkButtonText = "OK",
                     CancelButtonText = "Cancel",
                     CloseDialogOnEsc = true,
                 });


        if (confirm1 == false) return;

        var command1 = new ActivateOrDeactivateHolidayCommand(id);

        var rsp1 = await mediator.Send(command1);

        if (!rsp1.IsSuccess())
        {
            NotificationService.Notify(NotificationSeverity.Error, rsp1.GetMessage());

            return;
        }


    }


    void CloseTab()
    {
        if (SelectedIndex == 1)
        {
            SelectedIndex = 0;

            visibleAdd = false;

            StateHasChanged();
        }
    }
    async void Reload()
    {
        await GetsHolidays(searchField);
    }

    async void LoadData(LoadDataArgs e)
    {
        pageIndex = e.Skip ?? 0;

        if (!string.IsNullOrEmpty(e.OrderBy))
        {
            sortColumn = e.OrderBy.Split(" ")[0];

            string dir = e.OrderBy.Split(" ")[1];

            sortDescending = dir.Contains("asc") ? false : true;
        }

        searchField = e.Filter ?? string.Empty;

        await GetsHolidays(searchField);
    }

    async Task ChangedPageSize(int page)
    {
        pageSize = page;
        pageIndex = 0;
        await GetsHolidays(searchField);
    }


    private async Task ShowMultipleModal(MouseEventArgs args)
    {

        var newKey = Guid.NewGuid().ToString("N");

        RenderFragment content = (builder) =>
        {
            builder.OpenComponent(0, typeof(CreateMultipleModal));

            builder.AddAttribute(1, "Closed", EventCallback.Factory.Create(this, () =>
            {
                CloseAddTab(newKey);
            }));

            builder.SetKey(newKey);

            builder.CloseComponent();
        };

        var newTab = new CustomTab(newKey, "Create Holidays", TabActions.Create, content);

        _tabs.Add(newTab);

        SelectedIndex = _tabs.Count;



    }


}

