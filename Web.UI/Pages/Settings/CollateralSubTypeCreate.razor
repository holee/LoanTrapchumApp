@using Applications.Features.Collaterals.Dtos

<RadzenTemplateForm TItem="CollateralSubTypeDtoCreate" Data="@model" Submit="@SaveForm">
    <RadzenFieldset Text="Collateral Sub-Type Details">
        <RadzenRow Gap="1rem" class="rz-my-4">
            <RadzenColumn Size="12" SizeMD="12">
                <RadzenFormField Text="Collateral Type" class="rz-w-100">
                    <RadzenDropDown @bind-Value="@model.CollateralTypeRefId"
                                    Data="@_collateralTypes"
                                    TextProperty="@nameof(CollateralTypeDto.CollateralTypeCode)"
                                    ValueProperty="@nameof(CollateralTypeDto.CollateralTypeId)"
                                    Name="CollateralTypeRefId"
                                    class="rz-w-100"
                                    Placeholder="Select collateral type..."
                                    AllowClear="true"
                                    TValue="int?" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="CollateralTypeRefId" Text="Collateral Type is required." Popup="false" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="12">
                <RadzenFormField Text="Value Rate (%)" class="rz-w-100">
                    <RadzenNumeric @bind-Value="model.ValueRate"
                                   class="rz-w-100"
                                   Min="0"
                                   Max="100"
                                   Step="0.01"
                                   Format="N2"
                                   Placeholder="Value Rate (%)"
                                   TValue="decimal?" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow Gap="1rem" class="rz-my-4">
            <RadzenColumn Size="12" SizeMD="12">
                <RadzenFormField Text="Collateral Sub-Type Name" class="rz-w-100">
                    <RadzenTextBox @bind-Value="model.SubTypeName"
                                   Name="SubTypeName"
                                   class="rz-w-100"
                                   Placeholder="Enter sub-type name..."
                                   MaxLength="100" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="SubTypeName" Text="Sub-Type Name is required." Popup="false" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="12">
                <RadzenFormField Text="Collateral Sub-Type Name (Khmer)" class="rz-w-100">
                    <RadzenTextBox @bind-Value="@model.SubTypeNameInKhmer"
                                   class="rz-w-100"
                                   Placeholder="Enter sub-type name in Khmer..."
                                   MaxLength="100" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
        <RadzenRow Gap="1rem" class="rz-my-4">
            <RadzenColumn Size="12" SizeMD="12">
                <RadzenFormField Text="Min Loan Size Amunt" class="rz-w-100">
                    <RadzenNumeric @bind-Value="model.LoanSizeAmuntMin"
                                   class="rz-w-100"
                                   Min="0"
                                   Step="100"
                                   Format="C2"
                                   Placeholder="Enter minimum loan amount..."
                                   TValue="decimal?" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="12">
                <RadzenFormField Text="Max Loan Size Amount" class="rz-w-100">
                    <RadzenNumeric @bind-Value="model.LoanSizeAmuntMax"
                                   class="rz-w-100"
                                   Min="0"
                                   Step="100"
                                   Format="C2"
                                   Placeholder="Enter maximum loan amount..."
                                   TValue="decimal?" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>
    </RadzenFieldset>
    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 Gap="1rem"
                 Class="rz-mt-4">
        <RadzenButton ButtonType="ButtonType.Submit"
                      Text="Save"
                      Icon="save"
                      ButtonStyle="ButtonStyle.Success"
                      Size="ButtonSize.ExtraSmall"
                      IsBusy="@_isBusy"
                      BusyText="Saving..." />
        <RadzenButton Text="Cancel"
                      Icon="cancel"
                      ButtonType="ButtonType.Button"
                      ButtonStyle="ButtonStyle.Secondary"
                      Size="ButtonSize.ExtraSmall"
                      Click="@CancelForm" />
    </RadzenStack>
</RadzenTemplateForm>

@code {

    [Inject] private ISettingApi SettingApi { get; set; } = default!;

    private CollateralSubTypeDtoCreate model = new() { IsActive = true };

    private List<CollateralTypeDto> _collateralTypes = [];

    private bool _isBusy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var types = await SettingApi.GetCollateralTypesAsync();

            _collateralTypes = types ?? [];
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }

        await base.OnInitializedAsync();
    }

    private async Task SaveForm()
    {
        _isBusy = true;

        try
        {
            var rsp = await SettingApi.UpsertCollateralSubTypeAsync(model);

            NotificationService.Notify(NotificationSeverity.Success, "Success", rsp.Message);

            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void CancelForm() => DialogService.Close(false);
}
