@using Applications.Features.AdditionalInformations.Dto
@using Web.UI.Components.Buttons

<RadzenTemplateForm TItem="OccupationDtoUpate" Data="@model" Submit="@OnSubmit">
    <RadzenStack Gap="1rem">

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12">
                <RadzenFormField Text="Occupation Title *" Variant="Variant.Outlined" class="rz-w-100">
                    <RadzenTextBox @bind-Value="@model.OccupationTitle" Name="OccupationTitle" class="rz-w-100" />
                </RadzenFormField>
                <RadzenRequiredValidator Component="OccupationTitle" Text="Occupation Title is required." Popup="false" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Khmer" Variant="Variant.Outlined" class="rz-w-100">
                    <RadzenTextBox @bind-Value="@model.Khmer" Name="Khmer" class="rz-w-100" />
                </RadzenFormField>
            </RadzenColumn>

            <RadzenColumn Size="12" SizeMD="6">
                <RadzenFormField Text="Type Of" Variant="Variant.Outlined" class="rz-w-100">
                    <RadzenDropDown @bind-Value="@model.TypeOf"
                                    Data="@StorageConstant.TypeOfOptions"
                                    Name="TypeOf"
                                    TValue="string"
                                    AllowClear="true"
                                    class="rz-w-100" />
                </RadzenFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <SaveButton IsBusy="@_isBusy" />

            <CancelButton OnClick="@(() => DialogService.Close(false))" />
        </RadzenStack>

    </RadzenStack>
</RadzenTemplateForm>
