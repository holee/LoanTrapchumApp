@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager

<RadzenComponents />

<RadzenProgressBar Visible="@isLoading"
                   Mode="ProgressBarMode.Indeterminate"
                   Value="100"
                   ShowValue="false"
                   ProgressBarStyle="ProgressBarStyle.Danger"
                   Style="height: 2px; position: fixed; top: 0; left: 0; width: 100%; z-index: 9999;" />

<RadzenLayout>
    <RadzenHeader Style="background: linear-gradient(135deg, var(--rz-success) 0%, #1a7a4a 100%); box-shadow: 0 2px 8px rgba(0,0,0,0.18); padding: 0 1rem;">
        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.SpaceBetween"
                     AlignItems="AlignItems.Center"
                     Gap="0"
                     Style="height: 56px;">
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="8px">
                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)"
                                     Style="color: white;" />
                <span class="app-title">Loan Management System</span>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="12px">
                <button type="button" class="hd-icon-btn" aria-label="Notifications">
                    <span class="rzi hd-icon">notifications</span>
                </button>
                <div class="pm-trigger">
                    <span class="pm-avatar">LM</span>
                    <span class="pm-trigger__name">Guest</span>
                </div>
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar Responsive="false" Style="width: max-content;">
        <NavMenu Expanded="sidebarExpanded" />
    </RadzenSidebar>

    <RadzenBody>
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                <main class="page-animate" @key="currentUrl">
                    @Body
                </main>
            </ChildContent>
            <ErrorContent>
                <GlobalErrorPage Exception="@context"
                                 OnRecover="@(() => _errorBoundary.Recover())" />
            </ErrorContent>
        </ErrorBoundary>
    </RadzenBody>
</RadzenLayout>

@code {
    private string? currentUrl;
    private bool isLoading;
    private bool sidebarExpanded = true;
    private ErrorBoundary _errorBoundary = default!;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);

        isLoading = true;

        _errorBoundary?.Recover();

        StateHasChanged();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (isLoading)
        {
            isLoading = false;

            StateHasChanged();
        }
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}

